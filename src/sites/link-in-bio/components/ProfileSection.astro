---
---

<section class="profile-section">
  <p class="profile-bio-text">Rock band 4 friends making music together</p>

  <div class="profile-actions-row">
    <div class="location-badge">
      <i class="fa-solid fa-location-dot location-pin-icon"></i>
      <span>Melbourne, Australia</span>
    </div>
  </div>

  <div class="total-followers-card">
    <div class="followers-left">
      <i class="fa-solid fa-users"></i>
      <div class="followers-label-group">
        <span>Total Followers</span>
        <span class="followers-last-updated" id="followersLastUpdated"></span>
      </div>
    </div>
    <div class="followers-count" id="totalFollowersCount">0</div>
  </div>
</section>

<style>
  .profile-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: 145px;
  }

  .profile-bio-text {
    font-family: var(--font-secondary);
    font-size: 0.95rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.92);
    margin: 6px 0 10px 0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  .profile-actions-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .location-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 7px 16px;
    border-radius: 16px;
    font-size: 0.84rem;
    font-weight: 700;
    color: #ffffff;
    box-shadow: 0 3.5px 0 rgba(0, 0, 0, 0.3);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .location-pin-icon {
    color: var(--btn-green);
    font-size: 0.88rem;
  }

  .total-followers-card {
    display: none !important;
  }
</style>

<script>
  import { initFollowersTracker } from '../scripts/followers.js';
  initFollowersTracker();
</script>
