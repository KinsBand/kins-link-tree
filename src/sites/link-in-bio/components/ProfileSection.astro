---
---

<section class="profile-section">
  <p class="profile-bio-text">Rock band 4 friends making music together</p>

  <div class="profile-actions-row">
    <div class="location-badge">
      <i class="fa-solid fa-location-dot location-pin-icon"></i>
      <span>Melbourne, Australia</span>
    </div>
  </div>

  <div class="total-followers-card">
    <div class="followers-left">
      <i class="fa-solid fa-users"></i>
      <div class="followers-label-group">
        <span>Total Followers</span>
        <span class="followers-last-updated" id="followersLastUpdated"></span>
      </div>
    </div>
    <div class="followers-count" id="totalFollowersCount">0</div>
  </div>
</section>

<style>
  .profile-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: 140px;
  }

  .profile-bio-text {
    font-family: var(--font-heading);
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-white);
    margin: 8px 0 14px 0;
    text-transform: uppercase;
  }

  .profile-actions-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .location-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(18, 18, 20, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 6px 14px;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-white);
    backdrop-filter: blur(8px);
    transition: border-color 0.2s ease;
  }

  .location-badge:hover {
    border-color: rgba(255, 255, 255, 0.25);
  }

  .location-pin-icon {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .total-followers-card {
    display: none !important;
  }
</style>

<script>
  import { initFollowersTracker } from '../scripts/followers.js';
  initFollowersTracker();
</script>
