---
---

<header class="top-nav">
  <div class="top-subscribe-wrapper">
    <span class="free-badge-pill">FREE</span>
    <button class="nav-pill-btn" id="topSubscribeBtn" aria-label="Subscribe to updates">
      <span>SUBSCRIBE</span>
    </button>
  </div>

  <button class="header-search-pill-btn" id="headerSearchPillBtn" aria-label="Search cover videos">
    <i class="fa-solid fa-magnifying-glass search-pill-icon"></i>
    <span class="search-pill-placeholder">search covers...</span>
  </button>

  <button class="nav-pill-btn" id="shareBtn" aria-label="Share page">
    <span>SHARE</span>
  </button>
</header>

<style>
  .top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    margin-top: 6px;
    position: sticky;
    top: 10px;
    z-index: 100;
    width: 100%;
    box-sizing: border-box;
    transition: opacity 0.3s var(--ease-snappy),
                filter 0.3s var(--ease-snappy),
                transform 0.3s var(--ease-snappy);
  }

  .top-nav:global(.nav-hidden) {
    opacity: 0;
    filter: blur(8px);
    pointer-events: none;
    transform: translateY(-10px);
  }

  .top-subscribe-wrapper, #shareBtn {
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .top-nav.search-active .top-subscribe-wrapper,
  .top-nav.search-active #shareBtn {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.92);
  }

  .top-subscribe-wrapper {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    flex: 0 0 auto;
  }

  .free-badge-pill {
    position: absolute;
    top: -8px;
    left: 4px;
    background: var(--text-white);
    color: var(--text-dark);
    font-family: var(--font-secondary);
    font-weight: 800;
    font-size: 0.52rem;
    padding: 1px 5px;
    border-radius: 2px;
    letter-spacing: 0.08em;
    border: 1px solid rgba(0, 0, 0, 0.4);
    z-index: 15;
    text-transform: uppercase;
    pointer-events: none;
    white-space: nowrap;
  }

  .nav-pill-btn {
    background: rgba(18, 18, 20, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--text-white);
    padding: 7px 14px;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    backdrop-filter: blur(12px);
    transition: transform 0.18s var(--ease-snappy), background-color 0.18s ease, border-color 0.18s ease;
    white-space: nowrap;
    box-sizing: border-box;
    user-select: none;
    flex: 0 0 auto;
    min-height: 38px;
  }

  .nav-pill-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.35);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .nav-pill-btn:active {
    transform: translateY(0);
    background: rgba(255, 255, 255, 0.2);
  }

  #topSubscribeBtn,
  #shareBtn {
    background-color: var(--btn-green);
    color: var(--btn-text-color);
    border-color: transparent;
    font-weight: 800;
  }

  #topSubscribeBtn:hover,
  #shareBtn:hover {
    background-color: var(--btn-green-hover);
    color: #000000;
  }

  /* Header Central Search Pill Button */
  .header-search-pill-btn {
    flex: 1 1 auto;
    max-width: 200px;
    background: rgba(18, 18, 20, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--text-muted);
    padding: 6px 12px;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    backdrop-filter: blur(12px);
    transition: all 0.2s var(--ease-snappy);
    min-height: 38px;
  }

  .header-search-pill-btn:hover {
    background: rgba(28, 28, 32, 0.9);
    border-color: rgba(255, 255, 255, 0.3);
    color: var(--text-white);
  }

  .search-pill-icon {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .search-pill-placeholder {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<script>
  const topNav = document.querySelector('.top-nav');
  let lastScrollY = window.scrollY;

  window.addEventListener('scroll', () => {
    const currentScrollY = window.scrollY;
    if (!topNav) return;

    if (currentScrollY <= 15) {
      topNav.classList.remove('nav-hidden');
    } else if (currentScrollY > lastScrollY && currentScrollY > 60) {
      topNav.classList.add('nav-hidden');
    } else if (currentScrollY < lastScrollY) {
      topNav.classList.remove('nav-hidden');
    }
    lastScrollY = currentScrollY;
  }, { passive: true });

  const topSubscribeBtn = document.getElementById('topSubscribeBtn');
  const subscribeFormSection = document.getElementById('subscribeFormSection');
  if (topSubscribeBtn && subscribeFormSection) {
    topSubscribeBtn.addEventListener('click', () => {
      subscribeFormSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
      const subTabBtn = document.getElementById('tabSubBtn');
      if (subTabBtn) subTabBtn.click();
      const emailInput = document.getElementById('emailInput') as HTMLInputElement;
      if (emailInput) {
        setTimeout(() => emailInput.focus(), 600);
      }
    });
  }
</script>
