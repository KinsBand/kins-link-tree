---
---

<div class="bottom-sheet-backdrop" id="gigMapModal">
  <div class="bottom-sheet-container" id="bottomSheetContainer">
    
    <div class="sheet-drag-area" id="sheetDragArea">
      <div class="sheet-drag-handle"></div>
      <span class="swipe-hint-text"><i class="fa-solid fa-chevron-down"></i> Swipe down to view map / close</span>
    </div>

    <!-- Header & Region Copywriting -->
    <div class="gig-sheet-header">
      <div class="gig-header-titles">
        <div class="gig-status-row">
          <span class="gig-status-badge"><i class="fa-solid fa-guitar"></i> LOCAL GIGS</span>
          <span class="region-pill-tag"><i class="fa-solid fa-map-pin"></i> SYDNEY • NEWCASTLE</span>
        </div>
        <p class="gig-banner-meta">
          Indie rock band playing local venues across Sydney & Newcastle.
        </p>
      </div>
      <button class="close-sheet-btn" id="closeGigMapSheet" aria-label="Close Gig Map">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Quick Gig Selector Tabs (User-Friendly UI/UX) -->
    <div class="gig-selector-pills-row" id="gigSelectorPillsRow">
      <!-- Populated dynamically by gigMap.js -->
    </div>

    <!-- Leaflet Map Container -->
    <div class="gig-map-view" id="gigMapView"></div>

    <!-- Venue Detail Bottom Card (Selected Show Details & Past Archive) -->
    <div class="venue-detail-bottom-card" id="venueDetailBottomCard">
      
      <!-- Top Title & Ticket Bar -->
      <div class="venue-card-header">
        <div class="venue-header-info">
          <h4 class="venue-card-name" id="venueCardName">Select a venue on the map</h4>
          <div class="venue-submeta-row">
            <p class="venue-card-city" id="venueCardCity">Newcastle & Sydney Region</p>
            <div class="venue-stats-badges">
              <span class="venue-rating-badge" id="venueRatingBadge"><i class="fa-solid fa-star"></i> 4.9</span>
              <span class="venue-capacity-badge" id="venueCapacityBadge"><i class="fa-solid fa-users"></i> 350 Cap</span>
            </div>
          </div>
        </div>
        
        <div class="venue-action-buttons-group">
          <a href="https://www.bandsintown.com" target="_blank" rel="noopener" class="venue-booking-btn" id="venueBookingBtn">
            <i class="fa-solid fa-ticket"></i>
            <span>GET TICKETS</span>
          </a>
        </div>
      </div>

      <!-- Real-world Accessibility & Venue Amenities -->
      <div class="venue-amenities-row" id="venueAmenitiesRow">
        <!-- Populated dynamically -->
      </div>

      <!-- Countdown Timer for Upcoming Gig -->
      <div class="gig-countdown-banner hidden" id="gigCountdownBanner">
        <div class="countdown-label">
          <i class="fa-solid fa-clock"></i> NEXT SHOW COUNTDOWN:
        </div>
        <div class="countdown-timer-digits" id="countdownTimerDigits">
          <span class="time-unit"><strong id="cdDays">00</strong>d</span> : 
          <span class="time-unit"><strong id="cdHours">00</strong>h</span> : 
          <span class="time-unit"><strong id="cdMins">00</strong>m</span> : 
          <span class="time-unit"><strong id="cdSecs">00</strong>s</span>
        </div>
      </div>

      <!-- Rich Show Breakdown Container (Swipeable & Scrollable) -->
      <div class="rich-show-breakdown" id="richShowBreakdown">
        <!-- Dynamic rich content generated by gigMap.js -->
      </div>

    </div>

  </div>
</div>

<style>
  .bottom-sheet-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(14px);
    z-index: 1000;
    display: flex;
    align-items: flex-end;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-snappy);
  }

  .bottom-sheet-backdrop:global(.active) {
    opacity: 1;
    pointer-events: auto;
  }

  .bottom-sheet-container {
    width: 100%;
    height: 94vh;
    background: #0a0a0c;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: translateY(100%);
    transition: transform 0.3s var(--ease-snappy);
  }

  .bottom-sheet-backdrop:global(.active) .bottom-sheet-container {
    transform: translateY(0);
  }

  .sheet-drag-area {
    padding: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    cursor: grab;
  }

  .sheet-drag-handle {
    width: 44px;
    height: 4px;
    background: rgba(255, 255, 255, 0.25);
    border-radius: 2px;
  }

  .swipe-hint-text {
    font-family: var(--font-secondary);
    font-size: 0.66rem;
    color: var(--text-muted);
  }

  .gig-sheet-header {
    padding: 0 16px 8px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }

  .gig-header-titles {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .gig-status-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .gig-status-badge {
    background: var(--btn-green);
    color: var(--btn-text-color);
    font-family: var(--font-secondary);
    font-size: 0.6rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 2px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .region-pill-tag {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.6rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 2px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .gig-banner-meta {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    color: var(--text-muted);
    line-height: 1.3;
  }

  .close-sheet-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-white);
    width: 34px;
    height: 34px;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background-color 0.18s ease;
  }

  .close-sheet-btn:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  /* Quick Gig Selector Pills Row */
  .gig-selector-pills-row {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 4px 16px 8px 16px;
    background: rgba(10, 10, 12, 0.6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .gig-selector-pills-row::-webkit-scrollbar {
    display: none;
  }

  .gig-selector-pills-row :global(.gig-select-pill) {
    flex: 0 0 auto;
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.18s ease;
  }

  .gig-selector-pills-row :global(.gig-select-pill:hover) {
    background: rgba(255, 255, 255, 0.16);
    color: var(--text-white);
  }

  .gig-selector-pills-row :global(.gig-select-pill.active) {
    background: var(--btn-green);
    color: var(--btn-text-color);
    border-color: var(--btn-green);
    font-weight: 800;
  }

  .gig-map-view {
    height: 200px;
    width: 100%;
    background: #000;
    flex-shrink: 0;
  }

  .venue-detail-bottom-card {
    padding: 16px;
    background: #0d0d0f;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .venue-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
  }

  .venue-header-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }

  .venue-card-name {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-white);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .venue-submeta-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .venue-card-city {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .venue-stats-badges {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .venue-rating-badge, .venue-capacity-badge {
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--text-white);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 2px 6px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .venue-booking-btn {
    background: var(--btn-green);
    color: var(--btn-text-color);
    padding: 8px 14px;
    border-radius: 4px;
    text-decoration: none;
    font-family: var(--font-secondary);
    font-weight: 800;
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    transition: transform 0.18s var(--ease-snappy);
    flex-shrink: 0;
  }

  .venue-booking-btn:hover {
    background: var(--btn-green-hover);
    transform: translateY(-1px);
  }

  /* Venue Real-World Amenities Horizontal Scroll Row */
  .venue-amenities-row {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
    -webkit-overflow-scrolling: touch;
  }

  .venue-amenities-row::-webkit-scrollbar {
    display: none;
  }

  .venue-amenities-row :global(.amenity-chip) {
    flex: 0 0 auto;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.66rem;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
  }

  /* Gig Countdown Banner (Fixed Minimum Height & Uncrushed Layout) */
  .gig-countdown-banner {
    background: rgba(24, 24, 28, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
    min-height: 46px;
    width: 100%;
    box-sizing: border-box;
  }

  .countdown-label {
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .countdown-timer-digits {
    font-family: monospace;
    font-size: 0.88rem;
    font-weight: 900;
    color: var(--text-white);
    letter-spacing: 1px;
  }

  /* Rich Structured Show Cards & Sections */
  .rich-show-breakdown {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 4px;
  }

  .rich-show-breakdown :global(.show-section-card) {
    background: rgba(10, 10, 12, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .rich-show-breakdown :global(.section-heading) {
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 6px;
  }

  .rich-show-breakdown :global(.snapshot-item),
  .rich-show-breakdown :global(.scene-item),
  .rich-show-breakdown :global(.bts-item) {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .rich-show-breakdown :global(.setlist-list) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 4px;
  }

  .rich-show-breakdown :global(.setlist-item-row) {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: var(--text-white);
    background: rgba(255, 255, 255, 0.05);
    padding: 8px 12px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: background-color 0.18s ease, border-color 0.18s ease;
    border: 1px solid rgba(255, 255, 255, 0.1);
    user-select: none;
  }

  .rich-show-breakdown :global(.setlist-item-row:hover) {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.22);
  }

  .rich-show-breakdown :global(.setlist-row-progress) {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    background: linear-gradient(90deg, rgba(242, 240, 235, 0.2) 0%, rgba(242, 240, 235, 0.12) 100%);
    pointer-events: none;
    transition: width 0.25s linear;
  }

  .rich-show-breakdown :global(.setlist-item-row.is-playing .setlist-row-progress) {
    animation: setlistProgressFill 30s linear forwards;
  }

  @keyframes setlistProgressFill {
    from { width: 0%; }
    to { width: 100%; }
  }

  .rich-show-breakdown :global(.setlist-row-content) {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .rich-show-breakdown :global(.setlist-song-name) {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rich-show-breakdown :global(.setlist-play-icon) {
    font-size: 0.7rem;
    color: var(--text-muted);
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .rich-show-breakdown :global(.setlist-item-row.is-playing .setlist-play-icon) {
    color: var(--text-white);
  }

  .rich-show-breakdown :global(.setlist-tag) {
    font-size: 0.62rem;
    color: var(--text-muted);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>

<script>
  import { initGigMapModule } from '../scripts/gigMap.js';
  initGigMapModule();
</script>
