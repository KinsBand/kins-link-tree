---
---

<div class="bottom-sheet-backdrop" id="gigMapModal">
  <div class="bottom-sheet-container" id="bottomSheetContainer">
    
    <div class="sheet-drag-area" id="sheetDragArea">
      <div class="sheet-drag-handle"></div>
      <span class="swipe-hint-text"><i class="fa-solid fa-chevron-down"></i> Swipe down to view map / close</span>
    </div>

    <!-- Header & Region Copywriting -->
    <div class="gig-sheet-header">
      <div class="gig-banner-card" id="gigBannerCard">
        <div class="gig-banner-left">
          <div class="gig-status-row">
            <span class="gig-status-badge" id="gigStatusBadge"><i class="fa-solid fa-guitar"></i> LOCAL GIGS</span>
            <span class="region-pill-tag"><i class="fa-solid fa-map-pin"></i> SYDNEY • NEWCASTLE • MAITLAND</span>
          </div>
          <h4 class="gig-banner-venue" id="gigBannerVenue">Kins Live Gigs</h4>
          <p class="gig-banner-meta" id="gigBannerMeta">
            <i class="fa-solid fa-location-dot"></i> Up-and-coming indie rock band playing local venues across Newcastle, Maitland & Sydney
          </p>
        </div>
      </div>
      <button class="close-sheet-btn" id="closeGigMapSheet" aria-label="Close Gig Map">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Quick Gig Selector Tabs (User-Friendly UI/UX) -->
    <div class="gig-selector-pills-row" id="gigSelectorPillsRow">
      <!-- Populated dynamically by gigMap.js -->
    </div>

    <!-- Leaflet Map Container -->
    <div class="gig-map-view" id="gigMapView"></div>

    <!-- Venue Detail Bottom Card (Selected Show Details & Past Archive) -->
    <div class="venue-detail-bottom-card" id="venueDetailBottomCard">
      
      <!-- Top Title & Ticket Bar -->
      <div class="venue-card-header">
        <div class="venue-header-info">
          <div class="venue-title-row">
            <h4 class="venue-card-name" id="venueCardName">Select a venue on the map</h4>
            <span class="venue-rating-badge" id="venueRatingBadge"><i class="fa-solid fa-star"></i> 4.9 (48 Shows)</span>
          </div>
          <p class="venue-card-city" id="venueCardCity">Newcastle, Maitland & Sydney Region</p>
        </div>
        
        <div class="venue-action-buttons-group">
          <a href="https://www.bandsintown.com" target="_blank" rel="noopener" class="venue-booking-btn" id="venueBookingBtn">
            <i class="fa-solid fa-ticket"></i>
            <span>GET TICKETS</span>
          </a>
        </div>
      </div>

      <!-- Real-world Accessibility & Venue Amenities -->
      <div class="venue-amenities-row" id="venueAmenitiesRow">
        <!-- Populated dynamically -->
      </div>

      <!-- Countdown Timer for Upcoming Gig -->
      <div class="gig-countdown-banner hidden" id="gigCountdownBanner">
        <div class="countdown-label">
          <i class="fa-solid fa-clock"></i> NEXT SHOW COUNTDOWN:
        </div>
        <div class="countdown-timer-digits" id="countdownTimerDigits">
          <span class="time-unit"><strong id="cdDays">00</strong>d</span> : 
          <span class="time-unit"><strong id="cdHours">00</strong>h</span> : 
          <span class="time-unit"><strong id="cdMins">00</strong>m</span> : 
          <span class="time-unit"><strong id="cdSecs">00</strong>s</span>
        </div>
      </div>

      <!-- Rich Show Breakdown Container (Swipeable & Scrollable) -->
      <div class="rich-show-breakdown" id="richShowBreakdown">
        <!-- Dynamic rich content generated by gigMap.js -->
      </div>

    </div>

  </div>
</div>

<style>
  .bottom-sheet-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(14px);
    z-index: 1000;
    display: flex;
    align-items: flex-end;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-snappy);
  }

  .bottom-sheet-backdrop:global(.active) {
    opacity: 1;
    pointer-events: auto;
  }

  .bottom-sheet-container {
    width: 100%;
    height: 94vh;
    background: #0a0a0c;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: translateY(100%);
    transition: transform 0.3s var(--ease-snappy);
  }

  .bottom-sheet-backdrop:global(.active) .bottom-sheet-container {
    transform: translateY(0);
  }

  .sheet-drag-area {
    padding: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    cursor: grab;
  }

  .sheet-drag-handle {
    width: 44px;
    height: 4px;
    background: rgba(255, 255, 255, 0.25);
    border-radius: 2px;
  }

  .swipe-hint-text {
    font-family: var(--font-secondary);
    font-size: 0.66rem;
    color: var(--text-muted);
  }

  .gig-sheet-header {
    padding: 0 16px 8px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
  }

  .gig-status-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    flex-wrap: wrap;
  }

  .gig-status-badge {
    background: var(--btn-green);
    color: var(--btn-text-color);
    font-family: var(--font-secondary);
    font-size: 0.6rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 2px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .region-pill-tag {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.6rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 2px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .gig-banner-venue {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-white);
  }

  .gig-banner-meta {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    color: var(--text-muted);
    line-height: 1.3;
    margin-top: 2px;
  }

  .close-sheet-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-white);
    width: 34px;
    height: 34px;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background-color 0.18s ease;
  }

  .close-sheet-btn:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  /* Quick Gig Selector Pills Row */
  .gig-selector-pills-row {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 4px 16px 8px 16px;
    background: rgba(10, 10, 12, 0.6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .gig-selector-pills-row::-webkit-scrollbar {
    display: none;
  }

  .gig-selector-pills-row :global(.gig-select-pill) {
    flex: 0 0 auto;
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.18s ease;
  }

  .gig-selector-pills-row :global(.gig-select-pill:hover) {
    background: rgba(255, 255, 255, 0.16);
    color: var(--text-white);
  }

  .gig-selector-pills-row :global(.gig-select-pill.active) {
    background: var(--btn-green);
    color: var(--btn-text-color);
    border-color: var(--btn-green);
    font-weight: 800;
  }

  .gig-map-view {
    height: 220px;
    width: 100%;
    background: #000;
    flex-shrink: 0;
  }

  .venue-detail-bottom-card {
    padding: 16px;
    background: #0d0d0f;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .venue-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .venue-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .venue-card-name {
    font-family: var(--font-heading);
    font-size: 0.98rem;
    font-weight: 800;
    color: var(--text-white);
  }

  .venue-rating-badge {
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--text-white);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .venue-card-city {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .venue-booking-btn {
    background: var(--btn-green);
    color: var(--btn-text-color);
    padding: 8px 14px;
    border-radius: 4px;
    text-decoration: none;
    font-family: var(--font-secondary);
    font-weight: 800;
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    transition: transform 0.18s var(--ease-snappy);
  }

  .venue-booking-btn:hover {
    background: var(--btn-green-hover);
    transform: translateY(-1px);
  }

  /* Venue Real-World Amenities */
  .venue-amenities-row {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .venue-amenities-row :global(.amenity-chip) {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.66rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  /* Gig Countdown Banner */
  .gig-countdown-banner {
    background: rgba(24, 24, 28, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .countdown-label {
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .countdown-timer-digits {
    font-family: monospace;
    font-size: 0.86rem;
    font-weight: 900;
    color: var(--text-white);
    letter-spacing: 1px;
  }

  /* Rich Structured Show Cards & Sections */
  .rich-show-breakdown {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 4px;
  }

  .rich-show-breakdown :global(.show-meta-headline-box) {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 6px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .rich-show-breakdown :global(.show-main-title) {
    font-family: var(--font-heading);
    font-size: 0.98rem;
    font-weight: 800;
    color: var(--text-white);
  }

  .rich-show-breakdown :global(.show-sub-stats) {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .rich-show-breakdown :global(.show-section-card) {
    background: rgba(10, 10, 12, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .rich-show-breakdown :global(.section-heading) {
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 6px;
  }

  .rich-show-breakdown :global(.snapshot-item),
  .rich-show-breakdown :global(.scene-item),
  .rich-show-breakdown :global(.bts-item) {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .rich-show-breakdown :global(.video-preview-embed) {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    position: relative;
  }

  .rich-show-breakdown :global(.video-preview-embed iframe) {
    width: 100%;
    height: 100%;
    border: none;
  }

  .rich-show-breakdown :global(.setlist-list) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 4px;
  }

  .rich-show-breakdown :global(.setlist-item-row) {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: var(--text-white);
    background: rgba(255, 255, 255, 0.05);
    padding: 6px 10px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .rich-show-breakdown :global(.setlist-tag) {
    font-size: 0.62rem;
    color: var(--text-muted);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .rich-show-breakdown :global(.gallery-grid) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .rich-show-breakdown :global(.gallery-img-box) {
    aspect-ratio: 1 / 1;
    border-radius: 4px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .rich-show-breakdown :global(.gallery-img-box img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rich-show-breakdown :global(.stage-crowd-photo) {
    width: 100%;
    height: 130px;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .rich-show-breakdown :global(.request-song-mailto-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px dashed rgba(255, 255, 255, 0.25);
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 8px 16px;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.18s ease;
    width: 100%;
    box-sizing: border-box;
  }

  .rich-show-breakdown :global(.request-song-mailto-btn:hover) {
    background: var(--btn-green);
    color: var(--btn-text-color);
    border-style: solid;
  }
</style>

<script>
  import { initGigMapModule } from '../scripts/gigMap.js';
  initGigMapModule();
</script>
