---

<section class="merch-section">
  <div class="members-section-header">
    <h3 class="members-section-title"><i class="fa-solid fa-shirt"></i> Official Merch</h3>
    <span class="scroll-hint-pill merch-status-pill">
      <i class="fa-solid fa-clock"></i> Stay Tuned
    </span>
  </div>

  <div class="merch-coming-soon-card">
    <div class="merch-cs-icon-box">
      <i class="fa-solid fa-box-open"></i>
    </div>
    <div class="merch-cs-content">
      <span class="merch-cs-badge">COMING SOON</span>
      <h4 class="merch-cs-title">Official Kins Store Drop</h4>
      <p class="merch-cs-desc">Exclusive apparel, vinyl & limited accessories dropping soon. Stay tuned for release announcements.</p>
    </div>
  </div>
</section>

<style>
  .merch-section {
    width: 100%;
    margin-top: 10px;
    margin-bottom: 10px;
  }

  .members-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    padding: 0 4px;
  }

  .members-section-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-white, #ffffff);
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: -0.3px;
  }

  .members-section-title i {
    color: var(--btn-green);
  }

  .scroll-hint-pill {
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--btn-text-color, #0b1f18);
    background-color: var(--btn-green);
    border: none;
    padding: 6px 14px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .merch-coming-soon-card {
    background: var(--card-bg, rgba(11, 31, 24, 0.94));
    border: 1px dashed rgba(83, 198, 120, 0.4);
    border-radius: 24px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .merch-cs-icon-box {
    font-size: 2.2rem;
    color: var(--btn-green);
    width: 56px;
    height: 56px;
    background: rgba(83, 198, 120, 0.12);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .merch-cs-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .merch-cs-badge {
    font-size: 0.65rem;
    font-weight: 900;
    color: var(--btn-green);
    letter-spacing: 0.6px;
  }

  .merch-cs-title {
    font-size: 1rem;
    font-weight: 800;
    color: #ffffff;
  }

  .merch-cs-desc {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.35;
  }
</style>
