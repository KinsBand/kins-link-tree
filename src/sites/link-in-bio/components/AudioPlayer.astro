---
---

<div class="bottom-floating-controls-wrapper" id="bottomFloatingControls">
  <!-- Full-Width Streaming Drawer Panel -->
  <div class="stream-drawer-panel hidden" id="streamDrawerPanel">
    <div class="stream-drawer-header">
      <span class="stream-drawer-title">
        <i class="fa-solid fa-compact-disc"></i> Stream on
      </span>
      <span class="stream-drawer-song" id="streamDrawerSongName"></span>
    </div>
    <div class="stream-platforms-row">
      <a href="#" target="_blank" rel="noopener noreferrer" class="stream-platform-btn spotify" id="streamLinkSpotify" title="Spotify" aria-label="Spotify">
        <i class="fa-brands fa-spotify"></i>
      </a>
      <a href="#" target="_blank" rel="noopener noreferrer" class="stream-platform-btn apple" id="streamLinkApple" title="Apple Music" aria-label="Apple Music">
        <i class="fa-brands fa-apple"></i>
      </a>
      <a href="#" target="_blank" rel="noopener noreferrer" class="stream-platform-btn youtube" id="streamLinkYoutube" title="YouTube Music" aria-label="YouTube Music">
        <i class="fa-brands fa-youtube"></i>
      </a>
      <a href="#" target="_blank" rel="noopener noreferrer" class="stream-platform-btn amazon" id="streamLinkAmazon" title="Amazon Music" aria-label="Amazon Music">
        <i class="fa-brands fa-amazon"></i>
      </a>
      <a href="#" target="_blank" rel="noopener noreferrer" class="stream-platform-btn soundcloud" id="streamLinkSoundcloud" title="SoundCloud" aria-label="SoundCloud">
        <i class="fa-brands fa-soundcloud"></i>
      </a>
      <a href="#" target="_blank" rel="noopener noreferrer" class="stream-platform-btn deezer" id="streamLinkDeezer" title="Deezer" aria-label="Deezer">
        <i class="fa-brands fa-deezer"></i>
      </a>
      <a href="#" target="_blank" rel="noopener noreferrer" class="stream-platform-btn tidal" id="streamLinkTidal" title="Tidal" aria-label="Tidal">
        <i class="fa-solid fa-water"></i>
      </a>
      <a href="#" target="_blank" rel="noopener noreferrer" class="stream-platform-btn bandcamp" id="streamLinkBandcamp" title="Bandcamp" aria-label="Bandcamp">
        <i class="fa-brands fa-bandcamp"></i>
      </a>
      <a href="#" target="_blank" rel="noopener noreferrer" class="stream-platform-btn audiomack" id="streamLinkAudiomack" title="Audiomack" aria-label="Audiomack">
        <i class="fa-solid fa-headphones"></i>
      </a>
      <a href="#" target="_blank" rel="noopener noreferrer" class="stream-platform-btn qobuz" id="streamLinkQobuz" title="Qobuz" aria-label="Qobuz">
        <i class="fa-solid fa-compact-disc"></i>
      </a>
    </div>
  </div>

  <div class="bottom-audio-bar hidden" id="bottomAudioBar">
    <audio id="vaultAudioPlayer" preload="none"></audio>

    <!-- Vinyl Stylus riding on top of the card timeline -->
    <div class="vinyl-stylus-wrapper" id="vinylStylusWrapper">
      <svg class="vinyl-stylus-svg" viewBox="0 0 28 45" width="28" height="45">
        <defs>
          <linearGradient id="kins_aluminum" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#a1a1aa" />
            <stop offset="50%" stop-color="#f4f4f5" />
            <stop offset="100%" stop-color="#71717a" />
          </linearGradient>
        </defs>
        <!-- Brushed Metal Stem -->
        <line x1="14" y1="2" x2="14" y2="23" stroke="url(#kins_aluminum)" stroke-width="2.5" stroke-linecap="round"/>
        <!-- Minimalist Dark Cartridge Head -->
        <rect x="7" y="23" width="14" height="11" rx="2" fill="#09090b" stroke="#3f3f46" stroke-width="1"/>
        <rect x="9" y="25" width="10" height="2.5" fill="#ffffff" rx="1"/>
        <!-- Stylus Needle Pointer -->
        <line x1="14" y1="34" x2="14" y2="39" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/>
        <polygon points="14,41 12,38 16,38" fill="#ffffff"/>
      </svg>
    </div>

    <!-- Setlist-style Card Timeline Fill Progress -->
    <div class="audio-bar-timeline-progress" id="audioBarTimelineProgress"></div>

    <div class="audio-bar-content">
      <div class="audio-bar-left">
        <div class="audio-bar-icon-box">
          <img id="audioBarCoverImg" class="audio-bar-cover-img hidden" src="" alt="Album cover">
          <i class="fa-solid fa-compact-disc audio-icon-anim" id="audioBarFallbackIcon"></i>
        </div>
        <div class="audio-bar-details">
          <span class="audio-bar-title" id="audioBarTitle">Just Like Heaven</span>
          <div class="audio-bar-meta-row">
            <span class="audio-bar-artist" id="audioBarArtist">The Cure</span>
            <span class="audio-bar-time" id="audioBarTime">0:00 / 0:30</span>
          </div>
        </div>
      </div>
      <div class="audio-bar-right">
        <button class="audio-bar-stream-btn" id="audioBarStreamBtn" aria-label="Streaming options / Add to playlist" title="Stream or Add to Playlist">
          <i class="fa-solid fa-arrow-up-right-from-square"></i>
        </button>
        <button class="audio-bar-toggle-btn" id="audioBarToggleBtn" aria-label="Toggle playback">
          <i class="fa-solid fa-pause"></i>
        </button>
        <button class="audio-bar-close-btn" id="audioBarCloseBtn" aria-label="Close audio player">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .bottom-floating-controls-wrapper {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 900;
    width: 90%;
    max-width: 400px;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  :global(body.modal-open) .bottom-floating-controls-wrapper {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* Full-Width Streaming Platform Drawer (Icons-Only) */
  .stream-drawer-panel {
    pointer-events: auto;
    background: rgba(18, 18, 20, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    padding: 8px 12px;
    margin-bottom: 6px;
    backdrop-filter: blur(16px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.7);
    
    opacity: 0;
    transform: translateY(12px) scale(0.97);
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stream-drawer-panel.active-drawer {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .stream-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stream-drawer-title {
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .stream-drawer-song {
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-white);
    max-width: 170px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stream-platforms-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .stream-platform-btn {
    flex: 1;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-white);
    text-decoration: none;
    font-size: 1.15rem;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stream-platform-btn:hover {
    transform: translateY(-2px);
  }

  /* Platform specific vibrant hover colors & glows */
  .stream-platform-btn.spotify:hover {
    background: rgba(30, 215, 96, 0.22);
    border-color: rgba(30, 215, 96, 0.5);
    color: #1DB954;
    box-shadow: 0 0 12px rgba(30, 215, 96, 0.3);
  }

  .stream-platform-btn.apple:hover {
    background: rgba(252, 60, 80, 0.22);
    border-color: rgba(252, 60, 80, 0.5);
    color: #FC3C50;
    box-shadow: 0 0 12px rgba(252, 60, 80, 0.3);
  }

  .stream-platform-btn.youtube:hover {
    background: rgba(255, 0, 0, 0.22);
    border-color: rgba(255, 0, 0, 0.5);
    color: #FF0000;
    box-shadow: 0 0 12px rgba(255, 0, 0, 0.3);
  }

  .stream-platform-btn.soundcloud:hover {
    background: rgba(255, 85, 0, 0.22);
    border-color: rgba(255, 85, 0, 0.5);
    color: #FF5500;
    box-shadow: 0 0 12px rgba(255, 85, 0, 0.3);
  }

  .stream-platform-btn.amazon:hover {
    background: rgba(0, 168, 225, 0.22);
    border-color: rgba(0, 168, 225, 0.5);
    color: #00A8E1;
    box-shadow: 0 0 12px rgba(0, 168, 225, 0.3);
  }

  .stream-platform-btn.tidal:hover {
    background: rgba(0, 229, 255, 0.22);
    border-color: rgba(0, 229, 255, 0.5);
    color: #00E5FF;
    box-shadow: 0 0 12px rgba(0, 229, 255, 0.3);
  }

  .bottom-audio-bar {
    pointer-events: auto;
    background: rgba(18, 18, 20, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    padding: 10px 14px;
    backdrop-filter: blur(16px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.7);
    position: relative;
    overflow: visible;
    cursor: pointer;
    user-select: none;
    touch-action: none;
    
    /* Fluid entrance and exit transition */
    opacity: 0;
    transform: translateY(32px) scale(0.96);
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bottom-audio-bar:hover {
    border-color: rgba(255, 255, 255, 0.28);
  }

  .bottom-audio-bar.active-player {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .bottom-audio-bar.player-exiting {
    opacity: 0;
    transform: translateY(32px) scale(0.96);
  }

  /* Setlist Card Style Progress Fill */
  .audio-bar-timeline-progress {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 0%;
    background: linear-gradient(90deg, rgba(242, 240, 235, 0.22) 0%, rgba(242, 240, 235, 0.12) 100%);
    border-radius: 5px 0 0 5px;
    pointer-events: none;
    will-change: width;
    z-index: 1;
  }

  .bottom-audio-bar.is-scrubbing .audio-bar-timeline-progress {
    background: linear-gradient(90deg, rgba(242, 240, 235, 0.35) 0%, rgba(242, 240, 235, 0.2) 100%);
  }

  /* Vinyl Stylus Riding on Top of the Mini Player Card */
  .vinyl-stylus-wrapper {
    position: absolute;
    top: -36px;
    left: 0%;
    transform: translateX(-50%);
    z-index: 10;
    pointer-events: none;
    will-change: left;
    filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.7));
  }

  .vinyl-stylus-svg {
    display: block;
    transform-origin: 14px 2px; /* Stem top center */
    transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1), filter 0.15s ease;
  }

  .bottom-audio-bar.is-scrubbing .vinyl-stylus-svg {
    filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.8));
  }

  .vinyl-stylus-wrapper.tilt-forward .vinyl-stylus-svg {
    transform: rotate(14deg) scale(1.05);
  }

  .vinyl-stylus-wrapper.tilt-backward .vinyl-stylus-svg {
    transform: rotate(-14deg) scale(1.05);
  }

  .audio-bar-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 2;
  }

  .audio-bar-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .audio-bar-icon-box {
    width: 36px;
    height: 36px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: var(--text-white);
  }

  .audio-bar-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .audio-bar-details {
    display: flex;
    flex-direction: column;
  }

  .audio-bar-title {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-white);
  }

  .audio-bar-meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 1px;
  }

  .audio-bar-artist {
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .audio-bar-time {
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.55);
    letter-spacing: 0.04em;
  }

  .audio-bar-right {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .audio-bar-stream-btn, .audio-bar-toggle-btn, .audio-bar-close-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-white);
    width: 30px;
    height: 30px;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.78rem;
    transition: all 0.18s ease;
  }

  .audio-bar-stream-btn:hover, .audio-bar-toggle-btn:hover, .audio-bar-close-btn:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .audio-bar-stream-btn.active {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.4);
    color: #1DB954;
    box-shadow: 0 0 10px rgba(30, 215, 96, 0.25);
  }

  /* Animated Icon Morph Transition for Play/Pause */
  .audio-bar-toggle-btn i {
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  }

  .audio-bar-toggle-btn.icon-morph i {
    animation: iconMorphAnim 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes iconMorphAnim {
    0% {
      transform: scale(0.4) rotate(-90deg);
      opacity: 0.2;
    }
    60% {
      transform: scale(1.18) rotate(15deg);
      opacity: 1;
    }
    100% {
      transform: scale(1) rotate(0deg);
      opacity: 1;
    }
  }
</style>

<script>
  import { initAudioPlayer } from '../scripts/audioPlayer.js';
  initAudioPlayer();
</script>
