---
---

<div class="bottom-floating-controls-wrapper" id="bottomFloatingControls">
  <!-- Full-Width Streaming Drawer Panel -->
  <div class="stream-drawer-panel hidden" id="streamDrawerPanel">
    <div class="stream-drawer-header">
      <span class="stream-drawer-title">
        <i class="fa-solid fa-compact-disc"></i> Stream on
      </span>
      <span class="stream-drawer-song" id="streamDrawerSongName"></span>
    </div>
    <div class="stream-platforms-row">
      <a href="#" target="_blank" rel="noopener noreferrer" class="stream-platform-btn spotify" id="streamLinkSpotify" title="Spotify" aria-label="Spotify">
        <i class="fa-brands fa-spotify"></i>
      </a>
      <a href="#" target="_blank" rel="noopener noreferrer" class="stream-platform-btn apple" id="streamLinkApple" title="Apple Music" aria-label="Apple Music">
        <i class="fa-brands fa-apple"></i>
      </a>
      <a href="#" target="_blank" rel="noopener noreferrer" class="stream-platform-btn youtube" id="streamLinkYoutube" title="YouTube Music" aria-label="YouTube Music">
        <i class="fa-brands fa-youtube"></i>
      </a>
      <a href="#" target="_blank" rel="noopener noreferrer" class="stream-platform-btn soundcloud" id="streamLinkSoundcloud" title="SoundCloud" aria-label="SoundCloud">
        <i class="fa-brands fa-soundcloud"></i>
      </a>
      <a href="#" target="_blank" rel="noopener noreferrer" class="stream-platform-btn amazon" id="streamLinkAmazon" title="Amazon Music" aria-label="Amazon Music">
        <i class="fa-brands fa-amazon"></i>
      </a>
      <a href="#" target="_blank" rel="noopener noreferrer" class="stream-platform-btn tidal" id="streamLinkTidal" title="Tidal" aria-label="Tidal">
        <i class="fa-solid fa-water"></i>
      </a>
    </div>
  </div>

  <div class="bottom-audio-bar hidden" id="bottomAudioBar">
    <audio id="vaultAudioPlayer" preload="none"></audio>
    <div class="audio-bar-content">
      <div class="audio-bar-left">
        <div class="audio-bar-icon-box">
          <img id="audioBarCoverImg" class="audio-bar-cover-img hidden" src="" alt="Album cover">
          <i class="fa-solid fa-compact-disc audio-icon-anim" id="audioBarFallbackIcon"></i>
        </div>
        <div class="audio-bar-details">
          <span class="audio-bar-title" id="audioBarTitle">Just Like Heaven</span>
          <span class="audio-bar-artist" id="audioBarArtist">The Cure</span>
        </div>
      </div>
      <div class="audio-bar-right">
        <button class="audio-bar-stream-btn" id="audioBarStreamBtn" aria-label="Streaming options / Add to playlist" title="Stream or Add to Playlist">
          <i class="fa-solid fa-arrow-up-right-from-square"></i>
        </button>
        <button class="audio-bar-toggle-btn" id="audioBarToggleBtn" aria-label="Toggle playback">
          <i class="fa-solid fa-pause"></i>
        </button>
        <button class="audio-bar-close-btn" id="audioBarCloseBtn" aria-label="Close audio player">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .bottom-floating-controls-wrapper {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 900;
    width: 90%;
    max-width: 400px;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  :global(body.modal-open) .bottom-floating-controls-wrapper {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* Full-Width Streaming Platform Drawer (Icons-Only) */
  .stream-drawer-panel {
    pointer-events: auto;
    background: rgba(18, 18, 20, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    padding: 8px 12px;
    margin-bottom: 6px;
    backdrop-filter: blur(16px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.7);
    
    opacity: 0;
    transform: translateY(12px) scale(0.97);
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stream-drawer-panel.active-drawer {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .stream-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stream-drawer-title {
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .stream-drawer-song {
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-white);
    max-width: 170px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stream-platforms-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .stream-platform-btn {
    flex: 1;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-white);
    text-decoration: none;
    font-size: 1.15rem;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stream-platform-btn:hover {
    transform: translateY(-2px);
  }

  /* Platform specific vibrant hover colors & glows */
  .stream-platform-btn.spotify:hover {
    background: rgba(30, 215, 96, 0.22);
    border-color: rgba(30, 215, 96, 0.5);
    color: #1DB954;
    box-shadow: 0 0 12px rgba(30, 215, 96, 0.3);
  }

  .stream-platform-btn.apple:hover {
    background: rgba(252, 60, 80, 0.22);
    border-color: rgba(252, 60, 80, 0.5);
    color: #FC3C50;
    box-shadow: 0 0 12px rgba(252, 60, 80, 0.3);
  }

  .stream-platform-btn.youtube:hover {
    background: rgba(255, 0, 0, 0.22);
    border-color: rgba(255, 0, 0, 0.5);
    color: #FF0000;
    box-shadow: 0 0 12px rgba(255, 0, 0, 0.3);
  }

  .stream-platform-btn.soundcloud:hover {
    background: rgba(255, 85, 0, 0.22);
    border-color: rgba(255, 85, 0, 0.5);
    color: #FF5500;
    box-shadow: 0 0 12px rgba(255, 85, 0, 0.3);
  }

  .stream-platform-btn.amazon:hover {
    background: rgba(0, 168, 225, 0.22);
    border-color: rgba(0, 168, 225, 0.5);
    color: #00A8E1;
    box-shadow: 0 0 12px rgba(0, 168, 225, 0.3);
  }

  .stream-platform-btn.tidal:hover {
    background: rgba(0, 229, 255, 0.22);
    border-color: rgba(0, 229, 255, 0.5);
    color: #00E5FF;
    box-shadow: 0 0 12px rgba(0, 229, 255, 0.3);
  }

  .bottom-audio-bar {
    pointer-events: auto;
    background: rgba(18, 18, 20, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    padding: 10px 14px;
    backdrop-filter: blur(16px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.7);
    
    /* Fluid entrance and exit transition */
    opacity: 0;
    transform: translateY(32px) scale(0.96);
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bottom-audio-bar.active-player {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .bottom-audio-bar.player-exiting {
    opacity: 0;
    transform: translateY(32px) scale(0.96);
  }

  .audio-bar-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .audio-bar-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .audio-bar-icon-box {
    width: 36px;
    height: 36px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: var(--text-white);
  }

  .audio-bar-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .audio-bar-details {
    display: flex;
    flex-direction: column;
  }

  .audio-bar-title {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-white);
  }

  .audio-bar-artist {
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .audio-bar-right {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .audio-bar-stream-btn, .audio-bar-toggle-btn, .audio-bar-close-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-white);
    width: 30px;
    height: 30px;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.78rem;
    transition: all 0.18s ease;
  }

  .audio-bar-stream-btn:hover, .audio-bar-toggle-btn:hover, .audio-bar-close-btn:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .audio-bar-stream-btn.active {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.4);
    color: #1DB954;
    box-shadow: 0 0 10px rgba(30, 215, 96, 0.25);
  }

  /* Animated Icon Morph Transition for Play/Pause */
  .audio-bar-toggle-btn i {
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  }

  .audio-bar-toggle-btn.icon-morph i {
    animation: iconMorphAnim 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes iconMorphAnim {
    0% {
      transform: scale(0.4) rotate(-90deg);
      opacity: 0.2;
    }
    60% {
      transform: scale(1.18) rotate(15deg);
      opacity: 1;
    }
    100% {
      transform: scale(1) rotate(0deg);
      opacity: 1;
    }
  }
</style>

<script>
  import { initAudioPlayer } from '../scripts/audioPlayer.js';
  initAudioPlayer();
</script>
