---
---

<div class="modal-backdrop" id="shareModal">
  <div class="modal-content share-modal-enhanced">
    <div class="modal-header">
      <div class="modal-title-group">
        <i class="fa-solid fa-share-nodes share-header-icon"></i>
        <h3>Share Kins Official Page</h3>
      </div>
      <button class="close-modal-btn" id="closeShareModal" aria-label="Close share modal">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="modal-body share-modal-body">
      <div class="share-copy-handle-wrapper">
        <div class="handle-display-box">
          <i class="fa-solid fa-at handle-at-icon"></i>
          <span class="handle-handle-text">@KinsBandOfficial</span>
        </div>
        <button class="icon-only-copy-btn" id="handleCopyBtn" title="Copy handle @KinsBandOfficial" aria-label="Copy handle @KinsBandOfficial">
          <i class="fa-regular fa-copy"></i>
        </button>
      </div>

      <div class="qr-box-container">
        <div class="qr-canvas-wrapper" id="qrcodeCanvas"></div>
        <div class="qr-info-column">
          <span class="qr-label-title">Scan QR Code</span>
          <span class="qr-label-sub">Point mobile camera to view page</span>
          <button class="download-qr-btn" id="downloadQrBtn">
            <i class="fa-solid fa-download"></i> Save QR
          </button>
        </div>
      </div>

      <div class="copy-input-group">
        <div class="copy-input-wrapper">
          <i class="fa-solid fa-link link-input-icon"></i>
          <input type="text" id="shareUrlInput" value="https://beacons.ai/KinsBandOfficial" readonly>
        </div>
        <button id="copyUrlBtn" class="icon-only-copy-btn" title="Copy website link" aria-label="Copy website link">
          <i class="fa-regular fa-copy"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-snappy);
  }

  .modal-backdrop:global(.active) {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-content {
    background: rgba(18, 18, 20, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    width: 100%;
    max-width: 400px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.9);
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .modal-title-group {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-white);
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .share-header-icon {
    color: var(--text-muted);
  }

  .close-modal-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-white);
    width: 32px;
    height: 32px;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.18s ease;
  }

  .close-modal-btn:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .modal-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .share-copy-handle-wrapper, .copy-input-group {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(10, 10, 12, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    padding: 10px 12px;
  }

  .handle-display-box, .copy-input-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .copy-input-wrapper input {
    background: transparent;
    border: none;
    color: var(--text-white);
    font-family: var(--font-secondary);
    width: 100%;
    outline: none;
    font-size: 0.82rem;
  }

  .icon-only-copy-btn {
    background: var(--btn-green);
    color: var(--btn-text-color);
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.18s ease;
  }

  .icon-only-copy-btn:hover {
    background: var(--btn-green-hover);
  }

  .qr-box-container {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(10, 10, 12, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    padding: 14px;
  }

  .qr-canvas-wrapper {
    background: #ffffff;
    padding: 8px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .qr-info-column {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .qr-label-title {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-white);
  }

  .qr-label-sub {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .download-qr-btn {
    margin-top: 6px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--text-white);
    border-radius: 4px;
    padding: 6px 12px;
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background-color 0.18s ease;
  }

  .download-qr-btn:hover {
    background: rgba(255, 255, 255, 0.16);
  }
</style>

<script>
  import { initShareModal } from '../scripts/shareModal.js';
  initShareModal();
</script>
