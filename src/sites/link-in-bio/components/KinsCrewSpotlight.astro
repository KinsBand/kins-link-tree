---
const mockClips = [
  {
    id: 'clip-1',
    handle: '@mitch_drums',
    title: 'Everlong',
    tag: 'Drum Cover',
    platform: 'tiktok',
    platformIcon: 'fa-tiktok',
    platformName: 'TikTok',
    bgGradient: 'linear-gradient(145deg, #2d124d 0%, #120e24 100%)',
    icon: 'fa-drum'
  },
  {
    id: 'clip-2',
    handle: '@alex_covers',
    title: 'Just Like Heaven',
    tag: 'Vocal & Guitar',
    platform: 'instagram',
    platformIcon: 'fa-instagram',
    platformName: 'IG Reel',
    bgGradient: 'linear-gradient(145deg, #4d122b 0%, #1a0a14 100%)',
    icon: 'fa-guitar'
  },
  {
    id: 'clip-3',
    handle: '@sydney_live',
    title: 'Sydney Live Clip',
    tag: 'Front Row Edit',
    platform: 'youtube',
    platformIcon: 'fa-youtube',
    platformName: 'Shorts',
    bgGradient: 'linear-gradient(145deg, #123d4d 0%, #091a24 100%)',
    icon: 'fa-video'
  },
  {
    id: 'clip-4',
    handle: '@indie_edits',
    title: 'Kins Tour Vibe',
    tag: 'Fan Edit',
    platform: 'tiktok',
    platformIcon: 'fa-tiktok',
    platformName: 'TikTok',
    bgGradient: 'linear-gradient(145deg, #3d3b12 0%, #171607 100%)',
    icon: 'fa-clapperboard'
  }
];
---

<section class="spotlight-section" id="spotlight-section">
  <!-- Section Header -->
  <div class="spotlight-header">
    <div class="header-title-box">
      <h3 class="spotlight-title"><i class="fa-solid fa-users"></i> Community</h3>
      <p class="spotlight-subtitle">Covers, edits, and live clips from the Kins community.</p>
    </div>
    <span class="scroll-hint-pill"><i class="fa-solid fa-arrow-right-long"></i> Scroll</span>
  </div>

  <!-- Snap-Scroll Horizontal Video Row -->
  <div class="spotlight-scroll-container">
    {mockClips.map((clip) => (
      <div class="spotlight-card" data-clip-id={clip.id}>
        <div class="card-media-wrapper" style={`background: ${clip.bgGradient}`}>
          <!-- Mock Graphic Element -->
          <div class="mock-bg-art">
            <i class={`fa-solid ${clip.icon} mock-icon-bg`}></i>
          </div>

          <!-- Top Right Platform Badge -->
          <div class="platform-badge">
            <i class={`fa-brands ${clip.platformIcon}`}></i>
            <span>{clip.platformName}</span>
          </div>

          <!-- Center Glassmorphism Play Button -->
          <div class="play-btn-circle">
            <i class="fa-solid fa-play"></i>
          </div>

          <!-- Bottom Card Content Overlay -->
          <div class="card-content-overlay">
            <span class="creator-handle">{clip.handle}</span>
            <span class="clip-subtext">"{clip.title}" • {clip.tag}</span>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Bottom Submission Banner -->
  <div class="submission-banner">
    <div class="banner-text-content">
      <h4 class="banner-title"><i class="fa-solid fa-sparkles banner-sparkle-icon"></i> Made something for Kins?</h4>
      <p class="banner-desc">Tag <strong>@KinsBandOfficial</strong> on social media or send a link to our email to get featured on the site.</p>
    </div>
    <a href="mailto:contact@kinsband.com" target="_blank" rel="noopener noreferrer" class="submit-clip-btn">
      <span>Submit Your Clip</span>
      <i class="fa-solid fa-arrow-up-right-from-square"></i>
    </a>
  </div>
</section>

<style>
  .spotlight-section {
    width: 100%;
    margin-top: 14px;
    margin-bottom: 10px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    content-visibility: auto;
    contain-intrinsic-size: 0 450px;
  }

  /* Section Header */
  .spotlight-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 0 2px;
  }

  .header-title-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .spotlight-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .spotlight-title i {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .spotlight-subtitle {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .scroll-hint-pill {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 4px 10px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
  }

  /* Snap-Scroll Container */
  .spotlight-scroll-container {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 2px 16px 2px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .spotlight-scroll-container::-webkit-scrollbar {
    display: none;
  }

  /* Individual 9:16 Card */
  .spotlight-card {
    flex: 0 0 210px;
    height: 373px; /* 9:16 vertical video ratio standard for ~210px width */
    scroll-snap-align: start;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    cursor: pointer;
    backdrop-filter: blur(12px);
    transition: transform 0.25s var(--ease-snappy), border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .spotlight-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6);
  }

  .card-media-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 12px;
    overflow: hidden;
  }

  .card-media-wrapper::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.1) 40%, rgba(0, 0, 0, 0.85) 100%);
    z-index: 1;
    transition: opacity 0.25s ease;
  }

  .spotlight-card:hover .card-media-wrapper::before {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.2) 40%, rgba(0, 0, 0, 0.92) 100%);
  }

  /* Mock Icon Background Artwork */
  .mock-bg-art {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 0;
    overflow: hidden;
  }

  .mock-icon-bg {
    font-size: 8rem;
    color: rgba(255, 255, 255, 0.07);
    transition: transform 0.35s var(--ease-snappy);
  }

  .spotlight-card:hover .mock-icon-bg {
    transform: scale(1.08) rotate(6deg);
  }

  /* Platform Badge (Top Right) */
  .platform-badge {
    position: relative;
    z-index: 2;
    align-self: flex-end;
    background: rgba(10, 10, 12, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(8px);
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 700;
    padding: 4px 9px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 5px;
    letter-spacing: 0.02em;
  }

  .platform-badge i {
    font-size: 0.72rem;
  }

  /* Center Play Button (Glassmorphism) */
  .play-btn-circle {
    position: absolute;
    top: 45%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(10px);
    color: var(--text-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    z-index: 2;
    padding-left: 3px; /* visual alignment for play triangle */
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    transition: transform 0.25s var(--ease-snappy), background-color 0.25s ease, border-color 0.25s ease;
  }

  .spotlight-card:hover .play-btn-circle {
    transform: translate(-50%, -50%) scale(1.14);
    background: rgba(255, 255, 255, 0.28);
    border-color: rgba(255, 255, 255, 0.6);
  }

  /* Bottom Content Overlay */
  .card-content-overlay {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .creator-handle {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-white);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
    letter-spacing: -0.01em;
  }

  .clip-subtext {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Bottom Submission Banner */
  .submission-banner {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    backdrop-filter: blur(12px);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .submission-banner:hover {
    border-color: rgba(255, 255, 255, 0.26);
    background: rgba(24, 24, 28, 0.92);
  }

  .banner-text-content {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .banner-title {
    font-family: var(--font-heading);
    font-size: 0.86rem;
    font-weight: 800;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .banner-sparkle-icon {
    color: var(--btn-green);
    font-size: 0.8rem;
  }

  .banner-desc {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    color: var(--text-muted);
    line-height: 1.35;
  }

  .banner-desc strong {
    color: var(--text-white);
  }

  .submit-clip-btn {
    background: var(--btn-green);
    color: var(--btn-text-color);
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    padding: 9px 13px;
    border-radius: 6px;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    flex-shrink: 0;
    transition: transform 0.18s var(--ease-snappy), background-color 0.18s ease;
  }

  .submit-clip-btn:hover {
    background: var(--btn-green-hover);
    transform: translateY(-1px);
  }

  @media (max-width: 440px) {
    .submission-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .submit-clip-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
