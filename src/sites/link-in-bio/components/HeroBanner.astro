---
interface Props {
  image?: string;
}

const { image = `${import.meta.env.BASE_URL}pfp.jpg` } = Astro.props;
---

<div class="hero-banner-container" id="heroBannerContainer">
  <img src={image} alt="Kins hero banner" class="hero-banner-img" id="heroBannerImg" decoding="async" fetchpriority="high">
  <div class="hero-gradient-overlay"></div>
</div>

<!-- Floating Logo Download Popup -->
<div class="hero-download-popup hidden" id="heroDownloadPopup">
  <button class="hero-download-btn" id="heroDownloadBtn" aria-label="Download Logo">
    <i class="fa-solid fa-download"></i>
    <span>DOWNLOAD LOGO</span>
  </button>
</div>

<style>
  .hero-banner-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 420px;
    z-index: 0;
    overflow: hidden;
    pointer-events: auto;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .hero-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
    transform: scale(1.02);
    filter: contrast(110%) brightness(85%) grayscale(25%);
    display: block;
    transition: transform 0.6s var(--ease-snappy), filter 0.4s ease;
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 25%,
      rgba(0, 0, 0, 0.85) 40%,
      rgba(0, 0, 0, 0.55) 55%,
      rgba(0, 0, 0, 0.25) 68%,
      rgba(0, 0, 0, 0.08) 78%,
      transparent 85%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 25%,
      rgba(0, 0, 0, 0.85) 40%,
      rgba(0, 0, 0, 0.55) 55%,
      rgba(0, 0, 0, 0.25) 68%,
      rgba(0, 0, 0, 0.08) 78%,
      transparent 85%
    );
  }

  .hero-gradient-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(20, 20, 23, 0.1) 0%,
        transparent 20%,
        transparent 35%,
        rgba(20, 20, 23, 0.2) 48%,
        rgba(20, 20, 23, 0.45) 58%,
        rgba(20, 20, 23, 0.7) 67%,
        rgba(20, 20, 23, 0.88) 75%,
        #141417 84%,
        #141417 100%
      );
    pointer-events: none;
  }

  .hero-download-popup {
    position: fixed;
    z-index: 9999;
    transition: opacity 0.2s var(--ease-snappy), transform 0.2s var(--ease-snappy);
    transform-origin: right center;
    pointer-events: auto;
  }

  .hero-download-popup.hidden {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.9) translateX(8px);
  }

  .hero-download-btn {
    background: rgba(18, 18, 20, 0.92);
    color: var(--text-white);
    border: 1px solid rgba(255, 255, 255, 0.16);
    padding: 7px 13px;
    border-radius: 6px;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    cursor: pointer;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 12px rgba(29, 185, 84, 0.25);
    transition: transform 0.18s var(--ease-snappy), background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
    white-space: nowrap;
  }

  .hero-download-btn:hover {
    background: var(--btn-green);
    color: var(--btn-text-color);
    border-color: var(--btn-green);
    transform: translateY(-1px);
  }
</style>

<script>
  const container = document.getElementById('heroBannerContainer');
  const img = document.getElementById('heroBannerImg') as HTMLImageElement;
  const popup = document.getElementById('heroDownloadPopup');
  const downloadBtn = document.getElementById('heroDownloadBtn');

  let pressTimer: any = null;
  let startX = 0;
  let startY = 0;
  const HOLD_DURATION = 350; // 350ms snappy hold time

  const siteRoot = document.getElementById('siteContainer') || document.body;

  function isTopLogoArea(clientY: number) {
    const rootEl = document.getElementById('siteContainer') || container;
    if (!rootEl) return false;
    const rect = rootEl.getBoundingClientRect();
    const relativeY = clientY - rect.top;
    return relativeY >= 0 && relativeY <= 260;
  }

  function showPopupAt(clientX: number, clientY: number) {
    if (!popup) return;

    const popupWidth = 150;
    const popupHeight = 38;

    // Position to the LEFT of touch/hold location
    let leftPos = clientX - popupWidth - 14;
    let topPos = clientY - (popupHeight / 2);

    if (leftPos < 12) {
      leftPos = clientX + 16; // Flip to right if too close to left screen boundary
    }
    if (topPos < 12) topPos = 12;
    if (topPos + popupHeight > window.innerHeight - 12) {
      topPos = window.innerHeight - popupHeight - 12;
    }

    popup.style.left = `${leftPos}px`;
    popup.style.top = `${topPos}px`;
    popup.classList.remove('hidden');
  }

  function hidePopup() {
    if (popup) popup.classList.add('hidden');
  }

  function startHold(e: MouseEvent | TouchEvent) {
    // Ignore presses originating inside the popup or download button itself
    if (popup && (popup.contains(e.target as Node) || popup === e.target)) {
      return;
    }

    const point = 'touches' in e ? e.touches[0] : e;
    startX = point.clientX;
    startY = point.clientY;

    if (!isTopLogoArea(startY)) return;

    // Prevent browser text selection & default image context popups on top logo area
    window.getSelection()?.removeAllRanges();
    if (e.cancelable && 'touches' in e) {
      e.preventDefault();
    }

    clearTimeout(pressTimer);
    pressTimer = setTimeout(() => {
      window.getSelection()?.removeAllRanges();
      showPopupAt(startX, startY);
    }, HOLD_DURATION);
  }

  function cancelHold() {
    clearTimeout(pressTimer);
  }

  function moveHold(e: MouseEvent | TouchEvent) {
    const point = 'touches' in e ? e.touches[0] : (e as MouseEvent);
    const diffX = Math.abs(point.clientX - startX);
    const diffY = Math.abs(point.clientY - startY);
    if (diffX > 10 || diffY > 10) {
      cancelHold();
    }
  }

  if (siteRoot) {
    siteRoot.addEventListener('mousedown', startHold);
    siteRoot.addEventListener('mouseup', cancelHold);
    siteRoot.addEventListener('mouseleave', cancelHold);
    siteRoot.addEventListener('mousemove', moveHold);

    siteRoot.addEventListener('touchstart', startHold, { passive: false });
    siteRoot.addEventListener('touchend', cancelHold);
    siteRoot.addEventListener('touchcancel', cancelHold);
    siteRoot.addEventListener('touchmove', moveHold, { passive: true });

    siteRoot.addEventListener('contextmenu', (e) => {
      if (popup && popup.contains(e.target as Node)) return;
      if (isTopLogoArea(e.clientY)) {
        e.preventDefault();
        showPopupAt(e.clientX, e.clientY);
      }
    });
  }

  // Guaranteed Logo Download Trigger
  function triggerLogoDownload(e?: Event) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    hidePopup();

    const notify = (msg: string) => {
      if ((window as any).showToast) {
        (window as any).showToast(msg);
      }
    };

    const imageSrc = img?.src || `${import.meta.env.BASE_URL}pfp.jpg`;

    notify("Downloading logo...");

    // Synchronous native browser download link
    try {
      const link = document.createElement('a');
      link.href = imageSrc;
      link.download = 'kins-logo.jpg';
      link.target = '_self';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      notify("Logo saved!");
    } catch (err) {
      console.warn("Direct download link error, opening fallback image tab...", err);
      window.open(imageSrc, '_blank');
    }
  }

  if (downloadBtn) {
    downloadBtn.addEventListener('click', triggerLogoDownload);
    downloadBtn.addEventListener('touchend', (e) => {
      e.preventDefault();
      e.stopPropagation();
      triggerLogoDownload(e);
    });
  }

  document.addEventListener('click', (e) => {
    if (popup && !popup.contains(e.target as Node) && siteRoot && !siteRoot.contains(e.target as Node)) {
      hidePopup();
    }
  });

  window.addEventListener('scroll', hidePopup, { passive: true });
</script>
