---
interface Props {
  image?: string;
}

const { image = `${import.meta.env.BASE_URL}pfp.jpg` } = Astro.props;
---

<div class="hero-banner-container" id="heroBannerContainer">
  <img src={image} alt="Kins hero banner" class="hero-banner-img" id="heroBannerImg" decoding="async" fetchpriority="high">
  <div class="hero-gradient-overlay"></div>
</div>

<!-- Floating Logo Download Popup -->
<div class="hero-download-popup hidden" id="heroDownloadPopup">
  <button class="hero-download-btn" id="heroDownloadBtn" aria-label="Download Logo">
    <i class="fa-solid fa-download"></i>
    <span>DOWNLOAD LOGO</span>
  </button>
</div>

<style>
  .hero-banner-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 420px;
    z-index: 0;
    overflow: hidden;
    pointer-events: auto;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .hero-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
    transform: scale(1.02);
    filter: contrast(110%) brightness(85%) grayscale(25%);
    display: block;
    transition: transform 0.6s var(--ease-snappy), filter 0.4s ease;
    mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 25%,
      rgba(0, 0, 0, 0.85) 40%,
      rgba(0, 0, 0, 0.55) 55%,
      rgba(0, 0, 0, 0.25) 68%,
      rgba(0, 0, 0, 0.08) 78%,
      transparent 85%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      black 0%,
      black 25%,
      rgba(0, 0, 0, 0.85) 40%,
      rgba(0, 0, 0, 0.55) 55%,
      rgba(0, 0, 0, 0.25) 68%,
      rgba(0, 0, 0, 0.08) 78%,
      transparent 85%
    );
  }

  .hero-gradient-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(20, 20, 23, 0.1) 0%,
        transparent 20%,
        transparent 35%,
        rgba(20, 20, 23, 0.2) 48%,
        rgba(20, 20, 23, 0.45) 58%,
        rgba(20, 20, 23, 0.7) 67%,
        rgba(20, 20, 23, 0.88) 75%,
        #141417 84%,
        #141417 100%
      );
    pointer-events: none;
  }

  .hero-download-popup {
    position: fixed;
    z-index: 9999;
    transition: opacity 0.26s cubic-bezier(0.34, 1.56, 0.64, 1),
                transform 0.26s cubic-bezier(0.34, 1.56, 0.64, 1),
                filter 0.26s ease;
    transform-origin: right center;
    pointer-events: auto;
    filter: blur(0px);
  }

  .hero-download-popup.hidden {
    opacity: 0;
    filter: blur(6px);
    pointer-events: none;
    transform: scale(0.72) translateX(-10px) translateY(-2px);
  }

  .hero-download-btn {
    background: rgba(16, 16, 20, 0.94);
    color: var(--text-white);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 8px 15px;
    border-radius: 8px;
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.7), 0 0 16px rgba(29, 185, 84, 0.3);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
                background-color 0.18s ease,
                border-color 0.18s ease,
                color 0.18s ease;
    white-space: nowrap;
  }

  .hero-download-btn:hover {
    background: var(--btn-green);
    color: #000000;
    border-color: var(--btn-green);
    transform: scale(1.05) translateY(-1px);
  }
</style>

<script>
  import { showToast } from '../scripts/toast.js';
  import { rainEffect } from '../scripts/easterEgg.js';

  const container = document.getElementById('heroBannerContainer');
  const img = document.getElementById('heroBannerImg') as HTMLImageElement;
  const popup = document.getElementById('heroDownloadPopup');
  const downloadBtn = document.getElementById('heroDownloadBtn');

  let pressTimer: any = null;
  let startX = 0;
  let startY = 0;
  const HOLD_DURATION = 350; // 350ms snappy hold time

  let clickCount = 0;
  let clickResetTimer: any = null;
  let popupWasOpenOnPress = false;

  function isPopupOpen() {
    return popup && !popup.classList.contains('hidden');
  }

  const siteRoot = document.getElementById('siteContainer') || document.body;

  function isTopLogoArea(clientY: number) {
    const rootEl = document.getElementById('siteContainer') || container;
    if (!rootEl) return false;
    const rect = rootEl.getBoundingClientRect();
    const relativeY = clientY - rect.top;
    return relativeY >= 0 && relativeY <= 260;
  }

  function trackLogoTaps(clientY: number) {
    if (popupWasOpenOnPress || isPopupOpen()) {
      popupWasOpenOnPress = false;
      hidePopup();
      return;
    }

    if (!isTopLogoArea(clientY)) return;

    clickCount++;
    clearTimeout(clickResetTimer);
    clickResetTimer = setTimeout(() => {
      clickCount = 0;
    }, 1500);

    const remainingHits = 5 - clickCount;

    if (remainingHits === 3) {
      showToast("🔥 3 more hits until 🎸 Kins Physics Playground!");
    } else if (remainingHits === 2) {
      showToast("⚡ 2 more hits until 🎸 Kins Physics Playground!");
    } else if (remainingHits === 1) {
      showToast("🚀 1 more hit until 🎸 Kins Physics Playground!");
    } else if (clickCount >= 5) {
      clickCount = 0;
      hidePopup();
      rainEffect.init();
      showToast("🎉 🎸 Kins Physics Playground Unlocked!");
    }
  }

  function showPopupAt(clientX: number, clientY: number) {
    if (!popup) return;

    const popupWidth = 150;
    const popupHeight = 38;

    let leftPos = clientX - popupWidth - 14;
    let topPos = clientY - (popupHeight / 2);

    if (leftPos < 12) {
      leftPos = clientX + 16;
    }
    if (topPos < 12) topPos = 12;
    if (topPos + popupHeight > window.innerHeight - 12) {
      topPos = window.innerHeight - popupHeight - 12;
    }

    popup.style.left = `${leftPos}px`;
    popup.style.top = `${topPos}px`;
    popup.classList.remove('hidden');
  }

  function hidePopup() {
    if (popup) popup.classList.add('hidden');
  }

  function startHold(e: MouseEvent | TouchEvent) {
    if (popup && (popup.contains(e.target as Node) || popup === e.target)) {
      return;
    }

    popupWasOpenOnPress = isPopupOpen();
    if (popupWasOpenOnPress) {
      hidePopup();
      return;
    }

    const point = 'touches' in e ? e.touches[0] : e;
    startX = point.clientX;
    startY = point.clientY;

    if (!isTopLogoArea(startY)) return;

    window.getSelection()?.removeAllRanges();
    if (e.cancelable && 'touches' in e) {
      e.preventDefault();
    }

    clearTimeout(pressTimer);
    pressTimer = setTimeout(() => {
      window.getSelection()?.removeAllRanges();
      showPopupAt(startX, startY);
    }, HOLD_DURATION);
  }

  function cancelHold() {
    clearTimeout(pressTimer);
  }

  function moveHold(e: MouseEvent | TouchEvent) {
    const point = 'touches' in e ? e.touches[0] : (e as MouseEvent);
    const diffX = Math.abs(point.clientX - startX);
    const diffY = Math.abs(point.clientY - startY);
    if (diffX > 10 || diffY > 10) {
      cancelHold();
    }
  }

  if (siteRoot) {
    siteRoot.addEventListener('mousedown', startHold);
    siteRoot.addEventListener('mouseup', cancelHold);
    siteRoot.addEventListener('mouseleave', cancelHold);
    siteRoot.addEventListener('mousemove', moveHold);

    siteRoot.addEventListener('touchstart', startHold, { passive: false });
    siteRoot.addEventListener('touchend', cancelHold);
    siteRoot.addEventListener('touchcancel', cancelHold);
    siteRoot.addEventListener('touchmove', moveHold, { passive: true });

    siteRoot.addEventListener('click', (e) => {
      if (popup && popup.contains(e.target as Node)) return;
      trackLogoTaps(e.clientY);
    });

    siteRoot.addEventListener('touchend', (e) => {
      if (popup && popup.contains(e.target as Node)) return;
      if (e.changedTouches && e.changedTouches.length) {
        trackLogoTaps(e.changedTouches[0].clientY);
      }
    });

    siteRoot.addEventListener('contextmenu', (e) => {
      if (popup && popup.contains(e.target as Node)) return;
      if (isTopLogoArea(e.clientY)) {
        e.preventDefault();
        showPopupAt(e.clientX, e.clientY);
      }
    });
  }

  function triggerLogoDownload(e?: Event) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    hidePopup();

    const imageSrc = img?.src || `${import.meta.env.BASE_URL}pfp.jpg`;

    showToast("⚡ Kins Logo Downloaded!");

    try {
      const link = document.createElement('a');
      link.href = imageSrc;
      link.download = 'kins-logo.jpg';
      link.target = '_self';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    } catch (err) {
      console.warn("Direct download link error, opening fallback image tab...", err);
      window.open(imageSrc, '_blank');
    }
  }

  if (downloadBtn) {
    downloadBtn.addEventListener('click', triggerLogoDownload);
    downloadBtn.addEventListener('touchend', (e) => {
      e.preventDefault();
      e.stopPropagation();
      triggerLogoDownload(e);
    });
  }

  document.addEventListener('pointerdown', (e) => {
    if (isPopupOpen() && popup && !popup.contains(e.target as Node)) {
      hidePopup();
    }
  }, { capture: true });

  window.addEventListener('scroll', hidePopup, { passive: true });
</script>
