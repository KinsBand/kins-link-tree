<div class="floating-gig-pill-container" id="floatingGigPillBtn" role="button" aria-label="Open Tour & Gig Map">
  <div class="gig-pill-inner">
    <i class="fa-solid fa-map-location-dot pill-map-icon"></i>
    <div class="gig-pill-text-box">
      <span class="gig-pill-tag" id="gigPillTag">Gigs</span>
      <span class="gig-pill-location" id="gigPillLocation">Locations</span>
    </div>
    <div class="gig-pill-arrow-section">
      <i class="fa-solid fa-chevron-right pill-arrow-icon"></i>
    </div>
  </div>
</div>

<style>
  .floating-gig-pill-container {
    position: fixed;
    bottom: 24px;
    right: 20px;
    z-index: 800;
    cursor: pointer;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(body.audio-bar-active) .floating-gig-pill-container {
    transform: translateY(-64px);
  }

  :global(body.modal-open) .floating-gig-pill-container {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .gig-pill-inner {
    background: var(--btn-green);
    color: var(--btn-text-color);
    padding: 10px 16px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
    font-family: var(--font-secondary);
    transition: transform 0.2s var(--ease-snappy), background-color 0.2s ease;
  }

  .floating-gig-pill-container:hover .gig-pill-inner {
    transform: translateY(-2px);
    background: var(--btn-green-hover);
  }

  .pill-map-icon {
    font-size: 1rem;
  }

  .gig-pill-text-box {
    display: flex;
    flex-direction: column;
  }

  .gig-pill-tag {
    font-size: 0.58rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .gig-pill-location {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .pill-arrow-icon {
    font-size: 0.72rem;
    transition: transform 0.2s var(--ease-snappy);
  }

  .floating-gig-pill-container:hover .pill-arrow-icon {
    transform: translateX(2px);
  }
</style>
