---
const emails = [
  { address: "HelloKinsBand@gmail.com", desc: "Fan Updates & General Chat", icon: "fa-regular fa-paper-plane" },
  { address: "BookingsKinsBand@gmail.com", desc: "Shows, Tours & Live Booking", icon: "fa-regular fa-calendar-check" },
  { address: "PressKinsBand@gmail.com", desc: "Media, PR & Interviews", icon: "fa-solid fa-newspaper" },
  { address: "BusinessKinsBand@gmail.com", desc: "Brand Deals & Partnerships", icon: "fa-solid fa-briefcase" }
];
---

<section class="subscribe-section" id="subscribeFormSection">
  <div class="segmented-switcher-box subscribe-switcher">
    <button class="switcher-tab active" id="tabSubBtn" data-target="subscribeTab">
      Subscribe
    </button>
    <button class="switcher-tab" id="tabEmailBtn" data-target="emailsTab">
      Emails
    </button>
  </div>

  <div class="sub-tab-content active" id="subscribeTab">
    <div class="subscribe-card">
      <div id="subscribeFormContainer">
        <div class="substack-header-badge">
          <i class="fa-solid fa-bookmark"></i>
          <span>Substack Newsletter</span>
        </div>
        <h3>Subscribe to The Kins!</h3>
        <p class="subscribe-subtext">Join our Substack to receive new music, behind-the-scenes moments & gig drops.</p>

        <form id="subscribeForm" class="subscribe-form" action="https://kins.substack.com/api/v1/free" method="POST" target="_blank">
          <div class="form-group">
            <input type="email" name="email" id="emailInput" placeholder="Enter your email..." required autocomplete="email">
          </div>
          <button type="submit" class="green-submit-btn">
            <i class="fa-solid fa-envelope"></i>
            <span>Subscribe on Substack</span>
          </button>
        </form>
      </div>
      
      <!-- Prominent VIP Welcome Card + Welcome Email Message Preview -->
      <div id="subscribeSuccess" class="subscribe-success-card hidden">
        <div class="welcome-header">
          <div class="welcome-icon-circle">
            <i class="fa-solid fa-circle-check"></i>
          </div>
          <span class="subscriber-vip-tag">KINSCREW VIP MEMBER</span>
        </div>
        
        <h4 class="welcome-headline">Welcome to The Kins! 🎉</h4>
        
        <!-- Official Welcome Email Message Container -->
        <div class="welcome-email-preview-box">
          <div class="email-preview-header">
            <i class="fa-solid fa-envelope-open-text"></i>
            <span>Welcome Email Sent:</span>
          </div>
          <div class="welcome-email-body">
            <p>Hey,</p>
            <p>Thanks for joining The Kins!</p>
            <p>You'll be the first to hear about new music, covers, behind-the-scenes moments, gigs, and everything we're working on.</p>
            <p>If you've got a question, an idea, or just want to say hi, simply reply to this email. We'd love to hear from you and find out what you'd like to see from us.</p>
            <p class="folder-tip"><em>One last thing—if this email landed in your Promotions or Spam folder, move it to your Primary inbox so you don't miss future updates.</em></p>
            <p>Thanks for being here.<br>See you soon,</p>
            <p class="kins-sign-off">— KINS</p>
          </div>
        </div>

        <div class="post-sub-actions">
          <button id="unsubscribeBtn" class="unsubscribe-link-btn" type="button">
            <i class="fa-solid fa-user-minus"></i> Unsubscribe
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="sub-tab-content" id="emailsTab">
    <div class="emails-card">
      <h3>Official Contacts</h3>
      <p class="emails-subtext">Reach out to the Kins team for inquiries & partnerships.</p>

      <div class="emails-list">
        {emails.map((item) => (
          <div class="email-row-item">
            <div class="email-icon"><i class={item.icon}></i></div>
            <div class="email-details">
              <span class="email-address">{item.address}</span>
              <span class="email-desc">{item.desc}</span>
            </div>
            <button class="copy-email-btn" data-email={item.address} title="Copy Email">
              <i class="fa-regular fa-copy"></i>
            </button>
            <a href={`mailto:${item.address}`} class="send-email-btn" title="Send Email">
              <i class="fa-solid fa-arrow-up-right-from-square"></i>
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .subscribe-section {
    width: 100%;
    margin-top: 14px;
  }

  .segmented-switcher-box {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 3px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    margin-bottom: 12px;
    backdrop-filter: blur(12px);
  }

  .switcher-tab {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 9px 0;
    border-radius: 4px;
    cursor: pointer;
    text-align: center;
    transition: all 0.2s var(--ease-snappy);
  }

  .switcher-tab.active {
    background: var(--btn-green);
    color: var(--btn-text-color);
    font-weight: 800;
  }

  .sub-tab-content {
    display: none;
  }

  .sub-tab-content:global(.active) {
    display: block;
    animation: fadeInTab 0.25s var(--ease-snappy) forwards;
  }

  .subscribe-card, .emails-card {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    backdrop-filter: blur(12px);
  }

  .substack-header-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
    margin-bottom: 6px;
  }

  .subscribe-card h3, .emails-card h3 {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-white);
    letter-spacing: -0.01em;
  }

  .subscribe-subtext, .emails-subtext {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .subscribe-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 6px;
  }

  .form-group input {
    width: 100%;
    background: rgba(10, 10, 12, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 4px;
    padding: 12px 14px;
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.88rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .form-group input:focus {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .green-submit-btn {
    background: var(--btn-green);
    color: var(--btn-text-color);
    border: none;
    border-radius: 4px;
    padding: 12px;
    font-family: var(--font-secondary);
    font-weight: 800;
    font-size: 0.84rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: transform 0.18s var(--ease-snappy), background-color 0.18s ease;
    min-height: 48px;
  }

  .green-submit-btn:hover {
    background: var(--btn-green-hover);
    transform: translateY(-1px);
  }

  /* Prominent VIP Welcome Card & Welcome Email Container */
  .subscribe-success-card {
    background: rgba(24, 24, 28, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 6px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .welcome-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .welcome-icon-circle {
    width: 36px;
    height: 36px;
    border-radius: 4px;
    background: var(--btn-green);
    color: var(--btn-text-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
  }

  .subscriber-vip-tag {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 800;
    padding: 4px 8px;
    border-radius: 4px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .welcome-headline {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-white);
  }

  .welcome-email-preview-box {
    background: rgba(10, 10, 12, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .email-preview-header {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 6px;
  }

  .welcome-email-body {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.45;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .folder-tip {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .kins-sign-off {
    font-weight: 800;
    color: var(--text-white);
  }

  .post-sub-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 2px;
  }

  .unsubscribe-link-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: color 0.2s ease;
  }

  .unsubscribe-link-btn:hover {
    color: var(--accent-crimson);
  }

  .emails-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 6px;
  }

  .email-row-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(10, 10, 12, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 10px 12px;
  }

  .email-icon {
    font-size: 1rem;
    color: var(--text-muted);
    width: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .email-details {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .email-address {
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-white);
  }

  .email-desc {
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .copy-email-btn, .send-email-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-white);
    width: 32px;
    height: 32px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
    font-size: 0.78rem;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .copy-email-btn:hover, .send-email-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.25);
  }
</style>

<script>
  import { setupSegmentedSwitcher } from '../scripts/tabs.js';
  import { copyToClipboard } from '../../../shared/scripts/clipboard.js';
  import { showToast } from '../scripts/toast.js';

  setupSegmentedSwitcher('.subscribe-switcher .switcher-tab', '.sub-tab-content');

  const subscribeFormContainer = document.getElementById('subscribeFormContainer');
  const subscribeForm = document.getElementById('subscribeForm') as HTMLFormElement;
  const subscribeSuccess = document.getElementById('subscribeSuccess');
  const unsubscribeBtn = document.getElementById('unsubscribeBtn');

  function updateSubscribedUI(isSubscribed: boolean) {
    if (isSubscribed) {
      subscribeFormContainer?.classList.add('hidden');
      subscribeSuccess?.classList.remove('hidden');
    } else {
      subscribeFormContainer?.classList.remove('hidden');
      subscribeSuccess?.classList.add('hidden');
    }
  }

  if (localStorage.getItem('kins_subscribed') === 'true') {
    updateSubscribedUI(true);
  }

  if (subscribeForm) {
    subscribeForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('emailInput') as HTMLInputElement;
      if (emailInput && emailInput.value) {
        localStorage.setItem('kins_subscribed', 'true');
        updateSubscribedUI(true);
        showToast("🎉 Welcome to The Kins! Substack confirmation sent.");
      }
    });
  }

  if (unsubscribeBtn) {
    unsubscribeBtn.addEventListener('click', () => {
      localStorage.removeItem('kins_subscribed');
      updateSubscribedUI(false);
      showToast("You have unsubscribed from Kins updates.");
    });
  }

  document.querySelectorAll('.copy-email-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const email = btn.getAttribute('data-email');
      if (email) copyToClipboard(email);
    });
  });
</script>
