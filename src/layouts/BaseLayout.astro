---
import '../styles/global.css';
import PagePreloader from '../components/ui/PagePreloader.astro';
import LiveViewportFrame from '../components/live/LiveViewportFrame.astro';
import { siteConfig } from '../settings/site.config';
import { bandMembers } from '../settings/members.config';
import { epkConfig } from '../settings/epk.config';
import { bookingEmail } from '../settings/contact.config';

import { primaryStreams, primarySocials, primaryCommunity } from '../settings/links.config';
import { platformsData, isProfileUrl } from '../settings/platformsData';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = `${import.meta.env.BASE_URL}new.png`,
  url: urlProp,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const siteOrigin = siteConfig.siteUrl.endsWith('/') ? siteConfig.siteUrl : `${siteConfig.siteUrl}/`;
// Canonical: prefer explicit url prop, otherwise derive from Astro.url (correct per-page URL), fallback to siteUrl for 404/static edge cases
const rawUrl = urlProp ?? (Astro.url ? Astro.url.href : siteConfig.siteUrl);
const isLivePage = Astro.url ? Astro.url.pathname.endsWith('/live') || Astro.url.pathname.endsWith('/live/') : false;
const canonicalUrl = rawUrl.startsWith('http') ? rawUrl : new URL(rawUrl.replace(/^\//, ''), siteOrigin).href;
const absoluteImage = image.startsWith('http') ? image : new URL(image.replace(/^\//, ''), siteOrigin).href;

const sameAsUrls = [
  ...primaryStreams.map((s) => s.url),
  ...primarySocials.map((s) => s.url),
  ...primaryCommunity.map((c) => c.url)
].filter((u) => typeof u === 'string' && u.startsWith('http') && isProfileUrl(u));

// Only real artist profiles back the streaming FAQ answer.
const streamingProfiles = platformsData
  .filter((p) => p.category === 'streams' && isProfileUrl(p.url))
  .map((p) => p.name);
const streamingAnswer = streamingProfiles.length > 0
  ? `You can stream KINS on ${streamingProfiles.join(', ')}.`
  : 'KINS is releasing its first music soon. Join the mailing list on this page to hear it first.';

const musicGroupEntity = {
  '@type': 'MusicGroup',
  '@id': `${siteOrigin}#kins`,
  name: epkConfig.bandName,
  alternateName: [epkConfig.handle, 'Kins Band', 'KINS Newcastle', 'KINS Australia'],
  url: siteOrigin,
  image: absoluteImage,
  logo: absoluteImage,
  description: epkConfig.tagline,
  genre: [epkConfig.genreMain, ...(epkConfig.subGenres || [])],
  foundingDate: epkConfig.yearFormed,
  foundingLocation: {
    '@type': 'Place',
    name: 'Newcastle, NSW, Australia',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Newcastle',
      addressRegion: 'NSW',
      addressCountry: 'AU'
    }
  },
  knowsAbout: [
    'Post-Punk',
    'Alternative Rock',
    'Post-Punk Revival',
    'Indie Rock',
    'Australian Indie Rock',
    'Newcastle Music Scene',
    'Live Band Performance'
  ],
  sameAs: sameAsUrls,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'booking',
    email: bookingEmail
  },
  member: bandMembers.map((m) => ({
    '@type': 'Person',
    name: m.name,
    roleName: m.role,
    knowsAbout: m.instruments
  }))
};

const webSiteEntity = {
  '@type': 'WebSite',
  '@id': `${siteOrigin}#website`,
  url: siteOrigin,
  name: 'KINS Official Hub',
  description: siteConfig.description,
  publisher: { '@id': `${siteOrigin}#kins` },
  inLanguage: 'en-AU'
};

const faqEntity = {
  '@type': 'FAQPage',
  '@id': `${canonicalUrl}#faq`,
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Who is KINS?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'KINS is an Australian four-piece post-punk and alternative rock band from Newcastle, New South Wales, formed in 2024.'
      }
    },
    {
      '@type': 'Question',
      name: 'What genre does KINS play?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'KINS plays Post-Punk and Alternative Rock, featuring driving rhythm urgency, wall-of-sound guitar tones, and visceral live performance energy.'
      }
    },
    {
      '@type': 'Question',
      name: 'What artists sound like KINS?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'KINS is recommended if you like Fontaines D.C., IDLES, The Murder Capital, The Cure, and Gang of Youths.'
      }
    },
    {
      '@type': 'Question',
      name: 'Who are the band members of KINS?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The members of KINS are Vivian (Lead Vocals & Rhythm Guitar), Charlie (Lead Guitar & Backing Vocals), Oscar (Bass Guitar & Synthesizers), and Trai (Drums & Percussion).'
      }
    },
    {
      '@type': 'Question',
      name: 'Where is KINS based?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'KINS is based in Newcastle, New South Wales, Australia.'
      }
    },
    {
      '@type': 'Question',
      name: 'Where can I stream KINS music?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: streamingAnswer
      }
    }
  ]
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [musicGroupEntity, webSiteEntity, faqEntity]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="KINS, Kins Band, KinsBandOfficial, Newcastle band, Australian post punk, alternative rock, Fontaines DC, IDLES, The Murder Capital, Gang of Youths, Newcastle music">
  <link rel="canonical" href={canonicalUrl}>
  <link rel="alternate" hreflang="en" href={canonicalUrl} />
  <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

  <!-- Open Graph / Facebook Meta Tags -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:site_name" content="KINS">
  <meta property="og:locale" content="en_AU">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={absoluteImage}>
  <meta property="og:image:alt" content={`${epkConfig.bandName} — Official band website and music`}>

  <!-- Twitter Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={absoluteImage}>
  <meta name="twitter:image:alt" content={`${epkConfig.bandName} — Official band website and music`}>
  <meta name="twitter:creator" content="@KinsBandOfficial">

  <!-- Favicon & Touch Icons -->
  <link rel="icon" type="image/x-icon" href={`${baseUrl}favicon.ico`}>
  <link rel="icon" type="image/png" sizes="32x32" href={`${baseUrl}favicon-32x32.png`}>
  <link rel="icon" type="image/png" sizes="16x16" href={`${baseUrl}favicon-16x16.png`}>
  <link rel="apple-touch-icon" sizes="180x180" href={`${baseUrl}apple-touch-icon.png`}>

  <!-- PWA Manifest & App Capabilities -->
  <link rel="manifest" href={`${baseUrl}manifest.json`}>
  <meta name="theme-color" content={siteConfig.themeColor || "#0e0e0e"}>
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="KINS">
  <meta name="application-name" content="KINS">
  
  <!-- Apple Music & iTunes CDN Connection Warming -->
  <link rel="preconnect" href="https://itunes.apple.com">
  <link rel="dns-prefetch" href="https://itunes.apple.com">
  <link rel="preconnect" href="https://is1-ssl.mzstatic.com" crossorigin>
  <link rel="dns-prefetch" href="https://is1-ssl.mzstatic.com">
  <link rel="preconnect" href="https://is2-ssl.mzstatic.com" crossorigin>
  <link rel="dns-prefetch" href="https://is2-ssl.mzstatic.com">
  <link rel="preconnect" href="https://audio-ssl.itunes.apple.com" crossorigin>
  <link rel="dns-prefetch" href="https://audio-ssl.itunes.apple.com">

  <!-- Google Fonts: Syne, Cinzel, Space Grotesk with display=swap -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@700;800&display=swap">

  <!-- FontAwesome Icons (self-hosted) -->
  <link rel="preload" href={`${baseUrl}fonts/webfonts/fa-solid-900.woff2`} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={`${baseUrl}fonts/webfonts/fa-brands-400.woff2`} as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href={`${baseUrl}fonts/fontawesome/all.min.css`}>

  <!-- Lightweight Hardware & Theme Detector (Zero FOUC) -->
  <script is:inline>
    (function() {
      try {
        var savedTheme = null;
        try { savedTheme = localStorage.getItem('kins-theme'); } catch (_) {}
        if (savedTheme === 'standard') {
          document.documentElement.setAttribute('data-theme', 'standard');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
        }

        var isLowCpu = navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 4;
        var isLowRam = navigator.deviceMemory && navigator.deviceMemory <= 4;
        var isSaveData = navigator.connection && navigator.connection.saveData;
        var isSlowNet = navigator.connection && /(^2|slow-)2g$/.test(navigator.connection.effectiveType || '');
        if (isLowCpu || isLowRam || isSaveData || isSlowNet) {
          document.documentElement.classList.add('low-power-mode');
        }

        window.addEventListener('beforeinstallprompt', function(e) {
          e.preventDefault();
          window.__kinsDeferredInstallPrompt = e;
        });
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
  <!-- Vercel Web Analytics (cookieless, DNT-respecting) — script only exists when deployed -->
  <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
  {import.meta.env.PROD && <script is:inline defer src="/_vercel/insights/script.js"></script>}

</head>
<body>
  <PagePreloader />
  {!isLivePage && <LiveViewportFrame />}
  <slot />

  <script define:vars={{ baseUrl }}>
    // Register Service Worker for PWA
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register(`${baseUrl}sw.js`).catch(err => {
          console.log('ServiceWorker registration failed: ', err);
        });
      });
    }
  </script>

  <script>
    const scheduleIdle = window.requestIdleCallback || ((cb) => setTimeout(cb, 1));
    scheduleIdle(() => {
      import('../scripts/controllers/analyticsTelemetry.js')
        .then((m) => m.initAnalyticsTelemetry())
        .catch(() => {});
    });
  </script>
</body>
</html>
