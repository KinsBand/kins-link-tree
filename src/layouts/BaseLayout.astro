---
import '../styles/global.css';
import PagePreloader from '../components/ui/PagePreloader.astro';
import { siteConfig } from '../settings/site.config';
import { bandMembers } from '../settings/members.config';
import { epkConfig } from '../settings/epk.config';
import { bookingEmail } from '../settings/contact.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = `${import.meta.env.BASE_URL}new.png`,
  url = siteConfig.siteUrl
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;

const musicGroupSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: epkConfig.bandName,
  alternateName: epkConfig.handle,
  genre: epkConfig.genreMain,
  foundingLocation: epkConfig.origin,
  url,
  image,
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'booking',
    email: bookingEmail
  },
  member: bandMembers.map((m) => ({
    '@type': 'Person',
    name: m.name,
    role: m.role
  }))
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={url}>

  <script type="application/ld+json" set:html={JSON.stringify(musicGroupSchema)}></script>

  <!-- Open Graph / Facebook Meta Tags -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={url}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={image}>

  <!-- Twitter Meta Tags -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={image}>

  <!-- Favicon & Touch Icons -->
  <link rel="icon" type="image/x-icon" href={`${baseUrl}favicon.ico`}>
  <link rel="icon" type="image/png" sizes="32x32" href={`${baseUrl}favicon-32x32.png`}>
  <link rel="icon" type="image/png" sizes="16x16" href={`${baseUrl}favicon-16x16.png`}>
  <link rel="apple-touch-icon" sizes="180x180" href={`${baseUrl}apple-touch-icon.png`}>

  <!-- PWA Manifest & App Capabilities -->
  <link rel="manifest" href={`${baseUrl}manifest.json`}>
  <meta name="theme-color" content={siteConfig.themeColor || "#0e0e0e"}>
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="KINS">
  <meta name="application-name" content="KINS">
  
  <!-- Google Fonts: Syne, Cinzel, Space Grotesk with display=swap -->
  <!-- Non-render-blocking: fallback fonts paint instantly, webfonts swap in when ready -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@700;800&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@700;800&display=swap"></noscript>

  <!-- FontAwesome Icons (non-render-blocking) -->
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></noscript>

  <!-- Lightweight Hardware & Theme Detector (Zero FOUC) -->
  <script is:inline>
    (function() {
      try {
        var isLowCpu = navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 4;
        var isLowRam = navigator.deviceMemory && navigator.deviceMemory <= 4;
        var isSaveData = navigator.connection && navigator.connection.saveData;
        var isSlowNet = navigator.connection && /(^2|slow-)2g$/.test(navigator.connection.effectiveType || '');
        if (isLowCpu || isLowRam || isSaveData || isSlowNet) {
          document.documentElement.classList.add('low-power-mode');
        }

        var savedTheme = localStorage.getItem('kins-theme');
        if (savedTheme === 'dark' || (!savedTheme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.setAttribute('data-theme', 'standard');
        }

        window.addEventListener('beforeinstallprompt', function(e) {
          e.preventDefault();
          window.__kinsDeferredInstallPrompt = e;
        });
      } catch (e) {}
    })();
  </script>
  <!-- Vercel Web Analytics (cookieless, DNT-respecting) -->
  <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
  <script is:inline defer src="/_vercel/insights/script.js"></script>

</head>
<body>
  <PagePreloader />
  <slot />

  <script define:vars={{ baseUrl }}>
    // Register Service Worker for PWA
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register(`${baseUrl}sw.js`).catch(err => {
          console.log('ServiceWorker registration failed: ', err);
        });
      });
    }
  </script>

  <script>
    const scheduleIdle = window.requestIdleCallback || ((cb) => setTimeout(cb, 1));
    scheduleIdle(() => {
      import('../scripts/controllers/analyticsTelemetry.js')
        .then((m) => m.initAnalyticsTelemetry())
        .catch(() => {});
    });
  </script>
</body>
</html>
