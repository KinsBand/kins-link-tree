---
---

<div class="modal-backdrop cover-video-modal-backdrop hidden" id="coverVideoModal" role="dialog" aria-modal="true" aria-label="Cover Video Player" data-track-container="modal:cover_video">
  <div class="cover-video-modal-container">
    <!-- Header Bar: Category Badge (Left) & Icon-Only Close Button (Right) -->
    <div class="video-modal-top-bar">
      <div class="cover-modal-category-badge" id="modalCoverCategoryBadge">
        <i class="fa-solid fa-guitar" id="modalCoverCategoryIcon" aria-hidden="true"></i>
        <span id="modalCoverCategoryLabel">Full Band Cover</span>
      </div>
      <button class="close-video-modal-btn brutal-press" id="closeCoverVideoModal" aria-label="Close video player" data-track="cover_video:close">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>

    <!-- Responsive Embedded Video Frame with Custom Overlay Controls -->
    <div class="video-iframe-wrapper" id="videoIframeWrapper">
      <iframe id="coverVideoIframe" src="" title="Kins Cover Video" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>

      <!-- Video Controls Overlay: toggle on click/tap -->
      <div class="video-controls-overlay" id="videoControlsOverlay">
        <!-- Top Overlay Controls Bar: Quality in Top-Right -->
        <div class="video-overlay-top-bar">
          <div class="video-overlay-quality-wrapper">
            <button type="button" class="video-overlay-icon-btn brutal-press" id="videoQualityBtn" aria-label="Video quality settings" title="Video Quality">
              <i class="fa-solid fa-gear" aria-hidden="true"></i>
            </button>
            <div class="video-quality-dropdown hidden" id="videoQualityDropdown">
              <button type="button" class="quality-opt-btn active" data-quality="1080p">1080p HD</button>
              <button type="button" class="quality-opt-btn" data-quality="720p">720p</button>
              <button type="button" class="quality-opt-btn" data-quality="Auto">Auto</button>
            </div>
          </div>
        </div>

        <!-- Center Play/Pause Big Button -->
        <button type="button" class="video-overlay-center-play brutal-press" id="videoPlayPauseBtn" aria-label="Play or pause video">
          <i class="fa-solid fa-pause" id="videoPlayPauseIcon" aria-hidden="true"></i>
        </button>

        <!-- Bottom Overlay Controls Bar: Hint (Left) & Fullscreen/Landscape (Bottom-Right) -->
        <div class="video-overlay-bottom-bar">
          <div class="video-overlay-hint">
            <span>Tap to toggle controls</span>
          </div>

          <button type="button" class="video-overlay-icon-btn brutal-press" id="videoFullscreenBtn" aria-label="Fullscreen and landscape mode" title="Fullscreen / Landscape">
            <i class="fa-solid fa-expand" id="videoFullscreenIcon" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Cover Info Metadata -->
    <div class="cover-video-meta-box">
      <div class="cover-modal-header-stack">
        <div class="cover-modal-title-row">
          <h3 class="cover-modal-headline" id="modalCoverSongTitle">Everlong</h3>
          <a href="https://www.songsterr.com" target="_blank" rel="noopener noreferrer" class="cover-modal-tabs-btn brutal-press" id="modalSongsterrBtn" aria-label="Learn tabs on Songsterr" data-track="cover_video:songsterr">
            <i class="fa-solid fa-guitar" aria-hidden="true"></i>
            <span>Tabs ↗</span>
          </a>
        </div>
        <p class="cover-modal-artist-line">Original by <span id="modalCoverArtistName">Foo Fighters</span></p>
      </div>
      <p class="cover-modal-subline" id="modalCoverSubline">
        <i class="fa-solid fa-guitar" id="modalCoverSublineIcon" aria-hidden="true"></i>
        <span id="modalCoverPerformanceText">Cover by <strong>Kins Band</strong></span>
      </p>

      <!-- Metadata Stats Strip: Views, Comments, and Duration -->
      <div class="cover-modal-stats-strip" id="modalCoverStatsStrip">
        <span class="stat-pill" title="Views">
          <i class="fa-solid fa-eye" aria-hidden="true"></i>
          <span id="modalCoverViews">24.5K views</span>
        </span>
        <span class="stat-pill" title="Comments">
          <i class="fa-regular fa-comment" aria-hidden="true"></i>
          <span id="modalCoverComments">42 comments</span>
        </span>
        <span class="stat-pill" title="Duration">
          <i class="fa-regular fa-clock" aria-hidden="true"></i>
          <span id="modalCoverDuration">4:10</span>
        </span>
      </div>
    </div>

    <!-- Dedicated Social & Setlist Action Bar: Watch & Req. Setlist -->
    <div class="social-action-bar-container">
      <a href="https://www.youtube.com/@KinsBandOfficial" target="_blank" rel="noopener noreferrer" class="social-action-btn primary-action brutal-press" id="modalWatchNativeBtn" aria-label="Watch video" data-track="cover_video:watch_native">
        <i class="fa-brands fa-youtube" aria-hidden="true"></i>
        <span>Watch ↗</span>
      </a>

      <button type="button" class="social-action-btn tertiary-action setlist-request-action brutal-press" id="modalSetlistRequestBtn" aria-label="Request song for Kins live setlist" title="142 fans thought the same" data-track="cover_video:request_setlist">
        <span class="modal-setlist-main">
          <i class="fa-solid fa-fire" id="modalSetlistIcon" aria-hidden="true"></i>
          <span id="modalSetlistBtnText">Req. Setlist</span>
        </span>
        <span class="modal-setlist-chip" id="modalSetlistChip">
          <strong id="modalCoverEvidenceCount">142</strong>
        </span>
      </button>
    </div>

  </div>
</div>

<style>
  .cover-video-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(14px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-snappy);
  }

  .cover-video-modal-backdrop:global(.active) {
    opacity: 1;
    pointer-events: auto;
  }

  .cover-video-modal-backdrop.is-closing {
    opacity: 0 !important;
    pointer-events: none !important;
    transition: opacity 0.18s ease !important;
  }

  .cover-video-modal-container {
    background: #141418;
    border: 3px solid #000000;
    border-radius: 10px;
    width: 100%;
    max-width: 450px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: 6px 6px 0px #000000;
    transform: scale(0.95);
    transition: transform 0.25s var(--ease-snappy);
  }

  .cover-video-modal-backdrop:global(.active) .cover-video-modal-container {
    transform: scale(1);
  }

  .cover-video-modal-backdrop.is-closing .cover-video-modal-container {
    transform: scale(0.95) translateY(8px) !important;
    opacity: 0 !important;
    transition: transform 0.18s var(--ease-tactile), opacity 0.16s ease !important;
  }

  .video-modal-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .cover-modal-category-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--btn-brand-primary, #f2fd43);
    color: var(--btn-brand-text, #000000);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 5px 12px;
    font-family: var(--font-heading);
    font-size: 0.74rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    user-select: none;
  }

  .cover-modal-category-badge i {
    font-size: 0.75rem;
    color: #000000;
  }

  .close-video-modal-btn {
    background: var(--surface-card-panel, #f5f4ef);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: #000000;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.92rem;
    transition: transform 0.16s var(--ease-tactile, cubic-bezier(0.2, 0.8, 0.2, 1)), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
    flex-shrink: 0;
    padding: 0;
  }

  .close-video-modal-btn:hover {
    background: var(--btn-brand-primary, #f2fd43);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .close-video-modal-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .video-iframe-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    overflow: hidden;
    background: #000000;
    box-shadow: 3px 3px 0px #000000;
    border: 2px solid #000000;
  }

  .video-iframe-wrapper iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    pointer-events: none; /* Suppress native YouTube player hover cards and overlays */
  }

  .video-controls-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    padding: 8px;
    background: rgba(0, 0, 0, 0.38);
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.22s ease;
    z-index: 10;
  }

  .video-controls-overlay.controls-hidden {
    background: transparent;
  }

  .video-overlay-top-bar {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    transition: opacity 0.2s ease, transform 0.2s var(--ease-snappy);
  }

  .video-overlay-bottom-bar {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    transition: opacity 0.2s ease, transform 0.2s var(--ease-snappy);
  }

  .video-controls-overlay.controls-hidden .video-overlay-top-bar,
  .video-controls-overlay.controls-hidden .video-overlay-center-play,
  .video-controls-overlay.controls-hidden .video-overlay-bottom-bar {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.9);
  }

  .video-overlay-quality-wrapper {
    position: relative;
  }

  .video-overlay-icon-btn {
    background: rgba(14, 14, 18, 0.88);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: #ffffff;
    border-radius: 6px;
    width: 32px;
    height: 32px;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease;
  }

  .video-overlay-icon-btn i {
    font-size: 0.82rem;
  }

  .video-overlay-icon-btn:hover {
    background: var(--btn-brand-primary, #f2fd43);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .video-quality-dropdown {
    position: absolute;
    top: calc(100% + 5px);
    right: 0;
    background: #18181c;
    border: 2px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    z-index: 25;
    min-width: 90px;
  }

  .video-quality-dropdown.hidden {
    display: none !important;
  }

  .quality-opt-btn {
    background: transparent;
    border: none;
    color: #f5f5f7;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 7px 10px;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.14s ease, color 0.14s ease;
  }

  .quality-opt-btn:hover,
  .quality-opt-btn.active {
    background: var(--btn-brand-primary, #f2fd43);
    color: #000000;
  }

  .video-overlay-center-play {
    width: 46px;
    height: 46px;
    border-radius: 8px;
    background: var(--btn-brand-primary, #f2fd43);
    color: #000000;
    border: 2.5px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }

  .video-overlay-center-play:hover {
    background: var(--btn-brand-hover, #faff60);
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px #000000;
  }

  .video-overlay-hint {
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(0, 0, 0, 0.6);
    padding: 2px 6px;
    border-radius: 4px;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .cover-video-meta-box {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cover-modal-header-stack {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cover-modal-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .cover-modal-headline {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-white, #ffffff);
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin: 0;
  }

  .cover-modal-tabs-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--surface-card-panel, #f5f4ef);
    color: var(--text-card-primary, #000000);
    border: 1.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    border-radius: var(--radius-sm, 6px);
    padding: 3px 8px;
    font-family: var(--font-heading, sans-serif);
    font-size: 0.68rem;
    font-weight: 800;
    text-decoration: none;
    line-height: 1;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile, cubic-bezier(0.2, 0.8, 0.2, 1)), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .cover-modal-tabs-btn:hover {
    background: var(--surface-card-panel-hover, #ffffff);
    color: var(--text-card-primary, #000000);
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0px #000000;
  }

  .cover-modal-tabs-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 0.5px 0.5px 0px #000000;
  }

  .cover-modal-tabs-btn:focus-visible {
    outline: 2px solid var(--brand-accent-primary);
    outline-offset: 2px;
  }

  .cover-modal-tabs-btn i {
    font-size: 0.62rem;
    color: currentColor;
  }

  :global([data-theme="dark"]) .cover-modal-tabs-btn {
    background: #1c1c24;
    color: var(--text-on-dark, #f5f5f7);
    border-color: #33333f;
    box-shadow: 1.5px 1.5px 0px #000000;
  }

  :global([data-theme="dark"]) .cover-modal-tabs-btn:hover {
    background: #262630;
    color: var(--brand-accent-primary, #d4af37);
    border-color: var(--brand-accent-primary, #d4af37);
  }

  :global([data-theme="dark"]) .cover-modal-tabs-btn i {
    color: var(--brand-accent-primary, #d4af37);
  }

  .cover-modal-artist-line {
    font-family: var(--font-secondary, sans-serif);
    font-size: 0.82rem;
    color: var(--text-muted, #a1a1aa);
    margin: 0;
  }

  .cover-modal-artist-line span {
    color: var(--text-white, #f4f4f6);
    font-weight: 700;
  }

  .cover-modal-subline {
    font-family: var(--font-secondary, sans-serif);
    font-size: 0.78rem;
    color: var(--text-muted, #8e8e93);
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
  }

  .cover-modal-subline i {
    color: var(--brand-accent-primary, #f2fd43);
  }

  .cover-modal-stats-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 3px;
  }

  .stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #1c1c22;
    border: 1.5px solid #2d2d38;
    color: var(--text-muted, #a1a1aa);
    padding: 3px 8px;
    border-radius: 4px;
    font-family: var(--font-secondary, sans-serif);
    font-size: 0.70rem;
    font-weight: 600;
    line-height: 1;
    user-select: none;
  }

  .stat-pill i {
    font-size: 0.68rem;
    color: var(--brand-accent-primary, #f2fd43);
  }

  .stat-pill-highlight {
    background: rgba(242, 253, 67, 0.12);
    border-color: rgba(242, 253, 67, 0.4);
    color: #f5f5f7;
    font-weight: 700;
  }

  .stat-pill-highlight i {
    color: var(--btn-brand-primary, #f2fd43);
  }

  .social-action-bar-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    background: #0c0c10;
    border: 2px solid #000000;
    padding: 6px;
    border-radius: 8px;
    box-shadow: 2px 2px 0px #000000;
    margin-top: 2px;
  }

  .social-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 9px 8px;
    border-radius: 6px;
    text-decoration: none;
    font-family: var(--font-heading, sans-serif);
    font-size: 0.74rem;
    font-weight: 800;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    transition: transform 0.16s var(--ease-tactile, cubic-bezier(0.2, 0.8, 0.2, 1)), background-color 0.16s ease, border-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
    white-space: nowrap;
    cursor: pointer;
    line-height: 1;
    min-width: 0;
    width: 100%;
  }

  .social-action-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .social-action-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .social-action-btn span {
    white-space: nowrap;
  }

  .primary-action {
    background: var(--btn-brand-primary, #f2fd43);
    color: var(--btn-brand-text, #000000);
  }

  .primary-action:hover {
    background: var(--btn-brand-hover, #faff60);
    color: #000000;
  }

  .secondary-action {
    background: var(--surface-card-panel, #f5f4ef);
    color: var(--text-card-primary, #000000);
    padding: 9px 10px;
  }

  .secondary-action:hover {
    background: #ffffff;
    color: #000000;
  }

  .tertiary-action {
    background: #1c1c24;
    color: var(--brand-accent-primary, #f2fd43);
    padding: 9px 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
  }

  .tertiary-action:hover {
    background: #252530;
    color: #ffffff;
  }

  .modal-setlist-main {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    line-height: 1;
  }

  .modal-setlist-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(242, 253, 67, 0.16);
    color: var(--brand-accent-primary, #f2fd43);
    padding: 2px 6px;
    border-radius: 9999px;
    font-size: 0.68rem;
    font-family: var(--font-secondary, sans-serif);
    font-weight: 800;
    line-height: 1;
    transition: transform 0.2s var(--ease-snappy), background-color 0.2s ease, color 0.2s ease;
  }

  :global([data-theme="dark"]) .modal-setlist-chip {
    background: rgba(212, 175, 55, 0.18);
    color: var(--brand-accent-primary, #d4af37);
  }

  .tertiary-action.voted {
    background: var(--btn-brand-primary, #f2fd43);
    color: #000000;
    border-color: #000000;
    font-weight: 900;
  }

  .tertiary-action.voted i {
    color: #000000;
  }

  .tertiary-action.voted .modal-setlist-chip {
    background: rgba(0, 0, 0, 0.16);
    color: #000000;
  }

  :global([data-theme="dark"]) .tertiary-action.voted {
    background: var(--btn-brand-primary, #d4af37);
    color: #000000;
  }

  .modal-setlist-chip.chip-bump {
    transform: scale(1.18);
  }

  @media (max-width: 440px) {
    .social-action-bar-container {
      grid-template-columns: 1fr 1fr !important;
      gap: 5px;
      padding: 5px;
    }
    .social-action-btn {
      padding: 8px 6px;
      font-size: 0.70rem;
      gap: 4px;
    }
    .social-action-btn i {
      font-size: 0.70rem;
    }
  }

  /* Fullscreen & Landscape Enhancements */
  .video-iframe-wrapper:fullscreen,
  .video-iframe-wrapper:-webkit-full-screen {
    width: 100vw !important;
    height: 100vh !important;
    max-width: 100vw !important;
    max-height: 100vh !important;
    aspect-ratio: auto !important;
    border-radius: 0 !important;
    border: none !important;
    box-shadow: none !important;
  }

  /* Simulated Mobile Landscape (for iOS Safari & mobile devices) */
  @media (max-width: 768px) {
    .cover-video-modal-container.is-mobile-landscape {
      position: fixed !important;
      inset: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      max-width: 100vw !important;
      max-height: 100vh !important;
      border-radius: 0 !important;
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      margin: 0 !important;
      z-index: 10001 !important;
      background: #000000 !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
      align-items: center !important;
    }

    .cover-video-modal-container.is-mobile-landscape .video-modal-top-bar,
    .cover-video-modal-container.is-mobile-landscape .cover-video-meta-box,
    .cover-video-modal-container.is-mobile-landscape .social-action-bar-container {
      display: none !important;
    }

    .cover-video-modal-container.is-mobile-landscape .video-iframe-wrapper {
      width: 100% !important;
      height: 100% !important;
      max-width: 100% !important;
      max-height: 100% !important;
      aspect-ratio: auto !important;
      border-radius: 0 !important;
      border: none !important;
      box-shadow: none !important;
    }

