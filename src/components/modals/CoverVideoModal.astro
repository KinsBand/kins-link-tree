---
---

<div class="modal-backdrop cover-video-modal-backdrop" id="coverVideoModal">
  <div class="cover-video-modal-container">
    <!-- Header Close Bar -->
    <div class="video-modal-top-bar">
      <button class="close-video-modal-btn" id="closeCoverVideoModal" aria-label="Close video player">
        <i class="fa-solid fa-xmark"></i>
        <span>Close</span>
      </button>
    </div>

    <!-- Responsive Embedded Video Frame -->
    <div class="video-iframe-wrapper">
      <iframe id="coverVideoIframe" src="" title="Kins Cover Video" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
    </div>

    <!-- Cover Info Metadata -->
    <div class="cover-video-meta-box">
      <h3 class="cover-modal-headline">
        Cover: <span id="modalCoverSongTitle">"Everlong"</span> — <span id="modalCoverArtistName">Foo Fighters</span>
      </h3>
      <p class="cover-modal-subline"><i class="fa-solid fa-guitar" style="color: var(--btn-green);"></i> Performed live by <strong>Kins Band</strong></p>
    </div>

    <!-- Dedicated Social Action Bar -->
    <div class="social-action-bar-container">
      <a href="#" target="_blank" rel="noopener" class="social-action-btn primary-action" id="modalWatchNativeBtn">
        <i class="fa-brands fa-youtube"></i>
        <span>Watch Native ↗</span>
      </a>

      <a href="#" target="_blank" rel="noopener" class="social-action-btn secondary-action" id="modalCommentBtn">
        <i class="fa-regular fa-comment"></i>
        <span id="modalCommentCountText">42 Comments</span>
      </a>

      <a href="#" target="_blank" rel="noopener" class="social-action-btn tertiary-action" id="modalFollowBtn">
        <i class="fa-solid fa-user-plus"></i>
        <span>+ Follow Band ↗</span>
      </a>
    </div>

  </div>
</div>

<style>
  .cover-video-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(14px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-snappy);
  }

  .cover-video-modal-backdrop:global(.active) {
    opacity: 1;
    pointer-events: auto;
  }

  .cover-video-modal-container {
    background: rgba(18, 18, 20, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    width: 100%;
    max-width: 440px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.9);
    transform: scale(0.95);
    transition: transform 0.25s var(--ease-snappy);
  }

  .cover-video-modal-backdrop:global(.active) .cover-video-modal-container {
    transform: scale(1);
  }

  .video-modal-top-bar {
    display: flex;
    justify-content: flex-end;
  }

  .close-video-modal-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-white);
    padding: 6px 12px;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: background-color 0.18s ease;
  }

  .close-video-modal-btn:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .video-iframe-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    overflow: hidden;
    background: #000000;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .video-iframe-wrapper iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .cover-video-meta-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cover-modal-headline {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-white);
  }

  .cover-modal-subline {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .social-action-bar-container {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1.1fr;
    gap: 6px;
    background: rgba(10, 10, 12, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 6px;
    border-radius: 4px;
    margin-top: 4px;
  }

  .social-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 9px 8px;
    border-radius: 4px;
    text-decoration: none;
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 800;
    transition: transform 0.18s var(--ease-snappy), background-color 0.18s ease;
    white-space: nowrap;
  }

  .primary-action {
    background: var(--btn-green);
    color: var(--btn-text-color);
  }

  .primary-action:hover {
    background: var(--btn-green-hover);
    transform: translateY(-1px);
  }

  .secondary-action {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-white);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .secondary-action:hover {
    background: rgba(255, 255, 255, 0.16);
    transform: translateY(-1px);
  }

  .tertiary-action {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-muted);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .tertiary-action:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--text-white);
    transform: translateY(-1px);
  }
</style>

<script>
  import { initCoverVideoModalController } from '../../scripts/controllers/videoModalController.js';
  initCoverVideoModalController();
</script>
