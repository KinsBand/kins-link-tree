---
---

<div class="bottom-sheet-backdrop hidden" id="gigMapModal" role="dialog" aria-modal="true" aria-label="Kins Live Tour & Gig Map" data-track-container="modal:gig_map">
  <div class="bottom-sheet-container" id="bottomSheetContainer">
    
    <!-- Full-Screen Interactive Map Canvas -->
    <div class="map-view-wrapper" id="mapViewWrapper">
      <div class="gig-map-view" id="gigMapView"></div>

      <!-- Top Modal Header Bar (Floating Glass) -->
      <div class="gig-top-header-bar">
        <div class="gig-header-titles">
          <div class="gig-live-tag-row">
            <span class="live-pulse-dot"></span>
            <span class="gig-kicker">KINS LIVE TOUR</span>
          </div>
          <h3 class="gig-modal-heading">Sydney & Newcastle</h3>
        </div>
        <button class="close-sheet-btn" id="closeGigMapSheet" aria-label="Close Gig Map" title="Close Gig Map (Esc)" data-track="gig_map:close">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Floating Map Control Buttons (Top-Right) -->
      <div class="map-floating-overlay-controls">
        <button type="button" class="map-control-glass-btn" id="mapFitBoundsBtn" title="Fit all tour venues in view" aria-label="Fit All Venues" data-track="gig_map:fit_bounds">
          <i class="fa-solid fa-expand"></i>
        </button>
        <button type="button" class="map-control-glass-btn desktop-only" id="toggleMapDetailsBtn" title="Toggle venue details panel" aria-label="Toggle Details Panel" data-track="gig_map:toggle_details">
          <i class="fa-solid fa-layer-group"></i>
        </button>
      </div>
    </div>

    <!-- 3. Bottom: Venue Detail Card / Bottom Sheet (Tier 1 vs Tier 2, 55vh Max Expansion) -->
    <div 
      class="venue-detail-bottom-card is-peek" 
      id="venueDetailBottomCard" 
      role="region" 
      aria-label="Venue and Tour Details" 
      aria-expanded="false"
      data-snap-state="peek"
      tabindex="0"
    >
      
      <!-- Connected Floating Top Stack: Filter Button (Top) + Location Widget (Middle, connected to top of bottom menu) -->
      <div class="gig-bottom-sheet-attached-header" id="gigAttachedTopStack">
        <!-- 1. Top: Horizontal Expanding Filter Toolbar (Left-Anchored, Expands Right) -->
        <div class="expanding-filter-toolbar" id="expandingFilterToolbar">
          <button type="button" class="filter-toggle-icon-btn" id="gigFilterToggleBtn" aria-label="Toggle Tour Filters" title="Filter Shows (All / Upcoming / Archived)">
            <i class="fa-solid fa-sliders"></i>
            <span class="filter-active-dot" id="filterActiveDot"></span>
          </button>
          
          <div class="filter-chips-expandable" id="filterChipsExpandable" role="tablist" aria-label="Filter Tour Shows">
            <button type="button" class="gig-filter-tab active" data-filter="all" role="tab" aria-selected="true">
              <i class="fa-solid fa-border-all"></i>
              <span>All (10)</span>
            </button>
            <button type="button" class="gig-filter-tab" data-filter="upcoming" role="tab" aria-selected="false">
              <i class="fa-solid fa-fire-flame-curved"></i>
              <span>Upcoming (4)</span>
            </button>
            <button type="button" class="gig-filter-tab" data-filter="past" role="tab" aria-selected="false">
              <i class="fa-solid fa-box-archive"></i>
              <span>Archived (6)</span>
            </button>
          </div>
        </div>

        <!-- 2. Middle: Gig Location Widget / Quick Venue Selectors -->
        <div class="gig-selector-pills-row" id="gigSelectorPillsRow" role="region" aria-label="Quick Venue Selectors">
          <!-- Populated dynamically by gigMap.js -->
        </div>
      </div>

      <!-- Persistent Drag / Tap Handle Bar (Mobile Only) -->
      <div 
        class="sheet-drag-handle" 
        id="sheetDragHandle" 
        role="button" 
        tabindex="0"
        aria-label="Drag or tap to expand venue details (Snap: Peek 214px, Expanded 55vh)"
        title="Drag up or tap to expand"
      >
        <div class="drag-bar-pill"></div>
      </div>
      
      <!-- Sticky Header Block -->
      <div class="venue-card-header" id="venueCardHeader">
        <!-- Row 1: Venue Title + Badge -->
        <div class="venue-title-full-row">
          <h4 class="venue-card-name" id="venueCardName" title="Select a venue on the map">Select a venue on the map</h4>
          
          <div class="header-badges-group">
            <span class="venue-urgency-pill hidden" id="venueUrgencyPill"><i class="fa-solid fa-fire"></i> IN 8 DAYS</span>
            <span class="venue-archive-badge hidden" id="venueArchiveBadge"><i class="fa-solid fa-box-archive"></i> TOUR ARCHIVE</span>
            
            <!-- Desktop Snap Toggle -->
            <button 
              type="button" 
              class="desktop-snap-toggle-btn" 
              id="desktopSnapToggleBtn" 
              aria-label="Toggle Details Panel Expansion"
              title="Expand / Collapse details panel"
            >
              <i class="fa-solid fa-chevron-up"></i>
            </button>
          </div>
        </div>
        
        <!-- Row 2: Sub-meta Location & Date -->
        <div class="venue-sub-meta-line" id="venueSubMetaLine">
          <span class="venue-sub-location" id="venueCardLocation">Newcastle West</span>
          <span class="meta-dot">•</span>
          <span class="venue-sub-date" id="venuePeekDate">Sat, Aug 22, 2026</span>
        </div>

        <!-- Multi-show Timeline Bar -->
        <div class="venue-edition-timeline-bar hidden" id="venueEditionTimelineBar">
          <div class="timeline-bar-header">
            <span class="timeline-bar-label"><i class="fa-solid fa-clock-rotate-left"></i> Shows At This Venue</span>
          </div>
          <div class="timeline-bar-pills" id="timelineBarPills"></div>
        </div>

        <!-- Row 3: Full-Width Primary CTA Button -->
        <div class="venue-primary-cta-wrap">
          <!-- Upcoming CTA: Get Tickets -->
          <a href="https://www.bandsintown.com" target="_blank" rel="noopener" class="venue-booking-btn" id="venueBookingBtn" aria-label="Get tickets for this show">
            <i class="fa-solid fa-bolt"></i>
            <span id="venueBookingBtnText">GET TICKETS — $15 (EARLY BIRD)</span>
            <i class="fa-solid fa-arrow-up-right-from-square launch-icon"></i>
          </a>
          
          <!-- Archived CTA: I Was There Fan Check-in Button -->
          <button type="button" class="venue-checkin-btn hidden" id="venueCheckinBtn" aria-label="Check in to show">
            <i class="fa-solid fa-ticket"></i>
            <span id="venueCheckinBtnText">340 FANS ATTENDED • "I WAS THERE" (✓)</span>
          </button>
        </div>
      </div>

      <!-- Expandable Drawer Content (Tier 2 Body) -->
      <div class="venue-expanded-content" id="venueExpandedContent">
        <!-- Dynamic rich container populated by gigMap.js -->
        <div class="venue-dynamic-body" id="venueDynamicBody">
          <!-- Populated dynamically based on event type -->
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Concert Photo Lightbox Modal -->
<div class="gig-lightbox-backdrop hidden" id="gigPhotoLightbox" role="dialog" aria-modal="true" aria-label="Concert Photo Preview">
  <div class="gig-lightbox-content">
    <button type="button" class="gig-lightbox-close" id="gigLightboxClose" aria-label="Close photo preview">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <img src="" alt="Concert Photo" class="gig-lightbox-img" id="gigLightboxImg" loading="lazy">
    <div class="gig-lightbox-caption" id="gigLightboxCaption">Concert Photo • Kins Live</div>
  </div>
</div>

<style>
  /* ==========================================================================
     KINS NEO-BRUTALIST GIG MAP & TOUR BOTTOM SHEET
     ========================================================================== */

  .bottom-sheet-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 14, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.22s var(--ease-snappy), visibility 0.22s;
  }

  .bottom-sheet-backdrop.hidden,
  .bottom-sheet-backdrop:not(:global(.active)) {
    opacity: 0 !important;
    pointer-events: none !important;
    visibility: hidden !important;
    display: none !important;
  }

  .bottom-sheet-backdrop:global(.active) {
    opacity: 1 !important;
    pointer-events: auto !important;
    visibility: visible !important;
    display: flex !important;
  }

  .bottom-sheet-container {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background: var(--bg-chalkboard);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: translateY(16px);
    opacity: 0;
    transition: transform 0.26s var(--ease-snappy), opacity 0.22s ease;
    position: relative;
  }

  .bottom-sheet-backdrop:global(.active) .bottom-sheet-container {
    transform: translateY(0);
    opacity: 1;
  }

  /* --- TOP MODAL HEADER BAR --- */
  .gig-top-header-bar {
    position: absolute;
    top: 14px;
    left: 14px;
    right: 14px;
    z-index: 450;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 8px;
    padding: 9px 14px;
    pointer-events: auto;
    box-sizing: border-box;
  }

  .gig-header-titles {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .gig-live-tag-row {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .live-pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.9);
    animation: livePulseAnim 2s infinite ease-in-out;
  }

  @keyframes livePulseAnim {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .gig-kicker {
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-card-muted);
  }

  .gig-modal-heading {
    font-family: var(--font-heading);
    font-size: 1.02rem;
    font-weight: 900;
    color: var(--text-card-primary);
    letter-spacing: -0.015em;
    margin: 0;
    line-height: 1.15;
  }

  .close-sheet-btn {
    background: var(--surface-card-light-hover);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    width: 32px;
    height: 32px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    flex-shrink: 0;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
  }

  .close-sheet-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .close-sheet-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  /* --- MAP VIEW WRAPPER --- */
  .map-view-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    flex: 1 1 auto;
    min-height: 0;
    z-index: 1;
  }

  .gig-map-view {
    width: 100%;
    height: 100%;
    min-height: 200px;
    background: #111114;
  }

  /* Floating Map Overlay Controls (Top-Right) */
  .map-floating-overlay-controls {
    position: absolute;
    top: 76px;
    right: 14px;
    z-index: 450;
    display: flex;
    flex-direction: column;
    gap: 8px;
    pointer-events: auto;
  }

  .map-control-glass-btn {
    background: var(--surface-card-light);
    border: 2.5px solid #000000;
    box-shadow: 2.5px 2.5px 0px #000000;
    color: var(--text-card-primary);
    width: 36px;
    height: 36px;
    border-radius: 6px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
    user-select: none;
    position: relative;
  }

  .map-control-glass-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 3.5px 3.5px 0px #000000;
  }

  .map-control-glass-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .map-control-glass-btn.is-active {
    background: var(--accent-neon-yellow);
    color: #000000;
    box-shadow: 2.5px 2.5px 0px #000000;
  }

  .desktop-only,
  .map-control-glass-btn.desktop-only {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  /* Leaflet Neo-Brutalist Zoom Controls */
  :global(.leaflet-top.leaflet-left) {
    top: 76px !important;
    left: 14px !important;
    pointer-events: auto !important;
  }

  :global(.leaflet-control-zoom.leaflet-bar) {
    border: 2.5px solid #000000 !important;
    border-radius: 6px !important;
    overflow: hidden !important;
    background: var(--surface-card-light) !important;
    box-shadow: 2.5px 2.5px 0px #000000 !important;
    display: flex !important;
    flex-direction: column !important;
    margin: 0 !important;
  }

  :global(.leaflet-control-zoom-in),
  :global(.leaflet-control-zoom-out) {
    width: 36px !important;
    height: 36px !important;
    line-height: 34px !important;
    background: var(--surface-card-light) !important;
    color: var(--text-card-primary) !important;
    border: none !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-family: var(--font-secondary), -apple-system, sans-serif !important;
    font-size: 1.15rem !important;
    font-weight: 900 !important;
    cursor: pointer !important;
    transition: background-color 0.16s ease, color 0.16s ease !important;
    user-select: none !important;
    text-decoration: none !important;
    padding: 0 !important;
  }

  :global(.leaflet-control-zoom-in) {
    border-bottom: 2px solid #000000 !important;
  }

  :global(.leaflet-control-zoom-out) {
    border-bottom: none !important;
  }

  :global(.leaflet-control-zoom-in span),
  :global(.leaflet-control-zoom-out span) {
    line-height: 1 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    transform: translateY(-1px) !important;
    font-size: 1.15rem !important;
    font-weight: 800 !important;
  }

  :global(.leaflet-control-zoom-in:hover),
  :global(.leaflet-control-zoom-out:hover) {
    background: var(--accent-neon-yellow) !important;
    color: #000000 !important;
  }

  :global(.leaflet-control-zoom-in:active),
  :global(.leaflet-control-zoom-out:active) {
    background: #000000 !important;
    color: var(--accent-neon-yellow) !important;
  }

  :global(.leaflet-control-zoom a.leaflet-disabled) {
    opacity: 0.35 !important;
    cursor: not-allowed !important;
    background: var(--surface-card-light) !important;
    color: var(--text-card-muted) !important;
    pointer-events: none !important;
  }

  /* ==========================================================================
     CONNECTED TOP STACK (Filters + Location Selector Pills)
     ========================================================================== */
  .gig-bottom-sheet-attached-header {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 0;
    right: 0;
    padding: 0 14px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    pointer-events: none;
    z-index: 600;
  }

  .gig-bottom-sheet-attached-header .expanding-filter-toolbar,
  .gig-bottom-sheet-attached-header .gig-selector-pills-row {
    pointer-events: auto;
  }

  /* 1. Horizontal Expanding Filter Toolbar */
  .expanding-filter-toolbar {
    display: inline-flex;
    align-items: center;
    background: var(--surface-card-light);
    border: 2.5px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 9999px;
    padding: 3px;
    transition: max-width 0.32s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
    overflow: hidden;
    max-width: 44px;
    white-space: nowrap;
    user-select: none;
    box-sizing: border-box;
  }

  .expanding-filter-toolbar:global(.is-expanded) {
    max-width: 390px;
    box-shadow: 4px 4px 0px #000000;
  }

  .filter-toggle-icon-btn {
    width: 34px;
    height: 34px;
    min-width: 34px;
    border-radius: 50%;
    background: #141416;
    border: 2px solid #000000;
    color: var(--accent-neon-yellow);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    cursor: pointer;
    position: relative;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
  }

  .filter-toggle-icon-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
  }

  .expanding-filter-toolbar:global(.is-expanded) .filter-toggle-icon-btn {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: rotate(90deg);
  }

  .filter-active-dot {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-neon-yellow);
    border: 1px solid #000000;
    box-shadow: 0 0 6px var(--accent-neon-yellow-glow);
  }

  .filter-chips-expandable {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 6px;
    opacity: 0;
    transform: scaleX(0.88);
    transform-origin: left center;
    transition: opacity 0.22s var(--ease-snappy), transform 0.22s var(--ease-snappy);
    pointer-events: none;
  }

  .expanding-filter-toolbar:global(.is-expanded) .filter-chips-expandable {
    opacity: 1;
    transform: scaleX(1);
    pointer-events: auto;
  }

  .gig-filter-tab {
    flex: 0 0 auto;
    background: var(--surface-card-light-hover);
    border: 2px solid #000000;
    color: var(--text-card-secondary);
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 4px 11px;
    border-radius: 9999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .gig-filter-tab:hover {
    background: var(--surface-card-light);
    color: var(--text-card-primary);
    transform: translateY(-1px);
  }

  .gig-filter-tab.active {
    background: #141416 !important;
    color: var(--accent-neon-yellow) !important;
    border-color: var(--accent-neon-yellow) !important;
    font-weight: 900;
    box-shadow: 1.5px 1.5px 0px #000000;
  }

  /* 2. Middle: Quick Venue Selectors */
  .gig-selector-pills-row {
    height: auto;
    min-height: 38px;
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    touch-action: pan-x;
    scrollbar-width: none;
    padding: 5px 8px;
    background: var(--surface-card-light);
    border: 2.5px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 8px;
    max-width: min(92vw, 440px);
    box-sizing: border-box;
  }

  .gig-selector-pills-row::-webkit-scrollbar {
    display: none;
  }

  .gig-selector-pills-row :global(.gig-select-pill) {
    flex: 0 0 auto !important;
    min-width: max-content !important;
    background: var(--surface-card-light-hover);
    border: 2px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    padding: 5px 10px;
    border-radius: 5px;
    cursor: pointer;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease;
  }

  .gig-selector-pills-row :global(.gig-select-pill:hover) {
    background: var(--surface-card-light);
    transform: translate(-1px, -1px);
    box-shadow: 2.5px 2.5px 0px #000000;
  }

  .gig-selector-pills-row :global(.gig-select-pill.active) {
    background: var(--accent-neon-yellow) !important;
    color: #000000 !important;
    border: 2px solid #000000 !important;
    box-shadow: 2px 2px 0px #000000 !important;
    font-weight: 900;
  }

  .gig-selector-pills-row :global(.pill-city-tag) {
    opacity: 0.75;
    font-size: 0.62rem;
    font-weight: 700;
  }

  .gig-selector-pills-row :global(.pill-distance-tag) {
    font-size: 0.58rem;
    background: #000000;
    color: #ffffff;
    padding: 1px 4px;
    border-radius: 3px;
    font-weight: 900;
  }

  .gig-selector-pills-row :global(.gig-select-pill.active .pill-distance-tag) {
    background: #000000;
    color: var(--accent-neon-yellow);
  }

  /* ==========================================================================
     3. BOTTOM SHEET (Tier 1 vs Tier 2, 55vh Max Expansion)
     ========================================================================== */
  :root {
    --peek-height: calc(214px + env(safe-area-inset-bottom, 0px));
  }

  .venue-detail-bottom-card {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 500;
    background: var(--surface-card-light);
    border-top: 3.5px solid #000000;
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.45);
    display: flex;
    flex-direction: column;
    padding: 0 16px calc(14px + env(safe-area-inset-bottom, 0px)) 16px;
    box-sizing: border-box;
    overflow: visible;
    touch-action: pan-y;
    contain: layout style;
    height: 55vh;
    height: 55dvh;
    max-height: 55dvh;
    will-change: transform;
    transform: translate3d(0, 0, 0);
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .venue-detail-bottom-card.is-dragging {
    transition: none !important;
    user-select: none;
    will-change: transform;
  }

  /* --- TIER 1: INITIAL SUMMARY / COLLAPSED STATE (Peek ~214px + safe area) --- */
  .venue-detail-bottom-card.is-peek {
    transform: translate3d(0, calc(100% - var(--peek-height, 214px)), 0);
    padding-bottom: calc(14px + env(safe-area-inset-bottom, 0px));
  }

  .venue-detail-bottom-card.is-peek .venue-expanded-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 6px;
    padding-bottom: 0;
    overflow: hidden;
    animation: fadeInTier1 0.2s var(--ease-snappy) forwards;
  }

  .venue-detail-bottom-card.is-peek .expanded-only-block,
  .venue-detail-bottom-card:not(.is-expanded) .expanded-only-block {
    display: none !important;
    pointer-events: none !important;
    visibility: hidden !important;
  }

  @keyframes fadeInTier1 {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* --- TIER 2: FULL EXPANDED DRAWER (55vh) --- */
  .venue-detail-bottom-card.is-expanded {
    transform: translate3d(0, 0, 0);
  }

  .venue-detail-bottom-card.is-expanded .venue-card-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--surface-card-light);
    padding-top: 4px;
    padding-bottom: 10px;
    border-bottom: 2px solid #000000;
  }

  .venue-detail-bottom-card.is-expanded .venue-expanded-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
    padding-bottom: 24px;
    overflow-y: auto !important;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    animation: fadeInTier2 0.24s var(--ease-snappy) forwards;
  }

  .venue-detail-bottom-card.is-expanded .expanded-only-block {
    display: flex !important;
    pointer-events: auto !important;
    visibility: visible !important;
  }

  @keyframes fadeInTier2 {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* --- DRAG / TAP HANDLE BAR --- */
  .sheet-drag-handle {
    width: 100%;
    padding: 8px 0 4px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    flex-shrink: 0;
    user-select: none;
    position: relative;
    -webkit-tap-highlight-color: transparent;
  }

  .sheet-drag-handle:active {
    cursor: grabbing;
  }

  .drag-bar-pill {
    width: 44px;
    height: 5px;
    border-radius: 3px;
    background: #000000;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sheet-drag-handle:hover .drag-bar-pill,
  .venue-detail-bottom-card.is-dragging .drag-bar-pill {
    background: var(--accent-neon-yellow);
    width: 56px;
  }

  /* --- VENUE CARD HEADER & METADATA --- */
  .venue-card-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    flex-shrink: 0;
  }

  .venue-title-full-row {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
  }

  .venue-card-name {
    font-family: var(--font-heading);
    font-size: clamp(1.05rem, 3.8vw, 1.28rem);
    font-weight: 900;
    color: var(--text-card-primary);
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
    white-space: normal;
    word-break: break-word;
  }

  .header-badges-group {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .desktop-snap-toggle-btn {
    display: none;
  }

  /* Sub-meta Line: Location • Date */
  .venue-sub-meta-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--text-card-muted);
    line-height: 1.3;
  }

  .meta-dot {
    opacity: 0.5;
    font-size: 0.65rem;
  }

  .venue-sub-location {
    color: var(--text-card-primary);
    font-weight: 800;
  }

  .venue-sub-date {
    color: var(--text-card-secondary);
  }

  /* Urgency Pill (Upcoming) */
  .venue-urgency-pill {
    background: var(--accent-neon-yellow);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: #000000;
    font-family: var(--font-secondary);
    font-size: 0.64rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .venue-urgency-pill.hidden {
    display: none !important;
  }

  /* Archive Badge (Past) */
  .venue-archive-badge {
    background: #141416;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: #f4f4f6;
    font-family: var(--font-secondary);
    font-size: 0.64rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .venue-archive-badge.hidden {
    display: none !important;
  }

  /* Timeline Bar (Multi-show venues) */
  .venue-edition-timeline-bar {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 4px;
    padding-top: 6px;
    border-top: 1.5px dashed #000000;
  }

  .venue-edition-timeline-bar.hidden {
    display: none !important;
  }

  .timeline-bar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .timeline-bar-label {
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-card-muted);
  }

  .timeline-bar-pills {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 2px 0;
  }

  .timeline-bar-pills::-webkit-scrollbar {
    display: none;
  }

  :global(.venue-edition-tab) {
    flex: 0 0 auto;
    background: var(--surface-card-light-hover);
    border: 2px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 800;
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease;
  }

  :global(.venue-edition-tab:hover) {
    background: var(--surface-card-light);
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0px #000000;
  }

  :global(.venue-edition-tab.active) {
    background: var(--accent-neon-yellow) !important;
    color: #000000 !important;
    font-weight: 900;
    box-shadow: 2px 2px 0px #000000 !important;
  }

  :global(.edition-status-badge) {
    font-size: 0.55rem;
    font-weight: 900;
    background: #000000;
    color: #ffffff;
    padding: 1px 4px;
    border-radius: 2px;
    text-transform: uppercase;
  }

  :global(.venue-edition-tab.active .edition-status-badge) {
    background: #000000;
    color: var(--accent-neon-yellow);
  }

  /* --- PRIMARY ACTION CTAS --- */
  .venue-primary-cta-wrap {
    width: 100%;
    margin-top: 6px;
  }

  /* Upcoming Ticket CTA */
  .venue-booking-btn {
    width: 100%;
    box-sizing: border-box;
    background: var(--accent-neon-yellow);
    color: #000000;
    height: 42px;
    padding: 0 16px;
    border-radius: 6px;
    text-decoration: none;
    font-family: var(--font-secondary);
    font-weight: 900;
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
    cursor: pointer;
  }

  .venue-booking-btn i {
    color: #000000;
    font-size: 0.85rem;
  }

  .venue-booking-btn .launch-icon {
    font-size: 0.75rem;
    opacity: 0.85;
  }

  .venue-booking-btn:hover {
    background: var(--btn-green-hover, #faff60);
    transform: translate(-1.5px, -1.5px);
    box-shadow: 4.5px 4.5px 0px #000000;
  }

  .venue-booking-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0px #000000;
  }

  /* Archived Check-in CTA */
  .venue-checkin-btn {
    width: 100%;
    box-sizing: border-box;
    background: #141416;
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    color: #ffffff;
    height: 42px;
    padding: 0 16px;
    border-radius: 6px;
    font-family: var(--font-secondary);
    font-weight: 900;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
    user-select: none;
  }

  .venue-checkin-btn i {
    color: var(--accent-neon-yellow);
    font-size: 0.85rem;
  }

  .venue-checkin-btn:hover {
    background: #202026;
    transform: translate(-1.5px, -1.5px);
    box-shadow: 4.5px 4.5px 0px #000000;
  }

  .venue-checkin-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0px #000000;
  }

  .venue-checkin-btn.is-checked-in {
    background: var(--accent-neon-yellow);
    color: #000000;
    font-weight: 900;
  }

  .venue-checkin-btn.is-checked-in i {
    color: #000000;
  }

  .venue-checkin-btn.hidden {
    display: none !important;
  }

  /* --- DYNAMIC DRAWER BODY --- */
  .venue-dynamic-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  /* Quick Info Chip Row */
  :global(.venue-quick-info-row) {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 0;
  }

  :global(.venue-quick-info-row::-webkit-scrollbar) {
    display: none;
  }

  :global(.quick-chip) {
    background: var(--surface-card-light-hover);
    border: 2px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 4px 8px;
    border-radius: 5px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
  }

  /* Action Chips Row */
  :global(.venue-action-chips-row) {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 6px;
    width: 100%;
    margin-top: 2px;
  }

  :global(.venue-action-chip-btn) {
    background: var(--surface-card-light-hover);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 8px 6px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
    user-select: none;
    box-sizing: border-box;
  }

  :global(.venue-action-chip-btn:hover) {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  :global(.venue-action-chip-btn:active) {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  :global(.venue-action-chip-btn i) {
    font-size: 0.78rem;
    color: inherit;
  }

  /* Section Dividers & Headings */
  :global(.section-divider-bar) {
    border-top: 2px solid #000000;
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.expanded-section-title) {
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-card-primary);
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0;
  }

  :global(.expanded-section-title span.left-title),
  :global(.set-times-header-title),
  :global(.song-request-header) {
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    font-family: var(--font-heading) !important;
    font-size: 0.9rem !important;
    font-weight: 900 !important;
    letter-spacing: 0.05em !important;
    text-transform: uppercase !important;
    color: var(--text-card-primary) !important;
    margin: 0;
  }

  :global(.expanded-section-title i),
  :global(.set-times-header-title i),
  :global(.song-request-header i) {
    color: var(--text-card-muted);
    font-size: 0.82rem;
  }

  :global(.expanded-section-title span.right-hint) {
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--text-card-muted);
    font-family: var(--font-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Set Times & Lineup Card */
  :global(.set-times-card) {
    background: var(--surface-card-light-hover);
    border: 2px solid #000000;
    box-shadow: 2.5px 2.5px 0px #000000;
    border-radius: 8px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.set-times-list) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.set-time-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 10px;
    border-radius: 5px;
    background: var(--surface-card-light);
    border: 1.5px solid #000000;
  }

  :global(.set-time-left) {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow: hidden;
  }

  :global(.set-time-pill) {
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 900;
    color: #ffffff;
    background: #000000;
    padding: 2px 6px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  :global(.set-act-title) {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-card-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.set-act-title.is-headliner) {
    font-weight: 900;
  }

  :global(.set-role-badge) {
    font-size: 0.6rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 3px;
    font-family: var(--font-secondary);
    flex-shrink: 0;
    border: 1px solid #000000;
  }

  :global(.set-role-badge.role-doors) {
    color: var(--text-card-muted);
    background: var(--surface-card-light-hover);
  }

  :global(.set-role-badge.role-support) {
    color: var(--text-card-primary);
    background: var(--surface-card-light);
  }

  :global(.set-role-badge.role-headliner) {
    color: #000000;
    background: var(--accent-neon-yellow);
    font-weight: 900;
  }

  /* Setlist Preview Rows */
  :global(.setlist-preview-list),
  :global(.as-played-list) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.setlist-preview-row),
  :global(.as-played-item) {
    background: var(--surface-card-light-hover);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: var(--text-card-primary);
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease;
  }

  :global(.setlist-preview-row:hover),
  :global(.as-played-item:hover) {
    background: var(--surface-card-light);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  :global(.setlist-preview-row:active),
  :global(.as-played-item:active) {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  :global(.setlist-preview-row .track-title-wrap),
  :global(.as-played-item .track-main-info) {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.track-tag) {
    font-size: 0.6rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 3px;
    background: #000000;
    color: var(--accent-neon-yellow);
    flex-shrink: 0;
  }

  :global(.snippet-btn) {
    background: var(--accent-neon-yellow);
    border: 1.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    color: #000000;
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 4px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
  }

  :global(.snippet-btn:hover) {
    transform: translate(-1px, -1px);
    box-shadow: 2.5px 2.5px 0px #000000;
  }

  /* Song Request Card */
  :global(.song-request-card) {
    background: var(--surface-card-light-hover);
    border: 2px solid #000000;
    box-shadow: 2.5px 2.5px 0px #000000;
    border-radius: 8px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.song-request-desc) {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--text-card-muted);
    margin: 0;
    line-height: 1.35;
  }

  :global(.song-request-form) {
    display: flex;
    gap: 6px;
  }

  :global(.song-request-input) {
    flex: 1;
    background: var(--surface-card-light);
    border: 2px solid #000000;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    padding: 7px 10px;
    border-radius: 5px;
    box-sizing: border-box;
  }

  :global(.song-request-input:focus) {
    outline: none;
    border-color: #000000;
    box-shadow: 2px 2px 0px var(--accent-neon-yellow);
  }

  :global(.song-request-submit-btn) {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 5px;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
  }

  :global(.song-request-submit-btn:hover) {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  :global(.song-request-success) {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 800;
    color: #22c55e;
    padding: 6px 0;
  }

  /* Venue Location & Travel Card */
  :global(.venue-travel-card) {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.copy-address-btn) {
    width: 100%;
    background: var(--surface-card-light-hover);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
    text-align: left;
    box-sizing: border-box;
  }

  :global(.copy-address-btn:hover) {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  :global(.copy-address-text-wrap) {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--text-card-primary);
  }

  :global(.copy-address-action-badge) {
    font-family: var(--font-secondary);
    font-size: 0.64rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
