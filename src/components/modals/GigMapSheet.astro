<div class="bottom-sheet-backdrop" id="gigMapModal" role="dialog" aria-modal="true" aria-label="Kins Live Tour & Gig Map">
  <div class="bottom-sheet-container" id="bottomSheetContainer">
    
    <!-- Full-Screen Interactive Map Canvas -->
    <div class="map-view-wrapper" id="mapViewWrapper">
      <div class="gig-map-view" id="gigMapView"></div>

      <!-- Top Modal Header Bar (Floating Glass) -->
      <div class="gig-top-header-bar">
        <div class="gig-header-titles">
          <div class="gig-live-tag-row">
            <span class="live-pulse-dot"></span>
            <span class="gig-kicker">KINS LIVE TOUR</span>
          </div>
          <h3 class="gig-modal-heading">Sydney & Newcastle</h3>
        </div>
        <button class="close-sheet-btn" id="closeGigMapSheet" aria-label="Close Gig Map" title="Close Gig Map (Esc)">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Floating Map Control Buttons (Top-Right) -->
      <div class="map-floating-overlay-controls">
        <button type="button" class="map-control-glass-btn" id="mapFitBoundsBtn" title="Fit all tour venues in view" aria-label="Fit All Venues">
          <i class="fa-solid fa-expand"></i>
        </button>
        <button type="button" class="map-control-glass-btn desktop-only" id="toggleMapDetailsBtn" title="Toggle venue details panel" aria-label="Toggle Details Panel">
          <i class="fa-solid fa-layer-group"></i>
        </button>
      </div>
    </div>

    <!-- 3. Bottom: Venue Detail Card / Bottom Sheet (Tier 1 vs Tier 2, 55vh Max Expansion) -->
    <div 
      class="venue-detail-bottom-card is-peek" 
      id="venueDetailBottomCard" 
      role="region" 
      aria-label="Venue and Tour Details" 
      aria-expanded="false"
      data-snap-state="peek"
      tabindex="0"
    >
      
      <!-- Connected Floating Top Stack: Filter Button (Top) + Location Widget (Middle, connected to top of bottom menu) -->
      <div class="gig-bottom-sheet-attached-header" id="gigAttachedTopStack">
        <!-- 1. Top: Horizontal Expanding Filter Toolbar (Left-Anchored, Expands Right) -->
        <div class="expanding-filter-toolbar" id="expandingFilterToolbar">
          <button type="button" class="filter-toggle-icon-btn" id="gigFilterToggleBtn" aria-label="Toggle Tour Filters" title="Filter Shows (All / Upcoming / Archived)">
            <i class="fa-solid fa-sliders"></i>
            <span class="filter-active-dot" id="filterActiveDot"></span>
          </button>
          
          <div class="filter-chips-expandable" id="filterChipsExpandable" role="tablist" aria-label="Filter Tour Shows">
            <button type="button" class="gig-filter-tab active" data-filter="all" role="tab" aria-selected="true">
              <i class="fa-solid fa-border-all"></i>
              <span>All (10)</span>
            </button>
            <button type="button" class="gig-filter-tab" data-filter="upcoming" role="tab" aria-selected="false">
              <i class="fa-solid fa-fire-flame-curved"></i>
              <span>Upcoming (4)</span>
            </button>
            <button type="button" class="gig-filter-tab" data-filter="past" role="tab" aria-selected="false">
              <i class="fa-solid fa-box-archive"></i>
              <span>Archived (6)</span>
            </button>
          </div>
        </div>

        <!-- 2. Middle: Gig Location Widget / Quick Venue Selectors -->
        <div class="gig-selector-pills-row" id="gigSelectorPillsRow" role="region" aria-label="Quick Venue Selectors">
          <!-- Populated dynamically by gigMap.js -->
        </div>
      </div>

      <!-- Persistent Drag / Tap Handle Bar (Mobile Only) -->
      <div 
        class="sheet-drag-handle" 
        id="sheetDragHandle" 
        role="button" 
        tabindex="0"
        aria-label="Drag or tap to expand venue details (Snap: Peek 214px, Expanded 55vh)"
        title="Drag up or tap to expand"
      >
        <div class="drag-bar-pill"></div>
      </div>
      
      <!-- Sticky Header Block -->
      <div class="venue-card-header" id="venueCardHeader">
        <!-- Row 1: Venue Title + Badge -->
        <div class="venue-title-full-row">
          <h4 class="venue-card-name" id="venueCardName" title="Select a venue on the map">Select a venue on the map</h4>
          
          <div class="header-badges-group">
            <span class="venue-urgency-pill hidden" id="venueUrgencyPill"><i class="fa-solid fa-fire"></i> IN 8 DAYS</span>
            <span class="venue-archive-badge hidden" id="venueArchiveBadge"><i class="fa-solid fa-box-archive"></i> TOUR ARCHIVE</span>
            
            <!-- Desktop Snap Toggle -->
            <button 
              type="button" 
              class="desktop-snap-toggle-btn" 
              id="desktopSnapToggleBtn" 
              aria-label="Toggle Details Panel Expansion"
              title="Expand / Collapse details panel"
            >
              <i class="fa-solid fa-chevron-up"></i>
            </button>
          </div>
        </div>
        
        <!-- Row 2: Sub-meta Location & Date -->
        <div class="venue-sub-meta-line" id="venueSubMetaLine">
          <span class="venue-sub-location" id="venueCardLocation">Newcastle West</span>
          <span class="meta-dot">•</span>
          <span class="venue-sub-date" id="venuePeekDate">Sat, Aug 22, 2026</span>
        </div>

        <!-- Multi-show Timeline Bar -->
        <div class="venue-edition-timeline-bar hidden" id="venueEditionTimelineBar">
          <div class="timeline-bar-header">
            <span class="timeline-bar-label"><i class="fa-solid fa-clock-rotate-left"></i> Shows At This Venue</span>
          </div>
          <div class="timeline-bar-pills" id="timelineBarPills"></div>
        </div>

        <!-- Row 3: Full-Width Primary CTA Button -->
        <div class="venue-primary-cta-wrap">
          <!-- Upcoming CTA: Get Tickets -->
          <a href="https://www.bandsintown.com" target="_blank" rel="noopener" class="venue-booking-btn" id="venueBookingBtn" aria-label="Get tickets for this show">
            <i class="fa-solid fa-bolt"></i>
            <span id="venueBookingBtnText">GET TICKETS — $15 (EARLY BIRD)</span>
            <i class="fa-solid fa-arrow-up-right-from-square launch-icon"></i>
          </a>
          
          <!-- Archived CTA: I Was There Fan Check-in Button -->
          <button type="button" class="venue-checkin-btn hidden" id="venueCheckinBtn" aria-label="Check in to show">
            <i class="fa-solid fa-ticket"></i>
            <span id="venueCheckinBtnText">340 FANS ATTENDED • "I WAS THERE" (✓)</span>
          </button>
        </div>
      </div>

      <!-- Expandable Drawer Content (Tier 2 Body) -->
      <div class="venue-expanded-content" id="venueExpandedContent">
        <!-- Dynamic rich container populated by gigMap.js -->
        <div class="venue-dynamic-body" id="venueDynamicBody">
          <!-- Populated dynamically based on event type -->
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Concert Photo Lightbox Modal -->
<div class="gig-lightbox-backdrop" id="gigPhotoLightbox" role="dialog" aria-modal="true" aria-label="Concert Photo Preview">
  <div class="gig-lightbox-content">
    <button type="button" class="gig-lightbox-close" id="gigLightboxClose" aria-label="Close photo preview">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <img src="" alt="Concert Photo" class="gig-lightbox-img" id="gigLightboxImg" loading="lazy">
    <div class="gig-lightbox-caption" id="gigLightboxCaption">Concert Photo • Kins Live</div>
  </div>
</div>

<style>
  .bottom-sheet-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 12, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-snappy);
  }

  .bottom-sheet-backdrop:global(.active) {
    opacity: 1;
    pointer-events: auto;
  }

  .bottom-sheet-container {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background: #0a0a0c;
    border-radius: 0;
    border: none;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: translateY(20px);
    opacity: 0;
    transition: transform 0.3s var(--ease-snappy), opacity 0.25s ease;
    position: relative;
  }

  .bottom-sheet-backdrop:global(.active) .bottom-sheet-container {
    transform: translateY(0);
    opacity: 1;
  }

  /* --- TOP MODAL HEADER BAR (Floating Glass) --- */
  .gig-top-header-bar {
    position: absolute;
    top: 14px;
    left: 14px;
    right: 14px;
    z-index: 450;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: rgba(14, 14, 18, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    padding: 8px 14px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
    pointer-events: auto;
  }

  .gig-header-titles {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .gig-live-tag-row {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .live-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.9);
    animation: livePulseAnim 2s infinite ease-in-out;
  }

  @keyframes livePulseAnim {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .gig-kicker {
    font-family: var(--font-secondary);
    font-size: 0.56rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .gig-modal-heading {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-white);
    letter-spacing: -0.01em;
    margin: 0;
    line-height: 1.15;
  }

  .close-sheet-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--text-white);
    width: 30px;
    height: 30px;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    flex-shrink: 0;
    transition: all 0.18s ease;
  }

  .close-sheet-btn:hover {
    background: #f2f0eb;
    color: #0a0a0c;
    border-color: #f2f0eb;
    transform: translateY(-1px);
  }

  /* ==========================================================================
     CONNECTED TOP STACK (Attached to the top of the bottom sheet menu)
     ========================================================================== */
  .gig-bottom-sheet-attached-header {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0;
    right: 0;
    padding: 0 14px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    pointer-events: none;
    z-index: 600;
  }

  .gig-bottom-sheet-attached-header .expanding-filter-toolbar,
  .gig-bottom-sheet-attached-header .gig-selector-pills-row {
    pointer-events: auto;
  }

  /* 1. Horizontal Expanding Filter Toolbar */
  .expanding-filter-toolbar {
    display: inline-flex;
    align-items: center;
    background: rgba(14, 14, 18, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 9999px;
    padding: 3px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
    transition: max-width 0.32s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.2s ease,
                box-shadow 0.2s ease;
    overflow: hidden;
    max-width: 44px;
    white-space: nowrap;
    user-select: none;
    box-sizing: border-box;
  }

  .expanding-filter-toolbar:global(.is-expanded) {
    max-width: 380px;
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.8);
  }

  .filter-toggle-icon-btn {
    width: 36px;
    height: 36px;
    min-width: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: none;
    color: #f2f0eb;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    cursor: pointer;
    position: relative;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
  }

  .filter-toggle-icon-btn:hover {
    background: #f2f0eb;
    color: #0a0a0c;
  }

  .expanding-filter-toolbar:global(.is-expanded) .filter-toggle-icon-btn {
    background: #f2f0eb;
    color: #0a0a0c;
    transform: rotate(90deg);
  }

  .filter-active-dot {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fbbf24;
    box-shadow: 0 0 6px rgba(251, 191, 36, 0.9);
  }

  .filter-chips-expandable {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 0 6px 0 6px;
    opacity: 0;
    transform: scaleX(0.85);
    transform-origin: left center;
    transition: opacity 0.22s var(--ease-snappy), transform 0.22s var(--ease-snappy);
    pointer-events: none;
  }

  .expanding-filter-toolbar:global(.is-expanded) .filter-chips-expandable {
    opacity: 1;
    transform: scaleX(1);
    pointer-events: auto;
  }

  .gig-filter-tab {
    flex: 0 0 auto;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 9999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.18s ease;
    white-space: nowrap;
  }

  .gig-filter-tab:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .gig-filter-tab.active {
    background: #f2f0eb;
    color: #0a0a0c;
    border-color: #f2f0eb;
    font-weight: 900;
  }

  /* 2. Middle: Quick Venue Selectors / Location Widget */
  .gig-selector-pills-row {
    height: auto;
    min-height: 34px;
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    touch-action: pan-x;
    scrollbar-width: none;
    padding: 4px 6px;
    background: rgba(14, 14, 18, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    max-width: min(88vw, 420px);
    box-sizing: border-box;
  }

  .gig-selector-pills-row::-webkit-scrollbar {
    display: none;
  }

  .gig-selector-pills-row :global(.gig-select-pill) {
    flex: 0 0 auto !important;
    min-width: max-content !important;
    background: rgba(22, 22, 28, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #d4d4d8;
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.18s ease;
  }

  .gig-selector-pills-row :global(.gig-select-pill:hover) {
    background: rgba(255, 255, 255, 0.16);
    color: var(--text-white);
    border-color: rgba(255, 255, 255, 0.28);
  }

  .gig-selector-pills-row :global(.gig-select-pill.active) {
    background: #f2f0eb;
    color: #0a0a0c;
    border-color: #f2f0eb;
    font-weight: 900;
  }

  .gig-selector-pills-row :global(.pill-city-tag) {
    opacity: 0.7;
    font-size: 0.62rem;
  }

  .gig-selector-pills-row :global(.pill-distance-tag) {
    font-size: 0.58rem;
    background: rgba(0, 0, 0, 0.35);
    padding: 1px 4px;
    border-radius: 3px;
    font-weight: 800;
    color: inherit;
  }

  /* --- MAP VIEW WRAPPER --- */
  .map-view-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    flex: 1 1 auto;
    min-height: 0;
    z-index: 1;
  }

  .gig-map-view {
    width: 100%;
    height: 100%;
    min-height: 200px;
    background: #09090b;
  }

  /* Floating Map Overlay Controls (Top-Right) */
  .map-floating-overlay-controls {
    position: absolute;
    top: 72px;
    right: 14px;
    z-index: 450;
    display: flex;
    flex-direction: column;
    gap: 8px;
    pointer-events: auto;
  }

  .map-control-glass-btn {
    background: rgba(14, 14, 18, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #f2f0eb;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.88rem;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.65), 0 2px 6px rgba(0, 0, 0, 0.4);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
    position: relative;
    -webkit-tap-highlight-color: transparent;
  }

  .map-control-glass-btn:hover {
    background: #f2f0eb;
    border-color: #f2f0eb;
    color: #0a0a0c;
    transform: translateY(-1px);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.8), 0 0 12px rgba(255, 255, 255, 0.2);
  }

  .map-control-glass-btn:active {
    transform: scale(0.94);
  }

  .map-control-glass-btn.is-active {
    background: #f2f0eb;
    border-color: #f2f0eb;
    color: #0a0a0c;
    box-shadow: 0 0 16px rgba(255, 255, 255, 0.35);
  }

  /* Desktop-only button refinement: strictly hidden on mobile, visible on desktop */
  .desktop-only,
  .map-control-glass-btn.desktop-only {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  /* Leaflet Custom Glass Zoom Controls */
  :global(.leaflet-top.leaflet-left) {
    top: 72px !important;
    left: 14px !important;
    pointer-events: auto !important;
  }

  :global(.leaflet-control-zoom.leaflet-bar) {
    border: 1px solid rgba(255, 255, 255, 0.16) !important;
    border-radius: 8px !important;
    overflow: hidden !important;
    background: rgba(14, 14, 18, 0.92) !important;
    backdrop-filter: blur(16px) !important;
    -webkit-backdrop-filter: blur(16px) !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.65), 0 2px 6px rgba(0, 0, 0, 0.4) !important;
    display: flex !important;
    flex-direction: column !important;
    margin: 0 !important;
  }

  :global(.leaflet-control-zoom-in),
  :global(.leaflet-control-zoom-out) {
    width: 36px !important;
    height: 36px !important;
    line-height: 34px !important;
    background: transparent !important;
    color: #f2f0eb !important;
    border: none !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-family: var(--font-secondary), -apple-system, sans-serif !important;
    font-size: 1.18rem !important;
    font-weight: 500 !important;
    cursor: pointer !important;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1) !important;
    user-select: none !important;
    text-decoration: none !important;
    padding: 0 !important;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.leaflet-control-zoom-in) {
    border-bottom: 1px solid rgba(255, 255, 255, 0.12) !important;
  }

  :global(.leaflet-control-zoom-out) {
    border-bottom: none !important;
  }

  :global(.leaflet-control-zoom-in span),
  :global(.leaflet-control-zoom-out span) {
    line-height: 1 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    transform: translateY(-1px) !important;
    font-size: 1.15rem !important;
    font-weight: 600 !important;
  }

  :global(.leaflet-control-zoom-in:hover),
  :global(.leaflet-control-zoom-out:hover) {
    background: #f2f0eb !important;
    color: #0a0a0c !important;
  }

  :global(.leaflet-control-zoom-in:active),
  :global(.leaflet-control-zoom-out:active) {
    background: #ffffff !important;
    color: #000000 !important;
    transform: scale(0.96);
  }

  :global(.leaflet-control-zoom a.leaflet-disabled) {
    opacity: 0.28 !important;
    cursor: not-allowed !important;
    background: transparent !important;
    color: #71717a !important;
    pointer-events: none !important;
  }



  /* ==========================================================================
     3. BOTTOM SHEET (Tier 1 vs Tier 2, 55vh Max Expansion)
     ========================================================================== */
  :root {
    --peek-height: calc(214px + env(safe-area-inset-bottom, 0px));
  }

  .venue-detail-bottom-card {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 500;
    background: rgba(13, 13, 17, 0.98);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 -16px 48px rgba(0, 0, 0, 0.92);
    display: flex;
    flex-direction: column;
    padding: 0 16px calc(14px + env(safe-area-inset-bottom, 0px)) 16px;
    box-sizing: border-box;
    overflow: visible;
    touch-action: pan-y;
    contain: layout style;
    height: 55vh;
    height: 55dvh;
    max-height: 55dvh;
    will-change: transform;
    transform: translate3d(0, 0, 0);
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .venue-detail-bottom-card.is-dragging {
    transition: none !important;
    user-select: none;
    will-change: transform;
  }

  /* --- TIER 1: INITIAL SUMMARY / COLLAPSED STATE (Peek ~214px + safe area) --- */
  .venue-detail-bottom-card.is-peek {
    transform: translate3d(0, calc(100% - var(--peek-height, 214px)), 0);
    padding-bottom: calc(14px + env(safe-area-inset-bottom, 0px));
  }

  .venue-detail-bottom-card.is-peek .venue-expanded-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 6px;
    padding-bottom: 0;
    overflow: hidden;
    animation: fadeInTier1 0.2s var(--ease-snappy) forwards;
  }

  .venue-detail-bottom-card.is-peek .expanded-only-block,
  .venue-detail-bottom-card:not(.is-expanded) .expanded-only-block {
    display: none !important;
    pointer-events: none !important;
    visibility: hidden !important;
  }

  @keyframes fadeInTier1 {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* --- TIER 2: FULL EXPANDED DRAWER (55vh) --- */
  .venue-detail-bottom-card.is-expanded {
    transform: translate3d(0, 0, 0);
  }

  .venue-detail-bottom-card.is-expanded .venue-card-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(13, 13, 17, 0.98);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    padding-top: 4px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .venue-detail-bottom-card.is-expanded .venue-expanded-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
    padding-bottom: 24px;
    overflow-y: auto !important;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    animation: fadeInTier2 0.24s var(--ease-snappy) forwards;
  }

  .venue-detail-bottom-card.is-expanded .expanded-only-block {
    display: flex !important;
    pointer-events: auto !important;
    visibility: visible !important;
  }

  @keyframes fadeInTier2 {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* --- DRAG / TAP HANDLE BAR --- */
  .sheet-drag-handle {
    width: 100%;
    padding: 8px 0 4px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    flex-shrink: 0;
    user-select: none;
    position: relative;
    -webkit-tap-highlight-color: transparent;
  }

  .sheet-drag-handle:active {
    cursor: grabbing;
  }

  .drag-bar-pill {
    width: 36px;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.35);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sheet-drag-handle:hover .drag-bar-pill,
  .venue-detail-bottom-card.is-dragging .drag-bar-pill {
    background: rgba(255, 255, 255, 0.85);
    width: 48px;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.4);
  }

  /* --- VENUE CARD HEADER & METADATA --- */
  .venue-card-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    flex-shrink: 0;
  }

  .venue-title-full-row {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
  }

  .venue-card-name {
    font-family: var(--font-heading);
    font-size: clamp(1.02rem, 3.8vw, 1.25rem);
    font-weight: 800;
    color: var(--text-white);
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
    white-space: normal;
    word-break: break-word;
  }

  .header-badges-group {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .desktop-snap-toggle-btn {
    display: none;
  }

  /* Sub-meta Line: Location • Date */
  .venue-sub-meta-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 700;
    color: #a1a1aa;
    line-height: 1.3;
  }

  .meta-dot {
    opacity: 0.5;
    font-size: 0.65rem;
  }

  .venue-sub-location {
    color: #d4d4d8;
    font-weight: 700;
  }

  .venue-sub-date {
    color: #f2f0eb;
  }

  /* Urgency Pill (Upcoming) */
  .venue-urgency-pill {
    background: rgba(251, 191, 36, 0.14);
    border: 1px solid rgba(251, 191, 36, 0.35);
    color: #fbbf24;
    font-family: var(--font-secondary);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .venue-urgency-pill.hidden {
    display: none !important;
  }

  /* Archive Badge (Past) */
  .venue-archive-badge {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #e4e4e7;
    font-family: var(--font-secondary);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .venue-archive-badge.hidden {
    display: none !important;
  }

  /* --- PRIMARY ACTION CTAS --- */
  .venue-primary-cta-wrap {
    width: 100%;
    margin-top: 6px;
  }

  /* Upcoming Ticket CTA */
  .venue-booking-btn {
    width: 100%;
    box-sizing: border-box;
    background: #f2f0eb;
    color: #0a0a0c;
    height: 38px;
    padding: 0 14px;
    border-radius: 4px;
    text-decoration: none;
    font-family: var(--font-secondary);
    font-weight: 900;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: none;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.6);
    transition: transform 0.18s var(--ease-snappy), background-color 0.18s ease, box-shadow 0.18s ease;
    cursor: pointer;
  }

  .venue-booking-btn i {
    color: #0a0a0c;
    font-size: 0.8rem;
  }

  .venue-booking-btn .launch-icon {
    font-size: 0.7rem;
    opacity: 0.8;
  }

  .venue-booking-btn:hover {
    background: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(255, 255, 255, 0.25);
  }

  .venue-booking-btn:active {
    transform: scale(0.98);
  }

  /* Archived Check-in CTA */
  .venue-checkin-btn {
    width: 100%;
    box-sizing: border-box;
    background: rgba(28, 28, 36, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #ffffff;
    height: 38px;
    padding: 0 14px;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-weight: 800;
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
    transition: all 0.22s var(--ease-snappy);
    user-select: none;
  }

  .venue-checkin-btn i {
    color: #e4e4e7;
    font-size: 0.8rem;
  }

  .venue-checkin-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
    transform: translateY(-1px);
  }

  .venue-checkin-btn:active {
    transform: scale(0.98);
  }

  .venue-checkin-btn.is-checked-in {
    background: #f2f0eb;
    color: #0a0a0c;
    border-color: #f2f0eb;
    font-weight: 900;
  }

  .venue-checkin-btn.is-checked-in i {
    color: #0a0a0c;
  }

  .venue-checkin-btn.hidden {
    display: none !important;
  }

  /* --- DYNAMIC DRAWER BODY --- */
  .venue-dynamic-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  /* Quick Info Chip Row */
  :global(.venue-quick-info-row) {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 0;
  }

  :global(.venue-quick-info-row::-webkit-scrollbar) {
    display: none;
  }

  :global(.quick-chip) {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #d4d4d8;
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
  }

  /* Action Chips Row */
  :global(.venue-action-chips-row) {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 6px;
    width: 100%;
    margin-top: 2px;
  }

  :global(.venue-action-chip-btn) {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 7px 6px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.18s ease;
    user-select: none;
  }

  :global(.venue-action-chip-btn:hover) {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.3);
    color: #fff;
    transform: translateY(-1px);
  }

  :global(.venue-action-chip-btn i) {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  :global(.venue-action-chip-btn:hover i) {
    color: #fff;
  }

  /* Section Dividers & Headings */
  :global(.section-divider-bar) {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.expanded-section-title) {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-white);
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0;
  }

  :global(.expanded-section-title span.left-title),
  :global(.set-times-header-title),
  :global(.song-request-header) {
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    font-family: var(--font-heading) !important;
    font-size: 0.86rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
    color: var(--text-white) !important;
    margin: 0;
  }

  :global(.expanded-section-title i),
  :global(.set-times-header-title i),
  :global(.song-request-header i) {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  :global(.expanded-section-title span.right-hint) {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-muted);
    font-family: var(--font-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Set Times & Lineup Card */
  :global(.set-times-card) {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.set-times-list) {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  :global(.set-time-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 10px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  :global(.set-time-left) {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow: hidden;
  }

  :global(.set-time-pill) {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 800;
    color: #f4f4f5;
    background: rgba(255, 255, 255, 0.08);
    padding: 2px 6px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  :global(.set-act-title) {
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 600;
    color: #e4e4e7;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.set-act-title.is-headliner) {
    color: #ffffff;
    font-weight: 800;
  }

  :global(.set-role-badge) {
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 3px;
    font-family: var(--font-secondary);
    flex-shrink: 0;
  }

  :global(.set-role-badge.role-doors) {
    color: #a1a1aa;
    background: rgba(255, 255, 255, 0.06);
  }

  :global(.set-role-badge.role-support) {
    color: #f2f0eb;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  :global(.set-role-badge.role-headliner) {
    color: #0a0a0c;
    background: #f2f0eb;
    font-weight: 900;
  }

  /* Setlist Preview Rows */
  :global(.setlist-preview-list),
  :global(.as-played-list) {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  :global(.setlist-preview-row),
  :global(.as-played-item) {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    color: #e4e4e7;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  :global(.setlist-preview-row:hover),
  :global(.as-played-item:hover) {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-1px);
  }

  :global(.setlist-preview-row .track-title-wrap),
  :global(.as-played-item .track-main-info) {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.track-tag) {
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.08);
    color: #a1a1aa;
    flex-shrink: 0;
  }

  :global(.snippet-btn) {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #f2f0eb;
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 3px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: all 0.18s ease;
  }

  :global(.snippet-btn:hover) {
    background: #f2f0eb;
    color: #0a0a0c;
    border-color: #f2f0eb;
  }

  /* Song Request Card */
  :global(.song-request-card) {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.song-request-desc) {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    color: #a1a1aa;
    margin: 0;
    line-height: 1.35;
  }

  :global(.song-request-form) {
    display: flex;
    gap: 6px;
  }

  :global(.song-request-input) {
    flex: 1;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #fff;
    font-family: var(--font-secondary);
    font-size: 0.75rem;
    padding: 6px 10px;
    border-radius: 4px;
  }

  :global(.song-request-input:focus) {
    outline: none;
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.08);
  }

  :global(.song-request-submit-btn) {
    background: #f2f0eb;
    color: #0a0a0c;
    border: none;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  :global(.song-request-submit-btn:hover) {
    background: #ffffff;
    transform: translateY(-1px);
  }

  :global(.song-request-success) {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 700;
    color: #6ee7b7;
    padding: 6px 0;
  }

  /* Venue Location & Travel Card */
  :global(.venue-travel-card) {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.copy-address-btn) {
    width: 100%;
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    cursor: pointer;
    transition: all 0.18s ease;
    text-align: left;
  }

  :global(.copy-address-btn:hover) {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.25);
  }

  :global(.copy-address-text-wrap) {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    color: #e4e4e7;
  }

  :global(.copy-address-action-badge) {
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.08);
    color: #a1a1aa;
    padding: 2px 6px;
    border-radius: 3px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  :global(.travel-amenities-pills) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  :global(.travel-amenity-chip) {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #a1a1aa;
    font-family: var(--font-secondary);
    font-size: 0.66rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
  }

  /* Official Photos Gallery */
  :global(.official-media-gallery) {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 2px 0;
  }

  :global(.official-media-gallery::-webkit-scrollbar) {
    display: none;
  }

  :global(.official-photo-card) {
    flex: 0 0 130px;
    height: 90px;
    border-radius: 6px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.12);
    cursor: pointer;
  }

  :global(.official-photo-card img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  :global(.official-photo-card:hover img) {
    transform: scale(1.06);
  }

  :global(.photo-credit-bar) {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent);
    padding: 4px 6px;
    font-family: var(--font-secondary);
    font-size: 0.58rem;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Trivia & Highlights Card */
  :global(.show-trivia-card) {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.trivia-bullet) {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    color: #d4d4d8;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 0;
    line-height: 1.4;
  }

  :global(.trivia-bullet i) {
    color: #fbbf24;
    font-size: 0.65rem;
    margin-top: 4px;
  }

  /* Venue History List */
  :global(.venue-history-list) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.venue-history-card-row) {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-secondary);
    cursor: pointer;
    transition: all 0.18s var(--ease-snappy);
