---
---

<div class="bottom-sheet-backdrop" id="gigMapModal" role="dialog" aria-modal="true" aria-label="Kins Live Tour & Gig Map">
  <div class="bottom-sheet-container" id="bottomSheetContainer">
    
    <!-- Top Header & Region Branding -->
    <div class="gig-sheet-header">
      <div class="gig-header-titles">
        <h3 class="gig-modal-heading">Sydney & Newcastle</h3>
        <p class="gig-banner-meta">
          Official live dates, setlists, and concert archives across New South Wales.
        </p>
      </div>
      <button class="close-sheet-btn" id="closeGigMapSheet" aria-label="Close Gig Map" title="Close Gig Map (Esc)">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Category Filter Tabs Bar -->
    <div class="gig-filter-tabs-bar" id="gigFilterTabsBar" role="tablist" aria-label="Filter Tour Shows">
      <button type="button" class="gig-filter-tab active" data-filter="all" role="tab" aria-selected="true">
        <i class="fa-solid fa-border-all"></i>
        <span>All Shows (10)</span>
      </button>
      <button type="button" class="gig-filter-tab" data-filter="upcoming" role="tab" aria-selected="false">
        <i class="fa-solid fa-fire-flame-curved"></i>
        <span>Upcoming (4)</span>
      </button>
      <button type="button" class="gig-filter-tab" data-filter="past" role="tab" aria-selected="false">
        <i class="fa-solid fa-compact-disc"></i>
        <span>Tour Archive (6)</span>
      </button>
      <button type="button" class="gig-filter-tab" data-filter="newcastle" role="tab" aria-selected="false">
        <i class="fa-solid fa-location-dot"></i>
        <span>Newcastle (4)</span>
      </button>
      <button type="button" class="gig-filter-tab" data-filter="sydney" role="tab" aria-selected="false">
        <i class="fa-solid fa-location-dot"></i>
        <span>Sydney (6)</span>
      </button>
    </div>

    <!-- Quick Gig Selector Carousel Pills -->
    <div class="gig-selector-pills-row" id="gigSelectorPillsRow" role="region" aria-label="Quick Venue Selectors">
      <!-- Populated dynamically by gigMap.js -->
    </div>

    <!-- Map View Container with Floating Controls Overlay -->
    <div class="map-view-wrapper">
      <div class="gig-map-view" id="gigMapView"></div>

      <!-- Floating Map Control Buttons (Icon-only) -->
      <div class="map-floating-overlay-controls">
        <button type="button" class="map-control-glass-btn" id="mapFitBoundsBtn" title="Fit all tour venues in view" aria-label="Fit All Venues">
          <i class="fa-solid fa-expand"></i>
        </button>
        <button type="button" class="map-control-glass-btn" id="mapLocateMeBtn" title="Find closest show to your location (My GPS)" aria-label="My GPS">
          <i class="fa-solid fa-location-crosshairs"></i>
        </button>
        <button type="button" class="map-control-glass-btn desktop-only" id="toggleMapDetailsBtn" title="Toggle between map and details view" aria-label="Toggle Full Map">
          <i class="fa-solid fa-map"></i>
        </button>
      </div>

      <!-- Floating Interactive Directions HUD (Google Maps Style In-App Routing) -->
      <div class="map-directions-hud hidden" id="mapDirectionsHud" role="region" aria-label="Route Directions HUD">
        <div class="directions-hud-header">
          <div class="directions-hud-title-wrap">
            <span class="directions-hud-badge"><i class="fa-solid fa-diamond-turn-right"></i> ROUTE</span>
            <h5 class="directions-hud-destination" id="directionsHudDest">Venue Name</h5>
          </div>
          <button type="button" class="directions-hud-close" id="closeDirectionsHud" aria-label="Close directions HUD" title="Close directions">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
        
        <div class="directions-hud-stats">
          <div class="directions-stat-item">
            <span class="directions-stat-label">Estimated Drive</span>
            <span class="directions-stat-value" id="directionsDuration">-- mins</span>
          </div>
          <div class="directions-stat-divider"></div>
          <div class="directions-stat-item">
            <span class="directions-stat-label">Distance</span>
            <span class="directions-stat-value" id="directionsDistance">-- km</span>
          </div>
        </div>

        <div class="directions-hud-actions">
          <a href="#" target="_blank" rel="noopener" class="directions-gmaps-btn" id="directionsGmapsLink" title="Navigate in Google Maps app with live GPS">
            <i class="fa-solid fa-arrow-up-right-from-square"></i>
            <span>Google Maps</span>
          </a>
          <button type="button" class="directions-clear-btn" id="clearRouteHudBtn" title="Clear route from map">
            <i class="fa-solid fa-xmark"></i>
            <span>Clear</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Venue Detail Bottom Card with 3-Tier Fluid Snap Engine (Peek / Mid / Expanded) -->
    <div 
      class="venue-detail-bottom-card is-peek" 
      id="venueDetailBottomCard" 
      role="region" 
      aria-label="Venue and Tour Details" 
      aria-expanded="false"
      data-snap-state="peek"
      tabindex="0"
    >
      
      <!-- Persistent Drag / Tap Handle Bar -->
      <div 
        class="sheet-drag-handle" 
        id="sheetDragHandle" 
        role="button" 
        tabindex="0"
        aria-label="Drag or tap to expand venue details (Snap: Peek, Mid, Expanded)"
        title="Drag up or tap to expand (ArrowUp / ArrowDown)"
      >
        <div class="drag-bar-pill"></div>
        <button type="button" class="sheet-close-full-btn" id="sheetCloseFullBtn" aria-label="Collapse drawer">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      
      <!-- Sticky Header Block (Always visible; pins at top in State 3) -->
      <div class="venue-card-header" id="venueCardHeader">
        <!-- Row 1: Venue Title + Badge (Urgency for upcoming, Tour Archive for past) -->
        <div class="venue-title-full-row">
          <h4 class="venue-card-name" id="venueCardName" title="Select a venue on the map">Select a venue on the map</h4>
          
          <div class="header-badges-group">
            <span class="venue-urgency-pill hidden" id="venueUrgencyPill"><i class="fa-solid fa-fire"></i> IN 8 DAYS</span>
            <span class="venue-archive-badge hidden" id="venueArchiveBadge"><i class="fa-solid fa-box-archive"></i> TOUR ARCHIVE</span>
            
            <!-- Desktop Snap Toggle -->
            <button 
              type="button" 
              class="desktop-snap-toggle-btn" 
              id="desktopSnapToggleBtn" 
              aria-label="Toggle Details Panel Expansion"
              title="Expand / Collapse details panel (ArrowUp / ArrowDown)"
            >
              <i class="fa-solid fa-chevron-up"></i>
            </button>
          </div>
        </div>
        
        <!-- Row 2: Sub-meta Location & Date -->
        <div class="venue-sub-meta-line" id="venueSubMetaLine">
          <span class="venue-sub-location" id="venueCardLocation">Newcastle West</span>
          <span class="meta-dot">•</span>
          <span class="venue-sub-date" id="venuePeekDate">Sat, Aug 22, 2026</span>
        </div>

        <!-- Row 3: 100% Full-Width Primary CTA Button -->
        <div class="venue-primary-cta-wrap">
          <!-- Upcoming CTA: Get Tickets -->
          <a href="https://www.bandsintown.com" target="_blank" rel="noopener" class="venue-booking-btn" id="venueBookingBtn" aria-label="Get tickets for this show">
            <i class="fa-solid fa-bolt"></i>
            <span id="venueBookingBtnText">GET TICKETS — $15 (EARLY BIRD)</span>
          </a>
          
          <!-- Archived CTA: I Was There Fan Check-in Button -->
          <button type="button" class="venue-checkin-btn hidden" id="venueCheckinBtn" aria-label="Check in to show">
            <i class="fa-solid fa-ticket"></i>
            <span id="venueCheckinBtnText">340 FANS ATTENDED • "I WAS THERE" (✓)</span>
          </button>
        </div>
      </div>

      <!-- Expandable Drawer Content (Scrollable in State 2 and State 3) -->
      <div class="venue-expanded-content" id="venueExpandedContent">
        <!-- Dynamic rich container populated by gigMap.js for Upcoming / Archived -->
        <div class="venue-dynamic-body" id="venueDynamicBody">
          <!-- Populated dynamically based on event type -->
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Concert Photo Lightbox Modal -->
<div class="gig-lightbox-backdrop" id="gigPhotoLightbox" role="dialog" aria-modal="true" aria-label="Concert Photo Preview">
  <div class="gig-lightbox-content">
    <button type="button" class="gig-lightbox-close" id="gigLightboxClose" aria-label="Close photo preview">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <img src="" alt="Concert Photo" class="gig-lightbox-img" id="gigLightboxImg" loading="lazy">
    <div class="gig-lightbox-caption" id="gigLightboxCaption">Concert Photo • Kins Live</div>
  </div>
</div>

<style>
  .bottom-sheet-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 12, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-snappy);
  }

  .bottom-sheet-backdrop:global(.active) {
    opacity: 1;
    pointer-events: auto;
  }

  .bottom-sheet-container {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background: #0a0a0c;
    border-radius: 0;
    border: none;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: translateY(20px);
    opacity: 0;
    transition: transform 0.3s var(--ease-snappy), opacity 0.25s ease;
  }

  .bottom-sheet-backdrop:global(.active) .bottom-sheet-container {
    transform: translateY(0);
    opacity: 1;
  }

  /* Top Sheet Header */
  .gig-sheet-header {
    width: 100%;
    height: auto;
    min-height: 52px;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: rgba(14, 14, 17, 0.98);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
    box-sizing: border-box;
  }

  .gig-header-titles {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .gig-modal-heading {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-white);
    letter-spacing: -0.01em;
    margin: 0;
    line-height: 1.2;
  }

  .gig-banner-meta {
    font-family: var(--font-secondary);
    font-size: clamp(0.68rem, 2.6vw, 0.74rem);
    color: var(--text-muted);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
  }

  .close-sheet-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--text-white);
    width: 32px;
    height: 32px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    flex-shrink: 0;
    transition: all 0.18s ease;
  }

  .close-sheet-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.28);
    transform: scale(1.05);
  }

  /* Filter Tabs Bar */
  .gig-filter-tabs-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 16px;
    background: rgba(12, 12, 15, 0.96);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow-x: auto;
    scrollbar-width: none;
    flex-shrink: 0;
    box-sizing: border-box;
  }

  .gig-filter-tabs-bar::-webkit-scrollbar {
    display: none;
  }

  .gig-filter-tab {
    flex: 0 0 auto;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 4px 10px;
    border-radius: 9999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.18s ease;
    white-space: nowrap;
  }

  .gig-filter-tab:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }

  .gig-filter-tab.active {
    background: var(--text-white);
    color: var(--text-dark);
    border-color: var(--text-white);
    font-weight: 800;
  }

  /* Carousel Pills Row - Minimized */
  .gig-selector-pills-row {
    height: auto;
    min-height: 34px;
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    touch-action: pan-x;
    scrollbar-width: none;
    padding: 4px 14px;
    background: rgba(10, 10, 12, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .gig-selector-pills-row::-webkit-scrollbar {
    display: none;
  }

  .gig-selector-pills-row :global(.gig-select-pill) {
    flex: 0 0 auto !important;
    min-width: max-content !important;
    background: rgba(18, 18, 22, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #d4d4d8;
    font-family: var(--font-secondary);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 3px 9px;
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: all 0.18s ease;
  }

  .gig-selector-pills-row :global(.gig-select-pill:hover) {
    background: rgba(255, 255, 255, 0.14);
    color: var(--text-white);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .gig-selector-pills-row :global(.gig-select-pill.active) {
    background: var(--btn-green);
    color: var(--btn-text-color);
    border-color: var(--btn-green);
    font-weight: 900;
  }

  .gig-selector-pills-row :global(.pill-city-tag) {
    opacity: 0.7;
    font-size: 0.62rem;
  }

  .gig-selector-pills-row :global(.pill-distance-tag) {
    font-size: 0.58rem;
    background: rgba(0, 0, 0, 0.35);
    padding: 1px 4px;
    border-radius: 3px;
    font-weight: 800;
    color: inherit;
  }

  /* Map View Wrapper */
  .map-view-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    flex: 1 1 auto;
    min-height: 0;
    z-index: 1;
  }

  .gig-map-view {
    width: 100%;
    height: 100%;
    min-height: 200px;
    background: #09090b;
  }

  /* Floating Map Overlay Controls */
  .map-floating-overlay-controls {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 400;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .map-control-glass-btn {
    background: rgba(16, 16, 20, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.88rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
    transition: all 0.18s ease;
  }

  .map-control-glass-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.35);
    transform: scale(1.06);
  }

  .map-control-glass-btn:global(.is-active) {
    background: #38bdf8;
    color: #041019;
    border-color: #38bdf8;
  }

  /* Floating Directions HUD Overlay */
  .map-directions-hud {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    z-index: 500;
    background: rgba(12, 12, 16, 0.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 12px;
    padding: 10px 14px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.85);
    display: flex;
    flex-direction: column;
    gap: 8px;
    animation: slideUpHud 0.28s var(--ease-snappy) forwards;
    pointer-events: auto;
  }

  .map-directions-hud.hidden {
    display: none !important;
  }

  @keyframes slideUpHud {
    from { transform: translateY(12px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }

  .directions-hud-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .directions-hud-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .directions-hud-badge {
    background: #38bdf8;
    color: #041019;
    font-family: var(--font-secondary);
    font-size: 0.58rem;
    font-weight: 900;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .directions-hud-destination {
    font-family: var(--font-heading);
    font-size: 0.86rem;
    font-weight: 800;
    color: var(--text-white);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .directions-hud-close {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-muted);
    width: 24px;
    height: 24px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    flex-shrink: 0;
    transition: all 0.18s ease;
  }

  .directions-hud-close:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
    transform: scale(1.08);
  }

  .directions-hud-stats {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 6px 12px;
  }

  .directions-stat-item {
    display: flex;
    flex-direction: column;
    gap: 1px;
    flex: 1;
  }

  .directions-stat-label {
    font-family: var(--font-secondary);
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .directions-stat-value {
    font-family: var(--font-primary);
    font-size: 0.86rem;
    font-weight: 800;
    color: #38bdf8;
  }

  .directions-stat-divider {
    width: 1px;
    height: 24px;
    background: rgba(255, 255, 255, 0.12);
    margin: 0 10px;
  }

  .directions-hud-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .directions-gmaps-btn {
    flex: 1;
    background: #38bdf8;
    color: #031525;
    text-decoration: none;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: all 0.18s var(--ease-snappy);
  }

  .directions-gmaps-btn:hover {
    background: #7dd3fc;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(56, 189, 248, 0.4);
  }

  .directions-clear-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff;
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 800;
    padding: 6px 10px;
    border-radius: 6px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: all 0.18s ease;
  }

  .directions-clear-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* ==========================================================================
     VENUE DETAIL BOTTOM SHEET CARD (Refined 3-State Architecture)
     ========================================================================== */
  .venue-detail-bottom-card {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(13, 13, 17, 0.97);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 -14px 40px rgba(0, 0, 0, 0.9);
    display: flex;
    flex-direction: column;
    padding: 0 16px 12px 16px;
    box-sizing: border-box;
    overflow: hidden;
    touch-action: pan-y;
    contain: layout style;
    transition: height 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
                max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .venue-detail-bottom-card.is-dragging {
    transition: none !important;
    user-select: none;
    will-change: height, transform;
  }

  /* ==========================================================================
     VENUE DETAIL BOTTOM SHEET CARD (3-State Fluid Drawer Engine)
     ========================================================================== */
  .venue-detail-bottom-card {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(13, 13, 17, 0.98);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 -16px 48px rgba(0, 0, 0, 0.92);
    display: flex;
    flex-direction: column;
    padding: 0 16px 14px 16px;
    box-sizing: border-box;
    overflow: hidden;
    touch-action: pan-y;
    contain: layout style;
    transition: height 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
                max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .venue-detail-bottom-card.is-dragging {
    transition: none !important;
    user-select: none;
    will-change: height, transform;
  }

  /* --- SNAP STATE 1: PEEK / LOW (~20% screen height / ~136px) --- */
  .venue-detail-bottom-card.is-peek {
    height: 136px;
    max-height: 140px;
    overflow-y: hidden;
  }

  .venue-detail-bottom-card.is-peek .venue-expanded-content {
    display: none;
  }

  /* --- SNAP STATE 2: MID / HALF (~50% screen height) --- */
  .venue-detail-bottom-card.is-mid {
    height: auto;
    max-height: 60vh;
    max-height: 60dvh;
    overflow-y: hidden !important; /* Strict scroll lock: reveal content only via swipe up or CTA tap */
    -webkit-overflow-scrolling: auto;
  }

  .venue-detail-bottom-card.is-mid .venue-expanded-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 8px;
    padding-bottom: 2px;
    overflow: hidden;
    animation: fadeInMid 0.22s var(--ease-snappy) forwards;
  }

  .venue-detail-bottom-card:not(.is-expanded) .expanded-only-block {
    display: none !important;
  }

  @keyframes fadeInMid {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* --- SNAP STATE 3: HIGH / FULL EXPANDED (~94% screen height, scrollable body) --- */
  .venue-detail-bottom-card.is-expanded {
    height: 94vh;
    height: 94dvh;
    max-height: 96vh;
    overflow-y: auto !important; /* Free scrolling allowed in full expanded state */
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
  }

  .venue-detail-bottom-card.is-expanded .venue-card-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(13, 13, 17, 0.98);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    padding-top: 4px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .venue-detail-bottom-card.is-expanded .venue-expanded-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 12px;
    padding-bottom: 30px;
    animation: fadeInExpanded 0.24s var(--ease-snappy) forwards;
  }

  .venue-detail-bottom-card.is-expanded .expanded-only-block {
    display: flex !important;
  }

  @keyframes fadeInExpanded {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Custom Scrollbar for Card */
  .venue-detail-bottom-card::-webkit-scrollbar {
    width: 4px;
  }
  .venue-detail-bottom-card::-webkit-scrollbar-track {
    background: transparent;
  }
  .venue-detail-bottom-card::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
  }

  /* --- DRAG / TAP HANDLE BAR --- */
  .sheet-drag-handle {
    width: 100%;
    padding: 8px 0 4px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    flex-shrink: 0;
    user-select: none;
    position: relative;
    -webkit-tap-highlight-color: transparent;
  }

  .sheet-drag-handle:active {
    cursor: grabbing;
  }

  .drag-bar-pill {
    width: 38px;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.35);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sheet-drag-handle:hover .drag-bar-pill,
  .venue-detail-bottom-card.is-dragging .drag-bar-pill {
    background: rgba(255, 255, 255, 0.85);
    width: 48px;
    height: 5px;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.4);
  }

  .sheet-close-full-btn {
    display: none;
    position: absolute;
    right: 0;
    top: 2px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #d4d4d8;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .sheet-close-full-btn:hover {
    background: rgba(255, 255, 255, 0.22);
    color: #ffffff;
    transform: scale(1.08);
  }

  .venue-detail-bottom-card.is-expanded .sheet-close-full-btn {
    display: inline-flex;
  }

  /* --- VENUE CARD HEADER & METADATA --- */
  .venue-card-header {
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: 100%;
    flex-shrink: 0;
  }

  .venue-title-full-row {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
  }

  .venue-card-name {
    font-family: var(--font-heading);
    font-size: clamp(1.05rem, 4.2vw, 1.35rem);
    font-weight: 800;
    color: var(--text-white);
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
    white-space: normal;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  .header-badges-group {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .desktop-snap-toggle-btn {
    display: none;
  }

  /* Sub-meta Line: Location • Date */
  .venue-sub-meta-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    color: #a1a1aa;
    line-height: 1.3;
  }

  .meta-dot {
    opacity: 0.5;
    font-size: 0.65rem;
  }

  .venue-sub-location {
    color: #d4d4d8;
    font-weight: 600;
  }

  .venue-sub-date {
    color: #e4e4e7;
  }

  /* Urgency Pill (Upcoming) */
  .venue-urgency-pill {
    background: rgba(255, 115, 0, 0.16);
    border: 1px solid rgba(255, 115, 0, 0.38);
    color: #ff9800;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    box-shadow: 0 0 10px rgba(255, 152, 0, 0.2);
  }

  .venue-urgency-pill.hidden {
    display: none !important;
  }

  /* Archive Badge (Past) */
  .venue-archive-badge {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #e4e4e7;
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .venue-archive-badge.hidden {
    display: none !important;
  }

  /* --- 100% FULL-WIDTH PRIMARY CTAS --- */
  .venue-primary-cta-wrap {
    width: 100%;
    margin-top: 5px;
  }

  /* Upcoming Ticket CTA */
  .venue-booking-btn {
    width: 100%;
    box-sizing: border-box;
    background: #f2f0eb;
    color: #0a0a0c;
    height: 40px;
    padding: 0 16px;
    border-radius: 9px;
    text-decoration: none;
    font-family: var(--font-secondary);
    font-weight: 900;
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: none;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.6), 0 0 20px rgba(242, 240, 235, 0.18);
    transition: transform 0.18s var(--ease-snappy), background-color 0.18s ease, box-shadow 0.18s ease;
    cursor: pointer;
  }

  .venue-booking-btn i {
    color: #0a0a0c;
    font-size: 0.82rem;
  }

  .venue-booking-btn:hover {
    background: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 6px 22px rgba(255, 255, 255, 0.35);
  }

  .venue-booking-btn:active {
    transform: scale(0.98);
  }

  .venue-booking-btn.is-selling-fast {
    animation: pulseSellingFast 2.4s infinite ease-in-out;
  }

  /* Archived Check-in CTA */
  .venue-checkin-btn {
    width: 100%;
    box-sizing: border-box;
    background: linear-gradient(135deg, rgba(28, 28, 36, 0.95), rgba(18, 18, 24, 0.98));
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #ffffff;
    height: 42px;
    padding: 0 16px;
    border-radius: 9px;
    font-family: var(--font-secondary);
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
  }

  .venue-checkin-btn i {
    color: #e4e4e7;
    font-size: 0.82rem;
  }

  .venue-checkin-btn:hover {
    background: linear-gradient(135deg, rgba(38, 38, 48, 0.98), rgba(24, 24, 32, 1));
    border-color: rgba(255, 255, 255, 0.35);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.65);
  }

  .venue-checkin-btn:active {
    transform: scale(0.98);
  }

  .venue-checkin-btn.is-checked-in {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.22), rgba(5, 150, 105, 0.16));
    border-color: rgba(16, 185, 129, 0.55);
    color: #6ee7b7;
    box-shadow: 0 0 20px rgba(16, 185, 129, 0.28), 0 4px 14px rgba(0, 0, 0, 0.5);
  }

  .venue-checkin-btn.is-checked-in i {
    color: #6ee7b7;
    animation: checkmarkPop 0.3s ease-out;
  }

  @keyframes checkmarkPop {
    0% { transform: scale(0.6); }
    70% { transform: scale(1.2); }
    100% { transform: scale(1); }
  }

  .venue-checkin-btn.hidden {
    display: none !important;
  }

  /* --- DYNAMIC DRAWER BODY --- */
  .venue-dynamic-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  /* --- QUICK INFO PILL ROW (Doors, Age, Capacity) --- */
  .venue-quick-info-row {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 0;
  }

  .venue-quick-info-row::-webkit-scrollbar {
    display: none;
  }

  :global(.venue-quick-info-row .quick-chip) {
    flex: 1 1 auto !important;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #d4d4d8;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    padding: 5px 8px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    white-space: nowrap;
  }

  :global(.venue-quick-info-row .quick-chip i) {
    font-size: 0.68rem;
    color: #a1a1aa;
  }

  /* --- REDESIGNED QUICK ACTION ROW (Navigate, +Calendar, Share) --- */
  .venue-action-chips-row,
  :global(.venue-action-chips-row) {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 2px 0;
  }

  :global(.venue-action-chip-btn) {
    flex: 1 1 0;
    height: 36px;
    min-width: 0;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #f4f4f5;
    border-radius: 8px;
    padding: 0 8px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  :global(.venue-action-chip-btn#venueDirectionsAction i) {
    color: #38bdf8 !important;
    font-size: 0.76rem;
  }

  :global(.venue-action-chip-btn#venueCalendarAction i) {
    color: #fbbf24 !important;
    font-size: 0.76rem;
  }

  :global(.venue-action-chip-btn#venueShareAction i) {
    color: #a78bfa !important;
    font-size: 0.76rem;
  }

  :global(.venue-action-chip-btn:hover) {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.28);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
  }

  :global(.venue-action-chip-btn:active) {
    transform: scale(0.97);
  }

  /* --- ENHANCED SET TIMES & LINEUP CARD (Clean Hierarchy, No Arrows) --- */
  :global(.set-times-card) {
    background: rgba(18, 18, 24, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.set-times-header-title) {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #a1a1aa;
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 2px 0;
  }

  :global(.set-times-list) {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  :global(.set-time-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 8px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  :global(.set-time-left) {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow: hidden;
  }

  :global(.set-time-pill) {
    font-family: monospace;
    font-size: 0.68rem;
    font-weight: 700;
    color: #f4f4f5;
    background: rgba(255, 255, 255, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  :global(.set-act-title) {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.74rem;
    font-weight: 600;
    color: #e4e4e7;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.set-act-title.is-headliner) {
    color: #ffffff;
    font-weight: 800;
  }

  :global(.set-role-badge) {
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 4px;
    font-family: monospace;
    flex-shrink: 0;
  }

  :global(.set-role-badge.role-doors) {
    color: #a1a1aa;
    background: rgba(255, 255, 255, 0.06);
  }

  :global(.set-role-badge.role-support) {
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.25);
  }

  :global(.set-role-badge.role-headliner) {
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.12);
    border: 1px solid rgba(251, 191, 36, 0.3);
  }

  /* --- INTERACTIVE SWIPE UP CTA BUTTON / DRAWER TRIGGER --- */
  :global(.swipe-up-hint-box) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px dashed rgba(255, 255, 255, 0.22);
    border-radius: 8px;
    padding: 10px 14px;
    color: #f4f4f5;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    margin-top: 2px;
    user-select: none;
    touch-action: manipulation;
    width: 100%;
    box-sizing: border-box;
    pointer-events: auto;
  }

  /* Automatically remove swipe up button in Tier 3 / Expanded State */
  .venue-detail-bottom-card.is-expanded .swipe-up-hint-box,
  :global(.venue-detail-bottom-card.is-expanded .swipe-up-hint-box) {
    display: none !important;
  }

  :global(.swipe-up-hint-box i) {
    font-size: 0.76rem;
    color: #f4f4f5;
    animation: bounceUp 1.8s infinite ease-in-out;
  }

  :global(.swipe-up-hint-box:hover) {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.4);
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
  }

  :global(.swipe-up-hint-box:active) {
    transform: scale(0.98);
    background: rgba(255, 255, 255, 0.2);
  }

  @keyframes bounceUp {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  /* --- RECAP PHOTOS STRIP (Archived State 2) --- */
  :global(.recap-photos-strip) {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 2px 0;
  }

  :global(.recap-photos-strip::-webkit-scrollbar) {
    display: none;
  }

  :global(.recap-photo-card) {
    flex: 0 0 110px;
    height: 78px;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.12);
    cursor: pointer;
  }

  :global(.recap-photo-card img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  :global(.recap-photo-card:hover img) {
    transform: scale(1.08);
  }

  :global(.recap-photo-card .photo-caption) {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent);
    padding: 4px 6px;
    font-size: 0.62rem;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* --- SPOTIFY AS-PLAYED BUTTON --- */
  :global(.spotify-as-played-btn) {
    width: 100%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #ffffff;
    border-radius: 8px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 800;
    text-decoration: none;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: all 0.18s ease;
  }

  :global(.spotify-as-played-btn:hover) {
    background: #1db954;
    color: #0a0a0c;
    border-color: #1db954;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(29, 185, 84, 0.4);
  }

  :global(.spotify-as-played-btn i) {
    font-size: 0.85rem;
  }

  /* --- EXPANDED SECTION HEADINGS & DIVIDERS (Matched with Community & Band Members) --- */
  :global(.section-divider-bar) {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  :global(.expanded-section-title) {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-white);
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0;
    overflow: visible;
  }

  :global(.expanded-section-title span.left-title),
  :global(.set-times-header-title),
  :global(.song-request-header),
  :global(.recap-header-title) {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    gap: 8px !important;
    font-family: var(--font-heading) !important;
    font-size: 0.92rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
    color: var(--text-white) !important;
    margin: 0;
    overflow: visible;
    text-align: left;
  }

  :global(.expanded-section-title i),
  :global(.set-times-header-title i),
  :global(.song-request-header i),
  :global(.recap-header-title i) {
    color: var(--text-muted);
    font-size: 0.85rem;
    width: 1.25em;
    height: 1.25em;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  :global(.expanded-section-title span.right-hint),
  :global(.recap-header-title span.right-hint) {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--text-muted);
    font-family: monospace;
    text-transform: none;
    letter-spacing: normal;
    margin-left: auto;
