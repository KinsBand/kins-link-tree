<script>
  // Idle-loaded: share modal is interaction-gated, never needed for first render
  const scheduleIdle = (cb: () => void) => {
    if (typeof window !== 'undefined' && 'requestIdleCallback' in window) {
      (window as any).requestIdleCallback(cb, { timeout: 2000 });
    } else {
      setTimeout(cb, 1);
    }
  };
  scheduleIdle(() => {
    import('../../scripts/controllers/shareModal.js').then((m) => m.initShareModal());
  });
</script>
