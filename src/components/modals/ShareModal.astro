---
import { Image } from 'astro:assets';
import kinsLogoImg from '../../assets/new.png';
---

<!-- 1. Share Modal / Bottom Sheet Backdrop -->
<div class="modal-backdrop hidden" id="shareModal" role="dialog" aria-modal="true" aria-label="Share Kins Official Page" data-track-container="modal:share">
  <div class="share-sheet-wrapper" id="shareSheetWrapper">

    <!-- Floating Pill Header (Above Bottom Sheet / Menu) -->
    <div class="sheet-floating-pill-header" id="shareFloatingPillHeader">
      <div class="header-spacer" aria-hidden="true"></div>
      <div class="sheet-pill-title">
        <i class="fa-solid fa-share-nodes"></i>
        <span>SHARE</span>
      </div>
      <button class="sheet-pill-close-btn brutal-press" id="closeShareModal" aria-label="Close share modal" data-track="share:close">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Main Sheet / Modal Card Content -->
    <div class="modal-content share-modal-enhanced" id="shareModalContent">
      
      <!-- Mobile Drag Handle Bar -->
      <div class="sheet-drag-handle" id="sheetDragHandle" aria-hidden="true">
        <span class="sheet-drag-pill"></span>
      </div>

      <div class="modal-body share-modal-body">
        <!-- 1. Native Web Share CTA (Prioritized when navigator.share is available) -->
        <button type="button" class="native-share-primary-btn brutal-press" id="nativeShareCtaBtn" data-track="share:native_app" data-share-app="native">
          <i class="fa-solid fa-arrow-up-from-bracket"></i>
          <span>Share via App...</span>
        </button>

        <!-- 2. Direct Social Apps Share Grid -->
        <div class="share-field-group" id="socialAppsSection">
          <div class="share-field-header-row">
            <label class="share-field-label">Share to App</label>
          </div>
          <div class="share-apps-grid" id="shareAppsGrid">
            <button type="button" class="share-app-pill-btn instagram brutal-press" data-share-app="instagram" title="Share on Instagram">
              <i class="fa-brands fa-instagram"></i>
              <span>Instagram</span>
            </button>
            <button type="button" class="share-app-pill-btn messages brutal-press" data-share-app="sms" title="Share via Messages">
              <i class="fa-solid fa-comment-sms"></i>
              <span>Messages</span>
            </button>
            <button type="button" class="share-app-pill-btn whatsapp brutal-press" data-share-app="whatsapp" title="Share on WhatsApp">
              <i class="fa-brands fa-whatsapp"></i>
              <span>WhatsApp</span>
            </button>
            <button type="button" class="share-app-pill-btn discord brutal-press" data-share-app="discord" title="Share on Discord">
              <i class="fa-brands fa-discord"></i>
              <span>Discord</span>
            </button>
          </div>
        </div>

        <!-- 3. Direct Link Full-Row Interactive Target -->
        <div class="share-field-group">
          <label class="share-field-label">Direct Link</label>
          <div class="interactive-copy-row brutal-press" id="copyUrlRow" role="button" tabindex="0" aria-label="Copy website direct link" data-track="share:copy_url_row">
            <div class="copy-row-left">
              <div class="copy-row-icon-wrap">
                <i class="fa-solid fa-link link-input-icon"></i>
              </div>
              <div class="copy-row-text-stack">
                <span class="copy-row-primary">kinsband-hub.vercel.app</span>
                <span class="copy-row-secondary" id="copyUrlHint">Full UTM link with attribution</span>
              </div>
            </div>
            <div class="copy-row-right">
              <div class="icon-only-copy-btn" id="copyUrlBtn">
                <i class="fa-regular fa-copy" id="copyUrlIcon"></i>
              </div>
            </div>
          </div>
          <!-- Hidden input for clipboard fallback -->
          <input type="hidden" id="shareUrlInput" value="https://kinsband-hub.vercel.app/?utm_source=direct_link&utm_medium=share_modal&utm_campaign=fan_share">
        </div>

        <!-- 4. Band Handle Full-Row Interactive Target -->
        <div class="share-field-group">
          <label class="share-field-label">Band Handle</label>
          <div class="interactive-copy-row brutal-press" id="copyHandleRow" role="button" tabindex="0" aria-label="Copy band handle @KinsBandOfficial" data-track="share:copy_handle_row">
            <div class="copy-row-left">
              <div class="copy-row-icon-wrap">
                <i class="fa-solid fa-at handle-at-icon"></i>
              </div>
              <div class="copy-row-text-stack">
                <span class="copy-row-primary">@KinsBandOfficial</span>
                <span class="copy-row-secondary" id="copyHandleHint">Official artist handle</span>
              </div>
            </div>
            <div class="copy-row-right">
              <div class="icon-only-copy-btn" id="handleCopyBtn">
                <i class="fa-regular fa-copy" id="copyHandleIcon"></i>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 5. Dual Asset Deck: QR Code (Left) | Band Logo (Right) -->
      <div class="share-field-group">
        <label class="share-field-label">Visual & Media Assets</label>
        <div class="dual-asset-box">
          <!-- Left Asset Card: QR Code -->
          <div class="asset-card" id="qrAssetCard">
            <div class="asset-card-header">
              <span class="asset-card-title">QR CODE</span>
              <button type="button" class="asset-download-btn brutal-press" id="openQrDownloadModalBtn" title="Export QR Code Formats" aria-label="Download QR Code">
                <i class="fa-solid fa-download"></i>
              </button>
            </div>
            <div class="qr-canvas-clickable" id="qrcodeCanvasWrapper" role="button" tabindex="0" title="Click to view full screen QR code" aria-label="Fullscreen QR Code">
              <div class="qr-canvas-inner" id="qrcodeCanvas"></div>
              <div class="asset-hover-tap-badge">
                <i class="fa-solid fa-expand"></i>
                <span>Fullscreen</span>
              </div>
            </div>
          </div>

          <!-- Right Asset Card: Band Logo -->
          <div class="asset-card" id="logoAssetCard">
            <div class="asset-card-header">
              <span class="asset-card-title">LOGO</span>
              <button type="button" class="asset-download-btn brutal-press" id="openLogoDownloadModalBtn" title="Export Band Logo Formats" aria-label="Download Band Logo">
                <i class="fa-solid fa-download"></i>
              </button>
            </div>
            <div class="band-logo-preview-box" id="openLogoDownloadModalBox" role="button" tabindex="0" title="Click to download Band Logo formats" aria-label="Download Band Logo">
              <Image src={kinsLogoImg} alt="Kins Band Official Logo" class="band-logo-asset-img" width={110} height={110} />
              <div class="asset-hover-tap-badge">
                <i class="fa-solid fa-download"></i>
                <span>Export</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 6. Minimalist PWA App CTA Button -->
      <div class="share-field-group pwa-install-group" id="pwaInstallFieldGroup">
        <button
          type="button"
          class="download-pwa-primary-btn brutal-press"
          id="downloadPwaCtaBtn"
          data-track="share:download_pwa"
          aria-label="Install Kins Official App"
          title="Install Kins App for offline access"
        >
          <span class="pwa-progress-track" id="pwaProgressTrack" aria-hidden="true">
            <span class="pwa-progress-bar" id="pwaProgressBar"></span>
          </span>
          <div class="pwa-btn-content" id="pwaBtnContent">
            <div class="pwa-btn-left">
              <i class="fa-solid fa-download pwa-btn-icon" id="pwaBtnIcon" aria-hidden="true"></i>
              <span class="pwa-btn-title" id="pwaBtnLabel">Install App</span>
            </div>
            <div class="pwa-status-pill-wrap">
              <span class="pwa-status-badge" id="pwaProgressStatus">FREE</span>
            </div>
          </div>
        </button>
      </div>

    </div>
  </div>
</div>

<!-- 7. Fullscreen QR Code Lightbox Modal / Bottom Sheet -->
<div class="modal-backdrop hidden" id="qrFullscreenModal" role="dialog" aria-modal="true" aria-label="Full screen QR Code">
  <div class="qr-fullscreen-sheet-wrapper" id="qrFullscreenSheetWrapper">
    <!-- Floating Pill Header -->
    <div class="sheet-floating-pill-header" id="qrFullscreenFloatingPillHeader">
      <div class="header-spacer" aria-hidden="true"></div>
      <div class="sheet-pill-title">
        <i class="fa-solid fa-qrcode"></i>
        <span>QR CODE</span>
      </div>
      <button class="sheet-pill-close-btn brutal-press" id="closeQrFullscreenBtn" aria-label="Close full screen QR code">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Main Sheet / Modal Content -->
    <div class="qr-fullscreen-content" id="qrFullscreenContent">
      <div class="sheet-drag-handle" id="qrFullscreenDragHandle" aria-hidden="true">
        <span class="sheet-drag-pill"></span>
      </div>

      <div class="qr-fullscreen-canvas-wrapper" id="qrcodeFullscreenCanvas"></div>
      <p class="qr-fullscreen-sub">Point mobile camera to view Kins official link tree</p>
      
      <!-- Instant 1-Click Fast Export Bar -->
      <div class="qr-fast-export-bar">
        <span class="fast-export-label">Fast Export Formats:</span>
        <div class="fast-export-buttons">
          <button type="button" class="fast-export-btn brutal-press" data-qr-quick-format="png" title="Download High Resolution PNG">
            <i class="fa-solid fa-image"></i>
            <span>PNG HD</span>
          </button>
          <button type="button" class="fast-export-btn brutal-press" data-qr-quick-format="svg" title="Download Scalable Vector Graphic">
            <i class="fa-solid fa-bezier-curve"></i>
            <span>SVG Vector</span>
          </button>
          <button type="button" class="fast-export-btn brutal-press" data-qr-quick-format="eps" title="Download Print Shop EPS Vector">
            <i class="fa-solid fa-file-lines"></i>
            <span>EPS Vector</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 8. QR Format Selection Download Modal / Bottom Sheet -->
<div class="modal-backdrop hidden" id="qrDownloadFormatModal" role="dialog" aria-modal="true" aria-label="Select QR Code Download Format">
  <div class="qr-download-sheet-wrapper" id="qrDownloadSheetWrapper">
    <!-- Floating Pill Header -->
    <div class="sheet-floating-pill-header" id="qrDownloadFloatingPillHeader">
      <div class="header-spacer" aria-hidden="true"></div>
      <div class="sheet-pill-title">
        <i class="fa-solid fa-download"></i>
        <span>EXPORT QR</span>
      </div>
      <button class="sheet-pill-close-btn brutal-press" id="closeQrFormatModalBtn" aria-label="Close format selector">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Main Sheet / Modal Content -->
    <div class="qr-format-modal-content" id="qrDownloadFormatContent">
      <div class="sheet-drag-handle" id="qrFormatDragHandle" aria-hidden="true">
        <span class="sheet-drag-pill"></span>
      </div>
      <div class="format-options-grid">
        <button type="button" class="format-option-card brutal-press" data-format="jpeg">
          <div class="format-badge-icon jpeg">JPG</div>
          <div class="format-details">
            <span class="format-name">JPEG Image</span>
            <span class="format-desc">High resolution 300 DPI image</span>
          </div>
          <i class="fa-solid fa-download format-action-icon"></i>
        </button>
        <button type="button" class="format-option-card brutal-press" data-format="png">
          <div class="format-badge-icon png">PNG</div>
          <div class="format-details">
            <span class="format-name">PNG Image</span>
            <span class="format-desc">Ultra HD 300 DPI crisp raster</span>
          </div>
          <i class="fa-solid fa-download format-action-icon"></i>
        </button>
        <button type="button" class="format-option-card brutal-press" data-format="eps">
          <div class="format-badge-icon eps">EPS</div>
          <div class="format-details">
            <span class="format-name">EPS Vector</span>
            <span class="format-desc">Professional print shop vector</span>
          </div>
          <i class="fa-solid fa-download format-action-icon"></i>
        </button>
        <button type="button" class="format-option-card brutal-press" data-format="svg">
          <div class="format-badge-icon svg">SVG</div>
          <div class="format-details">
            <span class="format-name">SVG Vector</span>
            <span class="format-desc">Scalable vector graphics</span>
          </div>
          <i class="fa-solid fa-download format-action-icon"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- 9. Band Logo Format Selection Download Modal / Bottom Sheet -->
<div class="modal-backdrop hidden" id="logoDownloadFormatModal" role="dialog" aria-modal="true" aria-label="Select Band Logo Download Format">
  <div class="logo-download-sheet-wrapper" id="logoDownloadSheetWrapper">
    <!-- Floating Pill Header -->
    <div class="sheet-floating-pill-header" id="logoDownloadFloatingPillHeader">
      <div class="header-spacer" aria-hidden="true"></div>
      <div class="sheet-pill-title">
        <i class="fa-solid fa-download"></i>
        <span>EXPORT LOGO</span>
      </div>
      <button class="sheet-pill-close-btn brutal-press" id="closeLogoFormatModalBtn" aria-label="Close format selector">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Main Sheet / Modal Content -->
    <div class="qr-format-modal-content" id="logoDownloadFormatContent">
      <div class="sheet-drag-handle" id="logoFormatDragHandle" aria-hidden="true">
        <span class="sheet-drag-pill"></span>
      </div>
      <div class="format-options-grid">
        <button type="button" class="format-option-card brutal-press" data-logo-format="png">
          <div class="format-badge-icon png">PNG</div>
          <div class="format-details">
            <span class="format-name">PNG Transparent</span>
            <span class="format-desc">High resolution transparent logo</span>
          </div>
          <i class="fa-solid fa-download format-action-icon"></i>
        </button>
        <button type="button" class="format-option-card brutal-press" data-logo-format="jpeg">
          <div class="format-badge-icon jpeg">JPG</div>
          <div class="format-details">
            <span class="format-name">JPEG Image</span>
            <span class="format-desc">High contrast dark background image</span>
          </div>
          <i class="fa-solid fa-download format-action-icon"></i>
        </button>
        <button type="button" class="format-option-card brutal-press" data-logo-format="svg">
          <div class="format-badge-icon svg">SVG</div>
          <div class="format-details">
            <span class="format-name">SVG Vector</span>
            <span class="format-desc">Scalable vector graphics logo</span>
          </div>
          <i class="fa-solid fa-download format-action-icon"></i>
        </button>
        <button type="button" class="format-option-card brutal-press" data-logo-format="webp">
          <div class="format-badge-icon eps">WEBP</div>
          <div class="format-details">
            <span class="format-name">WebP Image</span>
            <span class="format-desc">Optimized web format logo</span>
          </div>
          <i class="fa-solid fa-download format-action-icon"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- 10. iOS Safari Step-by-Step Installation Modal / Bottom Sheet -->
<div class="modal-backdrop hidden" id="iosInstallGuideModal" role="dialog" aria-modal="true" aria-label="Add Kins to iOS Home Screen">
  <div class="ios-guide-sheet-wrapper" id="iosGuideSheetWrapper">
    <!-- Floating Pill Header -->
    <div class="sheet-floating-pill-header" id="iosGuideFloatingPillHeader">
      <div class="header-spacer" aria-hidden="true"></div>
      <div class="sheet-pill-title">
        <i class="fa-brands fa-apple"></i>
        <span>IOS INSTALL</span>
      </div>
      <button class="sheet-pill-close-btn brutal-press" id="closeIosGuideModalBtn" aria-label="Close iOS guide">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Main Sheet / Modal Content -->
    <div class="ios-guide-modal-content" id="iosGuideModalContent">
      <div class="sheet-drag-handle" id="iosGuideDragHandle" aria-hidden="true">
        <span class="sheet-drag-pill"></span>
      </div>
      
      <div class="ios-guide-header">
        <div class="ios-guide-app-badge">
          <Image src={kinsLogoImg} alt="Kins Band App" class="ios-app-icon-img" width={48} height={48} />
          <div class="ios-app-meta">
            <h4 class="ios-guide-title">Install Kins on iOS</h4>
            <p class="ios-guide-sub">Add to your iPhone / iPad Home Screen</p>
          </div>
        </div>
      </div>

      <div class="ios-steps-list">
        <div class="ios-step-item">
          <div class="ios-step-num">1</div>
          <div class="ios-step-body">
            <div class="ios-step-text">
              Tap the <strong>Share button</strong> <span class="ios-icon-inline"><i class="fa-solid fa-arrow-up-from-bracket"></i></span> in Safari's bottom toolbar.
            </div>
          </div>
        </div>

        <div class="ios-step-item">
          <div class="ios-step-num">2</div>
          <div class="ios-step-body">
            <div class="ios-step-text">
              Scroll down and tap <strong>'Add to Home Screen'</strong> <span class="ios-icon-inline"><i class="fa-regular fa-square-plus"></i></span>.
            </div>
          </div>
        </div>

        <div class="ios-step-item">
          <div class="ios-step-num">3</div>
          <div class="ios-step-body">
            <div class="ios-step-text">
              Tap <strong>Add</strong> in the top right corner. You're ready to rock offline!
            </div>
          </div>
        </div>
      </div>

      <button type="button" class="native-share-primary-btn brutal-press ios-guide-done-btn" id="iosGuideGotItBtn">
        <span>Got It</span>
        <i class="fa-solid fa-check" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.24s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.24s;
  }

  /* Sub-modal stacking z-index */
  .modal-backdrop#qrFullscreenModal,
  .modal-backdrop#qrDownloadFormatModal,
  .modal-backdrop#logoDownloadFormatModal,
  .modal-backdrop#iosInstallGuideModal {
    z-index: 1050;
  }

  .modal-backdrop.active,
  .modal-backdrop:not(.hidden):not(.is-closing) {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .modal-backdrop.is-closing {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    transition: opacity 0.2s ease, visibility 0.2s !important;
  }

  /* Keyframe Animations for Desktop */
  @keyframes modalPopIn {
    from {
      transform: scale(0.94) translateY(12px);
      opacity: 0;
    }
    to {
      transform: scale(1) translateY(0);
      opacity: 1;
    }
  }

  @keyframes modalPopOut {
    from {
      transform: scale(1) translateY(0);
      opacity: 1;
    }
    to {
      transform: scale(0.95) translateY(10px);
      opacity: 0;
    }
  }

  /* Desktop Default: Centered Brutalist Cards */
  .share-modal-enhanced,
  .qr-fullscreen-content,
  .qr-format-modal-content,
  .ios-guide-modal-content {
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 6px 6px 0px #000000;
    border-radius: 12px;
    width: 100%;
    padding: 20px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    position: relative;
    overscroll-behavior: contain;
  }

  /* Chalkboard fine grain noise texture overlay on modal/sheet surfaces */
  .share-modal-enhanced::before,
  .qr-fullscreen-content::before,
  .qr-format-modal-content::before,
  .ios-guide-modal-content::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("/noise-tile.webp");
    background-repeat: repeat;
    background-size: 64px 64px;
    image-rendering: pixelated;
    opacity: 0.055;
    pointer-events: none;
    border-radius: inherit;
    z-index: 0;
  }

  .share-modal-enhanced > *,
  .qr-fullscreen-content > *,
  .qr-format-modal-content > *,
  .ios-guide-modal-content > * {
    position: relative;
    z-index: 1;
  }

  .share-modal-enhanced {
    max-width: 440px;
    gap: 14px;
    max-height: 90vh;
    overflow-y: auto;
  }

  .qr-fullscreen-content {
    max-width: 380px;
    padding: 20px;
    align-items: center;
    gap: 14px;
    text-align: center;
  }

  .qr-fullscreen-header-bar {
    width: 100%;
    box-sizing: border-box;
  }

  .qr-format-modal-content {
    max-width: 380px;
    gap: 14px;
  }

  /* Sheet Drag Handle (Hidden on Desktop) */
  .sheet-drag-handle {
    display: none;
    width: 100%;
    padding: 2px 0 8px 0;
    justify-content: center;
    cursor: grab;
    touch-action: none;
  }

  .sheet-drag-pill {
    width: 42px;
    height: 5px;
    background: #000000;
    border-radius: 999px;
    opacity: 0.35;
    pointer-events: none;
  }

  /* Floating Header Pill Container (Above Sheet / Modal) */
  .share-sheet-wrapper,
  .qr-fullscreen-sheet-wrapper,
  .qr-download-sheet-wrapper,
  .logo-download-sheet-wrapper,
  .ios-guide-sheet-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 440px;
    gap: 12px;
    position: relative;
    z-index: 10;
    animation: modalPopIn 0.24s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    will-change: transform, opacity;
  }

  .share-sheet-wrapper.is-closing,
  .qr-fullscreen-sheet-wrapper.is-closing,
  .qr-download-sheet-wrapper.is-closing,
  .logo-download-sheet-wrapper.is-closing,
  .ios-guide-sheet-wrapper.is-closing {
    animation: modalPopOut 0.18s ease forwards !important;
  }

  .qr-fullscreen-sheet-wrapper {
    max-width: 420px;
  }

  .sheet-floating-pill-header {
    display: grid;
    grid-template-columns: 40px 1fr 40px;
    align-items: center;
    justify-items: center;
    width: 100%;
    padding: 0 4px;
    box-sizing: border-box;
    z-index: 20;
    user-select: none;
    pointer-events: none;
    transition: transform 0.16s var(--ease-tactile);
  }

  .sheet-floating-pill-header > * {
    pointer-events: auto;
  }

  .header-spacer {
    width: 40px;
    height: 40px;
    visibility: hidden;
    pointer-events: none;
  }

  .sheet-pill-title {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--surface-card-panel, #f5f4ef);
    border: 2.5px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 9999px;
    padding: 7px 20px;
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.88rem;
    font-weight: 900;
    color: var(--text-card-primary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sheet-pill-title i {
    font-size: 0.85rem;
    color: var(--brand-accent-primary, #f2fd43);
    filter: drop-shadow(0 0 1px #000000);
  }

  :global([data-theme="dark"]) .sheet-pill-title i {
    color: var(--brand-accent-primary, #d4af37);
  }

  .sheet-pill-close-btn {
    justify-self: end;
    background: var(--btn-brand-primary, #f2fd43);
    color: var(--btn-brand-text, #000000);
    border: 2.5px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }

  .sheet-pill-close-btn i {
    font-size: 0.95rem;
    pointer-events: none;
  }

  .sheet-pill-close-btn:hover {
    background: var(--btn-brand-hover, #faff60);
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px #000000;
  }

  .sheet-pill-close-btn:focus-visible {
    outline: 2px solid var(--brand-accent-primary, #f2fd43);
    outline-offset: 2px;
  }

  .sheet-pill-close-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Secondary Sub-Modal Headers (QR / Logo Modals) */
  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 8px;
    border-bottom: 2px solid #000000;
  }

  .modal-title-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }

  .brand-mini-badge {
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--text-card-primary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .modal-title-group h3 {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 900;
    color: var(--text-card-primary);
    margin: 0;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .close-modal-btn {
    background: var(--surface-input);
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .close-modal-btn i {
    pointer-events: none;
  }

  .close-modal-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
  }

  .share-modal-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* 1. Native Share CTA */
  .native-share-primary-btn {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2.5px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    padding: 12px 18px;
    font-family: var(--font-secondary);
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 46px;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
  }

  .native-share-primary-btn i,
  .native-share-primary-btn span {
    pointer-events: none;
  }

  .native-share-primary-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px #000000;
  }

  /* Social Apps Share Grid */
  .share-field-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .share-field-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .share-field-label {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--text-card-primary);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .share-apps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    width: 100%;
    box-sizing: border-box;
  }

  .share-app-pill-btn {
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 8px 3px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    cursor: pointer;
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--text-card-primary);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.15s var(--ease-tactile), background-color 0.15s ease, box-shadow 0.15s ease, color 0.15s ease;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .share-app-pill-btn i {
    font-size: 1.15rem;
    pointer-events: none;
  }

  .share-app-pill-btn span {
    pointer-events: none;
    line-height: 1.1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .share-app-pill-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .share-app-pill-btn.instagram:hover { background: #E1306C; color: #ffffff; }
  .share-app-pill-btn.messages:hover { background: #34C759; color: #ffffff; }
  .share-app-pill-btn.whatsapp:hover { background: #25D366; color: #000000; }
  .share-app-pill-btn.discord:hover { background: #5865F2; color: #ffffff; }

  /* Interactive Tap-to-Copy Full Rows */
  .interactive-copy-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background: var(--surface-card-panel, #f5f4ef);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 8px;
    padding: 8px 12px;
    cursor: pointer;
    user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.15s var(--ease-tactile), background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .interactive-copy-row:hover {
    background: var(--surface-card-panel-hover, #ffffff);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .copy-row-left {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex: 1;
  }

  .copy-row-icon-wrap {
    width: 32px;
    height: 32px;
    min-width: 32px;
    background: #000000;
    color: var(--accent-neon-yellow);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .copy-row-text-stack {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
    overflow: hidden;
  }

  .copy-row-primary {
    font-family: var(--font-secondary);
    font-size: 0.84rem;
    font-weight: 800;
    color: var(--text-card-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .copy-row-secondary {
    font-family: var(--font-secondary);
    font-size: 0.64rem;
    font-weight: 700;
    color: var(--text-card-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .copy-row-right {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .icon-only-copy-btn {
    background: var(--surface-card-panel, #f5f4ef);
    color: var(--text-card-primary);
    border: 1.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    pointer-events: none;
    transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .interactive-copy-row:hover .icon-only-copy-btn {
    background: var(--btn-brand-primary, #f2fd43);
    color: #000000;
  }

  .icon-only-copy-btn i {
    font-size: 0.88rem;
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .icon-only-copy-btn i.fa-check,
  .icon-only-copy-btn .text-check-success {
    color: #10b981 !important;
    font-weight: 900 !important;
  }

  /* Dual Asset Grid: QR (Left) | Logo (Right) */
  .dual-asset-box {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    width: 100%;
    box-sizing: border-box;
  }

  .asset-card {
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 8px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: transform 0.16s var(--ease-tactile);
  }

  .asset-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
  }

  .asset-card-title {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-card-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .asset-download-btn {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 1.5px solid #000000;
    box-shadow: 1px 1px 0px #000000;
    width: 26px;
    height: 26px;
    min-width: 26px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.72rem;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .asset-download-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
  }

  /* Asset Preview Containers */
  .qr-canvas-clickable,
  .band-logo-preview-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #000000;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.18s var(--ease-snappy);
  }

  .qr-canvas-clickable {
    background: #ffffff;
    padding: 6px;
  }

  .qr-canvas-inner {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .qr-canvas-inner :global(img) {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain;
    border-radius: 4px;
  }

  .band-logo-preview-box {
    background: #111114;
    padding: 8px;
  }

  .band-logo-asset-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .asset-hover-tap-badge {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.82);
    color: var(--accent-neon-yellow);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.18s ease;
    text-align: center;
    padding: 2px;
  }

  .qr-canvas-clickable:hover .asset-hover-tap-badge,
  .band-logo-preview-box:hover .asset-hover-tap-badge {
    opacity: 1;
  }

  /* ==========================================================================
     Minimalist PWA CTA Button
     ========================================================================== */
  .pwa-install-group {
    margin-top: 4px;
  }

  .download-pwa-primary-btn {
    position: relative;
    overflow: hidden;
    background: var(--btn-brand-primary, #f2fd43);
    color: var(--btn-brand-text, #000000);
    border: var(--border-brutal, 3px solid #000000);
    box-shadow: var(--shadow-brutal-black, 3px 3px 0px #000000);
    padding: 0;
    border-radius: var(--radius-sm, 8px);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    height: 48px;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }

  .download-pwa-primary-btn:hover {
    background: var(--btn-brand-hover, #faff60);
    transform: translate(-1px, -1px);
    box-shadow: var(--shadow-brutal-black-lg, 4px 4px 0px #000000);
  }

  .download-pwa-primary-btn:active {
    transform: translate(2px, 2px) scale(0.985);
    box-shadow: 1px 1px 0px #000000;
  }

  .download-pwa-primary-btn:focus-visible {
    outline: 2px solid var(--brand-accent-primary, #f2fd43);
    outline-offset: 2px;
  }

  .pwa-progress-track {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: transparent;
    pointer-events: none;
    z-index: 1;
  }

  .pwa-progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0%;
    background: rgba(16, 185, 129, 0.35);
    border-right: 2.5px solid #000000;
    transition: width 0.12s linear;
    pointer-events: none;
    will-change: width;
  }

  .pwa-btn-content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding: 0 14px;
    box-sizing: border-box;
  }

  .pwa-btn-left {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .pwa-btn-icon {
    font-size: 1.05rem;
    color: #000000;
    flex-shrink: 0;
    transition: transform 0.16s var(--ease-tactile);
  }

  .download-pwa-primary-btn:hover .pwa-btn-icon {
    transform: scale(1.1);
  }

  .pwa-btn-title {
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.88rem;
    font-weight: 900;
    color: #000000;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pwa-status-pill-wrap {
    flex-shrink: 0;
  }

  .pwa-status-badge {
    font-family: var(--font-primary, var(--font-secondary));
    font-size: 0.66rem;
    font-weight: 900;
    color: #000000;
    background: rgba(255, 255, 255, 0.95);
    border: 1.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    padding: 3px 8px;
    border-radius: var(--radius-pill, 9999px);
    letter-spacing: 0.04em;
    white-space: nowrap;
    transition: background-color 0.16s ease, color 0.16s ease;
  }

  /* State 2: Downloading in progress */
  .download-pwa-primary-btn.downloading {
    cursor: wait;
    background: var(--surface-input, #ffffff);
  }

  .download-pwa-primary-btn.downloading .pwa-btn-title {
    color: var(--text-card-primary, #000000);
  }

  .download-pwa-primary-btn.downloading .pwa-btn-icon {
    color: var(--text-card-primary, #000000);
  }

  .download-pwa-primary-btn.downloading .pwa-status-badge {
    background: #000000;
    color: var(--brand-accent-primary, #f2fd43);
  }

  /* State 3: Already Installed */
  .download-pwa-primary-btn.download-complete,
  .download-pwa-primary-btn.installed-mode {
    background: #10b981;
    color: #000000;
  }

  .download-pwa-primary-btn.download-complete:hover,
  .download-pwa-primary-btn.installed-mode:hover {
    background: #34d399;
  }

  .download-pwa-primary-btn.download-complete .pwa-btn-icon,
  .download-pwa-primary-btn.installed-mode .pwa-btn-icon {
    color: #000000;
  }

  .download-pwa-primary-btn.download-complete .pwa-btn-title,
  .download-pwa-primary-btn.installed-mode .pwa-btn-title {
    color: #000000;
  }

  .download-pwa-primary-btn.download-complete .pwa-status-badge,
  .download-pwa-primary-btn.installed-mode .pwa-status-badge {
    background: #000000;
    color: #53FC18;
  }

  /* State 4: iOS Safari Guidance Mode */
  .download-pwa-primary-btn.ios-mode .pwa-status-badge {
    background: #000000;
    color: var(--brand-accent-primary, #f2fd43);
  }

  /* Dark Mode 1:1 Theme Parity Matrix for PWA Button */
  :global([data-theme="dark"]) .download-pwa-primary-btn {
    background: var(--btn-brand-primary, #d4af37);
    color: #000000;
    border-color: #000000;
    box-shadow: 3px 3px 0px #000000;
  }

  :global([data-theme="dark"]) .download-pwa-primary-btn:hover {
    background: var(--btn-brand-hover, #e5c07b);
  }

  :global([data-theme="dark"]) .download-pwa-primary-btn .pwa-btn-icon {
    color: #000000;
  }

  :global([data-theme="dark"]) .download-pwa-primary-btn .pwa-btn-title {
    color: #000000;
  }

  :global([data-theme="dark"]) .download-pwa-primary-btn .pwa-status-badge {
    background: #000000;
    color: var(--brand-accent-primary, #d4af37);
    border-color: #000000;
  }

  :global([data-theme="dark"]) .download-pwa-primary-btn.downloading {
    background: var(--surface-elevated, #1e1e24);
  }

  :global([data-theme="dark"]) .download-pwa-primary-btn.downloading .pwa-btn-title,
  :global([data-theme="dark"]) .download-pwa-primary-btn.downloading .pwa-btn-icon {
    color: var(--text-on-dark, #f5f5f7);
  }

  :global([data-theme="dark"]) .download-pwa-primary-btn.downloading .pwa-progress-bar {
    background: rgba(212, 175, 55, 0.35);
  }

  :global([data-theme="dark"]) .download-pwa-primary-btn.download-complete,
  :global([data-theme="dark"]) .download-pwa-primary-btn.installed-mode {
    background: #059669;
    color: #ffffff;
  }

  :global([data-theme="dark"]) .download-pwa-primary-btn.download-complete:hover,
  :global([data-theme="dark"]) .download-pwa-primary-btn.installed-mode:hover {
    background: #10b981;
  }

  :global([data-theme="dark"]) .download-pwa-primary-btn.download-complete .pwa-btn-title,
  :global([data-theme="dark"]) .download-pwa-primary-btn.installed-mode .pwa-btn-title,
  :global([data-theme="dark"]) .download-pwa-primary-btn.download-complete .pwa-btn-icon,
  :global([data-theme="dark"]) .download-pwa-primary-btn.installed-mode .pwa-btn-icon {
    color: #ffffff;
  }

  :global([data-theme="dark"]) .download-pwa-primary-btn.download-complete .pwa-status-badge,
  :global([data-theme="dark"]) .download-pwa-primary-btn.installed-mode .pwa-status-badge {
    background: #000000;
    color: #53FC18;
  }

  /* ==========================================================================
     iOS Safari Step-by-Step Guidance Modal Styles
     ========================================================================== */
  .ios-guide-modal-content {
    max-width: 400px;
    gap: 16px;
  }

  .ios-guide-header {
    width: 100%;
    padding-bottom: 12px;
    border-bottom: 2px solid #000000;
  }

  .ios-guide-app-badge {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ios-app-icon-img {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    background: #000000;
    object-fit: contain;
    flex-shrink: 0;
  }

  .ios-app-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }

  .ios-guide-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 900;
    color: var(--text-card-primary);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .ios-guide-sub {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-card-secondary);
    margin: 0;
  }

  .ios-steps-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .ios-step-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 8px;
    padding: 10px 12px;
    box-sizing: border-box;
  }

  .ios-step-num {
    width: 26px;
    height: 26px;
    min-width: 26px;
    background: var(--btn-brand-primary, #f2fd43);
    color: #000000;
    border: 1.5px solid #000000;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 900;
    flex-shrink: 0;
  }

  :global([data-theme="dark"]) .ios-step-num {
    background: var(--btn-brand-primary, #d4af37);
  }

