---
import { Image } from 'astro:assets';
import kinsLogoImg from '../../assets/new.png';
---

<!-- Share Modal Backdrop -->
<div class="modal-backdrop hidden" id="shareModal" role="dialog" aria-modal="true" aria-label="Share Kins Official Page" data-track-container="modal:share">
  <div class="modal-content share-modal-enhanced">
    <!-- Header -->
    <div class="modal-header">
      <div class="modal-title-group">
        <span class="brand-mini-badge">Kins • Official Link Tree</span>
        <h3>SHARE</h3>
      </div>
      <button class="close-modal-btn" id="closeShareModal" aria-label="Close share modal" data-track="share:close">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="modal-body share-modal-body">
      <!-- 1. Native Web Share CTA -->
      <button type="button" class="native-share-primary-btn" id="nativeShareCtaBtn" data-track="share:native_app" data-share-app="native">
        <i class="fa-solid fa-arrow-up-from-bracket"></i>
        <span>Share via App...</span>
      </button>

      <!-- 2. Direct Social Apps Share Grid (Single Horizontal Row) -->
      <div class="share-field-group">
        <label class="share-field-label">Share to App</label>
        <div class="share-apps-grid" id="shareAppsGrid">
          <button type="button" class="share-app-pill-btn instagram" data-share-app="instagram" title="Share on Instagram">
            <i class="fa-brands fa-instagram"></i>
            <span>Instagram</span>
          </button>
          <button type="button" class="share-app-pill-btn messages" data-share-app="sms" title="Share via Messages">
            <i class="fa-solid fa-comment-sms"></i>
            <span>Messages</span>
          </button>
          <button type="button" class="share-app-pill-btn whatsapp" data-share-app="whatsapp" title="Share on WhatsApp">
            <i class="fa-brands fa-whatsapp"></i>
            <span>WhatsApp</span>
          </button>
          <button type="button" class="share-app-pill-btn discord" data-share-app="discord" title="Share on Discord">
            <i class="fa-brands fa-discord"></i>
            <span>Discord</span>
          </button>
        </div>
      </div>

      <!-- 3. Direct Link Input Box -->
      <div class="share-field-group">
        <label class="share-field-label" for="shareUrlInput">Direct Link</label>
        <div class="copy-input-group">
          <div class="copy-input-wrapper">
            <i class="fa-solid fa-link link-input-icon"></i>
            <input type="text" id="shareUrlInput" value="https://kinsband.com/?utm_source=share_modal&utm_medium=direct_link" readonly>
          </div>
          <button id="copyUrlBtn" class="icon-only-copy-btn" title="Copy website link" aria-label="Copy website link" data-track="share:copy_url">
            <i class="fa-regular fa-copy"></i>
          </button>
        </div>
      </div>

      <!-- 4. Band Handle Box -->
      <div class="share-field-group">
        <label class="share-field-label">Band Handle</label>
        <div class="share-copy-handle-wrapper">
          <div class="handle-display-box">
            <i class="fa-solid fa-at handle-at-icon"></i>
            <span class="handle-handle-text">@KinsBandOfficial</span>
          </div>
          <button class="icon-only-copy-btn" id="handleCopyBtn" title="Copy handle @KinsBandOfficial" aria-label="Copy handle @KinsBandOfficial" data-track="share:copy_handle">
            <i class="fa-regular fa-copy"></i>
          </button>
        </div>
      </div>

      <!-- 5. Dual Asset Grid: QR Code Card (Left) | Band Logo Card (Right) -->
      <div class="dual-asset-box">
        <!-- Left Asset Card: QR Code -->
        <div class="asset-card">
          <div class="asset-card-header">
            <span class="asset-card-title">QR CODE</span>
            <button type="button" class="asset-download-btn" id="openQrDownloadModalBtn" title="Download QR Code Asset" aria-label="Download QR Code">
              <i class="fa-solid fa-download"></i>
            </button>
          </div>
          <div class="qr-canvas-clickable" id="qrcodeCanvasWrapper" title="Click to view full screen QR code">
            <div class="qr-canvas-inner" id="qrcodeCanvas"></div>
            <div class="qr-hover-tap-badge">
              <i class="fa-solid fa-expand"></i>
              <span>Fullscreen</span>
            </div>
          </div>
        </div>

        <!-- Right Asset Card: Band Logo -->
        <div class="asset-card">
          <div class="asset-card-header">
            <span class="asset-card-title">LOGO</span>
            <button type="button" class="asset-download-btn" id="openLogoDownloadModalBtn" title="Download Band Logo Asset" aria-label="Download Band Logo">
              <i class="fa-solid fa-download"></i>
            </button>
          </div>
          <div class="band-logo-preview-box" id="openLogoDownloadModalBox" title="Click to download Band Logo format">
            <Image src={kinsLogoImg} alt="Kins Band Official Logo" class="band-logo-asset-img" width={120} height={120} />
            <div class="logo-hover-tap-badge">
              <i class="fa-solid fa-download"></i>
              <span>Export</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 6. Download Progressive Web App CTA Button -->
      <button type="button" class="download-pwa-primary-btn" id="downloadPwaCtaBtn" data-track="share:download_pwa">
        <i class="fa-solid fa-download"></i>
        <span>Download App</span>
      </button>
    </div>
  </div>
</div>

<!-- 6. Fullscreen QR Code Lightbox Modal -->
<div class="modal-backdrop hidden" id="qrFullscreenModal" role="dialog" aria-modal="true" aria-label="Full screen QR Code">
  <div class="qr-fullscreen-content">
    <button class="close-modal-btn qr-fullscreen-close" id="closeQrFullscreenBtn" aria-label="Close full screen QR code">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <div class="qr-fullscreen-header">
      <span class="brand-mini-badge">Kins Official</span>
      <h2>Scan to Open Link in Bio</h2>
    </div>
    <div class="qr-fullscreen-canvas-wrapper" id="qrcodeFullscreenCanvas"></div>
    <p class="qr-fullscreen-sub">Point mobile camera to view Kins official website</p>
  </div>
</div>

<!-- 7. QR Format Selection Download Modal -->
<div class="modal-backdrop hidden" id="qrDownloadFormatModal" role="dialog" aria-modal="true" aria-label="Select QR Code Download Format">
  <div class="qr-format-modal-content">
    <div class="modal-header">
      <div class="modal-title-group">
        <span class="brand-mini-badge">Export Vector & HD Assets</span>
        <h3>Download QR Code</h3>
      </div>
      <button class="close-modal-btn" id="closeQrFormatModalBtn" aria-label="Close format selector">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <div class="format-options-grid">
      <button type="button" class="format-option-card" data-format="jpeg">
        <div class="format-badge-icon jpeg">JPG</div>
        <div class="format-details">
          <span class="format-name">JPEG Image</span>
          <span class="format-desc">High resolution 300 DPI image</span>
        </div>
        <i class="fa-solid fa-download format-action-icon"></i>
      </button>
      <button type="button" class="format-option-card" data-format="png">
        <div class="format-badge-icon png">PNG</div>
        <div class="format-details">
          <span class="format-name">PNG Image</span>
          <span class="format-desc">Ultra HD 300 DPI crisp raster</span>
        </div>
        <i class="fa-solid fa-download format-action-icon"></i>
      </button>
      <button type="button" class="format-option-card" data-format="eps">
        <div class="format-badge-icon eps">EPS</div>
        <div class="format-details">
          <span class="format-name">EPS Vector</span>
          <span class="format-desc">Professional print shop vector</span>
        </div>
        <i class="fa-solid fa-download format-action-icon"></i>
      </button>
      <button type="button" class="format-option-card" data-format="svg">
        <div class="format-badge-icon svg">SVG</div>
        <div class="format-details">
          <span class="format-name">SVG Vector</span>
          <span class="format-desc">Scalable vector graphics</span>
        </div>
        <i class="fa-solid fa-download format-action-icon"></i>
      </button>
    </div>
  </div>
</div>

<!-- 8. Band Logo Format Selection Download Modal -->
<div class="modal-backdrop hidden" id="logoDownloadFormatModal" role="dialog" aria-modal="true" aria-label="Select Band Logo Download Format">
  <div class="qr-format-modal-content">
    <div class="modal-header">
      <div class="modal-title-group">
        <span class="brand-mini-badge">Kins Official Brand Asset</span>
        <h3>Download Band Logo</h3>
      </div>
      <button class="close-modal-btn" id="closeLogoFormatModalBtn" aria-label="Close format selector">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <div class="format-options-grid">
      <button type="button" class="format-option-card" data-logo-format="png">
        <div class="format-badge-icon png">PNG</div>
        <div class="format-details">
          <span class="format-name">PNG Transparent</span>
          <span class="format-desc">High resolution transparent logo</span>
        </div>
        <i class="fa-solid fa-download format-action-icon"></i>
      </button>
      <button type="button" class="format-option-card" data-logo-format="jpeg">
        <div class="format-badge-icon jpeg">JPG</div>
        <div class="format-details">
          <span class="format-name">JPEG Image</span>
          <span class="format-desc">High contrast dark background image</span>
        </div>
        <i class="fa-solid fa-download format-action-icon"></i>
      </button>
      <button type="button" class="format-option-card" data-logo-format="svg">
        <div class="format-badge-icon svg">SVG</div>
        <div class="format-details">
          <span class="format-name">SVG Vector</span>
          <span class="format-desc">Scalable vector graphics logo</span>
        </div>
        <i class="fa-solid fa-download format-action-icon"></i>
      </button>
      <button type="button" class="format-option-card" data-logo-format="webp">
        <div class="format-badge-icon eps">WEBP</div>
        <div class="format-details">
          <span class="format-name">WebP Image</span>
          <span class="format-desc">Optimized web format logo</span>
        </div>
        <i class="fa-solid fa-download format-action-icon"></i>
      </button>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-snappy);
  }

  .modal-backdrop:not(.hidden) {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-backdrop:global(.active) {
    opacity: 1;
    pointer-events: auto;
  }

  .share-modal-enhanced {
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 6px 6px 0px #000000;
    border-radius: 10px;
    width: 100%;
    max-width: 440px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-height: 90vh;
    overflow-y: auto;
    box-sizing: border-box;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 10px;
    border-bottom: 2px solid #000000;
  }

  .modal-title-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand-mini-badge {
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--text-card-primary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .modal-title-group h3 {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 900;
    color: var(--text-card-primary);
    margin: 0;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .close-modal-btn {
    background: var(--surface-input);
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .close-modal-btn i {
    pointer-events: none;
  }

  .close-modal-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
  }

  .share-modal-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .native-share-primary-btn,
  .download-pwa-primary-btn {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    padding: 12px 18px;
    font-family: var(--font-secondary);
    font-size: 0.85rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 48px;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
  }

  .native-share-primary-btn i,
  .native-share-primary-btn span,
  .download-pwa-primary-btn i,
  .download-pwa-primary-btn span {
    pointer-events: none;
  }

  .native-share-primary-btn:hover,
  .download-pwa-primary-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  /* Social Apps Share Grid - Single Non-Scrolling Row of 4 */
  .share-apps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    width: 100%;
    box-sizing: border-box;
  }

  .share-app-pill-btn {
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 8px 3px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    cursor: pointer;
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--text-card-primary);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.15s var(--ease-tactile), background-color 0.15s ease, box-shadow 0.15s ease;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .share-app-pill-btn i {
    font-size: 1.15rem;
    pointer-events: none;
  }

  .share-app-pill-btn span {
    pointer-events: none;
    line-height: 1.1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .share-app-pill-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .share-app-pill-btn.instagram:hover { background: #E1306C; color: #ffffff; }
  .share-app-pill-btn.messages:hover { background: #34C759; color: #ffffff; }
  .share-app-pill-btn.whatsapp:hover { background: #25D366; color: #000000; }
  .share-app-pill-btn.discord:hover { background: #5865F2; color: #ffffff; }

  .share-section-label, .share-field-label {
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--text-card-primary);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .share-field-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .share-copy-handle-wrapper, .copy-input-group {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 6px 8px 6px 12px;
  }

  .handle-display-box, .copy-input-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .copy-input-wrapper input {
    background: transparent;
    border: none;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    width: 100%;
    outline: none;
    font-size: 0.8rem;
    font-weight: 700;
    text-overflow: ellipsis;
  }

  .icon-only-copy-btn {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 1.5px solid #000000;
    box-shadow: 1px 1px 0px #000000;
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .icon-only-copy-btn i {
    pointer-events: none;
  }

  .icon-only-copy-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
  }

  .dual-asset-box {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    width: 100%;
    box-sizing: border-box;
  }

  .asset-card {
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 8px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: transform 0.16s var(--ease-tactile);
  }

  .asset-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2px;
  }

  .asset-card-title {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-card-primary);
  }

  .asset-download-btn {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 1.5px solid #000000;
    box-shadow: 1px 1px 0px #000000;
    width: 28px;
    height: 28px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.76rem;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .asset-download-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
  }

  /* Preview Boxes */
  .qr-canvas-clickable,
  .band-logo-preview-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 6px;
    overflow: hidden;
    cursor: pointer;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #000000;
    transition: transform 0.2s var(--ease-snappy);
  }

  .qr-canvas-clickable {
    background: #ffffff;
    padding: 6px;
  }

  .band-logo-preview-box {
    background: #111114;
    padding: 8px;
  }

  .qr-canvas-inner {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .qr-canvas-inner :global(img) {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain;
    border-radius: 4px;
  }

  .band-logo-asset-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Hover Badges */
  .qr-hover-tap-badge,
  .logo-hover-tap-badge {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.78);
    color: var(--accent-neon-yellow);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    font-family: var(--font-secondary);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .qr-canvas-clickable:hover .qr-hover-tap-badge,
  .band-logo-preview-box:hover .logo-hover-tap-badge {
    opacity: 1;
  }

  /* Format Selector Modal */
  .qr-format-modal-content {
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 6px 6px 0px #000000;
    border-radius: 10px;
    width: 100%;
    max-width: 380px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-sizing: border-box;
  }

  .format-options-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .format-option-card {
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
  }

  .format-option-card:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0px #000000;
  }

  .format-badge-icon {
    width: 42px;
    height: 42px;
    min-width: 42px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: #000000;
    border: 1.5px solid #000000;
  }

  .format-badge-icon.jpeg {
    background: #f59e0b;
  }

  .format-badge-icon.png {
    background: var(--accent-neon-yellow);
  }

  .format-badge-icon.eps {
    background: #60a5fa;
  }

  .format-badge-icon.svg {
    background: #f472b6;
  }

  .format-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }

  .format-name {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--text-card-primary);
    text-transform: uppercase;
  }

  .format-desc {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
