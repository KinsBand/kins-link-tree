---
import { Image } from 'astro:assets';
import kinsLogoImg from '../../assets/new.png';
---

<!-- 1. Share Modal / Bottom Sheet Backdrop -->
<div class="modal-backdrop hidden" id="shareModal" role="dialog" aria-modal="true" aria-label="Share Kins Official Page" data-track-container="modal:share">
  <div class="share-sheet-wrapper" id="shareSheetWrapper">

    <!-- Floating Pill Header (Above Bottom Sheet / Menu) -->
    <div class="sheet-floating-pill-header" id="shareFloatingPillHeader">
      <div class="sheet-pill-title">
        <i class="fa-solid fa-share-nodes"></i>
        <span>SHARE</span>
      </div>
      <button class="sheet-pill-close-btn brutal-press" id="closeShareModal" aria-label="Close share modal" data-track="share:close">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Main Sheet / Modal Card Content -->
    <div class="modal-content share-modal-enhanced" id="shareModalContent">
      
      <!-- Mobile Drag Handle Bar -->
      <div class="sheet-drag-handle" id="sheetDragHandle" aria-hidden="true">
        <span class="sheet-drag-pill"></span>
      </div>

      <div class="modal-body share-modal-body">
        <!-- 1. Native Web Share CTA (Prioritized when navigator.share is available) -->
        <button type="button" class="native-share-primary-btn brutal-press" id="nativeShareCtaBtn" data-track="share:native_app" data-share-app="native">
          <i class="fa-solid fa-arrow-up-from-bracket"></i>
          <span>Share via App...</span>
        </button>

        <!-- 2. Direct Social Apps Share Grid -->
        <div class="share-field-group" id="socialAppsSection">
          <div class="share-field-header-row">
            <label class="share-field-label">Share to App</label>
          </div>
          <div class="share-apps-grid" id="shareAppsGrid">
            <button type="button" class="share-app-pill-btn instagram brutal-press" data-share-app="instagram" title="Share on Instagram">
              <i class="fa-brands fa-instagram"></i>
              <span>Instagram</span>
            </button>
            <button type="button" class="share-app-pill-btn messages brutal-press" data-share-app="sms" title="Share via Messages">
              <i class="fa-solid fa-comment-sms"></i>
              <span>Messages</span>
            </button>
            <button type="button" class="share-app-pill-btn whatsapp brutal-press" data-share-app="whatsapp" title="Share on WhatsApp">
              <i class="fa-brands fa-whatsapp"></i>
              <span>WhatsApp</span>
            </button>
            <button type="button" class="share-app-pill-btn discord brutal-press" data-share-app="discord" title="Share on Discord">
              <i class="fa-brands fa-discord"></i>
              <span>Discord</span>
            </button>
          </div>
        </div>

        <!-- 3. Direct Link Full-Row Interactive Target -->
        <div class="share-field-group">
          <label class="share-field-label">Direct Link</label>
          <div class="interactive-copy-row brutal-press" id="copyUrlRow" role="button" tabindex="0" aria-label="Copy website direct link" data-track="share:copy_url_row">
            <div class="copy-row-left">
              <div class="copy-row-icon-wrap">
                <i class="fa-solid fa-link link-input-icon"></i>
              </div>
              <div class="copy-row-text-stack">
                <span class="copy-row-primary">kinsband-hub.vercel.app</span>
                <span class="copy-row-secondary" id="copyUrlHint">Full UTM link with attribution</span>
              </div>
            </div>
            <div class="copy-row-right">
              <div class="icon-only-copy-btn" id="copyUrlBtn">
                <i class="fa-regular fa-copy" id="copyUrlIcon"></i>
              </div>
            </div>
          </div>
          <!-- Hidden input for clipboard fallback -->
          <input type="hidden" id="shareUrlInput" value="https://kinsband-hub.vercel.app/?utm_source=direct_link&utm_medium=share_modal&utm_campaign=fan_share">
        </div>

        <!-- 4. Band Handle Full-Row Interactive Target -->
        <div class="share-field-group">
          <label class="share-field-label">Band Handle</label>
          <div class="interactive-copy-row brutal-press" id="copyHandleRow" role="button" tabindex="0" aria-label="Copy band handle @KinsBandOfficial" data-track="share:copy_handle_row">
            <div class="copy-row-left">
              <div class="copy-row-icon-wrap">
                <i class="fa-solid fa-at handle-at-icon"></i>
              </div>
              <div class="copy-row-text-stack">
                <span class="copy-row-primary">@KinsBandOfficial</span>
                <span class="copy-row-secondary" id="copyHandleHint">Official artist handle</span>
              </div>
            </div>
            <div class="copy-row-right">
              <div class="icon-only-copy-btn" id="handleCopyBtn">
                <i class="fa-regular fa-copy" id="copyHandleIcon"></i>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 5. Dual Asset Deck: QR Code (Left) | Band Logo (Right) -->
      <div class="share-field-group">
        <label class="share-field-label">Visual & Media Assets</label>
        <div class="dual-asset-box">
          <!-- Left Asset Card: QR Code -->
          <div class="asset-card" id="qrAssetCard">
            <div class="asset-card-header">
              <span class="asset-card-title">QR CODE</span>
              <button type="button" class="asset-download-btn brutal-press" id="openQrDownloadModalBtn" title="Export QR Code Formats" aria-label="Download QR Code">
                <i class="fa-solid fa-download"></i>
              </button>
            </div>
            <div class="qr-canvas-clickable" id="qrcodeCanvasWrapper" role="button" tabindex="0" title="Click to view full screen QR code" aria-label="Fullscreen QR Code">
              <div class="qr-canvas-inner" id="qrcodeCanvas"></div>
              <div class="asset-hover-tap-badge">
                <i class="fa-solid fa-expand"></i>
                <span>Fullscreen</span>
              </div>
            </div>
          </div>

          <!-- Right Asset Card: Band Logo -->
          <div class="asset-card" id="logoAssetCard">
            <div class="asset-card-header">
              <span class="asset-card-title">LOGO</span>
              <button type="button" class="asset-download-btn brutal-press" id="openLogoDownloadModalBtn" title="Export Band Logo Formats" aria-label="Download Band Logo">
                <i class="fa-solid fa-download"></i>
              </button>
            </div>
            <div class="band-logo-preview-box" id="openLogoDownloadModalBox" role="button" tabindex="0" title="Click to download Band Logo formats" aria-label="Download Band Logo">
              <Image src={kinsLogoImg} alt="Kins Band Official Logo" class="band-logo-asset-img" width={110} height={110} />
              <div class="asset-hover-tap-badge">
                <i class="fa-solid fa-download"></i>
                <span>Export</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 6. Real-time Two-Stage Download / Install App CTA -->
      <button type="button" class="download-pwa-primary-btn brutal-press" id="downloadPwaCtaBtn" data-track="share:download_pwa" title="Install / Download Kins App for instant offline access">
        <span class="pwa-progress-track" id="pwaProgressTrack">
          <span class="pwa-progress-bar" id="pwaProgressBar"></span>
        </span>
        <div class="pwa-btn-content" id="pwaBtnContent">
          <div class="pwa-btn-icon-wrap" id="pwaBtnIconWrap">
            <i class="fa-solid fa-download" id="pwaBtnIcon"></i>
          </div>
          <div class="pwa-btn-text-stack">
            <span class="pwa-btn-title" id="pwaBtnLabel">Download Kins App</span>
            <span class="pwa-btn-subtitle" id="pwaBtnSub">Install to home screen • Offline ready</span>
          </div>
          <div class="pwa-status-pill-wrap">
            <span class="pwa-status-badge" id="pwaProgressStatus">INSTALL</span>
          </div>
        </div>
      </button>

    </div>
  </div>
</div>

<!-- 7. Fullscreen QR Code Lightbox Modal / Bottom Sheet -->
<div class="modal-backdrop hidden" id="qrFullscreenModal" role="dialog" aria-modal="true" aria-label="Full screen QR Code">
  <div class="qr-fullscreen-sheet-wrapper" id="qrFullscreenSheetWrapper">
    <!-- Floating Pill Header -->
    <div class="sheet-floating-pill-header" id="qrFullscreenFloatingPillHeader">
      <div class="sheet-pill-title">
        <i class="fa-solid fa-qrcode"></i>
        <span>QR CODE</span>
      </div>
      <button class="sheet-pill-close-btn brutal-press" id="closeQrFullscreenBtn" aria-label="Close full screen QR code">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Main Sheet / Modal Content -->
    <div class="qr-fullscreen-content" id="qrFullscreenContent">
      <div class="sheet-drag-handle" id="qrFullscreenDragHandle" aria-hidden="true">
        <span class="sheet-drag-pill"></span>
      </div>

      <div class="qr-fullscreen-canvas-wrapper" id="qrcodeFullscreenCanvas"></div>
      <p class="qr-fullscreen-sub">Point mobile camera to view Kins official link tree</p>
      
      <!-- Instant 1-Click Fast Export Bar -->
      <div class="qr-fast-export-bar">
        <span class="fast-export-label">Fast Export Formats:</span>
        <div class="fast-export-buttons">
          <button type="button" class="fast-export-btn brutal-press" data-qr-quick-format="png" title="Download High Resolution PNG">
            <i class="fa-solid fa-image"></i>
            <span>PNG HD</span>
          </button>
          <button type="button" class="fast-export-btn brutal-press" data-qr-quick-format="svg" title="Download Scalable Vector Graphic">
            <i class="fa-solid fa-bezier-curve"></i>
            <span>SVG Vector</span>
          </button>
          <button type="button" class="fast-export-btn brutal-press" data-qr-quick-format="eps" title="Download Print Shop EPS Vector">
            <i class="fa-solid fa-file-lines"></i>
            <span>EPS Vector</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 8. QR Format Selection Download Modal / Bottom Sheet -->
<div class="modal-backdrop hidden" id="qrDownloadFormatModal" role="dialog" aria-modal="true" aria-label="Select QR Code Download Format">
  <div class="qr-download-sheet-wrapper" id="qrDownloadSheetWrapper">
    <!-- Floating Pill Header -->
    <div class="sheet-floating-pill-header" id="qrDownloadFloatingPillHeader">
      <div class="sheet-pill-title">
        <i class="fa-solid fa-download"></i>
        <span>EXPORT QR</span>
      </div>
      <button class="sheet-pill-close-btn brutal-press" id="closeQrFormatModalBtn" aria-label="Close format selector">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Main Sheet / Modal Content -->
    <div class="qr-format-modal-content" id="qrDownloadFormatContent">
      <div class="sheet-drag-handle" id="qrFormatDragHandle" aria-hidden="true">
        <span class="sheet-drag-pill"></span>
      </div>
      <div class="format-options-grid">
        <button type="button" class="format-option-card brutal-press" data-format="jpeg">
          <div class="format-badge-icon jpeg">JPG</div>
          <div class="format-details">
            <span class="format-name">JPEG Image</span>
            <span class="format-desc">High resolution 300 DPI image</span>
          </div>
          <i class="fa-solid fa-download format-action-icon"></i>
        </button>
        <button type="button" class="format-option-card brutal-press" data-format="png">
          <div class="format-badge-icon png">PNG</div>
          <div class="format-details">
            <span class="format-name">PNG Image</span>
            <span class="format-desc">Ultra HD 300 DPI crisp raster</span>
          </div>
          <i class="fa-solid fa-download format-action-icon"></i>
        </button>
        <button type="button" class="format-option-card brutal-press" data-format="eps">
          <div class="format-badge-icon eps">EPS</div>
          <div class="format-details">
            <span class="format-name">EPS Vector</span>
            <span class="format-desc">Professional print shop vector</span>
          </div>
          <i class="fa-solid fa-download format-action-icon"></i>
        </button>
        <button type="button" class="format-option-card brutal-press" data-format="svg">
          <div class="format-badge-icon svg">SVG</div>
          <div class="format-details">
            <span class="format-name">SVG Vector</span>
            <span class="format-desc">Scalable vector graphics</span>
          </div>
          <i class="fa-solid fa-download format-action-icon"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- 9. Band Logo Format Selection Download Modal / Bottom Sheet -->
<div class="modal-backdrop hidden" id="logoDownloadFormatModal" role="dialog" aria-modal="true" aria-label="Select Band Logo Download Format">
  <div class="logo-download-sheet-wrapper" id="logoDownloadSheetWrapper">
    <!-- Floating Pill Header -->
    <div class="sheet-floating-pill-header" id="logoDownloadFloatingPillHeader">
      <div class="sheet-pill-title">
        <i class="fa-solid fa-download"></i>
        <span>EXPORT LOGO</span>
      </div>
      <button class="sheet-pill-close-btn brutal-press" id="closeLogoFormatModalBtn" aria-label="Close format selector">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Main Sheet / Modal Content -->
    <div class="qr-format-modal-content" id="logoDownloadFormatContent">
      <div class="sheet-drag-handle" id="logoFormatDragHandle" aria-hidden="true">
        <span class="sheet-drag-pill"></span>
      </div>
      <div class="format-options-grid">
        <button type="button" class="format-option-card brutal-press" data-logo-format="png">
          <div class="format-badge-icon png">PNG</div>
          <div class="format-details">
            <span class="format-name">PNG Transparent</span>
            <span class="format-desc">High resolution transparent logo</span>
          </div>
          <i class="fa-solid fa-download format-action-icon"></i>
        </button>
        <button type="button" class="format-option-card brutal-press" data-logo-format="jpeg">
          <div class="format-badge-icon jpeg">JPG</div>
          <div class="format-details">
            <span class="format-name">JPEG Image</span>
            <span class="format-desc">High contrast dark background image</span>
          </div>
          <i class="fa-solid fa-download format-action-icon"></i>
        </button>
        <button type="button" class="format-option-card brutal-press" data-logo-format="svg">
          <div class="format-badge-icon svg">SVG</div>
          <div class="format-details">
            <span class="format-name">SVG Vector</span>
            <span class="format-desc">Scalable vector graphics logo</span>
          </div>
          <i class="fa-solid fa-download format-action-icon"></i>
        </button>
        <button type="button" class="format-option-card brutal-press" data-logo-format="webp">
          <div class="format-badge-icon eps">WEBP</div>
          <div class="format-details">
            <span class="format-name">WebP Image</span>
            <span class="format-desc">Optimized web format logo</span>
          </div>
          <i class="fa-solid fa-download format-action-icon"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-snappy);
  }

  .modal-backdrop:not(.hidden),
  .modal-backdrop:global(.active) {
    opacity: 1;
    pointer-events: auto;
  }

  /* Desktop Default: Centered Brutalist Cards */
  .share-modal-enhanced,
  .qr-fullscreen-content,
  .qr-format-modal-content {
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 6px 6px 0px #000000;
    border-radius: 12px;
    width: 100%;
    padding: 20px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    position: relative;
    overscroll-behavior: contain;
    transition: transform 0.24s var(--ease-snappy), opacity 0.2s ease;
  }

  /* Chalkboard fine grain noise texture overlay on modal/sheet surfaces */
  .share-modal-enhanced::before,
  .qr-fullscreen-content::before,
  .qr-format-modal-content::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("/noise-tile.webp");
    background-repeat: repeat;
    background-size: 64px 64px;
    image-rendering: pixelated;
    opacity: 0.055;
    pointer-events: none;
    border-radius: inherit;
    z-index: 0;
  }

  .share-modal-enhanced > *,
  .qr-fullscreen-content > *,
  .qr-format-modal-content > * {
    position: relative;
    z-index: 1;
  }

  .share-modal-enhanced {
    max-width: 440px;
    gap: 14px;
    max-height: 90vh;
    overflow-y: auto;
  }

  .qr-fullscreen-content {
    max-width: 380px;
    padding: 20px;
    align-items: center;
    gap: 14px;
    text-align: center;
  }

  .qr-fullscreen-header-bar {
    width: 100%;
    box-sizing: border-box;
  }

  .qr-format-modal-content {
    max-width: 380px;
    gap: 14px;
  }

  /* Sheet Drag Handle (Hidden on Desktop) */
  .sheet-drag-handle {
    display: none;
    width: 100%;
    padding: 2px 0 8px 0;
    justify-content: center;
    cursor: grab;
    touch-action: none;
  }

  .sheet-drag-pill {
    width: 42px;
    height: 5px;
    background: #000000;
    border-radius: 999px;
    opacity: 0.35;
    pointer-events: none;
  }

  /* Floating Header Pill Container (Above Sheet / Modal) */
  .share-sheet-wrapper,
  .qr-fullscreen-sheet-wrapper,
  .qr-download-sheet-wrapper,
  .logo-download-sheet-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 440px;
    gap: 12px;
    position: relative;
    z-index: 10;
  }

  .qr-fullscreen-sheet-wrapper {
    max-width: 420px;
  }

  .sheet-floating-pill-header {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    background: var(--surface-card-panel, #f5f4ef);
    border: 2.5px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 9999px;
    padding: 6px 6px 6px 18px;
    z-index: 20;
    user-select: none;
    transition: transform 0.16s var(--ease-tactile);
  }

  .sheet-pill-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.88rem;
    font-weight: 900;
    color: var(--text-card-primary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sheet-pill-title i {
    font-size: 0.85rem;
    color: var(--brand-accent-primary, #f2fd43);
    filter: drop-shadow(0 0 1px #000000);
  }

  :global([data-theme="dark"]) .sheet-pill-title i {
    color: var(--brand-accent-primary, #d4af37);
  }

  .sheet-pill-close-btn {
    background: var(--btn-brand-primary, #f2fd43);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .sheet-pill-close-btn i {
    font-size: 0.88rem;
    pointer-events: none;
  }

  .sheet-pill-close-btn:hover {
    background: var(--btn-brand-hover, #ffffff);
    transform: scale(1.05);
  }

  /* Secondary Sub-Modal Headers (QR / Logo Modals) */
  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 8px;
    border-bottom: 2px solid #000000;
  }

  .modal-title-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }

  .brand-mini-badge {
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--text-card-primary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .modal-title-group h3 {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 900;
    color: var(--text-card-primary);
    margin: 0;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .close-modal-btn {
    background: var(--surface-input);
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .close-modal-btn i {
    pointer-events: none;
  }

  .close-modal-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
  }

  .share-modal-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* 1. Native Share CTA */
  .native-share-primary-btn {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2.5px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    padding: 12px 18px;
    font-family: var(--font-secondary);
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 46px;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
  }

  .native-share-primary-btn i,
  .native-share-primary-btn span {
    pointer-events: none;
  }

  .native-share-primary-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px #000000;
  }

  /* Social Apps Share Grid */
  .share-field-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .share-field-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .share-field-label {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--text-card-primary);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .share-apps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    width: 100%;
    box-sizing: border-box;
  }

  .share-app-pill-btn {
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 8px 3px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    cursor: pointer;
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 800;
    color: var(--text-card-primary);
