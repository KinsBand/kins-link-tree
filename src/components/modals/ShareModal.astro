---
import { Image } from 'astro:assets';
import kinsLogoImg from '../../assets/kins-logo-new.png';
---

<!-- Share Modal Backdrop -->
<div class="modal-backdrop hidden" id="shareModal" role="dialog" aria-modal="true" aria-label="Share Kins Official Page">
  <div class="modal-content share-modal-enhanced">
    <!-- Header -->
    <div class="modal-header">
      <div class="modal-title-group">
        <span class="brand-mini-badge">Kins • Official Link Tree</span>
        <h3>Share Official Page</h3>
      </div>
      <button class="close-modal-btn" id="closeShareModal" aria-label="Close share modal">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="modal-body share-modal-body">
      <!-- 1. Native Web Share CTA -->
      <button type="button" class="native-share-primary-btn" id="nativeShareCtaBtn">
        <i class="fa-solid fa-arrow-up-from-bracket"></i>
        <span>Share via App...</span>
      </button>

      <!-- 2. One-Tap Quick Share Shortcuts -->
      <div class="quick-share-section">
        <span class="share-section-label">Quick Share</span>
        <div class="quick-share-grid">
          <a href="#" id="shareWhatsappBtn" target="_blank" rel="noopener noreferrer" class="quick-share-chip whatsapp" aria-label="Share on WhatsApp">
            <i class="fa-brands fa-whatsapp"></i>
            <span>WhatsApp</span>
          </a>
          <a href="#" id="shareSmsBtn" class="quick-share-chip sms" aria-label="Share via Messages">
            <i class="fa-solid fa-comment-sms"></i>
            <span>Messages</span>
          </a>
          <a href="#" id="shareTwitterBtn" target="_blank" rel="noopener noreferrer" class="quick-share-chip twitter" aria-label="Share on X / Twitter">
            <i class="fa-brands fa-x-twitter"></i>
            <span>X / Twitter</span>
          </a>
          <a href="#" id="shareFacebookBtn" target="_blank" rel="noopener noreferrer" class="quick-share-chip facebook" aria-label="Share on Facebook">
            <i class="fa-brands fa-facebook-f"></i>
            <span>Facebook</span>
          </a>
        </div>
      </div>

      <!-- 3. Direct Link Input Box -->
      <div class="share-field-group">
        <label class="share-field-label" for="shareUrlInput">Direct Link</label>
        <div class="copy-input-group">
          <div class="copy-input-wrapper">
            <i class="fa-solid fa-link link-input-icon"></i>
            <input type="text" id="shareUrlInput" value="https://kinsband.com/?utm_source=share_modal&utm_medium=direct_link" readonly>
          </div>
          <button id="copyUrlBtn" class="icon-only-copy-btn" title="Copy website link" aria-label="Copy website link">
            <i class="fa-regular fa-copy"></i>
          </button>
        </div>
      </div>

      <!-- 4. Band Handle Box -->
      <div class="share-field-group">
        <label class="share-field-label">Band Handle</label>
        <div class="share-copy-handle-wrapper">
          <div class="handle-display-box">
            <i class="fa-solid fa-at handle-at-icon"></i>
            <span class="handle-handle-text">@KinsBandOfficial</span>
          </div>
          <button class="icon-only-copy-btn" id="handleCopyBtn" title="Copy handle @KinsBandOfficial" aria-label="Copy handle @KinsBandOfficial">
            <i class="fa-regular fa-copy"></i>
          </button>
        </div>
      </div>

      <!-- 5. Dual Asset Box: QR Code (Left) | Band Logo (Right) -->
      <div class="dual-asset-box">
        <!-- Left Asset: QR Code -->
        <div class="asset-column">
          <span class="asset-col-label">QR CODE</span>
          <div class="asset-img-row">
            <button type="button" class="icon-only-download-btn qr-btn" id="openQrDownloadModalBtn" title="Download QR Code Asset" aria-label="Download QR Code">
              <i class="fa-solid fa-download"></i>
            </button>
            <div class="qr-canvas-clickable" id="qrcodeCanvasWrapper" title="Click to view full screen QR code">
              <div class="qr-canvas-inner" id="qrcodeCanvas"></div>
              <div class="qr-hover-tap-badge">
                <i class="fa-solid fa-expand"></i>
                <span>Fullscreen</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Asset: Band Logo -->
        <div class="asset-column">
          <span class="asset-col-label">LOGO</span>
          <div class="asset-img-row">
            <button type="button" class="icon-only-download-btn logo-btn" id="openLogoDownloadModalBtn" title="Download Band Logo Asset" aria-label="Download Band Logo">
              <i class="fa-solid fa-download"></i>
            </button>
            <div class="band-logo-preview-box" id="bandLogoPreviewBox" title="Kins Official Logo Asset">
              <Image src={kinsLogoImg} alt="Kins Band Official Logo" class="band-logo-asset-img" width={100} height={100} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 6. Fullscreen QR Code Lightbox Modal -->
<div class="modal-backdrop hidden" id="qrFullscreenModal" role="dialog" aria-modal="true" aria-label="Full screen QR Code">
  <div class="qr-fullscreen-content">
    <button class="close-modal-btn qr-fullscreen-close" id="closeQrFullscreenBtn" aria-label="Close full screen QR code">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <div class="qr-fullscreen-header">
      <span class="brand-mini-badge">Kins Official</span>
      <h2>Scan to Open Link in Bio</h2>
    </div>
    <div class="qr-fullscreen-canvas-wrapper" id="qrcodeFullscreenCanvas"></div>
    <p class="qr-fullscreen-sub">Point mobile camera to view Kins official website</p>
  </div>
</div>

<!-- 7. QR Format Selection Download Modal -->
<div class="modal-backdrop hidden" id="qrDownloadFormatModal" role="dialog" aria-modal="true" aria-label="Select QR Code Download Format">
  <div class="qr-format-modal-content">
    <div class="modal-header">
      <div class="modal-title-group">
        <span class="brand-mini-badge">Export Vector & HD Assets</span>
        <h3>Download QR Code</h3>
      </div>
      <button class="close-modal-btn" id="closeQrFormatModalBtn" aria-label="Close format selector">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <div class="format-options-grid">
      <button type="button" class="format-option-card" data-format="jpeg">
        <div class="format-badge-icon jpeg">JPG</div>
        <div class="format-details">
          <span class="format-name">JPEG Image</span>
          <span class="format-desc">High resolution 300 DPI image</span>
        </div>
        <i class="fa-solid fa-download format-action-icon"></i>
      </button>
      <button type="button" class="format-option-card" data-format="png">
        <div class="format-badge-icon png">PNG</div>
        <div class="format-details">
          <span class="format-name">PNG Image</span>
          <span class="format-desc">Ultra HD 300 DPI crisp raster</span>
        </div>
        <i class="fa-solid fa-download format-action-icon"></i>
      </button>
      <button type="button" class="format-option-card" data-format="eps">
        <div class="format-badge-icon eps">EPS</div>
        <div class="format-details">
          <span class="format-name">EPS Vector</span>
          <span class="format-desc">Professional print shop vector</span>
        </div>
        <i class="fa-solid fa-download format-action-icon"></i>
      </button>
      <button type="button" class="format-option-card" data-format="svg">
        <div class="format-badge-icon svg">SVG</div>
        <div class="format-details">
          <span class="format-name">SVG Vector</span>
          <span class="format-desc">Scalable vector graphics</span>
        </div>
        <i class="fa-solid fa-download format-action-icon"></i>
      </button>
    </div>
  </div>
</div>

<!-- 8. Band Logo Format Selection Download Modal -->
<div class="modal-backdrop hidden" id="logoDownloadFormatModal" role="dialog" aria-modal="true" aria-label="Select Band Logo Download Format">
  <div class="qr-format-modal-content">
    <div class="modal-header">
      <div class="modal-title-group">
        <span class="brand-mini-badge">Kins Official Brand Asset</span>
        <h3>Download Band Logo</h3>
      </div>
      <button class="close-modal-btn" id="closeLogoFormatModalBtn" aria-label="Close format selector">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <div class="format-options-grid">
      <button type="button" class="format-option-card" data-logo-format="png">
        <div class="format-badge-icon png">PNG</div>
        <div class="format-details">
          <span class="format-name">PNG Transparent</span>
          <span class="format-desc">High resolution transparent logo</span>
        </div>
        <i class="fa-solid fa-download format-action-icon"></i>
      </button>
      <button type="button" class="format-option-card" data-logo-format="jpeg">
        <div class="format-badge-icon jpeg">JPG</div>
        <div class="format-details">
          <span class="format-name">JPEG Image</span>
          <span class="format-desc">High contrast dark background image</span>
        </div>
        <i class="fa-solid fa-download format-action-icon"></i>
      </button>
      <button type="button" class="format-option-card" data-logo-format="svg">
        <div class="format-badge-icon svg">SVG</div>
        <div class="format-details">
          <span class="format-name">SVG Vector</span>
          <span class="format-desc">Scalable vector graphics logo</span>
        </div>
        <i class="fa-solid fa-download format-action-icon"></i>
      </button>
      <button type="button" class="format-option-card" data-logo-format="webp">
        <div class="format-badge-icon eps">WEBP</div>
        <div class="format-details">
          <span class="format-name">WebP Image</span>
          <span class="format-desc">Optimized web format logo</span>
        </div>
        <i class="fa-solid fa-download format-action-icon"></i>
      </button>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-snappy);
  }

  .modal-backdrop:not(.hidden) {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-backdrop:global(.active) {
    opacity: 1;
    pointer-events: auto;
  }

  .share-modal-enhanced {
    background: rgba(14, 14, 17, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 12px;
    width: 100%;
    max-width: 440px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.9);
    max-height: 90vh;
    overflow-y: auto;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .modal-title-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand-mini-badge {
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--btn-green);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .modal-title-group h3 {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
    color: var(--text-white);
    margin: 0;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .close-modal-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-white);
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.18s ease;
  }

  .close-modal-btn:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  .share-modal-body {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .native-share-primary-btn {
    background: var(--btn-green);
    color: var(--btn-text-color);
    border: none;
    padding: 12px 18px;
    font-family: var(--font-secondary);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 44px;
    transition: transform 0.18s var(--ease-snappy), background-color 0.18s ease;
  }

  .native-share-primary-btn:hover {
    background: var(--btn-green-hover);
    transform: translateY(-1px);
  }

  .quick-share-section {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .share-section-label, .share-field-label {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .quick-share-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  .quick-share-chip {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 10px 6px;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-decoration: none;
    min-height: 48px;
    transition: all 0.18s ease;
  }

  .quick-share-chip:hover {
    background: rgba(255, 255, 255, 0.14);
    transform: translateY(-2px);
  }

  .quick-share-chip.whatsapp:hover {
    color: #25D366;
    border-color: rgba(37, 211, 102, 0.4);
  }

  .quick-share-chip.sms:hover {
    color: #34B7F1;
    border-color: rgba(52, 183, 241, 0.4);
  }

  .quick-share-chip.twitter:hover {
    color: #1DA1F2;
    border-color: rgba(29, 161, 242, 0.4);
  }

  .quick-share-chip.facebook:hover {
    color: #1877F2;
    border-color: rgba(24, 119, 242, 0.4);
  }

  .quick-share-chip i {
    font-size: 1rem;
  }

  .share-field-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .share-copy-handle-wrapper, .copy-input-group {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(10, 10, 12, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 6px;
    padding: 6px 8px 6px 12px;
  }

  .handle-display-box, .copy-input-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .copy-input-wrapper input {
    background: transparent;
    border: none;
    color: var(--text-white);
    font-family: var(--font-secondary);
    width: 100%;
    outline: none;
    font-size: 0.8rem;
    text-overflow: ellipsis;
  }

  .icon-only-copy-btn {
    background: var(--btn-green);
    color: var(--btn-text-color);
    border: none;
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 0.18s ease;
  }

  .icon-only-copy-btn:hover {
    background: var(--btn-green-hover);
  }

  .dual-asset-box {
    display: flex;
    align-items: stretch;
    gap: 6px;
    background: rgba(10, 10, 12, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 10px;
    width: 100%;
    box-sizing: border-box;
  }

  /* Each asset column takes equal width */
  .asset-column {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    min-width: 0;
  }

  /* Big label above each image — offset past the 36px button + 5px gap */
  .asset-col-label {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-white);
    line-height: 1;
    margin-left: 41px;
  }

  /* Row: download button on left, image on right */
  .asset-img-row {
    display: flex;
    align-items: center;
    gap: 5px;
    width: 100%;
  }

  /* QR Code Image Card */
  .qr-canvas-clickable {
    position: relative;
    background: #ffffff;
    flex: 1;
    aspect-ratio: 1;
    padding: 5px;
    box-sizing: border-box;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    overflow: hidden;
    transition: transform 0.2s var(--ease-snappy), box-shadow 0.2s ease;
  }

  .qr-canvas-clickable:hover {
    transform: scale(1.03);
    box-shadow: 0 0 14px rgba(0, 230, 153, 0.35);
  }

  .qr-hover-tap-badge {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.78);
    color: var(--text-white);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    font-family: var(--font-secondary);
    font-size: 0.58rem;
    font-weight: 700;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .qr-canvas-clickable:hover .qr-hover-tap-badge {
    opacity: 1;
  }

  /* Download Buttons — tall pill, flush with image height */
  .icon-only-download-btn {
    background: var(--btn-green);
    color: var(--btn-text-color);
    border: none;
    width: 36px;
    min-width: 36px;
    align-self: stretch;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.95rem;
    transition: all 0.18s var(--ease-snappy);
    box-shadow: 0 3px 10px rgba(0, 230, 153, 0.25);
    flex-shrink: 0;
  }

  .icon-only-download-btn:hover {
    background: var(--btn-green-hover);
    transform: translateY(-1px) scale(1.04);
    box-shadow: 0 5px 16px rgba(0, 230, 153, 0.4);
  }

  .icon-only-download-btn.logo-btn {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: var(--text-white);
    box-shadow: none;
  }

  .icon-only-download-btn.logo-btn:hover {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.35);
    color: var(--text-white);
    transform: translateY(-1px) scale(1.04);
  }

  /* Band Logo Container — matches QR sizing via flex */
  .band-logo-preview-box {
    flex: 1;
    aspect-ratio: 1;
    box-sizing: border-box;
    background: #0a0a0c;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.5);
  }

  .band-logo-asset-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.5));
  }

  /* Format Selector Modal */
  .qr-format-modal-content {
    background: rgba(14, 14, 17, 0.98);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 12px;
    width: 100%;
    max-width: 380px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.95);
  }

  .format-options-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .format-option-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    text-align: left;
    transition: all 0.18s var(--ease-snappy);
    width: 100%;
  }

  .format-option-card:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--btn-green);
    transform: translateX(4px);
  }

  .format-badge-icon {
    width: 42px;
    height: 42px;
    min-width: 42px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: #0a0a0c;
  }

  .format-badge-icon.jpeg {
    background: #f59e0b;
  }

  .format-badge-icon.png {
    background: var(--btn-green);
  }

  .format-badge-icon.eps {
    background: #3b82f6;
    color: #ffffff;
  }

  .format-badge-icon.svg {
    background: #ec4899;
    color: #ffffff;
  }

  .format-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }

  .format-name {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--text-white);
    text-transform: uppercase;
  }

  .format-desc {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .format-action-icon {
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: color 0.18s ease;
  }

  .format-option-card:hover .format-action-icon {
    color: var(--btn-green);
  }

  /* Fullscreen QR Lightbox Modal */
  .qr-fullscreen-content {
    background: rgba(14, 14, 17, 0.98);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 16px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.95);
    position: relative;
    max-width: 360px;
    width: 100%;
    text-align: center;
  }

  .qr-fullscreen-close {
    position: absolute;
    top: 14px;
    right: 14px;
  }

  .qr-fullscreen-header h2 {
    font-family: var(--font-heading);
