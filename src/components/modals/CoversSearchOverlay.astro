---
const categories = [
  { key: "all", label: "All Covers", active: true },
  { key: "full-band", label: "Full Band", active: false },
  { key: "acoustic", label: "Acoustic", active: false },
  { key: "shorts", label: "Shorts", active: false }
];
---

<div class="covers-search-overlay" id="coversSearchOverlay" role="dialog" aria-modal="true" aria-label="Search Cover Videos" data-track-container="modal:covers_search">
  <div class="command-palette-container" id="commandPaletteContainer">
    <div class="search-overlay-header">
      <div class="expanded-search-input-box">
        <i class="fa-solid fa-magnifying-glass search-box-icon"></i>
        <input type="text" id="overlaySearchInput" placeholder="Search covers by title, artist, or tag..." autocomplete="off" data-track="covers_search:input">
        <span class="cmd-k-badge"><kbd>Ctrl</kbd> <kbd>K</kbd></span>
        <button type="button" class="clear-search-btn hidden" id="clearSearchInputBtn" aria-label="Clear search text" data-track="covers_search:clear">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <button class="close-overlay-btn" id="closeSearchOverlayBtn" aria-label="Close cover search" data-track="covers_search:close">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="search-overlay-body">
      <!-- Category Filter Pills Row -->
      <div class="category-pills-row">
        {categories.map((cat) => (
          <button class={`cover-category-pill ${cat.active ? 'active' : ''}`} data-category={cat.key} data-track={`covers_search:cat_${cat.key}`}>
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Section Title -->
      <div class="covers-results-header">
        <h3 class="covers-section-title" id="coversSectionTitle">Latest Releases</h3>
      </div>

      <!-- Cover Results Cards List -->
      <div class="covers-results-list" id="coversResultsList">
        <!-- Populated dynamically by coversSearchEngine.js -->
      </div>
    </div>
  </div>
</div>

<style>
  .covers-search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    z-index: 950;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-snappy);
  }

  .covers-search-overlay:global(.active) {
    opacity: 1;
    pointer-events: auto;
  }

  .command-palette-container {
    width: 100%;
    max-width: 780px;
    max-height: 85vh;
    background: #141416;
    border: 3px solid #000000;
    border-radius: 10px;
    box-shadow: 6px 6px 0px #000000;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 20px;
    transform: scale(0.95) translateY(-10px);
    transition: transform 0.25s var(--ease-snappy);
    box-sizing: border-box;
  }

  .covers-search-overlay:global(.active) .command-palette-container {
    transform: scale(1) translateY(0);
  }

  @media (max-width: 767px) {
    .covers-search-overlay {
      padding: 0;
      background: #141416;
    }
    .command-palette-container {
      max-width: 100%;
      height: 100%;
      max-height: 100%;
      border-radius: 0;
      border: none;
      padding: 14px 16px;
    }
  }

  .search-overlay-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .expanded-search-input-box {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface-input);
    border: 3px solid #000000;
    border-radius: 6px;
    box-shadow: 3px 3px 0px var(--accent-neon-yellow);
    padding: 10px 14px;
    transition: box-shadow 0.2s ease;
  }

  .expanded-search-input-box:focus-within {
    box-shadow: 4px 4px 0px var(--accent-neon-yellow);
  }

  .search-box-icon {
    font-size: 1rem;
    color: var(--text-card-primary);
  }

  .expanded-search-input-box input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.92rem;
    font-weight: 800;
    width: 100%;
  }

  .expanded-search-input-box input::placeholder {
    color: var(--text-card-muted);
    font-weight: 600;
  }

  .cmd-k-badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    color: #000000;
    background: var(--accent-neon-yellow);
    border: 1.5px solid #000000;
    padding: 1px 6px;
    border-radius: 4px;
    white-space: nowrap;
    font-weight: 900;
  }

  .cmd-k-badge kbd {
    font-family: inherit;
    font-weight: 900;
  }

  @media (max-width: 600px) {
    .cmd-k-badge { display: none; }
  }

  .clear-search-btn {
    background: transparent;
    border: none;
    color: var(--text-card-primary);
    cursor: pointer;
    font-size: 0.95rem;
    padding: 6px 10px;
    min-width: 38px;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile);
  }

  .clear-search-btn i {
    pointer-events: none;
  }

  .clear-search-btn:hover {
    transform: scale(1.2);
  }

  .clear-search-btn.hidden {
    display: none !important;
  }

  .close-overlay-btn {
    background: var(--surface-input);
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1rem;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
    flex-shrink: 0;
  }

  .close-overlay-btn i {
    pointer-events: none;
  }

  .close-overlay-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
  }

  .search-overlay-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow-y: auto;
    overscroll-behavior: contain;
    width: 100%;
    max-width: 100%;
    padding-right: 4px;
  }

  .zero-state-suggestions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 14px;
    background: var(--surface-card-light);
    border: 2.5px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 6px;
  }

  .zero-state-suggestions.hidden {
    display: none !important;
  }

  .suggestions-header {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 900;
    color: var(--text-card-primary);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .suggestions-header .text-green {
    color: var(--text-card-primary);
  }

  .suggestion-chips-row {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .suggestion-chip-btn {
    background: var(--surface-card-light-hover);
    border: 1.5px solid #000000;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .suggestion-chip-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translateY(-1px);
  }

  .category-pills-row {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 2px;
  }

  .cover-category-pill {
    background: #232328;
    border: 2px solid #3f3f46;
    color: #ffffff;
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, border-color 0.16s ease;
  }

  .cover-category-pill:hover {
    background: #2e2e34;
    border-color: #ffffff;
    transform: translate(-1px, -1px);
  }

  .cover-category-pill.active {
    background: var(--accent-neon-yellow);
    border-color: #000000;
    box-shadow: 2px 2px 0px #000000;
    color: #000000;
    font-weight: 900;
  }

  .covers-results-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
  }

  .covers-section-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .covers-results-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (min-width: 600px) {
    .covers-results-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 14px;
    }
  }

  .covers-results-list :global(.cover-result-card) {
    background: #ffffff;
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px var(--accent-neon-yellow);
    border-radius: 8px;
    padding: 8px 10px;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 68px;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
    box-sizing: border-box;
  }

  .covers-results-list :global(.cover-result-card:hover) {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px var(--accent-neon-yellow);
    background: #ffffff;
  }

  .covers-results-list :global(.cover-card-thumb-box) {
    width: 62px;
    height: 46px;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
    background: #000;
    border: 1.5px solid #000000;
  }

  .covers-results-list :global(.cover-card-thumb-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .covers-results-list :global(.thumb-play-overlay) {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-neon-yellow);
    font-size: 0.85rem;
  }

  .covers-results-list :global(.cover-card-info) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .covers-results-list :global(.cover-card-title) {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 900;
    color: #000000;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .covers-results-list :global(.cover-card-sub) {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 700;
    color: #3f3f46;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .covers-results-list :global(.artist-highlight) {
    color: #000000;
    font-weight: 900;
  }

  .covers-results-list :global(.cover-card-action-btn) {
    width: 34px;
    height: 34px;
    border-radius: 4px;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 1.5px solid #000000;
    box-shadow: 1px 1px 0px #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.85rem;
    flex-shrink: 0;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .covers-results-list :global(.cover-card-action-btn:hover) {
    background: #ffffff;
    transform: scale(1.1);
  }

  .covers-results-list :global(.request-song-card-container) {
    width: 100%;
    grid-column: 1 / -1;
  }

  .covers-results-list :global(.cant-find-card) {
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 4px 4px 0px #000000;
    border-radius: 8px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .covers-results-list :global(.cant-find-header) {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .covers-results-list :global(.cant-find-icon-badge) {
    width: 42px;
    height: 42px;
    border-radius: 6px;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    flex-shrink: 0;
  }

  .covers-results-list :global(.cant-find-title) {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 900;
    color: var(--text-card-primary);
    text-transform: uppercase;
    margin: 0;
  }

  .covers-results-list :global(.cant-find-sub) {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-card-secondary);
    margin: 2px 0 0 0;
  }

  .covers-results-list :global(.request-song-form) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .covers-results-list :global(.form-group) {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .covers-results-list :global(.form-group label) {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-card-primary);
  }

  .covers-results-list :global(.req-star) {
    color: #ef4444;
  }

  .covers-results-list :global(.opt-label) {
    color: var(--text-card-muted);
    font-weight: 600;
    font-size: 0.68rem;
  }

  .covers-results-list :global(.form-group input),
  .covers-results-list :global(.form-group textarea) {
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 8px 12px;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.84rem;
    font-weight: 700;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .covers-results-list :global(.form-group input:focus),
  .covers-results-list :global(.form-group textarea:focus) {
    border-color: #000000;
    box-shadow: 3px 3px 0px #000000;
  }

  .covers-results-list :global(.subscribed-email-notice-badge) {
    background: var(--surface-card-light-hover);
    border: 2px solid #000000;
    border-radius: 6px;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 2px 2px 0px #000000;
  }

  .covers-results-list :global(.sub-badge-left) {
    color: #16a34a;
    font-size: 1.15rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .covers-results-list :global(.sub-badge-content) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .covers-results-list :global(.sub-badge-status) {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-card-primary);
  }

  .covers-results-list :global(.sub-badge-text) {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-card-secondary);
    margin: 0;
    line-height: 1.3;
  }

  .covers-results-list :global(.artist-suggestions-box) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 4px;
  }

  .covers-results-list :global(.suggestions-label) {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    color: var(--text-card-primary);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .covers-results-list :global(.suggestions-loading-text) {
    font-size: 0.72rem;
    color: var(--text-card-secondary);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 2px 0;
  }

  .covers-results-list :global(.artist-pills-scroll-row) {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 2px 0 4px 0;
    -webkit-overflow-scrolling: touch;
  }

  .covers-results-list :global(.artist-suggestion-pill) {
    flex: 0 0 auto;
    background: var(--surface-card-light-hover);
    border: 1.5px solid #000000;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
    animation: pillPopIn 0.22s var(--ease-snappy) both;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  @keyframes pillPopIn {
    from {
      opacity: 0;
      transform: scale(0.92) translateY(4px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .covers-results-list :global(.artist-suggestion-pill:hover) {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translateY(-1px);
  }

  .covers-results-list :global(.artist-suggestion-pill.active) {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
    font-weight: 900;
  }

  .covers-results-list :global(.request-form-actions) {
    display: flex;
    gap: 8px;
    margin-top: 6px;
  }

  .covers-results-list :global(.submit-request-btn) {
    flex: 1;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    padding: 10px 16px;
    border-radius: 6px;
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .covers-results-list :global(.submit-request-btn:hover) {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
  }

  .covers-results-list :global(.cancel-request-btn) {
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    padding: 8px 14px;
    border-radius: 6px;
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: transform 0.16s var(--ease-tactile);
  }

  .covers-results-list :global(.cancel-request-btn:hover) {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
  }

  .covers-results-list :global(.song-request-success-card) {
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 4px 4px 0px #000000;
    border-radius: 8px;
    padding: 24px 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    margin: 8px 0;
  }

  .covers-results-list :global(.success-icon-box) {
    width: 52px;
    height: 52px;
    border-radius: 10px;
    background: var(--accent-neon-yellow);
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
  }

  .covers-results-list :global(.success-title) {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 900;
    color: var(--text-card-primary);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .covers-results-list :global(.success-desc) {
    font-family: var(--font-secondary);
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--text-card-secondary);
    line-height: 1.45;
    margin: 0;
    max-width: 360px;
  }

  .covers-results-list :global(.success-meta-note) {
    background: var(--surface-card-light-hover);
    border: 2px solid #000000;
    border-radius: 6px;
    padding: 8px 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--text-card-secondary);
    box-shadow: 1.5px 1.5px 0px #000000;
  }

  .covers-results-list :global(.success-meta-note i) {
    color: var(--text-card-primary);
    font-size: 0.9rem;
  }

  .covers-results-list :global(.request-another-btn) {
