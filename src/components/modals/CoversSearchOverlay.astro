---
const categories = [
  { key: "all", label: "All Covers", active: true },
  { key: "full-band", label: "Full Band", active: false },
  { key: "acoustic", label: "Acoustic", active: false },
  { key: "shorts", label: "Shorts", active: false }
];
---

<div class="covers-search-overlay" id="coversSearchOverlay">
  <div class="search-overlay-header">
    <div class="expanded-search-input-box">
      <i class="fa-solid fa-magnifying-glass search-box-icon"></i>
      <input type="text" id="overlaySearchInput" placeholder="Search covers by title or artist..." autocomplete="off">
    </div>
    <button class="close-overlay-btn" id="closeSearchOverlayBtn" aria-label="Close cover search">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>

  <div class="search-overlay-body">
    <!-- Category Filter Pills Row -->
    <div class="category-pills-row">
      {categories.map((cat) => (
        <button class={`cover-category-pill ${cat.active ? 'active' : ''}`} data-category={cat.key}>
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Section Title -->
    <div class="covers-results-header">
      <h3 class="covers-section-title" id="coversSectionTitle">Latest Releases</h3>
    </div>

    <!-- Cover Results Cards List -->
    <div class="covers-results-list" id="coversResultsList">
      <!-- Populated dynamically by coversSearchEngine.js -->
    </div>
  </div>
</div>

<style>
  .covers-search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 12, 0.96);
    backdrop-filter: blur(16px);
    z-index: 950;
    display: flex;
    flex-direction: column;
    padding: 16px 20px;
    opacity: 0;
    pointer-events: none;
    transform: scale(0.95);
    transition: opacity 0.25s var(--ease-snappy), transform 0.25s var(--ease-snappy);
  }

  .covers-search-overlay:global(.active) {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
  }

  .search-overlay-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    margin-top: 8px;
  }

  .expanded-search-input-box {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(18, 18, 20, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 4px;
    padding: 10px 14px;
    transition: border-color 0.2s ease;
  }

  .expanded-search-input-box:focus-within {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .search-box-icon {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .expanded-search-input-box input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.88rem;
    font-weight: 500;
    width: 100%;
  }

  .close-overlay-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-white);
    width: 36px;
    height: 36px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.9rem;
    transition: background-color 0.18s ease;
  }

  .close-overlay-btn:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .search-overlay-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow-y: auto;
    max-width: 440px;
    width: 100%;
    margin: 0 auto;
    padding-bottom: 40px;
  }

  .category-pills-row {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 2px 0;
  }

  .cover-category-pill {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.18s var(--ease-snappy);
  }

  .cover-category-pill.active {
    background: var(--btn-green);
    color: var(--btn-text-color);
    border-color: var(--btn-green);
    font-weight: 800;
  }

  .covers-section-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-white);
    margin-top: 4px;
  }

  .covers-results-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .covers-results-list :global(.cover-result-card) {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 64px;
    cursor: pointer;
    backdrop-filter: blur(12px);
    transition: transform 0.18s var(--ease-snappy), border-color 0.18s ease;
  }

  .covers-results-list :global(.cover-result-card:hover) {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.28);
  }

  .covers-results-list :global(.cover-card-thumb-box) {
    width: 60px;
    height: 44px;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
    background: #000;
  }

  .covers-results-list :global(.cover-card-thumb-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .covers-results-list :global(.thumb-play-overlay) {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-white);
    font-size: 0.8rem;
  }

  .covers-results-list :global(.cover-card-info) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .covers-results-list :global(.cover-card-title) {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-white);
  }

  .covers-results-list :global(.cover-card-sub) {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .covers-results-list :global(.artist-highlight) {
    color: var(--text-white);
    font-weight: 700;
  }

  .covers-results-list :global(.cover-card-action-btn) {
    width: 32px;
    height: 32px;
    border-radius: 4px;
    background: var(--btn-green);
    color: var(--btn-text-color);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.8rem;
  }

  .covers-results-list :global(.request-song-card-container) {
    width: 100%;
  }

  .covers-results-list :global(.cant-find-card) {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    backdrop-filter: blur(12px);
  }

  .covers-results-list :global(.cant-find-header) {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .covers-results-list :global(.cant-find-icon-badge) {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    background: var(--btn-green);
    color: var(--btn-text-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .covers-results-list :global(.cant-find-title) {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-white);
  }

  .covers-results-list :global(.cant-find-sub) {
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .covers-results-list :global(.request-song-form) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .covers-results-list :global(.form-group) {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .covers-results-list :global(.form-group label) {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-white);
  }

  .covers-results-list :global(.req-star) {
    color: var(--accent-crimson);
  }

  .covers-results-list :global(.opt-label) {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.68rem;
  }

  .covers-results-list :global(.form-group input),
  .covers-results-list :global(.form-group textarea) {
    background: rgba(10, 10, 12, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    padding: 8px 12px;
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.84rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .covers-results-list :global(.form-group input:focus),
  .covers-results-list :global(.form-group textarea:focus) {
    border-color: rgba(255, 255, 255, 0.3);
  }

  .covers-results-list :global(.artist-suggestions-box) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 4px;
  }

  .covers-results-list :global(.suggestions-label) {
    font-family: var(--font-secondary);
    font-size: 0.64rem;
    color: var(--text-muted);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .covers-results-list :global(.suggestions-loading-text) {
    font-size: 0.72rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 2px 0;
  }

  .covers-results-list :global(.artist-pills-scroll-row) {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 2px 0 4px 0;
    -webkit-overflow-scrolling: touch;
  }

  .covers-results-list :global(.artist-suggestion-pill) {
    flex: 0 0 auto;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.18s ease;
  }

  .covers-results-list :global(.artist-suggestion-pill:hover) {
    background: rgba(255, 255, 255, 0.16);
    color: var(--text-white);
  }

  .covers-results-list :global(.artist-suggestion-pill.active) {
    background: var(--btn-green);
    color: var(--btn-text-color);
    border-color: var(--btn-green);
    font-weight: 800;
  }

  .covers-results-list :global(.request-form-actions) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 6px;
  }

  .covers-results-list :global(.submit-request-btn) {
    background: var(--btn-green);
    color: var(--btn-text-color);
    border: none;
    padding: 10px 16px;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: transform 0.18s var(--ease-snappy);
  }

  .covers-results-list :global(.submit-request-btn:hover) {
    background: var(--btn-green-hover);
    transform: translateY(-1px);
  }

  .covers-results-list :global(.cancel-request-btn) {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-muted);
    padding: 8px 14px;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: all 0.18s ease;
  }

  .covers-results-list :global(.cancel-request-btn:hover) {
    background: rgba(255, 255, 255, 0.16);
    color: var(--text-white);
  }

  .covers-results-list :global(.song-request-success-card) {
    background: rgba(18, 18, 20, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 6px;
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
  }

  .covers-results-list :global(.success-icon-box) {
    font-size: 2rem;
    color: var(--text-white);
  }

  .covers-results-list :global(.success-title) {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-white);
  }

  .covers-results-list :global(.success-desc) {
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .covers-results-list :global(.request-another-btn) {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--text-white);
    padding: 8px 16px;
    border-radius: 4px;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 6px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .covers-results-list :global(.bottom-request-trigger-box) {
    display: flex;
    justify-content: center;
    margin-top: 10px;
  }

  .covers-results-list :global(.bottom-request-pill-btn) {
    background: rgba(255, 255, 255, 0.06);
    border: 1px dashed rgba(255, 255, 255, 0.25);
    color: var(--text-white);
    padding: 8px 16px;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 0.18s ease;
  }

  .covers-results-list :global(.bottom-request-pill-btn:hover) {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.4);
    color: #ffffff;
  }
</style>

<script>
  import { initCoversSearchEngine } from '../../scripts/controllers/coversSearchEngine.js';
  initCoversSearchEngine();
</script>
