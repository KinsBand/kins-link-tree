<script>
  // Warm up at idle, but preserve the first click when it arrives earlier.
  let controllerPromise: Promise<typeof import('../../scripts/controllers/coversSearchEngine.js')> | null = null;
  const loadController = () => controllerPromise ??= import('../../scripts/controllers/coversSearchEngine.js');
  document.addEventListener('click', async (event) => {
    const button = event.target instanceof Element ? event.target.closest<HTMLElement>('#headerSearchPillBtn') : null;
    const overlay = document.getElementById('coversSearchOverlay');
    if (!button || !overlay || overlay.dataset.searchReady === 'true') return;
    event.preventDefault();
    event.stopPropagation();
    try {
      const controller = await loadController();
      if (!button.isConnected || !overlay.isConnected) return;
      controller.initCoversSearchEngine();
      if (!overlay.classList.contains('active')) button.click();
    } catch (error) {
      controllerPromise = null;
      console.error('Unable to load covers search', error);
    }
  }, true);
  const scheduleIdle = (cb: () => void) => {
    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(cb, { timeout: 2500 });
    } else {
      setTimeout(cb, 1);
    }
  };
  scheduleIdle(() => {
    loadController().then((m) => m.initCoversSearchEngine()).catch(() => { controllerPromise = null; });
  });
</script>
