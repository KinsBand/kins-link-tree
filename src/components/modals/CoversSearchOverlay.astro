---
const categories = [
  { key: "all", label: "All", active: true },
  { key: "full-band", label: "Full Band", active: false },
  { key: "acoustic", label: "Acoustic", active: false },
  { key: "shorts", label: "Shorts", active: false }
];
---

<div class="covers-search-overlay" id="coversSearchOverlay" role="dialog" aria-modal="true" aria-label="Search Cover Videos" aria-hidden="true" inert data-track-container="modal:covers_search">
  <div class="command-palette-container" id="commandPaletteContainer">
    <div class="search-overlay-header">
      <div class="expanded-search-input-box">
        <i class="fa-solid fa-magnifying-glass search-box-icon"></i>
        <input type="text" id="overlaySearchInput" placeholder="Search covers by title, artist, or tag..." autocomplete="off" data-track="covers_search:input">
        <span class="cmd-k-badge"><kbd>Ctrl</kbd> <kbd>K</kbd></span>
        <button type="button" class="clear-search-btn hidden" id="clearSearchInputBtn" aria-label="Clear search text" data-track="covers_search:clear">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <button class="close-overlay-btn" id="closeSearchOverlayBtn" aria-label="Close cover search" data-track="covers_search:close">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Pinned Top Controls: Category Pills (Never scrolls or gets clipped) -->
    <div class="search-overlay-pinned-controls">
      <!-- Category Filter Pills Row -->
      <div class="category-pills-row">
        {categories.map((cat) => (
          <button class={`cover-category-pill brutal-press ${cat.active ? 'active' : ''}`} data-category={cat.key} data-track={`covers_search:cat_${cat.key}`}>
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <div class="search-overlay-body" id="searchOverlayBody">
      <!-- Rehearsal Spotlight: Cover song Kins Band is actively learning -->
      <section class="covers-learning-section" id="coversLearningSection" aria-label="Currently Learning Cover">
        <!-- Populated dynamically by coversSearchEngine.js -->
      </section>

      <!-- Section Title -->
      <div class="covers-results-header">
        <h3 class="covers-section-title" id="coversSectionTitle">Latest Covers</h3>
      </div>

      <!-- Cover Results Cards List -->
      <div class="covers-results-list" id="coversResultsList">
        <!-- Populated dynamically by coversSearchEngine.js -->
      </div>
    </div>
  </div>
</div>

<style>
  .covers-search-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    z-index: 950;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s var(--ease-snappy);
  }

  .covers-search-overlay:global(.active) {
    opacity: 1;
    pointer-events: auto;
  }

  .command-palette-container {
    width: 100%;
    max-width: 780px;
    max-height: 85vh;
    background: #141416;
    border: 3px solid #000000;
    border-radius: 10px;
    box-shadow: 6px 6px 0px #000000;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 20px;
    transform: scale(0.95) translateY(-10px);
    transition: transform 0.25s var(--ease-snappy);
    box-sizing: border-box;
  }

  .covers-search-overlay:global(.active) .command-palette-container {
    transform: scale(1) translateY(0);
  }

  @media (max-width: 767px) {
    .covers-search-overlay {
      padding: 0;
      background: #141416;
    }
    .command-palette-container {
      max-width: 100%;
      height: 100%;
      max-height: 100%;
      border-radius: 0;
      border: none;
      padding: 14px 16px;
    }
  }

  .search-overlay-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .expanded-search-input-box {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface-input);
    border: 3px solid #000000;
    border-radius: 6px;
    box-shadow: 3px 3px 0px var(--accent-neon-yellow);
    padding: 10px 14px;
    transition: box-shadow 0.2s ease;
  }

  .expanded-search-input-box:focus-within {
    box-shadow: 4px 4px 0px var(--accent-neon-yellow);
  }

  .search-box-icon {
    font-size: 1rem;
    color: var(--text-card-primary);
  }

  .expanded-search-input-box input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.92rem;
    font-weight: 800;
    width: 100%;
  }

  .expanded-search-input-box input::placeholder {
    color: var(--text-card-muted);
    font-weight: 600;
  }

  .cmd-k-badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    color: #000000;
    background: var(--accent-neon-yellow);
    border: 1.5px solid #000000;
    padding: 1px 6px;
    border-radius: 4px;
    white-space: nowrap;
    font-weight: 900;
  }

  .cmd-k-badge kbd {
    font-family: inherit;
    font-weight: 900;
  }

  @media (max-width: 600px) {
    .cmd-k-badge { display: none; }
  }

  .clear-search-btn {
    background: transparent;
    border: none;
    color: var(--text-card-primary);
    cursor: pointer;
    font-size: 0.95rem;
    padding: 6px 10px;
    min-width: 38px;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile);
  }

  .clear-search-btn i {
    pointer-events: none;
  }

  .clear-search-btn:hover {
    transform: scale(1.2);
  }

  .clear-search-btn.hidden {
    display: none !important;
  }

  .close-overlay-btn {
    background: var(--surface-input);
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1rem;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
    flex-shrink: 0;
  }

  .close-overlay-btn i {
    pointer-events: none;
  }

  .close-overlay-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
  }

  .search-overlay-pinned-controls {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-shrink: 0;
    margin-bottom: 12px;
    z-index: 5;
  }

  .search-overlay-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow-y: auto;
    overscroll-behavior: contain;
    width: 100%;
    max-width: 100%;
    padding-right: 4px;
    min-height: 0;
  }

  /* Currently Learning Spotlight Section */
  .covers-learning-section {
    width: 100%;
    margin-bottom: 6px;
    transition: opacity 0.2s ease;
  }

  .covers-learning-section.hidden {
    display: none !important;
  }

  .covers-learning-section :global(.learning-card) {
    background: #141418;
    border: 2.5px solid #000000;
    border-radius: 10px;
    box-shadow: 4px 4px 0px #000000;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    position: relative;
    overflow: hidden;
  }

  .covers-learning-section :global(.learning-header-bar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .covers-learning-section :global(.learning-badge) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--btn-brand-primary, #f2fd43);
    color: var(--btn-brand-text, #000000);
    border: 1.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    border-radius: 4px;
    padding: 3px 8px;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    user-select: none;
    line-height: 1;
  }

  .covers-learning-section :global(.learning-pulse-dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #000000;
    animation: learningPulse 1.2s ease-in-out infinite alternate;
  }

  @keyframes learningPulse {
    0% { transform: scale(0.75); opacity: 0.5; }
    100% { transform: scale(1.3); opacity: 1; }
  }

  .covers-learning-section :global(.learning-hero-thumb) {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 165px;
    border-radius: 6px;
    border: 2px solid #000000;
    overflow: hidden;
    background: #000000;
    box-shadow: 2px 2px 0px #000000;
  }

  .covers-learning-section :global(.learning-hero-thumb img) {
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    max-height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block !important;
  }

  .covers-learning-section :global(.learning-info-block) {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .covers-learning-section :global(.learning-song-title) {
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .covers-learning-section :global(.learning-artist-line) {
    font-family: var(--font-secondary, sans-serif);
    font-size: 0.80rem;
    color: var(--text-muted, #a1a1aa);
    margin: 0;
  }

  .covers-learning-section :global(.learning-artist-line strong) {
    color: #f4f4f6;
  }

  .covers-learning-section :global(.learning-actions-grid) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    margin-top: 4px;
  }

  .covers-learning-section :global(.learning-action-btn) {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 9px 14px;
    border-radius: 6px;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 800;
    text-decoration: none !important;
    cursor: pointer;
    line-height: 1;
    white-space: nowrap;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  .covers-learning-section :global(a.learning-tabs-btn) {
    background: var(--btn-brand-primary, #f2fd43);
    color: #000000 !important;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    box-sizing: border-box;
  }

  .covers-learning-section :global(a.learning-tabs-btn:hover) {
    background: var(--btn-brand-hover, #faff60);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .covers-learning-section :global(.learning-vote-btn) {
    background: #24242e;
    color: #f5f5f7;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 8px 10px;
  }

  .covers-learning-section :global(.learning-vote-label) {
    line-height: 1;
    font-weight: 800;
  }

  .covers-learning-section :global(.learning-vote-chip) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(255, 255, 255, 0.12);
    padding: 2px 6px;
    border-radius: 9999px;
    font-size: 0.68rem;
    font-family: var(--font-secondary, sans-serif);
    font-weight: 700;
    line-height: 1;
    color: #f5f5f7;
    transition: transform 0.2s var(--ease-snappy), background-color 0.2s ease, color 0.2s ease;
  }

  .covers-learning-section :global(.learning-vote-chip i) {
    color: var(--btn-brand-primary, #f2fd43);
    font-size: 0.65rem;
  }

  :global([data-theme="dark"]) .covers-learning-section :global(.learning-vote-chip i) {
    color: var(--btn-brand-primary, #d4af37);
  }

  .covers-learning-section :global(.learning-vote-btn:hover) {
    background: #31313e;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .covers-learning-section :global(.learning-vote-btn.voted) {
    background: var(--btn-brand-primary, #f2fd43);
    color: #000000;
    font-weight: 900;
  }

  .covers-learning-section :global(.learning-vote-btn.voted .learning-vote-chip) {
    background: rgba(0, 0, 0, 0.15);
    color: #000000;
  }

  .covers-learning-section :global(.learning-vote-btn.voted .learning-vote-chip i) {
    color: #000000;
  }

  :global([data-theme="dark"]) .covers-learning-section :global(.learning-vote-btn.voted) {
    background: var(--btn-brand-primary, #d4af37);
    color: #000000;
  }

  .covers-learning-section :global(.learning-vote-chip.chip-bump) {
    transform: scale(1.18);
  }

  .zero-state-suggestions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    width: 100%;
    margin-top: 2px;
  }

  .zero-state-suggestions.hidden {
    display: none !important;
  }

  .popular-search-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-heading);
    font-size: 0.70rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted, #a1a1aa);
    user-select: none;
    padding-left: 2px;
  }

  .popular-search-badge .text-green {
    color: #f97316;
  }

  .suggestion-chips-row {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    width: 100%;
    padding: 2px 2px 6px 2px;
  }

  .suggestion-chips-row::-webkit-scrollbar {
    display: none;
  }

  .suggestion-chip-btn {
    background: var(--surface-card-panel);
    border: 1.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  .suggestion-chip-btn:hover {
    background: var(--btn-brand-primary);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .suggestion-chip-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .suggestion-chip-btn:focus-visible {
    outline: 2px solid var(--brand-accent-primary);
    outline-offset: 2px;
  }

  .category-pills-row {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding: 4px 4px 8px 4px;
  }

  .category-pills-row::-webkit-scrollbar {
    display: none;
  }

  .cover-category-pill {
    background: var(--surface-card-panel);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 7px 16px;
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease, color 0.16s ease;
  }

  .cover-category-pill:hover {
    background: var(--surface-card-panel-hover);
    color: var(--text-card-primary);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .cover-category-pill.active {
    background: var(--btn-brand-primary);
    color: var(--btn-brand-text);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    font-weight: 900;
  }

  .cover-category-pill:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .cover-category-pill:focus-visible {
    outline: 2px solid var(--brand-accent-primary);
    outline-offset: 2px;
  }

  .covers-results-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
  }

  .covers-section-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .covers-results-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (min-width: 600px) {
    .covers-results-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 14px;
    }
  }

  .covers-results-list :global(.cover-result-card) {
    background: var(--surface-card-panel);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px var(--brand-accent-primary);
    border-radius: 8px;
    padding: 8px 10px;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease;
    box-sizing: border-box;
    text-decoration: none;
    user-select: none;
  }

  .covers-results-list :global(.cover-result-card:hover) {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px var(--brand-accent-primary);
    background: var(--surface-card-panel-hover);
  }

  .covers-results-list :global(.cover-result-card:focus-visible) {
    outline: 2px solid var(--brand-accent-primary);
    outline-offset: 2px;
  }

  .covers-results-list :global(.cover-card-thumb-box),
  .covers-results-list :global(.cover-card-thumb-wrap) {
    width: 64px;
    height: 48px;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
    background: #000000;
    border: 1.5px solid #000000;
  }

  .covers-results-list :global(.cover-card-thumb-img),
  .covers-results-list :global(.cover-card-thumb) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .covers-results-list :global(.thumb-play-overlay),
  .covers-results-list :global(.cover-card-play-overlay) {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-accent-primary);
    font-size: 0.85rem;
    transition: background-color 0.16s ease;
  }

  .covers-results-list :global(.cover-result-card:hover .thumb-play-overlay),
  .covers-results-list :global(.cover-result-card:hover .cover-card-play-overlay) {
    background: rgba(0, 0, 0, 0.22);
  }

  .covers-results-list :global(.cover-card-duration) {
    position: absolute;
    bottom: 2px;
    right: 2px;
    background: rgba(0, 0, 0, 0.85);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    padding: 1px 4px;
    border-radius: 2px;
    line-height: 1.2;
  }

  .covers-results-list :global(.cover-card-info) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .covers-results-list :global(.cover-card-meta-row) {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 1px;
  }

  .covers-results-list :global(.cover-card-category-badge) {
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: #000000;
    color: #ffffff;
    padding: 1px 5px;
    border-radius: 3px;
    display: inline-block;
  }

  .covers-results-list :global(.cover-card-views) {
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-card-muted);
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .covers-results-list :global(.cover-card-views i) {
    color: #f97316;
    font-size: 0.6rem;
  }

  .covers-results-list :global(.cover-card-title) {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 900;
    color: var(--text-card-primary);
    white-space: normal;
    word-break: break-word;
    overflow: visible;
    text-overflow: clip;
    line-height: 1.25;
    margin: 0;
  }

  .covers-results-list :global(.cover-card-sub),
  .covers-results-list :global(.cover-card-artist) {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--text-card-secondary);
    white-space: normal;
    word-break: break-word;
    overflow: visible;
    text-overflow: clip;
    line-height: 1.25;
    margin: 0;
  }

  .covers-results-list :global(.artist-highlight) {
    color: var(--text-card-primary);
    font-weight: 900;
  }

