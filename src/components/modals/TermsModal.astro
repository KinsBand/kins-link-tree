---
---

<div class="modal-backdrop hidden" id="termsModal" role="dialog" aria-modal="true" aria-label="Fan Submission Terms" data-track-container="modal:terms">
  <div class="modal-content legal-modal-content">
    <div class="modal-header">
      <div class="modal-title-group">
        <div class="header-icon-badge">
          <i class="fa-solid fa-file-contract"></i>
        </div>
        <div class="header-text">
          <span class="header-badge-tag">CREW GUIDELINES</span>
          <h3>Fan Submission Terms</h3>
        </div>
      </div>
      <button class="close-modal-btn" id="closeTermsModal" aria-label="Close Fan Submission Terms" data-track="terms:close">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="legal-modal-body">
      <div class="agreement-highlight-box">
        <div class="highlight-badge"><i class="fa-solid fa-bolt"></i> SUBMISSION AGREEMENT</div>
        <p class="agreement-main-text">
          By sharing your link or clip with Kins, you confirm that you own or have rights to the content and grant Kins permission to feature, repost, or embed your clip on our official website and social media channels. <strong>You maintain 100% full ownership of your original video.</strong>
        </p>
      </div>

      <div class="legal-section">
        <h4>1. Ownership & License</h4>
        <div class="legal-bullet-box">
          <div class="bullet-item">
            <span class="bullet-tag">YOUR RIGHTS</span>
            <p>You retain 100% ownership and copyright of your original video or audio.</p>
          </div>
          <div class="bullet-item">
            <span class="bullet-tag">BAND PERMISSION</span>
            <p>Submitting a link grants Kins a non-exclusive, royalty-free license to display, feature, or embed your clip across our official website, social media, and digital channels.</p>
          </div>
        </div>
      </div>

      <div class="legal-section">
        <h4>2. Content Responsibilities</h4>
        <p class="legal-text">You represent that your submission does not violate any third-party copyrights, trademarks, or privacy rights. Kins reserves the right to remove any featured clip at our discretion.</p>
      </div>
    </div>

    <div class="legal-modal-footer">
      <button type="button" class="close-legal-btn" id="closeTermsFooterBtn" data-track="terms:footer_close">I Agree & Close</button>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 10050;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.22s;
  }

  .modal-backdrop.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .modal-backdrop.is-closing {
    opacity: 0;
    pointer-events: none;
  }

  .legal-modal-content {
    background: #141416;
    border: 3px solid #000000;
    border-radius: 8px;
    box-shadow: 6px 6px 0px #000000;
    width: 100%;
    max-width: 520px;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: legalModalPopIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .legal-modal-content.is-closing {
    animation: legalModalPopOut 0.18s ease forwards;
  }

  @keyframes legalModalPopIn {
    from {
      transform: scale(0.96) translateY(6px);
      opacity: 0;
    }
    to {
      transform: scale(1) translateY(0);
      opacity: 1;
    }
  }

  @keyframes legalModalPopOut {
    from {
      transform: scale(1) translateY(0);
      opacity: 1;
    }
    to {
      transform: scale(0.96) translateY(6px);
      opacity: 0;
    }
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    background: #1c1c20;
    border-bottom: 3px solid #000000;
  }

  .modal-title-group {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
  }

  .header-icon-badge {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .header-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .header-badge-tag {
    font-family: var(--font-secondary);
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    color: var(--accent-neon-yellow);
    text-transform: uppercase;
  }

  .modal-title-group h3 {
    font-family: var(--font-heading);
    font-size: clamp(0.92rem, 3.5vw, 1.05rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
  }

  .close-modal-btn {
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    width: 36px;
    height: 36px;
    min-width: 36px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.95rem;
    flex-shrink: 0;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .close-modal-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .legal-modal-body {
    padding: 16px 18px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: #a1a1aa;
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    line-height: 1.5;
    scrollbar-width: thin;
    scrollbar-color: var(--accent-neon-yellow) transparent;
  }

  .agreement-highlight-box {
    background: #1c1c20;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .highlight-badge {
    align-self: flex-start;
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    background: var(--accent-neon-yellow);
    color: #000000;
    padding: 2px 7px;
    border-radius: 3px;
    border: 1px solid #000000;
  }

  .agreement-main-text {
    color: #ffffff;
    font-size: 0.82rem;
    line-height: 1.45;
    margin: 0;
  }

  .legal-section {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .legal-section h4 {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 900;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin: 0;
  }

  .legal-text {
    margin: 0;
    color: #d4d4d8;
  }

  .legal-bullet-box {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bullet-item {
    background: #1c1c20;
    border: 1.5px solid #000000;
    border-radius: 6px;
    padding: 8px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .bullet-tag {
    align-self: flex-start;
    font-size: 0.6rem;
    font-weight: 900;
    color: #000000;
    background: var(--accent-neon-yellow);
    padding: 1px 5px;
    border-radius: 3px;
    letter-spacing: 0.06em;
  }

  .bullet-item p {
    margin: 0;
    color: #d4d4d8;
    font-size: 0.8rem;
  }

  .legal-modal-footer {
    padding: 12px 16px;
    background: #1c1c20;
    border-top: 3px solid #000000;
    display: flex;
    justify-content: flex-end;
  }

  .close-legal-btn {
    background: var(--accent-neon-yellow);
    color: #000000;
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 9px 20px;
    border-radius: 6px;
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
  }

  .close-legal-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #ffffff;
  }
</style>

<script>
  const termsModal = document.getElementById('termsModal');
  const closeTermsModal = document.getElementById('closeTermsModal');
  const closeTermsFooterBtn = document.getElementById('closeTermsFooterBtn');

  const CLOSE_ANIM_MS = 190;
  let closeTimer: ReturnType<typeof setTimeout> | null = null;
  const prefersReducedMotion =
    typeof window.matchMedia === 'function' &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Check if underlying community submission modal or feedback modal is still open
  function isOtherModalOpen(): boolean {
    const ids = ['feedbackModal', 'communitySubmissionModal', 'privacyModal'];
    return ids.some((id) => {
      const el = document.getElementById(id);
      return !!el && !el.classList.contains('hidden');
    });
  }

  function finishTermsClose() {
    closeTimer = null;
    if (!termsModal) return;
    termsModal.classList.remove('is-closing');
    termsModal.classList.add('hidden');

    // Only unlock page scrolling if no other modal is active
    if (!isOtherModalOpen()) {
      document.body.classList.remove('modal-open');
      document.documentElement.classList.remove('modal-open');
    }
  }

  function hideTermsModal() {
    if (!termsModal) return;
    if (termsModal.classList.contains('hidden') || termsModal.classList.contains('is-closing')) return;

    if (prefersReducedMotion) {
      finishTermsClose();
      return;
    }

    termsModal.classList.add('is-closing');
    closeTimer = setTimeout(finishTermsClose, CLOSE_ANIM_MS);
  }

  function openTermsModal() {
    if (!termsModal) return;
    if (closeTimer) {
      clearTimeout(closeTimer);
      closeTimer = null;
    }
    termsModal.classList.remove('is-closing');
    termsModal.classList.remove('hidden');
    document.body.classList.add('modal-open');
  }

  (window as any).openTermsModal = openTermsModal;

  closeTermsModal?.addEventListener('click', hideTermsModal);
  closeTermsFooterBtn?.addEventListener('click', hideTermsModal);
  termsModal?.addEventListener('click', (e) => {
    if (e.target === termsModal) hideTermsModal();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && termsModal && !termsModal.classList.contains('hidden')) {
      e.stopPropagation();
      hideTermsModal();
    }
  });
</script>
