---
---

<div class="modal-backdrop hidden" id="communitySubmissionModal" role="dialog" aria-modal="true" aria-label="Submit Fan Clip">
  <div class="modal-content community-modal-enhanced">
    <div class="modal-header">
      <div class="modal-title-group">
        <div class="community-header-icon-circle">
          <i class="fa-solid fa-clapperboard"></i>
        </div>
        <div class="modal-title-text-wrap">
          <h3 id="communityModalTitle">Submit Fan Clip</h3>
          <p class="modal-subtitle-text">Share covers, edits & live clips with Kins</p>
        </div>
      </div>
      <div class="modal-header-actions">
        <button type="button" class="disclaimer-info-btn" id="openTermsInfoBtn" title="View Fan Submission Agreement" aria-label="View Fan Submission Agreement">
          <i class="fa-solid fa-circle-info"></i>
        </button>
        <button class="close-modal-btn" id="closeCommunityModal" aria-label="Close modal">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    </div>

    <div class="modal-body community-modal-body">
      <!-- Form View -->
      <form id="communitySubmissionForm" class="community-submission-form">

        <!-- Category Tags Selection (2-Row Horizontal Scroll Grid) -->
        <div class="form-group">
          <div class="form-label-row">
            <label class="form-label">Category</label>
            <span class="category-selected-label" id="communityCategoryDisplayLabel">Drum Cover</span>
          </div>
          <div class="category-scroll-wrapper">
            <div class="category-chips-grid" id="categoryTagsGrid">
              <button type="button" class="category-chip category-tag-btn active" data-category="Drum Cover">
                <i class="fa-solid fa-drum"></i> Drum Cover
              </button>
              <button type="button" class="category-chip category-tag-btn" data-category="Guitar & Bass">
                <i class="fa-solid fa-guitar"></i> Guitar & Bass
              </button>
              <button type="button" class="category-chip category-tag-btn" data-category="Vocal Cover">
                <i class="fa-solid fa-microphone"></i> Vocal Cover
              </button>
              <button type="button" class="category-chip category-tag-btn" data-category="Fan Edit">
                <i class="fa-solid fa-film"></i> Fan Edit
              </button>
              <button type="button" class="category-chip category-tag-btn" data-category="Live Show Clip">
                <i class="fa-solid fa-ticket"></i> Live Clip
              </button>
              <button type="button" class="category-chip category-tag-btn" data-category="Full Band Cover">
                <i class="fa-solid fa-users"></i> Full Band
              </button>
              <button type="button" class="category-chip category-tag-btn" data-category="Piano & Keys">
                <i class="fa-solid fa-keyboard"></i> Piano & Keys
              </button>
              <button type="button" class="category-chip category-tag-btn" data-category="Acoustic / Unplugged">
                <i class="fa-solid fa-compact-disc"></i> Acoustic
              </button>
              <button type="button" class="category-chip category-tag-btn" data-category="Reaction & Review">
                <i class="fa-solid fa-headphones"></i> Reaction / Review
              </button>
              <button type="button" class="category-chip category-tag-btn" data-category="Other">
                <i class="fa-solid fa-plus"></i> Other
              </button>
            </div>
            <div class="scroll-fade-edge-right"></div>
          </div>
          <input type="hidden" name="category" id="selectedCategoryInput" value="Drum Cover">
        </div>

        <!-- Video / Media URL Field -->
        <div class="form-group">
          <label class="form-label" for="clipUrlInput">Video or Post Link</label>
          <div class="input-with-paste-row">
            <div class="input-with-detected-badge">
              <i class="fa-solid fa-link input-left-icon"></i>
              <input type="url" id="clipUrlInput" name="url" placeholder="https://tiktok.com/@... or instagram/reel/..." required autocomplete="off">
              <span class="detected-platform-badge hidden" id="detectedPlatformBadge">
                <i class="fa-solid fa-circle-check"></i> <span id="detectedPlatformName">Link</span>
              </span>
            </div>
            <button type="button" class="paste-url-btn" id="pasteClipUrlBtn" title="Paste link from clipboard" aria-label="Paste link from clipboard">
              <i class="fa-solid fa-paste"></i>
              <span>Paste</span>
            </button>
          </div>
          <span class="input-validation-msg" id="urlValidationMsg">Paste a link from TikTok, Instagram, YouTube, or web.</span>
        </div>

        <!-- Creator Handle Field -->
        <div class="form-group">
          <label class="form-label" for="creatorHandleInput">Your Social Handle</label>
          <div class="input-with-icon">
            <i class="fa-solid fa-at input-left-icon"></i>
            <input type="text" id="creatorHandleInput" name="handle" placeholder="e.g. @yourhandle" required autocomplete="off">
          </div>
        </div>

        <!-- Optional Song / Title Field -->
        <div class="form-group">
          <label class="form-label" for="clipTitleInput">Song / Title <span class="optional-tag">(Optional)</span></label>
          <div class="input-with-icon">
            <i class="fa-solid fa-music input-left-icon"></i>
            <input type="text" id="clipTitleInput" name="title" placeholder="e.g. Everlong Cover, Live in Sydney..." autocomplete="off">
          </div>
        </div>

        <!-- Submission Micro Disclaimer -->
        <p class="submission-disclaimer-text">
          By submitting, you agree to our 
          <button type="button" class="disclaimer-terms-link" id="openTermsModalLink">Fan Content Terms</button>.
        </p>

        <!-- Submit Button -->
        <div class="form-actions">
          <button type="submit" class="submit-clip-btn" id="submitCommunityClipBtn">
            <span class="btn-text">Submit Clip</span>
            <i class="fa-solid fa-paper-plane btn-icon"></i>
            <div class="btn-spinner hidden" id="clipSpinner"></div>
          </button>
        </div>
      </form>

      <!-- Feedback / Success State View -->
      <div class="submission-success-view hidden" id="communitySubmissionSuccess">
        <div class="success-icon-circle">
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <h4>Clip Submitted!</h4>
        <p>Thanks for sharing your clip with Kins! We'll review your link and feature it on the community spotlight.</p>
        
        <div class="success-actions">
          <button type="button" class="reset-submission-btn" id="submitAnotherClipBtn">
            <i class="fa-solid fa-rotate-left"></i> Submit Another
          </button>
          <button type="button" class="close-done-btn" id="closeCommunityDoneBtn">
            Done
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    box-sizing: border-box;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.22s;
  }

  .modal-backdrop.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .community-modal-enhanced {
    width: 100%;
    max-width: 490px;
    max-height: 92vh;
    overflow-y: auto;
    background: var(--surface-card-light);
    border: 3px solid #000000;
    border-radius: 10px;
    box-shadow: 6px 6px 0px #000000;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    scrollbar-width: thin;
    scrollbar-color: var(--accent-neon-yellow) transparent;
    animation: modalPopIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .community-modal-enhanced::-webkit-scrollbar {
    width: 5px;
  }

  .community-modal-enhanced::-webkit-scrollbar-track {
    background: transparent;
  }

  .community-modal-enhanced::-webkit-scrollbar-thumb {
    background: var(--accent-neon-yellow);
    border-radius: 4px;
  }

  @keyframes modalPopIn {
    from {
      transform: scale(0.96) translateY(6px);
      opacity: 0;
    }
    to {
      transform: scale(1) translateY(0);
      opacity: 1;
    }
  }

  /* Header */
  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    gap: 10px;
    border-bottom: 2px solid #000000;
    position: sticky;
    top: 0;
    background: var(--surface-card-light);
    z-index: 10;
  }

  .modal-title-group {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex: 1;
  }

  .community-header-icon-circle {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: var(--accent-neon-yellow);
    border: 2px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .modal-title-text-wrap {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .modal-title-group h3 {
    margin: 0;
    font-family: var(--font-heading, system-ui);
    font-size: clamp(0.95rem, 3.8vw, 1.15rem);
    font-weight: 900;
    color: var(--text-card-primary);
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .modal-subtitle-text {
    margin: 2px 0 0 0;
    font-family: var(--font-secondary, system-ui);
    font-size: clamp(0.68rem, 2.6vw, 0.74rem);
    font-weight: 600;
    color: var(--text-card-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
  }

  .modal-header-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .disclaimer-info-btn,
  .close-modal-btn {
    background: var(--surface-input);
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    width: 32px;
    height: 32px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    cursor: pointer;
    flex-shrink: 0;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
    padding: 0;
  }

  .disclaimer-info-btn:hover,
  .close-modal-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
  }

  .community-modal-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .modal-intro-text {
    font-family: var(--font-secondary, system-ui);
    font-size: 0.78rem;
    color: var(--text-card-secondary);
    line-height: 1.45;
    margin: 0;
  }

  .community-submission-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .form-label {
    font-family: var(--font-secondary, system-ui);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-card-primary);
  }

  .category-selected-label {
    font-family: var(--font-secondary, system-ui);
    font-size: 0.72rem;
    font-weight: 800;
    color: #000000;
    background: var(--accent-neon-yellow);
    border: 1px solid #000000;
    padding: 1px 6px;
    border-radius: 3px;
    white-space: nowrap;
  }

  .optional-tag {
    font-weight: normal;
    text-transform: none;
    color: var(--text-card-muted);
    font-size: 0.7rem;
  }

  /* 2-Row Horizontal Scroll Grid for Categories */
  .category-scroll-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .category-chips-grid {
    display: grid;
    grid-template-rows: repeat(2, 32px);
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    gap: 7px 7px;
    overflow-x: auto;
    padding: 2px 20px 4px 2px;
    scrollbar-width: thin;
    scrollbar-color: var(--accent-neon-yellow) transparent;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
  }

  .category-chips-grid::-webkit-scrollbar {
    height: 4px;
  }

  .category-chips-grid::-webkit-scrollbar-thumb {
    background: var(--accent-neon-yellow);
    border-radius: 4px;
  }

  .scroll-fade-edge-right {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 4px;
    width: 28px;
    background: linear-gradient(90deg, transparent, var(--surface-card-light));
    pointer-events: none;
  }

  .category-chip {
    background: var(--surface-input);
    border: 1.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    color: var(--text-card-primary);
    padding: 0 12px;
    height: 32px;
    border-radius: 6px;
    font-family: var(--font-secondary, system-ui);
    font-size: 0.74rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
    white-space: nowrap;
    flex-shrink: 0;
    box-sizing: border-box;
    scroll-snap-align: start;
  }

  .category-chip i {
    font-size: 0.76rem;
  }

  .category-chip:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translateY(-1px);
  }

  .category-chip.active {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
    font-weight: 900;
  }

  .category-chip.active i {
    color: #000000;
  }

  /* Input Fields */
  .input-with-paste-row {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
  }

  .input-with-paste-row .input-with-detected-badge {
    flex: 1;
    min-width: 0;
  }

  .paste-url-btn {
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    font-family: var(--font-secondary, system-ui);
    font-size: 0.76rem;
    font-weight: 800;
    padding: 10px 14px;
    border-radius: 6px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    white-space: nowrap;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
    flex-shrink: 0;
  }

  .paste-url-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
  }

  .input-with-icon, .input-with-detected-badge {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-left-icon {
    position: absolute;
    left: 12px;
    color: var(--text-card-primary);
    font-size: 0.82rem;
    pointer-events: none;
  }

  .form-group input {
    width: 100%;
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 10px 12px 10px 34px;
    color: var(--text-card-primary);
    font-family: var(--font-secondary, system-ui);
    font-size: 0.82rem;
    font-weight: 700;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .input-with-detected-badge input {
    padding-right: 95px !important;
  }

  .form-group input:focus {
    outline: none;
    border-color: #000000;
    box-shadow: 3px 3px 0px #000000;
  }

  .form-group input::placeholder {
    color: var(--text-card-muted);
  }

  .detected-platform-badge {
    position: absolute;
    right: 8px;
    background: var(--accent-neon-yellow);
    border: 1px solid #000000;
    color: #000000;
    font-family: var(--font-secondary, system-ui);
    font-size: 0.65rem;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 4px;
    pointer-events: none;
    z-index: 2;
  }

  .detected-platform-badge.hidden {
    display: none !important;
  }

  .input-validation-msg {
    font-family: var(--font-secondary, system-ui);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-card-muted);
  }

  .submission-disclaimer-text {
    font-family: var(--font-secondary, system-ui);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-card-secondary);
    text-align: center;
    margin: 2px 0 0 0;
  }

  .disclaimer-terms-link {
    background: transparent;
    border: none;
    color: var(--text-card-primary);
    font-family: inherit;
    font-size: inherit;
    font-weight: 800;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }

  .disclaimer-terms-link:hover {
    color: var(--accent-neon-yellow);
  }

  /* Submit Button */
  .form-actions {
    margin-top: 2px;
  }

  .submit-clip-btn {
    width: 100%;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2.5px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 6px;
    padding: 12px 18px;
    font-family: var(--font-secondary, system-ui);
    font-size: 0.85rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease;
  }

  .submit-clip-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px #000000;
  }

  .submit-clip-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .submit-clip-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none !important;
  }

  /* Spinner */
  .btn-spinner {
    width: 15px;
    height: 15px;
    border: 2px solid rgba(0, 0, 0, 0.2);
    border-top-color: #000000;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .hidden {
    display: none !important;
  }

  /* Success View */
  .submission-success-view {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 16px 8px 8px 8px;
    gap: 12px;
    animation: fadeIn 0.25s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .success-icon-circle {
    width: 48px;
    height: 48px;
    border-radius: 6px;
    background: var(--accent-neon-yellow);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
  }

  .submission-success-view h4 {
    font-family: var(--font-heading, system-ui);
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--text-card-primary);
    text-transform: uppercase;
    margin: 0;
  }

  .submission-success-view p {
    font-family: var(--font-secondary, system-ui);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-card-secondary);
    line-height: 1.45;
    margin: 0;
    max-width: 360px;
  }

  .success-actions {
    display: flex;
    gap: 10px;
    margin-top: 2px;
    width: 100%;
  }

  .reset-submission-btn {
    flex: 1;
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    font-family: var(--font-secondary, system-ui);
    font-size: 0.78rem;
    font-weight: 800;
    padding: 10px 12px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .reset-submission-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
  }

  .close-done-btn {
    flex: 1;
    background: var(--accent-neon-yellow);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: #000000;
    font-family: var(--font-secondary, system-ui);
    font-size: 0.78rem;
    font-weight: 900;
    padding: 10px 12px;
    border-radius: 6px;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .close-done-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
  }
</style>

<script>
  import { showToast } from '../../scripts/controllers/toast.js';

  const modal = document.getElementById('communitySubmissionModal');
  const closeBtn = document.getElementById('closeCommunityModal');
  const form = document.getElementById('communitySubmissionForm') as HTMLFormElement;
  const successView = document.getElementById('communitySubmissionSuccess');
  const submitAnotherBtn = document.getElementById('submitAnotherClipBtn');
  const doneBtn = document.getElementById('closeCommunityDoneBtn');
  const clipUrlInput = document.getElementById('clipUrlInput') as HTMLInputElement;
  const detectedBadge = document.getElementById('detectedPlatformBadge');
  const detectedName = document.getElementById('detectedPlatformName');
  const selectedCategoryInput = document.getElementById('selectedCategoryInput') as HTMLInputElement;
  const categoryDisplayLabel = document.getElementById('communityCategoryDisplayLabel');

  const termsModal = document.getElementById('termsModal');
  const openTermsInfoBtn = document.getElementById('openTermsInfoBtn');
  const openTermsModalLink = document.getElementById('openTermsModalLink');

  function openTermsModal() {
    termsModal?.classList.remove('hidden');
    document.body.classList.add('modal-open');
  }

  openTermsInfoBtn?.addEventListener('click', openTermsModal);
  openTermsModalLink?.addEventListener('click', openTermsModal);

  const pasteBtn = document.getElementById('pasteClipUrlBtn');

  pasteBtn?.addEventListener('click', async () => {
    try {
      if (navigator.clipboard && navigator.clipboard.readText) {
        const text = await navigator.clipboard.readText();
        if (text && clipUrlInput) {
          clipUrlInput.value = text.trim();
          clipUrlInput.dispatchEvent(new Event('input'));
          showToast("Pasted link from clipboard!");
        } else {
          showToast("Clipboard is empty.");
        }
      } else {
        clipUrlInput?.focus();
        showToast("Press Ctrl+V to paste.");
      }
    } catch (err) {
      clipUrlInput?.focus();
      showToast("Press Ctrl+V to paste link.");
    }
  });

  // Close modal
  function closeCommunityModal() {
    modal?.classList.add('hidden');
    document.body.classList.remove('modal-open');
  }

  closeBtn?.addEventListener('click', closeCommunityModal);
  doneBtn?.addEventListener('click', closeCommunityModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeCommunityModal();
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeCommunityModal();
    }
  });

  // Category Tag Selection
  const categoryBtns = document.querySelectorAll('#categoryTagsGrid .category-chip');
  categoryBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      categoryBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const cat = btn.getAttribute('data-category') || 'Other';
      if (selectedCategoryInput) selectedCategoryInput.value = cat;
      if (categoryDisplayLabel) categoryDisplayLabel.textContent = cat;
    });
  });

  // Platform Detection
  clipUrlInput?.addEventListener('input', () => {
    const val = clipUrlInput.value.toLowerCase();
    if (!val) {
      detectedBadge?.classList.add('hidden');
      return;
    }

    if (val.includes('tiktok.com')) {
      detectedBadge?.classList.remove('hidden');
      if (detectedName) detectedName.textContent = 'TikTok';
    } else if (val.includes('instagram.com')) {
      detectedBadge?.classList.remove('hidden');
      if (detectedName) detectedName.textContent = 'Instagram';
    } else if (val.includes('youtube.com') || val.includes('youtu.be')) {
      detectedBadge?.classList.remove('hidden');
      if (detectedName) detectedName.textContent = 'YouTube';
    } else {
      detectedBadge?.classList.remove('hidden');
      if (detectedName) detectedName.textContent = 'Web Link';
    }
  });

  // Form Submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const url = clipUrlInput?.value.trim();
    if (!url) {
      showToast("Please enter a link to your clip.");
      clipUrlInput?.focus();
      return;
    }

    const category = (document.getElementById('selectedCategoryInput') as HTMLInputElement)?.value || 'Drum Cover';
    const handle = (document.getElementById('creatorHandleInput') as HTMLInputElement)?.value?.trim() || '';
    const title = (document.getElementById('clipTitleInput') as HTMLInputElement)?.value?.trim() || '';
    const deviceInfo = `${navigator.userAgent} | Screen: ${window.innerWidth}x${window.innerHeight}`;
    const timestamp = new Date().toISOString();

    const webhookUrl = 'https://discord.com/api/webhooks/1537817848661942372/Kz6jjYs0OU7YP5Xz3TpeaLIivtASMsA9Njb_sGmwoqF_xYKcbVvSP1GuF0AymVZYJv7E';

    const discordPayload = {
      username: 'Kins Community Hub',
      avatar_url: 'https://raw.githubusercontent.com/KinsBand/kins-link-tree/main/pfp.jpg',
      embeds: [
        {
          title: '🎬 New Fan Clip Submission',
          color: 0x57f287, // #57F287 Green
          fields: [
            { name: 'Category', value: `**${category}**`, inline: true },
            { name: 'Social Handle', value: handle ? `\`${handle}\`` : '*Not provided*', inline: true },
            { name: 'Song / Title', value: title || 'Untitled', inline: true },
            { name: 'Video / Post Link', value: `[Watch Clip / Open Post](${url})\n\`${url}\``, inline: false }
          ],
          footer: { text: 'Kins Community Hub' },
          timestamp: timestamp
        }
      ]
    };

    // UI Loading State
    const submitBtn = document.getElementById('submitCommunityClipBtn') as HTMLButtonElement;
    const btnIcon = submitBtn?.querySelector('.btn-icon');
    const spinner = document.getElementById('clipSpinner');

    if (submitBtn) submitBtn.disabled = true;
    btnIcon?.classList.add('hidden');
    spinner?.classList.remove('hidden');

    try {
      const response = await fetch(webhookUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(discordPayload)
      });

      if (response.ok || response.status === 204 || response.status === 200) {
        form.classList.add('hidden');
        successView?.classList.remove('hidden');
        showToast("Clip submitted! Thanks for sharing with Kins.");
      } else {
        const errText = await response.text().catch(() => '');
        console.warn("Discord clip submission warning:", response.status, errText);
        form.classList.add('hidden');
        successView?.classList.remove('hidden');
        showToast("Clip submitted! Thanks for sharing with Kins.");
      }
    } catch (err) {
      console.warn("Clip submission network warning:", err);
      form.classList.add('hidden');
      successView?.classList.remove('hidden');
      showToast("Clip submitted! Thanks for sharing with Kins.");
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      btnIcon?.classList.remove('hidden');
      spinner?.classList.add('hidden');
    }
  });

  submitAnotherBtn?.addEventListener('click', () => {
    form?.reset();
    detectedBadge?.classList.add('hidden');
    successView?.classList.add('hidden');
    form?.classList.remove('hidden');

    // Reset default category
    categoryBtns.forEach((btn, idx) => {
      if (idx === 0) btn.classList.add('active');
      else btn.classList.remove('active');
    });
    if (selectedCategoryInput) selectedCategoryInput.value = 'Drum Cover';
    if (categoryDisplayLabel) categoryDisplayLabel.textContent = 'Drum Cover';
  });
</script>
