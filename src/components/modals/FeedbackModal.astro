<script>
  // Interaction-gated / idle-loaded modular controller
  const scheduleIdle = (cb: () => void) => {
    if (typeof window !== 'undefined' && 'requestIdleCallback' in window) {
      (window as any).requestIdleCallback(cb, { timeout: 2000 });
    } else {
      setTimeout(cb, 1);
    }
  };
  scheduleIdle(() => {
    import('../../scripts/controllers/feedbackModal').then((m) => m.initFeedbackModal());
  });
</script>
