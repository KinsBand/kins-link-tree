    font-size: 0.72rem;
    opacity: 0.9;
  }

  .success-actions {
    display: flex;
    gap: 10px;
    margin-top: 4px;
    width: 100%;
  }

  .reset-feedback-btn {
    flex: 1;
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    font-family: var(--font-secondary, system-ui);
    font-size: 0.8rem;
    font-weight: 800;
    padding: 10px 14px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
