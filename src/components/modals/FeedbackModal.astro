---
---

<div class="modal-backdrop hidden" id="feedbackModal" role="dialog" aria-modal="true" aria-labelledby="feedbackModalTitle" data-track-container="modal:feedback">
  <div class="modal-content feedback-modal-enhanced">
    <div class="modal-header">
      <div class="modal-title-group">
        <div class="feedback-header-icon-circle">
          <i class="fa-solid fa-lightbulb" id="feedbackHeaderIcon"></i>
        </div>
        <div class="modal-title-text-wrap">
          <h3 id="feedbackModalTitle">Suggest Improvement</h3>
          <p class="modal-subtitle-text">Help us make the Kins site better</p>
        </div>
      </div>
      <button class="close-modal-btn" id="closeFeedbackModal" aria-label="Close feedback modal" data-track="feedback:close">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="modal-body feedback-modal-body">
      <!-- Form View -->
      <form id="siteFeedbackForm" class="site-feedback-form">
        
        <!-- Feedback Type Selector -->
        <div class="form-group">
          <label class="form-label">Feedback Type</label>
          <div class="type-pills-row" id="feedbackTypeRow">
            <button type="button" class="type-pill-btn active" data-type="Improvement / Idea">
              <i class="fa-solid fa-lightbulb"></i>
              <span>Improvement</span>
            </button>
            <button type="button" class="type-pill-btn" data-type="Bug / Broken Item">
              <i class="fa-solid fa-bug"></i>
              <span>Bug / Issue</span>
            </button>
            <button type="button" class="type-pill-btn" data-type="Content Fix / Typo">
              <i class="fa-solid fa-pen-nib"></i>
              <span>Content Fix</span>
            </button>
          </div>
          <input type="hidden" name="feedbackType" id="selectedFeedbackTypeInput" value="Improvement / Idea">
        </div>

        <!-- Section / Category Selection (2-Row Horizontal Scroll Grid on Mobile) -->
        <div class="form-group">
          <div class="form-label-row">
            <label class="form-label">Which section?</label>
            <span class="category-selected-label" id="categoryDisplayLabel">General Site</span>
          </div>
          <div class="category-scroll-wrapper">
            <div class="category-chips-grid" id="feedbackCategoryGrid">
              <button type="button" class="category-chip active" data-category="General Site">
                <i class="fa-solid fa-globe"></i> General Site
              </button>
              <button type="button" class="category-chip" data-category="Gig Map">
                <i class="fa-solid fa-map-location-dot"></i> Gig Map
              </button>
              <button type="button" class="category-chip" data-category="Search Covers">
                <i class="fa-solid fa-magnifying-glass"></i> Search Covers
              </button>
              <button type="button" class="category-chip" data-category="Share Menu">
                <i class="fa-solid fa-share-nodes"></i> Share Menu
              </button>
              <button type="button" class="category-chip" data-category="Socials & Streams">
                <i class="fa-solid fa-music"></i> Socials & Streams
              </button>
              <button type="button" class="category-chip" data-category="Band Members">
                <i class="fa-solid fa-users"></i> Band Members
              </button>
              <button type="button" class="category-chip" data-category="Subscribe & Contacts">
                <i class="fa-solid fa-envelope"></i> Subscribe & Contacts
              </button>
              <button type="button" class="category-chip" data-category="What Inspires Us">
                <i class="fa-solid fa-fire"></i> What Inspires Us
              </button>
              <button type="button" class="category-chip" data-category="Kins Crew Spotlight">
                <i class="fa-solid fa-clapperboard"></i> Kins Crew
              </button>
              <button type="button" class="category-chip" data-category="Audio Player">
                <i class="fa-solid fa-play"></i> Audio Player
              </button>
            </div>
            <div class="scroll-fade-edge-right"></div>
          </div>
          <input type="hidden" name="feedbackCategory" id="selectedCategoryInput" value="General Site">
        </div>

        <!-- Details Textarea with Adaptable Label & Tabular 0/1000 Counter -->
        <div class="form-group">
          <div class="form-label-row form-label-row-details">
            <label class="form-label dynamic-details-label" for="feedbackDetailsInput" id="detailsLabel">What improvement would you like to see?</label>
            <span class="char-counter" id="charCounter">0 / 1000</span>
          </div>
          <div class="textarea-wrapper">
            <textarea 
              id="feedbackDetailsInput" 
              name="details" 
              rows="3" 
              maxlength="1000" 
              placeholder="Tell us what you'd like added, changed, or refined..." 
              required
            ></textarea>
          </div>
        </div>

        <!-- Screenshot / Image Proof Field with Native Label-Triggered Skeleton Space -->
        <div class="form-group attachment-form-group">
          <div class="attachment-header-row">
            <label class="form-label" for="feedbackScreenshotInput">
              Screenshot / Proof <span class="optional-tag">(Optional)</span>
            </label>
            <span class="attachment-size-badge" id="attachmentSizeHint">Max 5MB</span>
          </div>

          <!-- Hidden Native File Input -->
          <input 
            type="file" 
            id="feedbackScreenshotInput" 
            name="screenshot" 
            accept="image/png, image/jpeg, image/webp, image/gif" 
            class="file-input-hidden" 
          />

          <!-- Native Label Dropzone (Clicking anywhere reliably opens file selector on all platforms) -->
          <label 
            for="feedbackScreenshotInput" 
            class="image-upload-skeleton" 
            id="imageUploadSkeleton" 
            tabindex="0" 
            role="button" 
            aria-label="Attach screenshot or image proof"
          >
            <div class="upload-skeleton-left">
              <div class="upload-icon-circle">
                <i class="fa-solid fa-camera"></i>
              </div>
              <div class="upload-text-wrap">
                <span class="upload-title">Attach Screenshot or Visual Proof</span>
                <span class="upload-subtext">Click to browse or drop image (PNG, JPG, WebP)</span>
              </div>
            </div>
            <div class="browse-btn-pill">
              <i class="fa-solid fa-folder-open"></i> Browse
            </div>
          </label>

          <!-- Image Preview Box (Takes the exact skeleton space upon upload, keeping thumbnail small) -->
          <div class="image-preview-container hidden" id="imagePreviewContainer">
            <div class="preview-left-box">
              <div class="preview-thumb-wrap">
                <img id="feedbackPreviewImg" src="" alt="Screenshot preview" />
              </div>
              <div class="preview-meta-wrap">
                <span class="preview-filename-text" id="previewFileName">screenshot.png</span>
                <div class="preview-badge-row">
                  <span class="attached-success-badge"><i class="fa-solid fa-circle-check"></i> Attached</span>
                  <span class="preview-filesize-text" id="previewFileSize">1.2 MB</span>
                </div>
              </div>
            </div>
            <button type="button" class="remove-image-btn" id="removeImageBtn" title="Remove screenshot" aria-label="Remove screenshot">
              <i class="fa-solid fa-trash-can"></i>
              <span>Remove</span>
            </button>
          </div>
        </div>

        <!-- Optional Contact / Handle -->
        <div class="form-group">
          <label class="form-label" for="feedbackContactInput">
            Your Discord, social, or email <span class="optional-tag">(Optional)</span>
          </label>
          <div class="input-with-icon">
            <i class="fa-solid fa-at input-left-icon"></i>
            <input 
              type="text" 
              id="feedbackContactInput" 
              name="contact" 
              placeholder="e.g. @username or email for follow-up"
              autocomplete="off"
            >
          </div>
        </div>

        <!-- Submit Button -->
        <div class="form-actions">
          <button type="submit" class="submit-feedback-btn" id="submitFeedbackBtn" data-track="feedback:submit">
            <span class="btn-text">Send Improvement</span>
            <i class="fa-solid fa-paper-plane btn-icon"></i>
            <div class="btn-spinner hidden" id="feedbackSpinner"></div>
          </button>
        </div>
      </form>

      <!-- Success View -->
      <div class="feedback-success-view hidden" id="feedbackSuccessView">
        <div class="success-icon-circle">
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <h4>Thanks for the feedback!</h4>
        <p>Your note has been sent directly to our Discord team.</p>
        
        <div class="discord-cta-wrap">
          <a 
            href="https://discord.gg/Yu2npHUrH" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="discord-cta-btn" 
            id="feedbackDiscordCtaBtn"
            data-track="feedback:discord_join"
          >
            <i class="fa-brands fa-discord"></i>
            <span>Join our Discord</span>
            <i class="fa-solid fa-arrow-up-right-from-square discord-launch-icon"></i>
          </a>
        </div>

        <div class="success-actions">
          <button type="button" class="reset-feedback-btn" id="submitAnotherFeedbackBtn" data-track="feedback:submit_another">
            <i class="fa-solid fa-rotate-left"></i> Suggest Another
          </button>
          <button type="button" class="close-done-btn" id="closeFeedbackDoneBtn" data-track="feedback:done">
            Done
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    box-sizing: border-box;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.22s;
  }

  .modal-backdrop.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .feedback-modal-enhanced {
    width: 100%;
    max-width: 490px;
    max-height: 92vh;
    overflow-y: auto;
    background: var(--surface-card-light);
    border: 3px solid #000000;
    border-radius: 10px;
    box-shadow: 6px 6px 0px #000000;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    scrollbar-width: thin;
    scrollbar-color: var(--accent-neon-yellow) transparent;
    animation: modalPopIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .feedback-modal-enhanced::-webkit-scrollbar {
    width: 5px;
  }

  .feedback-modal-enhanced::-webkit-scrollbar-track {
    background: transparent;
  }

  .feedback-modal-enhanced::-webkit-scrollbar-thumb {
    background: var(--accent-neon-yellow);
    border-radius: 4px;
  }

  @keyframes modalPopIn {
    from {
      transform: scale(0.96) translateY(6px);
      opacity: 0;
    }
    to {
      transform: scale(1) translateY(0);
      opacity: 1;
    }
  }

  /* Adaptable Header & Title */
  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    gap: 10px;
    border-bottom: 2px solid #000000;
    position: sticky;
    top: 0;
    background: var(--surface-card-light);
    z-index: 10;
  }

  .modal-title-group {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex: 1;
  }

  .feedback-header-icon-circle {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: var(--accent-neon-yellow);
    border: 2px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .modal-title-text-wrap {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .modal-title-group h3 {
    margin: 0;
    font-family: var(--font-heading, system-ui);
    font-size: clamp(0.95rem, 3.8vw, 1.15rem);
    font-weight: 900;
    color: var(--text-card-primary);
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .modal-subtitle-text {
    margin: 2px 0 0 0;
    font-family: var(--font-secondary, system-ui);
    font-size: clamp(0.68rem, 2.6vw, 0.74rem);
    font-weight: 600;
    color: var(--text-card-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
  }

  .close-modal-btn {
    background: var(--surface-input);
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    width: 32px;
    height: 32px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    cursor: pointer;
    flex-shrink: 0;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .close-modal-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
  }

  .feedback-modal-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .site-feedback-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-label-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .form-label-row-details {
    align-items: baseline;
  }

  .form-label {
    font-family: var(--font-secondary, system-ui);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-card-primary);
  }

  .dynamic-details-label {
    flex: 1;
    min-width: 0;
    line-height: 1.35;
    font-size: clamp(0.72rem, 2.7vw, 0.77rem);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 700;
    color: var(--text-card-primary);
  }

  .category-selected-label {
    font-family: var(--font-secondary, system-ui);
    font-size: 0.72rem;
    font-weight: 800;
    color: #000000;
    background: var(--accent-neon-yellow);
    border: 1px solid #000000;
    padding: 1px 6px;
    border-radius: 3px;
    white-space: nowrap;
  }

  .optional-tag {
    font-weight: normal;
    text-transform: none;
    color: var(--text-card-muted);
    font-size: 0.7rem;
  }

  /* Compact & Balanced Feedback Type Cards */
  .type-pills-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .type-pill-btn {
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    padding: 8px 6px;
    min-height: 48px;
    border-radius: 6px;
    font-family: var(--font-secondary, system-ui);
    font-size: clamp(0.68rem, 2.5vw, 0.74rem);
    font-weight: 800;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease;
    text-align: center;
    box-sizing: border-box;
  }

  .type-pill-btn span {
    color: var(--text-card-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
    line-height: 1.1;
  }

  .type-pill-btn i {
    color: var(--text-card-primary);
    font-size: 0.9rem;
    line-height: 1;
  }

  .type-pill-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .type-pill-btn.active {
    background: var(--accent-neon-yellow);
    border-color: #000000;
    color: #000000;
    font-weight: 900;
  }

  .type-pill-btn.active span,
  .type-pill-btn.active i {
    color: #000000;
  }

  .type-pill-btn[data-type="Bug / Broken Item"].active {
    background: #fca5a5;
    color: #000000;
  }

  .type-pill-btn[data-type="Bug / Broken Item"].active span,
  .type-pill-btn[data-type="Bug / Broken Item"].active i {
    color: #000000;
  }

  .type-pill-btn[data-type="Content Fix / Typo"].active {
    background: #93c5fd;
    color: #000000;
  }

  .type-pill-btn[data-type="Content Fix / Typo"].active span,
  .type-pill-btn[data-type="Content Fix / Typo"].active i {
    color: #000000;
  }

  /* 2-Row Horizontal Scroll Grid for Sections */
  .category-scroll-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .category-chips-grid {
    display: grid;
    grid-template-rows: repeat(2, 32px);
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    gap: 7px 7px;
    overflow-x: auto;
    padding: 2px 20px 4px 2px;
    scrollbar-width: thin;
    scrollbar-color: var(--accent-neon-yellow) transparent;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
  }

  .category-chips-grid::-webkit-scrollbar {
    height: 4px;
  }

  .category-chips-grid::-webkit-scrollbar-thumb {
    background: var(--accent-neon-yellow);
    border-radius: 4px;
  }

  .scroll-fade-edge-right {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 4px;
    width: 28px;
    background: linear-gradient(90deg, transparent, var(--surface-card-light));
    pointer-events: none;
  }

  .category-chip {
    background: var(--surface-input);
    border: 1.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    color: var(--text-card-primary);
    padding: 0 12px;
    height: 32px;
    border-radius: 6px;
    font-family: var(--font-secondary, system-ui);
    font-size: 0.74rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
    white-space: nowrap;
    flex-shrink: 0;
    box-sizing: border-box;
    scroll-snap-align: start;
  }

  .category-chip i {
    font-size: 0.74rem;
    color: var(--text-card-primary);
  }

  .category-chip:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translateY(-1px);
  }

  .category-chip:hover i {
    color: #000000;
  }

  .category-chip.active {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
    font-weight: 900;
  }

  .category-chip.active i {
    color: #000000;
  }

  /* Textarea & Inputs */
  .textarea-wrapper textarea {
    width: 100%;
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 10px 12px;
    color: var(--text-card-primary);
    font-family: var(--font-secondary, system-ui);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.45;
    resize: vertical;
    box-sizing: border-box;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .textarea-wrapper textarea:focus {
    outline: none;
    border-color: #000000;
    box-shadow: 3px 3px 0px #000000;
  }

  .textarea-wrapper textarea::placeholder {
    color: var(--text-card-muted);
  }

  .char-counter {
    font-family: var(--font-secondary, system-ui);
    font-size: clamp(0.66rem, 2.3vw, 0.72rem);
    color: var(--text-card-muted);
    white-space: nowrap;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  /* ===================================================
     SCREENSHOT / IMAGE ATTACHMENT SECTION
     =================================================== */
  .attachment-form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: relative;
    width: 100%;
  }

  .attachment-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .attachment-size-badge {
    font-family: var(--font-secondary, system-ui);
    font-size: 0.68rem;
    font-weight: 800;
    color: #000000;
    background: var(--accent-neon-yellow);
    border: 1px solid #000000;
    padding: 1px 6px;
    border-radius: 4px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .file-input-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    opacity: 0;
    pointer-events: none;
  }

  /* Skeleton Dropzone Card (Semantic Label Element) */
  .image-upload-skeleton {
    width: 100%;
    min-height: 62px;
    background: var(--surface-input);
    border: 2px dashed #000000;
    border-radius: 6px;
    box-shadow: 2px 2px 0px #000000;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    cursor: pointer;
    box-sizing: border-box;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease;
    user-select: none;
    outline: none;
    position: relative;
    overflow: hidden;
  }

  .image-upload-skeleton:hover,
  .image-upload-skeleton:focus-visible {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .image-upload-skeleton.drag-over {
    border-color: #000000;
    border-style: solid;
    background: var(--accent-neon-yellow);
    box-shadow: 3px 3px 0px #000000;
    transform: scale(1.01);
  }

  .upload-skeleton-left {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex: 1;
    pointer-events: none;
  }

  .upload-icon-circle {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: var(--accent-neon-yellow);
    border: 1.5px solid #000000;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .upload-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
    text-align: left;
  }

  .upload-title {
    font-family: var(--font-secondary, system-ui);
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--text-card-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: -0.01em;
  }

  .upload-subtext {
