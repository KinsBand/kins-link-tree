---
import { generalEmail } from '../../settings/contact.config';
---

<div class="modal-backdrop hidden" id="privacyModal" role="dialog" aria-modal="true" aria-label="Privacy Policy" data-track-container="modal:privacy">
  <div class="modal-content legal-modal-content">
    <div class="modal-header">
      <div class="modal-title-group">
        <div class="header-icon-badge">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <div class="header-text">
          <span class="header-badge-tag">LEGAL</span>
          <h3>Privacy Policy</h3>
        </div>
      </div>
      <button class="close-modal-btn" id="closePrivacyModal" aria-label="Close Privacy Policy" data-track="privacy:close">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="legal-modal-body">
      <div class="legal-highlight-card">
        <p class="legal-last-updated"><i class="fa-solid fa-clock"></i> <strong>Last Updated:</strong> August 2026</p>
        <p class="legal-intro">
          <strong>Kins</strong> ("we", "our", or "us") respects your privacy. This policy outlines how we handle personal information collected through our official link-in-bio page and website.
        </p>
      </div>

      <div class="legal-section">
        <h4>1. Information We Collect</h4>
        <div class="legal-bullet-box">
          <div class="bullet-item">
            <span class="bullet-tag">EMAIL</span>
            <p>When you subscribe to our mailing list, we collect your email address to send updates, release announcements, behind-the-scenes content, and show/tour dates.</p>
          </div>
          <div class="bullet-item">
            <span class="bullet-tag">SUBMISSIONS</span>
            <p>If you submit a fan clip, video link, or message, we collect the link and public handle you provide.</p>
          </div>
        </div>
      </div>

      <div class="legal-section">
        <h4>2. How We Use Your Data</h4>
        <p class="legal-text">We only use your email address to send official band updates. We do not sell, rent, or trade your personal information to third parties.</p>
      </div>

      <div class="legal-section">
        <h4>3. Service Providers</h4>
        <p class="legal-text">We use Substack (and trusted email delivery infrastructure) to deliver official newsletters and updates. These services process your data solely on our behalf and in compliance with privacy laws.</p>
      </div>

      <div class="legal-section">
        <h4>4. Unsubscribing</h4>
        <p class="legal-text">You can opt out of emails at any time by clicking the "Unsubscribe" link at the bottom of any update, or by contacting us directly at <a href={`mailto:${generalEmail}`} class="legal-email-link">{generalEmail}</a>.</p>
      </div>

      <div class="legal-section">
        <h4>5. Contact Us</h4>
        <p class="legal-text">For privacy inquiries or data requests, reach out to us at:</p>
        <div class="contact-pill-box">
          <i class="fa-solid fa-envelope"></i>
          <a href={`mailto:${generalEmail}`} class="legal-email-link">{generalEmail}</a>
        </div>
      </div>
    </div>

    <div class="legal-modal-footer">
      <button type="button" class="close-legal-btn" id="closePrivacyFooterBtn" data-track="privacy:footer_close">Close Policy</button>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.22s;
  }

  .modal-backdrop.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .modal-backdrop.is-closing {
    opacity: 0;
    pointer-events: none;
  }

  .legal-modal-content {
    background: #141416;
    border: 3px solid #000000;
    border-radius: 8px;
    box-shadow: 6px 6px 0px #000000;
    width: 100%;
    max-width: 540px;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: legalModalPopIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .legal-modal-content.is-closing {
    animation: legalModalPopOut 0.18s ease forwards;
  }

  @keyframes legalModalPopIn {
    from {
      transform: scale(0.96) translateY(6px);
      opacity: 0;
    }
    to {
      transform: scale(1) translateY(0);
      opacity: 1;
    }
  }

  @keyframes legalModalPopOut {
    from {
      transform: scale(1) translateY(0);
      opacity: 1;
    }
    to {
      transform: scale(0.96) translateY(6px);
      opacity: 0;
    }
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    background: #1c1c20;
    border-bottom: 3px solid #000000;
  }

  .modal-title-group {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    min-width: 0;
  }

  .header-icon-badge {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .header-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .header-badge-tag {
    font-family: var(--font-secondary);
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    color: var(--accent-neon-yellow);
    text-transform: uppercase;
  }

  .modal-title-group h3 {
    font-family: var(--font-heading);
    font-size: clamp(0.92rem, 3.5vw, 1.05rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
  }

  .close-modal-btn {
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    width: 36px;
    height: 36px;
    min-width: 36px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.95rem;
    flex-shrink: 0;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .close-modal-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .legal-modal-body {
    padding: 16px 18px;
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: #a1a1aa;
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .legal-highlight-card {
    background: #1c1c20;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .legal-last-updated {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--accent-neon-yellow);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .legal-intro {
    color: #ffffff;
    margin: 0;
    font-weight: 600;
  }

  .legal-section {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .legal-section h4 {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 900;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin: 0;
  }

  .legal-text {
    margin: 0;
    color: #d4d4d8;
  }

  .legal-bullet-box {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bullet-item {
    background: #1c1c20;
    border: 1.5px solid #000000;
    border-radius: 6px;
    padding: 8px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .bullet-tag {
    align-self: flex-start;
    font-size: 0.6rem;
    font-weight: 900;
    color: #000000;
    background: var(--accent-neon-yellow);
    padding: 1px 5px;
    border-radius: 3px;
    letter-spacing: 0.06em;
  }

  .bullet-item p {
    margin: 0;
    color: #d4d4d8;
    font-size: 0.8rem;
  }

  .contact-pill-box {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1c1c20;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    padding: 8px 14px;
    border-radius: 6px;
    width: fit-content;
    color: var(--accent-neon-yellow);
    margin-top: 4px;
  }

  .legal-email-link {
    color: var(--accent-neon-yellow);
    font-weight: 800;
    text-decoration: underline;
    transition: color 0.16s ease;
  }

  .legal-email-link:hover {
    color: #ffffff;
  }

  .legal-modal-footer {
    padding: 12px 16px;
    background: #1c1c20;
    border-top: 3px solid #000000;
    display: flex;
    justify-content: flex-end;
  }

  .close-legal-btn {
    background: var(--accent-neon-yellow);
    color: #000000;
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 9px 20px;
    border-radius: 6px;
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
  }

  .close-legal-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #ffffff;
  }
</style>

<script>
  const privacyModal = document.getElementById('privacyModal');
  const closePrivacyModal = document.getElementById('closePrivacyModal');
  const closePrivacyFooterBtn = document.getElementById('closePrivacyFooterBtn');

  const CLOSE_ANIM_MS = 190;
  let closeTimer: ReturnType<typeof setTimeout> | null = null;
  const prefersReducedMotion =
    typeof window.matchMedia === 'function' &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function isOtherModalOpen(): boolean {
    const ids = ['feedbackModal', 'termsModal', 'communitySubmissionModal'];
    return ids.some((id) => {
      const el = document.getElementById(id);
      return !!el && !el.classList.contains('hidden');
    });
  }

  function finishClose() {
    closeTimer = null;
    if (!privacyModal) return;
    privacyModal.classList.remove('is-closing');
    privacyModal.classList.add('hidden');

    // Only unlock page scrolling if no other modal took over while we were closing
    if (!isOtherModalOpen()) {
      document.body.classList.remove('modal-open');
      document.documentElement.classList.remove('modal-open');
    }
  }

  function hideModal() {
    if (!privacyModal) return;
    if (privacyModal.classList.contains('hidden') || privacyModal.classList.contains('is-closing')) return;

    if (prefersReducedMotion) {
      finishClose();
      return;
    }

    privacyModal.classList.add('is-closing');
    closeTimer = setTimeout(finishClose, CLOSE_ANIM_MS);
  }

  function openPrivacyModal() {
    if (!privacyModal) return;
    if (closeTimer) {
      clearTimeout(closeTimer);
      closeTimer = null;
    }
    privacyModal.classList.remove('is-closing');
    privacyModal.classList.remove('hidden');
    document.body.classList.add('modal-open');
  }

  (window as any).openPrivacyModal = openPrivacyModal;

  closePrivacyModal?.addEventListener('click', hideModal);
  closePrivacyFooterBtn?.addEventListener('click', hideModal);
  privacyModal?.addEventListener('click', (e) => {
    if (e.target === privacyModal) hideModal();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && privacyModal && !privacyModal.classList.contains('hidden')) {
      e.stopPropagation();
      hideModal();
    }
  });
</script>
