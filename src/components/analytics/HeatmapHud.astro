  .hud-refresh-icon-btn:hover {
    color: #ffffff !important;
    background: #242430 !important;
    border-color: #f2fd43 !important;
  }
</style>

<script>
  import { isUserAdmin, authenticateAdmin } from '../../lib/adminAuth';
  import { fetchHeatmapClicks, fetchSectionAttention, type ClickRecord } from '../../lib/heatmapTracker';

  let isHudOpen = false;
  let activeMode: 'density' | 'points' | 'hitboxes' | 'attention' | 'friction' = 'density';
  let activeTimeRange: '24h' | '7d' | '30d' | 'all' = '24h';
  let activeDeviceFilter: 'all' | 'mobile' | 'desktop' = 'desktop';
  let activeScope = 'auto';
  let isSnapMode = true;
  let spotRadius = 35;
  let cachedClicks: ClickRecord[] = [];

  const modal = document.getElementById('admin-passcode-modal');
  const hudContainer = document.getElementById('dev-heatmap-hud');
  const toolbar = document.getElementById('dev-heatmap-toolbar');
  const dragHandle = document.getElementById('toolbar-drag-handle');
  const canvas = document.getElementById('heatmap-canvas') as HTMLCanvasElement | null;
  const notchBanner = document.getElementById('hud-mobile-notch-banner');
  const form = document.getElementById('admin-passcode-form') as HTMLFormElement | null;
  const input = document.getElementById('admin-passcode-input') as HTMLInputElement | null;
  const errorMsg = document.getElementById('passcode-error-msg');
  const closePasscodeBtn = document.getElementById('close-passcode-btn');
  const closeHeatmapBtn = document.getElementById('close-heatmap-btn');
  const minimizeBtn = document.getElementById('minimize-heatmap-btn');
  const toolbarBody = document.getElementById('hud-toolbar-body');
  const refreshBtn = document.getElementById('refresh-heatmap-btn');
  const exportSnapshotBtn = document.getElementById('export-snapshot-btn');
  const clickCountEl = document.getElementById('heatmap-click-count');
  const radiusSlider = document.getElementById('heatmap-radius') as HTMLInputElement | null;
  const radiusValEl = document.getElementById('radius-val');
  const opacitySlider = document.getElementById('heatmap-opacity') as HTMLInputElement | null;
  const opacityValEl = document.getElementById('opacity-val');
  const radiusSliderSection = document.getElementById('radius-slider-section');
  const scopeSelect = document.getElementById('hud-scope-select') as HTMLSelectElement | null;
  const snapToggle = document.getElementById('hud-snap-mode-toggle') as HTMLInputElement | null;
  const activeModeLabel = document.getElementById('active-mode-label');
  const activeAreaLabel = document.getElementById('active-area-label');
  const inspectorCard = document.getElementById('hud-element-inspector');
  const inspectorTag = document.getElementById('inspector-tag');
  const inspectorTitle = document.getElementById('inspector-title');
  const inspectorClicks = document.getElementById('inspector-clicks');
  const inspectorScope = document.getElementById('inspector-scope');
  const inspectorAcc = document.getElementById('inspector-acc');
  const inspectorDev = document.getElementById('inspector-dev');

  // Detect currently active open menu / drawer / modal
  function getCurrentlyActiveVisibleScope(): string {
    const covers = document.getElementById('coversSearchOverlay');
    if (covers && (covers.classList.contains('active') || (covers.offsetWidth > 0 && getComputedStyle(covers).opacity === '1'))) {
      return 'modal:covers_search';
    }

    const gigMap = document.getElementById('gigMapModal') || document.getElementById('gigMapSheetModal');
    if (gigMap && !gigMap.classList.contains('hidden') && gigMap.style.display !== 'none' && gigMap.offsetWidth > 0) {
      return 'modal:gig_map';
    }

    const streamDrawer = document.getElementById('streamDrawerPanel');
    if (streamDrawer && !streamDrawer.classList.contains('hidden') && streamDrawer.style.display !== 'none' && streamDrawer.offsetHeight > 0) {
      return 'drawer:stream_platforms';
    }

    const shareModal = document.getElementById('shareModal');
    if (shareModal && !shareModal.classList.contains('hidden') && shareModal.style.display !== 'none' && shareModal.offsetWidth > 0) {
      return 'modal:share';
    }

    const videoModal = document.getElementById('coverVideoModal');
    if (videoModal && !videoModal.classList.contains('hidden') && videoModal.style.display !== 'none' && videoModal.offsetWidth > 0) {
      return 'modal:cover_video';
    }

    const feedbackModal = document.getElementById('feedbackModal');
    if (feedbackModal && !feedbackModal.classList.contains('hidden') && feedbackModal.style.display !== 'none' && feedbackModal.offsetWidth > 0) {
      return 'modal:feedback';
    }

    const commModal = document.getElementById('communitySubmissionModal');
    if (commModal && !commModal.classList.contains('hidden') && commModal.style.display !== 'none' && commModal.offsetWidth > 0) {
      return 'modal:community';
    }

    const privacyModal = document.getElementById('privacyModal');
    if (privacyModal && !privacyModal.classList.contains('hidden') && privacyModal.style.display !== 'none' && privacyModal.offsetWidth > 0) {
      return 'modal:privacy';
    }

    const termsModal = document.getElementById('termsModal');
    if (termsModal && !termsModal.classList.contains('hidden') && termsModal.style.display !== 'none' && termsModal.offsetWidth > 0) {
      return 'modal:terms';
    }

    if (window.location.pathname.includes('/epk') || document.getElementById('epkDeck')) {
      return 'epk:portal';
    }

    return 'main_feed';
  }

  // Draggable Toolbar Controller
  function initDraggableToolbar() {
    if (!toolbar || !dragHandle) return;

    try {
      const savedPos = localStorage.getItem('kins_hud_position');
      if (savedPos) {
        const { x, y } = JSON.parse(savedPos);
        if (typeof x === 'number' && typeof y === 'number') {
          const clampedX = Math.max(10, Math.min(window.innerWidth - 340, x));
          const clampedY = Math.max(10, Math.min(window.innerHeight - 400, y));
          toolbar.style.left = `${clampedX}px`;
          toolbar.style.top = `${clampedY}px`;
          toolbar.style.right = 'auto';
          toolbar.style.bottom = 'auto';
        }
      }
    } catch (e) {}

    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let initialLeft = 0;
    let initialTop = 0;

    function onPointerDown(e: PointerEvent) {
      const target = e.target as HTMLElement | null;
      if (target && (target.closest('#close-heatmap-btn') || target.closest('#minimize-heatmap-btn') || target.closest('#heatmap-click-count'))) return;

      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;

      const rect = toolbar!.getBoundingClientRect();
      initialLeft = rect.left;
      initialTop = rect.top;

      toolbar!.style.right = 'auto';
      toolbar!.style.bottom = 'auto';
      toolbar!.style.left = `${initialLeft}px`;
      toolbar!.style.top = `${initialTop}px`;

      dragHandle!.setPointerCapture(e.pointerId);
      dragHandle!.style.cursor = 'grabbing';
      e.preventDefault();
    }

    function onPointerMove(e: PointerEvent) {
      if (!isDragging || !toolbar) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;

      let newLeft = initialLeft + dx;
      let newTop = initialTop + dy;

      const maxLeft = window.innerWidth - toolbar.offsetWidth - 10;
      const maxTop = window.innerHeight - toolbar.offsetHeight - 10;

      newLeft = Math.max(10, Math.min(maxLeft, newLeft));
      newTop = Math.max(10, Math.min(maxTop, newTop));

      toolbar.style.left = `${newLeft}px`;
      toolbar.style.top = `${newTop}px`;
    }

    function onPointerUp(e: PointerEvent) {
      if (!isDragging) return;
      isDragging = false;
      dragHandle!.releasePointerCapture(e.pointerId);
      dragHandle!.style.cursor = 'grab';

      try {
        const rect = toolbar!.getBoundingClientRect();
        localStorage.setItem('kins_hud_position', JSON.stringify({ x: rect.left, y: rect.top }));
      } catch (e) {}
    }

    dragHandle.addEventListener('pointerdown', onPointerDown);
    dragHandle.addEventListener('pointermove', onPointerMove);
    dragHandle.addEventListener('pointerup', onPointerUp);
    dragHandle.addEventListener('pointercancel', onPointerUp);

    toolbar.addEventListener('pointerdown', (e) => e.stopPropagation());
    toolbar.addEventListener('click', (e) => e.stopPropagation());
  }

  initDraggableToolbar();

  function showModal() {
    if (!modal) return;
    modal.classList.remove('hidden');
    if (input) input.focus();
  }

  function hideModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    if (errorMsg) errorMsg.classList.add('hidden');
    if (input) input.value = '';
  }

  function toggleHud() {
    if (!isUserAdmin()) {
      showModal();
      return;
    }

    isHudOpen = !isHudOpen;
    if (isHudOpen) {
      if (hudContainer) hudContainer.classList.remove('hidden');
      applyDeviceMode(activeDeviceFilter);
      loadAndRenderHeatmap();
    } else {
      if (hudContainer) hudContainer.classList.add('hidden');
      if (inspectorCard) inspectorCard.classList.add('hidden');
      document.body.classList.remove('hud-mobile-emulator-mode');
      if (notchBanner) notchBanner.classList.add('hidden');
    }
  }

  function applyDeviceMode(device: 'all' | 'mobile' | 'desktop') {
    if (!isHudOpen) return;
    if (device === 'mobile' && window.innerWidth >= 768) {
      document.body.classList.add('hud-mobile-emulator-mode');
      if (notchBanner) notchBanner.classList.remove('hidden');
    } else {
      document.body.classList.remove('hud-mobile-emulator-mode');
      if (notchBanner) notchBanner.classList.add('hidden');
    }
  }

  // Keyboard shortcut listener: Ctrl + Shift + H / Cmd + Shift + H
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'H' || e.key === 'h')) {
      e.preventDefault();
      toggleHud();
    }
  });

  if (typeof window !== 'undefined' && window.location.search.includes('dev=heatmap')) {
    setTimeout(toggleHud, 400);
  }

  if (closePasscodeBtn) closePasscodeBtn.addEventListener('click', hideModal);
  if (closeHeatmapBtn) closeHeatmapBtn.addEventListener('click', toggleHud);

  // Minimize / Expand Toolbar Logic
  function setToolbarMinimized(isMin: boolean) {
    if (!toolbar || !toolbarBody || !minimizeBtn) return;
    if (isMin) {
      toolbar.classList.add('minimized');
      toolbarBody.classList.add('hidden');
      minimizeBtn.textContent = '+';
      minimizeBtn.title = 'Expand Toolbar';
      minimizeBtn.setAttribute('aria-label', 'Expand toolbar');
    } else {
      toolbar.classList.remove('minimized');
      toolbarBody.classList.remove('hidden');
      minimizeBtn.textContent = '−';
      minimizeBtn.title = 'Minimize Toolbar';
      minimizeBtn.setAttribute('aria-label', 'Minimize toolbar');
    }
    try {
      localStorage.setItem('kins_hud_minimized', isMin ? 'true' : 'false');
    } catch (e) {}
  }

  if (minimizeBtn) {
    minimizeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isCurrentlyMin = toolbar?.classList.contains('minimized');
      setToolbarMinimized(!isCurrentlyMin);
    });
  }

  // Restore saved minimize state
  try {
    if (localStorage.getItem('kins_hud_minimized') === 'true') {
      setToolbarMinimized(true);
    }
  } catch (e) {}

  if (form && input) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const code = input.value;
      if (authenticateAdmin(code)) {
        hideModal();
        isHudOpen = true;
        if (hudContainer) hudContainer.classList.remove('hidden');
        applyDeviceMode(activeDeviceFilter);
        loadAndRenderHeatmap();
      } else {
        if (errorMsg) errorMsg.classList.remove('hidden');
        input.focus();
      }
    });
  }

  // Mode Switcher Listeners
  const modeLabels: Record<string, string> = {
    density: '🔥 Thermal Density',
    points: '🎯 Radar Dots',
    hitboxes: '📦 Hitbox Heat Boxes',
    attention: '📊 Dwell Time Map',
    friction: '⚠️ Rage & Dead Clicks'
  };

  const modeBtns = document.querySelectorAll('#hud-mode-group .hud-mode-btn');
  modeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      modeBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeMode = btn.getAttribute('data-mode') as any || 'density';
      if (activeModeLabel) activeModeLabel.textContent = modeLabels[activeMode] || '🔥 Thermal Density';
      if (radiusSliderSection) {
        radiusSliderSection.style.display = (activeMode === 'density' || activeMode === 'friction') ? 'flex' : 'none';
      }
      renderCanvas();
    });
  });

  // Scope & Filter Listeners
  if (scopeSelect) {
    scopeSelect.addEventListener('change', () => {
      activeScope = scopeSelect.value;
      loadAndRenderHeatmap();
    });
  }

  if (snapToggle) {
    snapToggle.addEventListener('change', () => {
      isSnapMode = snapToggle.checked;
      renderCanvas();
    });
  }

  const timeBtns = document.querySelectorAll('#time-filter-group .hud-filter-btn');
  timeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      timeBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeTimeRange = btn.getAttribute('data-range') as any || '24h';
      loadAndRenderHeatmap();
    });
  });

  const deviceBtns = document.querySelectorAll('#device-filter-group .hud-device-btn');
  deviceBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      deviceBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeDeviceFilter = btn.getAttribute('data-device') as any || 'all';
      applyDeviceMode(activeDeviceFilter);
      loadAndRenderHeatmap();
    });
  });

  if (radiusSlider && radiusValEl) {
    radiusSlider.addEventListener('input', (e) => {
      spotRadius = Number((e.target as HTMLInputElement).value);
      radiusValEl.textContent = `${spotRadius}px`;
      renderCanvas();
    });
  }

  if (opacitySlider && opacityValEl) {
    opacitySlider.addEventListener('input', (e) => {
      const opacityVal = Number((e.target as HTMLInputElement).value);
      opacityValEl.textContent = `${opacityVal}%`;
      if (canvas) {
        canvas.style.opacity = (opacityVal / 100).toString();
      }
    });
  }

  if (refreshBtn) {
    refreshBtn.addEventListener('click', () => {
      refreshBtn.querySelector('i')?.classList.add('fa-spin');
      loadAndRenderHeatmap().then(() => {
        setTimeout(() => refreshBtn.querySelector('i')?.classList.remove('fa-spin'), 400);
      });
    });
  }

  // 1-Click PNG Snapshot Exporter
  if (exportSnapshotBtn && canvas) {
    exportSnapshotBtn.addEventListener('click', () => {
      try {
        const link = document.createElement('a');
        link.download = `kins_heatmap_${activeMode}_${new Date().toISOString().split('T')[0]}.png`;
        link.href = canvas.toDataURL('image/png');
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      } catch (e) {
        alert('Could not export canvas image.');
      }
    });
  }

  // Element Snapping Hover Inspector
  document.addEventListener('mousemove', (e) => {
    if (!isHudOpen || !isSnapMode || !inspectorCard) return;
    const target = e.target as HTMLElement | null;
    if (!target || !target.closest || target.closest('#dev-heatmap-hud') || target.closest('#admin-passcode-modal')) {
      inspectorCard.classList.add('hidden');
      return;
    }

    const interactiveEl = target.closest('a, button, [role="button"], .music-card, .cover-result-card, .filter-pill-btn, input, .nav-brutal-btn, .header-search-pill-btn') as HTMLElement | null;
    if (interactiveEl && interactiveEl.tagName) {
      const elId = interactiveEl.id || '';
      const tagLower = (interactiveEl.tagName || '').toLowerCase();
      
      const matchingClicks = (cachedClicks || []).filter(c => {
        if (!c) return false;
        if (elId && c.target_id && c.target_id === elId) return true;
        if (typeof c.target_selector === 'string' && tagLower && c.target_selector.toLowerCase().includes(tagLower)) return true;
        return false;
      });

      const mobClicks = matchingClicks.filter(c => c.is_mobile || c.pointer_type === 'touch').length;
      const deskClicks = matchingClicks.length - mobClicks;

      if (inspectorTag) inspectorTag.textContent = tagLower.toUpperCase();
      if (inspectorTitle) inspectorTitle.textContent = elId ? `#${elId}` : tagLower;
      if (inspectorClicks) inspectorClicks.textContent = `${matchingClicks.length}`;
      if (inspectorScope) inspectorScope.textContent = (interactiveEl.closest && interactiveEl.closest('#streamDrawerPanel')) ? 'drawer' : (interactiveEl.closest && interactiveEl.closest('.gig-map-sheet')) ? 'gig_map' : 'page';
      if (inspectorAcc) inspectorAcc.textContent = matchingClicks.some(c => c.is_rage_click) ? '⚠️ Rage Click' : '98% Center';
      if (inspectorDev) inspectorDev.textContent = `${mobClicks}📱 / ${deskClicks}💻`;

      inspectorCard.style.left = `${e.clientX}px`;
      inspectorCard.style.top = `${e.clientY}px`;
      inspectorCard.classList.remove('hidden');
    } else {
      inspectorCard.classList.add('hidden');
    }
  }, { passive: true });

  async function loadAndRenderHeatmap() {
    cachedClicks = await fetchHeatmapClicks({
      timeRange: activeTimeRange,
      deviceFilter: activeDeviceFilter,
      containerScope: activeScope
    });

    if (clickCountEl) {
      clickCountEl.textContent = `${cachedClicks.length} clicks`;
    }
    renderCanvas();
  }

  function resizeCanvas() {
    if (!canvas) return;
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }

  document.addEventListener('scroll', () => {
    if (isHudOpen) requestAnimationFrame(renderCanvas);
  }, { capture: true, passive: true });

  // Re-sync on layout shifts, menu toggles, and live telemetry
  let observerDebounce: any = null;
  function triggerLayoutReSync() {
    if (!isHudOpen) return;
    if (observerDebounce) clearTimeout(observerDebounce);
    observerDebounce = setTimeout(() => {
      requestAnimationFrame(renderCanvas);
    }, 60);
  }

  if (typeof ResizeObserver !== 'undefined' && document.body) {
    new ResizeObserver(() => triggerLayoutReSync()).observe(document.body);
  }

  if (typeof MutationObserver !== 'undefined') {
    new MutationObserver(() => triggerLayoutReSync()).observe(document.documentElement, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['class', 'style', 'aria-expanded', 'hidden']
    });
  }

  window.addEventListener('kins:telemetry:click', () => {
    if (isHudOpen) loadAndRenderHeatmap();
  });

  // 5-MODE CANVAS RENDER ENGINE (Menu-Aware)
  function renderCanvas() {
    if (!canvas || !isHudOpen) return;
    resizeCanvas();
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    ctx.clearRect(0, 0, canvas.width, canvas.height);
    const scrollY = window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0;
    const viewportHeight = window.innerHeight;
    const viewportWidth = window.innerWidth;

    const isMobileEmulator = document.body.classList.contains('hud-mobile-emulator-mode');
    const appWrapper = document.querySelector('.app-wrapper') as HTMLElement | null;
    const appRect = (isMobileEmulator && appWrapper) ? appWrapper.getBoundingClientRect() : null;

    // Detect currently visible active scope
    const visibleScope = getCurrentlyActiveVisibleScope();
    const effectiveScope = (activeScope === 'auto') ? visibleScope : activeScope;

    if (activeAreaLabel) {
      const scopePrettyNames: Record<string, string> = {
        'main_feed': 'Main Page Feed',
        'dock:audio_player': 'Audio Player Dock',
        'drawer:stream_platforms': 'Streaming Drawer',
        'modal:covers_search': 'Covers Search Modal',
        'modal:gig_map': 'NSW Gig Map Sheet',
        'modal:community': 'Fan Submission Modal',
        'modal:privacy': 'Privacy Policy Modal',
        'modal:terms': 'Fan Submission Terms',
        'modal:feedback': 'Improvement Feedback',
        'modal:cover_video': 'Cover Video Player',
        'modal:share': 'Share & QR Sheet',
        'epk:portal': 'EPK Press Kit',
        'all': 'All Areas Combined'
      };
      activeAreaLabel.textContent = `Area: ${scopePrettyNames[effectiveScope] || effectiveScope}`;
    }

    function findElementForClick(pt: any): HTMLElement | null {
      if (!pt) return null;

      // 1. If looking for a specific menu, search within that container
      if (effectiveScope !== 'all') {
        let containerEl: HTMLElement | null = null;
        if (effectiveScope === 'drawer:stream_platforms') containerEl = document.getElementById('streamDrawerPanel');
        else if (effectiveScope === 'modal:gig_map') containerEl = document.getElementById('gigMapModal') || document.getElementById('gigMapSheetModal');
        else if (effectiveScope === 'modal:covers_search') containerEl = document.getElementById('coversSearchOverlay');
        else if (effectiveScope === 'modal:community') containerEl = document.getElementById('communitySubmissionModal');
        else if (effectiveScope === 'modal:privacy') containerEl = document.getElementById('privacyModal');
        else if (effectiveScope === 'modal:terms') containerEl = document.getElementById('termsModal');
        else if (effectiveScope === 'modal:feedback') containerEl = document.getElementById('feedbackModal');
        else if (effectiveScope === 'modal:cover_video') containerEl = document.getElementById('coverVideoModal');
        else if (effectiveScope === 'modal:share') containerEl = document.getElementById('shareModal');
        else if (effectiveScope === 'dock:audio_player') containerEl = document.getElementById('bottomAudioBar');
        else if (effectiveScope === 'epk:portal') containerEl = document.getElementById('epkDeck');

        if (containerEl) {
          if (pt.target_id) {
            const byIdInCont = containerEl.querySelector(`#${pt.target_id}`) as HTMLElement | null;
            if (byIdInCont) return byIdInCont;
          }
          if (pt.target_selector) {
            try {
              const bySelInCont = containerEl.querySelector(pt.target_selector) as HTMLElement | null;
              if (bySelInCont) return bySelInCont;
            } catch (e) {}
          }
        }
      }

      // 2. Direct ID match
      if (pt.target_id) {
        const byId = document.getElementById(pt.target_id);
        if (byId) return byId;
        try {
          const byTrack = document.querySelector(`[data-track="${pt.target_id}"]`) as HTMLElement | null;
          if (byTrack) return byTrack;
        } catch (e) {}
      }

      // 3. Clean CSS selector match
      if (pt.target_selector && typeof pt.target_selector === 'string') {
        try {
          const cleanSel = pt.target_selector.replace(/:active|:hover|:focus/g, '').trim();
          if (cleanSel && !cleanSel.includes('undefined')) {
            const bySel = document.querySelector(cleanSel) as HTMLElement | null;
            if (bySel) return bySel;
          }
        } catch (e) {}
      }

      // 4. Role or platform tag match
      if (pt.element_role && pt.element_role.length > 1 && pt.element_role !== 'div') {
        try {
          const byRole = document.querySelector(
            `[data-track="${pt.element_role}"], [data-platform="${pt.element_role}"], [data-member="${pt.element_role}"], [aria-label="${pt.element_role}"]`
          ) as HTMLElement | null;
          if (byRole) return byRole;
        } catch (e) {}
      }

      return null;
    }

    // Filter points based on effective container scope
    const scopedClicks = (effectiveScope === 'all') 
      ? cachedClicks 
      : cachedClicks.filter(c => c.container_scope === effectiveScope || (effectiveScope === 'main_feed' && (c.container_scope === 'main_feed' || c.container_scope === 'main:top_nav' || c.container_scope === 'main:hero' || c.container_scope === 'main:profile' || c.container_scope === 'main:tabs' || c.container_scope === 'main:vault' || c.container_scope === 'main:members' || c.container_scope === 'main:spotlight' || c.container_scope === 'main:merch' || c.container_scope === 'main:subscribe')));

    // ==============================================================================
    // MODE 4: ATTENTION & SCROLL DEPTH MAP
    // ==============================================================================
    if (activeMode === 'attention') {
      const attentionData = fetchSectionAttention();
      const maxDwell = Math.max(...Object.values(attentionData).map(d => d.dwellSeconds), 100);

      Object.entries(attentionData).forEach(([secId, meta]) => {
        const secEl = document.querySelector(`[data-track-container="${secId}"]`) || document.getElementById(secId.split(':')[1] || secId);
        if (secEl && secEl instanceof HTMLElement && secEl.offsetHeight > 0) {
          const rect = secEl.getBoundingClientRect();
          if (rect.bottom >= 0 && rect.top <= viewportHeight) {
            const intensity = Math.min(1, meta.dwellSeconds / maxDwell);
            ctx.fillStyle = `rgba(242, 253, 67, ${0.14 + intensity * 0.32})`;
            ctx.fillRect(rect.left, rect.top, rect.width, rect.height);
            
            ctx.strokeStyle = '#f2fd43';
            ctx.lineWidth = 2;
            ctx.setLineDash([4, 4]);
            ctx.strokeRect(rect.left, rect.top, rect.width, rect.height);
            ctx.setLineDash([]);

            // Badge
            ctx.fillStyle = '#121216';
            ctx.fillRect(rect.left + 10, rect.top + 10, 160, 24);
            ctx.strokeStyle = '#f2fd43';
            ctx.strokeRect(rect.left + 10, rect.top + 10, 160, 24);
            ctx.fillStyle = '#f2fd43';
            ctx.font = 'bold 11px monospace';
            ctx.fillText(`⏱️ ${meta.dwellSeconds}s • ${meta.entries} views`, rect.left + 18, rect.top + 26);
          }
        }
      });

      // Draw Viewport Fold Line
      ctx.strokeStyle = '#00f0ff';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([6, 6]);
      ctx.beginPath();
      ctx.moveTo(0, viewportHeight - 1);
      ctx.lineTo(viewportWidth, viewportHeight - 1);
      ctx.stroke();
      ctx.setLineDash([]);

      return;
    }

    // ==============================================================================
    // MODE 3: ELEMENT HITBOX OVERLAY
    // ==============================================================================
    if (activeMode === 'hitboxes') {
      const elementMap = new Map<HTMLElement, { clicks: number; rage: number; dead: number }>();
      scopedClicks.forEach(pt => {
        const el = findElementForClick(pt);
        if (el && el instanceof HTMLElement && el.offsetHeight > 0) {
          const stats = elementMap.get(el) || { clicks: 0, rage: 0, dead: 0 };
          stats.clicks++;
          if (pt.is_rage_click) stats.rage++;
          if (pt.is_dead_click) stats.dead++;
          elementMap.set(el, stats);
        }
      });

      elementMap.forEach((stats, el) => {
        const rect = el.getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0 && rect.bottom >= 0 && rect.top <= viewportHeight) {
          const isProblem = stats.rage > 0 || stats.dead > 0;
          ctx.strokeStyle = isProblem ? '#fb7185' : '#f2fd43';
          ctx.lineWidth = 2.5;
          ctx.strokeRect(rect.left - 2, rect.top - 2, rect.width + 4, rect.height + 4);

          ctx.fillStyle = isProblem ? 'rgba(251, 113, 133, 0.22)' : 'rgba(242, 253, 67, 0.18)';
          ctx.fillRect(rect.left - 2, rect.top - 2, rect.width + 4, rect.height + 4);

          // Click count tag
          const badgeText = `${stats.clicks} clicks`;
          ctx.font = '900 10px monospace';
          const textWidth = ctx.measureText(badgeText).width;
          
          ctx.fillStyle = isProblem ? '#fb7185' : '#f2fd43';
          ctx.fillRect(rect.right - textWidth - 12, rect.top - 10, textWidth + 10, 18);
          ctx.fillStyle = '#000000';
          ctx.fillText(badgeText, rect.right - textWidth - 7, rect.top + 3);
        }
      });
      return;
    }

    // Filter points if in friction mode
    const pointsToRender = activeMode === 'friction' 
      ? scopedClicks.filter(c => c.is_rage_click || c.is_dead_click || c.is_near_miss)
      : scopedClicks;

    // ==============================================================================
    // MODE 2: DISCRETE CLICK & TAP POINTS (RADAR DOTS)
    // ==============================================================================
    if (activeMode === 'points') {
      pointsToRender.forEach(pt => {
        const domEl = findElementForClick(pt);
        let px = 0;
        let py = 0;

        if (domEl && isSnapMode && domEl.offsetHeight > 0) {
          const rect = domEl.getBoundingClientRect();
          if (rect.width > 0 && rect.height > 0 && rect.bottom >= 0 && rect.top <= viewportHeight) {
            px = rect.left + (pt.element_x_ratio || 0.5) * rect.width;
            py = rect.top + (pt.element_y_ratio || 0.5) * rect.height;
          } else return;
        } else if (!isSnapMode) {
          px = (pt.x_ratio || 0.5) * canvas.width;
          py = (pt.y_px || 0) - scrollY;
        } else return;

        if (py < 0 || py > viewportHeight) return;

        // Mobile touch contact radius halo
        if (pt.is_mobile || pt.pointer_type === 'touch') {
          const radius = Math.max(14, pt.touch_radius || 20);
          ctx.beginPath();
          ctx.arc(px, py, radius, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(16, 185, 129, 0.22)';
          ctx.fill();
          ctx.strokeStyle = 'rgba(16, 185, 129, 0.6)';
          ctx.lineWidth = 1.2;
          ctx.stroke();
        }

        // Central Dot
        ctx.beginPath();
        ctx.arc(px, py, pt.is_mobile ? 8 : 5.5, 0, Math.PI * 2);
        ctx.fillStyle = pt.is_rage_click ? '#fb7185' : (pt.is_mobile || pt.pointer_type === 'touch') ? '#10b981' : '#f2fd43';
        ctx.fill();
        ctx.strokeStyle = '#000000';
        ctx.lineWidth = 2;
        ctx.stroke();

        // High precision inner center
        ctx.beginPath();
        ctx.arc(px, py, 2, 0, Math.PI * 2);
        ctx.fillStyle = '#000000';
        ctx.fill();
      });
      return;
    }

    // ==============================================================================
    // MODE 1 & MODE 5: GAUSSIAN DENSITY / FRICTION MAP
    // ==============================================================================
    pointsToRender.forEach(pt => {
      if (!pt) return;
      let clickScreenX: number | null = null;
      let clickScreenY: number | null = null;

      const domEl = findElementForClick(pt);
      if (domEl && domEl instanceof HTMLElement && domEl.offsetHeight > 0) {
        const rect = domEl.getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0 && rect.bottom >= -30 && rect.top <= viewportHeight + 30 && rect.right >= -30 && rect.left <= viewportWidth + 30) {
          const relX = (typeof pt.element_x_ratio === 'number' && !isNaN(pt.element_x_ratio)) ? Math.max(0.05, Math.min(0.95, pt.element_x_ratio)) : 0.5;
          const relY = (typeof pt.element_y_ratio === 'number' && !isNaN(pt.element_y_ratio)) ? Math.max(0.05, Math.min(0.95, pt.element_y_ratio)) : 0.5;
          clickScreenX = rect.left + relX * rect.width;
          clickScreenY = rect.top + relY * rect.height;
        } else return;
      } else if (!isSnapMode) {
        const rawX = typeof pt.x_ratio === 'number' && !isNaN(pt.x_ratio) ? pt.x_ratio : 0.5;
        const rawY = typeof pt.y_px === 'number' && !isNaN(pt.y_px) ? pt.y_px : 0;
        if (appRect) {
          clickScreenX = appRect.left + (rawX * appRect.width);
          clickScreenY = (rawY - scrollY);
        } else {
          clickScreenX = rawX * canvas.width;
          clickScreenY = rawY - scrollY;
        }
      } else return;

      if (clickScreenX === null || clickScreenY === null) return;
      if (clickScreenY < -spotRadius * 2 || clickScreenY > viewportHeight + spotRadius * 2) return;

      const grad = ctx.createRadialGradient(
        clickScreenX, clickScreenY, 0,
        clickScreenX, clickScreenY, spotRadius
      );
      grad.addColorStop(0, 'rgba(0, 0, 0, 0.55)');
      grad.addColorStop(0.5, 'rgba(0, 0, 0, 0.30)');
      grad.addColorStop(1, 'rgba(0, 0, 0, 0)');

      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(clickScreenX, clickScreenY, spotRadius, 0, Math.PI * 2);
      ctx.fill();
    });

    // Colorize with High-Contrast Neon Palette
    try {
      const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
      const data = imgData.data;

      for (let i = 0; i < data.length; i += 4) {
        const alpha = data[i + 3];
        if (alpha > 0) {
          const norm = alpha / 255;
          if (activeMode === 'friction') {
            // Hot fiery red/purple palette for friction & rage
            data[i] = 255;
            data[i + 1] = Math.round(40 + 90 * norm);
            data[i + 2] = Math.round(70 * (1 - norm));
            data[i + 3] = Math.round(alpha * 1.75);
          } else {
            // Kins Neon Heat Palette
            if (norm < 0.25) {
              data[i] = 0;
              data[i + 1] = Math.round(200 * (norm / 0.25));
              data[i + 2] = 255;
              data[i + 3] = Math.round(alpha * 1.45);
            } else if (norm < 0.55) {
              const t = (norm - 0.25) / 0.3;
              data[i] = Math.round(242 * t);
              data[i + 1] = 253;
              data[i + 2] = Math.round(67 * (1 - t));
              data[i + 3] = Math.round(alpha * 1.65);
            } else if (norm < 0.8) {
              const t = (norm - 0.55) / 0.25;
              data[i] = 255;
              data[i + 1] = Math.round(160 + 40 * (1 - t));
              data[i + 2] = 0;
              data[i + 3] = Math.round(alpha * 1.85);
            } else {
              const t = (norm - 0.8) / 0.2;
              data[i] = 255;
              data[i + 1] = Math.round(60 * (1 - t) + 255 * t);
              data[i + 2] = Math.round(255 * t);
              data[i + 3] = 255;
            }
          }
        }
      }
      ctx.putImageData(imgData, 0, 0);
    } catch (e) {}
  }
</script>
