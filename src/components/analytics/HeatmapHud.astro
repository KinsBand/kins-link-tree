    font-size: 0.68rem !important;
    color: #a1a1aa !important;
    font-weight: 700 !important;
  }

  .slider-val { font-family: ui-monospace, monospace !important; color: #f2fd43 !important; font-weight: 800 !important; }

  .hud-slider {
    width: 100% !important;
