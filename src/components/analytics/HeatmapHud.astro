---
// src/components/analytics/HeatmapHud.astro
// Live Heatmap HUD with 5 Visualization Modes, Dynamic Active Menu Detection, Real-time DOM-Anchor Snapping & PNG Exporter
const baseUrl = import.meta.env.BASE_URL;
---

<!-- Passcode Prompt Modal -->
<div id="admin-passcode-modal" class="hud-modal-overlay hidden" data-no-track="true">
  <div class="hud-modal-card">
    <div class="hud-modal-header">
      <div class="hud-modal-title-group">
        <span class="hud-modal-icon">🔐</span>
        <h3 class="hud-modal-title">KINS DEV HUD</h3>
      </div>
      <button id="close-passcode-btn" class="hud-close-btn" aria-label="Close modal">✕</button>
    </div>
    <p class="hud-modal-desc">Enter Admin Passcode to unlock Dev Heatmap & Observability Suite.</p>
    
    <form id="admin-passcode-form" class="hud-modal-form">
      <div>
        <input 
          type="password" 
          id="admin-passcode-input" 
          placeholder="Enter Admin Passcode" 
          class="hud-input"
          autocomplete="current-password"
        />
        <p id="passcode-error-msg" class="hud-error-msg hidden">Incorrect passcode. Try again.</p>
      </div>
      
      <button type="submit" class="hud-submit-btn">
        Unlock Heatmap HUD
      </button>
    </form>

    <div class="hud-modal-footer">
      <span>Shortcut: <kbd>Ctrl+Shift+H</kbd></span>
    </div>
  </div>
</div>

<!-- Live Heatmap Overlay Canvas & Floating Toolbar -->
<div id="dev-heatmap-hud" class="hidden" data-no-track="true">
  <!-- Full-Page Interactive Canvas Overlay -->
  <canvas id="heatmap-canvas" class="hud-canvas"></canvas>

  <!-- Mobile Emulator Notch/Bezel Overlay (Visible only when MOBILE mode is active on Desktop) -->
  <div id="hud-mobile-notch-banner" class="hud-mobile-notch-banner hidden">
    <div class="notch-pill"></div>
    <span class="notch-label">📱 MOBILE VIEWPORT EMULATION (393px × 852px)</span>
  </div>

  <!-- Active Area Indicator Pill (Top Left HUD Indicator) -->
  <div id="hud-active-area-indicator" class="hud-active-area-badge">
    <span class="area-dot"></span>
    <span id="active-area-label">Area: Main Page Feed</span>
  </div>

  <!-- Element Inspection Tooltip -->
  <div id="hud-element-inspector" class="hud-inspector-card hidden">
    <div class="inspector-tag" id="inspector-tag">BUTTON</div>
    <div class="inspector-title" id="inspector-title">#streamLinkSpotify</div>
    <div class="inspector-stats">
      <span>Clicks: <strong id="inspector-clicks" class="text-yellow font-mono">0</strong></span>
      <span>Scope: <strong id="inspector-scope" class="text-cyan">drawer</strong></span>
    </div>
    <div class="inspector-extra" id="inspector-extra">
      <span>Accuracy: <strong id="inspector-acc" class="text-emerald">95%</strong></span>
      <span>Device: <strong id="inspector-dev" class="text-white">Mobile</strong></span>
    </div>
  </div>

  <!-- Draggable Floating Control Bar -->
  <div id="dev-heatmap-toolbar" class="hud-floating-toolbar">
    <!-- Header with Drag Grip -->
    <div class="toolbar-header" id="toolbar-drag-handle" title="Click and drag anywhere to move toolbar">
      <div class="toolbar-title-group">
        <span class="drag-grip-icon">⠿</span>
        <span class="pulse-dot"></span>
        <span class="toolbar-title">HEATMAP HUD</span>
      </div>
      <div class="toolbar-actions">
        <span id="heatmap-click-count" class="click-badge">0 clicks</span>
        <button id="minimize-heatmap-btn" class="toolbar-icon-btn" title="Minimize / Expand Toolbar" aria-label="Minimize or expand toolbar">−</button>
        <button id="close-heatmap-btn" class="toolbar-close-btn" title="Close HUD (Ctrl+Shift+H)">✕</button>
      </div>
    </div>

    <!-- Collapsible Toolbar Body -->
    <div id="hud-toolbar-body" class="hud-toolbar-body">
      <!-- Mode Selector Grid (5 Modes) -->
      <div class="filter-section">
        <div class="flex-between">
          <span class="filter-section-title">Mode</span>
          <span id="active-mode-label" class="mode-desc-pill">🔥 Density</span>
        </div>
        <div class="filter-pill-grid cols-5" id="hud-mode-group">
          <button data-mode="density" class="hud-mode-btn active" title="Gaussian Thermal Density">🔥 DENSE</button>
          <button data-mode="points" class="hud-mode-btn" title="Individual Click & Tap Radar Dots">🎯 DOTS</button>
          <button data-mode="hitboxes" class="hud-mode-btn" title="DOM Element Hitbox Heat Boxes">📦 BOXES</button>
          <button data-mode="attention" class="hud-mode-btn" title="Scroll Reach & Dwell Time">📊 DWELL</button>
          <button data-mode="friction" class="hud-mode-btn" title="Rage & Dead Click UX Alerts">⚠️ RAGE</button>
        </div>
      </div>

      <!-- Container Scope Filter -->
      <div class="filter-section">
        <span class="filter-section-title">Container Scope</span>
        <select id="hud-scope-select" class="hud-scope-dropdown">
          <option value="auto">⚡ Auto: Follow Active Menu</option>
          <option value="all">🌐 All Areas Combined</option>
          <option value="main_feed">🏠 Main Page Feed</option>
          <option value="dock:audio_player">🎵 Bottom Audio Dock</option>
          <option value="drawer:stream_platforms">💿 Streaming Drawer</option>
          <option value="modal:covers_search">🔍 Covers Search Modal</option>
          <option value="modal:gig_map">🗺️ NSW Gig Map Sheet</option>
          <option value="modal:community">🎬 Fan Submission Modal</option>
          <option value="modal:privacy">🛡️ Privacy Policy Modal</option>
          <option value="modal:terms">📜 Fan Submission Terms</option>
          <option value="modal:feedback">💡 Improvement Feedback</option>
          <option value="modal:cover_video">🎥 Cover Video Player</option>
          <option value="modal:share">🔗 Share & QR Modal</option>
          <option value="epk:portal">📄 EPK Press Portal</option>
        </select>
      </div>

      <!-- Time Range Filter -->
      <div class="filter-section">
        <span class="filter-section-title">Time Window</span>
        <div class="filter-pill-grid cols-4" id="time-filter-group">
          <button data-range="24h" class="hud-filter-btn active">24H</button>
          <button data-range="7d" class="hud-filter-btn">7D</button>
          <button data-range="30d" class="hud-filter-btn">30D</button>
          <button data-range="all" class="hud-filter-btn">ALL</button>
        </div>
      </div>

      <!-- Device Filter & Mobile Viewport Emulation -->
      <div class="filter-section">
        <div class="flex-between">
          <span class="filter-section-title">Device & Mode</span>
          <label class="snap-toggle-label">
            <input type="checkbox" id="hud-snap-mode-toggle" checked>
            <span>DOM Snap</span>
          </label>
        </div>
        <div class="filter-pill-grid cols-3" id="device-filter-group">
          <button data-device="all" class="hud-device-btn">ALL</button>
          <button data-device="desktop" class="hud-device-btn active">DESKTOP</button>
          <button data-device="mobile" class="hud-device-btn">📱 MOBILE</button>
        </div>
      </div>

      <!-- Dual Sliders: Radius & Opacity -->
      <div class="sliders-dual-row">
        <!-- Radius Slider -->
        <div class="slider-section flex-1" id="radius-slider-section">
          <div class="slider-header">
            <span>Radius</span>
            <span id="radius-val" class="slider-val">35px</span>
          </div>
          <input type="range" id="heatmap-radius" min="15" max="80" value="35" class="hud-slider" title="Adjust heat spot radius" />
        </div>

        <!-- Opacity Slider -->
        <div class="slider-section flex-1" id="opacity-slider-section">
          <div class="slider-header">
            <span>Opacity</span>
            <span id="opacity-val" class="slider-val">90%</span>
          </div>
          <input type="range" id="heatmap-opacity" min="20" max="100" value="90" class="hud-slider" title="Adjust heatmap layer transparency" />
        </div>
      </div>

      <!-- Action & Quick Nav Buttons -->
      <div class="toolbar-footer">
        <a href={baseUrl} class="hud-nav-link" title="Jump to Main Website / Link in Bio">
          <i class="fa-solid fa-house"></i> Site
        </a>
        <a href={`${baseUrl}epk/`} class="hud-nav-link" title="Jump to Electronic Press Kit">
          <i class="fa-solid fa-file-lines"></i> EPK
        </a>
        <a href={`${baseUrl}analytics`} class="hud-dash-link" title="Open Analytics Command Center">
          <i class="fa-solid fa-chart-line"></i> Dash
        </a>
        <button id="export-snapshot-btn" class="hud-tool-btn" title="Download Heatmap PNG Snapshot">
          <i class="fa-solid fa-camera"></i>
        </button>
        <button id="refresh-heatmap-btn" class="hud-refresh-icon-btn" title="Refresh Live Click Data">
          <i class="fa-solid fa-arrows-rotate"></i>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Base Modal Overlay */
  .hud-modal-overlay {
    position: fixed !important;
    inset: 0 !important;
    background: rgba(0, 0, 0, 0.84) !important;
    backdrop-filter: blur(8px) !important;
    z-index: 1000030 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 16px !important;
  }

  .hud-modal-overlay.hidden { display: none !important; }

  .hud-modal-card {
    background: #121216 !important;
    border: 3px solid #000000 !important;
    box-shadow: 6px 6px 0px #000000 !important;
    border-radius: 16px !important;
    padding: 24px !important;
    max-width: 380px !important;
    width: 100% !important;
    color: #ffffff !important;
    font-family: 'Space Grotesk', -apple-system, sans-serif !important;
  }

  .hud-modal-header {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    margin-bottom: 12px !important;
  }

  .hud-modal-title-group {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
  }

  .hud-modal-icon { font-size: 1.2rem !important; }

  .hud-modal-title {
    font-family: 'Cinzel', serif !important;
    font-weight: 900 !important;
    font-size: 1.1rem !important;
    color: #f2fd43 !important;
    margin: 0 !important;
    letter-spacing: 0.04em !important;
  }

  .hud-close-btn {
    background: none !important;
    border: none !important;
    color: #a1a1aa !important;
    font-size: 1.2rem !important;
    cursor: pointer !important;
    line-height: 1 !important;
    padding: 4px !important;
  }

  .hud-close-btn:hover { color: #ffffff !important; }

  .hud-modal-desc {
    font-size: 0.8rem !important;
    color: #a1a1aa !important;
    margin: 0 0 16px 0 !important;
    line-height: 1.4 !important;
  }

  .hud-modal-form {
    display: flex !important;
    flex-direction: column !important;
    gap: 12px !important;
  }

  .hud-input {
    width: 100% !important;
    background: #1b1b20 !important;
    border: 2px solid #3f3f46 !important;
    border-radius: 8px !important;
    padding: 10px 14px !important;
    color: #ffffff !important;
    font-size: 0.9rem !important;
    letter-spacing: 0.1em !important;
    outline: none !important;
    box-sizing: border-box !important;
  }

  .hud-input:focus {
    border-color: #f2fd43 !important;
    box-shadow: 0 0 12px rgba(242, 253, 67, 0.3) !important;
  }

  .hud-error-msg {
    color: #fb7185 !important;
    font-size: 0.72rem !important;
    margin: 4px 0 0 0 !important;
  }

  .hud-submit-btn {
    background: #f2fd43 !important;
    border: 2px solid #000000 !important;
    border-radius: 8px !important;
    color: #000000 !important;
    font-weight: 900 !important;
    font-size: 0.85rem !important;
    padding: 11px !important;
    cursor: pointer !important;
    box-shadow: 3px 3px 0px #000000 !important;
    transition: transform 0.15s ease, background-color 0.15s ease !important;
  }

  .hud-submit-btn:hover {
    background: #faff60 !important;
    transform: translate(-1px, -1px) !important;
  }

  .hud-modal-footer {
    margin-top: 16px !important;
    padding-top: 12px !important;
    border-top: 1px solid #27272a !important;
    display: flex !important;
    justify-content: space-between !important;
    font-size: 0.7rem !important;
    color: #71717a !important;
  }

  .hud-modal-footer kbd {
    background: #1f1f28 !important;
    color: #f2fd43 !important;
    padding: 2px 5px !important;
    border-radius: 4px !important;
    font-family: monospace !important;
  }

  .hud-modal-footer code {
    color: #f2fd43 !important;
    background: #1f1f28 !important;
    padding: 2px 4px !important;
    border-radius: 4px !important;
  }

  /* Canvas Overlay */
  .hud-canvas {
    position: fixed !important;
    inset: 0 !important;
    pointer-events: none !important;
    z-index: 1000000 !important;
    opacity: 0.90 !important;
  }

  /* Active Area Badge */
  .hud-active-area-badge {
    position: fixed !important;
    top: 14px !important;
    left: 16px !important;
    z-index: 1000005 !important;
    background: rgba(18, 18, 22, 0.92) !important;
    border: 1.5px solid #3f3f46 !important;
    border-radius: 20px !important;
    padding: 5px 12px !important;
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    font-size: 0.72rem !important;
    font-family: 'Space Grotesk', sans-serif !important;
    font-weight: 700 !important;
    color: #e4e4e7 !important;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.6) !important;
    pointer-events: none !important;
  }

  .area-dot {
    width: 8px !important;
    height: 8px !important;
    border-radius: 50% !important;
    background: #f2fd43 !important;
    box-shadow: 0 0 6px #f2fd43 !important;
  }

  /* Mobile Device Viewport Emulator Mode */
  body.hud-mobile-emulator-mode {
    background: #09090c !important;
    padding: 60px 0 120px 0 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    overflow-x: hidden !important;
    min-height: 100vh !important;
  }

  body.hud-mobile-emulator-mode .app-wrapper {
    width: 393px !important;
    max-width: 393px !important;
    min-height: 852px !important;
    margin: 0 auto !important;
    padding: 0 !important;
    box-shadow: 0 0 60px rgba(0, 0, 0, 0.98), 0 0 0 12px #181820, 0 0 0 14px #383842 !important;
    border-radius: 44px !important;
    overflow-x: hidden !important;
    position: relative !important;
    box-sizing: border-box !important;
    background: #141417 !important;
  }

  body.hud-mobile-emulator-mode .site-container {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    background: transparent !important;
    border-radius: 0 !important;
    padding: 16px 14px 110px !important;
    box-shadow: none !important;
    border: none !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 16px !important;
    min-height: auto !important;
  }

  body.hud-mobile-emulator-mode .left-sidebar,
  body.hud-mobile-emulator-mode .right-main-content {
    display: contents !important;
    position: static !important;
    width: 100% !important;
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    overflow: visible !important;
    transform: none !important;
  }

  body.hud-mobile-emulator-mode .left-sidebar > .top-nav { order: 1 !important; }
  body.hud-mobile-emulator-mode .left-sidebar > .hero-banner-container { order: 2 !important; }
  body.hud-mobile-emulator-mode .left-sidebar > .profile-section { order: 3 !important; }
  body.hud-mobile-emulator-mode .left-sidebar > .hero-feature-card-wrapper { order: 4 !important; }
  body.hud-mobile-emulator-mode .left-sidebar > .tabbed-links-section { order: 5 !important; }
  body.hud-mobile-emulator-mode .right-main-content > .members-section { order: 6 !important; }
  body.hud-mobile-emulator-mode .right-main-content > .spotlight-section { order: 7 !important; }
  body.hud-mobile-emulator-mode .right-main-content > .inspired-section { order: 8 !important; }
  body.hud-mobile-emulator-mode .left-sidebar > .subscribe-section { order: 9 !important; }
  body.hud-mobile-emulator-mode .right-main-content > .site-footer { order: 10 !important; }

  .hud-mobile-notch-banner {
    position: fixed !important;
    top: 12px !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    z-index: 1000006 !important;
    background: #111116 !important;
    border: 2px solid #f2fd43 !important;
    border-radius: 20px !important;
    padding: 6px 16px !important;
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.8), 0 0 15px rgba(242, 253, 67, 0.3) !important;
    pointer-events: none !important;
  }

  .notch-pill {
    width: 12px !important;
    height: 12px !important;
    border-radius: 50% !important;
    background: #10b981 !important;
    box-shadow: 0 0 8px #10b981 !important;
  }

  .notch-label {
    font-size: 0.72rem !important;
    font-weight: 900 !important;
    color: #ffffff !important;
    font-family: 'Space Grotesk', sans-serif !important;
    letter-spacing: 0.04em !important;
  }

  /* Element Inspector Tooltip */
  .hud-inspector-card {
    position: fixed !important;
    z-index: 1000010 !important;
    background: #121216 !important;
    border: 2px solid #f2fd43 !important;
    border-radius: 10px !important;
    padding: 8px 12px !important;
    color: #ffffff !important;
    font-family: 'Space Grotesk', sans-serif !important;
    font-size: 0.75rem !important;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.8), 0 0 15px rgba(242, 253, 67, 0.3) !important;
    pointer-events: none !important;
    transform: translate(-50%, -120%) !important;
    white-space: nowrap !important;
    transition: opacity 0.15s ease !important;
  }

  .inspector-tag {
    font-size: 0.6rem !important;
    font-weight: 800 !important;
    color: #a1a1aa !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
  }

  .inspector-title {
    font-family: monospace !important;
    font-weight: 700 !important;
    color: #f2fd43 !important;
    margin: 2px 0 4px 0 !important;
  }

  .inspector-stats, .inspector-extra {
    display: flex !important;
    gap: 12px !important;
    font-size: 0.7rem !important;
  }

  .inspector-extra {
    margin-top: 3px !important;
    padding-top: 3px !important;
    border-top: 1px solid #27272a !important;
    font-size: 0.65rem !important;
    color: #a1a1aa !important;
  }

  /* Draggable Floating Toolbar */
  .hud-floating-toolbar {
    position: fixed !important;
    bottom: 24px !important;
    right: 24px !important;
    z-index: 1000020 !important;
    background: rgba(18, 18, 22, 0.97) !important;
    border: 2px solid #f2fd43 !important;
    border-radius: 16px !important;
    padding: 13px !important;
    max-width: 338px !important;
    width: calc(100vw - 48px) !important;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.85), 0 0 25px rgba(242, 253, 67, 0.25) !important;
    backdrop-filter: blur(14px) !important;
    font-family: 'Space Grotesk', -apple-system, sans-serif !important;
    color: #ffffff !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 8px !important;
    box-sizing: border-box !important;
    touch-action: none !important;
  }

  .toolbar-header {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    border-bottom: 1px solid #27272a !important;
    padding-bottom: 6px !important;
    cursor: grab !important;
    cursor: -webkit-grab !important;
    user-select: none !important;
  }

  .toolbar-header:active { cursor: grabbing !important; }

  .drag-grip-icon {
    font-size: 1rem !important;
    color: #71717a !important;
    letter-spacing: -2px !important;
    line-height: 1 !important;
  }

  .toolbar-title-group {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
  }

  .pulse-dot {
    width: 8px !important;
    height: 8px !important;
    border-radius: 50%;
    background: #f2fd43 !important;
    box-shadow: 0 0 8px #f2fd43 !important;
    animation: pulseDotHud 1.5s infinite !important;
  }

  @keyframes pulseDotHud {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .toolbar-title {
    font-family: 'Cinzel', serif !important;
    font-weight: 900 !important;
    font-size: 0.85rem !important;
    color: #f2fd43 !important;
    letter-spacing: 0.04em !important;
  }

  .toolbar-actions {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
  }

  .click-badge {
    background: #1c1c24 !important;
    border: 1px solid #27272a !important;
    color: #f2fd43 !important;
    font-size: 0.7rem !important;
    font-family: monospace !important;
    padding: 2px 6px !important;
    border-radius: 6px !important;
  }

  .toolbar-icon-btn {
    background: #1c1c24 !important;
    border: 1px solid #27272a !important;
    color: #a1a1aa !important;
    font-size: 0.9rem !important;
    font-weight: 900 !important;
    cursor: pointer !important;
    line-height: 1 !important;
    width: 24px !important;
    height: 24px !important;
    border-radius: 6px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all 0.15s ease !important;
  }

  .toolbar-icon-btn:hover {
    color: #ffffff !important;
    border-color: #f2fd43 !important;
    background: #272733 !important;
  }

  .toolbar-close-btn {
    background: none !important;
    border: none !important;
    color: #a1a1aa !important;
    font-size: 1rem !important;
    cursor: pointer !important;
    line-height: 1 !important;
    padding: 2px 4px !important;
  }

  .toolbar-close-btn:hover { color: #ffffff !important; }

  /* Collapsible Toolbar States */
  .hud-floating-toolbar.minimized {
    max-width: 250px !important;
    padding: 8px 12px !important;
    border-radius: 12px !important;
    background: rgba(18, 18, 22, 0.94) !important;
  }

  .hud-floating-toolbar.minimized .toolbar-header {
    border-bottom: none !important;
    padding-bottom: 0 !important;
  }

  .hud-toolbar-body {
    display: flex !important;
    flex-direction: column !important;
    gap: 8px !important;
    transition: opacity 0.2s ease !important;
  }

