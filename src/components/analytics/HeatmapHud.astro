  }

  .hud-input:focus {
    border-color: #f2fd43 !important;
    box-shadow: 0 0 12px rgba(242, 253, 67, 0.3) !important;
  }

  .hud-error-msg {
    color: #fb7185 !important;
    font-size: 0.72rem !important;
    margin: 4px 0 0 0 !important;
  }

  .hud-submit-btn {
    background: #f2fd43 !important;
    border: 2px solid #000000 !important;
    border-radius: 8px !important;
    color: #000000 !important;
    font-weight: 900 !important;
    font-size: 0.85rem !important;
    padding: 11px !important;
    cursor: pointer !important;
    box-shadow: 3px 3px 0px #000000 !important;
    transition: transform 0.15s ease, background-color 0.15s ease !important;
  }

  .hud-submit-btn:hover {
    background: #faff60 !important;
    transform: translate(-1px, -1px) !important;
  }

  .hud-modal-footer {
    margin-top: 16px !important;
    padding-top: 12px !important;
    border-top: 1px solid #27272a !important;
    display: flex !important;
    justify-content: space-between !important;
    font-size: 0.7rem !important;
    color: #71717a !important;
  }

  .hud-modal-footer kbd {
    background: #1f1f28 !important;
    color: #f2fd43 !important;
    padding: 2px 5px !important;
    border-radius: 4px !important;
    font-family: monospace !important;
  }

  .hud-modal-footer code {
    color: #f2fd43 !important;
    background: #1f1f28 !important;
    padding: 2px 4px !important;
    border-radius: 4px !important;
  }

  /* Canvas Overlay */
  .hud-canvas {
    position: fixed !important;
    inset: 0 !important;
    pointer-events: none !important;
    z-index: 9990 !important;
    opacity: 0.88 !important;
  }

  /* Mobile Device Viewport Emulator Mode */
  body.hud-mobile-emulator-mode {
    background: #08080a !important;
    padding-top: 50px !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    overflow-x: hidden !important;
  }

  body.hud-mobile-emulator-mode > *:not(#dev-heatmap-hud):not(#admin-passcode-modal):not(.hud-mobile-notch-banner):not(#page-preloader) {
    max-width: 393px !important;
    width: 393px !important;
    box-shadow: 0 0 60px rgba(0, 0, 0, 0.95), 0 0 0 10px #1c1c24, 0 0 0 12px #3f3f46 !important;
    border-radius: 36px !important;
    overflow-x: hidden !important;
    position: relative !important;
    box-sizing: border-box !important;
  }

  .hud-mobile-notch-banner {
    position: fixed !important;
    top: 10px !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    z-index: 9996 !important;
    background: #111116 !important;
    border: 2px solid #f2fd43 !important;
    border-radius: 20px !important;
    padding: 6px 16px !important;
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.8), 0 0 15px rgba(242, 253, 67, 0.3) !important;
  }

  .notch-pill {
    width: 12px !important;
    height: 12px !important;
    border-radius: 50% !important;
    background: #10b981 !important;
    box-shadow: 0 0 8px #10b981 !important;
  }

  .notch-label {
    font-size: 0.72rem !important;
    font-weight: 900 !important;
    color: #ffffff !important;
    font-family: 'Space Grotesk', sans-serif !important;
    letter-spacing: 0.04em !important;
  }

  /* Element Inspector Tooltip */
  .hud-inspector-card {
    position: fixed !important;
    z-index: 9998 !important;
    background: #121216 !important;
    border: 2px solid #f2fd43 !important;
    border-radius: 10px !important;
    padding: 8px 12px !important;
    color: #ffffff !important;
    font-family: 'Space Grotesk', sans-serif !important;
    font-size: 0.75rem !important;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.8), 0 0 15px rgba(242, 253, 67, 0.3) !important;
    pointer-events: none !important;
    transform: translate(-50%, -120%) !important;
    white-space: nowrap !important;
    transition: opacity 0.15s ease !important;
  }

  .inspector-tag {
    font-size: 0.6rem !important;
    font-weight: 800 !important;
    color: #a1a1aa !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
  }

  .inspector-title {
    font-family: monospace !important;
    font-weight: 700 !important;
    color: #f2fd43 !important;
    margin: 2px 0 4px 0 !important;
  }

  .inspector-stats {
    display: flex !important;
    gap: 12px !important;
    font-size: 0.7rem !important;
  }

  /* Floating Toolbar */
  .hud-floating-toolbar {
    position: fixed !important;
    bottom: 24px !important;
    right: 24px !important;
    z-index: 9995 !important;
    background: rgba(18, 18, 22, 0.96) !important;
    border: 2px solid #f2fd43 !important;
    border-radius: 16px !important;
    padding: 16px !important;
    max-width: 320px !important;
    width: calc(100vw - 48px) !important;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.85), 0 0 25px rgba(242, 253, 67, 0.25) !important;
    backdrop-filter: blur(14px) !important;
    font-family: 'Space Grotesk', -apple-system, sans-serif !important;
    color: #ffffff !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 10px !important;
    box-sizing: border-box !important;
  }

  .toolbar-header {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    border-bottom: 1px solid #27272a !important;
    padding-bottom: 8px !important;
  }

  .toolbar-title-group {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
  }

  .pulse-dot {
    width: 8px !important;
    height: 8px !important;
    border-radius: 50% !important;
    background: #f2fd43 !important;
    box-shadow: 0 0 8px #f2fd43 !important;
    animation: pulseDotHud 1.5s infinite !important;
  }

  @keyframes pulseDotHud {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .toolbar-title {
    font-family: 'Cinzel', serif !important;
    font-weight: 900 !important;
    font-size: 0.85rem !important;
    color: #f2fd43 !important;
    letter-spacing: 0.04em !important;
  }

  .toolbar-actions {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
  }

  .click-badge {
    background: #1c1c24 !important;
    border: 1px solid #27272a !important;
    color: #f2fd43 !important;
    font-size: 0.7rem !important;
    font-family: monospace !important;
    padding: 2px 6px !important;
    border-radius: 6px !important;
  }

  .toolbar-close-btn {
    background: none !important;
    border: none !important;
    color: #a1a1aa !important;
    font-size: 1rem !important;
    cursor: pointer !important;
    line-height: 1 !important;
    padding: 2px 4px !important;
  }

  .toolbar-close-btn:hover { color: #ffffff !important; }

  .filter-section {
    display: flex !important;
    flex-direction: column !important;
    gap: 4px !important;
  }

  .filter-section-title {
    font-size: 0.65rem !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    color: #a1a1aa !important;
  }

  .flex-between {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
  }

  .snap-toggle-label {
    font-size: 0.68rem !important;
    color: #f2fd43 !important;
    display: flex !important;
    align-items: center !important;
    gap: 4px !important;
    cursor: pointer !important;
  }

  .hud-scope-dropdown {
    width: 100% !important;
    background: #181822 !important;
    border: 2px solid #3f3f46 !important;
    color: #ffffff !important;
    font-size: 0.8rem !important;
    font-family: 'Space Grotesk', -apple-system, sans-serif !important;
    font-weight: 800 !important;
    padding: 8px 10px !important;
    border-radius: 10px !important;
    outline: none !important;
    cursor: pointer !important;
    box-shadow: 2px 2px 0px #000000 !important;
    box-sizing: border-box !important;
  }

  .hud-scope-dropdown:focus { border-color: #f2fd43 !important; }

  .filter-pill-grid {
    display: grid !important;
    gap: 4px !important;
    background: #181822 !important;
    border: 2px solid #3f3f46 !important;
    border-radius: 10px !important;
    padding: 3px !important;
    box-sizing: border-box !important;
    box-shadow: 2px 2px 0px #000000 !important;
  }

  .filter-pill-grid.cols-4 { grid-template-columns: repeat(4, 1fr) !important; }
  .filter-pill-grid.cols-3 { grid-template-columns: repeat(3, 1fr) !important; }

  .hud-filter-btn, .hud-device-btn {
    background: transparent !important;
    border: none !important;
    color: #a1a1aa !important;
    font-size: 0.72rem !important;
    font-weight: 900 !important;
    padding: 6px 4px !important;
    border-radius: 6px !important;
    cursor: pointer !important;
    transition: all 0.15s ease !important;
  }

  .hud-filter-btn.active, .hud-device-btn.active {
    background: #f2fd43 !important;
    color: #000000 !important;
    box-shadow: 0 0 10px rgba(242, 253, 67, 0.4), 1px 1px 0px #000000 !important;
  }

  .slider-section {
    display: flex !important;
    flex-direction: column !important;
    gap: 4px !important;
  }

  .slider-header {
    display: flex !important;
    justify-content: space-between !important;
    font-size: 0.7rem !important;
    color: #a1a1aa !important;
    font-weight: 700 !important;
  }

  .slider-val { font-family: ui-monospace, monospace !important; color: #f2fd43 !important; font-weight: 800 !important; }

  .hud-slider {
    width: 100% !important;
    accent-color: #f2fd43 !important;
    cursor: pointer !important;
  }

  .toolbar-footer {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    padding-top: 10px !important;
    border-top: 1px solid #27272a !important;
  }

  .hud-dash-link {
    flex: 1 !important;
    background: #181822 !important;
    border: 2px solid #3f3f46 !important;
    color: #ffffff !important;
    text-decoration: none !important;
    font-size: 0.75rem !important;
    font-weight: 900 !important;
    padding: 9px !important;
    border-radius: 10px !important;
    text-align: center !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px !important;
    box-shadow: 2px 2px 0px #000000 !important;
    transition: all 0.15s ease !important;
  }

  .hud-dash-link:hover {
    background: #242430 !important;
    color: #f2fd43 !important;
    border-color: #f2fd43 !important;
    transform: translate(-1px, -1px) !important;
    box-shadow: 3px 3px 0px #000000 !important;
  }

  .hud-refresh-icon-btn {
    background: #181822 !important;
    border: 2px solid #3f3f46 !important;
    color: #a1a1aa !important;
    padding: 8px 10px !important;
    border-radius: 10px !important;
    cursor: pointer !important;
    font-size: 0.85rem !important;
    box-shadow: 2px 2px 0px #000000 !important;
  }

  .hud-refresh-icon-btn:hover {
    color: #ffffff !important;
    background: #242430 !important;
    border-color: #f2fd43 !important;
  }
</style>

<script>
  import { isUserAdmin, authenticateAdmin } from '../../lib/adminAuth';
  import { fetchHeatmapClicks, type ClickRecord } from '../../lib/heatmapTracker';

  let isHudOpen = false;
  let activeTimeRange: '24h' | '7d' | '30d' | 'all' = '24h';
  let activeDeviceFilter: 'all' | 'mobile' | 'desktop' = 'desktop';
  let activeScope = 'all';
  let isSnapMode = true;
  let spotRadius = 35;
  let cachedClicks: ClickRecord[] = [];

  const modal = document.getElementById('admin-passcode-modal');
  const hudContainer = document.getElementById('dev-heatmap-hud');
  const canvas = document.getElementById('heatmap-canvas') as HTMLCanvasElement | null;
  const notchBanner = document.getElementById('hud-mobile-notch-banner');
  const form = document.getElementById('admin-passcode-form') as HTMLFormElement | null;
  const input = document.getElementById('admin-passcode-input') as HTMLInputElement | null;
  const errorMsg = document.getElementById('passcode-error-msg');
  const closePasscodeBtn = document.getElementById('close-passcode-btn');
  const closeHeatmapBtn = document.getElementById('close-heatmap-btn');
  const refreshBtn = document.getElementById('refresh-heatmap-btn');
  const clickCountEl = document.getElementById('heatmap-click-count');
  const radiusSlider = document.getElementById('heatmap-radius') as HTMLInputElement | null;
  const radiusValEl = document.getElementById('radius-val');
  const scopeSelect = document.getElementById('hud-scope-select') as HTMLSelectElement | null;
  const snapToggle = document.getElementById('hud-snap-mode-toggle') as HTMLInputElement | null;
  const inspectorCard = document.getElementById('hud-element-inspector');
  const inspectorTag = document.getElementById('inspector-tag');
  const inspectorTitle = document.getElementById('inspector-title');
  const inspectorClicks = document.getElementById('inspector-clicks');
  const inspectorScope = document.getElementById('inspector-scope');

  function showModal() {
    if (!modal) return;
    modal.classList.remove('hidden');
    if (input) input.focus();
  }

  function hideModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    if (errorMsg) errorMsg.classList.add('hidden');
    if (input) input.value = '';
  }

  function toggleHud() {
    if (!isUserAdmin()) {
      showModal();
      return;
    }

    isHudOpen = !isHudOpen;
    if (isHudOpen) {
      if (hudContainer) hudContainer.classList.remove('hidden');
      applyDeviceMode(activeDeviceFilter);
      loadAndRenderHeatmap();
    } else {
      if (hudContainer) hudContainer.classList.add('hidden');
      if (inspectorCard) inspectorCard.classList.add('hidden');
      document.body.classList.remove('hud-mobile-emulator-mode');
      if (notchBanner) notchBanner.classList.add('hidden');
    }
  }

  function applyDeviceMode(device: 'all' | 'mobile' | 'desktop') {
    if (!isHudOpen) return;
    if (device === 'mobile' && window.innerWidth >= 768) {
      document.body.classList.add('hud-mobile-emulator-mode');
      if (notchBanner) notchBanner.classList.remove('hidden');
    } else {
      document.body.classList.remove('hud-mobile-emulator-mode');
      if (notchBanner) notchBanner.classList.add('hidden');
    }
  }

  // Keyboard shortcut listener: Ctrl + Shift + H / Cmd + Shift + H
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'H' || e.key === 'h')) {
      e.preventDefault();
      toggleHud();
    }
  });

  // Check URL query parameter for direct dev mode activation
  if (typeof window !== 'undefined' && window.location.search.includes('dev=heatmap')) {
    setTimeout(toggleHud, 400);
  }

  if (closePasscodeBtn) closePasscodeBtn.addEventListener('click', hideModal);
  if (closeHeatmapBtn) closeHeatmapBtn.addEventListener('click', toggleHud);

  if (form && input) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const code = input.value;
      if (authenticateAdmin(code)) {
        hideModal();
        isHudOpen = true;
        if (hudContainer) hudContainer.classList.remove('hidden');
        applyDeviceMode(activeDeviceFilter);
        loadAndRenderHeatmap();
      } else {
        if (errorMsg) errorMsg.classList.remove('hidden');
        input.focus();
      }
    });
  }

  // Scope & Filter Listeners
  if (scopeSelect) {
    scopeSelect.addEventListener('change', () => {
      activeScope = scopeSelect.value;
      loadAndRenderHeatmap();
    });
  }

  if (snapToggle) {
    snapToggle.addEventListener('change', () => {
      isSnapMode = snapToggle.checked;
      renderCanvas();
    });
  }

  const timeBtns = document.querySelectorAll('#time-filter-group .hud-filter-btn');
  timeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      timeBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeTimeRange = btn.getAttribute('data-range') as any || '24h';
      loadAndRenderHeatmap();
    });
  });

  const deviceBtns = document.querySelectorAll('#device-filter-group .hud-device-btn');
  deviceBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      deviceBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeDeviceFilter = btn.getAttribute('data-device') as any || 'all';
      applyDeviceMode(activeDeviceFilter);
      loadAndRenderHeatmap();
    });
  });

  if (radiusSlider && radiusValEl) {
    radiusSlider.addEventListener('input', (e) => {
      spotRadius = Number((e.target as HTMLInputElement).value);
      radiusValEl.textContent = `${spotRadius}px`;
      renderCanvas();
    });
  }

  if (refreshBtn) {
    refreshBtn.addEventListener('click', () => {
      refreshBtn.querySelector('i')?.classList.add('fa-spin');
      loadAndRenderHeatmap().then(() => {
        setTimeout(() => refreshBtn.querySelector('i')?.classList.remove('fa-spin'), 400);
      });
    });
  }

  // Element Snapping Hover Inspector
  document.addEventListener('mousemove', (e) => {
    if (!isHudOpen || !isSnapMode || !inspectorCard) return;
    const target = e.target as HTMLElement | null;
    if (!target || !target.closest || target.closest('#dev-heatmap-hud') || target.closest('#admin-passcode-modal')) {
      inspectorCard.classList.add('hidden');
      return;
    }

    const interactiveEl = target.closest('a, button, [role="button"], .music-card, .cover-result-card, .filter-pill-btn, input') as HTMLElement | null;
    if (interactiveEl && interactiveEl.tagName) {
      const elId = interactiveEl.id || '';
      const tagLower = (interactiveEl.tagName || '').toLowerCase();
      
      const matchingClicks = (cachedClicks || []).filter(c => {
        if (!c) return false;
        if (elId && c.target_id && c.target_id === elId) return true;
        if (typeof c.target_selector === 'string' && tagLower && c.target_selector.toLowerCase().includes(tagLower)) return true;
        return false;
      }).length;

      if (inspectorTag) inspectorTag.textContent = tagLower.toUpperCase();
      if (inspectorTitle) inspectorTitle.textContent = elId ? `#${elId}` : tagLower;
      if (inspectorClicks) inspectorClicks.textContent = `${matchingClicks}`;
      if (inspectorScope) inspectorScope.textContent = (interactiveEl.closest && interactiveEl.closest('#streamDrawerPanel')) ? 'drawer' : (interactiveEl.closest && interactiveEl.closest('.gig-map-sheet')) ? 'gig_map' : 'page';

      inspectorCard.style.left = `${e.clientX}px`;
      inspectorCard.style.top = `${e.clientY}px`;
      inspectorCard.classList.remove('hidden');
    } else {
      inspectorCard.classList.add('hidden');
    }
  }, { passive: true });

  async function loadAndRenderHeatmap() {
    cachedClicks = await fetchHeatmapClicks({
      timeRange: activeTimeRange,
      deviceFilter: activeDeviceFilter,
      containerScope: activeScope
    });

    if (clickCountEl) {
      clickCountEl.textContent = `${cachedClicks.length} clicks`;
    }
    renderCanvas();
  }

  function resizeCanvas() {
    if (!canvas) return;
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }

  // DOM-Anchor Real-Time Scroll Listener (Captures Window Scroll AND Internal Scrollable Menus)
  document.addEventListener('scroll', () => {
    if (isHudOpen) {
      requestAnimationFrame(renderCanvas);
    }
  }, { capture: true, passive: true });

  // Dynamic Layout Shift Observers (ResizeObserver & MutationObserver)
  let observerDebounce: any = null;
  function triggerLayoutReSync() {
    if (!isHudOpen) return;
    if (observerDebounce) clearTimeout(observerDebounce);
    observerDebounce = setTimeout(() => {
      requestAnimationFrame(renderCanvas);
    }, 80);
  }

  if (typeof ResizeObserver !== 'undefined') {
    const ro = new ResizeObserver(() => triggerLayoutReSync());
    if (document.body) ro.observe(document.body);
  }

  if (typeof MutationObserver !== 'undefined') {
    const mo = new MutationObserver(() => triggerLayoutReSync());
    mo.observe(document.documentElement, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['class', 'style', 'aria-expanded', 'hidden']
    });
  }

  // REAL-TIME DOM-ANCHOR CANVAS RENDER ENGINE
  function renderCanvas() {
    if (!canvas || !isHudOpen) return;
    resizeCanvas();
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    ctx.clearRect(0, 0, canvas.width, canvas.height);
    const scrollY = window.scrollY;
    const viewportHeight = window.innerHeight;
    const viewportWidth = window.innerWidth;

    cachedClicks.forEach(pt => {
      let clickScreenX: number | null = null;
      let clickScreenY: number | null = null;

      // 1. Try Live DOM-Anchor Snapping
      if (isSnapMode && (pt.target_id || pt.target_selector)) {
        try {
          const domEl = (pt.target_id ? document.getElementById(pt.target_id) : null) || 
                        (pt.target_selector ? document.querySelector(pt.target_selector) : null);
          
          if (domEl && domEl instanceof HTMLElement) {
            const rect = domEl.getBoundingClientRect();
            
            // Check if element is currently rendered inside the visible viewport (Culling)
            if (rect.bottom >= -20 && rect.top <= viewportHeight + 20 && rect.right >= -20 && rect.left <= viewportWidth + 20) {
              const relX = typeof pt.element_x_ratio === 'number' ? pt.element_x_ratio : 0.5;
              const relY = typeof pt.element_y_ratio === 'number' ? pt.element_y_ratio : 0.5;
              clickScreenX = rect.left + relX * rect.width;
              clickScreenY = rect.top + relY * rect.height;
            } else {
              // Element is scrolled out of view inside an internal container/drawer -> cull it out!
              return;
            }
          }
        } catch (e) {}
      }

      // 2. Fallback to Responsive Viewport Coordinates
      if (clickScreenX === null || clickScreenY === null) {
        clickScreenY = pt.y_px - scrollY;
        if (clickScreenY < -spotRadius * 2 || clickScreenY > viewportHeight + spotRadius * 2) {
          return;
        }
        clickScreenX = pt.x_ratio * canvas.width;
      }

      const grad = ctx.createRadialGradient(
        clickScreenX, clickScreenY, 0,
        clickScreenX, clickScreenY, spotRadius
      );
      grad.addColorStop(0, 'rgba(0, 0, 0, 0.48)');
      grad.addColorStop(0.5, 'rgba(0, 0, 0, 0.26)');
      grad.addColorStop(1, 'rgba(0, 0, 0, 0)');

      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.arc(clickScreenX, clickScreenY, spotRadius, 0, Math.PI * 2);
      ctx.fill();
    });

    // Colorize with High-Contrast Kins Neon Palette
    try {
      const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
      const data = imgData.data;

      for (let i = 0; i < data.length; i += 4) {
        const alpha = data[i + 3];
        if (alpha > 0) {
          const norm = alpha / 255;
          if (norm < 0.25) {
            data[i] = 0;
            data[i + 1] = Math.round(200 * (norm / 0.25));
            data[i + 2] = 255;
            data[i + 3] = Math.round(alpha * 1.45);
          } else if (norm < 0.55) {
            const t = (norm - 0.25) / 0.3;
            data[i] = Math.round(242 * t);
            data[i + 1] = 253;
            data[i + 2] = Math.round(67 * (1 - t));
            data[i + 3] = Math.round(alpha * 1.65);
          } else if (norm < 0.8) {
            const t = (norm - 0.55) / 0.25;
            data[i] = 255;
            data[i + 1] = Math.round(160 + 40 * (1 - t));
            data[i + 2] = 0;
            data[i + 3] = Math.round(alpha * 1.85);
          } else {
            const t = (norm - 0.8) / 0.2;
            data[i] = 255;
            data[i + 1] = Math.round(60 * (1 - t) + 255 * t);
            data[i + 2] = Math.round(255 * t);
            data[i + 3] = 255;
          }
        }
      }
      ctx.putImageData(imgData, 0, 0);
    } catch (e) {}
  }
</script>
