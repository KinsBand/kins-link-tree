  .filter-pill-grid.cols-5 { grid-template-columns: repeat(5, 1fr) !important; }
  .filter-pill-grid.cols-4 { grid-template-columns: repeat(4, 1fr) !important; }
  .filter-pill-grid.cols-3 { grid-template-columns: repeat(3, 1fr) !important; }

  .hud-filter-btn, .hud-device-btn, .hud-mode-btn {
