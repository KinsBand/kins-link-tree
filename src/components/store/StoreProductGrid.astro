---
import { storeConfig } from '../../settings/store.config';
import StoreProductCard from './StoreProductCard.astro';
---

<section class="store-product-grid-section" data-track-container="store:product_grid">
  <!-- Products Grid (2 columns on mobile, 3-4 on desktop) -->
  <div class="store-product-grid" id="storeProductGrid">
    {storeConfig.products.map((product, idx) => (
      <StoreProductCard product={product} index={idx} />
    ))}
  </div>

  <!-- Empty State -->
  <div class="store-empty-state brutal-card" id="storeEmptyState" style="display: none;">
    <div class="empty-state-icon-box">
      <i class="fa-solid fa-box-open"></i>
    </div>
    <h3 class="empty-state-title">NO ITEMS FOUND</h3>
    <p class="empty-state-desc">Try clearing your search query or selecting a different category filter.</p>
    <button type="button" class="empty-state-reset-btn green-link-btn brutal-press" id="emptyStateResetBtn" onclick="document.getElementById('storeSearchInput').value=''; document.querySelector('.store-category-pill[data-category=all]').click();">
      <span>VIEW ALL MERCH</span>
      <i class="fa-solid fa-rotate-left"></i>
    </button>
  </div>
</section>

<style>
  .store-product-grid-section {
    width: 100%;
    max-width: 1240px;
    margin: 12px auto 30px;
    padding: 0 12px;
    box-sizing: border-box;
  }

  .store-product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .store-product-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
  }

  @media (min-width: 1100px) {
    .store-product-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
  }

  /* Empty State Container */
  .store-empty-state {
    background: var(--surface-card);
    border: var(--border-brutal-sm);
    box-shadow: var(--shadow-brutal-black);
    border-radius: var(--radius-xs);
    padding: 36px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 10px;
    margin: 20px 0;
  }

  .empty-state-icon-box {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-xs);
    background: var(--surface-elevated);
    border: 1.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    color: var(--brand-accent-primary);
  }

  .empty-state-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--text-on-dark);
    margin: 0;
  }

  .empty-state-desc {
    font-family: var(--font-primary);
    font-size: 0.8rem;
    color: var(--text-muted);
    max-width: 360px;
    line-height: 1.4;
    margin: 0;
  }

  .empty-state-reset-btn {
    margin-top: 6px;
    height: 38px;
    padding: 0 16px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.76rem;
    cursor: pointer;
  }
</style>
