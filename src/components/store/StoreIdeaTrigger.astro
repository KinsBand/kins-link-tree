---
---

<section class="store-lab-trigger-section" data-track-container="store:lab_trigger">
  <div class="store-lab-trigger-card brutal-card">
    <div class="lab-trigger-left">
      <div class="lab-icon-pulse">
        <i class="fa-solid fa-lightbulb"></i>
      </div>
      <div class="lab-text-col">
        <h4 class="lab-title">⚡ KINS MERCH LAB // FAN CONCEPTS & DESIGNS</h4>
        <p class="lab-subtitle">Have an idea for a tour hoodie, vinyl pressing, pin set, or stage gear? Propose it directly to the band.</p>
      </div>
    </div>

    <div class="lab-trigger-right">
      <button
        type="button"
        class="lab-open-btn green-link-btn brutal-press"
        id="openMerchIdeaModalBtn"
        data-action="open-merch-idea-modal"
        aria-label="Open Merch Idea Submission Modal"
      >
        <span>PROPOSE A DESIGN</span>
        <i class="fa-solid fa-arrow-right btn-arrow-slide" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</section>

<style>
  .store-lab-trigger-section {
    width: 100%;
    max-width: 1240px;
    margin: 24px auto 16px;
    padding: 0 12px;
    box-sizing: border-box;
  }

  .store-lab-trigger-card {
    background: #121216;
    border: 2px solid var(--border-brutal-sm, #000000);
    box-shadow: var(--shadow-brutal-black, 3px 3px 0px #000000);
    border-radius: var(--radius-xs, 6px);
    padding: 14px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  .store-lab-trigger-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--btn-brand-primary, #f2fd43);
  }

  .lab-trigger-left {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex: 1;
  }

  .lab-icon-pulse {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-xs, 6px);
    background: var(--surface-card, #18181c);
    border: 1.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    color: var(--brand-accent-primary, #f2fd43);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
  }

  .lab-text-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .lab-title {
    font-family: var(--font-heading, 'Syne', sans-serif);
    font-size: 0.85rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: var(--text-on-dark, #f5f5f7);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lab-subtitle {
    font-family: var(--font-primary, sans-serif);
    font-size: 0.74rem;
    color: var(--text-muted, #a1a1aa);
    margin: 0;
    line-height: 1.3;
  }

  .lab-trigger-right {
    flex-shrink: 0;
  }

  .lab-open-btn {
    height: 38px;
    padding: 0 14px;
    font-size: 0.76rem;
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .store-lab-trigger-card {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      padding: 12px 14px;
    }

    .lab-title {
      white-space: normal;
    }

    .lab-open-btn {
      width: 100%;
      height: 42px;
    }
  }
</style>
