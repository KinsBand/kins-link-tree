---
---

<section class="store-idea-section" data-track-container="store:fan_idea_submission">
  <div class="store-idea-card brutal-card">
    <header class="idea-card-header">
      <div class="idea-icon-badge">
        <i class="fa-solid fa-lightbulb"></i>
      </div>
      <div class="idea-title-wrap">
        <h3 class="idea-section-title">HAVE A MERCH IDEA? SUBMIT YOUR DESIGN</h3>
        <p class="idea-section-subtitle">Suggest concepts, apparel colorways, or custom gear you want Kins to drop next. Fan-favorite designs get produced!</p>
      </div>
    </header>

    <form class="store-idea-form" id="storeMerchIdeaForm">
      <!-- Category Tag Selector -->
      <div class="idea-form-group">
        <label class="idea-form-label">MERCH CATEGORY</label>
        <div class="idea-category-chips" role="radiogroup" aria-label="Select merch category">
          <button type="button" class="idea-cat-chip active brutal-press" data-category="T-Shirt / Apparel">
            <i class="fa-solid fa-shirt"></i> T-Shirt / Apparel
          </button>
          <button type="button" class="idea-cat-chip brutal-press" data-category="Vinyl / Physical Media">
            <i class="fa-solid fa-compact-disc"></i> Vinyl / Media
          </button>
          <button type="button" class="idea-cat-chip brutal-press" data-category="Pins & Small Swag">
            <i class="fa-solid fa-tags"></i> Small Swag / Pins
          </button>
          <button type="button" class="idea-cat-chip brutal-press" data-category="Poster / Artwork">
            <i class="fa-solid fa-palette"></i> Poster / Art
          </button>
          <button type="button" class="idea-cat-chip brutal-press" data-category="Tour Collectible">
            <i class="fa-solid fa-ticket"></i> Tour Collectible
          </button>
          <button type="button" class="idea-cat-chip brutal-press" data-category="Other Idea">
            <i class="fa-solid fa-plus"></i> Other
          </button>
        </div>
        <input type="hidden" name="ideaCategory" id="selectedIdeaCategory" value="T-Shirt / Apparel" />
      </div>

      <!-- Idea Title -->
      <div class="idea-form-group">
        <label for="ideaTitleInput" class="idea-form-label">IDEA OR ITEM TITLE</label>
        <input
          type="text"
          id="ideaTitleInput"
          name="title"
          class="idea-input"
          placeholder="e.g. Acid-Washed Genesis Tour Hoodie with Lyric Backprint"
          required
          autocomplete="off"
        />
      </div>

      <!-- Description / Concept -->
      <div class="idea-form-group">
        <label for="ideaDescInput" class="idea-form-label">DESIGN CONCEPT & DETAILS</label>
        <textarea
          id="ideaDescInput"
          name="description"
          class="idea-textarea"
          rows="3"
          placeholder="Describe your design, colors, fabric style, artwork elements, or why fans would love it..."
          required
        ></textarea>
      </div>

      <!-- Two-Column Fields: Reference Link + Contact -->
      <div class="idea-form-row">
        <div class="idea-form-group flex-1">
          <label for="ideaLinkInput" class="idea-form-label">
            MOCKUP / REFERENCE LINK <span class="optional-tag">(Optional)</span>
          </label>
          <input
            type="url"
            id="ideaLinkInput"
            name="link"
            class="idea-input"
            placeholder="https://imgur.com/..., Pinterest, or Drive link"
            autocomplete="off"
          />
        </div>

        <div class="idea-form-group flex-1">
          <label for="ideaContactInput" class="idea-form-label">YOUR SOCIAL HANDLE OR EMAIL</label>
          <input
            type="text"
            id="ideaContactInput"
            name="contact"
            class="idea-input"
            placeholder="e.g. @yourhandle or name@email.com"
            required
            autocomplete="off"
          />
        </div>
      </div>

      <!-- Submit CTA -->
      <div class="idea-actions-row">
        <button type="submit" class="submit-idea-btn green-link-btn brutal-press" id="submitMerchIdeaBtn">
          <span>SUBMIT DESIGN IDEA</span>
          <i class="fa-solid fa-paper-plane btn-arrow-slide" aria-hidden="true"></i>
        </button>
      </div>
    </form>

    <!-- Success View -->
    <div class="idea-success-box" id="ideaSuccessBox" style="display: none;">
      <div class="idea-success-icon">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      <h4 class="idea-success-title">DESIGN SUBMISSION RECEIVED!</h4>
      <p class="idea-success-desc">Thank you for sharing your merch concept with Kins! The band reviews all fan designs for upcoming drop capsules.</p>
      <button type="button" class="idea-submit-another-btn card-action-btn brutal-press" id="ideaSubmitAnotherBtn">
        <i class="fa-solid fa-rotate-left"></i>
        <span>SUBMIT ANOTHER IDEA</span>
      </button>
    </div>
  </div>
</section>

<style>
  .store-idea-section {
    width: 100%;
    max-width: 1240px;
    margin: 30px auto 20px;
    padding: 0 12px;
    box-sizing: border-box;
  }

  .store-idea-card {
    background: var(--surface-card);
    border: var(--border-brutal);
    box-shadow: var(--shadow-brutal-black);
    border-radius: var(--radius-sm);
    padding: clamp(16px, 3vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-sizing: border-box;
  }

  .idea-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 2px solid #000000;
    padding-bottom: 14px;
  }

  .idea-icon-badge {
    width: 44px;
    height: 44px;
    background: var(--btn-brand-primary);
    color: var(--btn-brand-text);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-xs);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .idea-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .idea-section-title {
    font-family: var(--font-heading);
    font-size: clamp(0.95rem, 2.2vw, 1.25rem);
    font-weight: 900;
    color: var(--text-on-dark);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .idea-section-subtitle {
    font-family: var(--font-primary);
    font-size: clamp(0.74rem, 1.4vw, 0.84rem);
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0;
  }

  /* Form */
  .store-idea-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .idea-form-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .idea-form-row {
    display: flex;
    gap: 12px;
  }

  .flex-1 {
    flex: 1;
    min-width: 0;
  }

  .idea-form-label {
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .optional-tag {
    font-weight: 500;
    color: var(--text-muted);
    font-size: 0.62rem;
  }

  .idea-category-chips {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 2px;
  }

  .idea-category-chips::-webkit-scrollbar {
    display: none;
  }

  .idea-cat-chip {
    background: var(--surface-input);
    color: var(--text-card-primary);
    border: 1.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    border-radius: var(--radius-xs);
    padding: 5px 10px;
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
    transition: transform 0.14s var(--ease-tactile), background-color 0.14s ease;
  }

  .idea-cat-chip:hover {
    background: var(--surface-card-panel-hover);
  }

  .idea-cat-chip.active {
    background: var(--btn-brand-primary);
    color: var(--btn-brand-text);
  }

  .idea-input {
    width: 100%;
    height: 38px;
    background: var(--surface-input);
    color: var(--text-card-primary);
    border: var(--border-brutal-sm);
    border-radius: var(--radius-xs);
    padding: 0 12px;
    font-family: var(--font-primary);
    font-size: 0.8rem;
    box-sizing: border-box;
    box-shadow: 1.5px 1.5px 0px #000000;
  }

  .idea-input:focus,
  .idea-textarea:focus {
    outline: 2px solid var(--brand-accent-primary);
    outline-offset: 1px;
  }

  .idea-textarea {
    width: 100%;
    background: var(--surface-input);
    color: var(--text-card-primary);
    border: var(--border-brutal-sm);
    border-radius: var(--radius-xs);
    padding: 8px 12px;
    font-family: var(--font-primary);
    font-size: 0.8rem;
    line-height: 1.4;
    resize: vertical;
    box-sizing: border-box;
    box-shadow: 1.5px 1.5px 0px #000000;
  }

  .idea-actions-row {
    margin-top: 4px;
  }

  .submit-idea-btn {
    width: 100%;
    height: 44px;
    font-size: 0.82rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    border-radius: var(--radius-xs);
  }

  /* Success Box */
  .idea-success-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 24px 16px;
    gap: 10px;
    background: var(--surface-card-panel);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-xs);
  }

  .idea-success-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #53fc18;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
  }

  .idea-success-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 900;
    color: var(--text-card-primary);
    margin: 0;
  }

  .idea-success-desc {
    font-family: var(--font-primary);
    font-size: 0.82rem;
    color: var(--text-card-secondary);
    max-width: 420px;
    line-height: 1.4;
    margin: 0;
  }

  .idea-submit-another-btn {
    margin-top: 4px;
    height: 36px;
    padding: 0 14px;
    font-size: 0.74rem;
    border-radius: var(--radius-xs);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 640px) {
    .idea-form-row {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
