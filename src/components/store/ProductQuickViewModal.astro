---
---

<!-- Modal Backdrop -->
<div class="quick-view-backdrop" id="quickViewBackdrop" aria-hidden="true"></div>

<!-- Quick View Modal Container -->
<div
  class="product-quick-view-modal"
  id="productQuickViewModal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="quickViewTitle"
  data-track-container="store:quick_view_modal"
>
  <div class="quick-view-card brutal-card">
    <!-- Floating Close Button -->
    <button
      type="button"
      class="quick-view-close-btn brutal-press"
      id="closeQuickViewBtn"
      aria-label="Close product quick view"
      title="Close"
    >
      <i class="fa-solid fa-xmark"></i>
    </button>

    <div class="quick-view-body-grid">
      <!-- Media Showcase -->
      <div class="quick-view-media-col">
        <div class="quick-view-img-box">
          <img src="" alt="" id="quickViewMainImg" class="quick-view-img" />
          <div class="tape-badge quick-view-tape-badge" id="quickViewBadge" style="display: none;"></div>
        </div>
      </div>

      <!-- Details & Actions -->
      <div class="quick-view-details-col">
        <header class="quick-view-header">
          <h2 class="quick-view-title" id="quickViewTitle"></h2>
          <p class="quick-view-subtitle" id="quickViewSubtitle"></p>

          <div class="quick-view-price-row">
            <span class="quick-view-price-current" id="quickViewPrice"></span>
            <span class="quick-view-price-compare" id="quickViewComparePrice" style="display: none;"></span>
          </div>
        </header>

        <div class="quick-view-divider"></div>

        <p class="quick-view-desc" id="quickViewDesc"></p>

        <!-- Variants Selection -->
        <div class="quick-view-variants-section">
          <label class="quick-view-field-label">SELECT VARIANT / SIZE:</label>
          <div class="quick-view-variants-grid" id="quickViewVariants"></div>
        </div>

        <!-- Specifications / Tracklist -->
        <div class="quick-view-specs-section">
          <label class="quick-view-field-label">SPECIFICATIONS & DETAILS:</label>
          <ul class="quick-view-specs-list" id="quickViewSpecsList"></ul>
        </div>

        <!-- Add to Bag CTA -->
        <div class="quick-view-actions-row">
          <button type="button" class="quick-view-add-btn green-link-btn brutal-press" id="quickViewAddBtn">
            <span>ADD TO SHOPPING BAG</span>
            <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .quick-view-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(4px);
    z-index: 990;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .product-quick-view-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    z-index: 991;
    box-sizing: border-box;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .product-quick-view-modal.is-open,
  .product-quick-view-modal.is-open + .quick-view-backdrop,
  .quick-view-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .quick-view-card {
    background: var(--surface-card);
    border: var(--border-brutal);
    box-shadow: var(--shadow-brutal-black-lg);
    border-radius: var(--radius-md);
    width: 100%;
    max-width: 820px;
    max-height: 90vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    position: relative;
    padding: clamp(20px, 3.5vw, 36px);
    box-sizing: border-box;
  }

  .quick-view-close-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 38px;
    height: 38px;
    background: var(--surface-card-panel);
    color: var(--text-card-primary);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-xs);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    cursor: pointer;
    z-index: 10;
  }

  .quick-view-body-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 28px;
    align-items: flex-start;
  }

  /* Media column */
  .quick-view-media-col {
    position: relative;
  }

  .quick-view-img-box {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #141418;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-xs);
    position: relative;
    overflow: hidden;
  }

  .quick-view-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .quick-view-tape-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--btn-brand-primary);
    color: var(--btn-brand-text);
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    padding: 3px 10px;
    border: 1.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    transform: rotate(-2deg);
    border-radius: 3px;
  }

  /* Details Column */
  .quick-view-details-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .quick-view-title {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    font-weight: 900;
    color: var(--text-on-dark);
    line-height: 1.2;
    margin: 0;
    padding-right: 32px;
  }

  .quick-view-subtitle {
    font-family: var(--font-primary);
    font-size: 0.82rem;
    color: var(--text-muted);
    margin: 4px 0 0;
  }

  .quick-view-price-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-top: 8px;
  }

  .quick-view-price-current {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 900;
    color: var(--brand-accent-primary);
  }

  .quick-view-price-compare {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--text-muted);
    text-decoration: line-through;
  }

  .quick-view-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
  }

  .quick-view-desc {
    font-family: var(--font-primary);
    font-size: 0.85rem;
    color: var(--text-on-dark);
    line-height: 1.5;
    margin: 0;
  }

  .quick-view-field-label {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 900;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 6px;
  }

  /* Variants */
  .quick-view-variants-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  :global(.quick-view-variant-chip) {
    background: var(--surface-card-panel);
    color: var(--text-card-primary);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-xs);
    padding: 6px 14px;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
    transition: transform 0.14s var(--ease-tactile), background-color 0.14s ease;
  }

  :global(.quick-view-variant-chip.active) {
    background: var(--btn-brand-primary);
    color: var(--btn-brand-text);
  }

  :global(.quick-view-variant-chip.disabled) {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* Specs list */
  .quick-view-specs-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  :global(.quick-view-specs-list li) {
    font-family: var(--font-primary);
    font-size: 0.78rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  :global(.quick-view-specs-list li i) {
    color: var(--brand-accent-primary);
    font-size: 0.7rem;
  }

  /* Add to Bag CTA */
  .quick-view-actions-row {
    margin-top: 10px;
  }

  .quick-view-add-btn {
    width: 100%;
    height: 48px;
    font-size: 0.86rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    cursor: pointer;
  }

  @media (max-width: 767px) {
    .product-quick-view-modal {
      padding: 0;
      align-items: flex-end;
    }

    .quick-view-card {
      border-radius: var(--radius-md) var(--radius-md) 0 0;
      border-bottom: none;
      max-height: 85vh;
      padding: 24px 16px;
    }

    .quick-view-body-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
