---
import { epkConfig } from '../../settings/epk.config';
const baseUrl = import.meta.env.BASE_URL;
---

<footer class="epk-site-footer">
  <div class="epk-footer-inner-card">
    <div class="epk-footer-badge-row">
      <span class="epk-footer-brand-badge">
        <i class="fa-solid fa-compact-disc epk-footer-brand-icon"></i>
        <span class="epk-footer-copyright-text">@<span id="epkCopyrightYear">2026</span> {epkConfig.bandName}.</span>
      </span>
    </div>

    <nav class="epk-footer-nav" aria-label="EPK Footer Navigation">
      <a href={baseUrl} class="epk-footer-link">
        <i class="fa-solid fa-arrow-left"></i> Return to Link-in-Bio
      </a>
      <span class="footer-dot-sep">•</span>
      <a href="#epk-hero" class="epk-footer-link">
        <i class="fa-solid fa-arrow-up"></i> Back to Top
      </a>
      <span class="footer-dot-sep">•</span>
      <a href="#epk-downloads" class="epk-footer-link">
        <i class="fa-solid fa-download"></i> Production Deck
      </a>
    </nav>

    <div class="epk-footer-theme-toggle-wrap">
      <button type="button" id="themeToggleBtn" class="footer-theme-toggle-btn" aria-label="Toggle display theme" aria-pressed="false">
        <span class="theme-toggle-icon-badge">
          <i class="theme-toggle-icon fa-solid fa-sun" id="themeToggleIcon"></i>
        </span>
        <span class="theme-toggle-label" id="themeToggleLabel">Light Mode</span>
      </button>
    </div>
  </div>
</footer>

<style>
  .epk-site-footer {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40px 16px 60px;
    position: relative;
    z-index: 10;
    box-sizing: border-box;
    background: #111114;
    border-top: 3px solid #000000;
  }

  .epk-footer-inner-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    text-align: center;
  }

  .epk-footer-badge-row {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .epk-footer-brand-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    background: #18181b;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    padding: 5px 14px;
    border-radius: 6px;
    user-select: none;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .epk-footer-brand-badge:hover {
    background: #27272a;
    transform: translateY(-1px);
  }

  .epk-footer-brand-icon {
    font-size: 0.8rem;
    color: var(--accent-neon-yellow);
  }

  .epk-footer-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 12px;
  }

  .epk-footer-link {
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.16s ease;
  }

  .epk-footer-link:hover {
    color: var(--accent-neon-yellow);
  }

  .footer-dot-sep {
    color: rgba(255, 255, 255, 0.25);
    font-size: 0.7rem;
  }

  .epk-footer-theme-toggle-wrap {
    width: 100%;
    margin-top: 6px;
  }

  .footer-theme-toggle-btn {
    width: 100%;
    min-height: 48px;
    background: var(--surface-card-light);
    color: var(--text-card-primary);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 8px;
    padding: 10px 18px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    user-select: none;
    box-sizing: border-box;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
  }

  .footer-theme-toggle-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px #000000;
  }

  .theme-toggle-icon-badge {
    width: 28px;
    height: 28px;
    min-width: 28px;
    min-height: 28px;
    border-radius: 6px;
    background: var(--accent-neon-yellow);
    border: 2px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s var(--ease-snappy);
  }

  .theme-toggle-icon {
    font-size: 0.85rem;
    color: #000000;
    line-height: 1;
  }

  .theme-toggle-label {
    font-family: var(--font-secondary);
    font-size: 0.84rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-card-primary);
    line-height: 1;
  }
</style>
