---
import { epkConfig } from '../../settings/epk.config';
const baseUrl = import.meta.env.BASE_URL;
---

<footer class="epk-site-footer">
  <div class="epk-footer-inner-card">
    <div class="epk-footer-badge-row">
      <span class="epk-footer-brand-badge">
        <i class="fa-solid fa-compact-disc epk-footer-brand-icon"></i>
        <span class="epk-footer-copyright-text">@<span id="epkCopyrightYear">2026</span> {epkConfig.bandName}.</span>
      </span>
    </div>

    <nav class="epk-footer-nav" aria-label="EPK Footer Navigation">
      <a href={baseUrl} class="epk-footer-link">
        <i class="fa-solid fa-arrow-left"></i> Return to Link-in-Bio
      </a>
      <span class="footer-dot-sep">•</span>
      <a href="#epk-hero" class="epk-footer-link">
        <i class="fa-solid fa-arrow-up"></i> Back to Top
      </a>
      <span class="footer-dot-sep">•</span>
      <a href="#epk-downloads" class="epk-footer-link">
        <i class="fa-solid fa-download"></i> Production Deck
      </a>
    </nav>

    <div class="epk-footer-theme-toggle-wrap">
      <div class="footer-theme-toggle-btn" id="themeToggleBtn" role="group" aria-label="Toggle Display Theme">
        <span class="theme-current-title" id="themeCurrentTitle">Light</span>
        <div class="theme-pill-segmented" role="radiogroup" aria-label="Select theme mode">
          <button type="button" class="theme-pill-btn active" id="themePillLightBtn" data-theme-target="standard" aria-label="Light Mode" title="Switch to Light Mode">
            <i class="fa-solid fa-sun" aria-hidden="true"></i>
          </button>
          <button type="button" class="theme-pill-btn" id="themePillDarkBtn" data-theme-target="dark" aria-label="Dark Mode" title="Switch to Dark Mode">
            <i class="fa-solid fa-moon" aria-hidden="true"></i>
          </button>
        </div>
        <span class="theme-mode-label">Mode</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .epk-site-footer {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40px 16px 60px;
    position: relative;
    z-index: 10;
    box-sizing: border-box;
    background: #111114;
    border-top: 3px solid #000000;
  }

  .epk-footer-inner-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    text-align: center;
  }

  .epk-footer-badge-row {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .epk-footer-brand-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    background: #18181b;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    padding: 5px 14px;
    border-radius: 6px;
    user-select: none;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .epk-footer-brand-badge:hover {
    background: #27272a;
    transform: translateY(-1px);
  }

  .epk-footer-brand-icon {
    font-size: 0.8rem;
    color: var(--accent-neon-yellow);
  }

  .epk-footer-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 12px;
  }

  .epk-footer-link {
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.16s ease;
  }

  .epk-footer-link:hover {
    color: var(--accent-neon-yellow);
  }

  .footer-dot-sep {
    color: rgba(255, 255, 255, 0.25);
    font-size: 0.7rem;
  }

  .epk-footer-theme-toggle-wrap {
    width: 100%;
    margin-top: 6px;
  }

  .footer-theme-toggle-btn {
    width: 100%;
    min-height: 48px;
    background: var(--surface-card-light);
    color: var(--text-card-primary);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 8px;
    padding: 6px 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    user-select: none;
    box-sizing: border-box;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
  }

  .footer-theme-toggle-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px #000000;
  }

  .footer-theme-toggle-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .theme-current-title {
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.92rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-card-primary);
    flex: 1 1 0;
    text-align: left;
  }

  .theme-pill-segmented {
    display: inline-flex;
    align-items: center;
    background: var(--surface-input);
    border: 2px solid #000000;
    border-radius: 20px;
    padding: 3px;
    gap: 3px;
    box-shadow: 1.5px 1.5px 0px #000000;
    flex: 0 0 auto;
  }

  .theme-pill-btn {
    width: 30px;
    height: 30px;
    min-width: 30px;
    min-height: 30px;
    border-radius: 50%;
    border: 1.5px solid transparent;
    background: transparent;
    color: var(--text-card-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    margin: 0;
    font-size: 0.82rem;
    transition: transform 0.16s var(--ease-tactile), background-color 0.18s ease, color 0.18s ease, box-shadow 0.16s ease;
  }

  .theme-pill-btn:hover {
    color: var(--text-card-primary);
    transform: scale(1.1);
  }

  .theme-pill-btn.active {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
    box-shadow: 1px 1px 0px #000000;
    transform: scale(1.06);
  }

  .theme-mode-label {
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-card-secondary);
    flex: 1 1 0;
    text-align: right;
  }
</style>
