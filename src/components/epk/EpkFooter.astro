---
import { epkConfig } from '../../settings/epk.config';
const baseUrl = import.meta.env.BASE_URL;
---

<footer class="epk-site-footer">
  <div class="epk-footer-inner-card">
    <!-- Row 1: Full-Width Theme Selector Segmented Control (Top Row of Footer) -->
    <div class="epk-footer-theme-toggle-wrap">
      <div 
        class="footer-theme-toggle-btn" 
        id="themeToggleBtn" 
        role="group" 
        aria-label="Toggle Display Theme"
      >
        <span class="theme-current-title" id="themeCurrentTitle">Light</span>
        <div class="theme-pill-segmented" role="radiogroup" aria-label="Select theme mode">
          <button 
            type="button" 
            class="theme-pill-btn active theme-pill-light" 
            id="themePillLightBtn" 
            data-theme-target="standard" 
            aria-label="Light Mode" 
            title="Switch to Light Mode"
          >
            <i class="fa-solid fa-sun" aria-hidden="true"></i>
          </button>
          <button 
            type="button" 
            class="theme-pill-btn theme-pill-dark" 
            id="themePillDarkBtn" 
            data-theme-target="dark" 
            aria-label="Dark Mode" 
            title="Switch to Dark Mode"
          >
            <i class="fa-solid fa-moon" aria-hidden="true"></i>
          </button>
        </div>
        <span class="theme-mode-label">Mode</span>
      </div>
    </div>

    <!-- Row 2: Official Band Copyright Badge -->
    <div class="epk-footer-badge-row">
      <span class="epk-footer-brand-badge">
        <i class="fa-solid fa-compact-disc epk-footer-brand-icon" aria-hidden="true"></i>
        <span class="epk-footer-copyright-text">@<span id="epkCopyrightYear">2026</span> {epkConfig.bandName}.</span>
      </span>
    </div>

    <!-- Row 3: Compact Single-Row Navigation: [KINS!] • [TOP] • [FEEDBACK] • [LEGAL] -->
    <nav class="epk-footer-nav" aria-label="EPK Footer Navigation">
      <a href={baseUrl} class="epk-footer-item epk-footer-link brutal-press" title="Return to KINS Link-in-Bio">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
        <span>KINS!</span>
      </a>

      <span class="footer-dot-sep" aria-hidden="true">•</span>

      <a href="#epk-hero" class="epk-footer-item epk-footer-link brutal-press" id="epkBackToTopBtn" title="Back to Top">
        <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
        <span>TOP</span>
      </a>

      <span class="footer-dot-sep" aria-hidden="true">•</span>

      <button 
        type="button" 
        class="epk-footer-item epk-footer-btn open-feedback-trigger brutal-press" 
        id="openFeedbackFooterBtn" 
        data-open-feedback
        title="Open Feedback Modal"
      >
        FEEDBACK
      </button>

      <span class="footer-dot-sep" aria-hidden="true">•</span>

      <button 
        type="button" 
        class="epk-footer-item epk-footer-btn open-legal-trigger brutal-press" 
        id="openLegalFooterBtn" 
        title="Open Legal & Policies Modal"
      >
        LEGAL
      </button>
    </nav>
  </div>
</footer>

<style>
  .epk-site-footer {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 36px 16px 64px;
    position: relative;
    z-index: 10;
    box-sizing: border-box;
    background: #111114;
    border-top: 3px solid #000000;
  }

  .epk-footer-inner-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    text-align: center;
  }

  /* Full-Width Theme Selector Segmented Control (Top Row) */
  .epk-footer-theme-toggle-wrap {
    width: 100%;
    margin-bottom: 2px;
  }

  .footer-theme-toggle-btn {
    width: 100%;
    min-height: 48px;
    background: var(--surface-card-light);
    color: var(--text-card-primary);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 8px;
    padding: 6px 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    user-select: none;
    box-sizing: border-box;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
  }

  .footer-theme-toggle-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px #000000;
  }

  .footer-theme-toggle-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .theme-current-title {
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.92rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-card-primary);
    flex: 1 1 0;
    text-align: left;
  }

  .theme-pill-segmented {
    display: inline-flex;
    align-items: center;
    background: var(--surface-input);
    border: 2px solid #000000;
    border-radius: 20px;
    padding: 3px;
    gap: 3px;
    box-shadow: 1.5px 1.5px 0px #000000;
    flex: 0 0 auto;
  }

  .theme-pill-btn {
    width: 30px;
    height: 30px;
    min-width: 30px;
    min-height: 30px;
    border-radius: 50%;
    border: 1.5px solid transparent;
    background: transparent;
    color: var(--text-card-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    margin: 0;
    font-size: 0.82rem;
    transition: transform 0.16s var(--ease-tactile), background-color 0.18s ease, color 0.18s ease, box-shadow 0.16s ease;
  }

  .theme-pill-btn:hover {
    color: var(--text-card-primary);
    transform: scale(1.1);
  }

  .theme-pill-btn.active {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
    box-shadow: 1px 1px 0px #000000;
    transform: scale(1.06);
  }

  .theme-mode-label {
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-card-secondary);
    flex: 1 1 0;
    text-align: right;
  }

  /* Official Brand Badge */
  .epk-footer-badge-row {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .epk-footer-brand-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    background: #18181b;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: #ffffff;
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    padding: 5px 14px;
    border-radius: 6px;
    user-select: none;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .epk-footer-brand-badge:hover {
    background: #27272a;
    transform: translateY(-1px);
  }

  .epk-footer-brand-icon {
    font-size: 0.8rem;
    color: var(--accent-neon-yellow);
  }

  /* Compact Single-Row Navigation: [KINS!] • [TOP] • [FEEDBACK] • [LEGAL] */
  .epk-footer-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: nowrap;
    gap: 8px 12px;
    max-width: 100%;
    margin: 2px auto 0;
  }

  .epk-footer-item {
    background: transparent;
    border: none;
    color: #a1a1aa;
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 4px;
    text-decoration: none;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    white-space: nowrap;
    user-select: none;
    transition: color 0.16s ease, background-color 0.16s ease, transform 0.16s var(--ease-tactile);
  }

  .epk-footer-item:hover,
  .epk-footer-item:focus-visible {
    color: var(--accent-neon-yellow);
    background: rgba(255, 255, 255, 0.07);
    outline: none;
    transform: translateY(-1px);
  }

  .epk-footer-item:active {
    transform: translateY(1px);
  }

  .footer-dot-sep {
    color: rgba(255, 255, 255, 0.28);
    font-size: 10px;
    line-height: 1;
    flex-shrink: 0;
    user-select: none;
  }

  @media (max-width: 480px) {
    .epk-footer-nav {
      gap: 4px 6px;
    }
    .epk-footer-item {
      font-size: 0.68rem;
      padding: 3px 6px;
      letter-spacing: 0.04em;
    }
  }
</style>
