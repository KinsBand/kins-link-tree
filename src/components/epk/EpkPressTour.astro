---
import { epkConfig } from '../../settings/epk.config';
const { pressQuotes, tourDates } = epkConfig;
---

<section class="epk-section epk-press-tour-section" id="epk-press">
  <div class="epk-section-header">
    <div class="epk-header-tag">
      <i class="fa-solid fa-star"></i> PRAISE & TOURS
    </div>
    <h2 class="epk-section-title">Press & Tour</h2>
    <p class="epk-section-subtitle">Critical acclaim and upcoming live show dates.</p>
  </div>

  <!-- 1. Critical Praise Quote Cards -->
  <div class="epk-quotes-wrapper">
    <div class="epk-quotes-grid">
      {pressQuotes.map((item) => (
        <div class="epk-quote-card">
          <div class="quote-card-top">
            <span class="quote-badge">{item.badge}</span>
            <div class="quote-stars">
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
            </div>
          </div>

          <blockquote class="quote-text-body">
            "{item.quote}"
          </blockquote>

          <div class="quote-citation">
            <span class="citation-publication">{item.publication}</span>
            <span class="citation-author">{item.author}</span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- 2. Tactile Neo-Brutalist Tour Container -->
  <div class="epk-tour-container">
    <div class="tour-header-strip">
      <div class="tour-title-box">
        <i class="fa-solid fa-calendar-days tour-icon"></i>
        <h3 class="tour-title">Live Tour</h3>
      </div>
      <span class="tour-live-status"><span class="pulse-dot"></span> 2026 LIVE</span>
    </div>

    <!-- Tour Items Stack -->
    <div class="epk-tour-list">
      {tourDates.map((show) => {
        // Parse date for calendar badge (e.g. "SAT MAR 28, 2026" -> Day "28", Month "MAR", DayOfWeek "SAT")
        const parts = show.date.split(' ');
        const dayOfWeek = parts[0] || 'TBD';
        const month = parts[1] || 'MAR';
        const dayNum = parts[2]?.replace(',', '') || '28';
        
        return (
          <div class="epk-tour-item-card">
            <!-- Left: Calendar Block -->
            <div class="tour-item-date-badge">
              <span class="tour-badge-month">{month}</span>
              <span class="tour-badge-day">{dayNum}</span>
              <span class="tour-badge-dow">{dayOfWeek}</span>
            </div>

            <!-- Center: Venue & City -->
            <div class="tour-item-info">
              <div class="tour-venue-row">
                <h4 class="tour-venue-name">{show.venue}</h4>
                {show.status === 'selling_fast' && (
                  <span class="status-pill status-selling-fast">Selling Fast</span>
                )}
                {show.status === 'tickets_available' && (
                  <span class="status-pill status-available">Available</span>
                )}
                {show.status === 'sold_out' && (
                  <span class="status-pill status-sold-out">Sold Out</span>
                )}
              </div>
              <div class="tour-city-row">
                <span class="tour-city-name"><i class="fa-solid fa-location-dot"></i> {show.city}</span>
              </div>
            </div>

            <!-- Right: Action Button -->
            <div class="tour-item-action">
              <a 
                href={show.ticketsUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="tour-ticket-btn"
                title={`Tickets for ${show.venue} in ${show.city}`}
              >
                <i class="fa-solid fa-ticket"></i>
                <span>Get Tickets</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Tour Booking Inquiries Footer Strip -->
    <div class="tour-booking-strip">
      <span class="tour-booking-note"><i class="fa-solid fa-microphone-lines"></i> For festival bookings & routing inquiries:</span>
      <div class="tour-booking-actions">
        <!-- Copy Email Button -->
        <button 
          type="button" 
          class="epk-email-copy-btn tour-email-copy-btn" 
          data-email="booking@kinsband.com" 
          title="Copy booking@kinsband.com to clipboard"
        >
          <i class="fa-solid fa-copy"></i>
          <span class="copy-email-text">booking@kinsband.com</span>
          <span class="copy-badge">Copy</span>
        </button>

        <!-- Open Email Button -->
        <a 
          href="mailto:booking@kinsband.com?subject=Tour%20%26%20Festival%20Booking%20Inquiry%20-%20KINS" 
          class="tour-email-open-btn" 
          title="Open email to booking@kinsband.com"
        >
          <i class="fa-solid fa-paper-plane"></i>
          <span>Send Email</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .epk-section {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 48px 14px;
    box-sizing: border-box;
    border-bottom: 3px solid #000000;
  }

  /* Left-aligned Section Header */
  .epk-section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    margin-bottom: 24px;
    gap: 6px;
    width: 100%;
  }

  .epk-header-tag {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 8px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    width: fit-content;
  }

  .epk-section-title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    font-weight: 900;
    color: var(--text-white);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .epk-section-subtitle {
    font-family: var(--font-primary);
    font-size: 0.88rem;
    color: var(--text-muted);
    max-width: 600px;
    line-height: 1.4;
    margin: 0;
  }

  /* 1. Critical Praise Quotes */
  .epk-quotes-wrapper {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    padding-bottom: 8px;
    margin-bottom: 24px;
    box-sizing: border-box;
  }

  .epk-quotes-grid {
    display: flex;
    flex-direction: row;
    gap: 12px;
    scroll-snap-type: x mandatory;
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .epk-quotes-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      scroll-snap-type: none;
    }
  }

  .epk-quote-card {
    flex: 0 0 calc(85vw - 28px);
    width: calc(85vw - 28px);
    max-width: 380px;
    scroll-snap-align: start;
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 10px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    box-sizing: border-box;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
  }

  @media (min-width: 768px) {
    .epk-quote-card {
      flex: initial;
      width: 100%;
      max-width: 100%;
    }
  }

  .epk-quote-card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px #000000;
  }

  .quote-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .quote-badge {
    background: #000000;
    color: var(--accent-neon-yellow);
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .quote-stars {
    display: flex;
    gap: 3px;
    color: #f59e0b;
    font-size: 0.75rem;
  }

  .quote-text-body {
    font-family: var(--font-primary);
    font-size: 0.9rem;
    font-weight: 500;
    font-style: italic;
    line-height: 1.5;
    color: var(--text-card-primary);
    margin: 0;
    word-break: break-word;
  }

  .quote-citation {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 10px;
    border-top: 2px dashed rgba(0, 0, 0, 0.2);
  }

  [data-theme="dark"] .quote-citation {
    border-top-color: rgba(255, 255, 255, 0.15);
  }

  .citation-publication {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 900;
    color: var(--text-card-primary);
  }

  .citation-author {
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    color: var(--text-card-secondary);
  }

  /* 2. Tactile Neo-Brutalist Tour Container */
  .epk-tour-container {
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 10px;
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
  }

  .tour-header-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    background: #141418;
    border-bottom: 3px solid #000000;
    box-sizing: border-box;
  }

  .tour-title-box {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tour-icon {
    font-size: 1rem;
    color: var(--accent-neon-yellow);
  }

  .tour-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 900;
    color: #ffffff;
    margin: 0;
  }

  .tour-live-status {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 900;
    padding: 2px 8px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    letter-spacing: 0.04em;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #16a34a;
  }

  /* Tour Items List */
  .epk-tour-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px;
    width: 100%;
    box-sizing: border-box;
    background: var(--surface-card-light);
  }

  .epk-tour-item-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px 16px;
    background: var(--surface-card-light-hover);
    color: var(--text-card-primary);
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 8px;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
    box-sizing: border-box;
    width: 100%;
  }

  .epk-tour-item-card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3.5px 3.5px 0px #000000;
  }

  @media (max-width: 600px) {
    .epk-tour-item-card {
      flex-wrap: wrap;
      padding: 12px 14px;
      gap: 10px;
    }
  }

  /* Date Badge */
  .tour-item-date-badge {
    background: #000000;
    border: 2px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    border-radius: 6px;
    padding: 4px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 52px;
    flex-shrink: 0;
  }

  .tour-badge-month {
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 900;
    color: var(--accent-neon-yellow);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
  }

  .tour-badge-day {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 900;
    color: #ffffff;
    line-height: 1.1;
    margin-top: 1px;
  }

  .tour-badge-dow {
    font-family: var(--font-secondary);
    font-size: 0.52rem;
    font-weight: 800;
    color: #a1a1aa;
    text-transform: uppercase;
    line-height: 1;
    margin-top: 1px;
  }

  /* Tour Info */
  .tour-item-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .tour-venue-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tour-venue-name {
    font-family: var(--font-heading);
    font-size: 1.02rem;
    font-weight: 900;
    color: var(--text-card-primary);
    margin: 0;
    word-break: break-word;
  }

  .status-pill {
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 900;
    text-transform: uppercase;
    padding: 2px 6px;
    border-radius: 4px;
    display: inline-block;
    border: 1px solid #000000;
  }

  .status-selling-fast {
    background: #ef4444;
    color: #ffffff;
  }

  .status-available {
    background: #22c55e;
    color: #000000;
  }

  .status-sold-out {
    background: #71717a;
    color: #ffffff;
  }

  .tour-city-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: var(--text-card-secondary);
    font-weight: 600;
  }

  .tour-city-name {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .tour-city-name i {
    color: #000000;
    font-size: 0.74rem;
  }

  [data-theme="dark"] .tour-city-name i {
    color: var(--accent-neon-yellow);
  }

  /* Tour Action Button */
  .tour-item-action {
    flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .tour-item-action {
      width: 100%;
      margin-top: 4px;
    }
  }

  .tour-ticket-btn {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 8px 14px;
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  @media (max-width: 600px) {
    .tour-ticket-btn {
      width: 100%;
      padding: 10px 14px;
      box-sizing: border-box;
    }
  }

  .tour-ticket-btn:hover {
    background: var(--surface-card-light-hover);
    color: var(--text-card-primary);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  /* Tour Booking Footer Strip */
  .tour-booking-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding: 14px 18px;
    background: rgba(0, 0, 0, 0.06);
    border-top: 2px dashed rgba(0, 0, 0, 0.25);
    box-sizing: border-box;
  }

  [data-theme="dark"] .tour-booking-strip {
    background: rgba(255, 255, 255, 0.03);
    border-top-color: rgba(255, 255, 255, 0.15);
  }

  .tour-booking-note {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--text-card-primary);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .tour-booking-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .epk-email-copy-btn {
    background: var(--surface-card-light);
    color: var(--text-card-primary);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 7px 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 800;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }

  .epk-email-copy-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .copy-badge {
    background: #000000;
    color: var(--accent-neon-yellow);
    font-family: var(--font-secondary);
    font-size: 0.55rem;
    font-weight: 900;
    padding: 2px 5px;
    border-radius: 3px;
    text-transform: uppercase;
  }

  .tour-email-open-btn {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 7px 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }

  .tour-email-open-btn:hover {
    background: var(--surface-card-light-hover);
    color: var(--text-card-primary);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }
</style>
