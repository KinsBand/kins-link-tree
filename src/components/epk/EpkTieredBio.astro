---
import { epkConfig } from '../../settings/epk.config';
const { bios } = epkConfig;
---

<section class="epk-section epk-bio-section" id="epk-bio">
  <div class="epk-section-header">
    <div class="epk-header-tag">
      <i class="fa-solid fa-file-lines"></i> BIOS
    </div>
    <h2 class="epk-section-title">Biographies</h2>
    <p class="epk-section-subtitle">Third-person press bios for event programs and editorial.</p>
  </div>

  <div class="epk-bio-container">
    <!-- Bio Tier Tabs -->
    <div class="epk-bio-tabs-bar" role="tablist">
      <button 
        type="button" 
        class="epk-bio-tab-btn is-active" 
        data-bio-tier="elevator"
        role="tab"
        aria-selected="true"
      >
        <span class="tab-title">Elevator Pitch</span>
        <span class="tab-word-count">42 Words</span>
      </button>

      <button 
        type="button" 
        class="epk-bio-tab-btn" 
        data-bio-tier="short"
        role="tab"
        aria-selected="false"
      >
        <span class="tab-title">Short Bio</span>
        <span class="tab-word-count">135 Words</span>
      </button>

      <button 
        type="button" 
        class="epk-bio-tab-btn" 
        data-bio-tier="full"
        role="tab"
        aria-selected="false"
      >
        <span class="tab-title">Full Bio</span>
        <span class="tab-word-count">385 Words</span>
      </button>
    </div>

    <!-- Bio Panels Container -->
    <div class="epk-bio-panels-wrap">
      <!-- 1. Elevator Pitch Panel -->
      <div class="epk-bio-panel fade-in-active" data-bio-panel="elevator">
        <div class="bio-panel-top">
          <span class="tier-badge">ELEVATOR PITCH (42 WORDS)</span>
          <button 
            type="button" 
            class="epk-copy-bio-btn" 
            data-copy-text={bios.elevator.text}
            data-tier-name="Elevator Pitch"
            aria-label="Copy elevator pitch to clipboard"
          >
            <i class="fa-regular fa-copy"></i> Copy Text
          </button>
        </div>

        <div class="bio-text-box">
          <p class="bio-paragraph">{bios.elevator.text}</p>
        </div>
      </div>

      <!-- 2. Short Biography Panel -->
      <div class="epk-bio-panel hidden" data-bio-panel="short">
        <div class="bio-panel-top">
          <span class="tier-badge">SHORT BIOGRAPHY (135 WORDS)</span>
          <button 
            type="button" 
            class="epk-copy-bio-btn" 
            data-copy-text={bios.short.text}
            data-tier-name="Short Biography"
            aria-label="Copy short biography to clipboard"
          >
            <i class="fa-regular fa-copy"></i> Copy Text
          </button>
        </div>

        <div class="bio-text-box">
          {bios.short.text.split('\n\n').map(p => (
            <p class="bio-paragraph">{p}</p>
          ))}
        </div>
      </div>

      <!-- 3. Full Biography Panel -->
      <div class="epk-bio-panel hidden" data-bio-panel="full">
        <div class="bio-panel-top">
          <span class="tier-badge">FULL BIOGRAPHY (385 WORDS)</span>
          <button 
            type="button" 
            class="epk-copy-bio-btn" 
            data-copy-text={bios.full.text}
            data-tier-name="Full Biography"
            aria-label="Copy full biography to clipboard"
          >
            <i class="fa-regular fa-copy"></i> Copy Text
          </button>
        </div>

        <div class="bio-text-box">
          {bios.full.text.split('\n\n').map(p => (
            <p class="bio-paragraph">{p}</p>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .epk-section {
    max-width: 1240px;
    margin: 0 auto;
    padding: 55px 16px;
    box-sizing: border-box;
    border-bottom: 3px solid #000000;
  }

  .epk-section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    margin-bottom: 28px;
    gap: 6px;
  }

  .epk-header-tag {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 8px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    width: fit-content;
  }

  .epk-section-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    font-weight: 900;
    color: var(--text-white);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .epk-section-subtitle {
    font-family: var(--font-primary);
    font-size: 0.9rem;
    color: var(--text-muted);
    max-width: 600px;
    line-height: 1.4;
    margin: 0;
  }

  .epk-bio-container {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Bio Tabs Bar */
  .epk-bio-tabs-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .epk-bio-tab-btn {
    background: var(--surface-card-light);
    color: var(--text-card-primary);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 8px 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-secondary);
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .epk-bio-tab-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .epk-bio-tab-btn.is-active {
    background: var(--accent-neon-yellow);
    color: #000000;
    box-shadow: 3px 3px 0px #000000;
    border-color: #000000;
  }

  .tab-title {
    font-size: 0.8rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .tab-word-count {
    background: #000000;
    color: #ffffff;
    font-size: 0.62rem;
    font-weight: 800;
    padding: 1px 6px;
    border-radius: 3px;
  }

  /* Bio Panels */
  .epk-bio-panels-wrap {
    width: 100%;
  }

  .epk-bio-panel {
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 10px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-sizing: border-box;
  }

  .epk-bio-panel.hidden {
    display: none;
  }

  .epk-bio-panel.fade-in-active {
    display: flex;
    animation: fadeInBio 0.2s ease forwards;
  }

  @keyframes fadeInBio {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .bio-panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding-bottom: 10px;
    border-bottom: 2px dashed rgba(0, 0, 0, 0.2);
  }

  [data-theme="dark"] .bio-panel-top {
    border-bottom-color: rgba(255, 255, 255, 0.15);
  }

  .tier-badge {
    background: #000000;
    color: var(--accent-neon-yellow);
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: 3px;
  }

  .epk-copy-bio-btn {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 6px 12px;
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .epk-copy-bio-btn:hover {
    background: var(--surface-card-light-hover);
    color: var(--text-card-primary);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .bio-text-box {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bio-paragraph {
    font-family: var(--font-primary);
    font-size: 0.95rem;
    font-weight: 450;
    line-height: 1.6;
    color: var(--text-card-primary);
    margin: 0;
  }
</style>
