---
import { epkConfig } from '../../settings/epk.config';
const baseUrl = import.meta.env.BASE_URL;
---

<section class="epk-section epk-video-section" id="epk-video">
  <div class="epk-section-header">
    <div class="epk-header-tag">
      <i class="fa-solid fa-video"></i> MEDIA
    </div>
    <h2 class="epk-section-title">Video & Photos</h2>
    <p class="epk-section-subtitle">Live performances, music videos, and press photography.</p>
  </div>

  <!-- Video Showcase (Horizontal Swipe on Mobile, 2-Col on Desktop) -->
  <div class="epk-video-grid-wrapper">
    <div class="epk-video-grid">
      {epkConfig.videos.map((vid) => (
        <div class="epk-video-card">
          <div class="epk-video-card-top">
            <span class="epk-video-category">{vid.category}</span>
            <a href={vid.watchUrl} target="_blank" rel="noopener noreferrer" class="epk-youtube-link">
              <i class="fa-brands fa-youtube"></i> YouTube
            </a>
          </div>

          <div class="epk-video-frame-wrap">
            <iframe 
              src={vid.embedUrl} 
              title={vid.title}
              loading="lazy" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen
              class="epk-video-iframe"
            ></iframe>
          </div>

          <div class="epk-video-info">
            <h4 class="epk-video-title">{vid.title}</h4>
            <p class="epk-video-desc">{vid.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Press Media Kit (Horizontal Swipe on Mobile, 3-Col on Desktop) -->
  <div class="epk-press-gallery-container">
    <div class="press-gallery-header">
      <div class="press-gallery-title-box">
        <i class="fa-solid fa-images gallery-icon"></i>
        <h3 class="press-gallery-title">Press Photography</h3>
      </div>
      <span class="press-gallery-badge">300 DPI PRINT & WEB</span>
    </div>

    <div class="epk-photos-grid-wrapper">
      <div class="epk-photos-grid">
        {epkConfig.pressPhotos.map((photo) => (
          <div class="epk-photo-card">
            <div class="epk-photo-box">
              <img src={`${baseUrl}${photo.imgUrl}`} alt={photo.title} class="epk-press-img" loading="lazy" />
              <span class="epk-photo-badge">{photo.badge}</span>
            </div>

            <div class="epk-photo-details">
              <h5 class="epk-photo-title">{photo.title}</h5>
              <span class="epk-photo-type">{photo.type}</span>
              <a 
                href={`${baseUrl}${photo.downloadUrl}`} 
                download 
                class="epk-photo-download-btn"
                title="Download High-Resolution Asset"
              >
                <i class="fa-solid fa-download"></i> Download
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .epk-section {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 48px 14px;
    box-sizing: border-box;
    border-bottom: 3px solid #000000;
  }

  .epk-section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    margin-bottom: 24px;
    gap: 6px;
    width: 100%;
  }

  .epk-header-tag {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 8px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    width: fit-content;
  }

  .epk-section-title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    font-weight: 900;
    color: var(--text-white);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .epk-section-subtitle {
    font-family: var(--font-primary);
    font-size: 0.88rem;
    color: var(--text-muted);
    max-width: 600px;
    line-height: 1.4;
    margin: 0;
  }

  /* Video Grid & Horizontal Row Scroll on Mobile */
  .epk-video-grid-wrapper {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    padding-bottom: 8px;
    box-sizing: border-box;
  }

  .epk-video-grid {
    display: flex;
    flex-direction: row;
    gap: 12px;
    scroll-snap-type: x mandatory;
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .epk-video-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
      scroll-snap-type: none;
    }
  }

  .epk-video-card {
    flex: 0 0 calc(100vw - 44px);
    width: calc(100vw - 44px);
    max-width: 440px;
    scroll-snap-align: start;
    background: var(--surface-card-light);
    border: 2.5px solid #000000;
    box-shadow: 2.5px 2.5px 0px #000000;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .epk-video-card {
      flex: initial;
      width: 100%;
      max-width: 100%;
    }
  }

  .epk-video-card-top {
    padding: 8px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(0, 0, 0, 0.05);
    border-bottom: 2px solid #000000;
  }

  [data-theme="dark"] .epk-video-card-top {
    background: rgba(255, 255, 255, 0.04);
  }

  .epk-video-category {
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-card-primary);
  }

  .epk-youtube-link {
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 800;
    color: #e63946;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: opacity 0.16s ease;
  }

  .epk-youtube-link:hover {
    opacity: 0.8;
  }

  .epk-video-frame-wrap {
    position: relative;
    width: 100%;
    padding-top: 56.25%; /* 16:9 Aspect Ratio */
    background: #000000;
  }

  .epk-video-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .epk-video-info {
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    box-sizing: border-box;
  }

  .epk-video-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 900;
    color: var(--text-card-primary);
    margin: 0;
    line-height: 1.3;
    word-break: break-word;
  }

  .epk-video-desc {
    font-family: var(--font-primary);
    font-size: 0.78rem;
    color: var(--text-card-secondary);
    margin: 0;
    line-height: 1.4;
    word-break: break-word;
  }

  /* Press Photos Gallery */
  .epk-press-gallery-container {
    margin-top: 24px;
    background: rgba(18, 18, 22, 0.7);
    border: 2px solid #000000;
    box-shadow: 2.5px 2.5px 0px #000000;
    border-radius: 8px;
    padding: 14px;
    box-sizing: border-box;
    width: 100%;
  }

  .press-gallery-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1.5px solid #000000;
  }

  .press-gallery-title-box {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .gallery-icon {
    font-size: 1rem;
    color: var(--accent-neon-yellow);
  }

  .press-gallery-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 900;
    color: var(--text-white);
    margin: 0;
  }

  .press-gallery-badge {
    background: var(--surface-card-light);
    color: var(--text-card-primary);
    border: 1.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    padding: 2px 6px;
  }

  /* Photos Horizontal Swipe on Mobile */
  .epk-photos-grid-wrapper {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    padding-bottom: 6px;
    box-sizing: border-box;
  }

  .epk-photos-grid {
    display: flex;
    flex-direction: row;
    gap: 12px;
    scroll-snap-type: x mandatory;
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .epk-photos-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      scroll-snap-type: none;
    }
  }

  .epk-photo-card {
    flex: 0 0 calc(70vw - 20px);
    width: calc(70vw - 20px);
    max-width: 240px;
    scroll-snap-align: start;
    background: var(--surface-card-light);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .epk-photo-card {
      flex: initial;
      width: 100%;
      max-width: 100%;
    }
  }

  .epk-photo-box {
    position: relative;
    width: 100%;
    height: 140px;
    background: #0d0d10;
    overflow: hidden;
  }

  .epk-press-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .epk-photo-card:hover .epk-press-img {
    transform: scale(1.04);
  }

  .epk-photo-badge {
    position: absolute;
    top: 6px;
    right: 6px;
    background: rgba(0, 0, 0, 0.85);
    color: var(--accent-neon-yellow);
    border: 1px solid var(--accent-neon-yellow);
    font-family: var(--font-secondary);
    font-size: 0.52rem;
    font-weight: 900;
    padding: 1px 5px;
    border-radius: 2px;
  }

  .epk-photo-details {
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    box-sizing: border-box;
  }

  .epk-photo-title {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--text-card-primary);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .epk-photo-type {
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    color: var(--text-card-secondary);
  }

  .epk-photo-download-btn {
    margin-top: 4px;
    background: var(--surface-card-light);
    color: var(--text-card-primary);
    border: 1.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    border-radius: 4px;
    padding: 5px 8px;
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .epk-photo-download-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 2.5px 2.5px 0px #000000;
  }
</style>
