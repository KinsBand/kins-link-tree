---
import { epkConfig } from '../../settings/epk.config';
const baseUrl = import.meta.env.BASE_URL;
const priorityTrack = epkConfig.audioPipeline[0];
---

<section class="epk-section epk-audio-section" id="epk-audio">
  <div class="epk-section-header">
    <div class="epk-header-tag">
      <i class="fa-solid fa-music"></i> AUDIO
    </div>
    <h2 class="epk-section-title">Audio</h2>
    <p class="epk-section-subtitle">Curated streaming tracks and sonic references.</p>
  </div>

  <!-- Hidden HTML5 Audio Element for Interactive Player Controller -->
  <audio id="epkAudioPlayerElement" preload="metadata"></audio>

  <!-- Direct Native DSP Platform Quick-Links Strip -->
  <div class="epk-dsp-quicklinks-strip">
    <span class="dsp-strip-label"><i class="fa-solid fa-headphones"></i> Open in Native App:</span>
    <div class="dsp-buttons-row">
      {epkConfig.streamingPlatforms.map(platform => (
        <a 
          href={platform.url} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="dsp-platform-btn"
          title={`Listen to KINS on ${platform.platform}`}
        >
          <i class={`${platform.icon} dsp-icon`} style={`color: ${platform.color}`}></i>
          <span>{platform.platform}</span>
        </a>
      ))}
    </div>
  </div>

  <div class="epk-audio-pipeline-grid">
    <!-- Left Column: Tactile Neo-Brutalist Master Streaming Console -->
    <div class="epk-player-console-card">
      <div class="epk-console-top-strip">
        <div class="epk-console-status">
          <span class="status-indicator-dot"></span>
          <span class="status-indicator-label">DIRECT STREAMING</span>
        </div>
        <span class="epk-console-fidelity-badge">MASTER AUDIO</span>
      </div>

      <div class="epk-active-track-display">
        <div class="epk-track-hero-visual">
          <div class="epk-vinyl-record" id="epkVinylVisual">
            <div class="epk-vinyl-grooves"></div>
            <div class="epk-vinyl-center-label">
              <span class="vinyl-band-mark">KINS</span>
            </div>
          </div>
          <button type="button" class="epk-play-pause-btn" id="epkPlayPauseBtn" aria-label="Play track">
            <i class="fa-solid fa-play" id="epkPlayPauseIcon"></i>
          </button>
        </div>

        <div class="epk-active-track-meta">
          <span class="epk-now-streaming-tag">FEATURED SINGLE</span>
          <h3 class="epk-active-title" id="epkActiveTrackTitle">{priorityTrack.title}</h3>
          <p class="epk-active-subtitle" id="epkActiveTrackSubtitle">{priorityTrack.subtitle}</p>

          <!-- Interactive Scrubber Bar -->
          <div class="epk-timeline-wrapper">
            <div class="epk-timeline-track" id="epkAudioProgressContainer">
              <div class="epk-timeline-fill" id="epkAudioProgressBar"></div>
            </div>
            <div class="epk-timeline-time-row">
              <span class="time-readout" id="epkAudioTimeCurrent">0:00</span>
              <span class="time-readout" id="epkAudioTimeTotal">{priorityTrack.durationText}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Compact Metadata Specs -->
      <div class="epk-metadata-spec-block">
        <div class="metadata-badges-grid">
          <div class="meta-spec-card">
            <span class="meta-spec-label"><i class="fa-solid fa-stopwatch"></i> Tempo</span>
            <span class="meta-spec-value" id="epkActiveBpm">{priorityTrack.bpm} BPM</span>
          </div>

          <div class="meta-spec-card">
            <span class="meta-spec-label"><i class="fa-solid fa-heart-pulse"></i> Mood</span>
            <span class="meta-spec-value" id="epkActiveMood">{priorityTrack.mood}</span>
          </div>

          <div class="meta-spec-card">
            <span class="meta-spec-label"><i class="fa-solid fa-tag"></i> Genre</span>
            <span class="meta-spec-value" id="epkActiveSubGenre">{priorityTrack.subGenre}</span>
          </div>
        </div>

        <div class="meta-ffo-row">
          <span class="ffo-label">COMPATIBILITY:</span>
          <div class="ffo-pills-container" id="epkActiveFfo">
            {priorityTrack.ffo.map(artist => (
              <span class="epk-tag-pill">{artist}</span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Tracklist Selector -->
    <div class="epk-tracklist-column">
      <div class="epk-tracks-stack">
        {epkConfig.audioPipeline.map((track, idx) => (
          <div 
            class={`epk-track-card ${idx === 0 ? 'is-active' : ''}`}
            data-track-id={track.id}
            data-title={track.title}
            data-subtitle={track.subtitle}
            data-bpm={track.bpm}
            data-mood={track.mood}
            data-subgenre={track.subGenre}
            data-ffo={track.ffo.join(', ')}
            data-preview-url=""
          >
            <div class="track-card-number">{`0${idx + 1}`}</div>
            <div class="track-card-cover-box">
              <img src={`${baseUrl}${track.coverImg}`} alt={track.title} class="track-card-img" />
              <div class="track-card-play-overlay">
                <i class="fa-solid fa-play"></i>
              </div>
            </div>

            <div class="track-card-info">
              <div class="track-title-row">
                <h5 class="track-card-title">{track.title}</h5>
                {track.isPriority && <span class="priority-track-badge">PRIORITY</span>}
              </div>
              <p class="track-card-desc">{track.subtitle}</p>
              <div class="track-card-tags">
                <span class="track-bpm-tag">{track.bpm} BPM</span>
                <span class="track-genre-tag">{track.subGenre}</span>
              </div>
            </div>

            <div class="track-card-duration">
              <span>{track.durationText}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .epk-section {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 48px 14px;
    box-sizing: border-box;
    border-bottom: 3px solid #000000;
  }

  .epk-section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    margin-bottom: 20px;
    gap: 6px;
    width: 100%;
  }

  .epk-header-tag {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 8px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    width: fit-content;
  }

  .epk-section-title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    font-weight: 900;
    color: var(--text-white);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .epk-section-subtitle {
    font-family: var(--font-primary);
    font-size: 0.88rem;
    color: var(--text-muted);
    max-width: 600px;
    line-height: 1.4;
    margin: 0;
  }

  /* Direct DSP Platform Quick-Links Strip */
  .epk-dsp-quicklinks-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
    padding: 10px 14px;
    background: var(--surface-card-light);
    border: 2.5px solid #000000;
    box-shadow: 2.5px 2.5px 0px #000000;
    border-radius: 8px;
    width: 100%;
    box-sizing: border-box;
  }

  .dsp-strip-label {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 900;
    color: var(--text-card-primary);
    display: flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
  }

  .dsp-buttons-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }

  .dsp-platform-btn {
    background: var(--surface-card-light);
    color: var(--text-card-primary);
    border: 1.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    border-radius: 6px;
    padding: 5px 10px;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }

  .dsp-platform-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 2.5px 2.5px 0px #000000;
  }

  .dsp-icon {
    font-size: 0.82rem;
  }

  /* Audio Grid Layout */
  .epk-audio-pipeline-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 900px) {
    .epk-audio-pipeline-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 22px;
    }
  }

  /* Left Column: Player Console Card */
  .epk-player-console-card {
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 10px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
  }

  .epk-console-top-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 10px;
    border-bottom: 2px dashed rgba(0, 0, 0, 0.2);
  }

  [data-theme="dark"] .epk-console-top-strip {
    border-bottom-color: rgba(255, 255, 255, 0.15);
  }

  .epk-console-status {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .status-indicator-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 6px #22c55e;
  }

  .status-indicator-label {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    color: var(--text-card-primary);
    text-transform: uppercase;
  }

  .epk-console-fidelity-badge {
    background: #000000;
    color: var(--accent-neon-yellow);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 3px;
  }

  .epk-active-track-display {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 480px) {
    .epk-active-track-display {
      flex-wrap: nowrap;
    }
  }

  .epk-track-hero-visual {
    position: relative;
    width: 84px;
    height: 84px;
    min-width: 84px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .epk-vinyl-record {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #111114;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .epk-vinyl-grooves {
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: repeating-radial-gradient(
      circle at center,
      #111114,
      #111114 3px,
      #18181c 4px,
      #111114 5px
    );
  }

  .epk-vinyl-center-label {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--accent-neon-yellow);
    border: 1.5px solid #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .vinyl-band-mark {
    font-family: var(--font-heading);
    font-size: 0.5rem;
    font-weight: 900;
    color: #000000;
  }

  .epk-play-pause-btn {
    position: absolute;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--surface-card-light);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-card-primary);
    font-size: 0.95rem;
    cursor: pointer;
    z-index: 5;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease;
  }

  .epk-play-pause-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: scale(1.08);
  }

  .epk-active-track-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    width: 100%;
  }

  .epk-now-streaming-tag {
    font-family: var(--font-secondary);
    font-size: 0.6rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    color: var(--accent-neon-yellow);
    background: #000000;
    padding: 1px 6px;
    border-radius: 3px;
    width: fit-content;
  }

  .epk-active-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 900;
    color: var(--text-card-primary);
    margin: 2px 0 0 0;
    line-height: 1.2;
    word-break: break-word;
  }

  .epk-active-subtitle {
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--text-card-secondary);
    margin: 0;
    word-break: break-word;
  }

  .epk-timeline-wrapper {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
  }

  .epk-timeline-track {
    width: 100%;
    height: 8px;
    background: rgba(0, 0, 0, 0.15);
    border: 1.5px solid #000000;
    border-radius: 4px;
    cursor: pointer;
    overflow: hidden;
    position: relative;
  }

  [data-theme="dark"] .epk-timeline-track {
    background: rgba(255, 255, 255, 0.15);
  }

  .epk-timeline-fill {
    height: 100%;
    width: 0%;
    background: var(--accent-neon-yellow);
    border-right: 1.5px solid #000000;
    transition: width 0.1s linear;
  }

  .epk-timeline-time-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--text-card-secondary);
  }

  /* Compact Metadata Specification Block */
  .epk-metadata-spec-block {
    background: rgba(0, 0, 0, 0.04);
    border: 1.5px solid #000000;
    border-radius: 6px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    box-sizing: border-box;
  }

  [data-theme="dark"] .epk-metadata-spec-block {
    background: rgba(255, 255, 255, 0.03);
  }

  .metadata-badges-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
    width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 500px) {
    .metadata-badges-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .meta-spec-card {
    background: var(--surface-card-light);
    border: 1.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    border-radius: 6px;
    padding: 6px 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    box-sizing: border-box;
  }

  .meta-spec-label {
    font-family: var(--font-secondary);
    font-size: 0.6rem;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--text-card-secondary);
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .meta-spec-value {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 900;
    color: var(--text-card-primary);
    word-break: break-word;
  }

  .meta-ffo-row {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    width: 100%;
  }

  .ffo-label {
    font-family: var(--font-secondary);
    font-size: 0.64rem;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--text-card-secondary);
  }

  .ffo-pills-container {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .epk-tag-pill {
    background: #000000;
    color: #ffffff;
    font-family: var(--font-secondary);
    font-size: 0.64rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 3px;
  }

  /* Right Column: Tracklist Stack */
  .epk-tracklist-column {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .epk-tracks-stack {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .epk-track-card {
    background: var(--surface-card-light);
    border: 2.5px solid #000000;
    box-shadow: 2.5px 2.5px 0px #000000;
    border-radius: 8px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
    user-select: none;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .epk-track-card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3.5px 3.5px 0px #000000;
  }

  .epk-track-card.is-active {
    border-color: #000000;
    box-shadow: 3px 3px 0px var(--accent-neon-yellow), 3px 3px 0px 2px #000000;
    background: var(--surface-card-light-hover);
  }

  .track-card-number {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 900;
    color: var(--text-card-muted);
    flex-shrink: 0;
  }

  .track-card-cover-box {
    position: relative;
    width: 44px;
    height: 44px;
    min-width: 44px;
    border-radius: 6px;
    overflow: hidden;
    border: 1.5px solid #000000;
    flex-shrink: 0;
  }

  .track-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .track-card-play-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 0.85rem;
    opacity: 0;
    transition: opacity 0.16s ease;
  }

  .epk-track-card:hover .track-card-play-overlay,
  .epk-track-card.is-active .track-card-play-overlay {
    opacity: 1;
  }

  .track-card-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .track-title-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .track-card-title {
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 900;
    color: var(--text-card-primary);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .priority-track-badge {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 1px solid #000000;
    font-family: var(--font-secondary);
    font-size: 0.52rem;
    font-weight: 900;
    padding: 1px 4px;
    border-radius: 2px;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .track-card-desc {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    color: var(--text-card-secondary);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track-card-tags {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 2px;
  }

  .track-bpm-tag, .track-genre-tag {
    background: rgba(0, 0, 0, 0.08);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    padding: 1px 5px;
    border-radius: 3px;
    color: var(--text-card-primary);
  }

  [data-theme="dark"] .track-bpm-tag,
  [data-theme="dark"] .track-genre-tag {
    background: rgba(255, 255, 255, 0.1);
  }

  .track-card-duration {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--text-card-muted);
    flex-shrink: 0;
  }
</style>
