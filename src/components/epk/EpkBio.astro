---
import { epkConfig } from '../../settings/epk.config';
const { bios } = epkConfig;
---

<section class="epk-section epk-bio-section" id="epk-bio">
  <div class="epk-section-header">
    <div class="epk-header-tag">
      <i class="fa-solid fa-file-lines"></i> BIOGRAPHY
    </div>
    <h2 class="epk-section-title">Band Biography</h2>
    <p class="epk-section-subtitle">Official press biographies tailored for lineup posters, gig guides, and media interviews.</p>
  </div>

  <div class="epk-bio-card">
    <!-- Top Action & Length Toggle Bar -->
    <div class="bio-card-top">
      <!-- Segmented Length Toggle -->
      <div class="bio-segmented-control" role="tablist" aria-label="Select biography length">
        <button 
          type="button" 
          class="bio-toggle-btn active brutal-press" 
          role="tab" 
          id="bioTabShort" 
          aria-selected="true" 
          aria-controls="bioPanelShort" 
          data-bio-tier="short"
        >
          <span>Short (~50w)</span>
        </button>
        <button 
          type="button" 
          class="bio-toggle-btn brutal-press" 
          role="tab" 
          id="bioTabMedium" 
          aria-selected="false" 
          aria-controls="bioPanelMedium" 
          data-bio-tier="medium"
        >
          <span>Medium (~135w)</span>
        </button>
        <button 
          type="button" 
          class="bio-toggle-btn brutal-press" 
          role="tab" 
          id="bioTabLarge" 
          aria-selected="false" 
          aria-controls="bioPanelLarge" 
          data-bio-tier="large"
        >
          <span>Large (~280w)</span>
        </button>
      </div>

      <!-- 1-Click Copy Bio Button -->
      <button 
        type="button" 
        class="epk-copy-bio-btn brutal-press" 
        id="epkCopyBioBtn"
        data-active-tier="short"
        title="Copy active biography to clipboard"
        aria-label="Copy active biography to clipboard"
      >
        <i class="fa-regular fa-copy" aria-hidden="true"></i>
        <span>Copy Bio</span>
      </button>
    </div>

    <!-- Metadata Use-Case Badge Bar -->
    <div class="bio-meta-strip">
      <span class="bio-word-badge" id="bioWordBadge">{bios.short.wordCount}</span>
      <span class="bio-status-badge" id="bioTargetUseBadge">{bios.short.targetUse}</span>
    </div>

    <!-- Bio Content Panels -->
    <div class="bio-card-body">
      <!-- Short Bio Panel (Default Active) -->
      <div class="bio-panel active" id="bioPanelShort" role="tabpanel" aria-labelledby="bioTabShort" data-bio-content="short">
        <p class="bio-text-paragraph">{bios.short.text}</p>
      </div>

      <!-- Medium Bio Panel -->
      <div class="bio-panel" id="bioPanelMedium" role="tabpanel" aria-labelledby="bioTabMedium" data-bio-content="medium" hidden>
        <p class="bio-text-paragraph">{bios.medium.text}</p>
      </div>

      <!-- Large Bio Panel -->
      <div class="bio-panel" id="bioPanelLarge" role="tabpanel" aria-labelledby="bioTabLarge" data-bio-content="large" hidden>
        {bios.large.text.split('\n\n').map((para) => (
          <p class="bio-text-paragraph">{para}</p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .epk-section {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 44px 16px;
    box-sizing: border-box;
    border-bottom: 3px solid #000000;
  }

  /* Section Header */
  .epk-section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    margin-bottom: 20px;
    gap: 6px;
    width: 100%;
  }

  .epk-header-tag {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 4px;
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 8px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    width: fit-content;
  }

  .epk-section-title {
    font-family: var(--font-heading);
    font-size: clamp(1.45rem, 3.2vw, 2rem);
    font-weight: 900;
    color: var(--text-white);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .epk-section-subtitle {
    font-family: var(--font-primary);
    font-size: 0.86rem;
    color: var(--text-muted);
    max-width: 650px;
    line-height: 1.4;
    margin: 0;
  }

  /* Single-Panel Bio Card */
  .epk-bio-card {
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 10px;
    padding: clamp(14px, 2.5vw, 22px);
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-sizing: border-box;
    width: 100%;
  }

  .bio-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    padding-bottom: 12px;
    border-bottom: 2px dashed rgba(0, 0, 0, 0.2);
  }

  [data-theme="dark"] .bio-card-top {
    border-bottom-color: rgba(255, 255, 255, 0.15);
  }

  /* Segmented Toggle */
  .bio-segmented-control {
    display: inline-flex;
    align-items: center;
    background: var(--surface-input);
    border: 2px solid #000000;
    border-radius: 8px;
    padding: 3px;
    gap: 4px;
    box-shadow: 1.5px 1.5px 0px #000000;
    max-width: 100%;
    flex-wrap: wrap;
  }

  .bio-toggle-btn {
    background: transparent;
    border: 1.5px solid transparent;
    color: var(--text-card-secondary);
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    padding: 6px 12px;
    border-radius: 6px;
    cursor: pointer;
    text-transform: uppercase;
    transition: background-color 0.16s ease, color 0.16s ease, border-color 0.16s ease;
  }

  .bio-toggle-btn:hover {
    color: var(--text-card-primary);
  }

  .bio-toggle-btn.active {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
    box-shadow: 1px 1px 0px #000000;
    font-weight: 900;
  }

  /* Copy Bio Button */
  .epk-copy-bio-btn {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 6px 14px;
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }

  .epk-copy-bio-btn:hover {
    background: var(--surface-card-light-hover);
    color: var(--text-card-primary);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  /* Meta Strip */
  .bio-meta-strip {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .bio-word-badge {
    background: #000000;
    color: var(--accent-neon-yellow);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 900;
    padding: 2px 7px;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }

  .bio-status-badge {
    background: rgba(0, 0, 0, 0.08);
    color: var(--text-card-primary);
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.65rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid rgba(0, 0, 0, 0.18);
    letter-spacing: 0.04em;
  }

  [data-theme="dark"] .bio-status-badge {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
  }

  /* Bio Panels */
  .bio-card-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .bio-panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    animation: bioFadeIn 0.2s ease-out;
  }

  .bio-panel[hidden] {
    display: none !important;
  }

  @keyframes bioFadeIn {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .bio-text-paragraph {
    font-family: var(--font-primary);
    font-size: clamp(0.92rem, 2vw, 1.02rem);
    font-weight: 450;
    line-height: 1.6;
    color: var(--text-card-primary);
    margin: 0;
  }
</style>
