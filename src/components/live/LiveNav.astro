---
import { liveConfig } from '../../settings/live.config';

const baseUrl = import.meta.env.BASE_URL;
---

<header class="live-top-nav" data-track-container="nav:live_header">
  <!-- Left: Back to Bio Page -->
  <div class="live-nav-left">
    <a href={baseUrl} class="live-brutal-btn live-back-btn" aria-label="Back to Bio Page" title="Back to Bio" data-track="live:back_to_bio">
      <i class="fa-solid fa-arrow-left"></i>
    </a>
  </div>

  <!-- Center: Unified Focal Live Badge (Dead-Centered via Grid) -->
  <div class="live-nav-center">
    <div class="live-unified-badge" role="status" aria-live="polite">
      <span class="live-pulse-dot" aria-hidden="true"></span>
      <span class="live-text-label">LIVE</span>
      <span class="live-divider">•</span>
      <span class="live-audience-count" id="liveHeaderAudienceCount">{liveConfig.initialAudienceCount} watching</span>
    </div>
  </div>

  <!-- Right: Utilities Cluster [🔔 Alerts] [↗ Share] -->
  <div class="live-nav-right">
    <!-- [🔔] Show Alerts Toggle Button -->
    <button type="button" class="live-brutal-btn live-icon-action-btn" id="liveOpenAlertsModalBtn" aria-label="Toggle show alerts" title="Show Alerts" data-track="live:alerts_toggle">
      <i class="fa-solid fa-bell"></i>
    </button>

    <!-- [↗] Native OS Share Trigger -->
    <button type="button" class="live-brutal-btn live-icon-action-btn" id="liveHeaderShareBtn" aria-label="Share live stream" title="Share Stream" data-track="live:share">
      <i class="fa-solid fa-arrow-up-right-from-square"></i>
    </button>
  </div>
</header>

<style>
  .live-top-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    box-sizing: border-box;
    position: sticky;
    top: 0;
    z-index: 120;
    background: rgba(20, 20, 22, 0.88);
    /* backdrop-filter removed: sticky header re-blurred scrolling content every frame */
    border-bottom: 2px solid #000000;
  }

  .live-nav-left {
    display: flex;
    align-items: center;
    justify-self: start;
  }

  .live-nav-center {
    display: flex;
    align-items: center;
    justify-content: center;
    justify-self: center;
    min-width: 0;
  }

  .live-nav-right {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 8px;
  }

  /* Neo-Brutalist Live Action Buttons */
  .live-brutal-btn {
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    border-radius: 8px;
    font-family: var(--font-secondary);
    font-size: 0.85rem;
    font-weight: 800;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-decoration: none;
    box-sizing: border-box;
    user-select: none;
    transition: transform 0.14s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.14s ease;
  }

  .live-brutal-btn:hover {
    background: var(--accent-neon-yellow);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .live-brutal-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .live-back-btn,
  .live-icon-action-btn {
    width: 42px;
    height: 42px;
    min-width: 42px;
    min-height: 42px;
    padding: 0;
    font-size: 1rem;
  }

  /* Unified Center Focal Live Badge */
  .live-unified-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #000000;
    color: #ffffff;
    border: 2.5px solid #000000;
    border-radius: 9999px;
    padding: 6px 16px;
    box-shadow: 2px 2px 0px rgba(0, 0, 0, 0.75);
    font-family: var(--font-secondary);
    font-weight: 800;
    font-size: 0.84rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .live-pulse-dot {
    width: 10px;
    height: 10px;
    background-color: #ef4444;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 10px rgba(239, 68, 68, 0.9);
    animation: liveDotPulseAnim 1.4s ease-in-out infinite;
  }

  .live-text-label {
    color: #ef4444;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .live-divider {
    color: rgba(255, 255, 255, 0.4);
  }

  .live-audience-count {
    color: #f5f5f7;
    font-weight: 600;
  }

  @keyframes liveDotPulseAnim {
    0% { transform: scale(0.9); opacity: 0.8; box-shadow: 0 0 4px #ef4444; }
    50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 14px #ef4444; }
    100% { transform: scale(0.9); opacity: 0.8; box-shadow: 0 0 4px #ef4444; }
  }

  @media (max-width: 640px) {
    .live-top-nav {
      padding: 8px 10px;
      gap: 6px;
    }

    .live-back-btn,
    .live-icon-action-btn {
      width: 38px;
      height: 38px;
      min-width: 38px;
      min-height: 38px;
      font-size: 0.9rem;
    }

    .live-unified-badge {
      padding: 5px 10px;
      font-size: 0.76rem;
      gap: 5px;
      min-width: 0;
    }
  }

  @media (max-width: 420px) {
    .live-top-nav {
      padding: 6px 8px;
      gap: 4px;
    }

    .live-nav-right {
      gap: 4px;
    }

    .live-back-btn,
    .live-icon-action-btn {
      width: 34px;
      height: 34px;
      min-width: 34px;
      min-height: 34px;
      font-size: 0.82rem;
    }

    .live-unified-badge {
      padding: 4px 8px;
      font-size: 0.72rem;
      gap: 4px;
      max-width: 100%;
    }
  }
</style>

<script>
  import { showToast } from '../../scripts/controllers/toast.js';

  // Share button logic
  const shareBtn = document.getElementById('liveHeaderShareBtn');
  if (shareBtn) {
    shareBtn.addEventListener('click', async () => {
      const shareData = {
        title: 'KINS Live at The Cambridge Hotel',
        text: 'Watch KINS live stream right now from Newcastle! #KinsLive',
        url: window.location.href
      };

      if (navigator.share) {
        try {
          await navigator.share(shareData);
        } catch (err) {
          if (err.name !== 'AbortError') {
            copyUrlFallback();
          }
        }
      } else {
        copyUrlFallback();
      }
    });
  }

  function copyUrlFallback() {
    navigator.clipboard.writeText(window.location.href).then(() => {
      showToast('Live stream link copied to clipboard!', 'success');
    }).catch(() => {
      showToast('Share URL: ' + window.location.href, 'info');
    });
  }

  // Alerts button logic
  const alertsBtn = document.getElementById('liveOpenAlertsModalBtn');
  if (alertsBtn) {
    alertsBtn.addEventListener('click', () => {
      const modal = document.getElementById('liveAlertsModal');
      if (modal) {
        modal.classList.remove('hidden');
        document.body.classList.add('modal-open');
      }
    });
  }
</script>
