---
---

<div class="modal-backdrop hidden" id="liveStreamSettingsModal" role="dialog" aria-modal="true" aria-label="Stream Settings" data-track-container="modal:stream_settings">
  <div class="modal-content live-settings-modal-content">
    <!-- Modal Header -->
    <div class="modal-header">
      <div class="modal-title-group">
        <span class="brand-mini-badge">IN-PLAYER CONTROLS</span>
        <h3>Stream &amp; Audio Settings</h3>
      </div>
      <button class="close-modal-btn" id="closeStreamSettingsModal" aria-label="Close settings modal" data-track="settings:close">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="modal-body">
      <!-- 1. Audio Mix Selection -->
      <div class="setting-item-block">
        <div class="setting-label-row">
          <label class="setting-label" for="streamAudioMixSelect">
            <i class="fa-solid fa-sliders"></i>
            <span>Stage Audio Mix</span>
          </label>
          <span class="setting-hint">Soundboard direct feed</span>
        </div>
        <select id="streamAudioMixSelect" class="setting-select-input">
          <option value="soundboard" selected>🎛️ Soundboard Direct Feed (Hi-Fi Master)</option>
          <option value="pit">🎤 Pit Ambience &amp; Crowd Microphones</option>
          <option value="stereo">🔊 FOH Stereo Venue Room Mix</option>
        </select>
      </div>

      <!-- 2. Stream Quality Selection -->
      <div class="setting-item-block">
        <div class="setting-label-row">
          <label class="setting-label" for="streamQualitySelect">
            <i class="fa-solid fa-gauge-high"></i>
            <span>Stream Resolution</span>
          </label>
          <span class="setting-hint">Adaptive Bitrate</span>
        </div>
        <select id="streamQualitySelect" class="setting-select-input">
          <option value="auto" selected>Auto (1080p60 Peak Quality)</option>
          <option value="1080p">1080p60 HD (High Bitrate)</option>
          <option value="720p">720p60 HD (Standard)</option>
          <option value="480p">480p (Data Saver)</option>
          <option value="audio_only">📻 Audio Only (Low Bandwidth)</option>
        </select>
      </div>

      <!-- 3. Ultra-Low Latency Toggle -->
      <div class="setting-toggle-row">
        <div class="toggle-text-wrap">
          <span class="toggle-title">⚡ Ultra-Low Latency Mode</span>
          <span class="toggle-desc">Reduces stream delay to ~1.1s for real-time chat sync</span>
        </div>
        <label class="switch-toggle" for="streamLowLatencyToggle">
          <input type="checkbox" id="streamLowLatencyToggle" checked />
          <span class="switch-slider"></span>
        </label>
      </div>

      <!-- Close Action Button -->
      <button type="button" class="modal-primary-btn" id="saveStreamSettingsBtn" data-track="settings:save">
        <span>APPLY &amp; RETURN TO STREAM</span>
      </button>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
  }

  .modal-backdrop.hidden {
    display: none !important;
  }

  .live-settings-modal-content {
    background: #181820;
    border: 3px solid #000000;
    box-shadow: 6px 6px 0px #000000;
    border-radius: 14px;
    width: 100%;
    max-width: 440px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    animation: modalScaleIn 0.22s var(--ease-snappy) forwards;
  }

  @keyframes modalScaleIn {
    from { transform: scale(0.92) translateY(12px); opacity: 0; }
    to { transform: scale(1) translateY(0); opacity: 1; }
  }

  .modal-header {
    background: #20202a;
    border-bottom: 2px solid #000000;
    padding: 14px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .modal-title-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .brand-mini-badge {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 800;
    color: var(--accent-neon-yellow);
    letter-spacing: 0.05em;
  }

  .modal-title-group h3 {
    font-family: var(--font-secondary);
    font-size: 1.05rem;
    font-weight: 900;
    color: #ffffff;
    margin: 0;
  }

  .close-modal-btn {
    width: 36px;
    height: 36px;
    background: var(--surface-card-light);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000000;
    font-size: 1rem;
  }

  .close-modal-btn:hover {
    background: #ef4444;
    color: #ffffff;
  }

  .modal-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .setting-item-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .setting-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .setting-label {
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 800;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
  }

  .setting-label i {
    color: var(--accent-neon-yellow);
  }

  .setting-hint {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-card-muted);
  }

  .setting-select-input {
    width: 100%;
    background: #0f0f14;
    border: 2px solid #000000;
    border-radius: 6px;
    padding: 10px 12px;
    color: #ffffff;
    font-family: var(--font-primary);
    font-size: 0.84rem;
    outline: none;
    cursor: pointer;
    box-sizing: border-box;
  }

  .setting-select-input:focus {
    border-color: var(--accent-neon-yellow);
  }

  /* Switch Toggle */
  .setting-toggle-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #111116;
    border: 2px solid #000000;
    border-radius: 8px;
    padding: 12px 14px;
    gap: 10px;
  }

  .toggle-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .toggle-title {
    font-family: var(--font-secondary);
    font-size: 0.84rem;
    font-weight: 800;
    color: #ffffff;
  }

  .toggle-desc {
    font-family: var(--font-primary);
    font-size: 0.72rem;
    color: var(--text-card-muted);
  }

  .switch-toggle {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
    flex-shrink: 0;
  }

  .switch-toggle input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .switch-slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: #33333a;
    border: 1.5px solid #000000;
    transition: 0.2s;
    border-radius: 24px;
  }

  .switch-slider:before {
    position: absolute;
    content: "";
    height: 16px;
    width: 16px;
    left: 2px;
    bottom: 2px;
    background-color: white;
    transition: 0.2s;
    border-radius: 50%;
  }

  .switch-toggle input:checked + .switch-slider {
    background-color: var(--accent-neon-yellow);
  }

  .switch-toggle input:checked + .switch-slider:before {
    transform: translateX(20px);
    background-color: #000000;
  }

  .modal-primary-btn {
    width: 100%;
    height: 44px;
    background: var(--accent-neon-yellow);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 8px;
    color: #000000;
    font-family: var(--font-secondary);
    font-size: 0.86rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.12s var(--ease-tactile), background 0.14s ease;
  }

  .modal-primary-btn:hover {
    background: #ffffff;
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px #000000;
  }
</style>

<script>
  const closeBtn = document.getElementById('closeStreamSettingsModal');
  const saveBtn = document.getElementById('saveStreamSettingsBtn');
  const modal = document.getElementById('liveStreamSettingsModal');

  function closeModal() {
    modal?.classList.add('hidden');
    document.body.classList.remove('modal-open');
  }

  closeBtn?.addEventListener('click', closeModal);
  saveBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
</script>
