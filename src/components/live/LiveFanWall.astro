---
import { liveConfig } from '../../settings/live.config';

const baseUrl = import.meta.env.BASE_URL;
const resolveUrl = (url: string) => !url ? `${baseUrl}new.png` : url.startsWith('http') ? url : `${baseUrl}${url.replace(/^\//, '')}`;

const totalCount = liveConfig.fanWallPosts.length;
const photosCount = liveConfig.fanWallPosts.filter(p => p.category === 'Photos').length;
const pitShotsCount = liveConfig.fanWallPosts.filter(p => p.category === 'Pit Shots').length;
const videosCount = liveConfig.fanWallPosts.filter(p => p.category === 'Videos' || p.mediaType === 'video').length;
const merchCount = liveConfig.fanWallPosts.filter(p => p.category === 'Merch').length;
---

<section class="live-fan-wall-section" aria-label="Live Fan Wall" data-track-container="section:fan_wall">
  <!-- Section Header -->
  <div class="fan-wall-header-card">
    <div class="fan-wall-title-left">
      <div class="camera-icon-wrap">
        <i class="fa-solid fa-camera-retro"></i>
      </div>
      <div>
        <h2 class="fan-wall-main-title">LIVE FAN WALL</h2>
        <p class="fan-wall-subtitle">Live concert photos, pit videos &amp; merch drops</p>
      </div>
    </div>

    <!-- Upload Action Trigger (Neo-Brutalist Themed) -->
    <button type="button" class="fan-wall-add-photo-btn open-live-upload-modal-btn" data-track="fanwall:add_photo">
      <span class="btn-camera-badge"><i class="fa-solid fa-camera"></i></span>
      <span class="btn-text-content">
        <span class="btn-main-label">ADD YOUR SHOT</span>
        <span class="btn-sub-label">#KINSLIVE</span>
      </span>
      <i class="fa-solid fa-cloud-arrow-up btn-upload-arrow"></i>
    </button>
  </div>

  <!-- Filter Pills Bar -->
  <div class="fan-wall-filter-bar" role="tablist" aria-label="Filter Fan Wall by category">
    <button type="button" class="fan-wall-filter-pill active" data-category="All" role="tab" aria-selected="true">
      <span>All</span> (<span class="pill-count" data-count-category="All">{totalCount}</span>)
    </button>
    <button type="button" class="fan-wall-filter-pill" data-category="Photos" role="tab" aria-selected="false">
      <span>Photos</span> (<span class="pill-count" data-count-category="Photos">{photosCount}</span>)
    </button>
    <button type="button" class="fan-wall-filter-pill" data-category="Pit Shots" role="tab" aria-selected="false">
      <span>Pit Shots</span> (<span class="pill-count" data-count-category="Pit Shots">{pitShotsCount}</span>)
    </button>
    <button type="button" class="fan-wall-filter-pill" data-category="Videos" role="tab" aria-selected="false">
      <span>Videos</span> (<span class="pill-count" data-count-category="Videos">{videosCount}</span>)
    </button>
    <button type="button" class="fan-wall-filter-pill" data-category="Merch" role="tab" aria-selected="false">
      <span>Merch</span> (<span class="pill-count" data-count-category="Merch">{merchCount}</span>)
    </button>
  </div>

  <!-- Responsive Masonry / Card Grid -->
  <div class="fan-wall-grid" id="liveFanWallGrid">
    <!-- Accessible Empty State Element -->
    <div class="fan-wall-empty-state hidden" id="liveFanWallEmptyState" role="status" aria-live="polite">
      <div class="empty-state-icon-box">
        <i class="fa-solid fa-camera-retro" aria-hidden="true"></i>
      </div>
      <h3 class="empty-state-title">No posts in this category yet</h3>
      <p class="empty-state-subtitle">Be the first to share your concert shots from the crowd!</p>
      <button type="button" class="empty-state-upload-btn open-live-upload-modal-btn" data-track="fanwall:empty_upload">
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
        <span>UPLOAD THE FIRST SHOT</span>
      </button>
    </div>

    {liveConfig.fanWallPosts.map((post) => (
      <div 
        class="fan-wall-card"
        data-post-id={post.id}
        data-category={post.category}
        data-media-url={resolveUrl(post.mediaUrl)}
        data-media-type={post.mediaType}
        data-author={post.authorHandle}
        data-caption={post.caption}
      >
        <div class="fan-wall-media-wrap">
          <img src={resolveUrl(post.mediaUrl)} alt={post.caption} class="fan-wall-media-thumb" loading="lazy" />
          <span class="fan-wall-category-tag">{post.category}</span>
          {post.mediaType === 'video' && (
            <div class="video-play-indicator" aria-label="Video post">
              <i class="fa-solid fa-play"></i>
            </div>
          )}
        </div>

        <div class="fan-wall-card-content">
          <div class="fan-wall-card-header">
            <span class="fan-wall-handle">{post.authorHandle}</span>
            <span class="fan-wall-time">{post.timestamp}</span>
          </div>
          <p class="fan-wall-caption">{post.caption}</p>
          <div class="fan-wall-card-footer">
            <button type="button" class="fan-wall-like-btn" data-post-id={post.id} aria-label="Like post">
              <i class="fa-regular fa-heart"></i>
              <span class="fan-wall-like-count">{post.likes}</span>
            </button>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .live-fan-wall-section {
    width: 100%;
    max-width: 1280px;
    margin: 16px auto 32px;
    padding: 0 14px;
    box-sizing: border-box;
  }

  /* Header Card */
  .fan-wall-header-card {
    background: #181820;
    border: 3px solid #000000;
    box-shadow: 4px 4px 0px #000000;
    border-radius: 12px;
    padding: 14px 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .fan-wall-title-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .camera-icon-wrap {
    width: 44px;
    height: 44px;
    background: var(--accent-neon-yellow);
    border: 2px solid #000000;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000000;
    font-size: 1.3rem;
  }

  .fan-wall-main-title {
    font-family: var(--font-secondary);
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--text-white);
    letter-spacing: 0.04em;
    margin: 0;
    text-transform: uppercase;
  }

  .fan-wall-subtitle {
    font-family: var(--font-primary);
    font-size: 0.78rem;
    color: var(--text-card-muted);
    margin: 2px 0 0 0;
  }

  .fan-wall-add-photo-btn {
    background: var(--accent-neon-yellow);
    border: 3px solid #000000;
    box-shadow: 3.5px 3.5px 0px #000000;
    border-radius: 10px;
    padding: 6px 14px;
    color: #000000;
    font-family: var(--font-secondary);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    transition: transform 0.14s var(--ease-tactile), background 0.16s ease, box-shadow 0.14s ease;
    user-select: none;
  }

  .fan-wall-add-photo-btn:hover {
    background: #ffffff;
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px #000000;
  }

  .fan-wall-add-photo-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 2px 2px 0px #000000;
  }

  .btn-camera-badge {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: #000000;
    color: var(--accent-neon-yellow);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    transition: transform 0.14s ease, background 0.14s ease;
    flex-shrink: 0;
  }

  .fan-wall-add-photo-btn:hover .btn-camera-badge {
    background: #ef4444;
    color: #ffffff;
    transform: rotate(-10deg) scale(1.1);
  }

  .btn-text-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.15;
  }

  .btn-main-label {
    font-size: 0.86rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: #000000;
  }

  .btn-sub-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 800;
    color: rgba(0, 0, 0, 0.7);
    letter-spacing: 0.02em;
  }

  .btn-upload-arrow {
    font-size: 0.95rem;
    color: #000000;
    opacity: 0.85;
    flex-shrink: 0;
  }

  /* Filter Pills */
  .fan-wall-filter-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 10px;
    scrollbar-width: none;
    touch-action: pan-x;
    -webkit-overflow-scrolling: touch;
  }

  .fan-wall-filter-pill {
    background: #181820;
    border: 1.5px solid #000000;
    border-radius: 9999px;
    padding: 5px 14px;
    color: var(--text-card-muted);
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.14s ease, color 0.14s ease, border-color 0.14s ease, transform 0.12s var(--ease-tactile);
  }

  .pill-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    opacity: 0.85;
  }

  .fan-wall-filter-pill:hover,
  .fan-wall-filter-pill.active {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
  }

  /* Grid Layout (6 cards in desktop row as in wireframe, responsive on mobile) */
  .fan-wall-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
  }

  /* Accessible Empty State */
  .fan-wall-empty-state {
    grid-column: 1 / -1;
    background: #141418;
    border: 2px dashed rgba(242, 253, 67, 0.4);
    box-shadow: 4px 4px 0px #000000;
    border-radius: 12px;
    padding: 40px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 12px;
    animation: fadeInEmpty 0.22s var(--ease-snappy);
  }

  .fan-wall-empty-state.hidden {
    display: none !important;
  }

  @keyframes fadeInEmpty {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .empty-state-icon-box {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: rgba(242, 253, 67, 0.15);
    border: 2px solid var(--accent-neon-yellow);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-neon-yellow);
    font-size: 1.5rem;
  }

  .empty-state-title {
    font-family: var(--font-secondary);
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--text-white);
    margin: 0;
    letter-spacing: 0.02em;
  }

  .empty-state-subtitle {
    font-family: var(--font-primary);
    font-size: 0.85rem;
    color: var(--text-card-muted);
    margin: 0;
    max-width: 320px;
  }

  .empty-state-upload-btn {
    background: var(--accent-neon-yellow);
    border: 2px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 8px;
    padding: 8px 16px;
    color: #000000;
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 900;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    transition: transform 0.14s var(--ease-tactile), background 0.14s ease, box-shadow 0.14s ease;
  }

  .empty-state-upload-btn:hover {
    background: #ffffff;
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px #000000;
  }

  .empty-state-upload-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  :global(.fan-wall-card) {
    background: #141418;
    border: 2px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, opacity 0.2s ease;
  }

  :global(.fan-wall-card:hover) {
    transform: translateY(-3px);
    box-shadow: 4px 4px 0px var(--accent-neon-yellow);
  }

  :global(.fan-wall-card.hidden-by-filter) {
    display: none !important;
  }

  :global(.fan-wall-media-wrap) {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #0a0a0d;
    overflow: hidden;
  }

  :global(.fan-wall-media-thumb) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s var(--ease-snappy);
  }

  :global(.fan-wall-card:hover .fan-wall-media-thumb) {
    transform: scale(1.06);
  }

  :global(.fan-wall-category-tag) {
    position: absolute;
    top: 6px;
    left: 6px;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
  }

  :global(.video-play-indicator) {
    position: absolute;
    bottom: 6px;
    right: 6px;
    width: 22px;
    height: 22px;
    background: rgba(0, 0, 0, 0.8);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-neon-yellow);
    font-size: 0.65rem;
  }

  :global(.fan-wall-card-content) {
    padding: 8px 10px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  :global(.fan-wall-card-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-width: 0;
    gap: 4px;
  }

  :global(.fan-wall-handle) {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--text-white);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
    flex: 1;
  }

  :global(.fan-wall-time) {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--text-card-muted);
    flex-shrink: 0;
  }

  :global(.fan-wall-caption) {
    font-family: var(--font-primary);
    font-size: 0.72rem;
    color: #d1d1d6;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
    word-break: break-word;
  }

  :global(.fan-wall-card-footer) {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin-top: 2px;
  }

  :global(.fan-wall-like-btn) {
    background: transparent;
    border: none;
    color: var(--text-card-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 2px 4px;
    transition: color 0.14s ease;
  }

  :global(.fan-wall-like-btn.liked) {
    color: #ef4444;
  }

  :global(.heart-bounce-anim i) {
    animation: heartPop 0.35s var(--ease-snappy);
  }

  @keyframes heartPop {
    0% { transform: scale(1); }
    50% { transform: scale(1.6); }
    100% { transform: scale(1); }
  }

  @media (max-width: 1100px) {
    .fan-wall-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .fan-wall-header-card {
      flex-direction: column;
      align-items: flex-start;
    }

    .fan-wall-add-photo-btn {
      width: 100%;
      justify-content: center;
    }

    .fan-wall-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
  }
</style>
