<script>
  // Eager proxy stub: allows instant clicks on album cards before audioPlayer.js finishes idle hydration
  (function() {
    const w = window as any;
    w._pendingTrackToPlay = null;
    if (!w.playTrackPreview) {
      w.playTrackPreview = function(trackObj: any) {
        w._pendingTrackToPlay = trackObj;
        import('../../scripts/controllers/audioPlayer.js').then((m) => {
          m.initAudioPlayer();
          if (w.playTrackPreview && w._pendingTrackToPlay) {
            const t = w._pendingTrackToPlay;
            w._pendingTrackToPlay = null;
            w.playTrackPreview(t);
          }
        });
      };
    }
  })();

  // Idle-loaded: the audio deck enhances the page — it must not compete with first paint
  const scheduleIdle = (cb: () => void) => {
    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(cb, { timeout: 2000 });
    } else {
      setTimeout(cb, 1);
    }
  };
  scheduleIdle(() => {
    import('../../scripts/controllers/audioPlayer.js').then((m) => m.initAudioPlayer());
  });
</script>

