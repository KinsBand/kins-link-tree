---
---

<div class="bottom-floating-controls-wrapper" id="bottomFloatingControls">
  <!-- Full-Width Streaming Drawer Panel -->
  <div class="stream-drawer-panel hidden" id="streamDrawerPanel" data-track-container="drawer:stream_platforms">
    <div class="stream-drawer-header">
      <span class="stream-drawer-title">
        <i class="fa-solid fa-compact-disc"></i> Stream on
      </span>
      <span class="stream-drawer-song" id="streamDrawerSongName"></span>
    </div>
    <div class="stream-platforms-row">
      <a href="https://open.spotify.com/artist/57aKk67k5L7iL13C0d7g5Y" target="_blank" rel="noopener noreferrer" class="stream-platform-btn spotify" id="streamLinkSpotify" title="Spotify" aria-label="Spotify" data-track="stream:spotify" data-platform="spotify">
        <i class="fa-brands fa-spotify" aria-hidden="true"></i>
        <span class="sr-only">Stream on Spotify</span>
      </a>
      <a href="https://music.apple.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn apple" id="streamLinkApple" title="Apple Music" aria-label="Apple Music" data-track="stream:apple" data-platform="apple">
        <i class="fa-brands fa-apple" aria-hidden="true"></i>
        <span class="sr-only">Stream on Apple Music</span>
      </a>
      <a href="https://music.youtube.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn youtube" id="streamLinkYoutube" title="YouTube Music" aria-label="YouTube Music" data-track="stream:youtube" data-platform="youtube">
        <i class="fa-brands fa-youtube" aria-hidden="true"></i>
        <span class="sr-only">Stream on YouTube Music</span>
      </a>
      <a href="https://music.amazon.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn amazon" id="streamLinkAmazon" title="Amazon Music" aria-label="Amazon Music" data-track="stream:amazon" data-platform="amazon">
        <i class="fa-brands fa-amazon" aria-hidden="true"></i>
        <span class="sr-only">Stream on Amazon Music</span>
      </a>
      <a href="https://soundcloud.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn soundcloud" id="streamLinkSoundcloud" title="SoundCloud" aria-label="SoundCloud" data-track="stream:soundcloud" data-platform="soundcloud">
        <i class="fa-brands fa-soundcloud" aria-hidden="true"></i>
        <span class="sr-only">Stream on SoundCloud</span>
      </a>
      <a href="https://www.deezer.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn deezer" id="streamLinkDeezer" title="Deezer" aria-label="Deezer" data-track="stream:deezer" data-platform="deezer">
        <i class="fa-brands fa-deezer" aria-hidden="true"></i>
        <span class="sr-only">Stream on Deezer</span>
      </a>
      <a href="https://tidal.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn tidal" id="streamLinkTidal" title="Tidal" aria-label="Tidal" data-track="stream:tidal" data-platform="tidal">
        <i class="fa-solid fa-water" aria-hidden="true"></i>
        <span class="sr-only">Stream on Tidal</span>
      </a>
      <a href="https://bandcamp.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn bandcamp" id="streamLinkBandcamp" title="Bandcamp" aria-label="Bandcamp" data-track="stream:bandcamp" data-platform="bandcamp">
        <i class="fa-brands fa-bandcamp" aria-hidden="true"></i>
        <span class="sr-only">Stream on Bandcamp</span>
      </a>
      <a href="https://audiomack.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn audiomack" id="streamLinkAudiomack" title="Audiomack" aria-label="Audiomack" data-track="stream:audiomack" data-platform="audiomack">
        <i class="fa-solid fa-headphones" aria-hidden="true"></i>
        <span class="sr-only">Stream on Audiomack</span>
      </a>
      <a href="https://www.qobuz.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn qobuz" id="streamLinkQobuz" title="Qobuz" aria-label="Qobuz" data-track="stream:qobuz" data-platform="qobuz">
        <i class="fa-solid fa-compact-disc" aria-hidden="true"></i>
        <span class="sr-only">Stream on Qobuz</span>
      </a>
    </div>
  </div>

  <!-- Neo-Brutalist Dual-Card Bottom Dock -->
  <div class="brutal-bottom-dock" id="bottomAudioBar" data-track-container="dock:audio_player">
    <audio id="vaultAudioPlayer" preload="auto" playsinline webkit-playsinline></audio>

    <!-- Left Card: INSPIRATION PLAYER (Extended Width) -->
    <div class="brutal-player-card deck-music-section" id="deckMusicSection">
      <!-- Folder Tab Sticking Up From Top Left -->
      <div class="card-folder-tab tab-player">INSPIRATION</div>

      <!-- Minimalist Turntable Stylus Indicator at Top Edge -->
      <div class="vinyl-stylus-wrapper" id="vinylStylusWrapper">
        <svg class="stylus-turntable-svg" viewBox="0 0 22 18" width="22" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <g class="stylus-head-group" id="stylusTonearmWand">
            <!-- Turntable Cartridge Mount Body -->
            <polygon points="5,1 17,1 18,7 4,7" fill="#141416" stroke="#000000" stroke-width="1.8" stroke-linejoin="round" />
            <!-- Neon Yellow Stylus Grip Body -->
            <polygon points="4,7 18,7 16,13 6,13" fill="#F2FD43" stroke="#000000" stroke-width="1.8" stroke-linejoin="round" />
            <!-- Cartridge Nose / Diamond Needle -->
            <polygon points="8,13 14,13 12,17.5 10,17.5" fill="#141416" stroke="#000000" stroke-width="1.2" />
            <circle cx="11" cy="17.5" r="1.2" fill="#ffffff" stroke="#000000" stroke-width="0.8" />
            <!-- Center Calibration Line -->
            <line x1="11" y1="2" x2="11" y2="10" stroke="#ffffff" stroke-width="1.4" stroke-linecap="round" />
          </g>
        </svg>
      </div>

      <!-- Clipped Progress Fill -->
      <div class="deck-timeline-clip-box">
        <div class="audio-bar-timeline-progress" id="audioBarTimelineProgress"></div>
      </div>

      <!-- IDLE STATE: INSPIRATIONAL -->
      <div class="deck-idle-view" id="deckIdleView">
        <div class="stacked-album-covers" id="stackedAlbumCovers">
          <div class="cover-stack-item item-1">
            <img class="stack-cover-img hidden" id="stackCover1" alt="Album cover 1" width="36" height="36" loading="lazy" decoding="async">
            <i class="fa-solid fa-compact-disc stack-fallback-icon"></i>
          </div>
          <div class="cover-stack-item item-2">
            <img class="stack-cover-img hidden" id="stackCover2" alt="Album cover 2" width="36" height="36" loading="lazy" decoding="async">
            <i class="fa-solid fa-compact-disc stack-fallback-icon"></i>
          </div>
          <div class="cover-stack-item item-3">
            <img class="stack-cover-img hidden" id="stackCover3" alt="Album cover 3" width="36" height="36" loading="lazy" decoding="async">
            <i class="fa-solid fa-compact-disc stack-fallback-icon"></i>
          </div>
        </div>

        <div class="idle-text-info">
          <span class="idle-mix-title">WHAT INSPIRES US!</span>
          <span class="idle-mix-subtitle">listen to what inspires KINS</span>
        </div>

        <button class="idle-play-btn idle-mix-btn brutal-press" id="idlePlayBtn" aria-label="Auto-mix inspiration songs" title="Auto-Mix Inspiration Songs" data-track="player:idle_mix">
          <i class="fa-solid fa-shuffle"></i>
        </button>
      </div>

      <!-- ACTIVE STATE: NOW PLAYING TRACK -->
      <div class="deck-active-view hidden" id="deckActiveView">
        <div class="audio-bar-left">
          <div class="audio-bar-icon-box" id="audioBarIconBox">
            <img id="audioBarCoverImg" class="audio-bar-cover-img hidden" src="" alt="Album cover" width="36" height="36" loading="lazy" decoding="async">
            <i class="fa-solid fa-compact-disc audio-icon-anim" id="audioBarFallbackIcon"></i>
          </div>
          <div class="audio-bar-details">
            <div class="audio-bar-title-container">
              <span class="audio-bar-title" id="audioBarTitle">Just Like Heaven</span>
            </div>
            <div class="audio-bar-meta-row">
              <span class="audio-bar-artist" id="audioBarArtist">The Cure</span>
              <span class="audio-bar-time" id="audioBarTime">0:00 / 0:30</span>
            </div>
          </div>
        </div>

        <div class="audio-bar-right">
          <button class="audio-bar-stream-btn brutal-press" id="audioBarStreamBtn" aria-label="Streaming options" title="Stream or Add to Playlist" data-track="player:stream_options">
            <i class="fa-solid fa-arrow-up-right-from-square"></i>
          </button>
          <button class="audio-bar-toggle-btn brutal-press" id="audioBarToggleBtn" aria-label="Toggle playback" data-track="player:toggle">
            <i class="fa-solid fa-pause"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Right Card: GIG MAP (Tab-Sized Compact Width) -->
    <div class="brutal-gig-card" id="floatingGigPillBtn" role="button" aria-label="Tour dates & Gig Map" data-track="gig:open_map">
      <!-- Folder Tab Spanning Full Width of the Button -->
      <div class="card-folder-tab tab-gigmap">GIG MAP</div>
      
      <div class="gig-card-center-icon">
        <i class="fa-solid fa-map-location-dot"></i>
      </div>
    </div>
  </div>
</div>

<div class="bottom-gradient-blur-overlay" id="bottomGradientBlur"></div>

<style>
  .bottom-gradient-blur-overlay {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 75px;
    pointer-events: none;
    z-index: 750;
    background: linear-gradient(to top, 
      rgba(16, 16, 18, 0.45) 0%, 
      rgba(16, 16, 18, 0.15) 60%, 
      rgba(16, 16, 18, 0) 100%
    );
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    mask-image: linear-gradient(to top, black 0%, rgba(0, 0, 0, 0.6) 60%, transparent 100%);
    -webkit-mask-image: linear-gradient(to top, black 0%, rgba(0, 0, 0, 0.6) 60%, transparent 100%);
    transition: height 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  :global(body.stream-panel-open) .bottom-gradient-blur-overlay {
    height: 220px;
  }

  :global(body.modal-open) .bottom-gradient-blur-overlay {
    opacity: 0 !important;
  }

  .bottom-floating-controls-wrapper {
    position: fixed;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 900;
    width: calc(100% - 24px);
    max-width: 480px;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  :global(body.modal-open) .bottom-floating-controls-wrapper {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* Streaming Drawer */
  .stream-drawer-panel {
    pointer-events: auto;
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 14px;
    opacity: 0;
    transform: translateY(12px) scale(0.97);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stream-drawer-panel.active-drawer {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .stream-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom: 2px solid #000000;
  }

  .stream-drawer-title {
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-card-primary);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .stream-drawer-song {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--text-card-primary);
    max-width: 170px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stream-platforms-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .stream-platform-btn {
    flex: 1;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background: var(--surface-input);
    border: 2px solid #000000;
    color: var(--text-card-primary);
    text-decoration: none;
    font-size: 1.1rem;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .stream-platform-btn:hover {
    transform: translateY(-2px);
    background: var(--accent-neon-yellow);
    color: #000000;
  }

  /* Neo-Brutalist Dual-Card Dock */
  .brutal-bottom-dock {
    pointer-events: auto;
    display: flex;
    align-items: flex-end;
    gap: 8px;
    width: 100%;
    user-select: none;
    -webkit-user-select: none;
    box-sizing: border-box;
    touch-action: pan-y;
  }

  /* Folder Tab Sticking Up from Top Left */
  .card-folder-tab {
    position: absolute;
    top: -22px;
    left: -3px;
    height: 22px;
    padding: 0 10px;
    border: 3px solid #000000;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-secondary);
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    color: var(--text-card-primary);
    text-transform: uppercase;
    user-select: none;
    -webkit-user-select: none;
    z-index: 10;
    box-sizing: border-box;
  }

  .card-folder-tab.tab-player {
    background: var(--surface-card-light);
  }

  .card-folder-tab.tab-gigmap {
    background: var(--surface-card-light);
    color: var(--text-card-primary);
    left: -3px;
    right: -3px;
    width: calc(100% + 6px);
    padding: 0 2px;
    text-align: center;
  }

  /* Left Player Card - Dark Neo-Brutalist Surface */
  .brutal-player-card {
    flex: 1 1 auto;
    min-width: 0;
    max-width: none;
    background: #141416;
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 0 8px 8px 8px;
    position: relative;
    display: flex;
    align-items: center;
    min-height: 54px;
    height: 54px;
    box-sizing: border-box;
    overflow: visible;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    cursor: grab;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
  }

  .brutal-player-card.is-scrubbing,
  .brutal-bottom-dock.is-scrubbing {
    cursor: grabbing !important;
  }

  .brutal-player-card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px #000000;
  }

  /* Minimalist Stylus Needle Indicator - Top Edge Accent */
  .vinyl-stylus-wrapper {
    position: absolute;
    top: -16px;
    left: 0%;
    transform: translateX(-11px);
    pointer-events: none;
    z-index: 35;
    transition: left 0.1s linear, opacity 0.25s ease;
    opacity: 0;
    width: 22px;
    height: 18px;
    filter: drop-shadow(1.5px 1.5px 0px #000000);
    will-change: left;
  }

  /* Instant zero-lag 1:1 needle & timeline tracking during scrubbing */
  .brutal-bottom-dock.is-scrubbing .vinyl-stylus-wrapper,
  .brutal-player-card.is-scrubbing .vinyl-stylus-wrapper,
  :global(.is-scrubbing) .vinyl-stylus-wrapper,
  .brutal-bottom-dock.is-scrubbing .audio-bar-timeline-progress,
  .brutal-player-card.is-scrubbing .audio-bar-timeline-progress,
  :global(.is-scrubbing) .audio-bar-timeline-progress {
    transition: none !important;
  }

  .vinyl-stylus-wrapper.stylus-visible {
    opacity: 1;
  }

  .stylus-turntable-svg {
    display: block;
    width: 22px;
    height: 18px;
    overflow: visible;
  }

  .stylus-head-group {
    transform-origin: 11px 4px;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform: translateY(-4px) rotate(-8deg);
    will-change: transform;
  }

  .vinyl-stylus-wrapper.is-playing .stylus-head-group,
  :global(body.is-audio-playing) .stylus-head-group {
    transform: translateY(0px) rotate(0deg);
  }

  .vinyl-stylus-wrapper.is-paused .stylus-head-group {
    transform: translateY(-4px) rotate(-8deg);
  }

  .vinyl-stylus-wrapper.needle-drop-bounce .stylus-head-group {
    animation: needleDropBounce 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  @keyframes needleDropBounce {
    0% {
      transform: translateY(-6px) rotate(-12deg);
    }
    40% {
      transform: translateY(2px) rotate(2deg);
    }
    70% {
      transform: translateY(-1px) rotate(-1deg);
    }
    100% {
      transform: translateY(0px) rotate(0deg);
    }
  }

  .deck-timeline-clip-box {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    border-radius: 0 5px 5px 5px;
    pointer-events: none;
    z-index: 1;
  }

  .audio-bar-timeline-progress {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    height: 100%;
    width: 0%;
    background: rgba(242, 253, 67, 0.25);
    pointer-events: none;
    will-change: width;
    z-index: 1;
  }

  /* Idle View */
  .deck-idle-view {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 10px;
    cursor: pointer;
    position: relative;
    z-index: 5;
    box-sizing: border-box;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .stacked-album-covers {
    position: relative;
    width: 38px;
    height: 34px;
    flex-shrink: 0;
  }

  .cover-stack-item {
    position: absolute;
    width: 26px;
    height: 26px;
    border-radius: 4px;
    background: #111114;
    border: 1.5px solid #000000;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 1px 1px 0px #000000;
    transition: transform 0.2s var(--ease-snappy);
  }

  .cover-stack-item.item-1 {
    left: 0;
    top: 3px;
    transform: rotate(-10deg);
    z-index: 1;
  }

  .cover-stack-item.item-2 {
    left: 5px;
    top: 2px;
    transform: rotate(0deg);
    z-index: 2;
  }

  .cover-stack-item.item-3 {
    left: 10px;
    top: 3px;
    transform: rotate(10deg);
    z-index: 3;
  }

  .stack-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stack-fallback-icon {
    font-size: 0.72rem;
    color: var(--accent-neon-yellow);
  }

  .idle-text-info {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-width: 0;
    line-height: 1.15;
    overflow: hidden;
    justify-content: center;
  }

  .idle-mix-title {
    font-family: var(--font-heading);
    font-size: clamp(0.74rem, 2.4vw, 0.85rem);
    font-weight: 900;
    letter-spacing: 0.03em;
    color: #ffffff;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }

  .idle-mix-subtitle {
    font-family: var(--font-secondary);
    font-size: clamp(0.56rem, 1.8vw, 0.63rem);
    font-weight: 700;
    color: #d4d4d8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }

  .idle-play-btn {
    width: 34px;
    height: 34px;
    min-width: 34px;
    border-radius: 4px;
    background: var(--surface-input);
    color: var(--text-card-primary);
    border: 2.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.85rem;
    flex-shrink: 0;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .idle-play-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: scale(1.05);
  }

  /* Active View */
  .deck-active-view {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 10px;
    position: relative;
    z-index: 5;
    box-sizing: border-box;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .audio-bar-left {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
    overflow: visible;
  }

  .audio-bar-icon-box {
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    flex-shrink: 0;
    border-radius: 6px;
    background: #111114;
    border: 2px solid #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: var(--accent-neon-yellow);
    position: relative;
    box-shadow: 1px 1px 0px #000000;
    will-change: transform, border-radius;
    transition: border-radius 0.5s cubic-bezier(0.34, 1.35, 0.64, 1),
                box-shadow 0.4s ease,
                border-color 0.4s ease;
  }

  .audio-bar-icon-box.is-vinyl-disc,
  .audio-bar-icon-box.vinyl-spin-anim {
    border-radius: 50% !important;
    border-color: #000000;
    box-shadow: 0 0 12px var(--accent-neon-yellow-glow);
  }

  .audio-bar-icon-box::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 9px;
    height: 9px;
    background: #121214;
    border: 1.5px solid #ffffff;
    border-radius: 50%;
    box-shadow: inset 0 0 3px rgba(0, 0, 0, 0.8);
    z-index: 5;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .audio-bar-icon-box.is-vinyl-disc::after,
  .audio-bar-icon-box.vinyl-spin-anim::after {
    opacity: 1;
  }

  .audio-bar-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
    border-radius: inherit;
