---
---

<div class="bottom-floating-controls-wrapper" id="bottomFloatingControls">
  <!-- Full-Width Streaming Drawer Panel -->
  <div class="stream-drawer-panel hidden" id="streamDrawerPanel">
    <div class="stream-drawer-header">
      <span class="stream-drawer-title">
        <i class="fa-solid fa-compact-disc"></i> Stream on
      </span>
      <span class="stream-drawer-song" id="streamDrawerSongName"></span>
    </div>
    <div class="stream-platforms-row">
      <a href="https://open.spotify.com/artist/57aKk67k5L7iL13C0d7g5Y" target="_blank" rel="noopener noreferrer" class="stream-platform-btn spotify" id="streamLinkSpotify" title="Spotify" aria-label="Spotify">
        <i class="fa-brands fa-spotify" aria-hidden="true"></i>
        <span class="sr-only">Stream on Spotify</span>
      </a>
      <a href="https://music.apple.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn apple" id="streamLinkApple" title="Apple Music" aria-label="Apple Music">
        <i class="fa-brands fa-apple" aria-hidden="true"></i>
        <span class="sr-only">Stream on Apple Music</span>
      </a>
      <a href="https://music.youtube.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn youtube" id="streamLinkYoutube" title="YouTube Music" aria-label="YouTube Music">
        <i class="fa-brands fa-youtube" aria-hidden="true"></i>
        <span class="sr-only">Stream on YouTube Music</span>
      </a>
      <a href="https://music.amazon.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn amazon" id="streamLinkAmazon" title="Amazon Music" aria-label="Amazon Music">
        <i class="fa-brands fa-amazon" aria-hidden="true"></i>
        <span class="sr-only">Stream on Amazon Music</span>
      </a>
      <a href="https://soundcloud.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn soundcloud" id="streamLinkSoundcloud" title="SoundCloud" aria-label="SoundCloud">
        <i class="fa-brands fa-soundcloud" aria-hidden="true"></i>
        <span class="sr-only">Stream on SoundCloud</span>
      </a>
      <a href="https://www.deezer.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn deezer" id="streamLinkDeezer" title="Deezer" aria-label="Deezer">
        <i class="fa-brands fa-deezer" aria-hidden="true"></i>
        <span class="sr-only">Stream on Deezer</span>
      </a>
      <a href="https://tidal.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn tidal" id="streamLinkTidal" title="Tidal" aria-label="Tidal">
        <i class="fa-solid fa-water" aria-hidden="true"></i>
        <span class="sr-only">Stream on Tidal</span>
      </a>
      <a href="https://bandcamp.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn bandcamp" id="streamLinkBandcamp" title="Bandcamp" aria-label="Bandcamp">
        <i class="fa-brands fa-bandcamp" aria-hidden="true"></i>
        <span class="sr-only">Stream on Bandcamp</span>
      </a>
      <a href="https://audiomack.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn audiomack" id="streamLinkAudiomack" title="Audiomack" aria-label="Audiomack">
        <i class="fa-solid fa-headphones" aria-hidden="true"></i>
        <span class="sr-only">Stream on Audiomack</span>
      </a>
      <a href="https://www.qobuz.com" target="_blank" rel="noopener noreferrer" class="stream-platform-btn qobuz" id="streamLinkQobuz" title="Qobuz" aria-label="Qobuz">
        <i class="fa-solid fa-compact-disc" aria-hidden="true"></i>
        <span class="sr-only">Stream on Qobuz</span>
      </a>
    </div>
  </div>

  <!-- Unified Combined Bottom Deck Bar -->
  <div class="bottom-deck-bar" id="bottomAudioBar">
    <audio id="vaultAudioPlayer" preload="none"></audio>

    <!-- Music Player Section -->
    <div class="deck-music-section" id="deckMusicSection">
      <!-- Vinyl Stylus riding on top of the music section timeline -->
      <div class="vinyl-stylus-wrapper" id="vinylStylusWrapper">
        <svg class="vinyl-stylus-svg" viewBox="0 0 28 45" width="28" height="45">
          <defs>
            <linearGradient id="kins_aluminum" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#a1a1aa" />
              <stop offset="50%" stop-color="#f4f4f5" />
              <stop offset="100%" stop-color="#71717a" />
            </linearGradient>
          </defs>
          <line x1="14" y1="2" x2="14" y2="23" stroke="url(#kins_aluminum)" stroke-width="2.5" stroke-linecap="round"/>
          <rect x="7" y="23" width="14" height="11" rx="2" fill="#09090b" stroke="#3f3f46" stroke-width="1"/>
          <rect x="9" y="25" width="10" height="2.5" fill="#ffffff" rx="1"/>
          <line x1="14" y1="34" x2="14" y2="39" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/>
          <polygon points="14,41 12,38 16,38" fill="#ffffff"/>
        </svg>
      </div>

      <!-- Strictly Clipped Card Container (Timeline Progress & Wave Sheen) -->
      <div class="deck-timeline-clip-box">
        <div class="audio-bar-timeline-progress" id="audioBarTimelineProgress"></div>
        <div class="wave-wipe-overlay" id="waveWipeOverlay"></div>
      </div>

      <!-- IDLE STATE: INSPIRATION MIX -->
      <div class="deck-idle-view" id="deckIdleView">
        <div class="stacked-album-covers" id="stackedAlbumCovers">
          <div class="cover-stack-item item-1">
            <img class="stack-cover-img hidden" id="stackCover1" alt="Album cover 1" width="48" height="48" loading="lazy" decoding="async">
            <i class="fa-solid fa-compact-disc stack-fallback-icon"></i>
          </div>
          <div class="cover-stack-item item-2">
            <img class="stack-cover-img hidden" id="stackCover2" alt="Album cover 2" width="48" height="48" loading="lazy" decoding="async">
            <i class="fa-solid fa-compact-disc stack-fallback-icon"></i>
          </div>
          <div class="cover-stack-item item-3">
            <img class="stack-cover-img hidden" id="stackCover3" alt="Album cover 3" width="48" height="48" loading="lazy" decoding="async">
            <i class="fa-solid fa-compact-disc stack-fallback-icon"></i>
          </div>
        </div>

        <div class="idle-text-info">
          <span class="idle-mix-title">INSPIRATION MIX</span>
          <span class="idle-mix-subtitle">listen to what inspires the kins!</span>
        </div>

        <button class="idle-play-btn" id="idlePlayBtn" aria-label="Play random inspiration song">
          <i class="fa-solid fa-play"></i>
        </button>
      </div>

      <!-- ACTIVE STATE: NOW PLAYING TRACK -->
      <div class="deck-active-view hidden" id="deckActiveView">
        <div class="audio-bar-left">
          <div class="audio-bar-icon-box" id="audioBarIconBox">
            <img id="audioBarCoverImg" class="audio-bar-cover-img hidden" src="" alt="Album cover" width="48" height="48" loading="lazy" decoding="async">
            <i class="fa-solid fa-compact-disc audio-icon-anim" id="audioBarFallbackIcon"></i>
          </div>
          <div class="audio-bar-details">
            <div class="audio-bar-title-container">
              <span class="audio-bar-title" id="audioBarTitle">Just Like Heaven</span>
            </div>
            <div class="audio-bar-meta-row">
              <span class="audio-bar-artist" id="audioBarArtist">The Cure</span>
              <span class="audio-bar-time" id="audioBarTime">0:00 / 0:30</span>
            </div>
          </div>
        </div>

        <div class="audio-bar-right">
          <button class="audio-bar-stream-btn" id="audioBarStreamBtn" aria-label="Streaming options" title="Stream or Add to Playlist">
            <i class="fa-solid fa-arrow-up-right-from-square"></i>
          </button>
          <button class="audio-bar-toggle-btn" id="audioBarToggleBtn" aria-label="Toggle playback">
            <i class="fa-solid fa-pause"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Visual Separator Divider -->
    <div class="deck-divider"></div>

    <!-- Gig Location Button Section (40% Width Variation 1: Live Tour Pass) -->
    <div class="deck-gig-section" id="floatingGigPillBtn" role="button" aria-label="Open Tour & Gig Map">
      <div class="gig-pill-left-box">
        <div class="gig-pill-live-badge">
          <span class="live-pulse-dot"></span>
          <span class="gig-pill-tag" id="gigPillTag">LIVE GIGS</span>
        </div>
        <div class="gig-pill-text-info">
          <span class="gig-pill-title">TOUR MAP</span>
          <span class="gig-pill-sub">3 Upcoming</span>
        </div>
      </div>
      <div class="gig-pill-right-box">
        <i class="fa-solid fa-map-location-dot pill-map-icon"></i>
        <i class="fa-solid fa-chevron-right pill-arrow-icon"></i>
      </div>
    </div>
  </div>
</div>

<div class="bottom-gradient-blur-overlay" id="bottomGradientBlur"></div>

<style>
  .bottom-gradient-blur-overlay {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 95px;
    pointer-events: none;
    z-index: 750;
    background: linear-gradient(to top, 
      rgba(10, 10, 12, 0.94) 0%, 
      rgba(10, 10, 12, 0.72) 45%, 
      rgba(10, 10, 12, 0.25) 75%, 
      rgba(10, 10, 12, 0) 100%
    );
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    mask-image: linear-gradient(to top, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.75) 55%, rgba(0, 0, 0, 0) 100%);
    -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.75) 55%, rgba(0, 0, 0, 0) 100%);
    transition: height 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  :global(body.stream-panel-open) .bottom-gradient-blur-overlay {
    height: 220px;
  }

  :global(body.modal-open) .bottom-gradient-blur-overlay {
    opacity: 0 !important;
  }

  .bottom-floating-controls-wrapper {
    position: fixed;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 900;
    width: calc(100% - 24px);
    max-width: 480px;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  :global(body.modal-open) .bottom-floating-controls-wrapper {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .stream-drawer-panel {
    pointer-events: auto;
    background: rgba(18, 18, 20, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    padding: 8px 12px;
    margin-bottom: 6px;
    backdrop-filter: blur(16px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.7);
    opacity: 0;
    transform: translateY(12px) scale(0.97);
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stream-drawer-panel.active-drawer {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .stream-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stream-drawer-title {
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .stream-drawer-song {
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-white);
    max-width: 170px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stream-platforms-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .stream-platform-btn {
    flex: 1;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-white);
    text-decoration: none;
    font-size: 1.15rem;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stream-platform-btn:hover {
    transform: translateY(-2px);
  }

  .stream-platform-btn.spotify:hover {
    background: rgba(30, 215, 96, 0.22);
    border-color: rgba(30, 215, 96, 0.5);
    color: #1DB954;
    box-shadow: 0 0 12px rgba(30, 215, 96, 0.3);
  }

  .stream-platform-btn.apple:hover {
    background: rgba(252, 60, 80, 0.22);
    border-color: rgba(252, 60, 80, 0.5);
    color: #FC3C50;
    box-shadow: 0 0 12px rgba(252, 60, 80, 0.3);
  }

  .stream-platform-btn.youtube:hover {
    background: rgba(255, 0, 0, 0.22);
    border-color: rgba(255, 0, 0, 0.5);
    color: #FF0000;
    box-shadow: 0 0 12px rgba(255, 0, 0, 0.3);
  }

  .stream-platform-btn.soundcloud:hover {
    background: rgba(255, 85, 0, 0.22);
    border-color: rgba(255, 85, 0, 0.5);
    color: #FF5500;
    box-shadow: 0 0 12px rgba(255, 85, 0, 0.3);
  }

  .stream-platform-btn.amazon:hover {
    background: rgba(0, 168, 225, 0.22);
    border-color: rgba(0, 168, 225, 0.5);
    color: #00A8E1;
    box-shadow: 0 0 12px rgba(0, 168, 225, 0.3);
  }

  .stream-platform-btn.tidal:hover {
    background: rgba(0, 229, 255, 0.22);
    border-color: rgba(0, 229, 255, 0.5);
    color: #00E5FF;
    box-shadow: 0 0 12px rgba(0, 229, 255, 0.3);
  }

  /* Combined Deck Bar */
  .bottom-deck-bar {
    pointer-events: auto;
    background: rgba(18, 18, 22, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    padding: 0;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.08);
    position: relative;
    overflow: visible;
    display: flex;
    align-items: stretch;
    gap: 0;
    user-select: none;
    touch-action: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .bottom-deck-bar:hover {
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow: 0 16px 44px rgba(0, 0, 0, 0.8), 0 0 14px rgba(255, 255, 255, 0.06);
  }

  .deck-music-section {
    flex: 0 0 60%;
    max-width: 60%;
    min-width: 0;
    position: relative;
    display: flex;
    align-items: center;
    min-height: 48px;
    overflow: visible;
    border-radius: 7px 0 0 7px;
    box-sizing: border-box;
  }

  /* Strictly Clipped Card Container for Timeline Fill & Sheen */
  .deck-timeline-clip-box {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    border-radius: 7px 0 0 7px;
    pointer-events: none;
    z-index: 1;
  }

  /* Soft Translucent Wipe Sheen — Contained strictly inside Clip Box */
  .wave-wipe-overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    height: 100%;
    width: 32px;
    z-index: 30;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.12) 30%,
      rgba(255, 255, 255, 0.35) 50%,
      rgba(255, 255, 255, 0.12) 70%,
      transparent 100%
    );
    opacity: 0;
    transform: translateX(-50%);
  }

  /* Synchronized Curved Curtain Wipe Animation (Left -> Right) */
  .deck-music-section.is-transitioning .wave-wipe-overlay,
  .deck-music-section.is-song-changing .wave-wipe-overlay {
    animation: waveLineSweep 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes waveLineSweep {
    0% {
      left: 0%;
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }

  .deck-music-section.is-transitioning .deck-idle-view {
    position: relative;
    width: 100%;
    height: 100%;
    animation: wipeOutIdleView 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes wipeOutIdleView {
    0% {
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%, 0 50%);
    }
    50% {
      clip-path: polygon(45% 0, 100% 0, 100% 100%, 45% 100%, 52% 50%);
    }
    100% {
      clip-path: polygon(100% 0, 100% 0, 100% 100%, 100% 100%, 100% 50%);
    }
  }

  .deck-music-section.is-transitioning .deck-active-view {
    display: flex !important;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
    animation: revealActiveView 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes revealActiveView {
    0% {
      clip-path: polygon(0 0, 0 0, 0 50%, 0 100%, 0 100%);
    }
    50% {
      clip-path: polygon(0 0, 45% 0, 52% 50%, 45% 100%, 0 100%);
    }
    100% {
      clip-path: polygon(0 0, 100% 0, 100% 50%, 100% 100%, 0 100%);
    }
  }

  /* Song -> Song Curved Wipe Reveal Animation */
  .deck-music-section.is-song-changing .deck-active-view {
    animation: songChangeWipe 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes songChangeWipe {
    0% {
      filter: blur(4px);
      clip-path: polygon(0 0, 0 0, 0 50%, 0 100%, 0 100%);
    }
    50% {
      filter: blur(2px);
      clip-path: polygon(0 0, 45% 0, 52% 50%, 45% 100%, 0 100%);
    }
    100% {
      filter: blur(0px);
      clip-path: polygon(0 0, 100% 0, 100% 50%, 100% 100%, 0 100%);
    }
  }

  .deck-divider {
    width: 1px;
    align-self: center;
    height: 34px;
    background: linear-gradient(180deg, transparent 0%, rgba(255, 255, 255, 0.22) 30%, rgba(255, 255, 255, 0.22) 70%, transparent 100%);
    flex-shrink: 0;
  }

  /* 40% Width Gig Section - Variation 1: Live Tour Pass */
  .deck-gig-section {
    flex: 0 0 calc(40% - 1px);
    max-width: calc(40% - 1px);
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    align-self: stretch;
    padding: 6px 12px;
    background: var(--btn-green);
    color: var(--btn-text-color);
    border-radius: 0 7px 7px 0;
    cursor: pointer;
    font-family: var(--font-secondary);
    transition: transform 0.2s var(--ease-snappy), background-color 0.2s ease, box-shadow 0.2s ease;
    border: none;
    box-sizing: border-box;
    overflow: hidden;
  }

  .deck-gig-section:hover {
    background: var(--btn-green-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 18px rgba(30, 215, 96, 0.35);
  }

  .gig-pill-left-box {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1px;
    min-width: 0;
    overflow: hidden;
  }

  .gig-pill-live-badge {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .live-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--btn-text-color);
    display: inline-block;
    box-shadow: 0 0 0 rgba(11, 26, 14, 0.6);
    animation: livePulseAnim 1.8s infinite;
    flex-shrink: 0;
  }

  @keyframes livePulseAnim {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(11, 26, 14, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 5px rgba(11, 26, 14, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(11, 26, 14, 0);
    }
  }

  .gig-pill-tag {
    font-size: 0.5rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.9;
    line-height: 1;
    white-space: nowrap;
  }

  .gig-pill-text-info {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    min-width: 0;
  }

  .gig-pill-title {
    font-family: var(--font-heading);
    font-size: clamp(0.64rem, 2.4vw, 0.76rem);
    font-weight: 800;
    letter-spacing: 0.03em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: uppercase;
  }

  .gig-pill-sub {
    font-size: 0.52rem;
    font-weight: 700;
    opacity: 0.85;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gig-pill-right-box {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-shrink: 0;
  }

  .pill-map-icon {
    font-size: 0.86rem;
    color: var(--btn-text-color);
  }

  .pill-arrow-icon {
    font-size: 0.62rem;
    opacity: 0.8;
    transition: transform 0.2s var(--ease-snappy);
  }

  .deck-gig-section:hover .pill-arrow-icon {
    transform: translateX(3px);
  }

  .deck-gig-section:hover .pill-arrow-icon {
    transform: translateX(2px);
  }

  /* IDLE VIEW STYLING */
  .deck-idle-view {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;
    cursor: pointer;
    position: relative;
    z-index: 5;
  }

  .stacked-album-covers {
    position: relative;
    width: 44px;
    height: 38px;
    flex-shrink: 0;
  }

  .cover-stack-item {
    position: absolute;
    width: 30px;
    height: 30px;
    border-radius: 4px;
    background: #1a1a1e;
    border: 1px solid rgba(255, 255, 255, 0.22);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.6);
    transition: transform 0.25s var(--ease-snappy);
  }

  .cover-stack-item.item-1 {
    left: 0;
    top: 4px;
    transform: rotate(-10deg);
