---
import { features } from '../../settings/features';
---

<div class="bottom-floating-controls-wrapper" id="bottomFloatingControls">
  <!-- Screen Reader Accessible Live Announcement Region -->
  <div class="sr-only" aria-live="polite" id="audioPlayerAnnouncer"></div>

  <!-- Full-Width Streaming Drawer Panel -->
  <div class="stream-drawer-panel hidden" id="streamDrawerPanel" data-track-container="drawer:stream_platforms">
    <div class="stream-drawer-header">
      <span class="stream-drawer-title">
        <i class="fa-solid fa-compact-disc"></i> Stream on
      </span>
      <button type="button" class="stream-drawer-song-btn brutal-press" id="streamDrawerSongBtn" title="Click to copy song and band name" aria-label="Copy song title and band name">
        <span class="stream-drawer-song" id="streamDrawerSongName"></span>
        <i class="fa-regular fa-copy copy-hint-icon" id="streamDrawerCopyIcon" aria-hidden="true"></i>
      </button>
    </div>
    <div class="stream-platforms-row">
      <a href="https://open.spotify.com/search/KinsBandOfficial" target="_blank" rel="noopener noreferrer" class="stream-platform-btn spotify" id="streamLinkSpotify" title="Spotify" aria-label="Spotify" data-track="stream:spotify" data-platform="spotify">
        <i class="fa-brands fa-spotify" aria-hidden="true"></i>
        <span class="sr-only">Stream on Spotify</span>
      </a>
      <a href="https://music.apple.com/us/search?term=KinsBandOfficial" target="_blank" rel="noopener noreferrer" class="stream-platform-btn apple" id="streamLinkApple" title="Apple Music" aria-label="Apple Music" data-track="stream:apple" data-platform="apple">
        <i class="fa-brands fa-apple" aria-hidden="true"></i>
        <span class="sr-only">Stream on Apple Music</span>
      </a>
      <a href="https://music.youtube.com/search?q=KinsBandOfficial" target="_blank" rel="noopener noreferrer" class="stream-platform-btn youtube" id="streamLinkYoutube" title="YouTube Music" aria-label="YouTube Music" data-track="stream:youtube" data-platform="youtube">
        <i class="fa-brands fa-youtube" aria-hidden="true"></i>
        <span class="sr-only">Stream on YouTube Music</span>
      </a>
      <a href="https://music.amazon.com/search/KinsBandOfficial" target="_blank" rel="noopener noreferrer" class="stream-platform-btn amazon" id="streamLinkAmazon" title="Amazon Music" aria-label="Amazon Music" data-track="stream:amazon" data-platform="amazon">
        <i class="fa-brands fa-amazon" aria-hidden="true"></i>
        <span class="sr-only">Stream on Amazon Music</span>
      </a>
      <a href="https://soundcloud.com/search?q=KinsBandOfficial" target="_blank" rel="noopener noreferrer" class="stream-platform-btn soundcloud" id="streamLinkSoundcloud" title="SoundCloud" aria-label="SoundCloud" data-track="stream:soundcloud" data-platform="soundcloud">
        <i class="fa-brands fa-soundcloud" aria-hidden="true"></i>
        <span class="sr-only">Stream on SoundCloud</span>
      </a>
      <a href="https://bandcamp.com/search?q=KinsBandOfficial" target="_blank" rel="noopener noreferrer" class="stream-platform-btn bandcamp" id="streamLinkBandcamp" title="Bandcamp" aria-label="Bandcamp" data-track="stream:bandcamp" data-platform="bandcamp">
        <i class="fa-brands fa-bandcamp" aria-hidden="true"></i>
        <span class="sr-only">Stream on Bandcamp</span>
      </a>
    </div>
  </div>

  <!-- Neo-Brutalist Dual-Card Bottom Dock -->
  <div class="brutal-bottom-dock" id="bottomAudioBar" data-track-container="dock:audio_player">
    <audio id="vaultAudioPlayer" preload="auto" playsinline webkit-playsinline></audio>

    <!-- Left Card: INSPIRATION PLAYER (Extended Width) -->
    <div class="brutal-player-card deck-music-section" id="deckMusicSection">
      <!-- Folder Tab Sticking Up From Top Left -->
      <div class="card-folder-tab tab-player">INSPIRATION</div>

      <!-- Tactile Neo-Brutalist Timeline Groove Rail along top border -->
      <div class="deck-timeline-groove" id="deckTimelineGroove" role="slider" aria-label="Audio playback progress" aria-valuemin="0" aria-valuemax="30" aria-valuenow="0" aria-valuetext="0:00 of 0:30">
        <div class="groove-rail-track" id="grooveRailTrack"></div>
      </div>

      <!-- Minimalist Turntable Stylus Indicator at Top Edge -->
      <div class="vinyl-stylus-wrapper" id="vinylStylusWrapper" aria-hidden="true">
        <svg class="stylus-turntable-svg" viewBox="0 0 22 18" width="22" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <g class="stylus-head-group" id="stylusTonearmWand">
            <!-- Turntable Cartridge Mount Body -->
            <polygon points="5,1 17,1 18,7 4,7" fill="#141416" stroke="#000000" stroke-width="1.8" stroke-linejoin="round" />
            <!-- Neon Yellow Stylus Grip Body -->
            <polygon points="4,7 18,7 16,13 6,13" fill="#F2FD43" stroke="#000000" stroke-width="1.8" stroke-linejoin="round" />
            <!-- Cartridge Nose / Diamond Needle -->
            <polygon points="8,13 14,13 12,17.5 10,17.5" fill="#141416" stroke="#000000" stroke-width="1.2" />
            <circle cx="11" cy="17.5" r="1.2" fill="#ffffff" stroke="#000000" stroke-width="0.8" />
            <!-- Center Calibration Line -->
            <line x1="11" y1="2" x2="11" y2="10" stroke="#ffffff" stroke-width="1.4" stroke-linecap="round" />
          </g>
        </svg>
      </div>

      <!-- Clipped Progress Fill -->
      <div class="deck-timeline-clip-box">
        <div class="audio-bar-timeline-progress" id="audioBarTimelineProgress"></div>
      </div>

      <!-- IDLE STATE: INSPIRATIONAL -->
      <div class="deck-idle-view" id="deckIdleView">
        <div class="stacked-album-covers" id="stackedAlbumCovers">
          <div class="cover-stack-item item-1">
            <img class="stack-cover-img" id="stackCover1" src="https://is1-ssl.mzstatic.com/image/thumb/Music/y2004/m11/d24/h19/s06.lkkhqoax.jpg/100x100bb.jpg" alt="The Cure - Just Like Heaven" width="36" height="36" loading="eager" decoding="async">
            <i class="fa-solid fa-compact-disc stack-fallback-icon" style="display: none;"></i>
          </div>
          <div class="cover-stack-item item-2">
            <img class="stack-cover-img" id="stackCover2" src="https://is1-ssl.mzstatic.com/image/thumb/Music49/v4/5a/c0/24/5ac024bc-160e-e4bf-7982-80b8069de71a/075679912770.jpg/100x100bb.jpg" alt="Weezer - Do You Wanna Get High?" width="36" height="36" loading="eager" decoding="async">
            <i class="fa-solid fa-compact-disc stack-fallback-icon" style="display: none;"></i>
          </div>
          <div class="cover-stack-item item-3">
            <img class="stack-cover-img" id="stackCover3" src="https://is1-ssl.mzstatic.com/image/thumb/Music115/v4/21/f2/85/21f2856c-b6b9-9855-ede0-57b68427e268/00044006351322.rgb.jpg/100x100bb.jpg" alt="Pulp - Common People" width="36" height="36" loading="eager" decoding="async">
            <i class="fa-solid fa-compact-disc stack-fallback-icon" style="display: none;"></i>
          </div>
        </div>

        <div class="idle-text-info">
          <span class="idle-mix-title">WHAT INSPIRES US!</span>
          <span class="idle-mix-subtitle">listen to what inspires KINS</span>
        </div>

        <button class="idle-play-btn idle-mix-btn brutal-press" id="idlePlayBtn" aria-label="Auto-mix inspiration songs" title="Auto-Mix Inspiration Songs" data-track="player:idle_mix">
          <i class="fa-solid fa-shuffle"></i>
        </button>
      </div>

      <!-- ACTIVE STATE: NOW PLAYING TRACK -->
      <div class="deck-active-view hidden" id="deckActiveView">
        <div class="audio-bar-left">
          <div class="audio-bar-icon-wrap" id="audioBarIconWrap">
            <div class="audio-bar-icon-box" id="audioBarIconBox">
              <img id="audioBarCoverImg" class="audio-bar-cover-img hidden" src="" alt="Album cover" width="36" height="36" loading="lazy" decoding="async">
              <i class="fa-solid fa-compact-disc audio-icon-anim" id="audioBarFallbackIcon"></i>
            </div>
          </div>
          <div class="audio-bar-details">
            <div class="audio-bar-title-container">
              <span class="audio-bar-title" id="audioBarTitle">Just Like Heaven</span>
            </div>
            <div class="audio-bar-meta-row">
              <span class="audio-bar-artist" id="audioBarArtist">The Cure</span>
              <span class="audio-bar-time" id="audioBarTime">0:00 / 0:30</span>
            </div>
          </div>
        </div>

        <div class="audio-bar-right">
          <button class="audio-bar-stream-btn brutal-press" id="audioBarStreamBtn" aria-label="Streaming options" title="Stream or Add to Playlist" data-track="player:stream_options">
            <i class="fa-solid fa-arrow-up-right-from-square"></i>
          </button>
          <button class="audio-bar-toggle-btn brutal-press" id="audioBarToggleBtn" aria-label="Toggle playback" data-track="player:toggle">
            <i class="fa-solid fa-pause"></i>
          </button>
        </div>
      </div>
    </div>

    {features.gigMap && (
    <!-- Right Card: GIG MAP (Tab-Sized Compact Width) -->
    <button type="button" class="brutal-gig-card" id="floatingGigPillBtn" aria-label="Tour dates & Gig Map" data-track="gig:open_map">
      <!-- Folder Tab Spanning Full Width of the Button -->
      <div class="card-folder-tab tab-gigmap">GIG MAP</div>
      
      <div class="gig-card-center-icon">
        <i class="fa-solid fa-map-location-dot"></i>
      </div>

      <!-- High Contrast Diagonal Ribbon from Bottom-Left to Top-Right -->
      <div class="gig-soon-diagonal-banner">
        <span>COMING SOON</span>
      </div>
    </button>
    )}
  </div>
</div>

<div class="bottom-gradient-blur-overlay" id="bottomGradientBlur"></div>

<style>
  .bottom-gradient-blur-overlay {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    /* Gradient origin spans up to ~175px from viewport bottom (matching red line boundary above dock tabs)
       with progressive blur and smooth gradient falloff (z-index 750 < 900). */
    height: calc(175px + env(safe-area-inset-bottom, 0px));
    pointer-events: none;
    z-index: 750;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    mask-image: linear-gradient(to bottom, 
      transparent 0%, 
      rgba(0, 0, 0, 0.35) 20%, 
      rgba(0, 0, 0, 0.85) 50%, 
      black 75%, 
      black 100%
    );
    -webkit-mask-image: linear-gradient(to bottom, 
      transparent 0%, 
      rgba(0, 0, 0, 0.35) 20%, 
      rgba(0, 0, 0, 0.85) 50%, 
      black 75%, 
      black 100%
    );
    background: linear-gradient(to bottom, 
      rgba(20, 20, 22, 0) 0%, 
      rgba(20, 20, 22, 0.25) 20%, 
      rgba(20, 20, 22, 0.70) 50%, 
      rgba(20, 20, 22, 0.95) 75%, 
      rgba(20, 20, 22, 0.99) 100%
    );
    transition: height 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
  }

  :global([data-theme="dark"]) .bottom-gradient-blur-overlay,
  :global(body[data-theme="dark"]) .bottom-gradient-blur-overlay {
    background: linear-gradient(to bottom, 
      rgba(14, 14, 18, 0) 0%, 
      rgba(14, 14, 18, 0.25) 20%, 
      rgba(14, 14, 18, 0.70) 50%, 
      rgba(14, 14, 18, 0.95) 75%, 
      rgba(14, 14, 18, 0.99) 100%
    );
  }

  :global(body.stream-panel-open) .bottom-gradient-blur-overlay {
    height: calc(290px + env(safe-area-inset-bottom, 0px));
  }

  :global(body.modal-open) .bottom-gradient-blur-overlay {
    opacity: 0 !important;
  }

  .bottom-floating-controls-wrapper {
    position: fixed;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    left: 50%;
    transform: translateX(-50%);
    z-index: 900;
    width: calc(100% - 24px);
    max-width: 480px;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  :global(body.modal-open) .bottom-floating-controls-wrapper {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* Streaming Drawer */
  .stream-drawer-panel {
    pointer-events: auto;
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 14px;
    opacity: 0;
    transform: translateY(12px) scale(0.97);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stream-drawer-panel.active-drawer {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .stream-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom: 2px solid #000000;
  }

  .stream-drawer-title {
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-card-primary);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .stream-drawer-song-btn {
    background: transparent;
    border: 1px dashed transparent;
    border-radius: 4px;
    padding: 2px 6px;
    margin: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-card-primary);
    text-align: right;
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.12s var(--ease-tactile);
  }

  .stream-drawer-song-btn:hover {
    background: rgba(0, 0, 0, 0.06);
    border-color: rgba(0, 0, 0, 0.25);
  }

  :global([data-theme="dark"]) .stream-drawer-song-btn:hover,
  :global(body[data-theme="dark"]) .stream-drawer-song-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .stream-drawer-song-btn:focus-visible {
    outline: 2px solid var(--brand-accent-primary);
    outline-offset: 1px;
  }

  .stream-drawer-song-btn .copy-hint-icon {
    font-size: 0.72rem;
    color: var(--text-muted);
    opacity: 0.8;
    transition: color 0.15s ease, transform 0.15s ease, opacity 0.15s ease;
    flex-shrink: 0;
  }

  .stream-drawer-song-btn:hover .copy-hint-icon {
    color: var(--brand-accent-primary);
    opacity: 1;
    transform: scale(1.15);
  }

  .stream-drawer-song-btn.is-copied {
    background: rgba(16, 185, 129, 0.12) !important;
    border-color: rgba(16, 185, 129, 0.5) !important;
  }

  .stream-drawer-song-btn.is-copied .copy-hint-icon {
    color: #10b981 !important;
    opacity: 1 !important;
    transform: scale(1.15);
  }

  .stream-drawer-song {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--text-card-primary);
    max-width: 170px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .stream-platforms-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .stream-platform-btn {
    flex: 1;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background: var(--surface-input);
    border: 2px solid #000000;
    color: var(--text-card-primary);
    text-decoration: none;
    font-size: 1.1rem;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .stream-platform-btn:hover {
    transform: translateY(-2px);
    background: var(--accent-neon-yellow);
    color: #000000;
  }

  /* Neo-Brutalist Dual-Card Dock */
  .brutal-bottom-dock {
    pointer-events: auto;
    display: flex;
    align-items: flex-end;
    gap: 8px;
    width: 100%;
    user-select: none;
    -webkit-user-select: none;
    box-sizing: border-box;
    touch-action: pan-y;
  }

  /* Folder Tab Sticking Up from Top Left */
  .card-folder-tab {
    position: absolute;
    top: -22px;
    left: -3px;
    height: 22px;
    padding: 0 10px;
    border: 3px solid #000000;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-secondary);
    font-size: 0.66rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    color: var(--text-card-primary);
    text-transform: uppercase;
    user-select: none;
    -webkit-user-select: none;
    z-index: 10;
    box-sizing: border-box;
  }

  .card-folder-tab.tab-player {
    background: var(--surface-card-light);
  }

  .card-folder-tab.tab-gigmap {
    background: var(--surface-card-light);
    color: var(--text-card-primary);
    left: -3px;
    right: -3px;
    width: calc(100% + 6px);
    padding: 0 2px;
    text-align: center;
  }

  /* Left Player Card - Dark Neo-Brutalist Surface */
  .brutal-player-card {
    flex: 1 1 auto;
    min-width: 0;
    max-width: none;
    background: #141416;
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 0 8px 8px 8px;
    position: relative;
    display: flex;
    align-items: center;
    min-height: 54px;
    height: 54px;
    box-sizing: border-box;
    overflow: visible;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    cursor: grab;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
  }

  .brutal-player-card.is-scrubbing,
  .brutal-bottom-dock.is-scrubbing {
    cursor: grabbing !important;
  }

  .brutal-player-card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px #000000;
  }

  /* Tactile Neo-Brutalist Timeline Groove Rail */
  .deck-timeline-groove {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3.5px;
    background: rgba(0, 0, 0, 0.45);
    z-index: 12;
    pointer-events: none;
    border-bottom: 1.5px solid rgba(0, 0, 0, 0.7);
    overflow: hidden;
    border-radius: 0 5px 0 0;
  }

  .groove-rail-track {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    background: var(--brand-accent-primary, #f2fd43);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
    opacity: 0.9;
  }

  /* Minimalist Stylus Needle Indicator - Top Edge Accent */
  .vinyl-stylus-wrapper {
    position: absolute;
    top: -15.5px;
    left: 0;
    transform: translateX(-11px);
    pointer-events: none;
    z-index: 35;
    transition: opacity 0.25s ease;
    opacity: 0;
    width: 22px;
    height: 18px;
    filter: drop-shadow(1.5px 1.5px 0px #000000);
    will-change: transform;
  }

  /* Instant zero-lag 1:1 needle & timeline tracking during scrubbing */
  .brutal-bottom-dock.is-scrubbing .vinyl-stylus-wrapper,
  .brutal-player-card.is-scrubbing .vinyl-stylus-wrapper,
  :global(.is-scrubbing) .vinyl-stylus-wrapper,
  .brutal-bottom-dock.is-scrubbing .audio-bar-timeline-progress,
  .brutal-player-card.is-scrubbing .audio-bar-timeline-progress,
  :global(.is-scrubbing) .audio-bar-timeline-progress,
  .brutal-bottom-dock.is-scrubbing .groove-rail-track,
  .brutal-player-card.is-scrubbing .groove-rail-track,
  :global(.is-scrubbing) .groove-rail-track {
    transition: none !important;
  }

  .vinyl-stylus-wrapper.stylus-visible {
    opacity: 1;
  }

  .stylus-turntable-svg {
    display: block;
    width: 22px;
    height: 18px;
    overflow: visible;
  }

  .stylus-head-group {
    transform-origin: 11px 17.5px; /* Pivot directly at needle tip contact point */
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform: translateY(-5px) rotate(-6deg);
    will-change: transform;
  }

  .vinyl-stylus-wrapper.is-playing .stylus-head-group,
  :global(body.is-audio-playing) .stylus-head-group {
    transform: translateY(0px) rotate(0deg);
  }

  .vinyl-stylus-wrapper.is-paused .stylus-head-group {
    transform: translateY(-5px) rotate(-6deg);
  }

  .vinyl-stylus-wrapper.needle-drop-bounce .stylus-head-group {
    animation: needleDropBounce 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .vinyl-stylus-wrapper.needle-lift-ease .stylus-head-group {
    animation: needleLiftEase 0.35s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  @keyframes needleDropBounce {
    0% {
      transform: translateY(-7px) rotate(-8deg);
    }
    40% {
      transform: translateY(1px) rotate(1deg);
    }
    70% {
      transform: translateY(-0.5px) rotate(-0.5deg);
    }
    100% {
      transform: translateY(0px) rotate(0deg);
    }
  }

  @keyframes needleLiftEase {
    0% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-7px) rotate(-8deg);
    }
    100% {
      transform: translateY(-5px) rotate(-6deg);
    }
  }

  .deck-timeline-clip-box {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    border-radius: 0 5px 5px 5px;
    pointer-events: none;
    z-index: 1;
  }

  .audio-bar-timeline-progress {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    height: 100%;
    width: 100%;
    background: rgba(242, 253, 67, 0.25);
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
    z-index: 1;
  }

  /* Idle View */
  .deck-idle-view {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 6px 10px;
    cursor: pointer;
    z-index: 5;
    box-sizing: border-box;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
    transition: opacity 0.2s var(--ease-snappy), transform 0.2s var(--ease-snappy);
    opacity: 1;
    transform: scale(1);
  }

  .deck-idle-view.is-leaving {
    opacity: 0 !important;
    transform: scale(0.96) !important;
    pointer-events: none;
  }

