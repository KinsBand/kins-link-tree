---
---

<!-- Page Preloader & Transition Curtain Overlay -->
<div id="pagePreloaderOverlay" class="page-preloader-overlay active" aria-hidden="true">
  <div class="preloader-curtain">
    <div class="preloader-content">
      <!-- Kins Editorial Logo & Vinyl Spinner -->
      <div class="preloader-brand-box">
        <div class="preloader-disc-icon">
          <i class="fa-solid fa-compact-disc vinyl-spin-anim"></i>
        </div>
        <h1 class="preloader-logo">KINS</h1>
        <span class="preloader-tagline">OFFICIAL LINK IN BIO</span>
      </div>

      <!-- Editorial Wipe Progress Bar -->
      <div class="preloader-progress-track">
        <div class="preloader-progress-bar"></div>
      </div>
    </div>
  </div>
</div>

<style>
  .page-preloader-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    pointer-events: auto;
    overflow: hidden;
    visibility: visible;
  }

  .preloader-curtain {
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #141417 0%, #0a0a0c 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transform: translateY(0%);
    transition: transform 0.45s cubic-bezier(0.77, 0, 0.175, 1);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9);
  }

  .preloader-curtain::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
  }

  .preloader-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    z-index: 2;
    padding: 20px;
    text-align: center;
  }

  .preloader-brand-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .preloader-disc-icon {
    font-size: 2.5rem;
    color: var(--text-white);
    filter: drop-shadow(0 0 12px rgba(242, 240, 235, 0.3));
    margin-bottom: 4px;
  }

  .preloader-logo {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 900;
    letter-spacing: 0.22em;
    color: var(--text-white);
    text-indent: 0.22em;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
  }

  .preloader-tagline {
    font-family: var(--font-secondary);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .preloader-progress-track {
    width: 140px;
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }

  .preloader-progress-bar {
    width: 100%;
    height: 100%;
    background: var(--text-white);
    border-radius: 4px;
    transform: translateX(-100%);
    animation: preloaderBarSweep 1.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes preloaderBarSweep {
    0% {
      transform: translateX(-100%);
    }
    50% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  .page-preloader-overlay.dismissed .preloader-curtain {
    transform: translateY(-100%);
  }

  .page-preloader-overlay.dismissed {
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0s linear 0.45s;
  }

  .page-preloader-overlay.entering {
    visibility: visible;
    pointer-events: auto;
  }

  .page-preloader-overlay.entering .preloader-curtain {
    transform: translateY(0%);
  }
</style>

<script>
  function initPreloaderController() {
    const overlay = document.getElementById('pagePreloaderOverlay');
    if (!overlay) return;

    function dismissCurtain() {
      setTimeout(() => {
        overlay?.classList.remove('active', 'entering');
        overlay?.classList.add('dismissed');
      }, 250);
    }

    function triggerCurtainIn(targetUrl: string) {
      overlay?.classList.remove('dismissed');
      overlay?.classList.add('entering');

      setTimeout(() => {
        window.location.href = targetUrl;
      }, 380);
    }

    if (document.readyState === 'complete') {
      dismissCurtain();
    } else {
      window.addEventListener('load', dismissCurtain);
    }

    document.addEventListener('click', (e) => {
      const targetAnchor = (e.target as HTMLElement).closest('a');
      if (!targetAnchor) return;

      const href = targetAnchor.getAttribute('href');
      if (!href) return;

      if (
        href.startsWith('#') ||
        targetAnchor.getAttribute('target') === '_blank' ||
        href.startsWith('mailto:') ||
        href.startsWith('tel:')
      ) {
        return;
      }

      const isInternal =
        href.startsWith('/') ||
        href.startsWith(window.location.origin) ||
        !href.includes('://');

      if (isInternal) {
        e.preventDefault();
        triggerCurtainIn(href);
      }
    });

    document.addEventListener('astro:before-preparation', () => {
      overlay?.classList.remove('dismissed');
      overlay?.classList.add('entering');
    });

    document.addEventListener('astro:page-load', () => {
      dismissCurtain();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPreloaderController);
  } else {
    initPreloaderController();
  }
</script>
