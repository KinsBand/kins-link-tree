---
---

<!-- Page Preloader & Transition Curtain Overlay -->
<div id="pagePreloaderOverlay" class="page-preloader-overlay active" aria-hidden="true">
  <div class="preloader-curtain">
    <div class="preloader-content">
      <!-- Kins Tactile Brand Box -->
      <div class="preloader-brand-box">
        <!-- Spinning Vinyl Record Icon -->
        <div class="preloader-disc-wrapper">
          <div class="preloader-disc-record">
            <div class="preloader-disc-groove groove-outer"></div>
            <div class="preloader-disc-groove groove-inner"></div>
            <div class="preloader-disc-label">
              <i class="fa-solid fa-compact-disc vinyl-spin-anim"></i>
            </div>
          </div>
        </div>

        <div class="preloader-title-box">
          <h1 class="preloader-logo">KINS</h1>
          <div class="preloader-badge">
            <span class="badge-dot"></span>
            <span class="preloader-tagline">NEWCASTLE • POST-PUNK</span>
          </div>
        </div>
      </div>

      <!-- Tactile Neo-Brutalist Progress Meter -->
      <div class="preloader-progress-container">
        <div class="preloader-progress-track">
          <div class="preloader-progress-bar"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .page-preloader-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    pointer-events: auto;
    overflow: hidden;
    visibility: visible;
    opacity: 1;
    transition: opacity 0.28s var(--ease-snappy), visibility 0.28s ease;
  }

  /* ==========================================================================
     Preloader Curtain - Standard Mode (Light / Warm Chalkboard)
     ========================================================================== */
  .preloader-curtain {
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 50% 30%, #faf9f5 0%, #ebe7dc 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transform: translateY(0%);
    transition: transform 0.38s cubic-bezier(0.77, 0, 0.175, 1);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.85);
  }

  .preloader-curtain::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E");
    pointer-events: none;
  }

  /* ==========================================================================
     Preloader Curtain - Dark Mode
     ========================================================================== */
  :global([data-theme="dark"]) .preloader-curtain,
  :root[data-theme="dark"] .preloader-curtain {
    background: radial-gradient(circle at 50% 30%, #16161c 0%, #09090c 100%);
  }

  :global([data-theme="dark"]) .preloader-curtain::before,
  :root[data-theme="dark"] .preloader-curtain::before {
    opacity: 0.035;
  }

  .preloader-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    z-index: 2;
    padding: 24px;
    text-align: center;
  }

  /* Brand Box */
  .preloader-brand-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  /* Vinyl Record Visual Component */
  .preloader-disc-wrapper {
    position: relative;
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .preloader-disc-record {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: #000000;
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px var(--accent-neon-yellow), 3px 3px 0px 2px #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: transform 0.2s var(--ease-tactile);
  }

  :global([data-theme="dark"]) .preloader-disc-record,
  :root[data-theme="dark"] .preloader-disc-record {
    background: #121216;
    border-color: #000000;
    box-shadow: 3px 3px 0px var(--accent-neon-yellow), 3px 3px 0px 2px #000000;
  }

  .preloader-disc-groove {
    position: absolute;
    border-radius: 50%;
    border: 1px dashed rgba(255, 255, 255, 0.18);
    pointer-events: none;
  }

  .groove-outer {
    width: 52px;
    height: 52px;
  }

  .groove-inner {
    width: 38px;
    height: 38px;
  }

  .preloader-disc-label {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent-neon-yellow);
    border: 1.5px solid #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000000;
    font-size: 0.85rem;
    position: relative;
    z-index: 3;
  }

  .preloader-disc-label i {
    color: #000000 !important;
  }

  /* Typography */
  .preloader-title-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .preloader-logo {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 3.2rem);
    font-weight: 900;
    letter-spacing: 0.24em;
    color: #0a0a0c;
    text-indent: 0.24em;
    margin: 0;
    line-height: 1;
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 0.12);
  }

  :global([data-theme="dark"]) .preloader-logo,
  :root[data-theme="dark"] .preloader-logo {
    color: #f5f5f7;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
  }

  .preloader-badge {
    background: #000000;
    color: var(--accent-neon-yellow);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px var(--accent-neon-yellow);
    border-radius: 4px;
    padding: 3px 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-neon-yellow);
    animation: preloaderDotPulse 1.2s ease infinite;
  }

  @keyframes preloaderDotPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.5; }
  }

  .preloader-tagline {
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-neon-yellow);
  }

  /* Tactile Progress Track */
  .preloader-progress-container {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .preloader-progress-track {
    width: 160px;
    height: 6px;
    background: rgba(0, 0, 0, 0.12);
    border: 1.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }

  :global([data-theme="dark"]) .preloader-progress-track,
  :root[data-theme="dark"] .preloader-progress-track {
    background: rgba(255, 255, 255, 0.1);
    border-color: #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
  }

  .preloader-progress-bar {
    width: 100%;
    height: 100%;
    background: var(--accent-neon-yellow);
    border-right: 1.5px solid #000000;
    border-radius: 3px;
    transform: translateX(-100%);
    animation: preloaderBarSweep 1.1s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes preloaderBarSweep {
    0% {
      transform: translateX(-100%);
    }
    50% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  /* Dismiss States */
  .page-preloader-overlay.dismissed .preloader-curtain {
    transform: translateY(-100%);
  }

  .page-preloader-overlay.dismissed {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.28s var(--ease-snappy), visibility 0s linear 0.28s;
  }

  .page-preloader-overlay.entering {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  .page-preloader-overlay.entering .preloader-curtain {
    transform: translateY(0%);
  }
</style>

<script>
  function initPreloaderController() {
    const overlay = document.getElementById('pagePreloaderOverlay');
    if (!overlay) return;

    function dismissCurtain() {
      requestAnimationFrame(() => {
        overlay?.classList.remove('active', 'entering');
        overlay?.classList.add('dismissed');
      });
    }

    function triggerCurtainIn(targetUrl: string) {
      overlay?.classList.remove('dismissed');
      overlay?.classList.add('entering');

      setTimeout(() => {
        window.location.href = targetUrl;
      }, 250);
    }

    // Dismiss as soon as DOM is interactive (zero artificial delay)
    if (document.readyState === 'interactive' || document.readyState === 'complete') {
      dismissCurtain();
    } else {
      document.addEventListener('DOMContentLoaded', dismissCurtain, { once: true });
    }

    document.addEventListener('click', (e) => {
      const targetAnchor = (e.target as HTMLElement).closest('a');
      if (!targetAnchor) return;

      const href = targetAnchor.getAttribute('href');
      if (!href) return;

      if (
        href.startsWith('#') ||
        targetAnchor.getAttribute('target') === '_blank' ||
        href.startsWith('mailto:') ||
        href.startsWith('tel:')
      ) {
        return;
      }

      const isInternal =
        href.startsWith('/') ||
        href.startsWith(window.location.origin) ||
        !href.includes('://');

      if (isInternal) {
        e.preventDefault();
        triggerCurtainIn(href);
      }
    });

    document.addEventListener('astro:before-preparation', () => {
      overlay?.classList.remove('dismissed');
      overlay?.classList.add('entering');
    });

    document.addEventListener('astro:page-load', () => {
      dismissCurtain();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPreloaderController, { once: true });
  } else {
    initPreloaderController();
  }
</script>
