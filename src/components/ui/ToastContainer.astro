<div id="toastContainer" class="toast-container"></div>

<style>
  .toast-container {
    position: fixed;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10005;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: calc(100% - 32px);
    max-width: 420px;
    pointer-events: none;
  }

  .toast-container :global(.toast) {
    pointer-events: auto;
    cursor: pointer;
    user-select: none;
    position: relative;
    overflow: hidden;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    background: rgba(18, 18, 22, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    padding: 10px 14px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-white, #ffffff);
    font-family: var(--font-secondary, sans-serif);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.35;
    animation: toastSpringIn 0.35s cubic-bezier(0.16, 1.25, 0.3, 1) forwards;
    will-change: transform, opacity;
  }

  .toast-container :global(.toast-icon-box) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    min-width: 28px;
    min-height: 28px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .toast-container :global(.toast-text-content) {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .toast-container :global(.toast-close-btn) {
    background: transparent;
    border: none;
    color: var(--text-muted, rgba(255, 255, 255, 0.6));
    font-size: 0.85rem;
    cursor: pointer;
    padding: 3px 5px;
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: color 0.15s ease, background-color 0.15s ease;
    flex-shrink: 0;
  }

  .toast-container :global(.toast-close-btn:hover) {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.14);
  }

  /* Variant Accents */
  .toast-container :global(.toast.toast-type-music) {
    border-color: rgba(30, 215, 96, 0.4);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.65), 0 0 15px rgba(30, 215, 96, 0.15);
  }
  .toast-container :global(.toast.toast-type-music .toast-icon-box) {
    background: rgba(30, 215, 96, 0.15);
    border-color: rgba(30, 215, 96, 0.4);
    color: #1DB954;
  }

  .toast-container :global(.toast.toast-type-clipboard) {
    border-color: rgba(255, 255, 255, 0.28);
  }
  .toast-container :global(.toast.toast-type-clipboard .toast-icon-box) {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  .toast-container :global(.toast.toast-type-success) {
    border-color: rgba(30, 215, 96, 0.4);
  }
  .toast-container :global(.toast.toast-type-success .toast-icon-box) {
    background: rgba(30, 215, 96, 0.15);
    color: #1DB954;
  }

  .toast-container :global(.toast.toast-type-warning) {
    border-color: rgba(245, 158, 11, 0.4);
  }
  .toast-container :global(.toast.toast-type-warning .toast-icon-box) {
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
  }

  /* Progress Bar Indicator */
  .toast-container :global(.toast-progress-bar) {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--btn-green, #1DB954);
    width: 100%;
    transform-origin: left center;
    animation: toastProgress 2.8s linear forwards;
  }

  .toast-container :global(.toast-fade-out) {
    animation: toastSpringOut 0.25s cubic-bezier(0.4, 0, 1, 1) forwards;
  }

  @keyframes toastSpringIn {
    0% {
      opacity: 0;
      transform: translateY(-16px) scale(0.94);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes toastSpringOut {
    0% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    100% {
      opacity: 0;
      transform: translateY(-12px) scale(0.95);
    }
  }

  @keyframes toastProgress {
    0% { transform: scaleX(1); }
    100% { transform: scaleX(0); }
  }
</style>
