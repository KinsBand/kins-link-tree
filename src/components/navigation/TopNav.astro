---
---

<header class="top-nav">
  <button class="nav-pill-btn nav-icon-btn" id="topSubscribeBtn" aria-label="Subscribe to updates" title="Subscribe">
    <i class="fa-solid fa-bell nav-icon"></i>
  </button>

  <button class="header-search-pill-btn" id="headerSearchPillBtn" aria-label="Search cover videos">
    <i class="fa-solid fa-magnifying-glass search-pill-icon"></i>
    <span class="search-pill-placeholder">search covers...</span>
  </button>

  <button class="nav-pill-btn nav-icon-btn" id="shareBtn" aria-label="Share page" title="Share">
    <i class="fa-solid fa-share-nodes nav-icon"></i>
  </button>
</header>

<style>
  .top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 0;
    margin-top: 0;
    position: relative;
    z-index: 100;
    width: 100%;
    box-sizing: border-box;
    transition: opacity 0.35s ease,
                filter 0.35s ease,
                transform 0.35s ease;
  }

  .top-nav:global(.nav-hidden) {
    opacity: 0;
    filter: blur(8px);
    pointer-events: none;
    transform: translateY(-12px);
  }

  #topSubscribeBtn, #shareBtn {
    transition: opacity 0.2s ease, transform 0.18s var(--ease-snappy), background-color 0.18s ease, border-color 0.18s ease;
  }

  .top-nav.search-active #topSubscribeBtn,
  .top-nav.search-active #shareBtn {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.92);
  }

  .nav-pill-btn {
    background: rgba(18, 18, 20, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--text-white);
    padding: 7px 14px;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    backdrop-filter: blur(12px);
    transition: transform 0.18s var(--ease-snappy), background-color 0.18s ease, border-color 0.18s ease;
    white-space: nowrap;
    box-sizing: border-box;
    user-select: none;
    flex: 0 0 auto;
    min-height: 38px;
  }

  .nav-icon-btn {
    width: 38px;
    height: 38px;
    min-width: 38px;
    padding: 0;
    border-radius: 4px;
  }

  .nav-icon-btn .nav-icon {
    font-size: 0.88rem;
    display: inline-block;
  }

  .nav-pill-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.35);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .nav-pill-btn:active {
    transform: translateY(0);
    background: rgba(255, 255, 255, 0.2);
  }

  #topSubscribeBtn,
  #shareBtn {
    background-color: var(--btn-green);
    color: var(--btn-text-color);
    border-color: transparent;
    font-weight: 800;
  }

  #topSubscribeBtn:hover,
  #shareBtn:hover {
    background-color: var(--btn-green-hover);
    color: #000000;
  }

  .header-search-pill-btn {
    flex: 1 1 auto;
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 0;
    color: var(--text-muted);
    padding: 6px 10px;
    font-family: var(--font-secondary);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    backdrop-filter: blur(12px);
    transition: all 0.2s var(--ease-snappy);
    min-height: 38px;
  }

  .header-search-pill-btn:hover {
    background: rgba(255, 255, 255, 0.04);
    border-bottom-color: rgba(255, 255, 255, 0.5);
    color: var(--text-white);
  }

  .search-pill-icon {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .search-pill-placeholder {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<script>
  const topNav = document.querySelector('.top-nav');
  const leftSidebar = document.getElementById('leftSidebar');

  let lastWindowScrollY = window.scrollY;
  let lastSidebarScrollY = 0;

  function handleWindowScroll() {
    // When sidebar mode is active (≥ 768px), scrolling main view (window) should NOT blur topNav
    if (window.innerWidth >= 768) {
      topNav?.classList.remove('nav-hidden');
      return;
    }

    const currentScrollY = window.scrollY;
    if (!topNav) return;

    if (currentScrollY <= 20) {
      topNav.classList.remove('nav-hidden');
    } else if (currentScrollY > lastWindowScrollY && currentScrollY > 40) {
      topNav.classList.add('nav-hidden');
    } else if (currentScrollY < lastWindowScrollY) {
      topNav.classList.remove('nav-hidden');
    }
    lastWindowScrollY = currentScrollY;
  }

  function handleSidebarScroll() {
    // Only handle sidebar scroll in split sidebar view (≥ 768px)
    if (window.innerWidth < 768 || !leftSidebar || !topNav) return;

    const currentScrollY = leftSidebar.scrollTop;

    if (currentScrollY <= 20) {
      topNav.classList.remove('nav-hidden');
    } else if (currentScrollY > lastSidebarScrollY && currentScrollY > 40) {
      topNav.classList.add('nav-hidden');
    } else if (currentScrollY < lastSidebarScrollY) {
      topNav.classList.remove('nav-hidden');
    }
    lastSidebarScrollY = currentScrollY;
  }

  window.addEventListener('scroll', handleWindowScroll, { passive: true });

  if (leftSidebar) {
    leftSidebar.addEventListener('scroll', handleSidebarScroll, { passive: true });
  }

  const topSubscribeBtn = document.getElementById('topSubscribeBtn');
  const subscribeFormSection = document.getElementById('subscribeFormSection');
  if (topSubscribeBtn && subscribeFormSection) {
    topSubscribeBtn.addEventListener('click', () => {
      subscribeFormSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
      const subTabBtn = document.getElementById('tabSubBtn');
      if (subTabBtn) subTabBtn.click();
      const emailInput = document.getElementById('emailInput') as HTMLInputElement;
      if (emailInput) {
        setTimeout(() => emailInput.focus(), 600);
      }
    });
  }
</script>
