---
---

<header class="top-nav">
  <button class="nav-brutal-btn nav-icon-btn" id="topSubscribeBtn" aria-label="Subscribe to updates" title="Subscribe">
    <i class="fa-solid fa-bell nav-icon"></i>
  </button>

  <button class="header-search-pill-btn" id="headerSearchPillBtn" aria-label="Search cover videos">
    <i class="fa-solid fa-magnifying-glass search-pill-icon"></i>
    <span class="search-pill-placeholder">search covers...</span>
  </button>

  <button class="nav-brutal-btn nav-icon-btn" id="shareBtn" aria-label="Share page" title="Share">
    <i class="fa-solid fa-share-nodes nav-icon"></i>
  </button>
</header>

<style>
  .top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 0;
    margin-top: 0;
    position: relative;
    z-index: 100;
    width: 100%;
    box-sizing: border-box;
    transition: opacity 0.35s ease, filter 0.35s ease, transform 0.35s ease;
  }

  .top-nav:global(.nav-hidden) {
    opacity: 0;
    filter: blur(8px);
    pointer-events: none;
    transform: translateY(-12px);
  }

  #topSubscribeBtn, #shareBtn, .header-search-pill-btn {
    will-change: opacity, transform;
    transition: opacity 0.22s var(--ease-snappy), transform 0.16s var(--ease-tactile), background-color 0.18s ease, box-shadow 0.18s ease;
  }

  .top-nav.search-active #topSubscribeBtn,
  .top-nav.search-active #shareBtn {
    opacity: 0 !important;
    pointer-events: none !important;
    transform: scale(0.92) !important;
  }

  /* Neo-Brutalist Top Action Buttons */
  .nav-brutal-btn {
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    border-radius: 8px;
    font-family: var(--font-secondary);
    font-size: 0.85rem;
    font-weight: 800;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    box-sizing: border-box;
    user-select: none;
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    min-width: 46px;
    min-height: 46px;
  }

  .nav-brutal-btn .nav-icon {
    font-size: 1.05rem;
    color: var(--text-card-primary);
  }

  .nav-brutal-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .nav-brutal-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  /* Subscribed Bell State */
  #topSubscribeBtn.bell-subscribed {
    background: var(--accent-neon-yellow);
    border-color: #000000;
    box-shadow: 2px 2px 0px #000000;
    position: relative;
  }

  #topSubscribeBtn.bell-subscribed::after {
    content: '';
    position: absolute;
    top: 5px;
    right: 5px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #000000;
  }

  .bell-ring-shake {
    display: inline-block;
    animation: youtubeBellShake 0.6s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
  }

  @keyframes youtubeBellShake {
    0% { transform: rotate(0deg); }
    15% { transform: rotate(22deg); }
    30% { transform: rotate(-18deg); }
    45% { transform: rotate(14deg); }
    60% { transform: rotate(-8deg); }
    75% { transform: rotate(4deg); }
    100% { transform: rotate(0deg); }
  }

  /* Neo-Brutalist Search Pill Button */
  .header-search-pill-btn {
    flex: 1 1 auto;
    width: 100%;
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 24px;
    color: var(--text-card-primary);
    padding: 0 16px;
    font-family: var(--font-secondary);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
    height: 46px;
    min-height: 46px;
    box-sizing: border-box;
    user-select: none;
  }

  .header-search-pill-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .header-search-pill-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .search-pill-icon {
    font-size: 0.88rem;
    color: var(--text-card-primary);
  }

  .search-pill-placeholder {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--text-card-secondary);
    flex: 1;
    text-align: left;
  }

  .search-pill-clear-action {
    font-size: 0.82rem;
    color: var(--text-card-muted);
    margin-left: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>

<script>
  import { initSubscribeBell } from '../../scripts/controllers/subscribeController.js';

  const topSubscribeBtn = document.getElementById('topSubscribeBtn');
  const headerSearchPillBtn = document.getElementById('headerSearchPillBtn');
  const shareBtn = document.getElementById('shareBtn');
  const leftSidebar = document.getElementById('leftSidebar');

  let heroBannerImg: HTMLElement | null = null;
  let ticking = false;

  const mql = window.matchMedia('(min-width: 768px)');

  function updateScrollDrivenFade() {
    ticking = false;

    // Detect active scroll context dynamically:
    // Desktop (>= 768px): Scroll offset of #leftSidebar
    // Mobile (< 768px): Scroll offset of window / documentElement
    const scrollOffset = mql.matches && leftSidebar 
      ? leftSidebar.scrollTop 
      : (window.scrollY || document.documentElement.scrollTop || 0);

    // Distance (in pixels) over which elements transition from opacity 1.0 -> 0.0
    const maxFadeDistance = 140;

    // Linear progress ratio between 0.0 and 1.0
    const rawProgress = Math.min(1, Math.max(0, scrollOffset / maxFadeDistance));

    // Deceleration Easing Curve: 1 - (1 - x)^2.5 (Ease-Out Cubic-Bezier)
    // Eliminates harsh linear cuts and produces a gradual, ultra-smooth transparency decay
    const easedProgress = 1 - Math.pow(1 - rawProgress, 2.5);
    const targetOpacity = Math.max(0, 1 - easedProgress);

    if (!heroBannerImg) {
      heroBannerImg = document.getElementById('heroBannerImg') || document.querySelector('.hero-banner-img');
    }

    const elementsToFade = [topSubscribeBtn, headerSearchPillBtn, shareBtn, heroBannerImg];
    const isTransparent = targetOpacity <= 0.02;

    elementsToFade.forEach(el => {
      if (!el) return;
      el.style.opacity = targetOpacity.toFixed(3);
      
      if (isTransparent) {
        el.style.pointerEvents = 'none';
      } else {
        el.style.pointerEvents = '';
      }
    });
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(updateScrollDrivenFade);
      ticking = true;
    }
  }

  function rebindScrollListeners() {
    window.removeEventListener('scroll', onScroll);
    if (leftSidebar) {
      leftSidebar.removeEventListener('scroll', onScroll);
    }

    if (mql.matches && leftSidebar) {
      leftSidebar.addEventListener('scroll', onScroll, { passive: true });
    } else {
      window.addEventListener('scroll', onScroll, { passive: true });
    }
    onScroll();
  }

  mql.addEventListener('change', rebindScrollListeners);
  rebindScrollListeners();
  window.addEventListener('resize', onScroll, { passive: true });

  // Initialize YouTube-Style Notification Bell Component State
  initSubscribeBell();
</script>
