---
---

<header class="top-nav">
  <button class="nav-pill-btn nav-icon-btn" id="topSubscribeBtn" aria-label="Subscribe to updates" title="Subscribe">
    <i class="fa-solid fa-bell nav-icon"></i>
  </button>

  <button class="header-search-pill-btn" id="headerSearchPillBtn" aria-label="Search cover videos">
    <i class="fa-solid fa-magnifying-glass search-pill-icon"></i>
    <span class="search-pill-placeholder">search covers...</span>
  </button>

  <button class="nav-pill-btn nav-icon-btn" id="shareBtn" aria-label="Share page" title="Share">
    <i class="fa-solid fa-share-nodes nav-icon"></i>
  </button>
</header>

<style>
  .top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 0;
    margin-top: 0;
    position: relative;
    z-index: 100;
    width: 100%;
    box-sizing: border-box;
    transition: opacity 0.35s ease,
                filter 0.35s ease,
                transform 0.35s ease;
  }

  .top-nav:global(.nav-hidden) {
    opacity: 0;
    filter: blur(8px);
    pointer-events: none;
    transform: translateY(-12px);
  }

  #topSubscribeBtn, #shareBtn, .header-search-pill-btn {
    will-change: opacity, transform;
    transition: opacity 0.22s var(--ease-snappy), transform 0.22s var(--ease-snappy), background-color 0.18s ease, border-color 0.18s ease;
  }

  .top-nav.search-active #topSubscribeBtn,
  .top-nav.search-active #shareBtn {
    opacity: 0 !important;
    pointer-events: none !important;
    transform: scale(0.92) !important;
  }

  .nav-pill-btn {
    background: rgba(18, 18, 20, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--text-white);
    padding: 7px 14px;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    backdrop-filter: blur(12px);
    transition: transform 0.18s var(--ease-snappy), background-color 0.18s ease, border-color 0.18s ease;
    white-space: nowrap;
    box-sizing: border-box;
    user-select: none;
    flex: 0 0 auto;
    min-height: 38px;
  }

  .nav-icon-btn {
    width: 38px;
    height: 38px;
    min-width: 38px;
    padding: 0;
    border-radius: 4px;
  }

  .nav-icon-btn .nav-icon {
    font-size: 0.88rem;
    display: inline-block;
  }

  .nav-pill-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.35);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .nav-pill-btn:active {
    transform: translateY(0);
    background: rgba(255, 255, 255, 0.2);
  }

  #topSubscribeBtn,
  #shareBtn {
    background-color: var(--btn-green);
    color: var(--btn-text-color);
    border-color: transparent;
    font-weight: 800;
  }

  #topSubscribeBtn:hover,
  #shareBtn:hover {
    background-color: var(--btn-green-hover);
    color: #000000;
  }

  /* YouTube-Style Subscriber Bell Visual States & Animation */
  #topSubscribeBtn.bell-subscribed {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
    box-shadow: 0 0 14px rgba(255, 255, 255, 0.35);
    position: relative;
  }

  #topSubscribeBtn.bell-subscribed::after {
    content: '';
    position: absolute;
    top: 6px;
    right: 6px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #000000;
  }

  .bell-ring-shake {
    display: inline-block;
    animation: youtubeBellShake 0.6s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
  }

  @keyframes youtubeBellShake {
    0% { transform: rotate(0deg); }
    15% { transform: rotate(22deg); }
    30% { transform: rotate(-18deg); }
    45% { transform: rotate(14deg); }
    60% { transform: rotate(-8deg); }
    75% { transform: rotate(4deg); }
    100% { transform: rotate(0deg); }
  }

  .header-search-pill-btn {
    flex: 1 1 auto;
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 0;
    color: var(--text-muted);
    padding: 6px 10px;
    font-family: var(--font-secondary);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    backdrop-filter: blur(12px);
    transition: all 0.2s var(--ease-snappy);
    min-height: 38px;
  }

  .header-search-pill-btn:hover {
    background: rgba(255, 255, 255, 0.04);
    border-bottom-color: rgba(255, 255, 255, 0.5);
    color: var(--text-white);
  }

  .search-pill-icon {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .search-pill-placeholder {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<script>
  import { initSubscribeBell } from '../../scripts/controllers/subscribeController.js';

  const topSubscribeBtn = document.getElementById('topSubscribeBtn');
  const headerSearchPillBtn = document.getElementById('headerSearchPillBtn');
  const shareBtn = document.getElementById('shareBtn');
  const leftSidebar = document.getElementById('leftSidebar');

  let heroBannerImg: HTMLElement | null = null;
  let ticking = false;

  function updateScrollDrivenFade() {
    ticking = false;

    // Detect active scroll context:
    // Desktop (>= 768px): Scroll offset of #leftSidebar
    // Mobile (< 768px): Scroll offset of window / documentElement
    const isDesktop = window.innerWidth >= 768;
    const scrollOffset = isDesktop && leftSidebar 
      ? leftSidebar.scrollTop 
      : (window.scrollY || document.documentElement.scrollTop || 0);

    // Distance (in pixels) over which elements transition from opacity 1.0 -> 0.0
    const maxFadeDistance = 140;

    // Linear progress ratio between 0.0 and 1.0
    const rawProgress = Math.min(1, Math.max(0, scrollOffset / maxFadeDistance));

    // Deceleration Easing Curve: 1 - (1 - x)^2.5 (Ease-Out Cubic-Bezier)
    // Eliminates harsh linear cuts and produces a gradual, ultra-smooth transparency decay
    const easedProgress = 1 - Math.pow(1 - rawProgress, 2.5);
    const targetOpacity = Math.max(0, 1 - easedProgress);

    if (!heroBannerImg) {
      heroBannerImg = document.getElementById('heroBannerImg') || document.querySelector('.hero-banner-img');
    }

    const elementsToFade = [topSubscribeBtn, headerSearchPillBtn, shareBtn, heroBannerImg];
    const isTransparent = targetOpacity <= 0.02;

    elementsToFade.forEach(el => {
      if (!el) return;
      el.style.opacity = targetOpacity.toFixed(3);
      
      if (isTransparent) {
        el.style.pointerEvents = 'none';
      } else {
        el.style.pointerEvents = '';
      }
    });
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(updateScrollDrivenFade);
      ticking = true;
    }
  }

  // Bind scroll triggers efficiently
  const isDesktopEnv = window.innerWidth >= 768;
  if (isDesktopEnv && leftSidebar) {
    leftSidebar.addEventListener('scroll', onScroll, { passive: true });
  } else {
    window.addEventListener('scroll', onScroll, { passive: true });
  }
  window.addEventListener('resize', onScroll, { passive: true });

  // Initial calculation on load
  updateScrollDrivenFade();

  // Initialize YouTube-Style Notification Bell Component State
  initSubscribeBell();
</script>
