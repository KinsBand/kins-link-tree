---
---

<section class="profile-section">
  <p class="profile-bio-text">INDEPENDENT 4-PIECE ROCK BAND</p>

  <div class="profile-actions-row">
    <span class="profile-inline-item location-item">
      <i class="fa-solid fa-location-dot location-pin-icon"></i>
      <span>Newcastle, Australia</span>
      <img src="https://flagcdn.com/w40/au.png" alt="Australia Flag" class="aus-flag-img" loading="eager" decoding="async" width="20" height="13" />
    </span>
  </div>

  <div class="total-followers-card">
    <div class="followers-left">
      <i class="fa-solid fa-users"></i>
      <div class="followers-label-group">
        <span>Total Followers</span>
        <span class="followers-last-updated" id="followersLastUpdated"></span>
      </div>
    </div>
    <div class="followers-count" id="totalFollowersCount">0</div>
  </div>
</section>

<style>
  .profile-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: 0;
    padding: 0 4px;
  }

  .profile-bio-text {
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-white);
    margin: 0 0 6px 0;
    white-space: nowrap;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
  }

  .profile-actions-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .profile-inline-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
  }

  .aus-flag-img {
    width: 18px;
    height: 12px;
    object-fit: cover;
    border-radius: 2px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
    flex-shrink: 0;
    margin-left: 2px;
  }

  .location-pin-icon {
    color: #ff4d4d;
    font-size: 0.8rem;
  }

  .total-followers-card {
    display: none !important;
  }
</style>

<script>
  import { initFollowersTracker } from '../../scripts/controllers/followers.js';
  initFollowersTracker();
</script>
