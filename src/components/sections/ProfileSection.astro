---
---

<section class="profile-section">
  <p class="profile-bio-text">INDEPENDENT 4-PIECE ROCK BAND</p>

  <div class="profile-actions-row">
    <span class="profile-inline-item location-item">
      <i class="fa-solid fa-location-dot location-pin-icon"></i>
      <span>Newcastle, Australia</span>
      <svg class="aus-flag-img" viewBox="0 0 60 30" width="18" height="12" aria-label="Australia Flag" role="img">
        <clipPath id="au-flag-clip"><rect width="60" height="30" rx="2"/></clipPath>
        <g clip-path="url(#au-flag-clip)">
          <rect width="60" height="30" fill="#012169"/>
          <path d="M0 0 L30 15 M30 0 L0 15" stroke="#fff" stroke-width="3"/>
          <path d="M0 0 L30 15 M30 0 L0 15" stroke="#c8102e" stroke-width="1.5"/>
          <path d="M15 0 v15 M0 7.5 h30" stroke="#fff" stroke-width="5"/>
          <path d="M15 0 v15 M0 7.5 h30" stroke="#c8102e" stroke-width="3"/>
          <polygon points="15,19 16.2,21.8 19.1,22.2 16.8,24 17.6,26.9 15,25.2 12.4,26.9 13.2,24 10.9,22.2 13.8,21.8" fill="#fff"/>
          <polygon points="45,24 45.6,25.5 47.1,25.7 45.9,26.7 46.3,28.2 45,27.3 43.7,28.2 44.1,26.7 42.9,25.7 44.4,25.5" fill="#fff"/>
          <polygon points="38,14 38.6,15.5 40.1,15.7 38.9,16.7 39.3,18.2 38,17.3 36.7,18.2 37.1,16.7 35.9,15.7 37.4,15.5" fill="#fff"/>
          <polygon points="45,5 45.6,6.5 47.1,6.7 45.9,7.7 46.3,9.2 45,8.3 43.7,9.2 44.1,7.7 42.9,6.7 44.4,6.5" fill="#fff"/>
          <polygon points="51,11 51.6,12.5 53.1,12.7 51.9,13.7 52.3,15.2 51,14.3 49.7,15.2 50.1,13.7 48.9,12.7 50.4,12.5" fill="#fff"/>
          <polygon points="47,17 47.5,18.2 48.8,18.3 47.8,19.1 48.1,20.4 47,19.6 45.9,20.4 46.2,19.1 45.2,18.3 46.5,18.2" fill="#fff"/>
        </g>
      </svg>
    </span>
  </div>

  <div class="total-followers-card">
    <div class="followers-left">
      <i class="fa-solid fa-users"></i>
      <div class="followers-label-group">
        <span>Total Followers</span>
        <span class="followers-last-updated" id="followersLastUpdated"></span>
      </div>
    </div>
    <div class="followers-count" id="totalFollowersCount">0</div>
  </div>
</section>

<style>
  .profile-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: 0;
    padding: 0 4px;
  }

  .profile-bio-text {
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-white);
    margin: 0 0 6px 0;
    white-space: nowrap;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
  }

  .profile-actions-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .profile-inline-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
  }

  .aus-flag-img {
    width: 18px;
    height: 12px;
    object-fit: cover;
    border-radius: 2px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
    flex-shrink: 0;
    margin-left: 2px;
  }

  .location-pin-icon {
    color: #ff4d4d;
    font-size: 0.8rem;
  }

  .total-followers-card {
    display: none !important;
  }
</style>

<script>
  import { initFollowersTracker } from '../../scripts/controllers/followers.js';
  initFollowersTracker();
</script>
