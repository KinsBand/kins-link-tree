<section class="profile-section" data-track-container="main:profile">
  <div class="profile-tapes-stack">
    <div class="tape-tag-item bio-tag">
      <span>INDEPENDENT 4-PIECE ROCK BAND</span>
    </div>

    <div class="tape-tag-item location-tag">
      <i class="fa-solid fa-location-dot location-pin-icon"></i>
      <span>NEWCASTLE, AUSTRALIA</span>
      <span class="flag-icon" title="Australia" aria-label="Australia Flag">
        <svg class="au-flag-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 320" width="18" height="12" aria-hidden="true">
          <rect width="640" height="320" fill="#00247d"/>
          <g>
            <clipPath id="au-canton"><rect width="320" height="160"/></clipPath>
            <g clip-path="url(#au-canton)">
              <rect width="320" height="160" fill="#00247d"/>
              <path d="M0 0l320 160M320 0L0 160" stroke="#fff" stroke-width="32"/>
              <path d="M0 0l320 160M320 0L0 160" stroke="#cf142b" stroke-width="20" stroke-dasharray="160 160"/>
              <path d="M160 0v160M0 80h320" stroke="#fff" stroke-width="54"/>
              <path d="M160 0v160M0 80h320" stroke="#cf142b" stroke-width="32"/>
            </g>
          </g>
          <polygon fill="#fff" points="160,195 167,215 188,212 173,227 184,245 164,238 152,254 148,234 128,237 143,222 132,204 152,211"/>
          <polygon fill="#fff" points="480,40 483,50 493,48 486,55 491,64 482,60 476,68 474,58 464,60 471,53 466,44 476,48"/>
          <polygon fill="#fff" points="400,120 403,130 413,128 406,135 411,144 402,140 396,148 394,138 384,140 391,133 386,124 396,128"/>
          <polygon fill="#fff" points="550,105 553,115 563,113 556,120 561,129 552,125 546,133 544,123 534,125 541,118 536,109 546,113"/>
          <polygon fill="#fff" points="480,240 483,250 493,248 486,255 491,264 482,260 476,268 474,258 464,260 471,253 466,244 476,248"/>
          <polygon fill="#fff" points="515,160 518,168 526,168 520,173 522,181 515,176 508,181 510,173 504,168 512,168"/>
        </svg>
      </span>
    </div>
  </div>

  <div class="total-followers-card">
    <div class="followers-left">
      <i class="fa-solid fa-users"></i>
      <div class="followers-label-group">
        <span>Total Followers</span>
        <span class="followers-last-updated" id="followersLastUpdated"></span>
      </div>
    </div>
    <div class="followers-count" id="totalFollowersCount">0</div>
  </div>
</section>

<style>
  .profile-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: 0;
    margin-bottom: 6px;
    padding: 0 4px;
    position: relative;
    z-index: 10;
  }

  .profile-tapes-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  /* Authentic Neo-Brutalist Paper Tape Tags */
  .tape-tag-item {
    background: var(--surface-tape);
    color: var(--text-dark);
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    font-family: var(--font-secondary);
    font-size: clamp(0.72rem, 2.8vw, 0.82rem);
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 3px 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    white-space: nowrap;
    user-select: none;
    position: relative;
    transition: transform 0.2s var(--ease-spring);
  }

  .bio-tag {
    transform: rotate(-0.8deg);
  }

  .location-tag {
    transform: rotate(0.6deg);
  }

  .tape-tag-item:hover {
    transform: scale(1.03) rotate(0deg);
  }

  .location-pin-icon {
    color: var(--text-dark);
    font-size: 0.78rem;
  }

  .flag-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    margin-left: 2px;
  }

  .au-flag-svg {
    width: 17px;
    height: 11px;
    border-radius: 2px;
    box-shadow: 1px 1px 0px rgba(0, 0, 0, 0.4);
    display: inline-block;
  }

  .total-followers-card {
    display: none !important;
  }
</style>

<script>
  import { initFollowersTracker } from '../../scripts/controllers/followers.js';
  initFollowersTracker();
</script>
