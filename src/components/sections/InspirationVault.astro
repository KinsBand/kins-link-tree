---
const memberTabs = [
  { key: "all", label: "ALL" },
  { key: "trai", label: "TRAI", memberName: "Trai" },
  { key: "vivian", label: "VIVIAN", memberName: "Vivian" },
  { key: "oscar", label: "OSCAR", memberName: "Oscar" },
  { key: "charlie", label: "CHARLIE", memberName: "Charlie" }
];
---

<section class="inspired-section" id="inspired-section">
  <div class="inspired-header">
    <h3 class="inspired-title"><i class="fa-solid fa-record-vinyl fa-fw"></i> What Inspires Us</h3>
  </div>

  <div class="member-filter-tabs-container" id="memberFilterBar" role="tablist" aria-label="Band Member Inspiration Tabs">
    {memberTabs.map((tab) => (
      <button
        type="button"
        role="tab"
        aria-selected={tab.key === 'all' ? 'true' : 'false'}
        class={`member-filter-tab-btn ${tab.key === 'all' ? 'active' : ''}`}
        data-member-key={tab.key}
        data-member-name={tab.memberName || ''}
      >
        {tab.label}
      </button>
    ))}
  </div>

  <div class="inspired-tracks-container" id="inspiredTracksContainer">
    <!-- Populated dynamically -->
  </div>

  <div class="dots-pagination-container" id="dotsPaginationContainer">
    <button class="page-nav-arrow prev-page-btn" id="prevPageBtn" aria-label="Previous Page">
      <i class="fa-solid fa-chevron-left"></i>
    </button>
    
    <div class="dots-wrapper" id="dotsWrapper">
      <!-- Pagination dots populated dynamically -->
    </div>

    <button class="page-nav-arrow next-page-btn" id="nextPageBtn" aria-label="Next Page">
      <i class="fa-solid fa-chevron-right"></i>
    </button>
  </div>
</section>

<style>
  .inspired-section {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    margin-top: 14px;
    content-visibility: auto;
    contain-intrinsic-size: 0 420px;
  }

  .inspired-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2px;
    user-select: none;
    overflow: visible;
  }

  .inspired-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .inspired-title i {
    color: var(--accent-neon-yellow);
    font-size: 0.9rem;
    width: 1.25em;
    height: 1.25em;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .member-filter-tabs-container {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 2px 2px 8px 2px;
    scrollbar-width: thin;
    scrollbar-color: var(--accent-neon-yellow) rgba(0, 0, 0, 0.35);
    -webkit-overflow-scrolling: touch;
    width: 100%;
    box-sizing: border-box;
  }

  .member-filter-tabs-container::-webkit-scrollbar {
    height: 4px;
    display: block;
  }

  .member-filter-tabs-container::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.3);
    border-radius: 4px;
  }

  .member-filter-tabs-container::-webkit-scrollbar-thumb {
    background: #fbbf24;
    border-radius: 4px;
  }

  .member-filter-tab-btn {
    flex: 1 1 0px;
    min-width: 58px;
    background: rgba(24, 24, 27, 0.9);
    border: 1.5px solid #27272a;
    color: #a1a1aa;
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    padding: 7px 8px;
    border-radius: 6px;
    white-space: nowrap;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.16s var(--ease-tactile);
    user-select: none;
    box-sizing: border-box;
  }

  .member-filter-tab-btn:hover:not(.active) {
    background: #27272a;
    border-color: #3f3f46;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .member-filter-tab-btn.active {
    background: #fbbf24;
    color: #000000;
    border-color: #000000;
    box-shadow: 2px 2px 0px #000000;
    font-weight: 900;
    transform: translateY(0);
  }

  .inspired-tracks-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 220px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  /* Neo-Brutalist Track Card */
  .inspired-tracks-container :global(.music-card) {
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px var(--accent-neon-yellow), 3px 3px 0px 1px #000000;
    border-radius: 8px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 14px;
    cursor: pointer;
    user-select: none;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .inspired-tracks-container :global(.music-card:hover) {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px var(--accent-neon-yellow), 5px 5px 0px 1px #000000;
    background: var(--surface-card-light-hover);
  }

  .inspired-tracks-container :global(.music-card:active) {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0px #000000;
  }

  .inspired-tracks-container :global(.music-card-thumb) {
    width: 46px;
    height: 46px;
    min-width: 46px;
    min-height: 46px;
    border-radius: 6px;
    background: #111114;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
    border: 2px solid #000000;
    transition: border-radius 0.5s cubic-bezier(0.34, 1.35, 0.64, 1),
                box-shadow 0.4s ease,
                border-color 0.4s ease;
  }

  .inspired-tracks-container :global(.music-card-thumb.is-vinyl-disc),
  .inspired-tracks-container :global(.music-card-thumb.vinyl-spin-anim) {
    border-radius: 50%;
    border-color: #000000;
    box-shadow: 0 0 12px var(--accent-neon-yellow-glow);
    will-change: transform, border-radius;
  }

  .inspired-tracks-container :global(.music-card-thumb::after) {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 10px;
    height: 10px;
    background: #121214;
    border: 2px solid #ffffff;
    border-radius: 50%;
    box-shadow: inset 0 0 4px rgba(0, 0, 0, 0.8);
    z-index: 5;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .inspired-tracks-container :global(.music-card-thumb.is-vinyl-disc::after),
  .inspired-tracks-container :global(.music-card-thumb.vinyl-spin-anim::after) {
    opacity: 1;
  }

  .inspired-tracks-container :global(.fallback-disc-icon) {
    font-size: 1.2rem;
    color: var(--accent-neon-yellow);
    transition: transform 0.3s ease;
  }

  .inspired-tracks-container :global(.track-artwork-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
    border-radius: inherit;
    transition: border-radius 0.5s cubic-bezier(0.34, 1.35, 0.64, 1);
  }

  .inspired-tracks-container :global(.music-card-info) {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .inspired-tracks-container :global(.song-title-container) {
    position: relative;
    width: 100%;
    overflow: hidden;
    white-space: nowrap;
    mask-image: linear-gradient(to right, #000 82%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, #000 82%, transparent 100%);
  }

  .inspired-tracks-container :global(.song-title) {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-card-primary);
    letter-spacing: -0.01em;
    display: inline-block;
    white-space: nowrap;
    will-change: transform;
  }

  .inspired-tracks-container :global(.song-title.is-scrolling) {
    animation: inspiredTitleScroll 8s linear infinite;
  }

  @keyframes inspiredTitleScroll {
    0% { transform: translateX(0); }
    15% { transform: translateX(0); }
    85% { transform: translateX(var(--title-scroll-dist, -50%)); }
    100% { transform: translateX(0); }
  }

  .inspired-tracks-container :global(.artist-name) {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-card-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .inspired-tracks-container :global(.genre-meta-row) {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
    flex-wrap: nowrap;
    overflow: hidden;
  }

  .inspired-tracks-container :global(.genre-tag) {
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    color: var(--text-card-muted);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .inspired-tracks-container :global(.member-badges-container) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .inspired-tracks-container :global(.member-curator-badge) {
    height: 16px;
    min-width: 16px;
    padding: 0 5px;
    border-radius: 4px;
    background-color: #fbbf24;
    color: #000000;
    font-family: var(--font-secondary);
    font-size: 10px;
    font-weight: 900;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    user-select: none;
    box-shadow: 1px 1px 0px rgba(0, 0, 0, 0.4);
    box-sizing: border-box;
  }

  .inspired-tracks-container :global(.play-btn) {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 6px;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.88rem;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
  }

  .inspired-tracks-container :global(.play-btn:hover) {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .inspired-tracks-container :global(.empty-curation-state) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 36px 16px;
    background: var(--surface-card-light);
    border: 2px dashed #000000;
    border-radius: 8px;
    text-align: center;
    gap: 8px;
    width: 100%;
    box-sizing: border-box;
  }

  .inspired-tracks-container :global(.empty-icon) {
    font-size: 1.6rem;
    color: #fbbf24;
    text-shadow: 1px 1px 0px #000000;
  }

  .inspired-tracks-container :global(.empty-text) {
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 800;
    color: var(--text-card-primary);
    margin: 0;
  }

  .inspired-tracks-container :global(.empty-subtext) {
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--text-card-muted);
    margin: 0;
  }

  .dots-pagination-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }

  .dots-wrapper {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .page-nav-arrow {
    background: var(--surface-card-light);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    width: 32px;
    height: 32px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 800;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
  }

  .page-nav-arrow:hover:not(:disabled) {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .page-nav-arrow:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.05);
    color: #71717a;
    box-shadow: none;
  }

  .dots-pagination-container :global(.inspired-dot) {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid #000000;
    cursor: pointer;
    padding: 0;
    transition: all 0.2s var(--ease-snappy);
  }

  .dots-pagination-container :global(.inspired-dot:hover) {
    background: rgba(255, 255, 255, 0.5);
  }

  .dots-pagination-container :global(.inspired-dot.active) {
    background: #fbbf24;
    width: 18px;
  }

  @media (min-width: 545px) {
    .inspired-tracks-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 14px;
    }
  }
</style>

<script>
  import { INSPIRATION_TRACKS, getITunesTrackData, loadAlbumArt } from '../../scripts/controllers/inspirationVault.js';

  const MEMBER_INITIALS: Record<string, string> = {
    'Trai': 'T',
    'Vivian': 'V',
    'Oscar': 'O',
    'Charlie': 'C'
  };

  let currentMemberKey = 'all';
  let currentPageIndex = 0;
  let currentPlaybackTrack: any = null;
  let isCurrentlyPlaying = false;
  let isInitialized = false;

  function spinCardToStop(card: HTMLElement, thumb: HTMLElement, durationMs = 480) {
    if ((card as any)._retireAnimId) {
      cancelAnimationFrame((card as any)._retireAnimId);
      (card as any)._retireAnimId = null;
    }

    const transform = thumb.style.transform || '';
    const match = transform.match(/rotate\(([\d.-]+)deg\)/);
    let startAngle = match ? parseFloat(match[1]) : 0;
    if (isNaN(startAngle)) startAngle = 0;

    const normalizedStart = ((startAngle % 360) + 360) % 360;
    let distToUpright = 360 - normalizedStart;
    if (distToUpright === 360) distToUpright = 0;
    if (distToUpright < 75) {
      distToUpright += 360;
    }
    const targetAngle = startAngle + distToUpright;
    const startTime = performance.now();

    function step(now: number) {
      if (card.classList.contains('is-playing')) {
        (card as any)._retireAnimId = null;
        return;
      }

      const elapsed = now - startTime;
      const progress = Math.min(1, elapsed / durationMs);
      const easeOut = 1 - Math.pow(1 - progress, 3.4);
      const currentAngle = startAngle + (targetAngle - startAngle) * easeOut;

      thumb.style.transform = `rotate(${(currentAngle % 360).toFixed(2)}deg)`;

      if (progress >= 0.45) {
        thumb.classList.remove('is-vinyl-disc');
      } else {
        thumb.classList.add('is-vinyl-disc');
      }

      if (progress < 1) {
        (card as any)._retireAnimId = requestAnimationFrame(step);
      } else {
        (card as any)._retireAnimId = null;
        thumb.style.transform = 'rotate(0deg)';
        thumb.classList.remove('is-vinyl-disc', 'vinyl-spin-anim', 'vinyl-spin-decelerate');
        card.classList.remove('is-decelerating', 'is-playing');
      }
    }

    (card as any)._retireAnimId = requestAnimationFrame(step);
  }

  function updateCardStates(currentTrack: any, isPlaying: boolean) {
    const container = document.getElementById('inspiredTracksContainer');
    if (!container) return;
    const cards = container.querySelectorAll('.music-card');
    cards.forEach((card: any) => {
      const songTitle = card.dataset.songTitle;
      const playBtn = card.querySelector('.play-btn');
      const thumb = card.querySelector('.music-card-thumb');
      if (!playBtn || !thumb) return;

      const isCurrent = currentTrack && currentTrack.title === songTitle;
      const playingThis = isCurrent && isPlaying;

      const currentlyShowingPause = playBtn.querySelector('.fa-pause') !== null;

      if (currentlyShowingPause !== playingThis) {
        playBtn.classList.remove('card-icon-morph');
        playBtn.innerHTML = `<i class="fa-solid ${playingThis ? 'fa-pause' : 'fa-play'}"></i>`;
        requestAnimationFrame(() => {
          playBtn.classList.add('card-icon-morph');
        });

        setTimeout(() => {
          playBtn.classList.remove('card-icon-morph');
        }, 350);
      }

      if (playingThis) {
        if (card._retireAnimId) {
          cancelAnimationFrame(card._retireAnimId);
          card._retireAnimId = null;
        }
        card.classList.add('is-playing');
        card.classList.remove('is-decelerating');
        thumb.classList.remove('vinyl-spin-decelerate');
        thumb.classList.add('is-vinyl-disc');
      } else {
        const wasPlaying = card.classList.contains('is-playing');
        card.classList.remove('is-playing');

        if (wasPlaying && !card.classList.contains('is-decelerating')) {
          spinCardToStop(card, thumb);
        } else if (!card.classList.contains('is-decelerating') && !card._retireAnimId) {
          thumb.classList.remove('is-vinyl-disc', 'vinyl-spin-anim', 'vinyl-spin-decelerate');
          thumb.style.transform = 'rotate(0deg)';
        }
      }
    });
  }

  function getFilteredTracks(memberKey: string) {
    if (memberKey === 'all') {
      return INSPIRATION_TRACKS;
    }
    const memberName = memberKey.charAt(0).toUpperCase() + memberKey.slice(1).toLowerCase();
    return INSPIRATION_TRACKS.filter(t => t.curatedBy.some(c => c.toLowerCase() === memberKey.toLowerCase() || c === memberName));
  }

  function renderInspirationPage(memberKey: string, pageIndex: number = 0) {
    const container = document.getElementById('inspiredTracksContainer');
    const dotsContainer = document.getElementById('dotsPaginationContainer');
    if (!container) return;

    currentMemberKey = memberKey;
    const allFiltered = getFilteredTracks(memberKey);
    const pageSize = 4;
    const totalPages = Math.max(1, Math.ceil(allFiltered.length / pageSize));
    currentPageIndex = Math.max(0, Math.min(pageIndex, totalPages - 1));

    if (dotsContainer) {
      const dotsWrapper = document.getElementById('dotsWrapper');
      const prevBtn = document.getElementById('prevPageBtn') as HTMLButtonElement;
      const nextBtn = document.getElementById('nextPageBtn') as HTMLButtonElement;

      if (totalPages > 1) {
        dotsContainer.style.display = 'flex';

        if (dotsWrapper) {
          dotsWrapper.innerHTML = '';
          for (let i = 0; i < totalPages; i++) {
            const dot = document.createElement('button');
            dot.className = `inspired-dot ${i === currentPageIndex ? 'active' : ''}`;
            dot.setAttribute('aria-label', `Page ${i + 1}`);
            dot.addEventListener('click', () => renderInspirationPage(currentMemberKey, i));
            dotsWrapper.appendChild(dot);
          }
        }

        if (prevBtn) {
          prevBtn.disabled = (currentPageIndex === 0);
          prevBtn.onclick = () => {
            if (currentPageIndex > 0) renderInspirationPage(currentMemberKey, currentPageIndex - 1);
          };
        }

        if (nextBtn) {
          nextBtn.disabled = (currentPageIndex === totalPages - 1);
          nextBtn.onclick = () => {
            if (currentPageIndex < totalPages - 1) renderInspirationPage(currentMemberKey, currentPageIndex + 1);
          };
        }
      } else {
        dotsContainer.style.display = 'none';
      }
    }

    container.style.opacity = '0';
    container.style.transform = 'translateY(6px)';

    setTimeout(() => {
      container.innerHTML = '';
      const startIdx = currentPageIndex * pageSize;
      const tracks = allFiltered.slice(startIdx, startIdx + pageSize);

      if (tracks.length === 0) {
        const emptyEl = document.createElement('div');
        emptyEl.className = 'empty-curation-state';
        const memberDisplayName = memberKey.charAt(0).toUpperCase() + memberKey.slice(1);
        emptyEl.innerHTML = `
          <i class="fa-solid fa-sliders empty-icon"></i>
          <p class="empty-text">No tracks curated yet by ${memberDisplayName}.</p>
          <span class="empty-subtext">Check back soon for upcoming picks!</span>
        `;
        container.appendChild(emptyEl);
      }

      tracks.forEach((track: any) => {
        const badgesHtml = (track.curatedBy || []).map((m: string) => {
          const initial = MEMBER_INITIALS[m] || m.charAt(0).toUpperCase();
          return `<span class="member-curator-badge rounded-md bg-amber-400 text-black font-black text-[10px] px-1.5 h-4 inline-flex items-center justify-center" title="Curated by ${m}">${initial}</span>`;
        }).join('');

        const card = document.createElement('div');
        card.className = 'music-card';
        card.dataset.songTitle = track.title;
        card.innerHTML = `
          <div class="music-card-thumb">
            <i class="fa-solid fa-compact-disc fallback-disc-icon"></i>
            <img class="track-artwork-img hidden" alt="${track.title}" width="48" height="48" loading="lazy" decoding="async">
          </div>
          <div class="music-card-info">
            <div class="song-title-container">
              <span class="song-title">${track.title}</span>
            </div>
            <span class="artist-name">${track.artist}</span>
            <div class="genre-meta-row">
              <span class="genre-tag">${track.genre}</span>
              <div class="member-badges-container">
                ${badgesHtml}
              </div>
            </div>
          </div>
          <button class="play-btn card-icon-morph" aria-label="Play song">
            <i class="fa-solid fa-play"></i>
          </button>
        `;

        const fallbackDisc = card.querySelector('.fallback-disc-icon') as HTMLElement;
        const img = card.querySelector('.track-artwork-img') as HTMLImageElement;

        getITunesTrackData(track.artist, track.title).then((meta: any) => {
          if (meta && meta.artworkUrl) {
            track.coverUrl = meta.artworkUrl;
            track.artworkUrl = meta.artworkUrl;
            loadAlbumArt(img, meta.artworkUrl, meta.rawArtworkUrl).then(() => {
              if (fallbackDisc) fallbackDisc.style.display = 'none';
            }).catch(() => {
              if (fallbackDisc) fallbackDisc.style.display = 'flex';
            });
          } else if (fallbackDisc) {
            fallbackDisc.style.display = 'flex';
          }
          if (meta && meta.previewUrl) {
            track.previewUrl = meta.previewUrl;
          }
        });

        card.addEventListener('click', () => {
          if ((window as any).playTrackPreview) {
            (window as any).playTrackPreview(track);
          }
        });

        const playBtn = card.querySelector('.play-btn');
        if (playBtn) {
          playBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            if ((window as any).playTrackPreview) {
              (window as any).playTrackPreview(track);
            }
          });
        }

        container.appendChild(card);
      });

      requestAnimationFrame(() => {
        const titleUpdates: Array<{ el: HTMLElement; dist: number }> = [];
        container.querySelectorAll('.song-title').forEach((titleEl: any) => {
          const parent = titleEl.parentElement;
          if (parent && titleEl.scrollWidth > parent.clientWidth + 2) {
            const dist = -(titleEl.scrollWidth - parent.clientWidth + 16);
            titleUpdates.push({ el: titleEl, dist });
          }
        });
        titleUpdates.forEach(({ el, dist }) => {
          el.style.setProperty('--title-scroll-dist', `${dist}px`);
          el.classList.add('is-scrolling');
        });
      });

      updateCardStates(currentPlaybackTrack, isCurrentlyPlaying);

      container.style.opacity = '1';
      container.style.transform = 'translateY(0)';
    }, 180);
  }

  function selectMemberTabByKey(key: string, pageIndex: number = 0) {
    const filterTabs = document.querySelectorAll('#memberFilterBar .member-filter-tab-btn');
    filterTabs.forEach(b => {
      const isMatch = b.getAttribute('data-member-key') === key;
      b.classList.toggle('active', isMatch);
      b.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      if (isMatch) {
        b.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    });
    renderInspirationPage(key, pageIndex);
  }

  function initInspirationVault() {
    const container = document.getElementById('inspiredTracksContainer');
    const filterTabs = document.querySelectorAll('#memberFilterBar .member-filter-tab-btn');
    if (!container || !filterTabs.length) return;

    filterTabs.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-member-key') || 'all';
        selectMemberTabByKey(key, 0);
      });

      btn.addEventListener('keydown', (e: any) => {
        const btnArray = Array.from(filterTabs) as HTMLButtonElement[];
        if (e.key === 'ArrowRight' && idx < btnArray.length - 1) {
          btnArray[idx + 1].focus();
          btnArray[idx + 1].click();
        } else if (e.key === 'ArrowLeft' && idx > 0) {
          btnArray[idx - 1].focus();
          btnArray[idx - 1].click();
        }
      });
    });

    // Touch / Swipe Navigation Support
    let touchStartX = 0;
    let touchStartY = 0;
    let touchStartTime = 0;
    let isSwiping = false;

    container.addEventListener('touchstart', (e: TouchEvent) => {
      if (e.touches.length !== 1) return;
      const touch = e.touches[0];
      touchStartX = touch.clientX;
      touchStartY = touch.clientY;
      touchStartTime = performance.now();
      isSwiping = true;
    }, { passive: true });

    container.addEventListener('touchmove', (e: TouchEvent) => {
      if (!isSwiping || e.touches.length !== 1) return;
    }, { passive: true });

    container.addEventListener('touchend', (e: TouchEvent) => {
      if (!isSwiping) return;
      isSwiping = false;
      if (!e.changedTouches || e.changedTouches.length === 0) return;

      const touch = e.changedTouches[0];
      const deltaX = touch.clientX - touchStartX;
      const deltaY = touch.clientY - touchStartY;
      const deltaTime = performance.now() - touchStartTime;

      const isHorizontalSwipe = Math.abs(deltaX) > 42 && Math.abs(deltaX) > Math.abs(deltaY) * 1.35;
      const isVelocitySwipe = Math.abs(deltaX) > 28 && deltaTime < 240 && Math.abs(deltaX) > Math.abs(deltaY);

      if (isHorizontalSwipe || isVelocitySwipe) {
        const filtered = getFilteredTracks(currentMemberKey);
        const totalPages = Math.max(1, Math.ceil(filtered.length / 4));

        if (deltaX < 0) {
          // SWIPE LEFT -> NEXT PAGE or NEXT MEMBER TAB
          if (currentPageIndex < totalPages - 1) {
            renderInspirationPage(currentMemberKey, currentPageIndex + 1);
          } else {
            const btnArray = Array.from(filterTabs);
            const currentIndex = btnArray.findIndex(b => b.getAttribute('data-member-key') === currentMemberKey);
            if (currentIndex !== -1 && currentIndex < btnArray.length - 1) {
              const nextBtn = btnArray[currentIndex + 1];
              const nextKey = nextBtn.getAttribute('data-member-key') || 'all';
              selectMemberTabByKey(nextKey, 0);
            }
          }
        } else {
          // SWIPE RIGHT -> PREVIOUS PAGE or PREVIOUS MEMBER TAB
          if (currentPageIndex > 0) {
            renderInspirationPage(currentMemberKey, currentPageIndex - 1);
          } else {
            const btnArray = Array.from(filterTabs);
            const currentIndex = btnArray.findIndex(b => b.getAttribute('data-member-key') === currentMemberKey);
            if (currentIndex > 0) {
              const prevBtn = btnArray[currentIndex - 1];
              const prevKey = prevBtn.getAttribute('data-member-key') || 'all';
              const prevFiltered = getFilteredTracks(prevKey);
              const prevTotalPages = Math.max(1, Math.ceil(prevFiltered.length / 4));
              selectMemberTabByKey(prevKey, prevTotalPages - 1);
            }
          }
        }
      }
    }, { passive: true });

    renderInspirationPage(currentMemberKey, 0);
  }

  window.addEventListener('trackPlaybackStateChanged', (e: any) => {
    const { track, isPlaying } = e.detail || {};
    currentPlaybackTrack = track;
    isCurrentlyPlaying = isPlaying;
    updateCardStates(track, isPlaying);
  });

  // Handle both initial load and Astro View Transitions
  if (!isInitialized) {
    isInitialized = true;
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initInspirationVault);
    } else {
      initInspirationVault();
    }
  }

  document.addEventListener('astro:page-load', () => {
    initInspirationVault();
  });
</script>

