---
import { primarySocials, secondarySocials, primaryStreams, secondaryStreams } from '../../settings/links.config';

const baseUrl = import.meta.env.BASE_URL;
---

<section class="tabbed-links-section" data-track-container="main:tabs">
  <!-- Neo-Brutalist Segmented Tabs -->
  <div class="brutal-tab-switcher">
    <button class="brutal-tab-btn active" id="tabSocialsBtn" data-target="socialsTab" data-track="tab-btn-socials" data-track-container="main:tabs">
      SOCIALS
    </button>
    <button class="brutal-tab-btn" id="tabStreamsBtn" data-target="streamsTab" data-track="tab-btn-streams" data-track-container="main:tabs">
      STREAMS
    </button>
  </div>

  <div class="tab-content active" id="socialsTab">
    <div class="buttons-list">
      {primarySocials.map((link) => (
        <a href={link.url} target="_blank" rel="noopener" class="brutal-link-card" data-platform={link.platform} data-track={`social-btn-${link.platform}`} data-track-container="main:socials_tab">
          <div class="link-left-group">
            <div class="link-icon-box">
              <i class={link.icon}></i>
            </div>
            <span class="link-title-text">{link.name}</span>
          </div>
          <div class="link-arrow-block">
            <i class="fa-solid fa-arrow-up-right-from-square arrow-glyph"></i>
          </div>
        </a>
      ))}
    </div>

    <!-- Expandable Drawer for Extended Socials -->
    <div class="more-socials-container" id="moreSocialsContainer">
      <div class="buttons-list more-socials-list">
        {secondarySocials.map((link) => (
          <a href={link.url} target="_blank" rel="noopener" class="brutal-link-card" data-platform={link.platform} data-track={`secondary-social-${link.platform}`} data-track-container="main:socials_drawer">
            <div class="link-left-group">
              <div class="link-icon-box">
                <i class={link.icon}></i>
              </div>
              <span class="link-title-text">{link.name}</span>
            </div>
            <div class="link-arrow-block">
              <i class="fa-solid fa-arrow-up-right-from-square arrow-glyph"></i>
            </div>
          </a>
        ))}
      </div>
    </div>

    <button class="toggle-more-socials-btn" id="toggleMoreSocialsBtn" type="button" aria-label="Toggle all social channels" data-count={secondarySocials.length} data-track="toggle-more-socials" data-track-container="main:socials_tab">
      <div class="mini-icon-preview">
        {secondarySocials.slice(0, 4).map((link) => (
          <span class="mini-icon-chip" title={link.name}>
            <i class={link.icon}></i>
          </span>
        ))}
      </div>
      <span id="toggleSocialsText">Other (+{secondarySocials.length})</span>
      <i class="fa-solid fa-chevron-down toggle-chevron" id="toggleSocialsIcon"></i>
    </button>
  </div>

  <div class="tab-content" id="streamsTab">
    <div class="buttons-list">
      {primaryStreams.map((link) => (
        <a href={link.url} target="_blank" rel="noopener" class="brutal-link-card stream-link-only" data-platform={link.platform} data-track={`stream-btn-${link.platform}`} data-track-container="main:streams_tab">
          <div class="link-left-group">
            <div class="link-icon-box">
              <i class={link.icon}></i>
            </div>
            <span class="link-title-text">{link.name}</span>
          </div>
          <div class="link-arrow-block">
            <i class="fa-solid fa-arrow-up-right-from-square arrow-glyph"></i>
          </div>
        </a>
      ))}
    </div>

    <!-- Expandable Drawer for Extended Streams -->
    <div class="more-socials-container" id="moreStreamsContainer">
      <div class="buttons-list more-socials-list">
        {secondaryStreams.map((link) => (
          <a href={link.url} target="_blank" rel="noopener" class="brutal-link-card stream-link-only" data-platform={link.platform} data-track={`secondary-stream-${link.platform}`} data-track-container="main:streams_drawer">
            <div class="link-left-group">
              <div class="link-icon-box">
                <i class={link.icon}></i>
              </div>
              <span class="link-title-text">{link.name}</span>
            </div>
            <div class="link-arrow-block">
              <i class="fa-solid fa-arrow-up-right-from-square arrow-glyph"></i>
            </div>
          </a>
        ))}
      </div>
    </div>

    <button class="toggle-more-socials-btn" id="toggleMoreStreamsBtn" type="button" aria-label="Toggle all streaming services" data-count={secondaryStreams.length} data-track="toggle-more-streams" data-track-container="main:streams_tab">
      <div class="mini-icon-preview">
        {secondaryStreams.slice(0, 4).map((link) => (
          <span class="mini-icon-chip" title={link.name}>
            <i class={link.icon}></i>
          </span>
        ))}
      </div>
      <span id="toggleStreamsText">Other (+{secondaryStreams.length})</span>
      <i class="fa-solid fa-chevron-down toggle-chevron" id="toggleStreamsIcon"></i>
    </button>
  </div>
</section>

<style>
  .tabbed-links-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    margin-top: 4px;
  }

  /* Neo-Brutalist Tab Switcher */
  .brutal-tab-switcher {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    width: 100%;
    user-select: none;
  }

  .brutal-tab-btn {
    min-height: 44px;
    height: 44px;
    padding: 0 16px;
    font-family: var(--font-secondary);
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 6px;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-card-light);
    color: var(--text-card-primary);
    border: 3px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    position: relative;
    z-index: 5;
    user-select: none;
    box-sizing: border-box;
  }

  .brutal-tab-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .brutal-tab-btn.active {
    background: #141416 !important;
    color: var(--accent-neon-yellow) !important;
    border: 3px solid var(--accent-neon-yellow) !important;
    box-shadow: 2px 2px 0px #000000, 0 0 12px var(--accent-neon-yellow-glow) !important;
  }

  .tab-content {
    display: none;
  }

  .tab-content.active,
  :global(.tab-content.active) {
    display: block !important;
    animation: fadeInTab 0.2s var(--ease-snappy) forwards;
  }

  @keyframes fadeInTab {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .buttons-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  /* Neo-Brutalist Link Card */
  .brutal-link-card {
    background: var(--surface-card-light);
    border: 2.5px solid #000000;
    box-shadow: 2.5px 2.5px 0px var(--accent-neon-yellow), 2.5px 2.5px 0px 1px #000000;
    border-radius: 6px;
    padding: 0;
    min-height: 48px;
    height: 48px;
    text-decoration: none;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    position: relative;
    cursor: pointer;
    overflow: hidden;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
    user-select: none;
    box-sizing: border-box;
  }

  .brutal-link-card:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1.5px, -1.5px);
    box-shadow: 4px 4px 0px var(--accent-neon-yellow), 4px 4px 0px 1px #000000;
  }

  .brutal-link-card:active {
    transform: translate(1.5px, 1.5px);
    box-shadow: 1px 1px 0px #000000;
  }

  .link-left-group {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 8px;
    flex: 1;
    min-width: 0;
  }

  .link-icon-box {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 5px;
    background: #000000;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    flex-shrink: 0;
    transition: transform 0.18s var(--ease-spring);
  }

  .brutal-link-card:hover .link-icon-box {
    transform: scale(1.08);
  }

  .link-title-text {
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text-card-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .link-arrow-block {
    width: 30px;
    min-width: 30px;
    background: #111114;
    border-left: 2px solid #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-neon-yellow);
    flex-shrink: 0;
    transition: background-color 0.18s ease;
  }

  .arrow-glyph {
    font-size: 0.72rem;
    color: var(--accent-neon-yellow);
    transition: transform 0.18s var(--ease-spring);
  }

  .brutal-link-card:hover .arrow-glyph {
    transform: translate(1.5px, -1.5px);
  }

  /* Expandable Secondary Drawers */
  .more-socials-container {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    margin-top: 0;
    transition: max-height 0.35s var(--ease-snappy), opacity 0.25s ease, margin-top 0.25s ease;
  }

  .more-socials-container.active-drawer {
    max-height: 800px;
    opacity: 1;
    margin-top: 10px;
  }

  /* Toggle More Button */
  .toggle-more-socials-btn {
    width: 100%;
    margin-top: 10px;
    background: var(--surface-card-light);
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 8px 16px;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
  }

  .toggle-more-socials-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .toggle-more-socials-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .mini-icon-preview {
    display: flex;
    align-items: center;
    transition: opacity 0.2s ease, transform 0.2s ease, width 0.2s ease;
  }

  .toggle-more-socials-btn.active .mini-icon-preview {
    opacity: 0;
    pointer-events: none;
    width: 0;
    overflow: hidden;
    margin: 0;
  }

  .mini-icon-chip {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #000000;
    border: 1.5px solid #000000;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.62rem;
    color: #ffffff;
    margin-left: -5px;
    transition: transform 0.2s ease;
  }

  .mini-icon-chip:first-child {
    margin-left: 0;
  }

  .toggle-chevron {
    font-size: 0.72rem;
    color: var(--text-card-primary);
    transition: transform 0.25s var(--ease-snappy);
  }

  .toggle-more-socials-btn.active .toggle-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  import { setupSegmentedSwitcher } from '../../scripts/controllers/tabs.js';
  setupSegmentedSwitcher('.tabbed-links-section .brutal-tab-btn', '.tabbed-links-section .tab-content');

  const tabSocials = document.getElementById('tabSocialsBtn');
  const tabStreams = document.getElementById('tabStreamsBtn');
  const contentSocials = document.getElementById('socialsTab');
  const contentStreams = document.getElementById('streamsTab');

  if (tabSocials && tabStreams && contentSocials && contentStreams) {
    tabSocials.addEventListener('click', (e) => {
      e.preventDefault();
      tabSocials.classList.add('active');
      tabStreams.classList.remove('active');
      contentSocials.classList.add('active');
      contentSocials.style.display = 'block';
      contentStreams.classList.remove('active');
      contentStreams.style.display = 'none';
    });

    tabStreams.addEventListener('click', (e) => {
      e.preventDefault();
      tabStreams.classList.add('active');
      tabSocials.classList.remove('active');
      contentStreams.classList.add('active');
      contentStreams.style.display = 'block';
      contentSocials.classList.remove('active');
      contentSocials.style.display = 'none';
    });
  }

  const toggleSocialsBtn = document.getElementById('toggleMoreSocialsBtn');
  const socialsDrawer = document.getElementById('moreSocialsContainer');
  const socialsTextEl = document.getElementById('toggleSocialsText');

  if (toggleSocialsBtn && socialsDrawer) {
    const count = toggleSocialsBtn.getAttribute('data-count') || '8';
    toggleSocialsBtn.addEventListener('click', () => {
      const isOpen = socialsDrawer.classList.contains('active-drawer');
      if (isOpen) {
        socialsDrawer.classList.remove('active-drawer');
        toggleSocialsBtn.classList.remove('active');
        if (socialsTextEl) socialsTextEl.textContent = `Other (+${count})`;
      } else {
        socialsDrawer.classList.add('active-drawer');
        toggleSocialsBtn.classList.add('active');
        if (socialsTextEl) socialsTextEl.textContent = 'Show Less';
      }
    });
  }

  const toggleStreamsBtn = document.getElementById('toggleMoreStreamsBtn');
  const streamsDrawer = document.getElementById('moreStreamsContainer');
  const streamsTextEl = document.getElementById('toggleStreamsText');

  if (toggleStreamsBtn && streamsDrawer) {
    const count = toggleStreamsBtn.getAttribute('data-count') || '4';
    toggleStreamsBtn.addEventListener('click', () => {
      const isOpen = streamsDrawer.classList.contains('active-drawer');
      if (isOpen) {
        streamsDrawer.classList.remove('active-drawer');
        toggleStreamsBtn.classList.remove('active');
        if (streamsTextEl) streamsTextEl.textContent = `Other (+${count})`;
      } else {
        streamsDrawer.classList.add('active-drawer');
        toggleStreamsBtn.classList.add('active');
        if (streamsTextEl) streamsTextEl.textContent = 'Show Less';
      }
    });
  }
</script>

