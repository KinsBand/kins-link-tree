---
import { platformsData } from '../../settings/platformsData';
import { computePlatformMetrics } from '../../scripts/utils/metricsFormatter';

const { formattedCategoryCounts } = computePlatformMetrics(platformsData);

const primaryStreams = platformsData.filter(p => p.category === 'streams' && p.isPrimary !== false);
const secondaryStreams = platformsData.filter(p => p.category === 'streams' && p.isPrimary === false);

const primarySocials = platformsData.filter(p => p.category === 'socials' && p.isPrimary !== false);
const secondarySocials = platformsData.filter(p => p.category === 'socials' && p.isPrimary === false);

const primaryCommunity = platformsData.filter(p => p.category === 'community' && p.isPrimary !== false);
const secondaryCommunity = platformsData.filter(p => p.category === 'community' && p.isPrimary === false);

const baseUrl = import.meta.env.BASE_URL;
---

<section class="tabbed-links-section" data-track-container="main:tabs">
  <!-- Neo-Brutalist Segmented Tabs: 1) STREAMS, 2) SOCIALS (Default Open), 3) COMMUNITY -->
  <div class="brutal-tab-switcher" role="tablist">
    <button 
      class="brutal-tab-btn" 
      id="tabStreamsBtn" 
      data-target="streamsTab" 
      data-category="streams"
      data-track="tab-btn-streams" 
      data-track-container="main:tabs"
      role="tab"
      aria-selected="false"
    >
      STREAMS
    </button>

    <button 
      class="brutal-tab-btn active" 
      id="tabSocialsBtn" 
      data-target="socialsTab" 
      data-category="socials"
      data-track="tab-btn-socials" 
      data-track-container="main:tabs"
      role="tab"
      aria-selected="true"
    >
      SOCIALS
    </button>

    <button 
      class="brutal-tab-btn" 
      id="tabCommunityBtn" 
      data-target="communityTab" 
      data-category="community"
      data-track="tab-btn-community" 
      data-track-container="main:tabs"
      role="tab"
      aria-selected="false"
    >
      COMMUNITY
    </button>
  </div>

  <!-- STREAMS Tab Content -->
  <div class="tab-content" id="streamsTab" role="tabpanel">
    <div class="buttons-list">
      {primaryStreams.map((link) => (
        <a href={link.url} target="_blank" rel="noopener" class="brutal-link-card stream-link-only" data-platform={link.id} data-name={link.name} data-track={`stream-btn-${link.id}`} data-track-container="main:streams_tab">
          <div class="link-left-group">
            <div class="link-icon-box">
              <i class={link.icon}></i>
              <span class="rec-star-badge" aria-label="Recommended" title="Recommended for you">★</span>
            </div>
            <span class="link-title-text">{link.name}</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Expandable Drawer for Extended Streams -->
    {secondaryStreams.length > 0 && (
      <div class="more-socials-container" id="moreStreamsContainer">
        <div class="buttons-list more-socials-list">
          {secondaryStreams.map((link) => (
            <a href={link.url} target="_blank" rel="noopener" class="brutal-link-card stream-link-only" data-platform={link.id} data-name={link.name} data-track={`secondary-stream-${link.id}`} data-track-container="main:streams_drawer">
              <div class="link-left-group">
                <div class="link-icon-box">
                  <i class={link.icon}></i>
                </div>
                <span class="link-title-text">{link.name}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <button class="toggle-more-socials-btn" id="toggleMoreStreamsBtn" type="button" aria-label="Toggle all streaming services" data-count={secondaryStreams.length} data-track="toggle-more-streams" data-track-container="main:streams_tab">
        <div class="mini-icon-preview">
          {secondaryStreams.slice(0, 4).map((link) => (
            <span class="mini-icon-chip" title={link.name}>
              <i class={link.icon}></i>
            </span>
          ))}
        </div>
        <span id="toggleStreamsText">Other (+{secondaryStreams.length})</span>
        <i class="fa-solid fa-chevron-down toggle-chevron" id="toggleStreamsIcon"></i>
      </button>
    )}
  </div>

  <!-- SOCIALS Tab Content (Default Open) -->
  <div class="tab-content active" id="socialsTab" role="tabpanel">
    <div class="buttons-list">
      {primarySocials.map((link) => (
        <a href={link.url} target="_blank" rel="noopener" class="brutal-link-card" data-platform={link.id} data-name={link.name} data-track={`social-btn-${link.id}`} data-track-container="main:socials_tab">
          <div class="link-left-group">
            <div class="link-icon-box">
              <i class={link.icon}></i>
              <span class="rec-star-badge" aria-label="Recommended" title="Recommended for you">★</span>
            </div>
            <span class="link-title-text">{link.name}</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Expandable Drawer for Extended Socials -->
    {secondarySocials.length > 0 && (
      <div class="more-socials-container" id="moreSocialsContainer">
        <div class="buttons-list more-socials-list">
          {secondarySocials.map((link) => (
            <a href={link.url} target="_blank" rel="noopener" class="brutal-link-card" data-platform={link.id} data-name={link.name} data-track={`secondary-social-${link.id}`} data-track-container="main:socials_drawer">
              <div class="link-left-group">
                <div class="link-icon-box">
                  <i class={link.icon}></i>
                </div>
                <span class="link-title-text">{link.name}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <button class="toggle-more-socials-btn" id="toggleMoreSocialsBtn" type="button" aria-label="Toggle all social channels" data-count={secondarySocials.length} data-track="toggle-more-socials" data-track-container="main:socials_tab">
        <div class="mini-icon-preview">
          {secondarySocials.slice(0, 4).map((link) => (
            <span class="mini-icon-chip" title={link.name}>
              <i class={link.icon}></i>
            </span>
          ))}
        </div>
        <span id="toggleSocialsText">Other (+{secondarySocials.length})</span>
        <i class="fa-solid fa-chevron-down toggle-chevron" id="toggleSocialsIcon"></i>
      </button>
    )}
  </div>

  <!-- COMMUNITY Tab Content -->
  <div class="tab-content" id="communityTab" role="tabpanel">
    <div class="buttons-list">
      {primaryCommunity.map((link) => (
        <a href={link.url} target="_blank" rel="noopener" class="brutal-link-card" data-platform={link.id} data-name={link.name} data-track={`community-btn-${link.id}`} data-track-container="main:community_tab">
          <div class="link-left-group">
            <div class="link-icon-box">
              <i class={link.icon}></i>
              <span class="rec-star-badge" aria-label="Recommended" title="Recommended for you">★</span>
            </div>
            <span class="link-title-text">{link.name}</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Expandable Drawer for Extended Community -->
    {secondaryCommunity && secondaryCommunity.length > 0 && (
      <div class="more-socials-container" id="moreCommunityContainer">
        <div class="buttons-list more-socials-list">
          {secondaryCommunity.map((link) => (
            <a href={link.url} target="_blank" rel="noopener" class="brutal-link-card" data-platform={link.id} data-name={link.name} data-track={`secondary-community-${link.id}`} data-track-container="main:community_drawer">
              <div class="link-left-group">
                <div class="link-icon-box">
                  <i class={link.icon}></i>
                </div>
                <span class="link-title-text">{link.name}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <button class="toggle-more-socials-btn" id="toggleMoreCommunityBtn" type="button" aria-label="Toggle all community links" data-count={secondaryCommunity.length} data-track="toggle-more-community" data-track-container="main:community_tab">
        <div class="mini-icon-preview">
          {secondaryCommunity.slice(0, 4).map((link) => (
            <span class="mini-icon-chip" title={link.name}>
              <i class={link.icon}></i>
            </span>
          ))}
        </div>
        <span id="toggleCommunityText">Other (+{secondaryCommunity.length})</span>
        <i class="fa-solid fa-chevron-down toggle-chevron" id="toggleCommunityIcon"></i>
      </button>
    )}
  </div>
</section>

<style>
  .tabbed-links-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    margin-top: 4px;
  }

  /* Neo-Brutalist Tab Switcher */
  .brutal-tab-switcher {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    width: 100%;
    user-select: none;
  }

  .brutal-tab-btn {
    min-height: 44px;
    height: 44px;
    padding: 0 6px;
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 6px;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    background: var(--surface-card-light, var(--surface-card-panel));
    color: var(--text-card-primary);
    border: 3px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    position: relative;
    z-index: 5;
    user-select: none;
    box-sizing: border-box;
    white-space: nowrap;
  }

  .brutal-tab-btn:hover {
    background: var(--surface-card-light-hover, var(--surface-card-panel-hover));
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .brutal-tab-btn.active {
    background: #141416 !important;
    color: var(--accent-neon-yellow, var(--brand-accent-primary)) !important;
    border: 3px solid var(--accent-neon-yellow, var(--brand-accent-primary)) !important;
    box-shadow: 2px 2px 0px #000000, 0 0 12px var(--accent-neon-yellow-glow, var(--brand-accent-glow)) !important;
  }

  .tab-content {
    display: none;
  }

  .tab-content.active,
  :global(.tab-content.active) {
    display: block !important;
    animation: fadeInTab 0.2s var(--ease-snappy) forwards;
  }

  @keyframes fadeInTab {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .buttons-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  /* Neo-Brutalist Link Card (Clean & Minimalist, Arrow Removed) */
  .brutal-link-card {
    background: var(--surface-card-light, var(--surface-card-panel));
    border: 2.5px solid #000000;
    box-shadow: 2.5px 2.5px 0px var(--accent-neon-yellow, var(--brand-accent-primary)), 2.5px 2.5px 0px 1px #000000;
    border-radius: 6px;
    padding: 0 10px;
    min-height: 48px;
    height: 48px;
    text-decoration: none;
    display: flex;
    align-items: center;
    position: relative;
    cursor: pointer;
    overflow: hidden;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
    user-select: none;
    box-sizing: border-box;
  }

  .brutal-link-card:hover {
    background: var(--surface-card-light-hover, var(--surface-card-panel-hover));
    transform: translate(-1.5px, -1.5px);
    box-shadow: 4px 4px 0px var(--accent-neon-yellow, var(--brand-accent-primary)), 4px 4px 0px 1px #000000;
  }

  .brutal-link-card:active {
    transform: translate(1.5px, 1.5px);
    box-shadow: 1px 1px 0px #000000;
  }

  /* Highlighted / Recommended Card Styling */
  .brutal-link-card.is-recommended {
    border: 2.5px solid #000000;
    box-shadow: 3px 3px 0px var(--accent-neon-yellow, var(--brand-accent-primary)), 3px 3px 0px 1px #000000;
  }

  .link-left-group {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-width: 0;
  }

  .link-icon-box {
    position: relative;
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 5px;
    background: #000000;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    flex-shrink: 0;
    transition: transform 0.18s var(--ease-spring);
  }

  .brutal-link-card:hover .link-icon-box {
    transform: scale(1.08);
  }

  .link-title-text {
    font-family: var(--font-secondary);
    font-size: 0.84rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text-card-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
  }

  /* Minimalist Star Recommendation Pin */
  .rec-star-badge {
    display: none;
    position: absolute;
    top: -4px;
    right: -4px;
    width: 14px;
    height: 14px;
    background: var(--brand-accent-primary, #f2fd43);
    color: #000000;
    font-size: 0.52rem;
    font-weight: 900;
    border: 1.5px solid #000000;
    border-radius: 50%;
    box-shadow: 1px 1px 0px #000000;
    align-items: center;
    justify-content: center;
    line-height: 1;
    z-index: 4;
    user-select: none;
    pointer-events: none;
    animation: popStar 0.2s var(--ease-snappy) forwards;
  }

  .brutal-link-card.is-recommended .rec-star-badge {
    display: flex;
  }

  @keyframes popStar {
    from { opacity: 0; transform: scale(0.5); }
    to { opacity: 1; transform: scale(1); }
  }

  /* Expandable Secondary Drawers */
  .more-socials-container {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    margin-top: 0;
    transition: max-height 0.35s var(--ease-snappy), opacity 0.25s ease, margin-top 0.25s ease;
  }

  .more-socials-container.active-drawer {
    max-height: 800px;
    opacity: 1;
    margin-top: 10px;
  }

  /* Toggle More Button */
  .toggle-more-socials-btn {
    width: 100%;
    margin-top: 10px;
    background: var(--surface-card-light, var(--surface-card-panel));
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 8px 16px;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
  }

  .toggle-more-socials-btn:hover {
    background: var(--surface-card-light-hover, var(--surface-card-panel-hover));
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .toggle-more-socials-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .mini-icon-preview {
    display: flex;
    align-items: center;
    transition: opacity 0.2s ease, transform 0.2s ease, width 0.2s ease;
  }

  .toggle-more-socials-btn.active .mini-icon-preview {
    opacity: 0;
    pointer-events: none;
    width: 0;
    overflow: hidden;
    margin: 0;
  }

  .mini-icon-chip {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #000000;
    border: 1.5px solid #000000;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.62rem;
    color: #ffffff;
    margin-left: -5px;
    transition: transform 0.2s ease;
  }

  .mini-icon-chip:first-child {
    margin-left: 0;
  }

  .toggle-chevron {
    font-size: 0.72rem;
    color: var(--text-card-primary);
    transition: transform 0.25s var(--ease-snappy);
  }

  .toggle-more-socials-btn.active .toggle-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  import { setupSegmentedSwitcher } from '../../scripts/controllers/tabs.js';
  import { getRoutingRuleForUser } from '../../scripts/utils/referral.js';

  function applyReferralRouting() {
    const rule = getRoutingRuleForUser();

    // 1. Activate default tab from routing rule (fallback to Socials)
    let targetTabId = 'socialsTab';
    let targetBtnId = 'tabSocialsBtn';

    if (rule && rule.default_tab) {
      if (rule.default_tab === 'Streams') {
        targetTabId = 'streamsTab';
        targetBtnId = 'tabStreamsBtn';
      } else if (rule.default_tab === 'Community') {
        targetTabId = 'communityTab';
        targetBtnId = 'tabCommunityBtn';
      } else if (rule.default_tab === 'Socials') {
        targetTabId = 'socialsTab';
        targetBtnId = 'tabSocialsBtn';
      }
    }

    const targetBtn = document.getElementById(targetBtnId);
    const targetContent = document.getElementById(targetTabId);

    if (targetBtn && targetContent) {
      document.querySelectorAll('.tabbed-links-section .brutal-tab-btn').forEach((btn) => {
        btn.classList.remove('active');
        btn.setAttribute('aria-selected', 'false');
      });
      document.querySelectorAll('.tabbed-links-section .tab-content').forEach((content) => {
        content.classList.remove('active');
        content.style.display = 'none';
      });

      targetBtn.classList.add('active');
      targetBtn.setAttribute('aria-selected', 'true');
      targetContent.classList.add('active');
      targetContent.style.display = 'block';
    }

    // 2. Clear previous recommended badges
    document.querySelectorAll('.tabbed-links-section .brutal-link-card.is-recommended').forEach((card) => {
      card.classList.remove('is-recommended');
    });

    // 3. Highlight and prioritize recommended platforms per tab
    if (rule && rule.recommended) {
      const tabConfigs = [
        { containerId: 'streamsTab', recNames: rule.recommended.streams || [] },
        { containerId: 'socialsTab', recNames: rule.recommended.socials || [] },
        { containerId: 'communityTab', recNames: rule.recommended.community || [] }
      ];

      tabConfigs.forEach(({ containerId, recNames }) => {
        const container = document.getElementById(containerId);
        if (!container || !recNames.length) return;

        const primaryList = container.querySelector('.buttons-list:not(.more-socials-list)');
        if (!primaryList) return;

        const cards = Array.from(primaryList.querySelectorAll('.brutal-link-card'));
        const recCards = [];
        const otherCards = [];

        cards.forEach((card) => {
          const name = (card.getAttribute('data-name') || '').toLowerCase();
          const isRec = recNames.some((r) => r.toLowerCase() === name);
          if (isRec) {
            card.classList.add('is-recommended');
            recCards.push(card);
          } else {
            otherCards.push(card);
          }
        });

        // Reorder so recommended appear at the top of their list
        if (recCards.length > 0) {
          recCards.forEach((card) => primaryList.appendChild(card));
          otherCards.forEach((card) => primaryList.appendChild(card));
        }
      });
    }
  }

  function initTabbedLinks() {
    setupSegmentedSwitcher('.tabbed-links-section .brutal-tab-btn', '.tabbed-links-section .tab-content');
    applyReferralRouting();

    const setupDrawer = (btnId, drawerId, textId) => {
      const btn = document.getElementById(btnId);
      const drawer = document.getElementById(drawerId);
      const textEl = document.getElementById(textId);

      if (btn && drawer && !btn.dataset.drawerBound) {
        btn.dataset.drawerBound = 'true';
        const count = btn.getAttribute('data-count') || '0';
        btn.addEventListener('click', () => {
          const isOpen = drawer.classList.contains('active-drawer');
          if (isOpen) {
            drawer.classList.remove('active-drawer');
            btn.classList.remove('active');
            if (textEl) textEl.textContent = `Other (+${count})`;
          } else {
            drawer.classList.add('active-drawer');
            btn.classList.add('active');
            if (textEl) textEl.textContent = 'Show Less';
          }
        });
      }
    };

    setupDrawer('toggleMoreStreamsBtn', 'moreStreamsContainer', 'toggleStreamsText');
    setupDrawer('toggleMoreSocialsBtn', 'moreSocialsContainer', 'toggleSocialsText');
    setupDrawer('toggleMoreCommunityBtn', 'moreCommunityContainer', 'toggleCommunityText');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTabbedLinks);
  } else {
    initTabbedLinks();
  }
  document.addEventListener('astro:page-load', initTabbedLinks);
</script>
