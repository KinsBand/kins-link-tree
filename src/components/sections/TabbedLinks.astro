---
const primarySocials = [
  { name: "Instagram", icon: "fa-brands fa-instagram", url: "https://instagram.com/KinsBandOfficial", platform: "instagram" },
  { name: "TikTok", icon: "fa-brands fa-tiktok", url: "https://tiktok.com/@KinsBandOfficial", platform: "tiktok" },
  { name: "YouTube", icon: "fa-brands fa-youtube", url: "https://youtube.com/@KinsBandOfficial", platform: "youtube" },
  { name: "Facebook", icon: "fa-brands fa-facebook", url: "https://facebook.com/KinsBandOfficial", platform: "facebook" },
  { name: "Substack", icon: "fa-solid fa-bookmark", url: "https://kinsbandoffical.substack.com", platform: "substack" },
  { name: "Threads", icon: "fa-brands fa-threads", url: "https://threads.net/@KinsBandOfficial", platform: "threads" }
];

const secondarySocials = [
  { name: "Twitter / X", icon: "fa-brands fa-x-twitter", url: "https://x.com/KinsBandOfficial", platform: "twitter" },
  { name: "Snapchat", icon: "fa-brands fa-snapchat", url: "https://snapchat.com/add/KinsBandOfficial", platform: "snapchat" },
  { name: "Reddit", icon: "fa-brands fa-reddit-alien", url: "https://reddit.com/r/KinsBand", platform: "reddit" },
  { name: "Discord", icon: "fa-brands fa-discord", url: "https://discord.gg", platform: "discord" },
  { name: "Patreon", icon: "fa-brands fa-patreon", url: "https://patreon.com/KinsBand", platform: "patreon" },
  { name: "Twitch", icon: "fa-brands fa-twitch", url: "https://twitch.tv/KinsBandOfficial", platform: "twitch" },
  { name: "Pinterest", icon: "fa-brands fa-pinterest", url: "https://pinterest.com/KinsBandOfficial", platform: "pinterest" },
  { name: "LinkedIn", icon: "fa-brands fa-linkedin-in", url: "https://linkedin.com/company/KinsBandOfficial", platform: "linkedin" }
];

const streams = [
  { name: "Spotify", icon: "fa-brands fa-spotify", url: "https://open.spotify.com/search/KinsBandOfficial", platform: "spotify" },
  { name: "Apple Music", icon: "fa-brands fa-apple", url: "https://music.apple.com/search?term=KinsBandOfficial", platform: "apple" },
  { name: "YT Music", icon: "fa-brands fa-youtube", url: "https://music.youtube.com/search?q=KinsBandOfficial", platform: "ytmusic" },
  { name: "Amazon Music", icon: "fa-brands fa-amazon", url: "https://music.amazon.com/search/KinsBandOfficial", platform: "amazon" },
  { name: "SoundCloud", icon: "fa-brands fa-soundcloud", url: "https://soundcloud.com/KinsBandOfficial", platform: "soundcloud" },
  { name: "Deezer", icon: "fa-brands fa-deezer", url: "https://www.deezer.com/search/KinsBandOfficial", platform: "deezer" },
  { name: "Tidal", icon: "fa-solid fa-water", url: "https://listen.tidal.com/search?q=KinsBandOfficial", platform: "tidal" },
  { name: "Bandcamp", icon: "fa-brands fa-bandcamp", url: "https://bandcamp.com/search?q=KinsBandOfficial", platform: "bandcamp" },
  { name: "Audiomack", icon: "fa-solid fa-headphones", url: "https://audiomack.com/search?q=KinsBandOfficial", platform: "audiomack" },
  { name: "Qobuz", icon: "fa-solid fa-compact-disc", url: "https://www.qobuz.com/search?q=KinsBandOfficial", platform: "qobuz" }
];
---

<section class="tabbed-links-section">
  <div class="segmented-switcher-box">
    <button class="switcher-tab active" id="tabSocialsBtn" data-target="socialsTab">
      Socials
    </button>
    <button class="switcher-tab" id="tabStreamsBtn" data-target="streamsTab">
      Streams
    </button>
  </div>

  <div class="tab-content active" id="socialsTab">
    <div class="buttons-list">
      {primarySocials.map((link) => (
        <a href={link.url} target="_blank" rel="noopener" class="green-link-btn" data-platform={link.platform}>
          <div class="btn-icon"><i class={link.icon}></i></div>
          <span class="btn-text">{link.name}</span>
          <i class="fa-solid fa-arrow-up-right-from-square btn-arrow"></i>
        </a>
      ))}
    </div>

    <!-- Expandable Drawer for Extended Socials -->
    <div class="more-socials-container" id="moreSocialsContainer">
      <div class="buttons-list more-socials-list">
        {secondarySocials.map((link) => (
          <a href={link.url} target="_blank" rel="noopener" class="green-link-btn" data-platform={link.platform}>
            <div class="btn-icon"><i class={link.icon}></i></div>
            <span class="btn-text">{link.name}</span>
            <i class="fa-solid fa-arrow-up-right-from-square btn-arrow"></i>
          </a>
        ))}
      </div>
    </div>

    <button class="toggle-more-socials-btn" id="toggleMoreSocialsBtn" type="button" aria-label="Toggle all social channels">
      <span id="toggleSocialsText">Show All Channels (+8)</span>
      <i class="fa-solid fa-chevron-down" id="toggleSocialsIcon"></i>
    </button>
  </div>

  <div class="tab-content" id="streamsTab">
    <div class="buttons-list">
      {streams.map((link) => (
        <a href={link.url} target="_blank" rel="noopener" class="green-link-btn stream-link-only" data-platform={link.platform}>
          <div class="btn-icon"><i class={link.icon}></i></div>
          <span class="btn-text">{link.name}</span>
          <i class="fa-solid fa-arrow-up-right-from-square btn-arrow"></i>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .tabbed-links-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .tab-content {
    display: none;
  }

  .tab-content:global(.active) {
    display: block;
    animation: fadeInTab 0.25s var(--ease-snappy) forwards;
  }

  @keyframes fadeInTab {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .buttons-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .more-socials-container {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    margin-top: 0;
    transition: max-height 0.4s var(--ease-snappy), opacity 0.3s ease, margin-top 0.3s ease;
  }

  .more-socials-container.active-drawer {
    max-height: 800px;
    opacity: 1;
    margin-top: 10px;
  }

  .toggle-more-socials-btn {
    width: 100%;
    margin-top: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px dashed rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    padding: 11px 16px;
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.2s ease;
  }

  .toggle-more-socials-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .toggle-more-socials-btn i {
    font-size: 0.75rem;
    transition: transform 0.3s ease;
  }

  .toggle-more-socials-btn.active i {
    transform: rotate(180deg);
  }

  .green-link-btn {
    background: rgba(18, 18, 20, 0.85);
    color: var(--text-white);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 14px 18px;
    min-height: 52px;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    position: relative;
    cursor: pointer;
    overflow: hidden;
    backdrop-filter: blur(12px);
    transition: transform 0.2s var(--ease-snappy), border-color 0.2s ease, background-color 0.2s ease;
    user-select: none;
  }

  .green-link-btn:hover {
    background: rgba(26, 26, 30, 0.95);
    border-color: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  .green-link-btn:active {
    transform: translateY(0);
    background: rgba(35, 35, 40, 1);
  }

  .btn-icon {
    font-size: 1.15rem;
    width: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
    color: var(--text-white);
    flex-shrink: 0;
    transition: transform 0.2s var(--ease-snappy);
  }

  .green-link-btn:hover .btn-icon {
    transform: scale(1.1);
  }

  .btn-text {
    font-family: var(--font-secondary);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    flex: 1;
    text-align: left;
    color: var(--text-white);
  }

  .btn-arrow {
    font-size: 0.72rem;
    color: var(--text-muted);
    transition: transform 0.2s var(--ease-snappy), color 0.2s ease;
  }

  .green-link-btn:hover .btn-arrow {
    color: var(--text-white);
    transform: translate(2px, -2px);
  }
</style>

<script>
  import { setupSegmentedSwitcher } from '../../scripts/controllers/tabs.js';
  setupSegmentedSwitcher('.tabbed-links-section .switcher-tab', '.tabbed-links-section .tab-content');

  const toggleBtn = document.getElementById('toggleMoreSocialsBtn');
  const drawer = document.getElementById('moreSocialsContainer');
  const textEl = document.getElementById('toggleSocialsText');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = drawer.classList.contains('active-drawer');
      if (isOpen) {
        drawer.classList.remove('active-drawer');
        toggleBtn.classList.remove('active');
        if (textEl) textEl.textContent = 'Show All Channels (+8)';
      } else {
        drawer.classList.add('active-drawer');
        toggleBtn.classList.add('active');
        if (textEl) textEl.textContent = 'Show Less';
      }
    });
  }
</script>
