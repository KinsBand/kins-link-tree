---
const mockClips = [
  {
    id: 'clip-1',
    handle: '@mitch_drums',
    title: 'Everlong',
    tag: 'Drum Cover',
    platform: 'tiktok',
    platformIcon: 'fa-tiktok',
    platformName: 'TikTok',
    bgGradient: 'linear-gradient(145deg, #2d124d 0%, #120e24 100%)',
    icon: 'fa-drum'
  },
  {
    id: 'clip-2',
    handle: '@alex_covers',
    title: 'Just Like Heaven',
    tag: 'Vocal & Guitar',
    platform: 'instagram',
    platformIcon: 'fa-instagram',
    platformName: 'IG Reel',
    bgGradient: 'linear-gradient(145deg, #4d122b 0%, #1a0a14 100%)',
    icon: 'fa-guitar'
  },
  {
    id: 'clip-3',
    handle: '@sydney_live',
    title: 'Sydney Live Clip',
    tag: 'Front Row Edit',
    platform: 'youtube',
    platformIcon: 'fa-youtube',
    platformName: 'Shorts',
    bgGradient: 'linear-gradient(145deg, #123d4d 0%, #091a24 100%)',
    icon: 'fa-video'
  },
  {
    id: 'clip-4',
    handle: '@indie_edits',
    title: 'Kins Tour Vibe',
    tag: 'Fan Edit',
    platform: 'tiktok',
    platformIcon: 'fa-tiktok',
    platformName: 'TikTok',
    bgGradient: 'linear-gradient(145deg, #3d3b12 0%, #171607 100%)',
    icon: 'fa-clapperboard'
  }
];
---

<section class="spotlight-section" id="spotlight-section">
  <!-- Section Header -->
  <div class="spotlight-header">
    <div class="header-title-box">
      <h3 class="spotlight-title"><i class="fa-solid fa-users"></i> Community</h3>
      <p class="spotlight-subtitle">Covers, edits, and live clips from the Kins community.</p>
    </div>
    <div class="section-scroll-controls">
      <button type="button" class="scroll-arrow-btn" id="spotlightScrollPrev" aria-label="Scroll community clips left">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <button type="button" class="scroll-arrow-btn" id="spotlightScrollNext" aria-label="Scroll community clips right">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
  </div>

  <!-- Snap-Scroll Horizontal Video Row -->
  <div class="spotlight-scroll-container" id="spotlightScrollContainer">
    {mockClips.map((clip) => (
      <div class="spotlight-card" data-clip-id={clip.id}>
        <div class="card-media-wrapper" style={`background: ${clip.bgGradient}`}>
          <!-- Mock Graphic Element -->
          <div class="mock-bg-art">
            <i class={`fa-solid ${clip.icon} mock-icon-bg`}></i>
          </div>

          <!-- Top Right Platform Badge -->
          <div class="platform-badge">
            <i class={`fa-brands ${clip.platformIcon}`}></i>
            <span>{clip.platformName}</span>
          </div>

          <!-- Center Glassmorphism Play Button -->
          <div class="play-btn-circle">
            <i class="fa-solid fa-play"></i>
          </div>

          <!-- Bottom Card Content Overlay -->
          <div class="card-content-overlay">
            <span class="creator-handle">{clip.handle}</span>
            <span class="clip-subtext">"{clip.title}" • {clip.tag}</span>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Bottom Submission Banner -->
  <div class="submission-banner">
    <div class="banner-text-content">
      <h4 class="banner-title"><i class="fa-solid fa-sparkles banner-sparkle-icon"></i> SUBMISSIONS</h4>
      <p class="banner-desc">
        Tag <button type="button" class="copy-handle-pill" id="copyHandlePill" title="Copy @KinsBandOfficial handle">
          <span>@KinsBandOfficial</span>
          <i class="fa-regular fa-copy"></i>
        </button> or share your link to get featured.
      </p>
    </div>
    <button type="button" class="submit-fan-clip-btn" id="openCommunityModalBtn">
      <span>Submit Fan Clip</span>
      <i class="fa-solid fa-plus"></i>
    </button>
  </div>
</section>

<style>
  .spotlight-section {
    width: 100%;
    margin-top: 14px;
    margin-bottom: 10px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    content-visibility: auto;
    contain-intrinsic-size: 0 450px;
  }

  /* Section Header */
  .spotlight-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 0 2px;
  }

  .header-title-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .spotlight-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .spotlight-title i {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .spotlight-subtitle {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .scroll-hint-pill {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 4px 10px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
  }

  .section-scroll-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .scroll-arrow-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-white);
    width: 28px;
    height: 28px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.72rem;
    transition: all 0.18s ease;
  }

  .scroll-arrow-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.28);
    color: var(--btn-green);
    transform: translateY(-1px);
  }

  /* Snap-Scroll Container */
  .spotlight-scroll-container {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 2px 14px 2px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }

  .spotlight-scroll-container::-webkit-scrollbar {
    height: 4px;
    display: block;
  }

  .spotlight-scroll-container::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 2px;
  }

  .spotlight-scroll-container::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
  }

  .spotlight-scroll-container::-webkit-scrollbar-thumb:hover {
    background: var(--btn-green);
  }

  /* Individual 9:16 Card */
  .spotlight-card {
    flex: 0 0 210px;
    height: 373px;
    scroll-snap-align: start;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    cursor: pointer;
    backdrop-filter: blur(12px);
    transition: transform 0.25s var(--ease-snappy), border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .spotlight-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6);
  }

  .card-media-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 12px;
    overflow: hidden;
  }

  .card-media-wrapper::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.1) 40%, rgba(0, 0, 0, 0.85) 100%);
    z-index: 1;
    transition: opacity 0.25s ease;
  }

  .spotlight-card:hover .card-media-wrapper::before {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.2) 40%, rgba(0, 0, 0, 0.92) 100%);
  }

  .mock-bg-art {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 0;
    overflow: hidden;
  }

  .mock-icon-bg {
    font-size: 8rem;
    color: rgba(255, 255, 255, 0.07);
    transition: transform 0.35s var(--ease-snappy);
  }

  .spotlight-card:hover .mock-icon-bg {
    transform: scale(1.08) rotate(6deg);
  }

  .platform-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 3;
    background: var(--text-white);
    color: var(--text-dark);
    font-family: var(--font-secondary);
    font-size: 0.55rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 2px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 4px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
  }

  .platform-badge i {
    font-size: 0.65rem;
  }

  .play-btn-circle {
    position: absolute;
    top: 45%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(10px);
    color: var(--text-white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    z-index: 2;
    padding-left: 3px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    transition: transform 0.25s var(--ease-snappy), background-color 0.25s ease, border-color 0.25s ease;
  }

  .spotlight-card:hover .play-btn-circle {
    transform: translate(-50%, -50%) scale(1.14);
    background: rgba(255, 255, 255, 0.28);
    border-color: rgba(255, 255, 255, 0.6);
  }

  .card-content-overlay {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-top: auto;
  }

  .creator-handle {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-white);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
    letter-spacing: -0.01em;
  }

  .clip-subtext {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .submission-banner {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    backdrop-filter: blur(12px);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .submission-banner:hover {
    border-color: rgba(255, 255, 255, 0.26);
    background: rgba(24, 24, 28, 0.92);
  }

  .banner-text-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .banner-title {
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
  }

  .banner-sparkle-icon {
    color: var(--btn-green);
    font-size: 0.8rem;
  }

  .banner-desc {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
    display: block;
  }

  .copy-handle-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--text-white);
    padding: 3px 8px;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 700;
    cursor: pointer;
    vertical-align: middle;
    margin: 0 3px;
    transition: all 0.18s ease;
  }

  .copy-handle-pill:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-1px);
  }

  .submit-fan-clip-btn {
    background: var(--btn-green);
    color: var(--btn-text-color);
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    padding: 12px 20px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    transition: transform 0.18s var(--ease-snappy), background-color 0.18s ease;
  }

  .submit-fan-clip-btn:hover {
    background: var(--btn-green-hover);
    transform: translateY(-1px);
  }

  @media (min-width: 768px) {
    .submission-banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 18px 24px;
    }

    .banner-text-content {
      flex: 1;
      min-width: 0;
    }

    .banner-title {
      font-size: 0.9rem;
    }

    .banner-desc {
      font-size: 0.82rem;
    }

    .submit-fan-clip-btn {
      width: auto;
      max-width: 320px;
      padding: 12px 24px;
      font-size: 0.82rem;
      flex-shrink: 0;
      white-space: nowrap;
    }
  }

  @media (min-width: 768px) {
    .spotlight-card {
      flex: 0 0 240px;
      height: 340px;
    }
  }

  @media (min-width: 1200px) {
    .spotlight-card {
      flex: 0 0 260px;
      height: 350px;
    }
  }
</style>

<script>
  import { copyToClipboard, animateCopySuccess } from '../../scripts/controllers/clipboard.js';
  import { showToast } from '../../scripts/controllers/toast.js';

  const spotlightContainer = document.getElementById('spotlightScrollContainer');
  const spotlightPrevBtn = document.getElementById('spotlightScrollPrev');
  const spotlightNextBtn = document.getElementById('spotlightScrollNext');

  function updateSpotlightNav() {
    if (!spotlightContainer) return;
    const isOverflowing = spotlightContainer.scrollWidth > spotlightContainer.clientWidth + 4;
    const controlsGroup = spotlightPrevBtn?.parentElement;
    if (controlsGroup) {
      controlsGroup.style.display = isOverflowing ? 'flex' : 'none';
    }
  }

  if (spotlightContainer) {
    updateSpotlightNav();
    window.addEventListener('resize', updateSpotlightNav);
    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(updateSpotlightNav).observe(spotlightContainer);
    }

    spotlightContainer.addEventListener('wheel', (e) => {
      if (e.deltaY !== 0) {
        e.preventDefault();
        spotlightContainer.scrollLeft += e.deltaY;
      }
    }, { passive: false });

    spotlightPrevBtn?.addEventListener('click', () => {
      spotlightContainer.scrollBy({ left: -260, behavior: 'smooth' });
    });

    spotlightNextBtn?.addEventListener('click', () => {
      spotlightContainer.scrollBy({ left: 260, behavior: 'smooth' });
    });
  }

  const copyPill = document.getElementById('copyHandlePill');
  copyPill?.addEventListener('click', async (e) => {
    e.stopPropagation();
    const ok = await copyToClipboard('@KinsBandOfficial');
    if (ok) {
      animateCopySuccess(copyPill);
      showToast("Copied @KinsBandOfficial handle!");
    }
  });

  const openModalBtn = document.getElementById('openCommunityModalBtn');
  openModalBtn?.addEventListener('click', () => {
    const modal = document.getElementById('communitySubmissionModal');
    modal?.classList.remove('hidden');
  });
</script>
