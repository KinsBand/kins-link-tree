---
const featureCards = [
  {
    id: 'spot-1',
    category: 'Drum Cover',
    title: 'Drum Cover Slot',
    badge: 'Spot Open',
    actionText: 'Get Featured',
    bgGradient: 'linear-gradient(145deg, rgba(45, 18, 77, 0.9) 0%, rgba(18, 14, 36, 0.96) 100%)',
    icon: 'fa-drum'
  },
  {
    id: 'spot-2',
    category: 'Guitar & Bass',
    title: 'Guitar / Bass Slot',
    badge: 'Spot Open',
    actionText: 'Get Featured',
    bgGradient: 'linear-gradient(145deg, rgba(77, 18, 43, 0.9) 0%, rgba(26, 10, 20, 0.96) 100%)',
    icon: 'fa-guitar'
  },
  {
    id: 'spot-3',
    category: 'Vocal Cover',
    title: 'Vocal Cover Slot',
    badge: 'Spot Open',
    actionText: 'Get Featured',
    bgGradient: 'linear-gradient(145deg, rgba(18, 61, 77, 0.9) 0%, rgba(9, 26, 36, 0.96) 100%)',
    icon: 'fa-microphone'
  },
  {
    id: 'spot-4',
    category: 'Fan Edit',
    title: 'Fan Edit / Live Slot',
    badge: 'Spot Open',
    actionText: 'Get Featured',
    bgGradient: 'linear-gradient(145deg, rgba(61, 59, 18, 0.9) 0%, rgba(23, 22, 7, 0.96) 100%)',
    icon: 'fa-clapperboard'
  }
];
---

<section class="spotlight-section" id="spotlight-section">
  <!-- Section Header -->
  <div class="spotlight-header">
    <div class="header-title-box">
      <h3 class="spotlight-title"><i class="fa-solid fa-users fa-fw"></i> Community</h3>
    </div>
    <div class="section-scroll-controls">
      <button type="button" class="scroll-arrow-btn" id="spotlightScrollPrev" aria-label="Scroll community clips left">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <button type="button" class="scroll-arrow-btn" id="spotlightScrollNext" aria-label="Scroll community clips right">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
  </div>

  <!-- Snap-Scroll Horizontal Video Row -->
  <div class="spotlight-scroll-container" id="spotlightScrollContainer">
    {featureCards.map((clip) => (
      <div class="spotlight-card empty-feature-card" data-clip-id={clip.id} data-category={clip.category} title={`Submit your ${clip.category} to get featured!`}>
        <div class="card-media-wrapper" style={`background: ${clip.bgGradient}`}>
          <!-- Mock Graphic Element -->
          <div class="mock-bg-art">
            <i class={`fa-solid ${clip.icon} mock-icon-bg`}></i>
          </div>

          <!-- Top Right Availability Badge -->
          <div class="availability-badge">
            <i class="fa-solid fa-sparkles badge-sparkle"></i>
            <span>{clip.badge}</span>
          </div>

          <!-- Center Interactive Plus / Feature Button -->
          <div class="feature-btn-circle">
            <i class="fa-solid fa-plus"></i>
            <span class="feature-btn-sub">Submit</span>
          </div>

          <!-- Bottom Card Content Overlay -->
          <div class="card-content-overlay">
            <span class="category-header-pill"><i class={`fa-solid ${clip.icon}`}></i> {clip.category}</span>
            <span class="creator-handle">Your Video Here</span>
            <span class="clip-subtext">Click to submit or tag @KinsBandOfficial</span>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Bottom Submission Banner -->
  <div class="submission-banner">
    <div class="banner-text-content">
      <h4 class="banner-title"><i class="fa-solid fa-sparkles banner-sparkle-icon"></i> SUBMISSIONS OPEN</h4>
      <p class="banner-desc">
        Tag <button type="button" class="copy-handle-pill" id="copyHandlePill" title="Copy @KinsBandOfficial handle">
          <span>@KinsBandOfficial</span>
          <i class="fa-regular fa-copy"></i>
        </button> or submit your link to get featured in these spots.
      </p>
    </div>
    <button type="button" class="submit-fan-clip-btn" id="openCommunityModalBtn">
      <span>Submit Fan Clip</span>
      <i class="fa-solid fa-plus"></i>
    </button>
  </div>
</section>

<style>
  .spotlight-section {
    width: 100%;
    margin-top: 14px;
    margin-bottom: 10px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    content-visibility: auto;
    contain-intrinsic-size: 0 450px;
  }

  /* Section Header */
  .spotlight-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2px;
    cursor: pointer;
    user-select: none;
    overflow: visible;
  }

  .header-title-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
    overflow: visible;
  }

  .spotlight-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
    overflow: visible;
  }

  .spotlight-title i {
    color: var(--text-muted);
    font-size: 0.85rem;
    width: 1.25em;
    height: 1.25em;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: visible;
    transform-origin: 50% 50% !important;
    /* Plays 2 subtle pulse cycles on load (~2.8s total) then times out & settles */
    animation: pulseCommunityIntro 1.4s cubic-bezier(0.25, 1, 0.5, 1) 2 forwards;
    transition: color 0.3s ease, filter 0.3s ease;
  }

  /* Triggered on press / click down */
  .spotlight-header:active .spotlight-title i {
    color: var(--text-white);
    filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.45));
    /* Re-triggers 1 snappy bounce/pulse cycle on press then settles */
    animation: bounceCommunityPress 0.9s cubic-bezier(0.34, 1.56, 0.64, 1) 1 forwards;
  }

  @keyframes pulseCommunityIntro {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-1.5px) scale(1.14); }
  }

  @keyframes bounceCommunityPress {
    0% { transform: translateY(0) scale(1); }
    30% { transform: translateY(-3px) scale(1.22); }
    65% { transform: translateY(0.5px) scale(1.08); }
    100% { transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .spotlight-title i {
      animation: none !important;
    }
  }

  .spotlight-subtitle {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .scroll-hint-pill {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 4px 10px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
  }

  .section-scroll-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .scroll-arrow-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-white);
    width: 28px;
    height: 28px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.72rem;
    transition: all 0.18s ease;
  }

  .scroll-arrow-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.28);
    color: var(--btn-green);
    transform: translateY(-1px);
  }

  /* Snap-Scroll Container */
  .spotlight-scroll-container {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 2px 14px 2px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }

  .spotlight-scroll-container::-webkit-scrollbar {
    height: 4px;
    display: block;
  }

  .spotlight-scroll-container::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 2px;
  }

  .spotlight-scroll-container::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
  }

  .spotlight-scroll-container::-webkit-scrollbar-thumb:hover {
    background: var(--btn-green);
  }

  /* Individual 9:16 Card */
  .spotlight-card {
    flex: 0 0 210px;
    height: 373px;
    scroll-snap-align: start;
    border-radius: 12px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    cursor: pointer;
    backdrop-filter: blur(12px);
    transition: transform 0.25s var(--ease-snappy), border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .spotlight-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6);
  }

  .card-media-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 12px;
    overflow: hidden;
  }

  .card-media-wrapper::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.1) 40%, rgba(0, 0, 0, 0.85) 100%);
    z-index: 1;
    transition: opacity 0.25s ease;
  }

  .spotlight-card:hover .card-media-wrapper::before {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.2) 40%, rgba(0, 0, 0, 0.92) 100%);
  }

  .mock-bg-art {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 0;
    overflow: hidden;
  }

  .mock-icon-bg {
    font-size: 8rem;
    color: rgba(255, 255, 255, 0.07);
    transition: transform 0.35s var(--ease-snappy);
  }

  .spotlight-card:hover .mock-icon-bg {
    transform: scale(1.08) rotate(6deg);
  }

  .spotlight-card.empty-feature-card {
    border: 1px dashed rgba(255, 255, 255, 0.22);
  }

  .spotlight-card.empty-feature-card:hover {
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 12px 32px rgba(255, 255, 255, 0.15);
  }

  .availability-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 3;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.6rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 20px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 5px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(6px);
  }

  .badge-sparkle {
    font-size: 0.62rem;
    color: var(--text-white);
  }

  .feature-btn-circle {
    position: absolute;
    top: 42%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1.5px dashed rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(10px);
    color: var(--text-white);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    z-index: 2;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    transition: all 0.25s var(--ease-snappy);
  }

  .feature-btn-sub {
    font-family: var(--font-secondary);
    font-size: 0.54rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-top: 2px;
  }

  .spotlight-card:hover .feature-btn-circle {
    transform: translate(-50%, -50%) scale(1.12);
    background: var(--text-white);
    border-style: solid;
    border-color: var(--text-white);
    color: var(--text-dark);
    box-shadow: 0 8px 26px rgba(255, 255, 255, 0.3);
  }

  .category-header-pill {
    font-family: var(--font-secondary);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-white);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 2px;
  }

  .card-content-overlay {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-top: auto;
  }

  .creator-handle {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-white);
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
    letter-spacing: -0.01em;
  }

  .clip-subtext {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .submission-banner {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    backdrop-filter: blur(12px);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .submission-banner:hover {
    border-color: rgba(255, 255, 255, 0.26);
    background: rgba(24, 24, 28, 0.92);
  }

  .banner-text-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .banner-title {
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
  }

  .banner-sparkle-icon {
    color: var(--btn-green);
    font-size: 0.8rem;
  }

  .banner-desc {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
    display: block;
  }

  .copy-handle-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--text-white);
    padding: 3px 8px;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 700;
    cursor: pointer;
    vertical-align: middle;
    margin: 0 3px;
    transition: all 0.18s ease;
  }

  .copy-handle-pill:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-1px);
  }

  .submit-fan-clip-btn {
    background: var(--btn-green);
    color: var(--btn-text-color);
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    padding: 12px 20px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    transition: transform 0.18s var(--ease-snappy), background-color 0.18s ease;
  }

  .submit-fan-clip-btn:hover {
    background: var(--btn-green-hover);
    transform: translateY(-1px);
  }

  @media (min-width: 768px) {
    .submission-banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 18px 24px;
    }

    .banner-text-content {
      flex: 1;
      min-width: 0;
    }

    .banner-title {
      font-size: 0.9rem;
    }

    .banner-desc {
      font-size: 0.82rem;
    }

    .submit-fan-clip-btn {
      width: auto;
      max-width: 320px;
      padding: 12px 24px;
      font-size: 0.82rem;
      flex-shrink: 0;
      white-space: nowrap;
    }
  }

  @media (min-width: 768px) {
    .spotlight-card {
      flex: 0 0 240px;
      height: 340px;
    }
  }

  @media (min-width: 1200px) {
    .spotlight-card {
      flex: 0 0 260px;
      height: 350px;
    }
  }
</style>

<script>
  import { copyToClipboard, animateCopySuccess } from '../../scripts/controllers/clipboard.js';
  import { showToast } from '../../scripts/controllers/toast.js';

  const spotlightContainer = document.getElementById('spotlightScrollContainer');
  const spotlightPrevBtn = document.getElementById('spotlightScrollPrev');
  const spotlightNextBtn = document.getElementById('spotlightScrollNext');

  let spotlightRafId: number | null = null;

  function updateSpotlightNav() {
    if (!spotlightContainer) return;
    if (spotlightRafId) cancelAnimationFrame(spotlightRafId);
    spotlightRafId = requestAnimationFrame(() => {
      const isOverflowing = spotlightContainer.scrollWidth > spotlightContainer.clientWidth + 4;
      const controlsGroup = spotlightPrevBtn?.parentElement;
      if (controlsGroup) {
        controlsGroup.style.display = isOverflowing ? 'flex' : 'none';
      }
    });
  }

  if (spotlightContainer) {
    updateSpotlightNav();
    window.addEventListener('resize', updateSpotlightNav, { passive: true });

    spotlightContainer.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
        spotlightContainer.scrollLeft += e.deltaX;
      }
    }, { passive: true });

    spotlightPrevBtn?.addEventListener('click', () => {
      spotlightContainer.scrollBy({ left: -260, behavior: 'smooth' });
    });

    spotlightNextBtn?.addEventListener('click', () => {
      spotlightContainer.scrollBy({ left: 260, behavior: 'smooth' });
    });
  }

  const copyPill = document.getElementById('copyHandlePill');
  copyPill?.addEventListener('click', async (e) => {
    e.stopPropagation();
    const ok = await copyToClipboard('@KinsBandOfficial');
    if (ok) {
      animateCopySuccess(copyPill);
      showToast("Copied @KinsBandOfficial handle!");
    }
  });

  const openModalBtn = document.getElementById('openCommunityModalBtn');
  openModalBtn?.addEventListener('click', () => {
    const modal = document.getElementById('communitySubmissionModal');
    modal?.classList.remove('hidden');
  });

  // Empty Feature Cards Click Handlers
  const emptyFeatureCards = document.querySelectorAll('.spotlight-card.empty-feature-card');
  emptyFeatureCards.forEach(card => {
    card.addEventListener('click', () => {
      const category = card.getAttribute('data-category');
      const modal = document.getElementById('communitySubmissionModal');
      if (modal) {
        modal.classList.remove('hidden');
        if (category) {
          const categoryInput = document.getElementById('selectedCategoryInput') as HTMLInputElement;
          if (categoryInput) categoryInput.value = category;
          
          const displayLabel = document.getElementById('communityCategoryDisplayLabel');
          if (displayLabel) displayLabel.textContent = category;

          const categoryBtns = document.querySelectorAll('#categoryTagsGrid .category-tag-btn');
          categoryBtns.forEach(btn => {
            if (btn.getAttribute('data-category') === category) {
              btn.classList.add('active');
            } else {
              btn.classList.remove('active');
            }
          });
        }
      }
    });
  });
</script>
