---
const featureCards = [
  {
    id: 'spot-1',
    category: 'Drum Cover',
    title: 'Drum Cover Slot',
    badge: 'Spot Open',
    actionText: 'Get Featured',
    bgGradient: 'linear-gradient(145deg, rgba(45, 18, 77, 0.9) 0%, rgba(18, 14, 36, 0.96) 100%)',
    icon: 'fa-drum'
  },
  {
    id: 'spot-2',
    category: 'Guitar & Bass',
    title: 'Guitar / Bass Slot',
    badge: 'Spot Open',
    actionText: 'Get Featured',
    bgGradient: 'linear-gradient(145deg, rgba(77, 18, 43, 0.9) 0%, rgba(26, 10, 20, 0.96) 100%)',
    icon: 'fa-guitar'
  },
  {
    id: 'spot-3',
    category: 'Vocal Cover',
    title: 'Vocal Cover Slot',
    badge: 'Spot Open',
    actionText: 'Get Featured',
    bgGradient: 'linear-gradient(145deg, rgba(18, 61, 77, 0.9) 0%, rgba(9, 26, 36, 0.96) 100%)',
    icon: 'fa-microphone'
  },
  {
    id: 'spot-4',
    category: 'Fan Edit',
    title: 'Fan Edit / Live Slot',
    badge: 'Spot Open',
    actionText: 'Get Featured',
    bgGradient: 'linear-gradient(145deg, rgba(61, 59, 18, 0.9) 0%, rgba(23, 22, 7, 0.96) 100%)',
    icon: 'fa-clapperboard'
  }
];
---

<section class="spotlight-section" id="spotlight-section">
  <!-- Section Header -->
  <div class="spotlight-header">
    <div class="header-title-box">
      <h3 class="spotlight-title"><i class="fa-solid fa-users fa-fw"></i> Community</h3>
    </div>
    <div class="section-scroll-controls">
      <button type="button" class="scroll-arrow-btn" id="spotlightScrollPrev" aria-label="Scroll community clips left">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <button type="button" class="scroll-arrow-btn" id="spotlightScrollNext" aria-label="Scroll community clips right">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
  </div>

  <!-- Snap-Scroll Horizontal Video Row -->
  <div class="spotlight-scroll-container brutal-scroll-x" id="spotlightScrollContainer">
    {featureCards.map((clip) => (
      <div class="spotlight-card empty-feature-card" data-clip-id={clip.id} data-category={clip.category} title={`Submit your ${clip.category} to get featured!`}>
        <div class="card-media-wrapper" style={`background: ${clip.bgGradient}`}>
          <!-- Mock Graphic Element -->
          <div class="mock-bg-art">
            <i class={`fa-solid ${clip.icon} mock-icon-bg`}></i>
          </div>

          <!-- Top Right Availability Badge -->
          <div class="availability-badge">
            <i class="fa-solid fa-sparkles badge-sparkle"></i>
            <span>{clip.badge}</span>
          </div>

          <!-- Center Interactive Plus / Feature Button -->
          <div class="feature-btn-circle">
            <i class="fa-solid fa-plus"></i>
            <span class="feature-btn-sub">Submit</span>
          </div>

          <!-- Bottom Card Content Overlay -->
          <div class="card-content-overlay">
            <span class="category-header-pill"><i class={`fa-solid ${clip.icon}`}></i> {clip.category}</span>
            <span class="creator-handle">Your Video Here</span>
            <span class="clip-subtext">Click to submit or tag @KinsBandOfficial</span>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Bottom Submission Banner -->
  <div class="submission-banner">
    <div class="banner-text-content">
      <h4 class="banner-title"><i class="fa-solid fa-sparkles banner-sparkle-icon"></i> SUBMISSIONS OPEN</h4>
      <p class="banner-desc">
        Tag <button type="button" class="copy-handle-pill" id="copyHandlePill" title="Copy @KinsBandOfficial handle">
          <span>@KinsBandOfficial</span>
          <i class="fa-regular fa-copy"></i>
        </button> or submit your link to get featured in these spots.
      </p>
    </div>
    <button type="button" class="submit-fan-clip-btn" id="openCommunityModalBtn">
      <span>Submit Fan Clip</span>
      <i class="fa-solid fa-plus"></i>
    </button>
  </div>
</section>

<style>
  .spotlight-section {
    display: none !important;
    width: 100%;
    margin-top: 14px;
    margin-bottom: 10px;
    flex-direction: column;
    gap: 14px;
    content-visibility: auto;
    contain-intrinsic-size: 0 450px;
  }

  /* Section Header */
  .spotlight-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2px;
    user-select: none;
    overflow: visible;
  }

  .header-title-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
    overflow: visible;
  }

  .spotlight-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .spotlight-title i {
    color: var(--accent-neon-yellow);
    font-size: 0.9rem;
    width: 1.25em;
    height: 1.25em;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .section-scroll-controls {
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-2px);
    transition: opacity 0.22s ease, transform 0.22s ease;
  }

  .section-scroll-controls.is-scrolling {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  @media (min-width: 768px) {
    .section-scroll-controls {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
  }

  .scroll-arrow-btn {
    background: var(--surface-card-light);
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    width: 32px;
    height: 32px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 800;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease, opacity 0.16s ease;
  }

  .scroll-arrow-btn:hover:not(:disabled):not(.is-disabled) {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .scroll-arrow-btn:active:not(:disabled):not(.is-disabled) {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .scroll-arrow-btn:disabled,
  .scroll-arrow-btn.is-disabled {
    opacity: 0.35;
    pointer-events: none;
    cursor: not-allowed;
    box-shadow: none;
  }

  /* Snap-Scroll Container */
  .spotlight-scroll-container {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 4px 14px 4px;
    -webkit-overflow-scrolling: touch;
  }

  /* Individual 9:16 Neo-Brutalist Card */
  .spotlight-card {
    flex: 0 0 210px;
    height: 373px;
    scroll-snap-align: start;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px var(--accent-neon-yellow), 3px 3px 0px 1px #000000;
    cursor: pointer;
    transition: transform 0.18s var(--ease-tactile), box-shadow 0.18s ease;
    box-sizing: border-box;
  }

  .spotlight-card:hover,
  .spotlight-card.is-scroll-active {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px var(--accent-neon-yellow), 5px 5px 0px 1px #000000;
  }

  .card-media-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 12px;
    overflow: hidden;
  }

  .card-media-wrapper::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0.1) 40%, rgba(0, 0, 0, 0.85) 100%);
    z-index: 1;
    transition: opacity 0.25s ease;
  }

  .mock-bg-art {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 0;
    overflow: hidden;
  }

  .mock-icon-bg {
    font-size: 8rem;
    color: rgba(255, 255, 255, 0.08);
    transition: transform 0.35s var(--ease-snappy);
  }

  .spotlight-card:hover .mock-icon-bg {
    transform: scale(1.08) rotate(6deg);
  }

  .spotlight-card.empty-feature-card {
    border: 3px dashed #000000;
  }

  .spotlight-card.empty-feature-card:hover {
    border: 3px solid #000000;
  }

  .availability-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 3;
    background: var(--accent-neon-yellow);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: #000000;
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 900;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .badge-sparkle {
    font-size: 0.62rem;
    color: #000000;
  }

  .feature-btn-circle {
    position: absolute;
    top: 42%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--surface-card-light);
    border: 2.5px solid #000000;
    color: var(--text-card-primary);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    z-index: 2;
    box-shadow: 3px 3px 0px #000000;
    transition: transform 0.2s var(--ease-snappy), background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }

  .feature-btn-sub {
    font-family: var(--font-secondary);
    font-size: 0.56rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-top: 2px;
  }

  .spotlight-card:hover .feature-btn-circle {
    transform: translate(-50%, -50%) scale(1.1);
    background: var(--accent-neon-yellow);
    color: #000000;
    box-shadow: 4px 4px 0px #000000;
  }

  .category-header-pill {
    font-family: var(--font-secondary);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-neon-yellow);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 2px;
  }

  .card-content-overlay {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-top: auto;
  }

  .creator-handle {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    color: #ffffff;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
    letter-spacing: -0.01em;
  }

  .clip-subtext {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    color: #a1a1aa;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Neo-Brutalist Submission Banner */
  .submission-banner {
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 8px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform 0.18s var(--ease-tactile), box-shadow 0.18s ease;
    box-sizing: border-box;
  }

  .submission-banner:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px #000000;
  }

  .banner-text-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .banner-title {
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-card-primary);
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
  }

  .banner-sparkle-icon {
    color: var(--accent-neon-yellow);
    font-size: 0.82rem;
  }

  .banner-desc {
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-card-secondary);
    line-height: 1.5;
    margin: 0;
    display: block;
  }

  .copy-handle-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--accent-neon-yellow);
    border: 2px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    color: #000000;
    padding: 2px 8px;
    border-radius: 4px;
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 800;
    cursor: pointer;
    vertical-align: middle;
    margin: 0 3px;
    transition: transform 0.16s var(--ease-tactile);
  }

  .copy-handle-pill:hover {
    transform: translate(-1px, -1px);
  }

  .submit-fan-clip-btn {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    font-family: var(--font-secondary);
    font-size: 0.84rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 10px 20px;
    border-radius: 6px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
  }

  .submit-fan-clip-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .submit-fan-clip-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  @media (min-width: 768px) {
    .submission-banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 18px 24px;
    }

    .banner-text-content {
      flex: 1;
      min-width: 0;
    }

    .submit-fan-clip-btn {
      width: auto;
      max-width: 320px;
      padding: 12px 24px;
      font-size: 0.82rem;
      flex-shrink: 0;
      white-space: nowrap;
    }

    .spotlight-card {
      flex: 0 0 240px;
      height: 340px;
    }
  }

  @media (min-width: 1200px) {
    .spotlight-card {
      flex: 0 0 260px;
      height: 350px;
    }
  }
</style>

<script>
  import { copyToClipboard, animateCopySuccess } from '../../scripts/controllers/clipboard.js';
  import { showToast } from '../../scripts/controllers/toast.js';

  const spotlightContainer = document.getElementById('spotlightScrollContainer');
  const spotlightPrevBtn = document.getElementById('spotlightScrollPrev') as HTMLButtonElement | null;
  const spotlightNextBtn = document.getElementById('spotlightScrollNext') as HTMLButtonElement | null;
  const spotlightCards = spotlightContainer?.querySelectorAll('.spotlight-card') || [];

  let spotlightRafId: number | null = null;
  let spotlightScrollSettleTimeout: ReturnType<typeof setTimeout> | null = null;

  function updateSpotlightNav() {
    if (!spotlightContainer) return;
    if (spotlightRafId) cancelAnimationFrame(spotlightRafId);
    spotlightRafId = requestAnimationFrame(() => {
      const isOverflowing = spotlightContainer.scrollWidth > spotlightContainer.clientWidth + 4;
      const controlsGroup = spotlightPrevBtn?.parentElement;
      if (controlsGroup) {
        controlsGroup.style.display = isOverflowing ? 'flex' : 'none';
      }
      const maxScroll = spotlightContainer.scrollWidth - spotlightContainer.clientWidth;
      const atStart = spotlightContainer.scrollLeft <= 5;
      const atEnd = spotlightContainer.scrollLeft >= maxScroll - 5;
      if (spotlightPrevBtn) {
        spotlightPrevBtn.disabled = atStart;
        spotlightPrevBtn.classList.toggle('is-disabled', atStart);
        spotlightPrevBtn.setAttribute('aria-disabled', String(atStart));
      }
      if (spotlightNextBtn) {
        spotlightNextBtn.disabled = atEnd;
        spotlightNextBtn.classList.toggle('is-disabled', atEnd);
        spotlightNextBtn.setAttribute('aria-disabled', String(atEnd));
      }
    });
  }

  function updateActiveSpotlightHighlight() {
    if (!spotlightContainer || !spotlightCards.length) return;
    const containerCenter = spotlightContainer.getBoundingClientRect().left + spotlightContainer.clientWidth / 2;
    let closestCard: Element | null = null;
    let closestDist = Infinity;

    spotlightCards.forEach((card) => {
      const rect = card.getBoundingClientRect();
      const cardCenter = rect.left + rect.width / 2;
      const dist = Math.abs(containerCenter - cardCenter);
      if (dist < closestDist) {
        closestDist = dist;
        closestCard = card;
      }
    });

    spotlightCards.forEach((card) => {
      if (card === closestCard) {
        card.classList.add('is-scroll-active');
      } else {
        card.classList.remove('is-scroll-active');
      }
    });

    if (spotlightScrollSettleTimeout) clearTimeout(spotlightScrollSettleTimeout);
    spotlightScrollSettleTimeout = setTimeout(() => {
      spotlightCards.forEach((card) => card.classList.remove('is-scroll-active'));
      const controlsGroup = spotlightPrevBtn?.parentElement;
      if (controlsGroup) {
        controlsGroup.classList.remove('is-scrolling');
      }
    }, 800);
  }

  if (spotlightContainer) {
    updateSpotlightNav();
    window.addEventListener('resize', updateSpotlightNav, { passive: true });

    spotlightContainer.addEventListener('scroll', () => {
      const controlsGroup = spotlightPrevBtn?.parentElement;
      if (controlsGroup) {
        controlsGroup.classList.add('is-scrolling');
      }
      updateSpotlightNav();
      updateActiveSpotlightHighlight();
    }, { passive: true });

    spotlightContainer.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
        spotlightContainer.scrollLeft += e.deltaX;
      }
    }, { passive: true });

    spotlightPrevBtn?.addEventListener('click', () => {
      const controlsGroup = spotlightPrevBtn?.parentElement;
      if (controlsGroup) controlsGroup.classList.add('is-scrolling');
      spotlightContainer.scrollBy({ left: -260, behavior: 'smooth' });
    });

    spotlightNextBtn?.addEventListener('click', () => {
      const controlsGroup = spotlightNextBtn?.parentElement;
      if (controlsGroup) controlsGroup.classList.add('is-scrolling');
      spotlightContainer.scrollBy({ left: 260, behavior: 'smooth' });
    });
  }

  const copyPill = document.getElementById('copyHandlePill');
  copyPill?.addEventListener('click', async (e) => {
    e.stopPropagation();
    const ok = await copyToClipboard('@KinsBandOfficial');
    if (ok) {
      animateCopySuccess(copyPill);
      showToast("Copied @KinsBandOfficial handle!");
    }
  });

  const openModalBtn = document.getElementById('openCommunityModalBtn');
  openModalBtn?.addEventListener('click', () => {
    const modal = document.getElementById('communitySubmissionModal');
    modal?.classList.remove('hidden');
  });

  // Empty Feature Cards Click Handlers
  const emptyFeatureCards = document.querySelectorAll('.spotlight-card.empty-feature-card');
  emptyFeatureCards.forEach(card => {
    card.addEventListener('click', () => {
      const category = card.getAttribute('data-category');
      const modal = document.getElementById('communitySubmissionModal');
      if (modal) {
        modal.classList.remove('hidden');
        if (category) {
          const categoryInput = document.getElementById('selectedCategoryInput') as HTMLInputElement;
          if (categoryInput) categoryInput.value = category;
          
          const displayLabel = document.getElementById('communityCategoryDisplayLabel');
          if (displayLabel) displayLabel.textContent = category;

          const categoryBtns = document.querySelectorAll('#categoryTagsGrid .category-tag-btn');
          categoryBtns.forEach(btn => {
            if (btn.getAttribute('data-category') === category) {
              btn.classList.add('active');
            } else {
              btn.classList.remove('active');
            }
          });
        }
      }
    });
  });
</script>
