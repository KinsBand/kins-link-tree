---
---

<section class="subscribe-section" id="subscribeFormSection">
  <div class="subscribe-card">
    <!-- Form State -->
    <div id="subscribeFormContainer" class="subscribe-form-container">
      <div class="subscribe-header">
        <div class="subscribe-title-row">
          <h3>Subscribe to Kins!</h3>
          <span class="est-time-pill"><i class="fa-regular fa-clock"></i> ~5 sec</span>
        </div>
        <p class="subscribe-subtext">Receive new music, behind-the-scenes moments & gig drops via Substack.</p>
      </div>

      <form id="subscribeForm" class="subscribe-form" action="/api/subscribe" method="POST">
        <div class="form-group">
          <div class="inline-input-row">
            <input type="email" name="email" id="emailInput" placeholder="Enter your email..." required autocomplete="email">
            <!-- Inline Quick Email Domain Shortcuts Row -->
            <div class="email-domain-shortcuts-row" id="emailDomainShortcutsRow">
              <button type="button" class="domain-shortcut-btn" data-domain="@gmail.com">@gmail.com</button>
              <button type="button" class="domain-shortcut-btn" data-domain="@outlook.com">@outlook.com</button>
              <button type="button" class="domain-shortcut-btn" data-domain="@yahoo.com">@yahoo.com</button>
              <button type="button" class="domain-shortcut-btn" data-domain="@icloud.com">@icloud.com</button>
              <button type="button" class="domain-shortcut-btn" data-domain="@hotmail.com">@hotmail.com</button>
              <button type="button" class="domain-shortcut-btn" data-domain="@proton.me">@proton.me</button>
              <button type="button" class="domain-shortcut-btn" data-domain="@live.com">@live.com</button>
            </div>
          </div>

          <button type="submit" class="green-submit-btn">
            <i class="fa-solid fa-envelope"></i>
            <span>Subscribe</span>
          </button>

          <!-- Subscription Consent Micro-Text -->
          <p class="subscribe-consent-text">
            Powered by Substack. By subscribing, you agree to our 
            <button type="button" id="openPrivacyFormBtn" class="privacy-consent-link">Privacy Policy</button>. 
            <a href="https://kinsbandoffical.substack.com" target="_blank" rel="noopener noreferrer" class="substack-link-text">Subscribe on Substack directly</a> if preferred.
          </p>
        </div>
      </form>
    </div>

    <!-- Subscribed State -->
    <div id="subscribeSuccessContainer" class="subscribe-success-container hidden">
      <div class="subscribed-success-badge">
        <i class="fa-solid fa-circle-check"></i>
        <h3>You're Subscribed!</h3>
      </div>
      <p class="subscribed-subtext">You'll receive exclusive drops & gig alerts straight to your inbox.</p>
      <button type="button" id="unsubscribeBtn" class="unsubscribe-link-btn">
        <i class="fa-solid fa-user-minus"></i> Unsubscribe
      </button>
    </div>

    <!-- Always-Visible Official Contacts Block (Both Emails + Suggestions) -->
    <div class="official-contacts-block">
      <div class="contacts-block-header">
        <i class="fa-solid fa-paper-plane"></i>
        <span>Official Contacts & Feedback</span>
      </div>

      <div class="emails-list">
        <div class="email-row-item copy-email-card" data-email="HelloKinsBand@gmail.com" role="button" tabindex="0" title="Click to copy HelloKinsBand@gmail.com">
          <div class="email-icon"><i class="fa-regular fa-paper-plane"></i></div>
          <div class="email-details">
            <span class="email-address">HelloKinsBand@gmail.com</span>
            <span class="email-desc">General Chat, Help & Site Suggestions</span>
          </div>
          <div class="email-actions-group">
            <button type="button" class="copy-email-btn" data-email="HelloKinsBand@gmail.com" title="Copy Email" aria-label="Copy email HelloKinsBand@gmail.com">
              <i class="fa-regular fa-copy" aria-hidden="true"></i>
              <span class="sr-only">Copy email</span>
            </button>
            <a href="mailto:HelloKinsBand@gmail.com?subject=Kins%20Inquiry%20%26%20Feedback" class="send-email-btn" title="Open Mail App" aria-label="Send email to HelloKinsBand@gmail.com" target="_blank" rel="noopener noreferrer">
              <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
              <span class="sr-only">Go to mail app</span>
            </a>
          </div>
        </div>

        <div class="email-row-item copy-email-card" data-email="BookingsKinsBand@gmail.com" role="button" tabindex="0" title="Click to copy BookingsKinsBand@gmail.com">
          <div class="email-icon"><i class="fa-regular fa-calendar-check"></i></div>
          <div class="email-details">
            <span class="email-address">BookingsKinsBand@gmail.com</span>
            <span class="email-desc">Shows, Tours & Live Booking</span>
          </div>
          <div class="email-actions-group">
            <button type="button" class="copy-email-btn" data-email="BookingsKinsBand@gmail.com" title="Copy Email" aria-label="Copy Bookings Email">
              <i class="fa-regular fa-copy" aria-hidden="true"></i>
              <span class="sr-only">Copy email</span>
            </button>
            <a href="mailto:BookingsKinsBand@gmail.com?subject=Kins%20Booking%20Inquiry" class="send-email-btn" title="Open Mail App" aria-label="Send email to BookingsKinsBand@gmail.com" target="_blank" rel="noopener noreferrer">
              <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
              <span class="sr-only">Go to mail app</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .subscribe-section {
    width: 100%;
    margin-top: 14px;
  }

  .subscribe-card {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    backdrop-filter: blur(12px);
  }

  .subscribe-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .subscribe-header h3 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-white);
    margin: 0;
    letter-spacing: 0.02em;
  }

  .subscribe-subtext {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0;
  }

  .subscribe-form-container, .subscribe-success-container {
    transition: opacity 0.25s ease;
  }

  .subscribe-form-container.hidden, .subscribe-success-container.hidden {
    display: none !important;
  }

  .subscribe-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 6px;
  }

  .inline-input-row {
    display: flex;
    align-items: center;
    gap: 8px;
    position: relative;
    background: rgba(10, 10, 12, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 6px;
    padding: 3px 6px 3px 12px;
    transition: border-color 0.2s ease;
  }

  .inline-input-row:focus-within {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .inline-input-row input {
    flex: 1;
    min-width: 110px;
    background: transparent;
    border: none;
    padding: 10px 4px 10px 0;
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.88rem;
    outline: none;
  }

  .email-domain-shortcuts-row {
    display: flex;
    align-items: center;
    gap: 4px;
    overflow-x: auto;
    max-width: 55%;
    padding: 2px 0;
    margin-top: 0;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    flex-shrink: 0;
  }

  .email-domain-shortcuts-row::-webkit-scrollbar {
    display: none;
  }

  .domain-shortcut-btn {
    flex: 0 0 auto;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 600;
    padding: 3px 7px;
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.18s ease;
  }

  .domain-shortcut-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.32);
    color: var(--text-white);
    transform: translateY(-1px);
  }

  .subscribe-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .est-time-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 12px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .substack-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(255, 103, 25, 0.15);
    color: #FF6719;
    border: 1px solid rgba(255, 103, 25, 0.35);
    padding: 3px 8px;
    border-radius: 12px;
    font-size: 0.68rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .substack-badge-pill:hover {
    background: rgba(255, 103, 25, 0.28);
    border-color: #FF6719;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .subscribe-consent-text {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    color: var(--text-muted);
    margin-top: 6px;
    margin-bottom: 0;
  }

  .substack-link-text {
    color: #FF6719;
    text-decoration: underline;
    font-weight: 600;
  }

  .substack-link-text:hover {
    color: #ff8547;
  }

  .privacy-consent-link {
    background: transparent;
    border: none;
    color: var(--btn-green);
    font-family: inherit;
    font-size: inherit;
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }

  .privacy-consent-link:hover {
    color: var(--btn-green-hover);
  }

  .green-submit-btn {
    width: 100%;
    margin-top: 6px;
    background: var(--btn-green);
    color: var(--btn-text-color);
    border: none;
    border-radius: 6px;
    padding: 10px 16px;
    font-family: var(--font-secondary);
    font-weight: 800;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: transform 0.18s var(--ease-snappy), background-color 0.18s ease;
    min-height: 40px;
  }

  .green-submit-btn:hover {
    background: var(--btn-green-hover);
    transform: translateY(-1px);
  }

  .subscribed-success-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--btn-green);
  }

  .subscribed-success-badge h3 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-white);
    margin: 0;
    letter-spacing: 0.02em;
  }

  .subscribed-success-badge i {
    font-size: 1.2rem;
  }

  .subscribed-subtext {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: var(--text-muted);
    margin: 6px 0 10px 0;
  }

  .unsubscribe-link-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 4px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .unsubscribe-link-btn:hover {
    color: var(--accent-crimson, #ff4d4d);
    background: rgba(255, 77, 77, 0.12);
    border-color: rgba(255, 77, 77, 0.25);
  }

  .official-contacts-block {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .contacts-block-header {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--btn-green);
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .emails-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .email-row-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(10, 10, 12, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 10px 12px;
    cursor: pointer;
    transition: transform 0.18s var(--ease-snappy, cubic-bezier(0.16, 1.25, 0.3, 1)), border-color 0.18s ease, background-color 0.18s ease;
  }

  .email-row-item:hover {
    background: rgba(20, 20, 26, 0.85);
    border-color: rgba(255, 255, 255, 0.28);
    transform: translateY(-1px);
  }

  .email-icon {
    font-size: 1rem;
    color: var(--text-muted);
    width: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .email-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .email-address {
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-white);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .email-desc {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .email-actions-group {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .copy-email-btn, .send-email-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--text-white);
    padding: 5px 10px;
    height: 32px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    text-decoration: none;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: all 0.18s ease;
    white-space: nowrap;
  }

  .copy-email-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
    color: #ffffff;
  }

  .send-email-btn {
    background: var(--btn-green);
    color: var(--btn-text-color);
    border-color: transparent;
    font-weight: 800;
  }

  .send-email-btn:hover {
    background: var(--btn-green-hover);
    color: #000000;
  }
</style>

<script>
  import { copyToClipboard, animateCopySuccess } from '../../scripts/controllers/clipboard.js';
  import { showToast } from '../../scripts/controllers/toast.js';

  import { getSubscriptionState, setSubscriptionState } from '../../scripts/controllers/subscribeController.js';

  const formContainer = document.getElementById('subscribeFormContainer');
  const successContainer = document.getElementById('subscribeSuccessContainer');
  const subscribeForm = document.getElementById('subscribeForm') as HTMLFormElement;
  const unsubscribeBtn = document.getElementById('unsubscribeBtn');

  function setSubscribedState(isSubbed: boolean) {
    if (isSubbed) {
      formContainer?.classList.add('hidden');
      successContainer?.classList.remove('hidden');
    } else {
      formContainer?.classList.remove('hidden');
      successContainer?.classList.add('hidden');
    }
  }

  const initialSubbed = getSubscriptionState();
  setSubscribedState(initialSubbed);

  // Listen to global subscription events
  window.addEventListener('kins:subscription-change', (e: any) => {
    const isSubbed = e.detail?.isSubscribed;
    if (typeof isSubbed === 'boolean') {
      setSubscribedState(isSubbed);
    }
  });

  if (subscribeForm) {
    subscribeForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('emailInput') as HTMLInputElement;
      const submitBtn = subscribeForm.querySelector('button[type="submit"]') as HTMLButtonElement;

      if (!emailInput || !emailInput.value) return;

      const email = emailInput.value.trim();

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<i class="fa-solid fa-compact-disc fa-spin"></i> <span>Subscribing...</span>`;
      }

      const baseUrl = import.meta.env.BASE_URL ? import.meta.env.BASE_URL.replace(/\/$/, '') : '';
      const endpoint = `${baseUrl}/api/subscribe`;

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json().catch(() => ({}));

        setSubscriptionState(true);
        showToast(data.message || "Subscribed on Substack! Check your inbox to confirm.");

        if (data.redirectUrl) {
          setTimeout(() => {
            window.open(data.redirectUrl, '_blank');
          }, 1200);
        }
      } catch (err) {
        setSubscriptionState(true);
        showToast("Subscribed on Substack! Check your inbox to confirm.");
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = `<i class="fa-solid fa-envelope"></i> <span>Subscribe</span>`;
        }
      }
    });
  }

  if (unsubscribeBtn) {
    unsubscribeBtn.addEventListener('click', () => {
      setSubscriptionState(false);
      showToast("Notifications turned OFF.");
    });
  }

  document.querySelectorAll('.domain-shortcut-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const emailInput = document.getElementById('emailInput') as HTMLInputElement;
      if (!emailInput) return;

      const domain = btn.getAttribute('data-domain') || '';
      const currentVal = emailInput.value.trim();

      if (!currentVal) {
        emailInput.value = domain;
        emailInput.focus();
        emailInput.setSelectionRange(0, 0);
      } else {
        const handle = currentVal.includes('@') ? currentVal.split('@')[0] : currentVal;
        if (handle && handle.length > 0) {
          emailInput.value = handle + domain;
          emailInput.focus();
          emailInput.setSelectionRange(emailInput.value.length, emailInput.value.length);
        } else {
          emailInput.value = domain;
          emailInput.focus();
          emailInput.setSelectionRange(0, 0);
        }
      }
    });
  });

  const emailDomainShortcutsRow = document.getElementById('emailDomainShortcutsRow');
  if (emailDomainShortcutsRow) {
    emailDomainShortcutsRow.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
        emailDomainShortcutsRow.scrollLeft += e.deltaX;
      }
    }, { passive: true });
  }

  const privacyModal = document.getElementById('privacyModal');
  const openPrivacyFormBtn = document.getElementById('openPrivacyFormBtn');

  openPrivacyFormBtn?.addEventListener('click', () => {
    privacyModal?.classList.remove('hidden');
    document.body.classList.add('modal-open');
  });

  async function copyEmailHandler(email: string, targetEl: HTMLElement) {
    const ok = await copyToClipboard(email);
    if (ok) {
      const copyBtn = targetEl.querySelector('.copy-email-btn') || targetEl;
      animateCopySuccess(copyBtn);
      showToast(`Copied ${email} to clipboard!`);
    }
  }

  document.querySelectorAll('.copy-email-card').forEach(card => {
    card.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.send-email-btn')) return;

      const email = card.getAttribute('data-email');
      if (email) {
        await copyEmailHandler(email, card as HTMLElement);
      }
    });

    card.addEventListener('keydown', async (e: any) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const email = card.getAttribute('data-email');
        if (email) {
          await copyEmailHandler(email, card as HTMLElement);
        }
      }
    });
  });

  document.querySelectorAll('.send-email-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
    });
  });
</script>
