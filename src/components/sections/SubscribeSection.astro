---
---

<section class="subscribe-section" id="subscribeFormSection">
  <div class="subscribe-card">
    <div class="subscribe-header">
      <h3>Subscribe to Kins!</h3>
      <p class="subscribe-subtext">Receive new music, behind-the-scenes moments & gig drops.</p>
    </div>

    <!-- Form State -->
    <div id="subscribeFormContainer" class="subscribe-form-container">
      <form id="subscribeForm" class="subscribe-form" action="/api/subscribe" method="POST">
        <div class="form-group">
          <div class="inline-input-row">
            <input type="email" name="email" id="emailInput" placeholder="Enter your email..." required autocomplete="email">
            <button type="submit" class="green-submit-btn">
              <i class="fa-solid fa-envelope"></i>
              <span>Subscribe</span>
            </button>
          </div>
          <!-- Quick Email Domain Shortcuts Row -->
          <div class="email-domain-shortcuts-row" id="emailDomainShortcutsRow">
            <button type="button" class="domain-shortcut-btn" data-domain="@gmail.com">@gmail.com</button>
            <button type="button" class="domain-shortcut-btn" data-domain="@outlook.com">@outlook.com</button>
            <button type="button" class="domain-shortcut-btn" data-domain="@yahoo.com">@yahoo.com</button>
            <button type="button" class="domain-shortcut-btn" data-domain="@icloud.com">@icloud.com</button>
            <button type="button" class="domain-shortcut-btn" data-domain="@hotmail.com">@hotmail.com</button>
            <button type="button" class="domain-shortcut-btn" data-domain="@proton.me">@proton.me</button>
            <button type="button" class="domain-shortcut-btn" data-domain="@live.com">@live.com</button>
          </div>
        </div>
      </form>
    </div>

    <!-- Subscribed State -->
    <div id="subscribeSuccessContainer" class="subscribe-success-container hidden">
      <div class="subscribed-success-badge">
        <i class="fa-solid fa-circle-check"></i>
        <span>You're Subscribed!</span>
      </div>
      <p class="subscribed-subtext">You'll receive exclusive drops & gig alerts straight to your inbox.</p>
      <button type="button" id="unsubscribeBtn" class="unsubscribe-link-btn">
        <i class="fa-solid fa-user-minus"></i> Unsubscribe
      </button>
    </div>

    <!-- Always-Visible Official Contacts Block (Both Emails + Suggestions) -->
    <div class="official-contacts-block">
      <div class="contacts-block-header">
        <i class="fa-solid fa-paper-plane"></i>
        <span>Official Contacts & Feedback</span>
      </div>

      <div class="emails-list">
        <div class="email-row-item">
          <div class="email-icon"><i class="fa-regular fa-paper-plane"></i></div>
          <div class="email-details">
            <span class="email-address">HelloKinsBand@gmail.com</span>
            <span class="email-desc">General Chat, Help & Site Suggestions</span>
          </div>
          <div class="email-actions-group">
            <button class="copy-email-btn" data-email="HelloKinsBand@gmail.com" title="Copy Email" aria-label="Copy email HelloKinsBand@gmail.com">
              <i class="fa-regular fa-copy" aria-hidden="true"></i>
              <span class="sr-only">Copy email</span>
            </button>
            <a href="mailto:HelloKinsBand@gmail.com?subject=Kins%20Inquiry%20%26%20Feedback" class="send-email-btn" title="Open Mail App" aria-label="Send email to HelloKinsBand@gmail.com" target="_blank" rel="noopener noreferrer">
              <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
              <span class="sr-only">Go to mail app</span>
            </a>
          </div>
        </div>

        <div class="email-row-item">
          <div class="email-icon"><i class="fa-regular fa-calendar-check"></i></div>
          <div class="email-details">
            <span class="email-address">BookingsKinsBand@gmail.com</span>
            <span class="email-desc">Shows, Tours & Live Booking</span>
          </div>
          <div class="email-actions-group">
            <button class="copy-email-btn" data-email="BookingsKinsBand@gmail.com" title="Copy Email" aria-label="Copy Bookings Email">
              <i class="fa-regular fa-copy" aria-hidden="true"></i>
              <span class="sr-only">Copy email</span>
            </button>
            <a href="mailto:BookingsKinsBand@gmail.com?subject=Kins%20Booking%20Inquiry" class="send-email-btn" title="Open Mail App" aria-label="Send email to BookingsKinsBand@gmail.com" target="_blank" rel="noopener noreferrer">
              <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
              <span class="sr-only">Go to mail app</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .subscribe-section {
    width: 100%;
    margin-top: 14px;
  }

  .subscribe-card {
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    backdrop-filter: blur(12px);
  }

  .subscribe-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .subscribe-header h3 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-white);
    margin: 0;
    letter-spacing: 0.02em;
  }

  .subscribe-subtext {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0;
  }

  .subscribe-form-container, .subscribe-success-container {
    transition: opacity 0.25s ease;
  }

  .subscribe-form-container.hidden, .subscribe-success-container.hidden {
    display: none !important;
  }

  .subscribe-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 6px;
  }

  .inline-input-row {
    display: flex;
    align-items: center;
    position: relative;
    background: rgba(10, 10, 12, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 6px;
    padding: 3px 4px 3px 12px;
    transition: border-color 0.2s ease;
  }

  .inline-input-row:focus-within {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .inline-input-row input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    padding: 10px 8px 10px 0;
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.88rem;
    outline: none;
  }

  .email-domain-shortcuts-row {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    padding: 6px 2px 8px 2px;
    margin-top: 4px;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.25) transparent;
    -webkit-overflow-scrolling: touch;
  }

  .email-domain-shortcuts-row::-webkit-scrollbar {
    height: 4px;
  }

  .email-domain-shortcuts-row::-webkit-scrollbar-track {
    background: transparent;
  }

  .email-domain-shortcuts-row::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.25);
    border-radius: 4px;
  }

  .domain-shortcut-btn {
    flex: 0 0 auto;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 4px 9px;
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.18s ease;
  }

  .domain-shortcut-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.28);
    color: var(--text-white);
    transform: translateY(-1px);
  }

  .green-submit-btn {
    flex: 0 0 auto;
    background: var(--btn-green);
    color: var(--btn-text-color);
    border: none;
    border-radius: 4px;
    padding: 8px 14px;
    font-family: var(--font-secondary);
    font-weight: 800;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: transform 0.18s var(--ease-snappy), background-color 0.18s ease;
    min-height: 38px;
  }

  .green-submit-btn:hover {
    background: var(--btn-green-hover);
    transform: translateY(-1px);
  }

  .subscribed-success-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--btn-green);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
  }

  .subscribed-subtext {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: var(--text-muted);
    margin: 6px 0 10px 0;
  }

  .unsubscribe-link-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 4px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .unsubscribe-link-btn:hover {
    color: var(--accent-crimson, #ff4d4d);
    background: rgba(255, 77, 77, 0.12);
    border-color: rgba(255, 77, 77, 0.25);
  }

  .official-contacts-block {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .contacts-block-header {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--btn-green);
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .emails-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .email-row-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(10, 10, 12, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 10px 12px;
  }

  .email-icon {
    font-size: 1rem;
    color: var(--text-muted);
    width: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .email-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .email-address {
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-white);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .email-desc {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    color: var(--text-muted);
  }

  .email-actions-group {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .copy-email-btn, .send-email-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--text-white);
    padding: 5px 10px;
    height: 32px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    text-decoration: none;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: all 0.18s ease;
    white-space: nowrap;
  }

  .copy-email-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.35);
    color: #ffffff;
  }

  .send-email-btn {
    background: var(--btn-green);
    color: var(--btn-text-color);
    border-color: transparent;
    font-weight: 800;
  }

  .send-email-btn:hover {
    background: var(--btn-green-hover);
    color: #000000;
  }
</style>

<script>
  import { copyToClipboard } from '../../scripts/controllers/clipboard.js';
  import { showToast } from '../../scripts/controllers/toast.js';

  const formContainer = document.getElementById('subscribeFormContainer');
  const successContainer = document.getElementById('subscribeSuccessContainer');
  const subscribeForm = document.getElementById('subscribeForm') as HTMLFormElement;
  const unsubscribeBtn = document.getElementById('unsubscribeBtn');

  function setSubscribedState(isSubbed: boolean) {
    if (isSubbed) {
      formContainer?.classList.add('hidden');
      successContainer?.classList.remove('hidden');
    } else {
      formContainer?.classList.remove('hidden');
      successContainer?.classList.add('hidden');
    }
  }

  const initialSubbed = localStorage.getItem('kins_subscribed') === 'true';
  setSubscribedState(initialSubbed);

  if (subscribeForm) {
    subscribeForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('emailInput') as HTMLInputElement;
      const submitBtn = subscribeForm.querySelector('button[type="submit"]') as HTMLButtonElement;

      if (!emailInput || !emailInput.value) return;

      const email = emailInput.value.trim();

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<i class="fa-solid fa-compact-disc fa-spin"></i> <span>Subscribing...</span>`;
      }

      const baseUrl = import.meta.env.BASE_URL ? import.meta.env.BASE_URL.replace(/\/$/, '') : '';
      const endpoint = `${baseUrl}/api/subscribe`;

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        const data = await res.json().catch(() => ({}));

        localStorage.setItem('kins_subscribed', 'true');
        setSubscribedState(true);
        showToast(data.message || "Welcome to Kins! You are now subscribed.");
      } catch (err) {
        localStorage.setItem('kins_subscribed', 'true');
        setSubscribedState(true);
        showToast("Welcome to Kins! You are now subscribed.");
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = `<i class="fa-solid fa-envelope"></i> <span>Subscribe</span>`;
        }
      }
    });
  }

  if (unsubscribeBtn) {
    unsubscribeBtn.addEventListener('click', () => {
      localStorage.removeItem('kins_subscribed');
      setSubscribedState(false);
      showToast("You have unsubscribed from Kins updates.");
    });
  }

  document.querySelectorAll('.domain-shortcut-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const emailInput = document.getElementById('emailInput') as HTMLInputElement;
      if (!emailInput) return;

      const domain = btn.getAttribute('data-domain') || '';
      const currentVal = emailInput.value.trim();

      if (!currentVal) {
        emailInput.value = domain;
        emailInput.focus();
        emailInput.setSelectionRange(0, 0);
      } else {
        const handle = currentVal.includes('@') ? currentVal.split('@')[0] : currentVal;
        if (handle && handle.length > 0) {
          emailInput.value = handle + domain;
          emailInput.focus();
          emailInput.setSelectionRange(emailInput.value.length, emailInput.value.length);
        } else {
          emailInput.value = domain;
          emailInput.focus();
          emailInput.setSelectionRange(0, 0);
        }
      }
    });
  });

  const emailDomainShortcutsRow = document.getElementById('emailDomainShortcutsRow');
  if (emailDomainShortcutsRow) {
    emailDomainShortcutsRow.addEventListener('wheel', (e) => {
      if (e.deltaY !== 0) {
        e.preventDefault();
        emailDomainShortcutsRow.scrollLeft += e.deltaY;
      }
    }, { passive: false });
  }

  document.querySelectorAll('.copy-email-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email');
      if (email) {
        await copyToClipboard(email);
        showToast(`Copied ${email} to clipboard!`);
      }
    });
  });
</script>
