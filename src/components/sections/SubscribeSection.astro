---
---

<section class="subscribe-section" id="subscribeFormSection">
  <div class="subscribe-card">
    <!-- Form State -->
    <div id="subscribeFormContainer" class="subscribe-form-container">
      <div class="subscribe-header">
        <div class="subscribe-title-row">
          <h3>Subscribe to Kins!</h3>
          <span class="est-time-pill"><i class="fa-regular fa-clock"></i> ~5 sec</span>
        </div>
        <p class="subscribe-subtext">Receive new music, behind-the-scenes moments & gig drops straight to your inbox.</p>
      </div>

      <form id="subscribeForm" class="subscribe-form" action="/api/subscribe" method="POST">
        <div class="form-group">
          <div class="inline-input-row">
            <input type="text" name="email" id="emailInput" placeholder="Enter your email..." required autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false">
            <!-- Inline Quick Email Domain Shortcuts Row -->
            <div class="email-domain-shortcuts-row" id="emailDomainShortcutsRow">
              <button type="button" class="domain-shortcut-btn" data-domain="@gmail.com">@gmail.com</button>
              <button type="button" class="domain-shortcut-btn" data-domain="@outlook.com">@outlook.com</button>
              <button type="button" class="domain-shortcut-btn" data-domain="@yahoo.com">@yahoo.com</button>
              <button type="button" class="domain-shortcut-btn" data-domain="@icloud.com">@icloud.com</button>
              <button type="button" class="domain-shortcut-btn" data-domain="@hotmail.com">@hotmail.com</button>
              <button type="button" class="domain-shortcut-btn" data-domain="@proton.me">@proton.me</button>
              <button type="button" class="domain-shortcut-btn" data-domain="@live.com">@live.com</button>
            </div>
          </div>

          <button type="submit" class="green-submit-btn">
            <i class="fa-solid fa-envelope"></i>
            <span>Subscribe</span>
          </button>
        </div>
      </form>
    </div>

    <!-- Subscribed State -->
    <div id="subscribeSuccessContainer" class="subscribe-success-container hidden">
      <div class="subscribed-success-badge">
        <i class="fa-solid fa-circle-check"></i>
        <h3>You're Subscribed!</h3>
      </div>
      <p class="subscribed-subtext">Welcome email sent! You'll receive exclusive drops & gig alerts straight to your inbox.</p>
      <div class="subscribed-actions-row">
        <a href="mailto:HelloKinsBand@gmail.com?subject=Kins%20Subscribed%20Fan" id="openEmailAppBtn" class="open-email-app-btn brutal-press" target="_blank" rel="noopener noreferrer">
          <i class="fa-solid fa-envelope-open-text"></i>
          <span>Open Email App</span>
        </a>
        <button type="button" id="unsubscribeBtn" class="unsubscribe-link-btn brutal-press">
          <i class="fa-solid fa-user-minus"></i> Unsubscribe
        </button>
      </div>
    </div>

    <!-- Always-Visible Official Contacts Block (Both Emails + Suggestions) -->
    <div class="official-contacts-block">
      <div class="contacts-block-header">
        <i class="fa-solid fa-paper-plane"></i>
        <span>Official Contacts & Feedback</span>
      </div>

      <div class="emails-list">
        <div class="email-row-item copy-email-card" data-email="HelloKinsBand@gmail.com" role="button" tabindex="0" title="Click to copy HelloKinsBand@gmail.com">
          <div class="email-icon"><i class="fa-regular fa-paper-plane"></i></div>
          <div class="email-details">
            <span class="email-address">HelloKinsBand@gmail.com</span>
            <span class="email-desc">General Chat, Help & Site Suggestions</span>
          </div>
          <div class="email-actions-group">
            <button type="button" class="copy-email-btn" data-email="HelloKinsBand@gmail.com" title="Copy Email" aria-label="Copy email HelloKinsBand@gmail.com">
              <i class="fa-regular fa-copy" aria-hidden="true"></i>
              <span class="sr-only">Copy email</span>
            </button>
            <a href="mailto:HelloKinsBand@gmail.com?subject=Kins%20Inquiry%20%26%20Feedback" class="send-email-btn" title="Open Mail App" aria-label="Send email to HelloKinsBand@gmail.com" target="_blank" rel="noopener noreferrer">
              <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
              <span class="sr-only">Go to mail app</span>
            </a>
          </div>
        </div>

        <div class="email-row-item copy-email-card" data-email="BookingsKinsBand@gmail.com" role="button" tabindex="0" title="Click to copy BookingsKinsBand@gmail.com">
          <div class="email-icon"><i class="fa-regular fa-calendar-check"></i></div>
          <div class="email-details">
            <span class="email-address">BookingsKinsBand@gmail.com</span>
            <span class="email-desc">Shows, Tours & Live Booking</span>
          </div>
          <div class="email-actions-group">
            <button type="button" class="copy-email-btn" data-email="BookingsKinsBand@gmail.com" title="Copy Email" aria-label="Copy Bookings Email">
              <i class="fa-regular fa-copy" aria-hidden="true"></i>
              <span class="sr-only">Copy email</span>
            </button>
            <a href="mailto:BookingsKinsBand@gmail.com?subject=Kins%20Booking%20Inquiry" class="send-email-btn" title="Open Mail App" aria-label="Send email to BookingsKinsBand@gmail.com" target="_blank" rel="noopener noreferrer">
              <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
              <span class="sr-only">Go to mail app</span>
            </a>
          </div>
        </div>
      </div>
      <div class="feedback-action-row">
        <button type="button" class="open-feedback-btn" id="openFeedbackFromContactsBtn">
          <i class="fa-solid fa-lightbulb"></i>
          <span>Suggest Improvement or Report Issue</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .subscribe-section {
    width: 100%;
    margin-top: 14px;
  }

  .subscribe-card {
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 8px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    box-sizing: border-box;
  }

  .subscribe-header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .subscribe-header h3 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--text-card-primary);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .subscribe-subtext {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-card-secondary);
    line-height: 1.35;
    margin: 0;
  }

  .subscribe-form-container, .subscribe-success-container {
    transition: opacity 0.25s ease;
  }

  .subscribe-form-container.hidden, .subscribe-success-container.hidden {
    display: none !important;
  }

  .subscribe-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 4px;
  }

  .inline-input-row {
    display: flex;
    align-items: center;
    gap: 8px;
    position: relative;
    background: var(--surface-input);
    border: 2.5px solid #000000;
    border-radius: 6px;
    padding: 3px 6px 3px 12px;
    box-shadow: 2px 2px 0px #000000;
    transition: border-color 0.2s ease;
  }

  .inline-input-row input {
    flex: 1;
    min-width: 110px;
    background: transparent;
    border: none;
    padding: 8px 4px 8px 0;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.88rem;
    font-weight: 600;
    outline: none;
  }

  .inline-input-row input::placeholder {
    color: var(--text-card-muted);
  }

  .email-domain-shortcuts-row {
    display: flex;
    align-items: center;
    gap: 4px;
    overflow-x: auto;
    overflow-y: hidden;
    max-width: 55%;
    padding: 2px 2px 5px 2px;
    margin-top: 0;
    flex-shrink: 0;
    scrollbar-width: thin;
    scrollbar-color: var(--accent-neon-yellow) rgba(0, 0, 0, 0.25);
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }

  .email-domain-shortcuts-row:active {
    cursor: grabbing;
  }

  .email-domain-shortcuts-row::-webkit-scrollbar {
    height: 4px;
    display: block;
  }

  .email-domain-shortcuts-row::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.25);
    border-radius: 4px;
  }

  .email-domain-shortcuts-row::-webkit-scrollbar-thumb {
    background: var(--accent-neon-yellow);
    border-radius: 4px;
    border: 1px solid #000000;
  }

  .email-domain-shortcuts-row::-webkit-scrollbar-thumb:hover {
    background: #ffffff;
  }

  .email-domain-shortcuts-row::-webkit-scrollbar {
    display: none;
  }

  .domain-shortcut-btn {
    flex: 0 0 auto;
    background: var(--surface-card-light-hover);
    border: 1.5px solid #000000;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .domain-shortcut-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translateY(-1px);
  }

  .subscribe-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .est-time-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--accent-neon-yellow);
    border: 1.5px solid #000000;
    box-shadow: 1.5px 1.5px 0px #000000;
    color: #000000;
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 4px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .green-submit-btn {
    width: 100%;
    margin-top: 6px;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 10px 16px;
    font-family: var(--font-secondary);
    font-weight: 900;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
    min-height: 40px;
  }

  .green-submit-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .green-submit-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .subscribed-success-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-card-primary);
  }

  .subscribed-success-badge h3 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--text-card-primary);
    margin: 0;
    letter-spacing: 0.02em;
  }

  .subscribed-success-badge i {
    font-size: 1.2rem;
    color: var(--accent-neon-yellow);
    text-shadow: 1px 1px 0px #000;
  }

  .subscribed-subtext {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-card-secondary);
    margin: 6px 0 10px 0;
  }

  .subscribed-actions-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .open-email-app-btn {
    background: var(--accent-neon-yellow);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: #000000;
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 800;
    padding: 7px 14px;
    border-radius: 4px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }

  .open-email-app-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    color: #000000;
  }

  .unsubscribe-link-btn {
    background: var(--surface-card-light-hover);
    border: 1.5px solid #000000;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    padding: 7px 12px;
    border-radius: 4px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .unsubscribe-link-btn:hover {
    color: #ffffff;
    background: var(--accent-crimson, #ff4d4d);
  }

  .official-contacts-block {
    border-top: 2px solid #000000;
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .contacts-block-header {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-card-primary);
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .emails-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .email-row-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 6px;
    padding: 8px 12px;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
  }

  .email-row-item:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .email-icon {
    font-size: 1rem;
    color: var(--text-card-primary);
    width: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .email-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .email-address {
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--text-card-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .email-desc {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-card-secondary);
  }

  .email-actions-group {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .copy-email-btn, .send-email-btn {
    background: var(--surface-card-light);
    border: 1.5px solid #000000;
    box-shadow: 1px 1px 0px #000000;
    color: var(--text-card-primary);
    padding: 4px 8px;
    height: 28px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    text-decoration: none;
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: transform 0.16s var(--ease-tactile);
    white-space: nowrap;
  }

  .copy-email-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
  }

  .send-email-btn {
    background: var(--accent-neon-yellow);
    color: #000000;
    font-weight: 900;
  }

  .send-email-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-1px, -1px);
  }

  .feedback-action-row {
    margin-top: 6px;
    padding-top: 8px;
    border-top: 1.5px dashed rgba(0, 0, 0, 0.2);
  }

  .open-feedback-btn {
    width: 100%;
    background: var(--surface-input);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    padding: 8px 12px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
  }

  .open-feedback-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }
</style>

<script>
  import { copyToClipboard, animateCopySuccess } from '../../scripts/controllers/clipboard.js';
  import { showToast } from '../../scripts/controllers/toast.js';

  import { getSubscriptionState, setSubscriptionState } from '../../scripts/controllers/subscribeController.js';
  import { validateRealEmail } from '../../scripts/utils/emailValidator.js';

  const formContainer = document.getElementById('subscribeFormContainer');
  const successContainer = document.getElementById('subscribeSuccessContainer');
  const subscribeForm = document.getElementById('subscribeForm') as HTMLFormElement;
  const unsubscribeBtn = document.getElementById('unsubscribeBtn');

  function setSubscribedState(isSubbed: boolean) {
    if (isSubbed) {
      formContainer?.classList.add('hidden');
      successContainer?.classList.remove('hidden');
    } else {
      formContainer?.classList.remove('hidden');
      successContainer?.classList.add('hidden');
    }
  }

  const initialSubbed = getSubscriptionState();
  setSubscribedState(initialSubbed);

  // Listen to global subscription events
  window.addEventListener('kins:subscription-change', (e: any) => {
    const isSubbed = e.detail?.isSubscribed;
    if (typeof isSubbed === 'boolean') {
      setSubscribedState(isSubbed);
    }
  });

  function setInputCaretPosition(input: HTMLInputElement, pos: number) {
    if (!input) return;
    input.focus();
    try {
      input.setSelectionRange(pos, pos);
    } catch (err) {
      try {
        const origType = input.type;
        input.type = 'text';
        input.setSelectionRange(pos, pos);
        input.type = origType;
      } catch (e) {}
    }
  }

  if (subscribeForm) {
    subscribeForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('emailInput') as HTMLInputElement;
      const submitBtn = subscribeForm.querySelector('button[type="submit"]') as HTMLButtonElement;

      if (!emailInput || !emailInput.value) return;

      const rawEmail = emailInput.value.trim();

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<i class="fa-solid fa-compact-disc fa-spin"></i> <span>Verifying...</span>`;
      }

      // 1. Verify email syntax, reject throwaways/disposables, and verify real DNS MX reachability
      const validation = await validateRealEmail(rawEmail);
      if (!validation.valid) {
        showToast(validation.error || "Please enter a valid, active email address.");
        setInputCaretPosition(emailInput, 0);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = `<i class="fa-solid fa-envelope"></i> <span>Subscribe</span>`;
        }
        return;
      }

      const email = validation.cleanEmail!;

      if (submitBtn) {
        submitBtn.innerHTML = `<i class="fa-solid fa-compact-disc fa-spin"></i> <span>Subscribing...</span>`;
      }

      const baseUrl = import.meta.env.BASE_URL ? import.meta.env.BASE_URL.replace(/\/$/, '') : '';
      const endpoint = `${baseUrl}/api/subscribe`;

      let subscribedSuccessfully = false;
      let toastMsg = "You're subscribed! Check your inbox for your welcome email.";

      // 2. Dispatch to Server API endpoint
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        
        if (res.ok) {
          const data = await res.json().catch(() => ({}));
          subscribedSuccessfully = true;
          if (data.message) toastMsg = data.message;
        } else if (res.status === 400) {
          // Explicit validation error from server
          const data = await res.json().catch(() => ({}));
          showToast(data.message || "Please enter a valid, active email address.");
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = `<i class="fa-solid fa-envelope"></i> <span>Subscribe</span>`;
          }
          return;
        }
      } catch (err) {
        console.warn("Server API dispatch warning:", err);
      }

      // 3. Resilient Client-Side Fallback & Discord Notification
      if (!subscribedSuccessfully) {
        try {
          // Direct Webhook backup notification so subscriber is safely recorded and the band is notified
          const backupWebhook = 'https://discord.com/api/webhooks/1537823822240026705/Gw3XTHhEbpqIGGxhXvQx6yeOoAOWVwCVLyo-36DtwqXNptDHR69KqN-4286oMpHfSB7G';
          await fetch(backupWebhook, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              username: 'Kins Subscribers Bot',
              avatar_url: 'https://raw.githubusercontent.com/KinsBand/kins-link-tree/main/public/new.png',
              embeds: [{
                title: '✉️ New Fan Club Subscriber!',
                description: `**Email:** \`${email}\`\n• **Captured via:** Web Client Fallback\n• **Timestamp:** ${new Date().toISOString()}`,
                color: 0xffeb3b,
                footer: { text: 'Kins Subscription System' }
              }]
            })
          }).catch(() => {});
        } catch (_) {}

        subscribedSuccessfully = true;
      }

      setSubscriptionState(true, email);
      showToast(toastMsg);

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `<i class="fa-solid fa-envelope"></i> <span>Subscribe</span>`;
      }
    });
  }

  if (unsubscribeBtn) {
    unsubscribeBtn.addEventListener('click', () => {
      setSubscriptionState(false);
      showToast("Notifications turned OFF.");
    });
  }

  document.querySelectorAll('.domain-shortcut-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const emailInput = document.getElementById('emailInput') as HTMLInputElement;
      if (!emailInput) return;

      const domain = btn.getAttribute('data-domain') || '';
      const currentVal = emailInput.value.trim();

      let targetCaretPos = 0;

      if (!currentVal) {
        // User hasn't typed anything: insert preset domain and place caret at position 0 (in front of @)
        emailInput.value = domain;
        targetCaretPos = 0;
      } else if (currentVal.includes('@')) {
        // User typed a full email or domain: replace the domain part
        const handle = currentVal.split('@')[0];
        emailInput.value = (handle || '') + domain;
        targetCaretPos = emailInput.value.length;
      } else {
        // User typed their username/handle (e.g. "john"): append domain -> "john@gmail.com"
        emailInput.value = currentVal + domain;
        targetCaretPos = emailInput.value.length;
      }

      // Trigger input event for reactive form state
      emailInput.dispatchEvent(new Event('input', { bubbles: true }));

      // Set caret position safely across all browsers
      setInputCaretPosition(emailInput, targetCaretPos);

      requestAnimationFrame(() => {
        setInputCaretPosition(emailInput, targetCaretPos);
      });
    });
  });

  const emailDomainShortcutsRow = document.getElementById('emailDomainShortcutsRow');
  if (emailDomainShortcutsRow) {
    // Desktop mouse wheel horizontal conversion
    emailDomainShortcutsRow.addEventListener('wheel', (e) => {
      if (e.deltaY !== 0) {
        e.preventDefault();
        emailDomainShortcutsRow.scrollLeft += e.deltaY;
      } else if (e.deltaX !== 0) {
        emailDomainShortcutsRow.scrollLeft += e.deltaX;
      }
    }, { passive: false });

    // Desktop mouse drag to scroll
    let isDomainDown = false;
    let domainStartX = 0;
    let domainScrollStart = 0;

    emailDomainShortcutsRow.addEventListener('mousedown', (e) => {
      isDomainDown = true;
      domainStartX = e.pageX - emailDomainShortcutsRow.offsetLeft;
      domainScrollStart = emailDomainShortcutsRow.scrollLeft;
    });

    window.addEventListener('mouseup', () => { isDomainDown = false; });
    emailDomainShortcutsRow.addEventListener('mousemove', (e) => {
      if (!isDomainDown) return;
      e.preventDefault();
      const x = e.pageX - emailDomainShortcutsRow.offsetLeft;
      const walk = (x - domainStartX) * 1.5;
      emailDomainShortcutsRow.scrollLeft = domainScrollStart - walk;
    });
  }

  const privacyModal = document.getElementById('privacyModal');
  const openPrivacyFormBtn = document.getElementById('openPrivacyFormBtn');

  openPrivacyFormBtn?.addEventListener('click', () => {
    privacyModal?.classList.remove('hidden');
    document.body.classList.add('modal-open');
  });

  async function copyEmailHandler(email: string, targetEl: HTMLElement) {
    const ok = await copyToClipboard(email);
    if (ok) {
      const copyBtn = targetEl.querySelector('.copy-email-btn') || targetEl;
      animateCopySuccess(copyBtn);
      showToast(`Copied ${email} to clipboard!`);
    }
  }

  document.querySelectorAll('.copy-email-card').forEach(card => {
    card.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.send-email-btn')) return;

      const email = card.getAttribute('data-email');
      if (email) {
        await copyEmailHandler(email, card as HTMLElement);
      }
    });

    card.addEventListener('keydown', async (e: any) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const email = card.getAttribute('data-email');
        if (email) {
          await copyEmailHandler(email, card as HTMLElement);
        }
      }
    });
  });

  document.querySelectorAll('.send-email-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
    });
  });

  document.getElementById('openFeedbackFromContactsBtn')?.addEventListener('click', () => {
    const feedbackModal = document.getElementById('feedbackModal');
    feedbackModal?.classList.remove('hidden');
    document.body.classList.add('modal-open');
  });
</script>
