---
import { Image } from 'astro:assets';
import kinsLogoNew from '../../assets/kins-logo-new.jpg';

interface Props {
  image?: ImageMetadata | string;
}

const { image = kinsLogoNew } = Astro.props;
---

<div class="hero-banner-container" id="heroBannerContainer">
  <div class="hero-banner-glow"></div>
  {
    typeof image === 'string' ? (
      <img src={image} alt="Kins logo banner" class="hero-banner-img" id="heroBannerImg" decoding="async" fetchpriority="high" width="600" height="140" />
    ) : (
      <Image src={image} alt="Kins logo banner" class="hero-banner-img" id="heroBannerImg" decoding="async" loading="eager" width={600} height={140} />
    )
  }
  <div class="hero-gradient-overlay"></div>
</div>

<style>
  .hero-banner-container {
    position: relative;
    width: 100%;
    max-width: 100%;
    height: 140px;
    margin: 4px 0;
    z-index: 1;
    overflow: visible;
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-banner-glow {
    position: absolute;
    inset: -20px;
    background: radial-gradient(
      ellipse 70% 60% at 50% 50%,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.03) 40%,
      transparent 75%
    );
    pointer-events: none;
    filter: blur(16px);
  }

  .hero-banner-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    filter: brightness(105%) contrast(110%);
    mix-blend-mode: lighten;
    mask-image: radial-gradient(
      ellipse 85% 75% at 50% 50%,
      black 40%,
      rgba(0, 0, 0, 0.8) 65%,
      rgba(0, 0, 0, 0.3) 82%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 85% 75% at 50% 50%,
      black 40%,
      rgba(0, 0, 0, 0.8) 65%,
      rgba(0, 0, 0, 0.3) 82%,
      transparent 100%
    );
    display: block;
  }

  .hero-gradient-overlay {
    position: absolute;
    inset: -10px;
    background: radial-gradient(
      ellipse 90% 80% at 50% 50%,
      transparent 50%,
      rgba(20, 20, 23, 0.4) 75%,
      rgba(20, 20, 23, 0.85) 90%,
      #141417 100%
    );
    pointer-events: none;
  }
</style>

