---
import { Image } from 'astro:assets';
import kinsLogoNew from '../../assets/kins-logo-new.png';

interface Props {
  image?: ImageMetadata | string;
}

const { image = kinsLogoNew } = Astro.props;
---

<div class="hero-banner-container" id="heroBannerContainer" data-track-container="main:hero">
  <div class="hero-banner-glow"></div>
  {
    typeof image === 'string' ? (
      <img src={image} alt="Kins logo banner" class="hero-banner-img" id="heroBannerImg" decoding="async" fetchpriority="high" width="600" height="140" />
    ) : (
      <Image src={image} alt="Kins logo banner" class="hero-banner-img" id="heroBannerImg" decoding="async" loading="eager" width={600} height={140} />
    )
  }
</div>

<style>
  .hero-banner-container {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-height: 120px;
    height: 140px;
    margin: 0 auto;
    z-index: 10;
    overflow: visible;
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    box-sizing: border-box;
  }

  .hero-banner-glow {
    position: absolute;
    inset: -10px;
    background: radial-gradient(
      ellipse 65% 55% at 50% 50%,
      rgba(242, 253, 67, 0.12) 0%,
      rgba(242, 253, 67, 0.04) 40%,
      transparent 75%
    );
    pointer-events: none;
    filter: blur(14px);
    z-index: -1;
  }

  .hero-banner-img {
    width: 100%;
    max-width: 360px;
    height: 100%;
    max-height: 125px;
    object-fit: contain;
    object-position: center;
    filter: drop-shadow(0 0 16px rgba(242, 253, 67, 0.35)) drop-shadow(0 4px 10px rgba(0, 0, 0, 0.8));
    display: block;
    z-index: 2;
    transition: transform 0.22s var(--ease-snappy, ease);
  }

  @media (max-width: 767px) {
    .hero-banner-container {
      height: 120px;
      min-height: 100px;
    }
    .hero-banner-img {
      max-width: 320px;
      max-height: 105px;
    }
  }
</style>
