---
import { Image } from 'astro:assets';
import kinsLogoHero from '../../assets/kins-logo-hero.png';

interface Props {
  image?: ImageMetadata | string;
}

const { image = kinsLogoHero } = Astro.props;
---

<div class="hero-banner-container" id="heroBannerContainer" data-track-container="main:hero">
  <div class="hero-banner-glow"></div>
  <h1 class="hero-banner-heading">
    {
      typeof image === 'string' ? (
        <img src={image} alt="KINS" class="hero-banner-img" id="heroBannerImg" decoding="async" fetchpriority="high" width="409" height="372" />
      ) : (
        <Image src={image} alt="KINS" class="hero-banner-img" id="heroBannerImg" decoding="async" loading="eager" fetchpriority="high" width={409} height={372} />
      )
    }
  </h1>
</div>

<style>
  .hero-banner-heading {
    display: flex;
    justify-content: center;
    width: 100%;
    margin: 0;
    font-size: inherit;
    line-height: 0;
    position: relative;
    z-index: 2;
  }

  .hero-banner-container {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-height: 140px;
    height: auto;
    margin: 0 auto;
    z-index: 10;
    overflow: visible;
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 12px;
    box-sizing: border-box;
  }

  .hero-banner-glow {
    position: absolute;
    inset: -10px;
    background: radial-gradient(
      ellipse 65% 55% at 50% 50%,
      var(--brand-accent-glow, rgba(242, 253, 67, 0.12)) 0%,
      transparent 70%
    );
    pointer-events: none;
    filter: blur(14px);
    z-index: -1;
  }

  .hero-banner-img {
    width: 100%;
    max-width: 220px;
    height: auto;
    max-height: 175px;
    aspect-ratio: 409 / 372;
    object-fit: contain;
    object-position: center;
    filter: drop-shadow(0 0 16px rgba(242, 253, 67, 0.35)) drop-shadow(0 4px 10px rgba(0, 0, 0, 0.8));
    display: block;
    z-index: 2;
    transition: transform 0.22s var(--ease-snappy, ease);
  }

  @media (max-width: 767px) {
    .hero-banner-container {
      min-height: 130px;
      padding: 6px 12px;
    }
    .hero-banner-img {
      max-width: 185px;
      max-height: 155px;
    }
  }
</style>
