---
import { bandMembers } from '../../settings/members.config';

const members = bandMembers;
---

<section class="members-section" id="members-section">
  <div class="members-section-header">
    <h3 class="members-section-title"><i class="fa-solid fa-user-group fa-fw"></i> Band Members</h3>
    <div class="section-scroll-controls">
      <button type="button" class="scroll-arrow-btn" id="membersScrollPrev" aria-label="Scroll members left">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <button type="button" class="scroll-arrow-btn" id="membersScrollNext" aria-label="Scroll members right">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
  </div>

  <div class="members-scroll-container brutal-scroll-x" id="membersScrollContainer">
    {members.map((member) => (
      <div class="member-card">
        <div class={`member-img-wrapper member-avatar-box avatar-${member.id}`}>
          <div class="avatar-initials">{member.initial}</div>
          <i class={`fa-solid ${member.icon} avatar-bg-icon`}></i>
          <span class="member-badge">{member.badge}</span>
        </div>
        <div class="member-info">
          <h4 class="member-name">{member.name}</h4>
          <p class="member-bio">{member.bio}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .members-section {
    width: 100%;
    margin-top: 14px;
    margin-bottom: 10px;
    content-visibility: auto;
    contain-intrinsic-size: 0 350px;
  }

  .members-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    padding: 0 2px;
    user-select: none;
    overflow: visible;
  }

  .members-section-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .members-section-title i {
    color: var(--accent-neon-yellow);
    font-size: 0.9rem;
    width: 1.25em;
    height: 1.25em;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .section-scroll-controls {
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-2px);
    transition: opacity 0.22s ease, transform 0.22s ease;
  }

  .section-scroll-controls.is-scrolling {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  @media (min-width: 768px) {
    .section-scroll-controls {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }
  }

  .scroll-arrow-btn {
    background: var(--surface-card-light);
    border: 2.5px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: var(--text-card-primary);
    width: 32px;
    height: 32px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 800;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease, opacity 0.16s ease;
  }

  .scroll-arrow-btn:hover:not(:disabled):not(.is-disabled) {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .scroll-arrow-btn:active:not(:disabled):not(.is-disabled) {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .scroll-arrow-btn:disabled,
  .scroll-arrow-btn.is-disabled {
    opacity: 0.35;
    pointer-events: none;
    cursor: not-allowed;
    box-shadow: none;
  }

  .members-scroll-container {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 4px 14px 4px;
    -webkit-overflow-scrolling: touch;
  }

  /* Neo-Brutalist Member Card */
  .member-card {
    flex: 0 0 210px;
    scroll-snap-align: start;
    background: var(--surface-card-light);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px var(--accent-neon-yellow), 3px 3px 0px 1px #000000;
    border-radius: 8px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform 0.18s var(--ease-tactile), box-shadow 0.18s ease;
    box-sizing: border-box;
  }

  .member-card:hover,
  .member-card.is-scroll-active {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px var(--accent-neon-yellow), 5px 5px 0px 1px #000000;
  }

  @media (min-width: 768px) {
    .member-card {
      flex: 0 0 230px;
    }
  }

  .member-avatar-box {
    width: 100%;
    aspect-ratio: 1 / 1;
    height: auto;
    border-radius: 6px;
    background: #121216;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 2.5px solid #000000;
  }

  .avatar-initials {
    font-family: var(--font-display);
    font-size: 3.2rem;
    font-weight: 900;
    color: var(--accent-neon-yellow);
    z-index: 2;
  }

  .avatar-bg-icon {
    position: absolute;
    right: -10px;
    bottom: -10px;
    font-size: 5rem;
    color: rgba(255, 255, 255, 0.08);
    z-index: 1;
  }

  .member-badge {
    position: absolute;
    top: 6px;
    left: 6px;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 1.5px solid #000000;
    font-family: var(--font-secondary);
    font-size: 0.58rem;
    font-weight: 900;
    padding: 2px 6px;
    border-radius: 3px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    z-index: 3;
  }

  .member-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .member-name {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-card-primary);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .member-bio {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-card-secondary);
    line-height: 1.3;
    margin: 0;
  }
</style>

<script>
  const container = document.getElementById('membersScrollContainer');
  const prevBtn = document.getElementById('membersScrollPrev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('membersScrollNext') as HTMLButtonElement | null;
  const cards = container?.querySelectorAll('.member-card') || [];

  let rafId: number | null = null;
  let scrollSettleTimeout: ReturnType<typeof setTimeout> | null = null;

  function updateMembersNav() {
    if (!container) return;
    if (rafId) cancelAnimationFrame(rafId);
    rafId = requestAnimationFrame(() => {
      const isOverflowing = container.scrollWidth > container.clientWidth + 4;
      const controlsGroup = prevBtn?.parentElement;
      if (controlsGroup) {
        controlsGroup.style.display = isOverflowing ? 'flex' : 'none';
      }
      const maxScroll = container.scrollWidth - container.clientWidth;
      const atStart = container.scrollLeft <= 5;
      const atEnd = container.scrollLeft >= maxScroll - 5;
      if (prevBtn) {
        prevBtn.disabled = atStart;
        prevBtn.classList.toggle('is-disabled', atStart);
        prevBtn.setAttribute('aria-disabled', String(atStart));
      }
      if (nextBtn) {
        nextBtn.disabled = atEnd;
        nextBtn.classList.toggle('is-disabled', atEnd);
        nextBtn.setAttribute('aria-disabled', String(atEnd));
      }
    });
  }

  function updateActiveCardHighlight() {
    if (!container || !cards.length) return;
    const containerCenter = container.getBoundingClientRect().left + container.clientWidth / 2;
    let closestCard: Element | null = null;
    let closestDist = Infinity;

    cards.forEach((card) => {
      const rect = card.getBoundingClientRect();
      const cardCenter = rect.left + rect.width / 2;
      const dist = Math.abs(containerCenter - cardCenter);
      if (dist < closestDist) {
        closestDist = dist;
        closestCard = card;
      }
    });

    cards.forEach((card) => {
      if (card === closestCard) {
        card.classList.add('is-scroll-active');
      } else {
        card.classList.remove('is-scroll-active');
      }
    });

    if (scrollSettleTimeout) clearTimeout(scrollSettleTimeout);
    scrollSettleTimeout = setTimeout(() => {
      cards.forEach((card) => card.classList.remove('is-scroll-active'));
      const controlsGroup = prevBtn?.parentElement;
      if (controlsGroup) {
        controlsGroup.classList.remove('is-scrolling');
      }
    }, 800);
  }

  if (container) {
    updateMembersNav();
    window.addEventListener('resize', updateMembersNav, { passive: true });

    container.addEventListener('scroll', () => {
      const controlsGroup = prevBtn?.parentElement;
      if (controlsGroup) {
        controlsGroup.classList.add('is-scrolling');
      }
      updateMembersNav();
      updateActiveCardHighlight();
    }, { passive: true });

    container.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
        container.scrollLeft += e.deltaX;
      }
    }, { passive: true });

    prevBtn?.addEventListener('click', () => {
      const controlsGroup = prevBtn?.parentElement;
      if (controlsGroup) controlsGroup.classList.add('is-scrolling');
      container.scrollBy({ left: -260, behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      const controlsGroup = nextBtn?.parentElement;
      if (controlsGroup) controlsGroup.classList.add('is-scrolling');
      container.scrollBy({ left: 260, behavior: 'smooth' });
    });
  }
</script>
