---
const members = [
  {
    id: "vivian",
    name: "Vivian",
    role: "Lead Vocals & Guitar",
    icon: "fa-microphone",
    initial: "V",
    badge: "VOCALS & GUITAR",
    bio: "Melodies & guitar hooks."
  },
  {
    id: "charlie",
    name: "Charlie",
    role: "Guitar & Vocals",
    icon: "fa-guitar",
    initial: "C",
    badge: "GUITAR & VOCALS",
    bio: "Lyrics, guitar & band energy."
  },
  {
    id: "oscar",
    name: "Oscar",
    role: "Bass & Synth",
    icon: "fa-sliders",
    initial: "O",
    badge: "BASS",
    bio: "Basslines & vintage synths."
  },
  {
    id: "trai",
    name: "Trai",
    role: "Drums & Percussion",
    icon: "fa-drum",
    initial: "T",
    badge: "DRUMS",
    bio: "Drums & driving heartbeat."
  }
];
---

<section class="members-section" id="members-section">
  <div class="members-section-header">
    <h3 class="members-section-title"><i class="fa-solid fa-user-group"></i> Band Members</h3>
    <div class="section-scroll-controls">
      <button type="button" class="scroll-arrow-btn" id="membersScrollPrev" aria-label="Scroll members left">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      <button type="button" class="scroll-arrow-btn" id="membersScrollNext" aria-label="Scroll members right">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
    </div>
  </div>

  <div class="members-scroll-container" id="membersScrollContainer">
    {members.map((member) => (
      <div class="member-card">
        <div class={`member-img-wrapper member-avatar-box avatar-${member.id}`}>
          <div class="avatar-initials">{member.initial}</div>
          <i class={`fa-solid ${member.icon} avatar-bg-icon`}></i>
          <span class="member-badge">{member.badge}</span>
        </div>
        <div class="member-info">
          <h4 class="member-name">{member.name}</h4>
          <p class="member-bio">{member.bio}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .members-section {
    width: 100%;
    margin-top: 14px;
    margin-bottom: 10px;
    content-visibility: auto;
    contain-intrinsic-size: 0 350px;
  }

  .members-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    padding: 0 2px;
  }

  .members-section-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .members-section-title i {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .section-scroll-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .scroll-arrow-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-white);
    width: 28px;
    height: 28px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.72rem;
    transition: all 0.18s ease;
  }

  .scroll-arrow-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.28);
    color: var(--btn-green);
    transform: translateY(-1px);
  }

  .members-scroll-container {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 2px 2px 12px 2px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }

  .members-scroll-container::-webkit-scrollbar {
    height: 4px;
  }

  .members-scroll-container::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 2px;
  }

  .members-scroll-container::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
  }

  .members-scroll-container::-webkit-scrollbar-thumb:hover {
    background: var(--btn-green);
  }

  .member-card {
    flex: 0 0 210px;
    scroll-snap-align: start;
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    backdrop-filter: blur(12px);
    transition: transform 0.2s var(--ease-snappy), border-color 0.2s ease;
  }

  .member-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.28);
  }

  @media (min-width: 768px) {
    .member-card {
      flex: 0 0 240px;
    }
  }

  @media (min-width: 1200px) {
    .member-card {
      flex: 0 0 260px;
    }
  }

  .member-avatar-box {
    width: 100%;
    aspect-ratio: 1 / 1;
    height: auto;
    border-radius: 4px;
    background: linear-gradient(135deg, #18181c 0%, #0d0d0f 100%);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .avatar-initials {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 900;
    color: var(--text-white);
    z-index: 2;
  }

  .avatar-bg-icon {
    position: absolute;
    right: -10px;
    bottom: -10px;
    font-size: 4.8rem;
    color: rgba(255, 255, 255, 0.04);
    z-index: 1;
  }

  .member-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: var(--text-white);
    color: var(--text-dark);
    font-family: var(--font-secondary);
    font-size: 0.55rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 2px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    z-index: 3;
  }

  .member-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .member-name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-white);
    letter-spacing: -0.01em;
  }

  .member-role {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .member-bio {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.35;
  }
</style>

<script>
  const container = document.getElementById('membersScrollContainer');
  const prevBtn = document.getElementById('membersScrollPrev');
  const nextBtn = document.getElementById('membersScrollNext');

  function updateMembersNav() {
    if (!container) return;
    const isOverflowing = container.scrollWidth > container.clientWidth + 4;
    const controlsGroup = prevBtn?.parentElement;
    if (controlsGroup) {
      controlsGroup.style.display = isOverflowing ? 'flex' : 'none';
    }
  }

  if (container) {
    updateMembersNav();
    window.addEventListener('resize', updateMembersNav);
    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(updateMembersNav).observe(container);
    }

    container.addEventListener('wheel', (e) => {
      if (e.deltaY !== 0) {
        e.preventDefault();
        container.scrollLeft += e.deltaY;
      }
    }, { passive: false });

    prevBtn?.addEventListener('click', () => {
      container.scrollBy({ left: -260, behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      container.scrollBy({ left: 260, behavior: 'smooth' });
    });
  }
</script>
