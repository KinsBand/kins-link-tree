---
// Theory Sticky Category Filter Chips Bar
---

<nav class="theory-chip-bar" id="theoryChipBar" aria-label="Category Quick Filters">
  <div class="chip-scroll-row" id="guitarChipsRow">
    <button type="button" class="theory-chip-btn brutal-press" data-filter="fretboard">🎸 Fretboard</button>
    <button type="button" class="theory-chip-btn brutal-press" data-filter="scales">🎼 Scales</button>
    <button type="button" class="theory-chip-btn brutal-press" data-filter="chords">▤ Chords</button>
    <button type="button" class="theory-chip-btn brutal-press" data-filter="caged">❖ CAGED</button>
    <button type="button" class="theory-chip-btn brutal-press" data-filter="intervals">☍ Intervals</button>
    <button type="button" class="theory-chip-btn brutal-press" data-filter="tunings">⫸ Tunings</button>
  </div>
  <div class="chip-scroll-row" id="drumsChipsRow" hidden>
    <button type="button" class="theory-chip-btn brutal-press" data-filter="drum-grid">🥁 Beat Grid</button>
    <button type="button" class="theory-chip-btn brutal-press" data-filter="rudiments">🥢 Rudiments</button>
    <button type="button" class="theory-chip-btn brutal-press" data-filter="meter">⏱ Time & Meter</button>
    <button type="button" class="theory-chip-btn brutal-press" data-filter="polyrhythms">☍ Polyrhythms</button>
    <button type="button" class="theory-chip-btn brutal-press" data-filter="grooves">🎛 Grooves</button>
    <button type="button" class="theory-chip-btn brutal-press" data-filter="subdivisions">〰 Subdivisions</button>
  </div>
</nav>
