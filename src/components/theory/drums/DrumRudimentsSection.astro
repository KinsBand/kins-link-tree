---
import { drumCategories, type RudimentItem } from '../../../settings/theory.config';

const rudimentsCategory = drumCategories.find((c) => c.id === 'drum-rudiments');
const rudiments = (rudimentsCategory?.items || []) as RudimentItem[];
---

<article class="theory-category-card" data-category-id="drum-rudiments" data-chip="rudiments">
  <header class="category-header">
    <div class="category-title-wrap">
      <div class="category-icon-box"><i class="fa-solid fa-drumstick-bite" aria-hidden="true"></i></div>
      <div>
        <h2 class="category-title">Rudiments</h2>
        <p class="category-subtitle">Snare sticking patterns & flows.</p>
      </div>
    </div>
  </header>

  <!-- In-Section Sub-Filters -->
  <div class="section-subfilters-row" data-target-list="rudiments-list">
    <button type="button" class="subfilter-btn active brutal-press" data-type="all">All Rudiments</button>
    <button type="button" class="subfilter-btn brutal-press" data-type="rolls">Rolls</button>
    <button type="button" class="subfilter-btn brutal-press" data-type="diddles">Diddles</button>
    <button type="button" class="subfilter-btn brutal-press" data-type="flams-drags">Flams & Drags</button>
  </div>

  <div class="category-items-list" id="rudiments-list">
    {rudiments.map((item) => (
      <div class="theory-item-row" data-subfilter-type={item.type} data-search-target={`${item.name} ${item.sticking}`}>
        <div class="item-name-col">
          <div class="item-title-row">
            <strong class="item-name">{item.name}</strong>
            <span class="item-type-tag">{item.type}</span>
          </div>
          <span class="item-sticking-flow">Flow: <code>{item.sticking}</code></span>
        </div>
        <div class="item-actions-col">
          <div class="item-action-btns">
            <button type="button" class="item-quick-btn brutal-press" data-load-rudiment={item.id} title="Load in sticking visualizer">
              <i class="fa-solid fa-eye" aria-hidden="true"></i> View Flow
            </button>
            <button type="button" class="item-icon-quick-btn brutal-press" data-copy-text={`${item.name} Sticking: ${item.sticking}`} title="Copy sticking to clipboard">
              <i class="fa-solid fa-copy" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </div>
    ))}
  </div>
</article>
