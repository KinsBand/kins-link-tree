---
// Interactive Visual Fretboard Hero Sandbox
const chromaticKeys = ['A', 'Bb', 'B', 'C', 'C#', 'D', 'Eb', 'E', 'F', 'F#', 'G', 'Ab'];
---

<article class="theory-category-card hero-visual-card" data-category-id="guitar-fretboard-hero" data-chip="fretboard">
  <header class="category-header">
    <div class="category-title-wrap">
      <div class="category-icon-box">
        <i class="fa-solid fa-guitar" aria-hidden="true"></i>
      </div>
      <div>
        <h2 class="category-title">Fretboard</h2>
        <p class="category-subtitle">Live note positions, shapes & audio strum.</p>
      </div>
    </div>
    <div class="header-action-group">
      <button type="button" class="audio-action-btn brutal-press" id="guitarStrumBtn" title="Play scale arpeggio or chord strum" aria-label="Play scale or chord sound">
        <i class="fa-solid fa-volume-high" aria-hidden="true"></i>
        <span id="guitarStrumBtnText">STRUM</span>
      </button>
    </div>
  </header>

  <!-- Fretboard Mode & Label Selector -->
  <div class="fretboard-mode-bar">
    <div class="fret-mode-group">
      <span class="fret-control-label">MODE:</span>
      <div class="segmented-sub-pills" id="fretModeSelector">
        <button type="button" class="sub-pill-btn active brutal-press" data-fret-mode="scales">Scales & Modes</button>
        <button type="button" class="sub-pill-btn brutal-press" data-fret-mode="chords">Chord Shapes</button>
        <button type="button" class="sub-pill-btn brutal-press" data-fret-mode="caged">CAGED System</button>
      </div>
    </div>

    <!-- Note Display Mode Toggle (Degrees vs Note Names) -->
    <div class="fret-label-group">
      <span class="fret-control-label">DISPLAY:</span>
      <div class="segmented-sub-pills" id="fretLabelSelector">
        <button type="button" class="sub-pill-btn active brutal-press" data-fret-label="degree" title="Show scale & chord intervals (R, ♭3, 5, ♭7)">Degrees</button>
        <button type="button" class="sub-pill-btn brutal-press" data-fret-label="note" title="Show actual pitch names (A, C, D, E, G)">Notes</button>
      </div>
    </div>
  </div>

  <!-- Root Key & Preset Selector Pills -->
  <div class="fretboard-controls-row">
    <!-- Full 12-Tone Chromatic Root Key Selector -->
    <div class="fret-control-group" id="guitarRootGroup">
      <span class="fret-control-label">ROOT KEY:</span>
      <div class="fret-pills-wrap" id="guitarRootPills">
        {chromaticKeys.map((key) => (
          <button type="button" class={`fret-pill-btn ${key === 'A' ? 'active' : ''} brutal-press`} data-root={key}>
            {key}
          </button>
        ))}
      </div>
    </div>

    <!-- Scale / Chord Preset Pills -->
    <div class="fret-control-group" id="guitarPresetGroup">
      <span class="fret-control-label" id="guitarPresetLabel">SCALE:</span>
      <div class="fret-pills-wrap" id="guitarPresetPills">
        <!-- Dynamically populated via JS -->
      </div>
    </div>
  </div>

  <!-- Live SVG/DOM Fretboard Visualizer -->
  <div class="fretboard-visual-wrapper">
    <div class="fretboard-scroll-area">
      <div class="fretboard-canvas" id="guitarFretboardCanvas" role="img" aria-label="Visual 6-String Guitar Fretboard">
        <!-- Rendered dynamically by script -->
      </div>
    </div>
  </div>

  <!-- Legend & Info Bar -->
  <footer class="fretboard-legend-bar" id="guitarFretLegend">
    <div class="legend-item"><span class="legend-dot root-dot">R</span> Root Note</div>
    <div class="legend-item"><span class="legend-dot note-dot">●</span> Scale / Chord Tone</div>
    <div class="legend-item"><span class="legend-mute">✕</span> Muted String</div>
    <div class="legend-item"><span class="legend-open">◯</span> Open String</div>
    <div class="legend-summary" id="guitarFretSummary">A Minor Pentatonic • 1 - ♭3 - 4 - 5 - ♭7</div>
  </footer>
</article>
