---
const members = [
  {
    id: "vivian",
    name: "Vivian",
    role: "Lead Vocals & Guitar",
    icon: "fa-microphone",
    initial: "V",
    badge: "VOCALS & GUITAR",
    bio: "Shaping Kins' sound with signature melodies and driving rhythm."
  },
  {
    id: "charlie",
    name: "Charlie",
    role: "Guitar & Vocals",
    icon: "fa-guitar",
    initial: "C",
    badge: "GUITAR & VOCALS",
    bio: "Bringing melodies, lyrics and the energy that ties everything together."
  },
  {
    id: "oscar",
    name: "Oscar",
    role: "Bass & Synth",
    icon: "fa-sliders",
    initial: "O",
    badge: "BASS",
    bio: "Driving the groove with bass lines and vintage-inspired synth textures."
  },
  {
    id: "trai",
    name: "Trai",
    role: "Drums & Percussion",
    icon: "fa-drum",
    initial: "T",
    badge: "DRUMS",
    bio: "Laying down the heartbeat of the band with high-energy rhythms and anthemic beats."
  }
];
---

<section class="members-section" id="members-section">
  <div class="members-section-header">
    <h3 class="members-section-title"><i class="fa-solid fa-user-group"></i> Band Members</h3>
    <span class="scroll-hint-pill" id="scrollHintPill"><i class="fa-solid fa-arrow-right-long"></i> Scroll</span>
  </div>

  <div class="members-scroll-container">
    {members.map((member) => (
      <div class="member-card">
        <div class={`member-img-wrapper member-avatar-box avatar-${member.id}`}>
          <div class="avatar-initials">{member.initial}</div>
          <i class={`fa-solid ${member.icon} avatar-bg-icon`}></i>
          <span class="member-badge">{member.badge}</span>
        </div>
        <div class="member-info">
          <h4 class="member-name">{member.name}</h4>
          <span class="member-role"><i class={`fa-solid ${member.icon}`}></i> {member.role}</span>
          <p class="member-bio">{member.bio}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .members-section {
    width: 100%;
    margin-top: 14px;
    margin-bottom: 10px;
    content-visibility: auto;
    contain-intrinsic-size: 0 350px;
  }

  .members-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    padding: 0 2px;
  }

  .members-section-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .members-section-title i {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .scroll-hint-pill {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 4px 10px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .members-scroll-container {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 2px 2px 14px 2px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .member-card {
    flex: 0 0 210px;
    scroll-snap-align: start;
    background: rgba(18, 18, 20, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    backdrop-filter: blur(12px);
    transition: transform 0.2s var(--ease-snappy), border-color 0.2s ease;
  }

  .member-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.28);
  }

  /* 1:1 Aspect Ratio Headshot Container */
  .member-avatar-box {
    width: 100%;
    aspect-ratio: 1 / 1;
    height: auto;
    border-radius: 4px;
    background: linear-gradient(135deg, #18181c 0%, #0d0d0f 100%);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .avatar-initials {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 900;
    color: var(--text-white);
    z-index: 2;
  }

  .avatar-bg-icon {
    position: absolute;
    right: -10px;
    bottom: -10px;
    font-size: 4.8rem;
    color: rgba(255, 255, 255, 0.04);
    z-index: 1;
  }

  .member-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: var(--text-white);
    color: var(--text-dark);
    font-family: var(--font-secondary);
    font-size: 0.55rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 2px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    z-index: 3;
  }

  .member-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .member-name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-white);
    letter-spacing: -0.01em;
  }

  .member-role {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .member-bio {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.35;
  }
</style>
