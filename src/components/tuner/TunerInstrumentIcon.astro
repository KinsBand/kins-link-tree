---
interface Props { instrument: 'electric' | 'acoustic' | 'bass' | 'drums'; }
const { instrument } = Astro.props;
---
<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {instrument === 'electric' && <>
    <path d="M14 12c-2 0-3-2-3-4-3 2-4 5-2 8-1 2-5 3-5 7 0 4 4 7 9 7s9-3 9-7c0-3-3-4-3-6 3-2 5-5 4-8-2 3-4 4-6 3" />
    <path d="M14 18V6l-1-3 5-2 1 4-2 2v11M11 20h7m-7 4h7M21 2l-2 1M21 5l-2 1" />
    <circle cx="19" cy="25" r="1" fill="currentColor" stroke="none" />
  </>}
  {instrument === 'acoustic' && <>
    <path d="M13 11c-5-2-8 2-6 6 1 2 1 3-1 5-3 5 1 8 10 8s13-3 10-8c-2-2-2-3-1-5 2-4-1-8-6-6" />
    <path d="M14 14V7l-1-5h6l-1 5v7M11 26h10M11 3h2m6 0h2M11 6h2m6 0h2" />
    <circle cx="16" cy="19" r="3" />
    <path d="M16 8v8m0 6v4" stroke-width="1" />
  </>}
  {instrument === 'bass' && <>
    <path d="M13 16c-2 0-3-3-2-5-4 2-5 5-3 8-2 1-4 3-4 6 0 3 4 5 8 5 5 0 9-2 9-6 0-3-3-4-3-6 3-1 5-4 4-7-1 3-3 5-6 5" />
    <path d="M13 22V6l-1-4h6l-2 4v16M10 23h8m-8 3h8M10 2h2m-2 3h2m6-3h2m-3 3h2" />
    <path d="M14.5 7v15" stroke-width="0.8" />
  </>}
  {instrument === 'drums' && <>
    <circle cx="16" cy="23" r="7" /><circle cx="16" cy="23" r="3" />
    <path d="M10 28l-2 2m14-2 2 2M4 11v17m-2 2 2-2 2 2M28 10v18m-2 2 2-2 2 2M9 3l9 8M23 3l-8 8" />
    <ellipse cx="5" cy="10" rx="4" ry="1.5" /><ellipse cx="27" cy="9" rx="4" ry="1.5" />
    <rect x="8" y="12" width="7" height="6" rx="1.5" /><rect x="17" y="12" width="7" height="6" rx="1.5" />
  </>}
</svg>
