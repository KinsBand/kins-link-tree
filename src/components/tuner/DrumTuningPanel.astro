---
import { DRUM_DEFAULTS } from '../../settings/drumTuner.config';
---
<section class="drum-workflow" id="drumWorkflow" hidden aria-label="Guided drum tuning">
  <header class="drum-heading"><h2>TUNE YOUR KIT</h2><span class="drum-beta">BETA</span></header>
  <div class="drum-fields">
    <div class="drum-field"><label for="drumSelect">Drum</label><div class="drum-select-row"><div class="drum-select-wrap"><select id="drumSelect">{DRUM_DEFAULTS.map(drum => <option value={drum.id}>{drum.label}</option>)}</select><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></div><button id="drumRemove" type="button" class="drum-remove brutal-press" aria-label="Remove selected drum" title="Remove selected drum">×</button></div></div>
      <label id="drumTargetField">Lug target (Hz)<input id="drumTargetHz" type="number" min="45" max="500" step="0.5" /></label>
    <label>Diameter (inches)<input id="drumDiameter" type="number" min="6" max="30" step="1" /></label>
    <div class="drum-field"><span id="drumLugLabel">Lugs per head</span><div class="tuner-stepper-controls drum-lug-stepper" role="group" aria-labelledby="drumLugLabel"><button id="drumLugsMinus" type="button" class="tuner-stepper-button brutal-press" aria-label="Remove one lug">−</button><output id="drumLugCount" aria-live="polite">6</output><button id="drumLugsPlus" type="button" class="tuner-stepper-button brutal-press" aria-label="Add one lug">+</button></div></div>
  </div>
  <nav class="drum-steps" aria-label="Tuning steps">
    <button type="button" class="brutal-press" data-drum-step="batter">1 · Batter</button>
    <button type="button" class="brutal-press" data-drum-step="resonant">2 · Resonant</button>
    <button type="button" class="brutal-press" data-drum-step="whole">3 · Whole drum</button>
  </nav>
  <div class="drum-session">
    <div id="drumLugDiagram" class="drum-lug-diagram" role="group" aria-label="Select a lug"></div>
    <div class="drum-measurement">
      <output id="drumReading" class="drum-reading">—<small>Hz · last tap</small></output>
      <p id="drumFeedback" role="status">Tap the selected lug.</p>
      <button type="button" class="brutal-press" id="drumUseReading" disabled>Use last tap as target</button>
    </div>
  </div>
  <p id="drumAudioStatus" class="drum-audio-status" role="status" aria-live="polite">Tap a lug to hear the target. Start to measure.</p>
  <p class="drum-sample-credit">Drum recordings: <a href="https://oramics.github.io/sampled/DRUMS/pearl-master-studio/" target="_blank" rel="noopener noreferrer">Pearl Master Studio by enoe</a> · <a href="https://creativecommons.org/licenses/by/3.0/" target="_blank" rel="noopener noreferrer">CC BY 3.0</a>. Pitch-adjusted reference.</p>
  <p id="drumProgress" class="drum-progress"></p>
  <div class="drum-actions"><button type="button" class="brutal-press" id="drumNextLug">Next lug →</button><button type="button" class="brutal-press" id="drumNextStep">Next head →</button></div>
  <p id="drumNotice" class="drum-notice" role="status" aria-live="polite"></p>
</section>
