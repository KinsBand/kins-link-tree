  }

  :global(html.low-power-mode) .tuner-needle {
    display: none;
  }
</style>

<script>
  let controllerPromise: Promise<any> | null = null;
  let initialized = false;

  async function loadController() {
    if (!controllerPromise) controllerPromise = import('../scripts/controllers/tuner/index.js');
    return controllerPromise;
  }

  function start() {
    if (initialized) return;
    initialized = true;
    loadController()
      .then((mod) => mod.initTuner())
      .catch((err) => console.error('KINS Tuner failed to load:', err));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }

  document.addEventListener(
    'click',
    (e) => {
      if (initialized) return;
      const target = e.target as HTMLElement | null;
      const btn = target?.closest('button');
      if (!btn || !btn.dataset.track?.startsWith('tuner:')) return;
      start();
    },
    { passive: true }
  );
</script>
