      padding: 8px 20px;
    }

    .tuner-badge-side {
      font-size: 0.7rem;
      padding: 6px 12px;
    }

    .tuner-hint {
      font-size: 0.88rem;
    }

    .tuner-figure {
      align-self: center;
      min-height: 260px;
      max-height: none;
    }

    .tuner-figure :global(svg) {
      width: min(420px, 100%);
      max-height: none;
    }

    .tuner-footer-group {
      flex-direction: row;
      align-items: stretch;
      gap: 16px;
    }

    .tuner-instruments {
      flex: 1 1 auto;
    }

    .tuner-inst-card {
      padding: 14px 8px 16px;
      gap: 8px;
    }

    .tuner-inst-card svg {
      width: 30px;
      height: 30px;
    }

