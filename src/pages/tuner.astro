      max-width: 1080px;
      padding: 28px 32px 36px;
    }

    /* Main tuner view: topbar / meter | figure / footer via existing DOM order */
    .tuner-view {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 24px 48px;
      align-items: start;
    }

    .tuner-topbar,
    .tuner-footer-group {
      grid-column: 1 / -1;
    }

    .tuner-subbar {
      justify-content: space-between;
      gap: 16px;
    }

    .tuner-anchor-center {
      flex: 0 1 auto;
    }

    .tuner-anchor-center .tuner-pill {
      flex: none;
      width: auto;
    }

    .tuner-readout {
      align-self: center;
      gap: 14px;
    }

    /* Chromatic mode hides the figure — readout takes the full row */
    .tuner-view.mode-chromatic .tuner-readout {
      grid-column: 1 / -1;
    }

    .tuner-meter-btn {
      padding: 16px 22px;
    }

    .tuner-meter {
