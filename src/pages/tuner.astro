<script>
  import { initTheme } from '../scripts/controllers/themeController.js';
  initTheme();

  let controllerPromise: Promise<any> | null = null;
  let initialized = false;

  async function loadController() {
    if (!controllerPromise) controllerPromise = import('../scripts/controllers/tuner/index.js');
    return controllerPromise;
  }

  function start() {
    if (initialized) return;
    initialized = true;
    loadController()
      .then((mod) => mod.initTuner())
      .catch((err) => console.error('KINS Tuner failed to load:', err));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }

  document.addEventListener(
    'click',
    (e) => {
      if (initialized) return;
      const target = e.target as HTMLElement | null;
      const btn = target?.closest('button');
      if (!btn || !btn.dataset.track?.startsWith('tuner:')) return;
      start();
    },
    { passive: true }
  );
</script>

<script is:inline>
  (function initTunerFooterModalTriggers() {
    function handleFooterTriggerClick(e) {
      var target = e.target;
      if (!target || !target.closest) return;

      var suggestBtn = target.closest('#tunerOpenSuggestImprovementFooterBtn, #openSuggestImprovementFooterBtn, .open-feedback-trigger, [data-open-feedback]');
      if (suggestBtn) {
        e.preventDefault();
        e.stopPropagation();
        var feedbackModal = document.getElementById('feedbackModal');
        if (typeof window.openFeedbackModal === 'function') {
          var category = suggestBtn.getAttribute('data-feedback-category') || 'Tuner';
          window.openFeedbackModal(category);
        } else if (feedbackModal) {
          feedbackModal.classList.remove('hidden');
          document.body.classList.add('modal-open');
        }
        return;
      }

      var privacyBtn = target.closest('#tunerOpenPrivacyFooterBtn, #openPrivacyFooterBtn, .open-privacy-trigger');
      if (privacyBtn) {
        e.preventDefault();
        e.stopPropagation();
        var privacyModal = document.getElementById('privacyModal');
        if (typeof window.openPrivacyModal === 'function') {
          window.openPrivacyModal();
        } else if (privacyModal) {
          privacyModal.classList.remove('is-closing');
          privacyModal.classList.remove('hidden');
          document.body.classList.add('modal-open');
        }
        return;
      }

      var termsBtn = target.closest('#tunerOpenTermsFooterBtn, #openTermsFooterBtn, .open-terms-trigger');
      if (termsBtn) {
        e.preventDefault();
        e.stopPropagation();
        var termsModal = document.getElementById('termsModal');
        if (typeof window.openTermsModal === 'function') {
          window.openTermsModal();
        } else if (termsModal) {
          termsModal.classList.remove('is-closing');
          termsModal.classList.remove('hidden');
          document.body.classList.add('modal-open');
        }
        return;
      }
    }

    document.addEventListener('click', handleFooterTriggerClick, true);

    var yearEls = document.querySelectorAll('#copyrightYear, #tunerCopyrightYear, .footer-copyright-year');
    var curYear = new Date().getFullYear().toString();
    yearEls.forEach(function(el) {
      el.textContent = curYear;
    });
  })();
</script>
