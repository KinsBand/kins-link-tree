---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToastContainer from '../components/ui/ToastContainer.astro';
import FeedbackModal from '../components/modals/FeedbackModal.astro';
import PrivacyModal from '../components/modals/PrivacyModal.astro';
import TermsModal from '../components/modals/TermsModal.astro';
---

<BaseLayout
  title="KINS TUNER — Free Chromatic Tuner for Guitar, Bass & Drums"
  description="Free browser chromatic tuner by KINS. Guided and chromatic modes, a full tuning library for acoustic, electric and bass, drum-kit references, string-safety warnings and a studio-grade mic pitch detector. Audio never leaves your device."
>
  <main class="tuner-page">
    <div class="tuner-view" id="tunerView">
      <div class="tuner-topbar">
        <nav class="tuner-header-nav" aria-label="Tuner navigation">
          <a href="/" class="tuner-icon-btn tuner-icon-btn-back brutal-press" aria-label="Back to KINS home">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 3.5L6 10l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <button type="button" class="tuner-pill tuner-pill-tuning brutal-press" id="tunerPresetBtn" data-track="tuner:preset_open" aria-haspopup="dialog">
            <span class="tuner-pill-title">TUNER</span>
            <span class="tuner-pill-main">
              <span class="tuner-pill-label" id="tunerPresetLabel">Standard</span>
              <svg class="tuner-btn-caret" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </span>
          </button>
          <button type="button" class="tuner-icon-btn tuner-icon-btn-settings brutal-press" id="tunerSettingsBtn" data-track="tuner:settings_open" aria-label="Open tuner settings" aria-haspopup="dialog" aria-expanded="false">
            <i class="fa-solid fa-gear" aria-hidden="true"></i>
          </button>
        </nav>
        <!-- Legacy subbar kept hidden — controls now live in settings sheet (see plan) -->
        <div class="tuner-subbar" hidden aria-hidden="true">
          <div class="tuner-menu-anchor tuner-anchor-left">
            <button type="button" class="tuner-pill brutal-press" id="tunerModeBtn" data-track="tuner:mode_open" aria-haspopup="true" tabindex="-1">
              <span id="tunerModeLabel">GUIDED</span>
              <svg class="tuner-btn-caret" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
            <div id="tunerModeMenuSlot"></div>
          </div>
          <div class="tuner-menu-anchor tuner-anchor-center">
            <button type="button" class="tuner-pill brutal-press" id="tunerStringsBtn" data-track="tuner:strings_open" aria-haspopup="true" tabindex="-1">
              <span id="tunerStringsLabel">6 STRINGS</span>
              <svg class="tuner-btn-caret" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
            <div id="tunerStringsMenuSlot"></div>
          </div>
          <div class="tuner-menu-anchor tuner-anchor-right">
            <button type="button" class="tuner-pill brutal-press" id="tunerMaterialBtn" data-track="tuner:material_open" aria-haspopup="true" tabindex="-1">
              <span id="tunerMaterialLabel">STEEL</span>
              <svg class="tuner-btn-caret" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
            <div id="tunerMaterialMenuSlot"></div>
          </div>
        </div>
      </div>

      <section class="tuner-readout" id="tunerReadoutPanel" aria-label="Tuning meter">
        <button type="button" class="tuner-meter-btn brutal-press" id="tunerMicBtn" data-track="tuner:mic_start" aria-label="Start or stop mic tuning">
          <span class="tuner-meter" id="tunerMeter" aria-hidden="true">
            <span class="tuner-meter-ticks"></span>
            <span class="tuner-meter-zone"></span>
            <span class="tuner-meter-zone-safety zone-warn-up" id="tunerZoneWarnUp" hidden></span>
            <span class="tuner-meter-zone-safety zone-danger" id="tunerZoneDanger" hidden></span>
            <span class="tuner-meter-zone-safety zone-loose" id="tunerZoneLoose" hidden></span>
            <span class="tuner-meter-zone-safety zone-dead" id="tunerZoneDead" hidden></span>
            <div class="tuner-chromatic-rail" id="tunerChromRail" aria-hidden="true" hidden>
              <div class="tuner-chromatic-tape" id="tunerChromTape"></div>
            </div>
            <span class="tuner-needle" id="tunerNeedle"></span>
          </span>
        </button>
        <div class="tuner-badges">
          <span class="tuner-badge-side" id="tunerBadgeLow">TOO LOW</span>
          <span class="tuner-cents" id="tunerCentsReadout" aria-live="polite" aria-atomic="true">--</span>
          <span class="tuner-badge-side" id="tunerBadgeHigh">TOO HIGH</span>
        </div>
        <p class="tuner-status sr-only" id="tunerStatusLine" aria-live="polite">TAP TO START TUNING</p>
        <div class="tuner-note-row">
          <span class="tuner-note" id="tunerDetectedNote">--</span>
          <span class="tuner-note-octave" id="tunerDetectedNoteOctave"></span>
          <span class="tuner-note-freq" id="tunerDetectedFreq"></span>
        </div>
        <p class="tuner-hint" id="tunerDirectionHint" aria-live="polite"></p>
        <p class="tuner-warning" id="tunerMicWarning" hidden></p>
        <p class="tuner-low-mic-hint" id="tunerLowMicHint" hidden></p>
      </section>

      <div class="tuner-middle-scroll">
        <section class="tuner-figure" id="tunerFigure" aria-label="String and drum targets"></section>
      </div>

      <div class="tuner-footer-group">
        <button type="button" class="tuner-mic-cta brutal-press" id="tunerMicToggleBtn" data-track="tuner:mic_start" aria-label="Start tuning">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15.5a3.5 3.5 0 0 0 3.5-3.5V6a3.5 3.5 0 1 0-7 0v6a3.5 3.5 0 0 0 3.5 3.5z" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
          <span class="tuner-mic-cta-text">START TUNING</span>
        </button>
        <div class="tuner-instruments" id="tunerInstrumentRow" role="tablist" aria-label="Instrument">
          <button type="button" class="tuner-inst-card active brutal-press" role="tab" aria-selected="true" data-instrument="electric" data-track="tuner:tab_electric">
            <span class="tuner-inst-label">ELECTRIC</span>
            <svg viewBox="0 0 28 28" aria-hidden="true"><path d="M8 25c-3.5 0-5.5-2.6-5.5-5.4 0-2.4 1.6-3.8 3.2-5.1C7.4 13.1 8.6 11.8 8.6 10V4.5h4.8V10c0 1.8 1.2 3.1 2.9 4.5 1.6 1.3 3.2 2.7 3.2 5.1 0 2.8-2 5.4-5.5 5.4z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><path d="M11 2.5v4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
          </button>
          <button type="button" class="tuner-inst-card brutal-press" role="tab" aria-selected="false" data-instrument="acoustic" data-track="tuner:tab_acoustic">
            <span class="tuner-inst-label">ACOUSTIC</span>
            <svg viewBox="0 0 28 28" aria-hidden="true"><circle cx="14" cy="17" r="9" fill="none" stroke="currentColor" stroke-width="2.4"/><circle cx="14" cy="17" r="3.2" fill="currentColor"/><path d="M11.5 9.5 L12.5 2.5 M16.5 9.5 L15.5 2.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
          </button>
          <button type="button" class="tuner-inst-card brutal-press" role="tab" aria-selected="false" data-instrument="bass" data-track="tuner:tab_bass">
            <span class="tuner-inst-label">BASS</span>
            <svg viewBox="0 0 28 28" aria-hidden="true"><path d="M9 25.5c-3.2 0-5-2.4-5-5 0-2.2 1.4-3.4 2.9-4.6C8.4 14.7 9.5 13.5 9.5 12V6h4v6c0 1.5 1.1 2.7 2.6 3.9 1.5 1.2 2.9 2.4 2.9 4.6 0 2.6-1.8 5-5 5z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><path d="M11.5 2.5V6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><circle cx="13.5" cy="16.5" r="1.6" fill="currentColor"/></svg>
          </button>
          <button type="button" class="tuner-inst-card brutal-press" role="tab" aria-selected="false" data-instrument="drums" data-track="tuner:tab_drums">
            <span class="tuner-inst-label">DRUMS</span>
            <svg viewBox="0 0 28 28" aria-hidden="true"><circle cx="14" cy="17.5" r="7.5" fill="none" stroke="currentColor" stroke-width="2.4"/><circle cx="6.5" cy="9" r="3.4" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M21.5 5.5 L15 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
          </button>
        </div>

        <!-- bottom gear removed — single header gear controls sheet (kept hidden for legacy compat) -->
        <div class="tuner-bottom-settings" hidden aria-hidden="true">
          <button type="button" class="tuner-icon-btn brutal-press" id="tunerSettingsBtnBottom" aria-haspopup="dialog" aria-expanded="false" aria-label="Open tuner settings" data-track="tuner:settings_open" tabindex="-1">
            <i class="fa-solid fa-gear" aria-hidden="true"></i>
          </button>
        </div>

      </div>
    </div>

    <div class="tuner-sheet-backdrop" id="tunerSheetBackdrop" hidden></div>
    <div class="tuner-sheet" id="tunerSheet" role="dialog" aria-modal="true" tabindex="-1" hidden>
      <div class="tuner-sheet-handle" id="tunerSheetHandle" aria-hidden="true"></div>

      <section class="tuner-sheet-panel" id="tunerPanelSettings" hidden aria-label="Settings">
        <p class="tuner-sheet-title">SETTINGS</p>
        <button type="button" class="tuner-sheet-feedback-btn brutal-press" data-open-feedback data-feedback-category="Tuner" data-track="tuner:feedback_open" aria-haspopup="dialog" aria-label="Send feedback about the tuner">
          <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>
        </button>

        <p class="tuner-settings-label">INSTRUMENT</p>
        <div class="tuner-sheet-instruments" id="tunerSheetInstrumentRow" role="radiogroup" aria-label="Instrument"></div>

        <p class="tuner-settings-label">MODE</p>
        <div class="tuner-sheet-mode-row" id="tunerSheetModeRow" role="radiogroup" aria-label="Mode"></div>

        <p class="tuner-settings-label">SETUP</p>
        <div class="tuner-sheet-setup-row">
          <div class="tuner-sheet-setup-cell">
            <button type="button" class="tuner-sheet-setup-btn brutal-press" id="tunerSheetStringsBtn" aria-haspopup="true" aria-expanded="false">
              <span class="tuner-sheet-setup-label">STRINGS</span>
              <span class="tuner-sheet-setup-value" id="tunerSheetStringsLabel">6 STRINGS</span>
              <svg class="tuner-btn-caret" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
            <div id="tunerSheetStringsSlot" class="tuner-sheet-slot"></div>
          </div>
          <div class="tuner-sheet-setup-cell">
            <button type="button" class="tuner-sheet-setup-btn brutal-press" id="tunerSheetMaterialBtn" aria-haspopup="true" aria-expanded="false">
              <span class="tuner-sheet-setup-label">MATERIAL</span>
              <span class="tuner-sheet-setup-value" id="tunerSheetMaterialLabelSheet">STEEL</span>
              <svg class="tuner-btn-caret" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
            <div id="tunerSheetMaterialSlot" class="tuner-sheet-slot"></div>
          </div>
        </div>

        <!-- legacy containers kept hidden for compat (JS may still query) -->
        <div hidden aria-hidden="true">
          <div class="tuner-material-row" id="tunerSheetMaterialRow" role="radiogroup" aria-label="Material profile"></div>
          <div class="tuner-a4-row" id="tunerSheetA4Row" role="radiogroup" aria-label="A4 calibration"></div>
        </div>

        <p class="tuner-settings-label">TUNING BEHAVIOR</p>
        <div class="tuner-toggle-row">
          <label class="tuner-sheet-toggle">
            <input type="checkbox" id="tunerSheetAutoAdvance" />
            <span class="tuner-sheet-toggle-track" aria-hidden="true"><span class="tuner-sheet-toggle-knob"></span></span>
            <span class="tuner-sheet-toggle-text">AUTO-ADVANCE NEXT STRING</span>
          </label>
          <label class="tuner-sheet-toggle">
            <input type="checkbox" id="tunerSheetAutoId" />
            <span class="tuner-sheet-toggle-track" aria-hidden="true"><span class="tuner-sheet-toggle-knob"></span></span>
            <span class="tuner-sheet-toggle-text">AUTO STRING SELECT (FOLLOW PLUCK)</span>
          </label>
        </div>

        <div class="tuner-settings-copy-wrap">
          <button type="button" class="tuner-copy-link-card brutal-press" id="tunerCopyLinkBtn" aria-label="Copy Tuner link" data-track="tuner:copy_link">
            <div class="tuner-copy-link-left">
              <i class="fa-solid fa-link" aria-hidden="true"></i>
              <span class="tuner-copy-link-text">Share Tuner</span>
            </div>
            <span class="tuner-copy-badge" id="tunerCopyBadge">Copy</span>
          </button>
        </div>

        <div class="tuner-sheet-footer-card">
          <div class="footer-theme-toggle-wrap">
            <div class="footer-theme-toggle-btn" id="tunerThemeToggleBtn" role="group" aria-label="Toggle Display Theme" data-track="tuner:theme_toggle">
              <span class="theme-current-title" id="tunerThemeCurrentTitle">Light</span>
              <div class="theme-pill-segmented" role="radiogroup" aria-label="Select theme mode">
                <button type="button" class="theme-pill-btn active theme-pill-light" id="tunerThemePillLightBtn" data-theme-target="standard" aria-label="Light Mode" title="Switch to Light Mode">
                  <i class="fa-solid fa-sun" aria-hidden="true"></i>
                </button>
                <button type="button" class="theme-pill-btn theme-pill-dark" id="tunerThemePillDarkBtn" data-theme-target="dark" aria-label="Dark Mode" title="Switch to Dark Mode">
                  <i class="fa-solid fa-moon" aria-hidden="true"></i>
                </button>
              </div>
              <span class="theme-mode-label">Mode</span>
            </div>
          </div>

          <div class="footer-badge-row">
            <span class="footer-brand-badge">
              <i class="fa-solid fa-compact-disc footer-brand-icon"></i>
              <span class="footer-copyright-text">@<span id="tunerCopyrightYear">2026</span> KINS.</span>
            </span>
          </div>

          <nav class="footer-legal-links" aria-label="Legal & Feedback Links">
            <button type="button" id="tunerOpenPrivacyFooterBtn" class="footer-legal-btn open-privacy-trigger">Privacy Policy</button>
            <span class="legal-bullet" aria-hidden="true">•</span>
            <button type="button" id="tunerOpenSuggestImprovementFooterBtn" class="footer-legal-btn open-feedback-trigger" data-open-feedback data-feedback-category="Tuner">Suggest Improvement</button>
            <span class="legal-bullet" aria-hidden="true">•</span>
            <button type="button" id="tunerOpenTermsFooterBtn" class="footer-legal-btn open-terms-trigger">Fan Submission Terms</button>
          </nav>
        </div>
      </section>
    </div>

    <div class="tuning-view" id="tuningView" hidden>
      <div class="tuning-top-fixed">
        <header class="tuning-header">
          <button type="button" class="tuning-back-btn brutal-press" id="tunerBackToTunerBtn" aria-label="Back to Tuner">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 3.5L6 10l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>Back</span>
          </button>
          <h1 class="tuning-title">TUNING</h1>
          <div class="tuning-header-anchor">
            <button type="button" class="tuning-instrument-btn brutal-press" id="tunerInstrumentBtn" aria-haspopup="true">
              <span id="tunerInstrumentLabel">Electric</span>
              <svg class="tuning-caret" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div id="tunerInstrumentMenuSlot"></div>
          </div>
        </header>

        <section class="tuning-search-section" aria-label="Search and filter tunings">
          <div class="tuning-search-box">
            <svg class="tuning-search-icon" viewBox="0 0 20 20" aria-hidden="true">
              <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2.2"/>
              <path d="M12.5 12.5 L17 17" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
            </svg>
            <input type="search" id="tunerSearchInput" placeholder="Search tunings or notes (e.g. Drop D, Open G, DADGAD)..." autocomplete="off" enterkeyhint="search" />
            <button type="button" class="tuning-search-clear-btn" id="tunerSearchClearBtn" aria-label="Clear search" hidden>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
            </button>
          </div>
          <div class="tuning-filters" id="tunerFilterRow">
            <button type="button" class="tuning-filter-chip active brutal-press" data-filter="all">All</button>
            <button type="button" class="tuning-filter-chip brutal-press" data-filter="standard">Standard</button>
            <button type="button" class="tuning-filter-chip brutal-press" data-filter="drop">Drop</button>
            <button type="button" class="tuning-filter-chip brutal-press" data-filter="open">Open</button>
            <button type="button" class="tuning-filter-chip brutal-press" data-filter="artist">Artist</button>
          </div>
        </section>
      </div>

      <div class="tuning-list" id="tunerCategoryList"></div>

      <div class="tuning-bottom-fixed" hidden aria-hidden="true">
        <!-- A4 calibration removed — fixed 440 Hz (see tuner.config.ts) -->
        <div class="tuning-a4" hidden aria-hidden="true"><span class="tuning-a4-label">A4</span><div class="tuning-a4-chips" id="tunerA4Chips"></div></div>
      </div>
    </div>
  </main>

  <PrivacyModal />
  <TermsModal />
  <FeedbackModal />

  <ToastContainer />
</BaseLayout>

<style>
  .tuner-page {
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
    padding: 18px 16px 28px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: var(--bg-dark);
    background-image: var(--bg-dark-gradient);
    color: var(--text-white);
  }

  .tuner-view {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
  }

  .tuning-view {
    display: flex;
    flex-direction: column;
    gap: 0;
    flex: 1;
    min-height: 0;
    height: calc(100vh - 46px);
    height: calc(100dvh - 46px);
    max-height: calc(100vh - 46px);
    max-height: calc(100dvh - 46px);
    overflow: hidden;
  }

  .tuner-view[hidden],
  .tuning-view[hidden] {
    display: none;
  }

  /* ---------- Middle scroll area (meter + figure) ---------- */
  .tuner-middle-scroll {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  /* ---------- Top bar ---------- */
  .tuner-topbar {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .tuner-header-nav {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .tuner-icon-btn {
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-card);
    color: var(--text-white);
    border: var(--border-brutal-sm);
    box-shadow: var(--shadow-brutal-black);
    border-radius: var(--radius-pill);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    text-decoration: none;
    flex-shrink: 0;
    box-sizing: border-box;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }

  .tuner-icon-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: var(--shadow-brutal-black-lg);
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
  }

  .tuner-icon-btn svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .tuner-icon-btn-back svg {
    width: 16px;
    height: 16px;
  }

  .tuner-subbar {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .tuner-subbar[hidden],
  .tuner-bottom-settings[hidden],
  .tuning-a4[hidden] {
    display: none !important;
  }

  /* Legacy sheet rows kept hidden — A4 removed from UI (fixed 440 Hz) */
  .tuner-material-row[hidden],
  .tuner-a4-row[hidden] {
    display: none !important;
  }

  .tuner-menu-anchor {
    position: relative;
    display: inline-flex;
  }

  .tuner-menu-anchor.tuner-anchor-left,
  .tuner-menu-anchor.tuner-anchor-right {
    flex-shrink: 0;
  }

  .tuner-menu-anchor.tuner-anchor-center {
    flex: 1 1 0;
    min-width: 0;
  }

  .tuner-menu-anchor.tuner-anchor-center .tuner-pill {
    flex: 1;
    width: 100%;
    justify-content: center;
  }

  .tuner-menu-anchor:has(> .tuner-pill[hidden]) {
    display: none;
  }

  .tuner-anchor-left :global(.tuner-menu-panel) {
    left: 0;
    right: auto;
  }

  .tuner-anchor-center :global(.tuner-menu-panel) {
    left: 50%;
    transform: translateX(-50%);
    right: auto;
  }

  .tuner-anchor-right :global(.tuner-menu-panel) {
    right: 0;
    left: auto;
  }

  .tuner-pill {
    background: var(--surface-card);
    color: var(--text-white);
    border: var(--border-brutal-sm);
    box-shadow: var(--shadow-brutal-black);
    border-radius: var(--radius-pill);
    padding: 10px 16px;
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  .tuner-pill:hover {
    transform: translate(-1px, -1px);
    box-shadow: var(--shadow-brutal-black-lg);
  }

  .tuner-pill-tuning {
    flex: 1 1 0;
    min-width: 0;
    width: auto;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 7px 16px 8px;
    box-sizing: border-box;
    gap: 1px;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease, flex-basis 0.22s var(--ease-snappy);
  }

  /* Smooth inward curve bridges the gap between back and settings icons:
     pill visually expands into the header's middle space without layout jank.
     No width/height anim — only flex + transform/opacity per perf rules. */
  .tuner-pill-tuning:hover {
    transform: translate(-1px, -1px);
  }

  .tuner-pill-title {
    font-family: var(--font-secondary);
    font-size: 0.58rem;
    font-weight: 900;
    letter-spacing: 0.22em;
    line-height: 1;
    color: var(--text-muted);
  }

  .tuner-pill-main {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
  }

  .tuner-pill-tuning .tuner-pill-label {
    font-family: var(--font-heading);
    font-size: clamp(0.86rem, 3.4vw, 1.14rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .tuner-sliders-icon {
    width: 18px;
    height: 18px;
    color: var(--accent-neon-yellow);
    flex-shrink: 0;
    margin-left: 8px;
  }

  .tuner-btn-caret {
    width: 12px;
    height: 12px;
    opacity: 0.75;
  }

  .tuner-pill.off {
    color: var(--text-muted);
    border-style: dashed;
  }

  /* ---------- Meter ---------- */
  .tuner-readout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .tuner-meter-btn {
    width: 100%;
    background: var(--surface-card);
    border: var(--border-brutal);
    box-shadow: var(--shadow-brutal-black-lg);
    border-radius: var(--radius-pill);
    padding: 14px 18px;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, border-color 0.16s ease;
  }

  .tuner-meter-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0px #000000;
  }

  .tuner-meter-btn.listening {
    border-color: var(--accent-neon-yellow);
  }

  .tuner-meter {
    position: relative;
    display: block;
    width: 100%;
    height: 34px;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.55);
    overflow: hidden;
  }

  .tuner-meter-ticks {
    position: absolute;
    inset: 6px 18px;
    background-image: repeating-linear-gradient(
      to right,
      rgba(245, 244, 239, 0.28) 0 2px,
      transparent 2px calc((100% - 2px) / 12)
    );
    background-size: calc(100% - 2px) 100%;
    background-repeat: no-repeat;
  }

  .tuner-meter-zone {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 12%;
    transform: translateX(-50%);
    background: rgba(242, 253, 67, 0.16);
    border-left: 2px solid rgba(242, 253, 67, 0.5);
    border-right: 2px solid rgba(242, 253, 67, 0.5);
  }

  /* Breakage (sharp side) and looseness (flat side) highlight sections.
     Positioned by the controller from the active material profile; they sit
     on the log-compressed ends of the meter scale. */
  .tuner-meter-zone-safety {
    position: absolute;
    top: 0;
    bottom: 0;
    pointer-events: none;
    transition: background-color 0.16s ease;
  }

  .tuner-meter-zone-safety.zone-warn-up {
    background: rgba(220, 42, 60, 0.14);
    border-left: 2px solid rgba(220, 42, 60, 0.55);
  }

  .tuner-meter-zone-safety.zone-danger {
    background: rgba(220, 42, 60, 0.32);
    border-left: 2px solid var(--accent-crimson);
  }

  .tuner-meter-zone-safety.zone-loose {
    background: rgba(83, 252, 24, 0.1);
    border-right: 2px solid rgba(83, 252, 24, 0.45);
  }

  .tuner-meter-zone-safety.zone-dead {
    background: rgba(83, 252, 24, 0.22);
    border-right: 2px solid var(--btn-green);
  }

  .tuner-needle {
    position: absolute;
    left: 50%;
    top: 5px;
    bottom: 5px;
    width: 5px;
    margin-left: -2.5px;
    border-radius: 3px;
    background: var(--surface-card-light);
    transform: translateX(0px);
    transition: transform 0.09s linear, background-color 0.16s ease, opacity 0.3s ease;
    will-change: transform;
  }

  .tuner-readout.safety-red .tuner-needle,
  .tuner-readout.safety-red-soft .tuner-needle {
    background: var(--accent-crimson);
  }

  .tuner-readout.safety-green .tuner-needle,
  .tuner-readout.safety-green-soft .tuner-needle {
    background: var(--btn-green);
  }

  .tuner-readout.in-tune .tuner-needle {
    background: var(--btn-green);
  }

  /* ---------- Badges + cents readout ---------- */
  .tuner-badges {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 8px;
    width: 100%;
  }

  .tuner-badge-side {
    font-family: var(--font-secondary);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    background: var(--surface-card);
    border: 2px solid rgba(0, 0, 0, 0.85);
    border-radius: var(--radius-pill);
    padding: 5px 10px;
    justify-self: start;
    white-space: nowrap;
  }

  .tuner-badge-side#tunerBadgeHigh {
    justify-self: end;
  }

  .tuner-cents {
    justify-self: center;
    min-width: 64px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    background: var(--surface-card);
    border: 2px solid rgba(0, 0, 0, 0.85);
    border-radius: var(--radius-pill);
    padding: 5px 12px;
    font-variant-numeric: tabular-nums;
    box-sizing: border-box;
    transition: color 0.16s ease, border-color 0.16s ease, background-color 0.16s ease;
  }

  .tuner-cents.is-in-tune {
    color: var(--btn-green);
    border-color: var(--btn-green);
  }

  .tuner-cents.is-flat,
  .tuner-cents.is-sharp {
    color: var(--text-white);
  }

  .tuner-readout.safety-red .tuner-cents,
  .tuner-readout.safety-red-soft .tuner-cents {
    color: var(--accent-crimson);
    border-color: var(--accent-crimson);
  }

  .tuner-readout.safety-green .tuner-cents,
  .tuner-readout.safety-green-soft .tuner-cents {
    color: var(--btn-green);
    border-color: var(--btn-green);
  }

  .tuner-readout.in-tune .tuner-cents {
    color: var(--btn-green);
    border-color: var(--btn-green);
  }

  /* Hidden status element retained for JS compat + a11y live region */
  .tuner-status.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .tuner-status {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    border-radius: var(--radius-pill);
    padding: 6px 16px;
    margin: 0;
    text-align: center;
    min-height: 1.5em;
    box-sizing: border-box;
    transition: background-color 0.16s ease, color 0.16s ease;
  }

  .tuner-status.pill-cta {
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: var(--shadow-brutal-black);
  }

  .tuner-status.pill-neutral {
    background: var(--surface-card);
    color: var(--text-white);
    border: 2px solid rgba(0, 0, 0, 0.85);
  }

  .tuner-status.pill-off {
    background: var(--surface-card);
    color: var(--text-white);
    border: 2px solid rgba(0, 0, 0, 0.85);
  }

  .tuner-status.pill-tuned {
    background: var(--btn-green);
    color: var(--btn-text-color);
    border: 2px solid #000000;
    box-shadow: var(--shadow-brutal-black);
  }

  .tuner-readout.safety-red .tuner-status,
  .tuner-readout.safety-red-soft .tuner-status {
    border-color: var(--accent-crimson);
    color: var(--accent-crimson);
  }

  .tuner-readout.safety-green .tuner-status,
  .tuner-readout.safety-green-soft .tuner-status {
    border-color: var(--btn-green);
    color: var(--btn-green);
  }

  /* ---------- Chromatic free-mode note rail (inside meter pill) ---------- */
  .tuner-view.mode-chromatic .tuner-meter-ticks,
  .tuner-view.mode-chromatic .tuner-meter-zone,
  .tuner-view.mode-chromatic .tuner-meter-zone-safety {
    display: none !important;
  }

  .tuner-chromatic-rail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    pointer-events: none;
    border-radius: var(--radius-pill);
    box-sizing: border-box;
  }

  .tuner-view.mode-chromatic .tuner-chromatic-rail:not([hidden]) {
    display: flex;
  }

  .tuner-chromatic-tape {
    display: flex;
    align-items: center;
    height: 100%;
    will-change: transform;
    transition: transform 0.08s linear;
  }

  .tuner-chromatic-rail :global(.rail-note) {
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    gap: 1px;
    width: 56px;
    min-width: 56px;
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--text-white);
    padding: 3px 0;
    border-radius: 999px;
    border: 2px solid transparent;
    opacity: 0.35;
    transition: opacity 0.12s linear, background-color 0.12s ease, color 0.12s ease, border-color 0.12s ease, transform 0.12s ease;
  }

  .tuner-chromatic-rail :global(.rail-note-octave) {
    font-size: 0.62rem;
    font-weight: 700;
    opacity: 0.75;
  }

  .tuner-chromatic-rail :global(.rail-note.is-near) {
    opacity: 0.85;
  }

  .tuner-chromatic-rail :global(.rail-note.active),
  .tuner-chromatic-rail :global(.rail-note.is-exact) {
    opacity: 1;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: var(--shadow-brutal-black-sm);
    transform: scale(1.06);
  }

  .tuner-chromatic-rail :global(.rail-note.active .rail-note-octave),
  .tuner-chromatic-rail :global(.rail-note.is-exact .rail-note-octave) {
    color: #000000;
    opacity: 0.9;
  }

  .tuner-view.mode-chromatic .tuner-needle {
    width: 4px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--accent-neon-yellow);
    box-shadow: 0 0 4px rgba(242, 253, 67, 0.4);
    z-index: 2;
  }

  .tuner-view.mode-chromatic .tuner-readout.in-tune .tuner-needle {
    background: var(--btn-green);
    box-shadow: 0 0 8px var(--btn-green);
  }

  /* ---------- Latched reading: keep the last identified note visibly held
     between plucks instead of blanking. A subtle dim + steady pulse signals
     "remembered" without the previous 0.45 washout that read as vanishing. */
  .tuner-note-row,
  .tuner-hint,
  .tuner-needle {
    transition: opacity 0.28s ease;
  }

  .tuner-readout.is-held .tuner-note-row,
  .tuner-readout.is-held .tuner-hint {
    opacity: 0.86;
  }

  .tuner-readout.is-held .tuner-needle {
    opacity: 0.82;
  }

  /* ---------- Note row ---------- */
  .tuner-note-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 8px;
    min-height: 56px;
  }

  .tuner-note {
    font-family: var(--font-heading);
    font-size: clamp(2.6rem, 11vw, 3.6rem);
    font-weight: 800;
    line-height: 1;
    color: var(--text-white);
    font-variant-numeric: tabular-nums;
  }

  .tuner-note-octave {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--accent-neon-yellow);
  }

  .tuner-note-freq {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .tuner-hint {
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--accent-neon-yellow);
    margin: 0;
    min-height: 1.2em;
  }

  .tuner-warning {
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.45;
    color: var(--text-white);
    background: var(--accent-crimson);
    border: var(--border-brutal-sm);
    box-shadow: var(--shadow-brutal-black);
    border-radius: var(--radius-xs);
    padding: 10px 12px;
    margin: 0;
  }

  .tuner-low-mic-hint {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--text-muted);
    background: rgba(0, 0, 0, 0.35);
    border-radius: var(--radius-xs);
    padding: 8px 10px;
    margin: 0;
    max-width: 52ch;
    text-align: center;
  }

  /* ---------- Figure (headstock / drums) — fills negative space ---------- */
  .tuner-figure {
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 1 1 auto;
    min-height: 220px;
    min-width: 0;
    width: 100%;
    height: 100%;
    max-height: none;
  }

  .tuner-figure :global(svg) {
    width: 100%;
    max-width: 560px;
    height: auto;
    max-height: min(520px, 56dvh);
    flex: 1 1 auto;
  }

  .tuner-middle-scroll {
    flex: 1 1 auto;
    min-height: 180px;
  }

  /* ---------- Instrument cards ---------- */
  .tuner-instruments {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .tuner-inst-card {
    background: var(--surface-card);
    border: var(--border-brutal-sm);
    box-shadow: var(--shadow-brutal-black);
    border-radius: var(--radius-md);
    padding: 10px 4px 12px;
    color: var(--text-white);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  .tuner-inst-card:hover {
    transform: translate(-1px, -1px);
    box-shadow: var(--shadow-brutal-black-lg);
  }

  .tuner-inst-card.active {
    background: var(--accent-neon-yellow);
    color: #000000;
  }

  .tuner-inst-label {
    font-family: var(--font-secondary);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .tuner-inst-card svg {
    width: 26px;
    height: 26px;
  }

  /* ---------- Mic start/stop CTA (above instrument cards) ---------- */
  .tuner-mic-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: calc(50% - 4px);
    margin-left: auto;
    margin-right: auto;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: var(--border-brutal);
    box-shadow: var(--shadow-brutal-black-lg);
    border-radius: var(--radius-pill);
    padding: 14px 18px;
    font-family: var(--font-secondary);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    box-sizing: border-box;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  .tuner-mic-cta:hover {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0px #000000;
  }

  .tuner-mic-cta.listening {
    background: var(--btn-green);
  }

  .tuner-mic-cta svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  /* ---------- Footer group ---------- */
  .tuner-footer-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: auto;
    width: 100%;
  }

  .tuner-bottom-settings {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding-top: 2px;
  }

  .tuner-bottom-settings .tuner-icon-btn {
    width: 46px;
    height: 46px;
    min-width: 46px;
    min-height: 46px;
    font-size: 1rem;
  }

  /* Legacy: bottom Back to KINS pill removed — keep selector hidden for any cached HTML */
  .tuner-back-pill {
    display: none !important;
  }

  /* ---------- Chromatic mode ---------- */
  .tuner-view.mode-chromatic .tuner-figure,
  .tuner-view.mode-chromatic .tuner-badges {
    display: none;
  }

  /* ---------- Tuner settings bottom sheet — mirrors metronome sheet ---------- */
  .tuner-sheet-backdrop {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(0, 0, 0, 0.62);
    opacity: 0;
    transition: opacity 0.22s ease;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  .tuner-sheet-backdrop.open {
    opacity: 1;
  }

  .tuner-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 61;
    max-height: 78vh;
    max-height: 78dvh;
    display: flex;
    flex-direction: column;
    background: #141418;
    color: #f5f5f7;
    border: 3px solid #000000;
    border-bottom: none;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    padding: 36px 18px calc(18px + env(safe-area-inset-bottom));
    transform: translateY(102%);
    transition: transform 0.24s var(--ease-snappy);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    outline: none;
    box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.6);
  }

  .tuner-sheet.open {
    transform: translateY(0);
  }

  .tuner-sheet.dragging {
    transition: none;
  }

  .tuner-sheet-handle {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    flex-shrink: 0;
    z-index: 2;
  }

  .tuner-sheet-handle::before {
    content: "";
    width: 36px;
    height: 4px;
    border-radius: 999px;
    background: #2a2a30;
    position: static;
  }

  .tuner-sheet-panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .tuner-sheet-title {
    position: absolute;
    top: 12px;
    left: 18px;
    margin: 0;
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.24em;
    text-align: left;
    color: #a1a1aa;
    line-height: 1;
    z-index: 1;
    pointer-events: none;
  }

  .tuner-sheet-feedback-btn {
    position: absolute;
    top: 6px;
    right: 14px;
    z-index: 3;
    width: 26px;
    height: 26px;
    min-width: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: #1e1e24;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-pill);
    font-size: 0.72rem;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  .tuner-sheet-feedback-btn:hover {
    transform: translate(-1px, -1px);
    background: var(--accent-neon-yellow);
    color: #000000;
    box-shadow: 3px 3px 0px #000000;
  }

  .tuner-sheet-feedback-btn:focus-visible {
    outline: 2px solid var(--accent-neon-yellow);
    outline-offset: 2px;
  }

  .tuner-settings-label {
    margin: 4px 0 0;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    color: #a1a1aa;
  }

  .tuner-sheet-instruments {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .tuner-sheet-mode-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .tuner-sheet-setup-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .tuner-sheet-setup-cell {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .tuner-sheet-setup-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    width: 100%;
    padding: 10px 12px;
    background: #1e1e24;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
    box-sizing: border-box;
  }

  .tuner-sheet-setup-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #25252e;
  }

  .tuner-sheet-setup-btn[aria-expanded="true"] {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .tuner-sheet-setup-btn[aria-expanded="true"] .tuner-sheet-setup-label {
    color: rgba(0,0,0,0.62);
  }

  .tuner-sheet-setup-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    transform: none;
    box-shadow: 2px 2px 0px #000000;
  }

  .tuner-sheet-setup-label {
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    color: #a1a1aa;
  }

  .tuner-sheet-setup-value {
    flex: 1;
    text-align: center;
    font-size: 0.8rem;
  }

  .tuner-sheet-slot {
    position: relative;
  }

  /* Sheet dropdowns open downward inside the sheet to avoid clipping at the top;
     spec "open a menu up" = sheet itself slides up, dropdowns stay in-flow. For the
     requested upward behaviour, flip to bottom when near sheet top via JS if needed.
     Using in-flow static panel keeps it scrollable and not clipped by sheet's
     overflow. */
  .tuner-sheet-slot :global(.tuner-menu-panel) {
    position: static;
    width: 100%;
    min-width: 0;
    margin-top: 8px;
    z-index: 75;
    max-height: min(340px, 42dvh);
    box-shadow: 4px 4px 0px #000000;
    animation: tuner-sheet-menu-in 0.18s var(--ease-snappy);
  }

  /* Upward variant — toggled via .is-up on the panel when JS detects top collision */
  .tuner-sheet-slot :global(.tuner-menu-panel.is-up) {
    position: absolute;
    bottom: calc(100% + 8px);
    top: auto;
    left: 0;
    right: 0;
    margin-top: 0;
  }

  .tuner-sheet-setup-cell:has(> .tuner-sheet-slot:not(:empty)) {
    z-index: 2;
  }

  @keyframes tuner-sheet-menu-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .tuner-material-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .tuner-a4-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  :global(.tuner-sheet-chip) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 8px;
    background: #1e1e24;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  :global(.tuner-sheet-chip:hover) {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #25252e;
  }

  :global(.tuner-sheet-chip.active) {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
  }

  :global(.tuner-sheet-chip:focus-visible) {
    outline: 2px solid var(--accent-neon-yellow);
    outline-offset: 2px;
  }

  .tuner-toggle-row {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 4px;
  }

  .tuner-sheet-toggle {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
  }

  .tuner-sheet-toggle input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .tuner-sheet-toggle-track {
    display: inline-flex;
    align-items: center;
    width: 46px;
    height: 26px;
    flex-shrink: 0;
    padding: 2px;
    box-sizing: border-box;
    background: #1e1e24;
    border: 2px solid #000000;
    border-radius: var(--radius-pill);
    transition: background-color 0.16s ease, border-color 0.16s ease;
  }

  :global(.tuner-sheet-toggle-knob) {
    display: inline-block;
    width: 18px;
    height: 18px;
    background: #71717a;
    border-radius: 50%;
    transform: translateX(0);
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .tuner-sheet-toggle input:checked + .tuner-sheet-toggle-track {
    background: var(--accent-neon-yellow);
    border-color: #000000;
  }

  .tuner-sheet-toggle input:checked + .tuner-sheet-toggle-track :global(.tuner-sheet-toggle-knob) {
    transform: translateX(20px);
    background: #000000;
  }

  .tuner-sheet-toggle input:focus-visible + .tuner-sheet-toggle-track {
    outline: 2px solid var(--accent-neon-yellow);
    outline-offset: 2px;
  }

  .tuner-sheet-toggle-text {
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #f5f5f7;
  }

  .tuner-settings-copy-wrap {
    margin-top: 8px;
    padding-top: 12px;
    border-top: 2px solid rgba(255, 255, 255, 0.08);
  }

  .tuner-copy-link-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 12px 14px;
    background: #1e1e24;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: var(--radius-md);
    font-family: var(--font-secondary);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease;
  }

  .tuner-copy-link-card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #25252e;
  }

  .tuner-copy-link-left {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .tuner-copy-link-left i {
    color: var(--accent-neon-yellow);
    font-size: 1rem;
  }

  .tuner-copy-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 14px;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 1px 1px 0px #000000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    transition: background-color 0.16s ease, color 0.16s ease, transform 0.16s ease;
  }

  .tuner-copy-badge.copied {
    background: var(--btn-green);
    color: #000000;
  }

  /* ---------- Sheet Footer Card: Theme Toggle & Legal Links ---------- */
  .tuner-sheet-footer-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    margin-top: 4px;
    padding-top: 12px;
    border-top: 2px solid rgba(255, 255, 255, 0.08);
    text-align: center;
    box-sizing: border-box;
  }

  .footer-badge-row {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer-brand-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    background: #18181b;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    padding: 5px 14px;
    border-radius: 6px;
    user-select: none;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .footer-brand-badge:hover {
    background: #27272a;
    transform: translateY(-1px);
  }

  .footer-brand-icon {
    font-size: 0.8rem;
    color: var(--accent-neon-yellow);
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px 10px;
    max-width: 100%;
    margin: 0 auto;
  }

  .footer-legal-btn {
    background: transparent;
    border: none;
    color: #a1a1aa;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 4px 8px;
    border-radius: 4px;
    text-decoration: none;
    transition: color 0.16s ease, background-color 0.16s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    user-select: none;
  }

  .footer-legal-btn:hover,
  .footer-legal-btn:focus-visible {
    color: var(--accent-neon-yellow);
    background: rgba(255, 255, 255, 0.08);
    outline: none;
  }

  .legal-bullet {
    color: rgba(255, 255, 255, 0.25);
    font-size: 0.7rem;
    flex-shrink: 0;
    user-select: none;
  }

  @media (max-width: 480px) {
    .footer-legal-links {
      gap: 4px 8px;
    }
    .footer-legal-btn {
      font-size: 0.68rem;
      padding: 3px 6px;
    }
  }

  .footer-theme-toggle-wrap {
    width: 100%;
  }

  .footer-theme-toggle-btn {
    width: 100%;
    min-height: 48px;
    background: var(--surface-card-light);
    color: var(--text-card-primary);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 8px;
    padding: 6px 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    user-select: none;
    box-sizing: border-box;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
  }

  .footer-theme-toggle-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px #000000;
  }

  .footer-theme-toggle-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .theme-current-title {
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.92rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-card-primary);
    flex: 1 1 0;
    text-align: left;
  }

  .theme-pill-segmented {
    display: inline-flex;
    align-items: center;
    background: var(--surface-input);
    border: 2px solid #000000;
    border-radius: 20px;
    padding: 3px;
    gap: 3px;
    box-shadow: 1.5px 1.5px 0px #000000;
    flex: 0 0 auto;
  }

  .theme-pill-btn {
    width: 30px;
    height: 30px;
    min-width: 30px;
    min-height: 30px;
    border-radius: 50%;
    border: 1.5px solid transparent;
    background: transparent;
    color: var(--text-card-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    margin: 0;
    font-size: 0.82rem;
    transition: transform 0.16s var(--ease-tactile), background-color 0.18s ease, color 0.18s ease, box-shadow 0.16s ease;
  }

  .theme-pill-btn:hover {
    color: var(--text-card-primary);
    transform: scale(1.1);
  }

  .theme-pill-btn.active {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
    box-shadow: 1px 1px 0px #000000;
    transform: scale(1.06);
  }

  .theme-mode-label {
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-card-secondary);
    flex: 1 1 0;
    text-align: right;
  }

  .tuner-sheet[hidden],
  .tuner-sheet-backdrop[hidden],
  .tuner-sheet-panel[hidden] {
    display: none !important;
  }

  /* ---------- Tuning view — fixed header + filters top ---------- */
  .tuning-top-fixed {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    padding: 6px 0 12px;
    background-color: var(--bg-dark);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .tuning-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px;
    padding: 2px 0;
    width: 100%;
  }

  .tuning-back-btn {
    background: var(--surface-card);
    border: var(--border-brutal-sm);
    box-shadow: var(--shadow-brutal-black);
    border-radius: var(--radius-pill);
    color: var(--text-white);
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    white-space: nowrap;
    justify-self: start;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }

  .tuning-back-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: var(--shadow-brutal-black-lg);
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
  }

  .tuning-back-btn svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .tuning-title {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 4.5vw, 1.6rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
    color: var(--text-white);
    line-height: 1.1;
    text-align: center;
    justify-self: center;
    white-space: nowrap;
  }

  .tuning-header-anchor {
    position: relative;
    display: inline-flex;
    justify-self: end;
    justify-content: flex-end;
    flex-shrink: 0;
  }

  .tuning-header-anchor :global(.tuner-menu-panel) {
    left: auto;
    right: 0;
    transform: none;
  }

  .tuning-instrument-btn {
    background: var(--surface-card);
    border: var(--border-brutal-sm);
    box-shadow: var(--shadow-brutal-black);
    border-radius: var(--radius-pill);
    color: var(--accent-neon-yellow);
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  .tuning-instrument-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: var(--shadow-brutal-black-lg);
    color: var(--text-white);
  }

  .tuning-caret {
    width: 15px;
    height: 15px;
    transition: transform 0.2s var(--ease-tactile);
  }

  /* ---------- Tuning Search & Filters (inside fixed top) ---------- */
  .tuning-search-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .tuning-search-box {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    background: var(--surface-card);
    border: var(--border-brutal-sm);
    box-shadow: var(--shadow-brutal-black);
    border-radius: var(--radius-pill);
    padding: 10px 16px;
    color: var(--text-white);
    box-sizing: border-box;
    transition: transform 0.16s var(--ease-tactile), border-color 0.16s ease, box-shadow 0.16s ease;
  }

  .tuning-search-box:focus-within {
    border-color: var(--accent-neon-yellow);
    box-shadow: var(--shadow-brutal-black-lg);
  }

  .tuning-search-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--accent-neon-yellow);
  }

  .tuning-search-box input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--font-secondary);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-white);
    height: 100%;
  }

  .tuning-search-box input::placeholder {
    color: var(--text-muted);
    font-weight: 500;
  }

  .tuning-search-clear-btn {
    background: transparent;
    border: none;
    padding: 4px;
    cursor: pointer;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0.8;
    transition: opacity 0.14s ease, color 0.14s ease;
  }

  .tuning-search-clear-btn:hover {
    opacity: 1;
    color: var(--accent-neon-yellow);
  }

  .tuning-search-clear-btn svg {
    width: 15px;
    height: 15px;
  }

  .tuning-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    width: 100%;
  }

  .tuning-filter-chip {
    background: var(--surface-card);
    border: 2px solid rgba(0, 0, 0, 0.85);
    border-radius: var(--radius-pill);
    padding: 5px 12px;
    color: var(--text-muted);
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 0.16s ease, color 0.16s ease, border-color 0.16s ease;
  }

  .tuning-filter-chip:hover {
    color: var(--text-white);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .tuning-filter-chip.active {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
  }

  /* ---------- Tuning list — scrollable middle ---------- */
  .tuning-list {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    padding: 4px 2px calc(16px + env(safe-area-inset-bottom, 0px)) 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ---------- Tuning bottom (legacy A4 container) ---------- */
  .tuning-bottom-fixed[hidden] {
    display: none !important;
  }

  /* ---------- Mobile app-shell layout ----------
     Page locks to the dynamic viewport so the whole document never scrolls;
     each view pins its own top bar / bottom controls and scrolls only its
     middle content (meter+figure / tuning list).
     Footer polish: with Back pill removed, instrument row + CTA must stay
     pinned without extra scroll. Tighten vertical rhythm for sub-700px heights. */
  @media (max-width: 768px) {
    .tuner-page {
      height: 100vh;
      height: 100dvh;
      min-height: 100vh;
      min-height: 100dvh;
      max-height: 100vh;
      max-height: 100dvh;
      padding: 12px 14px calc(10px + env(safe-area-inset-bottom, 0px));
      overflow: hidden;
    }

    /* Fill the locked page instead of the old calc(100dvh - 46px) math */
    .tuner-view,
    .tuning-view {
      height: auto;
      min-height: 0;
      max-height: none;
    }

    .tuner-view {
      gap: 8px;
      overflow: hidden;
    }

    .tuner-topbar,
    .tuner-readout {
