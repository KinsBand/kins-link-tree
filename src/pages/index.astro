---
import BaseLayout from '../layouts/BaseLayout.astro';

// Section Components
import HeroBanner from '../components/sections/HeroBanner.astro';
import ProfileSection from '../components/sections/ProfileSection.astro';
import HeroFeatureCard from '../components/sections/HeroFeatureCard.astro';
import TabbedLinks from '../components/sections/TabbedLinks.astro';
import MembersSection from '../components/sections/MembersSection.astro';
import KinsCrewSpotlight from '../components/sections/KinsCrewSpotlight.astro';
import MerchSection from '../components/sections/MerchSection.astro';
import InspirationVault from '../components/sections/InspirationVault.astro';
import KinsToolsSection from '../components/sections/KinsToolsSection.astro';
import SubscribeSection from '../components/sections/SubscribeSection.astro';

// Navigation Components
import TopNav from '../components/navigation/TopNav.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';

// Modal Components
import ShareModal from '../components/modals/ShareModal.astro';
import GigMapSheet from '../components/modals/GigMapSheet.astro';
import CoversSearchOverlay from '../components/modals/CoversSearchOverlay.astro';
import CoverVideoModal from '../components/modals/CoverVideoModal.astro';
import CommunitySubmissionModal from '../components/modals/CommunitySubmissionModal.astro';
import LegalModal from '../components/modals/LegalModal.astro';
import FeedbackModal from '../components/modals/FeedbackModal.astro';
import LiveUploadModal from '../components/live/LiveUploadModal.astro';

// UI Components
import AudioPlayer from '../components/ui/AudioPlayer.astro';
import ToastContainer from '../components/ui/ToastContainer.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Kins | Official Link in Bio">
  <div class="app-wrapper">
    <div class="site-container" id="siteContainer">
      <!-- Fixed Left Sidebar for Desktop / Top Portion for Mobile -->
      <TopNav />

      <!-- Fixed Left Sidebar for Desktop / Top Portion for Mobile -->
      <aside class="left-sidebar" id="leftSidebar">
        <HeroBanner />
        <ProfileSection />
        <HeroFeatureCard />
        <TabbedLinks />
        <SubscribeSection />
      </aside>

      <!-- Scrollable Right Main View for Desktop / Bottom Portion for Mobile -->
      <main class="right-main-content" id="rightMainContent">
        <MembersSection />
        <KinsCrewSpotlight />
        <MerchSection />
        <InspirationVault />
        <KinsToolsSection />

        <SiteFooter />
      </main>
    </div>
  </div>

  <CoversSearchOverlay />
  <CoverVideoModal />
  <CommunitySubmissionModal />
  <LiveUploadModal />
  <LegalModal />
  <FeedbackModal />
  <ShareModal />
  <GigMapSheet />
  <AudioPlayer />
  <ToastContainer />
</BaseLayout>

<style>
  .app-wrapper {
    width: 100%;
    min-height: 100vh;
    display: flex;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
    background-color: var(--bg-chalkboard);
    background-image: 
      radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.04) 0%, transparent 70%),
      radial-gradient(circle at 100% 100%, rgba(242, 253, 67, 0.03) 0%, transparent 60%);
  }

  .site-container {
    width: 100%;
    max-width: 100%;
    position: relative;
    z-index: 2;
  }

  /* Split Viewport (≥ 768px): Fullscreen Split with Fluid Left Sidebar & Right Main Content */
  @media (min-width: 768px) {
    .app-wrapper {
      padding: 0;
      margin: 0;
      width: 100%;
      min-height: 100vh;
    }

    .site-container {
      width: 100%;
      max-width: 100%;
      min-height: 100vh;
      display: flex;
      background: transparent;
      box-shadow: none;
      border: none;
      border-radius: 0;
    }

    /* Fixed Left Sidebar - Fluid clamp scaling, spans height below fixed top header */
    .left-sidebar {
      position: fixed;
      top: 64px;
      left: 0;
      width: clamp(300px, 30vw, 420px);
      height: calc(100vh - 64px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 24px 20px 90px;
      background: #141416;
      border-right: 3px solid #000000;
      box-shadow: 4px 0 0px #000000;
      display: flex;
      flex-direction: column;
      gap: 16px;
      z-index: 100;
      box-sizing: border-box;
    }

    /* Scrollable Right Main Content - Fills remaining width, offset below top header */
    .right-main-content {
      margin-top: 64px;
      margin-left: clamp(300px, 30vw, 420px);
      width: calc(100% - clamp(300px, 30vw, 420px));
      min-height: calc(100vh - 64px);
      display: flex;
      flex-direction: column;
      gap: 28px;
      padding: 28px 36px 120px;
      background: #18181b;
      box-sizing: border-box;
      transform: translateZ(0);
    }
  }

  /* Ultra-wide Displays (≥ 1400px): Expand right padding */
  @media (min-width: 1400px) {
    .right-main-content {
      padding: 36px 60px 120px;
    }
  }

  /* Mobile Stacked Edge-to-Edge View (< 768px) */
  @media (max-width: 767px) {
    .app-wrapper {
      padding: 0;
      margin: 0;
    }

    .site-container {
      width: 100%;
      max-width: 100%;
      margin: 0;
      background: transparent;
      border-radius: 0;
      padding: 16px 14px 110px;
      box-shadow: none;
      border: none;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .left-sidebar, .right-main-content {
      display: contents;
    }

    /* Mobile Flow Order */
    :global(.top-nav) { order: 1; }
    .left-sidebar > :global(.hero-banner-container) { order: 2; }
    .left-sidebar > :global(.profile-section) { order: 3; }
    .left-sidebar > :global(.hero-feature-card-wrapper) { order: 4; }
    .left-sidebar > :global(.tabbed-links-section) { order: 5; }

    .right-main-content > :global(.members-section) { order: 6; }
    .right-main-content > :global(.spotlight-section) { order: 7; }
    .right-main-content > :global(.inspired-section) { order: 8; }
    .right-main-content > :global(.rehearsal-utilities-section) { order: 9; }

    .left-sidebar > :global(.subscribe-section) { order: 10; }
    .right-main-content > :global(.site-footer) { order: 11; }
  }

  .site-footer {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 24px 16px 120px;
    margin-top: 16px;
    position: relative;
    z-index: 10;
    box-sizing: border-box;
    border-top: 2px solid #000000;
  }

  @media (min-width: 1024px) {
    .site-footer {
      padding: 32px 16px 56px;
    }
  }

  .footer-inner-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    text-align: center;
  }

  .footer-badge-row {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer-brand-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    background: #18181b;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    padding: 5px 14px;
    border-radius: 6px;
    user-select: none;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .footer-brand-badge:hover {
    background: #27272a;
    transform: translateY(-1px);
  }

  .footer-brand-icon {
    font-size: 0.8rem;
    color: var(--accent-neon-yellow);
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px 10px;
    max-width: 100%;
    margin: 0 auto;
  }

  .footer-legal-btn {
    background: transparent;
    border: none;
    color: #a1a1aa;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 4px 8px;
    border-radius: 4px;
    text-decoration: none;
    transition: color 0.16s ease, background-color 0.16s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    user-select: none;
  }

  .footer-legal-btn:hover,
  .footer-legal-btn:focus-visible {
    color: var(--accent-neon-yellow);
    background: rgba(255, 255, 255, 0.08);
    outline: none;
  }

  .legal-bullet {
    color: rgba(255, 255, 255, 0.25);
    font-size: 0.7rem;
    flex-shrink: 0;
    user-select: none;
  }

  @media (max-width: 480px) {
    .footer-legal-links {
      gap: 4px 8px;
    }
    .footer-legal-btn {
      font-size: 0.68rem;
      padding: 3px 6px;
    }
  }

  /* Full-Width Theme Toggle Button & Segmented Pill Control */
  .footer-theme-toggle-wrap {
    width: 100%;
    margin-top: 0;
    margin-bottom: 2px;
  }

  .footer-theme-toggle-btn {
    width: 100%;
    min-height: 48px;
    background: var(--surface-card-light);
    color: var(--text-card-primary);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 8px;
    padding: 6px 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    user-select: none;
    box-sizing: border-box;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
  }

  .footer-theme-toggle-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px #000000;
  }

  .footer-theme-toggle-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .theme-current-title {
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.92rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-card-primary);
    flex: 1 1 0;
    text-align: left;
  }

  .theme-pill-segmented {
    display: inline-flex;
    align-items: center;
    background: var(--surface-input);
    border: 2px solid #000000;
    border-radius: 20px;
    padding: 3px;
    gap: 3px;
    box-shadow: 1.5px 1.5px 0px #000000;
    flex: 0 0 auto;
  }

  .theme-pill-btn {
    width: 30px;
    height: 30px;
    min-width: 30px;
    min-height: 30px;
    border-radius: 50%;
    border: 1.5px solid transparent;
    background: transparent;
    color: var(--text-card-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    margin: 0;
    font-size: 0.82rem;
    transition: transform 0.16s var(--ease-tactile), background-color 0.18s ease, color 0.18s ease, box-shadow 0.16s ease;
  }

  .theme-pill-btn:hover {
    color: var(--text-card-primary);
    transform: scale(1.1);
  }

  .theme-pill-btn.active {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
    box-shadow: 1px 1px 0px #000000;
    transform: scale(1.06);
  }

  .theme-mode-label {
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-card-secondary);
    flex: 1 1 0;
    text-align: right;
  }

  .theme-toggle-icon-badge.theme-spin-pop {
    animation: themeSpinPop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes themeSpinPop {
    0% {
      transform: scale(1) rotate(0deg);
    }
    45% {
      transform: scale(1.3) rotate(180deg);
    }
    100% {
      transform: scale(1) rotate(360deg);
    }
  }
</style>

<script>
  import { initTheme } from '../scripts/controllers/themeController.js';
  initTheme();

  // Off-screen animation gating: pause infinite CSS animations inside heavy sections
  // while they are scrolled out of view (idle battery/CPU savings on low-end devices).
  if ('IntersectionObserver' in window) {
    const gated = document.querySelectorAll('[data-anim-gated]');
    const animObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle('offscreen', !entry.isIntersecting);
      });
    }, { rootMargin: '120px' });
    gated.forEach((el) => animObserver.observe(el));
  }
</script>

<script is:inline>
  (function initFooterModalTriggers() {
    function handleFooterTriggerClick(e) {
      var target = e.target;
      if (!target || !target.closest) return;

      var suggestBtn = target.closest('#openFeedbackFooterBtn, #openSuggestImprovementFooterBtn, .open-feedback-trigger, [data-open-feedback]');
      if (suggestBtn) {
        e.preventDefault();
        e.stopPropagation();
        var feedbackModal = document.getElementById('feedbackModal');
        if (typeof window.openFeedbackModal === 'function') {
          window.openFeedbackModal();
        } else if (feedbackModal) {
          feedbackModal.classList.remove('hidden');
          document.body.classList.add('modal-open');
        }
        return;
      }

      var legalBtn = target.closest('#openLegalFooterBtn, .open-legal-trigger, #openPrivacyFooterBtn, .open-privacy-trigger, #openTermsFooterBtn, .open-terms-trigger');
      if (legalBtn) {
        e.preventDefault();
        e.stopPropagation();
        var isSubmissions = legalBtn.id === 'openTermsFooterBtn' || legalBtn.classList.contains('open-terms-trigger');
        var initialTab = isSubmissions ? 'submissions' : 'privacy';
        if (typeof window.openLegalModal === 'function') {
          window.openLegalModal(initialTab);
        } else if (typeof window.openPrivacyModal === 'function') {
          window.openPrivacyModal();
        } else {
          var legalModal = document.getElementById('legalModal');
          if (legalModal) {
            legalModal.classList.remove('is-closing');
            legalModal.classList.remove('hidden');
            document.body.classList.add('modal-open');
          }
        }
        return;
      }
    }

    document.addEventListener('click', handleFooterTriggerClick, true);

    var yearEl = document.getElementById('copyrightYear');
    if (yearEl) yearEl.textContent = new Date().getFullYear().toString();
  })();
</script>
