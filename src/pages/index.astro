import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import TopNav from '../components/TopNav.astro';
import ProfileSection from '../components/ProfileSection.astro';
import MusicTeaserCard from '../components/MusicTeaserCard.astro';
import TabbedLinks from '../components/TabbedLinks.astro';
import MembersSection from '../components/MembersSection.astro';
import KinsCrewSpotlight from '../components/KinsCrewSpotlight.astro';
import MerchSection from '../components/MerchSection.astro';
import InspirationVault from '../components/InspirationVault.astro';
import SubscribeSection from '../components/SubscribeSection.astro';
import ShareModal from '../components/ShareModal.astro';
import GigMapSheet from '../components/GigMapSheet.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import FloatingGigPill from '../components/FloatingGigPill.astro';
import ToastContainer from '../components/ToastContainer.astro';
import CoversSearchOverlay from '../components/CoversSearchOverlay.astro';
import CoverVideoModal from '../components/CoverVideoModal.astro';
---

<BaseLayout title="Kins | Link in Bio">
  <div class="app-wrapper">
    <div class="site-container" id="siteContainer">
      <HeroBanner />

      <main class="container">
        <TopNav />
        <ProfileSection />
        <MusicTeaserCard />
        <TabbedLinks />
        <MerchSection />
        <MembersSection />
        <KinsCrewSpotlight />
        <InspirationVault />
        <SubscribeSection />

        <footer class="site-footer">
          <p>© 2026 Kins (@KinsBandOfficial). All rights reserved.</p>
        </footer>
      </main>
    </div>
  </div>

  <CoversSearchOverlay />
  <CoverVideoModal />
  <ShareModal />
  <GigMapSheet />
  <AudioPlayer />
  <FloatingGigPill />
  <ToastContainer />
</BaseLayout>

<style>
  .app-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 24px 12px;
    flex: 1;
    box-sizing: border-box;
  }

  .site-container {
    width: 100%;
    max-width: 500px;
    background: var(--bg-dark-green-gradient);
    min-height: 850px;
    border-radius: 12px;
    position: relative;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .app-wrapper {
      padding: 0;
    }
    .site-container {
      max-width: 100%;
      border-radius: 0;
      box-shadow: none;
      min-height: 100vh;
      border: none;
    }
  }

  .container {
    padding: 24px 20px 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: relative;
    z-index: 2;
    transition: padding-bottom 0.3s ease;
  }

  :global(body.audio-bar-active) .container {
    padding-bottom: 90px;
  }

  .site-footer {
    text-align: center;
    padding: 32px 0 20px;
    color: var(--text-muted);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-family: var(--font-secondary);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: 12px;
  }
</style>
