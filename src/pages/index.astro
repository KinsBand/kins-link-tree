---
import BaseLayout from '../shared/layouts/BaseLayout.astro';
import HeroBanner from '../sites/link-in-bio/components/HeroBanner.astro';
import TopNav from '../sites/link-in-bio/components/TopNav.astro';
import ProfileSection from '../sites/link-in-bio/components/ProfileSection.astro';
import MusicTeaserCard from '../sites/link-in-bio/components/MusicTeaserCard.astro';
import TabbedLinks from '../sites/link-in-bio/components/TabbedLinks.astro';
import MembersSection from '../sites/link-in-bio/components/MembersSection.astro';
import MerchSection from '../sites/link-in-bio/components/MerchSection.astro';
import InspirationVault from '../sites/link-in-bio/components/InspirationVault.astro';
import SubscribeSection from '../sites/link-in-bio/components/SubscribeSection.astro';
import ShareModal from '../sites/link-in-bio/components/ShareModal.astro';
import GigMapSheet from '../sites/link-in-bio/components/GigMapSheet.astro';
import AudioPlayer from '../sites/link-in-bio/components/AudioPlayer.astro';
import FloatingGigPill from '../sites/link-in-bio/components/FloatingGigPill.astro';
import ToastContainer from '../sites/link-in-bio/components/ToastContainer.astro';
import CoversSearchOverlay from '../sites/link-in-bio/components/CoversSearchOverlay.astro';
import CoverVideoModal from '../sites/link-in-bio/components/CoverVideoModal.astro';
---

<BaseLayout title="Kins | Link in Bio">
  <div class="app-wrapper">
    <div class="site-container" id="siteContainer">
      <HeroBanner />

      <main class="container">
        <TopNav />
        <ProfileSection />
        <MusicTeaserCard />
        <TabbedLinks />
        <MembersSection />
        <MerchSection />
        <InspirationVault />
        <SubscribeSection />

        <footer class="site-footer">
          <p>© 2026 Kins (@KinsBandOfficial). All rights reserved.</p>
        </footer>
      </main>
    </div>
  </div>

  <CoversSearchOverlay />
  <CoverVideoModal />
  <ShareModal />
  <GigMapSheet />
  <AudioPlayer />
  <FloatingGigPill />
  <ToastContainer />
</BaseLayout>

<style>
  .app-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 20px 10px;
    flex: 1;
    box-sizing: border-box;
  }

  .site-container {
    width: 100%;
    max-width: 520px;
    background: var(--bg-dark-green-gradient);
    min-height: 850px;
    border-radius: 32px;
    position: relative;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .app-wrapper {
      padding: 0;
    }
    .site-container {
      max-width: 100%;
      border-radius: 0;
      box-shadow: none;
      min-height: 100vh;
    }
  }

  .container {
    padding: 24px 20px 40px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: relative;
    z-index: 2;
  }

  .site-footer {
    text-align: center;
    padding: 20px 0;
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.78rem;
  }
</style>
