---
import BaseLayout from '../layouts/BaseLayout.astro';

// Section Components
import HeroBanner from '../components/sections/HeroBanner.astro';
import ProfileSection from '../components/sections/ProfileSection.astro';
import MusicTeaserCard from '../components/sections/MusicTeaserCard.astro';
import TabbedLinks from '../components/sections/TabbedLinks.astro';
import MembersSection from '../components/sections/MembersSection.astro';
import KinsCrewSpotlight from '../components/sections/KinsCrewSpotlight.astro';
import MerchSection from '../components/sections/MerchSection.astro';
import InspirationVault from '../components/sections/InspirationVault.astro';
import SubscribeSection from '../components/sections/SubscribeSection.astro';

// Navigation Components
import TopNav from '../components/navigation/TopNav.astro';
import FloatingGigPill from '../components/navigation/FloatingGigPill.astro';

// Modal Components
import ShareModal from '../components/modals/ShareModal.astro';
import GigMapSheet from '../components/modals/GigMapSheet.astro';
import CoversSearchOverlay from '../components/modals/CoversSearchOverlay.astro';
import CoverVideoModal from '../components/modals/CoverVideoModal.astro';
import CommunitySubmissionModal from '../components/modals/CommunitySubmissionModal.astro';
import PrivacyModal from '../components/modals/PrivacyModal.astro';
import TermsModal from '../components/modals/TermsModal.astro';

// UI Components
import AudioPlayer from '../components/ui/AudioPlayer.astro';
import ToastContainer from '../components/ui/ToastContainer.astro';
---

<BaseLayout title="Kins | Official Link in Bio">
  <div class="app-wrapper">
    <div class="site-container" id="siteContainer">
      <!-- Fixed Left Sidebar for Desktop / Top Portion for Mobile -->
      <aside class="left-sidebar" id="leftSidebar">
        <TopNav />
        <HeroBanner />
        <ProfileSection />
        <MusicTeaserCard />
        <TabbedLinks />
        <SubscribeSection />
      </aside>

      <!-- Scrollable Right Main View for Desktop / Bottom Portion for Mobile -->
      <main class="right-main-content" id="rightMainContent">
        <MembersSection />
        <KinsCrewSpotlight />
        <MerchSection />
        <InspirationVault />

        <footer class="site-footer">
          <p>© <span id="copyrightYear">2026</span> KINS (@KINSBANDOFFICIAL). ALL RIGHTS RESERVED.</p>
          <div class="footer-legal-links">
            <button type="button" id="openPrivacyFooterBtn" class="footer-legal-btn">Privacy Policy</button>
            <span class="legal-bullet">•</span>
            <button type="button" id="openTermsFooterBtn" class="footer-legal-btn">Fan Submission Terms</button>
          </div>
        </footer>
      </main>
    </div>
  </div>

  <CoversSearchOverlay />
  <CoverVideoModal />
  <CommunitySubmissionModal />
  <PrivacyModal />
  <TermsModal />
  <ShareModal />
  <GigMapSheet />
  <AudioPlayer />
  <FloatingGigPill />
  <ToastContainer />
</BaseLayout>

<style>
  .app-wrapper {
    width: 100%;
    min-height: 100vh;
    display: flex;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
    background: var(--bg-dark-green-gradient);
  }

  .site-container {
    width: 100%;
    max-width: 100%;
    position: relative;
    z-index: 2;
  }

  /* Split Viewport (≥ 768px): Fullscreen Split with Fluid Left Sidebar & Right Main Content */
  @media (min-width: 768px) {
    .app-wrapper {
      padding: 0;
      margin: 0;
      width: 100%;
      min-height: 100vh;
    }

    .site-container {
      width: 100%;
      max-width: 100%;
      min-height: 100vh;
      display: flex;
      background: transparent;
      box-shadow: none;
      border: none;
      border-radius: 0;
    }

    /* Fixed Left Sidebar - Fluid clamp scaling, spans 100% height of viewport */
    .left-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      width: clamp(300px, 30vw, 420px);
      height: 100vh;
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
      padding: 24px 20px 40px;
      background: rgba(14, 14, 17, 0.94);
      border-right: 1px solid rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      box-shadow: 10px 0 30px rgba(0, 0, 0, 0.5);
      display: flex;
      flex-direction: column;
      gap: 20px;
      z-index: 100;
      box-sizing: border-box;
    }

    .left-sidebar::-webkit-scrollbar {
      width: 4px;
    }

    .left-sidebar::-webkit-scrollbar-track {
      background: transparent;
    }

    .left-sidebar::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.2);
      border-radius: 4px;
    }

    /* Scrollable Right Main Content - Fills 100% remaining width */
    .right-main-content {
      margin-left: clamp(300px, 30vw, 420px);
      width: calc(100% - clamp(300px, 30vw, 420px));
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      gap: 32px;
      padding: 32px 36px 120px;
      background: rgba(10, 10, 12, 0.5);
      box-sizing: border-box;
    }
  }

  /* Ultra-wide Displays (≥ 1400px): Expand right padding */
  @media (min-width: 1400px) {
    .right-main-content {
      padding: 40px 60px 120px;
    }
  }

  /* Mobile Stacked Edge-to-Edge View (< 768px) */
  @media (max-width: 767px) {
    .app-wrapper {
      padding: 0;
      margin: 0;
    }

    .site-container {
      width: 100%;
      max-width: 100%;
      margin: 0;
      background: transparent;
      border-radius: 0;
      padding: 16px 16px 100px;
      box-shadow: none;
      border: none;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .left-sidebar, .right-main-content {
      display: contents;
    }

    /* Mobile Flow Order */
    .left-sidebar > :global(.top-nav) { order: 1; }
    .left-sidebar > :global(.hero-banner-container) { order: 2; }
    .left-sidebar > :global(.profile-section) { order: 3; }
    .left-sidebar > :global(.music-teaser-wrapper) { order: 4; }
    .left-sidebar > :global(.tabbed-links-section) { order: 5; }

    .right-main-content > :global(.members-section) { order: 6; }
    .right-main-content > :global(.spotlight-section) { order: 7; }
    .right-main-content > :global(.inspired-section) { order: 8; }

    .left-sidebar > :global(.subscribe-section) { order: 9; }
    .right-main-content > :global(.site-footer) { order: 10; }
  }

  .site-footer {
    text-align: center;
    padding: 32px 0 20px;
    color: var(--text-muted);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-family: var(--font-secondary);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: 12px;
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 8px;
  }

  .footer-legal-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.7rem;
    font-weight: 700;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0;
    transition: color 0.18s ease;
  }

  .footer-legal-btn:hover {
    color: var(--text-white);
    text-decoration: underline;
  }

  .legal-bullet {
    color: rgba(255, 255, 255, 0.2);
  }
</style>

<script>
  const yearEl = document.getElementById('copyrightYear');
  if (yearEl) yearEl.textContent = new Date().getFullYear().toString();

  const privacyModal = document.getElementById('privacyModal');
  const termsModal = document.getElementById('termsModal');

  document.getElementById('openPrivacyFooterBtn')?.addEventListener('click', () => {
    privacyModal?.classList.remove('hidden');
    document.body.classList.add('modal-open');
  });

  document.getElementById('openTermsFooterBtn')?.addEventListener('click', () => {
    termsModal?.classList.remove('hidden');
    document.body.classList.add('modal-open');
  });
</script>
