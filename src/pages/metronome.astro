    letter-spacing: 0.06em;
    color: #a1a1aa;
    font-variant-numeric: tabular-nums;
  }

  .metro-color-input {
    width: 38px;
    height: 28px;
    padding: 0;
    border: 2px solid #000000;
    border-radius: 6px;
    background: #0f0f12;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    overflow: hidden;
    flex-shrink: 0;
  }

  .metro-color-input::-webkit-color-swatch-wrapper {
    padding: 0;
  }

  .metro-color-input::-webkit-color-swatch {
    border: none;
    border-radius: 4px;
  }

  .metro-color-input::-moz-color-swatch {
    border: none;
    border-radius: 4px;
