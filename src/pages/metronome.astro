</BaseLayout>

<style>
  /* ========== page shell — dark textured, matte black containers ========== */
  .metro-page {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background-color: #0a0a0c;
    background-image:
      radial-gradient(circle at 50% 16%, #1e1c18 0%, #121210 42%, #08080a 78%, #040405 100%);
    color: var(--text-white);
    overflow: hidden;
    position: relative;
  }

  .metro-page :global([hidden]) {
    display: none !important;
  }

  .metro-view {
    position: relative;
    z-index: 1;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    padding: calc(14px + env(safe-area-inset-top)) 16px calc(14px + env(safe-area-inset-bottom));
    box-sizing: border-box;
  }

  /* ---------- top bar ---------- */
  .metro-topbar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    flex-shrink: 0;
  }

  /* ---------- pitch & beat colors section inside settings ---------- */
  .metro-color-section {
    margin-top: 6px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .metro-color-grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .metro-color-row {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 12px;
    background: #1e1e24;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    cursor: pointer;
    box-sizing: border-box;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease, border-color 0.16s ease;
  }

  .metro-color-row:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #25252e;
