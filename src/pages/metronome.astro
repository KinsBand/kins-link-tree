  }

  .metro-topbar-counter-line {
    font-family: var(--font-secondary);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #a1a1aa;
  }

  .metro-topbar-counter-line[hidden] {
    display: none !important;
  }

  /* ---------- transformed setlist deck (Req 11: 4 equal 20% zones) ---------- */
  .metro-setlist-deck {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    width: 100%;
    margin-top: 10px;
    box-sizing: border-box;
    justify-content: center;
    align-items: center;
  }

  .metro-setlist-deck[hidden] {
    display: none !important;
  }

  .metro-setlist-deck-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    background: #1a1a1e;
    color: var(--accent-neon-yellow);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    font-size: 1.15rem;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.12s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.12s ease;
  }

  .metro-setlist-deck-btn:hover {
    background: #25252e;
    color: var(--btn-green-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .metro-setlist-deck-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
    background: var(--accent-neon-yellow);
    color: #000000;
  }

  @keyframes metroTopbarIn {
    from { opacity: 0; transform: translateY(-4px) scale(0.98); } 
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (max-width: 380px) {
    .metro-topbar-center { max-width: 38%; }
    .metro-topbar-title,
    .metro-topbar-undo { font-size: 0.66rem; padding: 6px 10px; }
    .metro-back-pill {
      height: 48px;
      min-height: 48px;
      padding: 0 14px;
      font-size: 0.84rem;
      gap: 6px;
    }
  }

  /* ---------- shared icon button — matte black, gold hover ========== */
  .metro-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    flex-shrink: 0;
    background: #1a1a1e;
    color: #f5f5f7;
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: var(--radius-pill);
    font-size: 1.15rem;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease, color 0.16s ease;
  }

  .metro-icon-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px #000000;
    color: var(--accent-neon-yellow);
  }

  .metro-icon-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  /* ---------- dial — matte black card feel, gold BPM ========== */
  .metro-dial {
    --metro-dial-size: min(86vw, 380px, calc(100dvh - 280px));
    --metro-dot-radius: calc(var(--metro-dial-size) / 2 - 22px);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--metro-dial-size);
    height: var(--metro-dial-size);
    aspect-ratio: 1;
    margin: auto auto;
    flex: 0 1 auto;
    min-width: 190px;
    min-height: 190px;
    max-width: 380px;
    max-height: 380px;
    cursor: ns-resize;
    touch-action: none;
    user-select: none;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 38%, #1e1e22 0%, #131316 48%, #0c0c0e 100%);
    border: 2px solid rgba(216, 178, 68, 0.14);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      inset 0 -1px 0 rgba(0, 0, 0, 0.6);
  }

  .metro-view.has-strip .metro-dial {
    --metro-dial-size: min(82vw, 330px, calc(100dvh - 340px));
  }

  .metro-beat-dots {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  :global(.metro-beat-dot) {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    border-radius: 50%;
    background: #1e1e24;
    border: 2px solid #2a2a30;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
    opacity: 0.7;
    pointer-events: auto;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    box-sizing: border-box;
    overflow: visible;
    transition: background-color 0.14s ease, border-color 0.14s ease, transform 0.14s var(--ease-tactile), opacity 0.14s ease, box-shadow 0.14s ease;
  }

  /* Expanded touch hit area (44px x 44px) without moving the visual dot */
  :global(.metro-beat-dot)::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    pointer-events: auto;
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) {
    :global(.metro-beat-dot:hover) {
      opacity: 1;
      filter: brightness(1.25);
    }
  }

  :global(.metro-beat-dot:active) {
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.metro-beat-dot:focus-visible) {
    outline: none;
    box-shadow: 0 0 0 2px #F2FD43;
  }

  /* Idle dots — high-contrast Neo-Brutalist pitch palette
      Low  = Deep Amber  #FF9F1C (warm sub/bass)
      Mid  = Vivid Cyan  #2EC4B6 (body/primary)
      High = Neon Green  #53FC18 (accent/peak)
      Muted = more-grey desaturated mid-grey fill + prominent dashed greige border (#9A9688), 0.78 opacity, clearly rest (not note), no glow until active */
  :global(.metro-beat-dot.tier-mute),
  :global(.metro-beat-dot.beat-muted-gold),
  :global(.metro-beat-dot.is-muted),
  :global(.metro-beat-dot.is-mute),
  :global(.beat-pip.is-muted),
  :global(.beat-muted) {
    background: var(--beat-muted-bg, rgba(82, 82, 80, 0.38)) !important;
    background-color: var(--beat-muted-bg, rgba(82, 82, 80, 0.38)) !important;
    border: 2px dashed var(--beat-muted-border, #9A9688) !important;
    box-shadow: none !important;
    filter: none !important;
    opacity: var(--beat-muted-opacity, 0.78) !important;
    box-sizing: border-box !important;
    overflow: visible;
    transition: background-color 0.14s ease, border-color 0.14s ease, transform 0.14s var(--ease-tactile), opacity 0.14s ease, box-shadow 0.14s ease, filter 0.14s ease;
  }

  /* Muted inner icons/numerals/LED pips reduced */
  :global(.metro-beat-dot.tier-mute) :global(*),
  :global(.metro-beat-dot.beat-muted-gold) :global(*) {
    opacity: var(--beat-muted-inner-opacity, 0.42);
  }

  :global(.metro-beat-dot.tier-low),
  :global(.beat-pip.is-low),
  :global(.beat-low) {
    background: var(--level-low-bg, rgba(255, 159, 28, 0.16));
    background-color: var(--level-low-bg, rgba(255, 159, 28, 0.16));
    border: 2px solid var(--level-low-border, rgba(255, 159, 28, 0.75));
    box-shadow: 0 0 6px var(--level-low-glow, rgba(255, 159, 28, 0.25));
    opacity: 0.9;
    box-sizing: border-box;
    overflow: visible;
  }

  :global(.metro-beat-dot.tier-mid),
  :global(.beat-pip.is-mid),
  :global(.beat-mid) {
    background: var(--level-mid-bg, rgba(46, 196, 182, 0.16));
    background-color: var(--level-mid-bg, rgba(46, 196, 182, 0.16));
    border: 2px solid var(--level-mid-border, rgba(46, 196, 182, 0.75));
    box-shadow: 0 0 6px var(--level-mid-glow, rgba(46, 196, 182, 0.25));
    opacity: 0.9;
    box-sizing: border-box;
    overflow: visible;
  }

  :global(.metro-beat-dot.tier-high),
  :global(.beat-pip.is-high),
  :global(.beat-high) {
    background: var(--level-high-bg, rgba(83, 252, 24, 0.16));
    background-color: var(--level-high-bg, rgba(83, 252, 24, 0.16));
    border: 2px solid var(--level-high-border, rgba(83, 252, 24, 0.75));
    box-shadow: 0 0 6px var(--level-high-glow, rgba(83, 252, 24, 0.25));
    opacity: 0.9;
    box-sizing: border-box;
    overflow: visible;
  }

  /* Active dots — muted: more-grey brighter fill + subtle grey glow flash (still rest, not vivid note) */
  :global(.metro-beat-dot.active.tier-mute),
  :global(.metro-beat-dot.active.beat-muted-gold),
  :global(.metro-beat-dot.active.is-muted) {
    background: var(--beat-muted-active-bg, rgba(102, 102, 100, 0.46)) !important;
    background-color: var(--beat-muted-active-bg, rgba(102, 102, 100, 0.46)) !important;
    border: 2px dashed var(--beat-muted-active-border, #B8B4A3) !important;
    box-shadow: 0 0 8px var(--beat-muted-active-glow, rgba(155, 150, 136, 0.28)) !important;
    filter: none !important;
    opacity: var(--beat-muted-active-opacity, 0.92) !important;
    box-sizing: border-box !important;
  }

  :global(.metro-beat-dot.active.tier-low),
  :global(.beat-pip.is-low.active) {
    background: var(--level-low, #FF9F1C);
    background-color: var(--level-low, #FF9F1C);
    border: 2px solid var(--level-low, #FF9F1C);
    opacity: 1;
    box-sizing: border-box;
    box-shadow: 0 0 14px var(--level-low-glow, rgba(255, 159, 28, 0.85)), 0 0 24px var(--level-low-glow, rgba(255, 159, 28, 0.45));
  }

  :global(.metro-beat-dot.active.tier-mid),
  :global(.metro-beat-dot.active),
  :global(.beat-pip.is-mid.active) {
    background: var(--level-mid, #2EC4B6);
    background-color: var(--level-mid, #2EC4B6);
    border: 2px solid var(--level-mid, #2EC4B6);
    opacity: 1;
    box-sizing: border-box;
    box-shadow: 0 0 14px var(--level-mid-glow, rgba(46, 196, 182, 0.85)), 0 0 24px var(--level-mid-glow, rgba(46, 196, 182, 0.45));
  }

  :global(.metro-beat-dot.active.tier-high),
  :global(.beat-pip.is-high.active) {
    background: var(--level-high, #53FC18);
    background-color: var(--level-high, #53FC18);
    border: 2px solid var(--level-high, #53FC18);
    opacity: 1;
    box-sizing: border-box;
    box-shadow: 0 0 14px var(--level-high-glow, rgba(83, 252, 24, 0.85)), 0 0 24px var(--level-high-glow, rgba(83, 252, 24, 0.45));
  }

  /* Active Accent dots — muted: subtle grey flash (accent does not re-color rest beats) */
  :global(.metro-beat-dot.active.accent.tier-mute),
  :global(.metro-beat-dot.active.accent.beat-muted-gold) {
    background: var(--beat-muted-active-bg, rgba(102, 102, 100, 0.46)) !important;
    background-color: var(--beat-muted-active-bg, rgba(102, 102, 100, 0.46)) !important;
    border: 2px dashed var(--beat-muted-active-border, #B8B4A3) !important;
    box-shadow: 0 0 10px var(--beat-muted-active-glow, rgba(155, 150, 136, 0.28)) !important;
    filter: none !important;
    opacity: var(--beat-muted-active-opacity, 0.92) !important;
    box-sizing: border-box !important;
  }

  :global(.metro-beat-dot.active.accent.tier-low) {
    background: var(--level-low, #FF9F1C);
    background-color: var(--level-low, #FF9F1C);
    border: 2px solid #FFD6A0;
    opacity: 1;
    box-sizing: border-box;
    box-shadow: 0 0 18px var(--level-low-glow, rgba(255, 159, 28, 0.95)), 0 0 30px var(--level-low-glow, rgba(255, 159, 28, 0.6));
  }

  :global(.metro-beat-dot.active.accent.tier-mid),
  :global(.metro-beat-dot.active.accent) {
    background: var(--level-mid, #2EC4B6);
    background-color: var(--level-mid, #2EC4B6);
    border: 2px solid #FFFFFF;
    opacity: 1;
    box-sizing: border-box;
    box-shadow: 0 0 18px var(--level-mid-glow, rgba(46, 196, 182, 0.95)), 0 0 30px var(--level-mid-glow, rgba(46, 196, 182, 0.6));
  }

  :global(.metro-beat-dot.active.accent.tier-high) {
    background: var(--level-high, #53FC18);
    background-color: var(--level-high, #53FC18);
    border: 2px solid #A3FF85;
    opacity: 1;
    box-sizing: border-box;
    box-shadow: 0 0 18px var(--level-high-glow, rgba(83, 252, 24, 0.95)), 0 0 30px var(--level-high-glow, rgba(83, 252, 24, 0.6));
  }

  /* ---------- radial ring — segmented circle around BPM ========== */
  .metro-radial-ring {
    position: absolute;
    inset: 4%;
    width: 92%;
    height: 92%;
    pointer-events: none;
    overflow: visible;
    z-index: 2;
  }

  .metro-radial-ring :global(.metro-radial-seg) {
    fill: none;
    stroke: rgba(255, 255, 255, 0.08);
    stroke-width: 8;
    stroke-linecap: round;
    pointer-events: none;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    outline: none;
    transition: stroke 0.12s ease, stroke-width 0.12s ease, opacity 0.12s ease;
    opacity: 0.9;
  }

  /* Hit path carries pointer events, visual path is non-interactive */
  .metro-radial-ring :global(.metro-radial-seg-hit) {
    pointer-events: stroke;
  }

  .metro-radial-ring :global(.metro-radial-seg-group:focus-visible) {
    outline: 2px solid #F2FD43;
    outline-offset: 2px;
    border-radius: 4px;
  }

  .metro-radial-ring :global(.metro-radial-seg:active) {
    outline: none;
    -webkit-tap-highlight-color: transparent;
    opacity: 1;
  }

  .metro-radial-ring :global(.metro-radial-seg:focus-visible) {
    outline: none;
    stroke-width: 9.5;
  }

  /* Idle radial segments — unified Low/Mid/High via level tokens
      Muted: more-grey mid-grey fill + prominent dashed greige stroke (#9A9688), crisp 5 4 dashes, clearly rest */
  .metro-radial-ring :global(.metro-radial-seg.tier-mute),
  .metro-radial-ring :global(.metro-radial-seg.beat-muted-gold),
  .metro-radial-ring :global(.metro-radial-seg.is-muted) {
    stroke: var(--beat-muted-border, #9A9688);
    stroke-dasharray: 5 4;
    stroke-linecap: butt;
    stroke-width: 8;
    fill: none;
    filter: none;
    opacity: var(--beat-muted-opacity, 0.78);
    /* Prevent SVG child clipping on dashed stroke */
    overflow: visible;
    transition: stroke 0.14s ease, fill 0.14s ease, opacity 0.14s ease, stroke-width 0.14s ease, filter 0.14s ease;
  }

  .metro-radial-ring :global(.metro-radial-seg.tier-low),
  .metro-radial-ring :global(.beat-pip.is-low) {
    stroke: var(--level-low, #FF9F1C);
    stroke-dasharray: none;
    opacity: 0.85;
  }

  .metro-radial-ring :global(.metro-radial-seg.tier-mid),
  .metro-radial-ring :global(.beat-pip.is-mid) {
    stroke: var(--level-mid, #2EC4B6);
    stroke-dasharray: none;
    opacity: 0.85;
  }

  .metro-radial-ring :global(.metro-radial-seg.tier-high),
  .metro-radial-ring :global(.beat-pip.is-high) {
    stroke: var(--level-high, #53FC18);
    stroke-dasharray: none;
    opacity: 0.85;
  }

  /* Active radial segments — muted: brighter greige dash + subtle grey glow flash */
  .metro-radial-ring :global(.metro-radial-seg.active.tier-mute),
  .metro-radial-ring :global(.metro-radial-seg.active.beat-muted-gold),
  .metro-radial-ring :global(.metro-radial-seg.active.is-muted) {
    stroke: var(--beat-muted-active-border, #B8B4A3) !important;
    stroke-dasharray: 5 4 !important;
    stroke-width: 8 !important;
    filter: drop-shadow(0 0 6px var(--beat-muted-active-glow, rgba(155, 150, 136, 0.28))) !important;
    opacity: var(--beat-muted-active-opacity, 0.92) !important;
  }

  .metro-radial-ring :global(.metro-radial-seg.active.tier-low) {
    stroke: var(--level-low, #FF9F1C);
    stroke-dasharray: none;
    stroke-width: 8;
    filter: drop-shadow(0 0 8px var(--level-low-glow, rgba(255, 159, 28, 0.85)));
    opacity: 1;
  }

  .metro-radial-ring :global(.metro-radial-seg.active.tier-mid),
  .metro-radial-ring :global(.metro-radial-seg.active) {
    stroke: var(--level-mid, #2EC4B6);
    stroke-dasharray: none;
    stroke-width: 8;
    filter: drop-shadow(0 0 8px var(--level-mid-glow, rgba(46, 196, 182, 0.85)));
    opacity: 1;
  }

  .metro-radial-ring :global(.metro-radial-seg.active.tier-high) {
    stroke: var(--level-high, #53FC18);
    stroke-dasharray: none;
    stroke-width: 8;
    filter: drop-shadow(0 0 8px var(--level-high-glow, rgba(83, 252, 24, 0.85)));
    opacity: 1;
  }

  /* Active Accent radial segments — muted accent: same subtle grey flash (accent does not re-color rest beats) */
  .metro-radial-ring :global(.metro-radial-seg.active.accent.tier-mute),
  .metro-radial-ring :global(.metro-radial-seg.active.accent.beat-muted-gold) {
    stroke: var(--beat-muted-active-border, #B8B4A3) !important;
    stroke-dasharray: 5 4 !important;
    stroke-linecap: butt !important;
    stroke-width: 8 !important;
    filter: drop-shadow(0 0 7px var(--beat-muted-active-glow, rgba(155, 150, 136, 0.30))) !important;
    opacity: var(--beat-muted-active-opacity, 0.92) !important;
  }

  .metro-radial-ring :global(.metro-radial-seg.active.accent.tier-low) {
    stroke: var(--level-low, #FF9F1C);
    stroke-dasharray: none;
    stroke-width: 8.5;
    filter: drop-shadow(0 0 12px var(--level-low-glow, rgba(255, 159, 28, 0.95))) drop-shadow(0 0 20px var(--level-low-glow, rgba(255, 159, 28, 0.5)));
    opacity: 1;
  }

  .metro-radial-ring :global(.metro-radial-seg.active.accent.tier-mid),
  .metro-radial-ring :global(.metro-radial-seg.active.accent) {
    stroke: var(--level-mid, #2EC4B6);
    stroke-dasharray: none;
    stroke-width: 8.5;
    filter: drop-shadow(0 0 12px var(--level-mid-glow, rgba(46, 196, 182, 0.95))) drop-shadow(0 0 20px var(--level-mid-glow, rgba(46, 196, 182, 0.5)));
    opacity: 1;
  }

  .metro-radial-ring :global(.metro-radial-seg.active.accent.tier-high) {
    stroke: var(--level-high, #53FC18);
    stroke-dasharray: none;
    stroke-width: 8.5;
    filter: drop-shadow(0 0 12px var(--level-high-glow, rgba(83, 252, 24, 0.95))) drop-shadow(0 0 20px var(--level-high-glow, rgba(83, 252, 24, 0.5)));
    opacity: 1;
  }

  /* hide dots when radial is active, hide ring when dots active */
  .metro-dial[data-beat-style="dots"] .metro-radial-ring {
    display: none;
  }

  .metro-dial[data-beat-style="radial"] .metro-beat-dots {
    display: none;
  }

  .metro-dial[data-beat-style="radial"] {
    --metro-dot-radius: calc(var(--metro-dial-size) / 2 - 18px);
  }

  .metro-dial-core {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    z-index: 1;
    pointer-events: auto;
  }

  .metro-tempo-marking {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent-neon-yellow);
    text-shadow: 0 0 12px rgba(242, 253, 67, 0.45);
    height: 18px;
    line-height: 18px;
    margin-bottom: 2px;
    text-align: center;
    opacity: 0;
    transform: translateY(4px) scale(0.95);
    pointer-events: none;
    user-select: none;
    transition: opacity 0.38s ease, transform 0.38s var(--ease-snappy);
    will-change: opacity, transform;
  }

  .metro-tempo-marking.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .metro-tempo-marking.swap-anim-a {
    animation: tempoBlurInA 0.35s ease forwards;
  }

  .metro-tempo-marking.swap-anim-b {
    animation: tempoBlurInB 0.35s ease forwards;
  }

  .metro-tempo-marking.is-hiding {
    animation: tempoBlurOut 0.38s ease forwards;
  }

  @keyframes tempoBlurInA {
    0% {
      opacity: 0.15;
      transform: translateY(4px) scale(0.93);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes tempoBlurInB {
    0% {
      opacity: 0.15;
      transform: translateY(4px) scale(0.93);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes tempoBlurOut {
    0% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    100% {
      opacity: 0;
      transform: translateY(-3px) scale(0.95);
    }
  }

  :global(html.low-power-mode) .metro-tempo-marking {
    animation: none !important;
    transition: opacity 0.2s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .metro-tempo-marking {
      animation: none !important;
      transition: opacity 0.2s ease;
    }
  }

  .metro-bpm-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    position: relative;
  }

  .metro-bpm-num {
    font-family: var(--font-heading);
    font-size: clamp(3.8rem, 19vw, 5.8rem);
    font-weight: 800;
    line-height: 1;
    color: #ffffff;
    text-align: center;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    user-select: none;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8), 0 0 2px rgba(255, 255, 255, 0.2);
    background: transparent;
    border: 2px solid transparent;
    border-radius: 8px;
    padding: 10px 16px;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    position: relative;
    transition: border-color 0.16s ease, background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  .metro-bpm-num::after {
    content: "";
    position: absolute;
    inset: -8px;
    border-radius: inherit;
    pointer-events: auto;
  }

  .metro-bpm-num:hover {
    border-color: rgba(242, 253, 67, 0.5);
    background: rgba(242, 253, 67, 0.08);
    color: var(--accent-neon-yellow);
  }

  .metro-bpm-num:active {
    border-color: var(--accent-neon-yellow);
    background: rgba(242, 253, 67, 0.16);
    color: var(--accent-neon-yellow);
    outline: none;
    -webkit-tap-highlight-color: transparent;
    box-shadow: 0 0 12px rgba(242, 253, 67, 0.35);
  }

  .metro-bpm-num:focus-visible {
    outline: none;
    border-color: var(--accent-neon-yellow);
    box-shadow: 0 0 0 2px rgba(242, 253, 67, 0.5);
  }

  .metro-bpm-input {
    font-family: var(--font-heading);
    font-size: clamp(3.2rem, 17vw, 5rem);
    font-weight: 800;
    line-height: 1;
    color: #f5f5f7;
    background: #1e1e24;
    border: 2px solid var(--accent-neon-yellow);
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    padding: 6px 12px;
    width: 4ch;
    max-width: 5ch;
    text-align: center;
    font-variant-numeric: tabular-nums;
    outline: none;
    -moz-appearance: textfield;
  }

  .metro-bpm-input::-webkit-outer-spin-button,
  .metro-bpm-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .metro-bpm-input:focus {
    border-color: var(--btn-green-hover);
    box-shadow: 0 0 0 2px rgba(216, 178, 68, 0.25), 2px 2px 0px #000000;
  }

  /* Two identical flash animations — JS alternates class names to restart
     the effect each beat without a forced reflow */
  .metro-dial.beat-flash-a .metro-bpm-num,
  .metro-dial.beat-flash-a .metro-bpm-input {
    animation: metro-bpm-flash-a 140ms ease;
  }

  .metro-dial.beat-flash-b .metro-bpm-num,
  .metro-dial.beat-flash-b .metro-bpm-input {
    animation: metro-bpm-flash-b 140ms ease;
  }

  @keyframes metro-bpm-flash-a {
    0% { opacity: 1; transform: scale(1); }
    40% { opacity: 0.65; transform: scale(1.03); }
    100% { opacity: 1; transform: scale(1); }
  }

  @keyframes metro-bpm-flash-b {
    0% { opacity: 1; transform: scale(1); }
    40% { opacity: 0.65; transform: scale(1.03); }
    100% { opacity: 1; transform: scale(1); }
  }

  .metro-bpm-unit {
    margin: 0;
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent-neon-yellow);
    text-shadow: 0 0 8px rgba(242, 253, 67, 0.3);
  }

  /* ---------- KINS Sheet Strip — horizontal brutalist viewer in negative space ========== */
  .metro-sheet-strip {
    width: 100%;
    flex-shrink: 0;
    background: #141418;
    color: #f5f5f7;
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: var(--radius-md);
    padding: 10px 10px 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 10px 0 2px;
    overflow: hidden;
    box-sizing: border-box;
  }

  .metro-sheet-strip[hidden] { display: none !important; }

  .metro-sheet-strip-head {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .metro-sheet-strip-title {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #a1a1aa;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .metro-sheet-strip-bpm {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 3px 8px;
    background: var(--accent-neon-yellow);
    color: #000;
    border: 1px solid #000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .metro-sheet-strip-bar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 3px 8px;
    background: #0f0f12;
    color: var(--accent-neon-yellow);
    border: 1px solid rgba(216, 178, 68, 0.4);
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .metro-sheet-track {
    display: flex;
    align-items: stretch;
    gap: 10px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 2px 2px 6px;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x;
    outline: none;
  }

  .metro-sheet-track:focus-visible { outline: 2px solid var(--accent-neon-yellow); outline-offset: 2px; }

  /* page cards are JS-created at runtime → styled in the is:global block below */

  /* toggles directly above stepper row */
  .metro-sheet-toggles {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    flex-wrap: wrap;
  }

  .metro-sheet-toggles[hidden] { display: none !important; }

  .metro-sheet-toggle {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    background: #1e1e24;
    color: #a1a1aa;
    border: 2px solid #000;
    box-shadow: 2px 2px 0 #000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease, color 0.16s ease;
  }

  .metro-sheet-toggle:hover {
    transform: translate(-1px,-1px);
    box-shadow: 3px 3px 0 #000;
    background: #25252e;
    color: #f5f5f7;
  }

  .metro-sheet-toggle[aria-pressed="true"] {
    background: var(--accent-neon-yellow);
    color: #000;
  }

  .metro-sheet-toggle--ghost {
    margin-left: auto;
    background: transparent;
    color: #71717a;
    border-style: dashed;
    box-shadow: none;
  }

  .metro-sheet-toggle--ghost:hover { background: rgba(255,255,255,0.06); color: #ff6b6b; }

  /* ---------- BPM stepper strip — sits above bottom controls ========== */
  .metro-bottom {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    margin-top: auto;
    flex-shrink: 0;
  }

  /* when the sheet strip is revealed it takes over the auto gap (dial → strip),
     and the controls group sits tight beneath it */
  .metro-view.has-strip .metro-sheet-strip { margin-top: auto; }
  .metro-view.has-strip .metro-bottom { margin-top: 10px; }

  .metro-stepper-strip {
    display: none !important;
  }

  #metroBpmMinus {
    grid-column: 1;
  }

  #metroBpmPlus {
    grid-column: 3;
  }

  .metro-stepper-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 44px;
    min-height: 44px;
    flex-shrink: 0;
    background: #1a1a1e;
    color: var(--accent-neon-yellow);
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-pill);
    font-size: 0.95rem;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.12s var(--ease-tactile), box-shadow 0.12s ease, background-color 0.16s ease, color 0.16s ease;
    user-select: none;
  }

  .metro-stepper-btn:hover {
    background: #222228;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    color: var(--btn-green-hover);
  }

  .metro-stepper-btn:active {
    transform: translate(1px, 1px) scale(0.97);
    box-shadow: 1px 1px 0px #000000;
    background: var(--accent-neon-yellow);
    color: #000000;
  }

  .metro-stepper-btn:focus-visible {
    outline: 2px solid var(--accent-neon-yellow);
    outline-offset: 2px;
  }

  .metro-pill-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    background: #101014;
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: var(--radius-pill);
    padding: 8px 14px;
  }

  .metro-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: transparent;
    color: #f5f5f7;
    border: none;
    padding: 4px 6px;
    font-family: var(--font-secondary);
    font-size: 0.95rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color 0.16s ease, transform 0.16s var(--ease-tactile);
  }

  .metro-pill:hover {
    color: var(--accent-neon-yellow);
  }

  .metro-pill-caret {
    font-size: 0.65rem;
    color: var(--accent-neon-yellow);
    transition: transform 0.16s ease;
  }

  .metro-pill[aria-expanded="true"] .metro-pill-caret {
    transform: rotate(180deg);
  }

  .metro-pill-divider {
    width: 2px;
    height: 18px;
    background: rgba(255, 255, 255, 0.2);
  }

  /* ---------- bottom controls ---------- */
  .metro-controls {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    width: 100%;
    box-sizing: border-box;
    flex-shrink: 0;
  }

  .metro-controls .metro-icon-btn {
    width: 54px;
    height: 54px;
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .metro-tap-btn {
    flex: 1 1 auto;
    min-width: 0;
    height: 54px;
    min-height: 54px;
    box-sizing: border-box;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: var(--radius-pill);
    padding: 0 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-secondary);
    font-size: 0.95rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }

  .metro-tap-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0px #000000;
    background: var(--btn-green-hover);
  }

  .metro-tap-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .metro-play-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    flex-shrink: 0;
    margin-left: auto;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: var(--radius-pill);
    font-size: 1.15rem;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }

  .metro-play-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0px #000000;
    background: var(--btn-green-hover);
  }

  .metro-play-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .metro-play-btn.playing {
    background: #c0392b;
    color: #ffffff;
  }

  .metro-play-btn.playing:hover {
    background: #d64a3b;
  }

  .metro-play-icon {
    display: inline-flex;
    line-height: 1;
  }

  .metro-play-btn .icon-stop {
    display: none;
  }

  .metro-play-btn.playing .icon-play {
    display: none;
  }

  .metro-play-btn.playing .icon-stop {
    display: inline-flex;
  }

  /* ---------- now playing display — reserved between two bottom buttons ---------- */
  .metro-now-playing {
    flex: 1 1 0%;
    width: 100%;
    height: 54px;
    min-height: 54px;
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    background: #1a1a1e;
    color: #f5f5f7;
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: var(--radius-pill);
    padding: 6px 10px 6px 16px;
    box-sizing: border-box;
    animation: metroTopbarIn 0.2s var(--ease-snappy);
  }

  .metro-now-playing[hidden] {
    display: none !important;
  }

  .metro-now-playing-inner {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }

  .metro-now-playing-title {
    font-family: var(--font-secondary);
    font-size: 0.84rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.1;
  }

  .metro-now-playing-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--accent-neon-yellow);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1;
  }

  .metro-now-playing-section {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 110px;
  }

  .metro-now-playing-bars {
    font-variant-numeric: tabular-nums;
    color: #a1a1aa;
    font-size: 0.66rem;
  }

  .metro-now-playing-sep {
    color: #52525b;
    font-size: 0.6rem;
  }

  .metro-now-playing-sep[hidden] {
    display: none !important;
  }

  .metro-now-playing-exit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    background: #0f0f12;
    color: #a1a1aa;
    border: 2px solid #000000;
    box-shadow: 1px 1px 0px #000000;
    border-radius: 999px;
    font-size: 0.72rem;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  .metro-now-playing-exit:hover {
    background: #c0392b;
    color: #ffffff;
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0px #000000;
  }

  .metro-now-playing-exit:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  /* ---------- coach deck button ---------- */
  .metro-coach-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    min-height: 52px;
    margin-top: 12px;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: var(--radius-pill);
    padding: 14px 18px;
    font-family: var(--font-secondary);
    font-size: 0.95rem;
    font-weight: 900;
    letter-spacing: 0.16em;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    box-sizing: border-box;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }

  .metro-coach-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0px #000000;
    background: var(--btn-green-hover);
  }

  .metro-coach-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .metro-coach-btn.is-live-hidden {
    display: none !important;
  }

  .metro-coach-btn.is-reviving {
    animation: coachBtnRevive 0.22s var(--ease-snappy);
  }

  @keyframes coachBtnRevive {
    0% {
      opacity: 0;
      transform: scale(0.96);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* ---------- sheet — matte black, warm gold accents ========== */
  .metro-sheet-backdrop {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(0, 0, 0, 0.62);
    opacity: 0;
    transition: opacity 0.22s ease;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  .metro-sheet-backdrop.open {
    opacity: 1;
  }

  .metro-sheet {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 61;
    max-height: 78vh;
    max-height: 78dvh;
    height: auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: #141418;
    color: #f5f5f7;
    border: 3px solid #000000;
    border-bottom: none;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    padding: 32px 18px 0 18px;
    transform: translateY(102%);
    transition: transform 0.24s var(--ease-snappy);
    overflow: visible;
    outline: none;
    box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.6);
    box-sizing: border-box;
  }

  .metro-sheet.open {
    padding-bottom: 0;
    overflow: visible;
    transform: translateY(0);
  }

  .metro-sheet.dragging {
    transition: none;
  }

  .metro-sheet-handle {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    flex-shrink: 0;
    z-index: 2;
  }

  .metro-sheet-handle::before {
    content: "";
    width: 36px;
    height: 4px;
    border-radius: 999px;
    background: #2a2a30;
    position: static;
  }

  .metro-sheet-panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: static;
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: calc(18px + env(safe-area-inset-bottom));
  }

  .metro-panel--settings {
    gap: 0;
    padding-bottom: 0;
    overflow: hidden;
  }

  .metro-settings-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-right: 2px;
    padding-bottom: 12px;
  }

  .metro-settings-fixed-footer {
    flex-shrink: 0;
    background: #141418;
    border-top: 2px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.35);
    padding: 12px 0 calc(12px + env(safe-area-inset-bottom));
    margin: 0 -18px;
    padding-left: 18px;
    padding-right: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .metro-settings-fixed-footer .metro-settings-copy-wrap {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .metro-settings-fixed-footer .metro-sheet-footer-card {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .metro-settings-footer {
    flex-shrink: 0;
    position: sticky;
    bottom: 0;
    padding: 12px 0 calc(12px + env(safe-area-inset-bottom));
    margin: 8px -18px 0 -18px;
    padding-left: 18px;
    padding-right: 18px;
    background: #141418;
    border-top: 2px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 -4px 16px rgba(0,0,0,0.35);
  }

  .metro-panel--coach {
    gap: 10px;
  }

  .metro-sheet-title {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-align: center;
    color: #f5f5f7;
    line-height: 1;
    z-index: 10;
    pointer-events: none;
    white-space: nowrap;
    background: #141418;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-pill);
    padding: 6px 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .metro-sheet-subtitle {
    margin: -6px 0 0;
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    text-align: left;
    color: #71717a;
  }

  .metro-sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .metro-sheet-display {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .metro-display-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 58px;
    padding: 10px 8px;
    background: #1e1e24;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    font-family: var(--font-heading);
    font-size: 1.9rem;
    font-weight: 800;
    line-height: 1;
    color: #f5f5f7;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease, border-color 0.16s ease;
  }

  .metro-display-box:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #25252e;
    border-color: rgba(216, 178, 68, 0.35);
  }

  .metro-display-slash {
    font-family: var(--font-heading);
    font-size: 1.7rem;
    font-weight: 800;
    color: #52525b;
  }

  .metro-info-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    background: #1e1e24;
    color: #a1a1aa;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-pill);
    font-size: 0.8rem;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, color 0.16s ease, background-color 0.16s ease;
  }

  .metro-info-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    color: var(--accent-neon-yellow);
    background: #25252e;
  }

  .metro-info-spacer {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
  }

  /* ---------- chips — matte black, gold active (runtime JS chips use :global) ========== */
  .metro-chip-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  :global(.metro-chip) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 6px;
    background: #1e1e24;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    font-family: var(--font-secondary);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  :global(.metro-chip:hover) {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #25252e;
  }

  :global(.metro-chip:active) {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  :global(.metro-chip.active) {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
  }

  :global(.metro-chip:focus-visible) {
    outline: 2px solid var(--accent-neon-yellow);
    outline-offset: 2px;
  }

  .metro-sound-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    padding: 4px 2px 6px;
    align-items: stretch;
    width: 100%;
    box-sizing: border-box;
  }

  .metro-sound-row :global(.metro-chip) {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-width: 0;
    width: 100%;
    min-height: 56px;
    white-space: normal;
    word-break: break-word;
    overflow-wrap: anywhere;
    text-align: center;
    font-size: 0.70rem;
    padding: 12px 8px 10px;
    letter-spacing: 0.06em;
    line-height: 1.15;
    box-sizing: border-box;
  }

  .metro-sound-row :global(.metro-chip i) {
    font-size: 1rem;
    line-height: 1;
    opacity: 0.98;
    pointer-events: none;
  }

  .metro-sound-row :global(.metro-chip span) {
    display: block;
    line-height: 1.15;
  }

  @media (min-width: 520px) {
    .metro-sound-row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .metro-sound-row :global(.metro-chip) {
      font-size: 0.68rem;
      padding: 11px 6px 10px;
      min-height: 62px;
    }
  }

  /* ---------- subdivision row ---------- */
  .metro-sub-row {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding: 4px 2px 8px;
    -webkit-overflow-scrolling: touch;
  }

  :global(.metro-sub-chip) {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    min-width: 64px;
    padding: 12px 10px 10px;
    background: #1e1e24;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  :global(.metro-sub-chip:hover) {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #25252e;
  }

  :global(.metro-sub-chip.active) {
    background: var(--accent-neon-yellow);
    color: #000000;
  }

  :global(.metro-sub-dot) {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.85;
  }

  :global(.metro-sub-label) {
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  /* ---------- setlist and songs ---------- */
  .metro-panel--setlist {
    gap: 0 !important;
    overflow: hidden !important;
    display: flex !important;
    flex-direction: column !important;
    padding-bottom: 0 !important;
    position: relative !important;
    width: 100% !important;
    max-width: 100% !important;
    min-height: 0 !important;
    height: 100% !important;
    max-height: 100% !important;
    flex: 1 1 auto !important;
    box-sizing: border-box !important;
    align-self: stretch !important;
  }

  /* ---------- 50/50 Menu Toggle (Req 3) ---------- */
  .metro-menu-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    width: 100%;
    max-width: 100%;
    margin-bottom: 12px;
    flex-shrink: 0;
    box-sizing: border-box;
    align-self: stretch;
  }

  .metro-menu-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 8px;
    background: #1e1e24;
    color: #a1a1aa;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    font-family: var(--font-secondary);
    font-size: 0.88rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  .metro-menu-nav-btn:hover {
    background: #25252e;
    color: #f5f5f7;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .metro-menu-nav-btn.active {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
    box-shadow: 2px 2px 0px #000000;
  }

  .metro-setlist-content-area {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    position: relative;
    box-sizing: border-box;
    align-self: stretch;
  }

  .metro-view-pane {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    max-width: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 12px;
    box-sizing: border-box;
    overscroll-behavior: contain;
  }

  @media (min-width: 769px) and (pointer: fine) {
    .metro-view-pane {
      scrollbar-gutter: stable;
    }
  }

  .metro-view-pane[hidden] {
    display: none !important;
  }

  /* Subview Header */
  .metro-subview-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    position: sticky;
    top: 0;
    z-index: 5;
    background: #141418;
    margin: -8px -18px 12px -18px;
    padding: 8px 18px 10px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
  }

  .metro-nav-back-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: #1e1e24;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-pill);
    font-size: 0.85rem;
    cursor: pointer;
    flex-shrink: 0;
    touch-action: manipulation;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  .metro-nav-back-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #25252e;
    color: var(--accent-neon-yellow);
  }

  .metro-nav-back-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .metro-subview-title {
    margin: 0;
    font-family: var(--font-secondary);
    font-size: 0.95rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-neon-yellow);
    text-align: center;
    flex: 1 1 auto;
    min-width: 0;
    max-width: 100%;
    line-height: 1.25;
    word-break: break-word;
    overflow-wrap: anywhere;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
  }

  @media (max-width: 380px) {
    .metro-subview-title {
      font-size: 0.85rem;
      letter-spacing: 0.06em;
    }
  }

  .metro-subview-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-pill);
    font-size: 0.8rem;
    cursor: pointer;
    flex-shrink: 0;
    touch-action: manipulation;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }

  .metro-subview-action-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: var(--btn-green-hover);
  }

  .metro-subview-action-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  /* Setlists List Cards (Level 1) */
  .metro-setlists-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 4px;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    align-self: stretch;
  }

  :global(.metro-setlist-empty) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 32px 16px;
    gap: 8px;
    background: rgba(30, 30, 36, 0.4);
    border: 2px dashed rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    margin: 8px 0;
    box-sizing: border-box;
  }

  :global(.metro-setlist-empty-icon) {
    font-size: 2rem;
    color: #71717a;
    margin-bottom: 4px;
  }

  :global(.metro-setlist-empty-title) {
    font-family: var(--font-secondary);
    font-size: 0.88rem;
    font-weight: 900;
    color: #f5f5f7;
    letter-spacing: 0.08em;
    margin: 0;
    text-transform: uppercase;
  }

  :global(.metro-setlist-empty-sub) {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    color: #a1a1aa;
    max-width: 300px;
    line-height: 1.4;
    margin: 0 0 8px 0;
  }

  :global(.metro-setlist-empty-cta) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 9px 18px;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    cursor: pointer;
    touch-action: manipulation;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease, color 0.16s ease;
  }

  :global(.metro-setlist-empty-cta:hover) {
    background: var(--btn-green-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  :global(.metro-setlist-empty-cta:active) {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  :global(.metro-setlist-card) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 14px;
    background: #1e1e24;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    cursor: pointer;
    text-align: left;
    touch-action: manipulation;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease, border-color 0.16s ease;
  }

  :global(.metro-setlist-card:hover) {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #25252e;
  }

  :global(.metro-setlist-card.active-setlist) {
    border-color: var(--accent-neon-yellow);
    background: #252522;
    box-shadow: 0 0 0 1px var(--accent-neon-yellow), 2px 2px 0px #000000;
  }

  :global(.metro-setlist-card-info) {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1 1 auto;
    min-width: 0;
  }

  :global(.metro-setlist-card-title) {
    font-family: var(--font-secondary);
    font-size: 0.94rem;
    font-weight: 800;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.metro-setlist-card-meta) {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    color: #a1a1aa;
    font-weight: 700;
  }

  :global(.metro-setlist-card-badge) {
    background: #0f0f12;
    color: var(--accent-neon-yellow);
    border: 1px solid rgba(216, 178, 68, 0.3);
    padding: 1px 6px;
    border-radius: var(--radius-pill);
    font-size: 0.65rem;
  }

  :global(.metro-setlist-card-actions) {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  :global(.metro-setlist-card-play-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 999px;
    font-size: 0.72rem;
    cursor: pointer;
    touch-action: manipulation;
    flex-shrink: 0;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }

  :global(.metro-setlist-card-play-btn:hover) {
    background: var(--btn-green-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  :global(.metro-setlist-card-play-btn:active) {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  :global(.metro-setlist-card-del-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: #1a1a1e;
    color: #ff6b6b;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-pill);
    font-size: 0.74rem;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease;
  }

  :global(.metro-setlist-card-del-btn:hover) {
    background: #c0392b;
    color: #ffffff;
  }

  /* Setlist Detail View (Level 2) */
  .metro-setlist-detail-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 4px 0 10px;
  }

  .metro-setlist-detail-count {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    color: #a1a1aa;
    letter-spacing: 0.08em;
  }

  .metro-setlist-detail-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .metro-setlist-detail-edit-name-btn,
  .metro-setlist-detail-add-song-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    background: #1e1e24;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 800;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease;
  }

  .metro-setlist-detail-add-song-btn {
    background: var(--accent-neon-yellow);
    color: #000000;
  }

  .metro-setlist-detail-add-song-btn:hover {
    background: var(--btn-green-hover);
  }

  .metro-setlist-detail-songs {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    align-self: stretch;
  }

  :global(.metro-setlist-song-row) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    background: #1e1e24;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    position: relative;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease, border-color 0.16s ease, opacity 0.16s ease;
  }

  :global(.metro-setlist-song-row:hover) {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #25252e;
  }

  :global(.metro-setlist-song-row:active) {
    cursor: grabbing;
  }

  :global(.metro-setlist-song-row.active-loaded) {
    border-color: var(--accent-neon-yellow);
    background: #252522;
    box-shadow: 0 0 0 1px var(--accent-neon-yellow), 2px 2px 0px #000000;
  }

  :global(.metro-setlist-song-row.is-dragging) {
    opacity: 0.96;
    z-index: 100;
    box-shadow: 4px 8px 0px #000000;
    cursor: grabbing;
    background: #25252e;
    border-color: var(--accent-neon-yellow);
    pointer-events: none;
    will-change: transform;
    transition: none;
  }

  :global(.metro-setlist-song-row.drag-placeholder),
  :global(.metro-setlist-song-row.drop-placeholder-slot) {
    background: var(--accent-gold-dashed-bg, rgba(242, 253, 67, 0.22)) !important;
    border: 2px dashed var(--accent-gold-dashed-border, var(--accent-neon-yellow)) !important;
    box-shadow: none !important;
    border-radius: var(--radius-sm, 6px);
    pointer-events: none;
    box-sizing: border-box;
    transition: transform 0.16s var(--ease-tactile), opacity 0.16s ease, background-color 0.16s ease, border-color 0.16s ease;
  }

  :global(.metro-setlist-song-num) {
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 900;
    color: var(--accent-neon-yellow);
    min-width: 28px;
    text-align: center;
    flex-shrink: 0;
    letter-spacing: 0.04em;
  }

  :global(.metro-setlist-song-info) {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1 1 auto;
    min-width: 0;
  }

  :global(.metro-setlist-song-title) {
    font-family: var(--font-secondary);
    font-size: 0.9rem;
    font-weight: 800;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0.01em;
    line-height: 1.2;
  }

  :global(.metro-setlist-song-sub) {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    color: #a1a1aa;
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }

  :global(.metro-setlist-song-countin-btn) {
    display: none !important;
  }

  :global(.metro-setlist-song-countin-btn.is-active) {
    display: none !important;
  }

  :global(.metro-setlist-song-ctrls) {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  :global(.metro-reorder-btn) {
    display: none !important;
  }

  :global(.metro-setlist-song-drag-handle) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: transparent;
    color: #71717a;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 0.82rem;
    cursor: grab;
    touch-action: none;
    flex-shrink: 0;
    transition: color 0.16s ease, background-color 0.16s ease, border-color 0.16s ease, transform 0.12s ease;
  }

  :global(.metro-setlist-song-drag-handle:hover) {
    color: var(--accent-neon-yellow);
    background: #0f0f12;
    border-color: rgba(216, 178, 68, 0.25);
  }

  :global(.metro-setlist-song-drag-handle:active) {
    cursor: grabbing;
    color: var(--accent-neon-yellow);
    background: #25252e;
    transform: scale(0.96);
  }

  :global(.metro-setlist-song-remove-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: #1a1a1e;
    color: #ff6b6b;
    border: 2px solid #000000;
    box-shadow: 1px 1px 0px #000000;
    border-radius: 999px;
    font-size: 0.72rem;
    cursor: pointer;
    touch-action: manipulation;
    flex-shrink: 0;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  :global(.metro-setlist-song-remove-btn:hover) {
    background: #c0392b;
    color: #ffffff;
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0px #000000;
  }

  /* ---------- songs list & rows ---------- */
  .metro-setlist-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 4px;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    align-self: stretch;
  }

  :global(.metro-setlist-row-wrap) {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
  }

  :global(.metro-setlist-row) {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1 1 auto;
    min-width: 0;
    padding: 10px 12px;
    background: #1e1e24;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    cursor: pointer;
    text-align: left;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease, border-color 0.16s ease;
  }

  :global(.metro-setlist-row:hover) {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #25252e;
  }

  :global(.metro-setlist-row.active-loaded) {
    border-color: var(--accent-neon-yellow);
    background: #252522;
    box-shadow: 0 0 0 1px var(--accent-neon-yellow), 2px 2px 0px #000000;
  }

  :global(.metro-setlist-bpm) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 52px;
    padding: 8px 6px;
    background: #0f0f12;
    color: var(--accent-neon-yellow);
    border: 1px solid rgba(216, 178, 68, 0.25);
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  :global(.metro-setlist-text) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1 1 auto;
    min-width: 0;
  }

  :global(.metro-setlist-title-wrap) {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  :global(.metro-setlist-title) {
    font-family: var(--font-secondary);
    font-size: 0.92rem;
    font-weight: 800;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.metro-setlist-meta-row) {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    color: #a1a1aa;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.metro-setlist-artist) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.metro-setlist-tag) {
    display: inline-flex;
    align-items: center;
    padding: 1px 5px;
    background: #0f0f12;
    color: #a1a1aa;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-pill);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  :global(.metro-setlist-load) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 999px;
    font-size: 0.7rem;
    flex-shrink: 0;
    cursor: pointer;
    touch-action: manipulation;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }

  :global(.metro-setlist-load:hover) {
    background: var(--btn-green-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  :global(.metro-setlist-load:active) {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  :global(.metro-setlist-edit-btn),
  :global(.metro-setlist-delete) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    background: #1e1e24;
    border: 2px solid #000;
    box-shadow: 2px 2px 0 #000;
    border-radius: var(--radius-pill);
    font-size: 0.78rem;
    cursor: pointer;
    touch-action: manipulation;
    transition: background-color 0.16s ease, transform 0.16s var(--ease-tactile), color 0.16s ease, box-shadow 0.16s ease;
  }

  :global(.metro-setlist-edit-btn) {
    color: var(--accent-neon-yellow);
  }

  :global(.metro-setlist-edit-btn:hover) {
    background: var(--accent-neon-yellow);
    color: #000;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 #000;
  }

  :global(.metro-setlist-delete) {
    color: #ff6b6b;
  }

  :global(.metro-setlist-delete:hover) {
    background: #c0392b;
    color: #fff;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 #000;
  }

  /* Songs header — sticky so filters never scroll away */
  .metro-setlist-header {
    position: sticky;
    top: 0;
    z-index: 6;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: calc(100% + 36px);
    max-width: calc(100% + 36px);
    margin: 0 -18px 10px -18px;
    padding: 10px 18px 12px 18px;
    background: #141418;
    border-bottom: 2px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    box-sizing: border-box;
    flex-shrink: 0;
  }

  .metro-songs-browse-view {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    align-self: stretch;
    gap: 0;
  }

  .metro-songs-browse-view .metro-setlist-list,
  .metro-songs-browse-view .metro-setlist-external {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  /* Song Categories (Req 3) — inside sticky header, always visible */
  .metro-setlist-filters {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 2px 2px 4px;
    -webkit-overflow-scrolling: touch;
    flex-shrink: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .metro-setlist-filters::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .metro-setlist-filter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    flex: 0 0 auto;
    min-width: 80px;
    padding: 8px 12px;
    background: #1e1e24;
    color: #a1a1aa;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    cursor: pointer;
    white-space: nowrap;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }

  .metro-setlist-filter:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #25252e;
    color: #f5f5f7;
  }

  .metro-setlist-filter.active {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
    box-shadow: 2px 2px 0px #000000;
  }

  .metro-setlist-filter.active:hover {
    background: var(--btn-green-hover);
  }

  /* Sort Bar — inside sticky header */
  .metro-setlist-sort-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 2px 2px 2px;
    -webkit-overflow-scrolling: touch;
    flex-shrink: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .metro-setlist-sort-bar::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .metro-setlist-sort-label {
    font-family: var(--font-secondary);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #71717a;
    margin-right: 2px;
  }

  .metro-setlist-sort-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    background: #0f0f12;
    color: #a1a1aa;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    cursor: pointer;
    white-space: nowrap;
    touch-action: manipulation;
    transition: background-color 0.16s ease, color 0.16s ease, border-color 0.16s ease, transform 0.16s var(--ease-tactile);
  }

  .metro-setlist-sort-chip:hover {
    background: #1e1e24;
    color: #f5f5f7;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .metro-setlist-sort-chip.active {
    background: #25252e;
    color: var(--accent-neon-yellow);
    border-color: var(--accent-neon-yellow);
  }

  /* Song Edit Tabs */
  .metro-song-edit-tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 12px;
  }

  .metro-setlist-add-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 10px 12px;
    background: #1e1e24;
    color: #a1a1aa;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    font-family: var(--font-secondary);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }

  .metro-setlist-add-tab:hover {
    background: #25252e;
    color: #f5f5f7;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .metro-setlist-add-tab.active {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
    box-shadow: 2px 2px 0px #000000;
  }

  .metro-setlist-add-tab.active:hover {
    background: var(--btn-green-hover);
  }

  .metro-setlist-add-tab:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .metro-song-edit-pane {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .metro-song-edit-pane[hidden] {
    display: none !important;
  }

  /* Song Structure Builder (Req 6) */
  .metro-structure-builder {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 8px;
    padding-top: 10px;
    border-top: 2px dashed rgba(255, 255, 255, 0.1);
  }

  .metro-structure-builder-head {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .metro-structure-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .metro-structure-summary {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--accent-neon-yellow);
    letter-spacing: 0.06em;
  }

  .metro-structure-sub {
    margin: 0;
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    color: #71717a;
    line-height: 1.3;
  }

  .metro-structure-deck {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    white-space: nowrap;
    gap: 10px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 6px 4px 14px;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x proximity;
    align-items: stretch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
  }

  .metro-structure-deck::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  @media (min-width: 769px) and (pointer: fine) {
    .metro-structure-deck {
      scrollbar-width: thin;
      scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
    }

    .metro-structure-deck::-webkit-scrollbar {
      display: block;
      height: 6px;
    }

    .metro-structure-deck::-webkit-scrollbar-track {
      background: #141418;
      border-radius: 999px;
    }

    .metro-structure-deck::-webkit-scrollbar-thumb {
      background: var(--scrollbar-thumb);
      border-radius: 999px;
    }

    .metro-structure-deck::-webkit-scrollbar-thumb:hover {
      background: var(--scrollbar-thumb-hover);
    }
  }

  :global(.metro-structure-card) {
    display: inline-flex;
    flex-direction: column;
    gap: 8px;
    min-width: 220px;
    max-width: 260px;
    width: 240px;
    flex: 0 0 240px;
    scroll-snap-align: start;
    background: #141418;
    border: 2px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: var(--radius-sm, 6px);
    padding: 10px 12px;
    box-sizing: border-box;
    position: relative;
    white-space: normal;
    transition: transform 0.16s var(--ease-tactile), border-color 0.16s ease, background-color 0.16s ease, box-shadow 0.16s ease;
  }

  :global(.metro-structure-card:hover) {
    border-color: rgba(242, 253, 67, 0.4);
    transform: translateY(-1px);
    box-shadow: 4px 4px 0px #000000;
  }

  :global(.metro-structure-card.is-active) {
    border-color: var(--accent-neon-yellow);
    background: #1c1c22;
    box-shadow: 0 0 0 1px var(--accent-neon-yellow), 4px 4px 0px #000000;
  }

  :global(.metro-structure-card.is-active) :global(.metro-structure-card-pos) {
    color: var(--accent-neon-yellow);
    font-weight: 900;
  }

  :global(.metro-structure-card-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  :global(.metro-structure-card-name-input) {
    flex: 1 1 auto;
    min-width: 0;
    background: #1e1e24;
    color: #f5f5f7;
    border: 1px solid #000;
    border-radius: 4px;
    padding: 4px 6px;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    outline: none;
    transition: border-color 0.14s ease, background-color 0.14s ease;
  }

  :global(.metro-structure-card-name-input:focus) {
    border-color: var(--accent-neon-yellow);
    background: #25252e;
  }

  :global(.metro-structure-card-del-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: transparent;
    color: #ff6b6b;
    border: 1px solid rgba(255, 107, 107, 0.3);
    border-radius: 50%;
    font-size: 0.65rem;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 0.14s ease, color 0.14s ease, border-color 0.14s ease, transform 0.12s ease;
  }

  :global(.metro-structure-card-del-btn:hover) {
    background: #c0392b;
    color: #ffffff;
    border-color: #c0392b;
  }

  :global(.metro-structure-card-del-btn:active) {
    transform: scale(0.92);
  }

  :global(.metro-structure-card-row) {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    gap: 6px;
  }

  :global(.metro-structure-card-field) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1 1 0;
    min-width: 0;
  }

  :global(.metro-structure-card-field-label) {
    font-family: var(--font-secondary);
    font-size: 0.52rem;
    font-weight: 800;
    color: #a1a1aa;
    letter-spacing: 0.05em;
    line-height: 1.1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.metro-structure-card-num-input),
  :global(.metro-structure-card-select) {
    background: #1e1e24;
    color: var(--accent-neon-yellow);
    border: 1px solid #000;
    border-radius: 4px;
    padding: 4px 5px;
    font-family: var(--font-secondary);
    font-size: 0.70rem;
    font-weight: 800;
    outline: none;
    width: 100%;
    box-sizing: border-box;
    transition: border-color 0.14s ease, background-color 0.14s ease;
  }

  :global(.metro-structure-card-num-input:focus),
  :global(.metro-structure-card-select:focus) {
    border-color: var(--accent-neon-yellow);
    background: #25252e;
  }

  :global(.metro-structure-card-footer) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(.metro-structure-card-pos) {
    font-family: var(--font-heading);
    font-size: 0.64rem;
    font-weight: 800;
    color: #71717a;
    transition: color 0.14s ease;
  }

  :global(.metro-structure-card-nav-btns) {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  :global(.metro-structure-reorder-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: #1e1e24;
    color: #f5f5f7;
    border: 1px solid #000000;
    border-radius: 4px;
    font-size: 0.65rem;
    cursor: pointer;
    box-shadow: 1px 1px 0px #000000;
    transition: transform 0.12s var(--ease-tactile), background-color 0.14s ease, color 0.14s ease, border-color 0.14s ease, box-shadow 0.12s ease;
  }

  :global(.metro-structure-reorder-btn:hover:not(:disabled)) {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0px #000000;
  }

  :global(.metro-structure-reorder-btn:active:not(:disabled)) {
    transform: translate(1px, 1px);
    box-shadow: 0 0 0 #000000;
  }

  :global(.metro-structure-reorder-btn:disabled) {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .metro-structure-quick-add {
    display: flex;
    align-items: center;
    gap: 6px;
    overflow-x: auto;
    padding: 2px 2px 6px;
    -webkit-overflow-scrolling: touch;
  }

  .metro-structure-quick-label {
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 800;
    color: #71717a;
    letter-spacing: 0.06em;
    flex-shrink: 0;
  }

  .metro-structure-preset-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 12px;
    background: #1e1e24;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    touch-action: manipulation;
    transition: transform 0.12s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.12s ease;
  }

  .metro-structure-preset-btn:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .metro-structure-preset-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .metro-structure-preset-btn--custom {
    background: #181820;
    border-color: var(--accent-neon-yellow);
    color: var(--accent-neon-yellow);
  }

  .metro-structure-preset-btn--custom:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
  }

  .metro-structure-preview {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #0f0f12;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    padding: 6px 10px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .metro-structure-preview-label {
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 900;
    color: #71717a;
    letter-spacing: 0.08em;
    flex-shrink: 0;
  }

  .metro-structure-preview-flow {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    color: var(--accent-neon-yellow);
    font-weight: 800;
    white-space: nowrap;
  }

  /* Fixed Bottom Dock — Add left corner, Search right corner (expands full width on click) */
  .metro-bottom-fixed-dock {
    position: relative;
    flex-shrink: 0;
    width: calc(100% + 36px);
    max-width: calc(100% + 36px);
    margin: auto -18px 0 -18px;
    align-self: stretch;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: #141418;
    border-top: 2px solid #000000;
    padding: 10px 18px calc(10px + env(safe-area-inset-bottom));
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.4);
    box-sizing: border-box;
    transition: background-color 0.16s ease;
  }

  .metro-bottom-search-col {
    flex: 0 0 auto;
    width: auto;
    min-width: 0;
    order: 2;
    margin-left: auto;
    transition: flex 0.2s var(--ease-snappy), width 0.2s var(--ease-snappy);
  }

  .metro-bottom-add-col {
    flex: 0 0 auto;
    width: auto;
    min-width: 0;
    order: 1;
    transition: opacity 0.16s ease, transform 0.16s ease;
  }

  .metro-bottom-fixed-dock.is-search-expanded .metro-bottom-add-col {
    display: none !important;
  }

  .metro-bottom-fixed-dock.is-search-expanded .metro-bottom-search-col {
    flex: 1 1 100%;
    width: 100%;
    margin-left: 0;
  }

  .metro-bottom-search-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: #1e1e24;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-pill);
    padding: 0;
    box-sizing: border-box;
    transition: width 0.2s var(--ease-snappy), border-color 0.16s ease, box-shadow 0.16s ease, background-color 0.16s ease, transform 0.12s var(--ease-tactile);
    overflow: hidden;
  }

  .metro-bottom-search-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    padding: 0;
    color: #f5f5f7;
    cursor: pointer;
    flex-shrink: 0;
    font-size: 0.88rem;
  }

  .metro-bottom-search-toggle-btn:hover {
    color: var(--accent-neon-yellow);
  }

  .metro-bottom-search-pill .metro-bottom-search-input,
  .metro-bottom-search-pill .metro-bottom-search-clear,
  .metro-bottom-search-pill .metro-bottom-search-close {
    display: none;
  }

  .metro-bottom-search-pill:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #25252e;
  }

  /* Expanded full width state */
  .metro-bottom-fixed-dock.is-search-expanded .metro-bottom-search-pill,
  .metro-bottom-search-pill.expanded {
    width: 100%;
    max-width: 100%;
    padding: 0 10px 0 12px;
    gap: 8px;
    justify-content: flex-start;
    background: #1e1e24;
    border-color: var(--accent-neon-yellow);
    box-shadow: 3px 3px 0px #000000;
    cursor: default;
    transform: none;
  }

  .metro-bottom-fixed-dock.is-search-expanded .metro-bottom-search-input,
  .metro-bottom-search-pill.expanded .metro-bottom-search-input {
    display: block !important;
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: #f5f5f7;
    font-family: var(--font-secondary);
    font-size: 0.86rem;
    font-weight: 700;
    padding: 0;
  }

  .metro-bottom-fixed-dock.is-search-expanded .metro-bottom-search-toggle-btn,
  .metro-bottom-search-pill.expanded .metro-bottom-search-toggle-btn {
    width: auto;
    height: auto;
    cursor: default;
    pointer-events: none;
    color: var(--accent-neon-yellow);
  }

  .metro-bottom-search-clear,
  .metro-bottom-search-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: #141418;
    color: #a1a1aa;
    border: 1.5px solid #000000;
    box-shadow: 1px 1px 0px #000000;
    border-radius: 50%;
    font-size: 0.68rem;
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
    transition: transform 0.12s var(--ease-tactile), background-color 0.12s ease, color 0.12s ease;
  }

  .metro-bottom-search-clear:hover,
  .metro-bottom-search-close:hover {
    background: #ff6b6b;
    color: #ffffff;
    transform: scale(1.08);
  }

  .metro-bottom-fixed-dock.is-search-expanded .metro-bottom-search-close {
    display: inline-flex !important;
  }

  /* Improved ADD button — left corner, bolder brutalist with icon wrap */
  .metro-bottom-add-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 44px;
    padding: 0 18px;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease, color 0.16s ease;
  }

  .metro-bottom-add-btn:hover {
    background: var(--btn-green-hover);
    transform: translate(-1.5px, -1.5px);
    box-shadow: 4.5px 4.5px 0px #000000;
  }

  .metro-bottom-add-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .metro-add-icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: #000000;
    color: var(--accent-neon-yellow);
    border-radius: 50%;
    font-size: 0.65rem;
    flex-shrink: 0;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .metro-bottom-add-btn:hover .metro-add-icon-wrap {
    transform: rotate(90deg);
    background: #111111;
  }

  /* Song Picker Modal */
  .metro-picker-modal {
    position: absolute;
    inset: 0;
    z-index: 20;
    background: rgba(0, 0, 0, 0.75);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
  }

  .metro-picker-modal[hidden] {
    display: none !important;
  }

  .metro-picker-card {
    width: 100%;
    max-width: 420px;
    max-height: 80vh;
    background: #141418;
    border: 3px solid #000000;
    box-shadow: 4px 4px 0px #000000;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .metro-picker-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    border-bottom: 2px solid #000000;
    background: #1e1e24;
  }

  .metro-picker-title {
    margin: 0;
    font-family: var(--font-secondary);
    font-size: 0.84rem;
    font-weight: 900;
    color: var(--accent-neon-yellow);
    letter-spacing: 0.08em;
  }

  .metro-picker-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: #0f0f12;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 50%;
    cursor: pointer;
    touch-action: manipulation;
    transition: background-color 0.16s ease, color 0.16s ease, transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
  }

  .metro-picker-close:hover {
    background: #ef4444;
    color: #ffffff;
    transform: scale(1.06);
    box-shadow: 3px 3px 0px #000000;
  }

  .metro-picker-close:active {
    transform: scale(0.96);
    box-shadow: 1px 1px 0px #000000;
  }

  .metro-picker-search-wrap {
    display: flex;
    align-items: center;
    margin: 8px 12px;
    padding: 0 14px;
    height: 40px;
    background: #0f0f12;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 999px;
    box-sizing: border-box;
    transition: border-color 0.16s ease;
  }

  .metro-picker-search-wrap:focus-within {
    border-color: var(--accent-neon-yellow);
  }

  .metro-picker-search-icon {
    color: #71717a;
    font-size: 0.8rem;
    margin-right: 8px;
  }

  .metro-picker-search-input {
    flex: 1 1 auto;
    background: transparent;
    border: none;
    outline: none;
    color: #f5f5f7;
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .metro-picker-list {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: 8px 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 40vh;
  }

  :global(.metro-picker-item) {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    background: #1e1e24;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background-color 0.16s ease, border-color 0.16s ease;
  }

  :global(.metro-picker-item:hover) {
    background: #25252e;
    border-color: var(--accent-neon-yellow);
  }

  :global(.metro-picker-item-checkbox) {
    width: 18px;
    height: 18px;
    accent-color: var(--accent-neon-yellow);
    cursor: pointer;
  }

  :global(.metro-picker-item-info) {
    flex: 1 1 auto;
    min-width: 0;
  }

  :global(.metro-picker-item-title) {
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 800;
    color: #f5f5f7;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.metro-picker-item-sub) {
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    color: #a1a1aa;
  }

  .metro-picker-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-top: 2px solid #000000;
    background: #1e1e24;
  }

  .metro-picker-selected-count {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    color: #a1a1aa;
  }

  .metro-picker-confirm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 9px 18px;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    cursor: pointer;
    touch-action: manipulation;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }

  .metro-picker-confirm-btn:hover {
    background: var(--btn-green-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  .metro-picker-confirm-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  /* Web lookup results in song editor */
  .metro-setlist-web-search-box {
    display: flex;
    align-items: center;
    background: #1e1e24;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: 999px;
    padding: 0 14px;
    height: 44px;
    box-sizing: border-box;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
    overflow: hidden;
  }

  .metro-setlist-web-search-box:focus-within {
    border-color: var(--accent-neon-yellow);
  }

  .metro-setlist-web-search-icon {
    font-size: 0.82rem;
    color: #71717a;
    margin-right: 10px;
    flex-shrink: 0;
  }

  .metro-setlist-web-search-input {
    flex: 1 1 auto;
    background: transparent;
    border: none;
    outline: none;
    color: #f5f5f7;
    font-family: var(--font-secondary);
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 44px;
    padding: 0;
  }

  .metro-setlist-search-clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: #0f0f12;
    color: #a1a1aa;
    border: 1px solid #000000;
    border-radius: 50%;
    font-size: 0.7rem;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 0.16s ease, color 0.16s ease;
  }

  .metro-setlist-search-clear:hover {
    background: #25252e;
    color: #f5f5f7;
  }

  .metro-setlist-web-results {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 340px;
    overflow-y: auto;
    padding: 4px 2px 10px;
    -webkit-overflow-scrolling: touch;
  }

  :global(.metro-web-result-card) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    background: #1e1e24;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    color: #f5f5f7;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }

  :global(.metro-web-result-card:hover) {
    background: #25252e;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  :global(.metro-web-result-info) {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1 1 auto;
  }

  :global(.metro-web-result-title) {
    font-family: var(--font-secondary);
    font-size: 0.88rem;
    font-weight: 800;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.metro-web-result-meta) {
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    color: #a1a1aa;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.metro-web-result-import-btn) {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    cursor: pointer;
    flex-shrink: 0;
    touch-action: manipulation;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }

  :global(.metro-web-result-import-btn:hover) {
    background: var(--btn-green-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
  }

  :global(.metro-web-result-import-btn:active) {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  /* Custom song form */
  .metro-custom-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #1e1e24;
    border: 2px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: var(--radius-md);
    padding: 16px 14px;
  }

  .metro-custom-field {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .metro-custom-field--checkbox {
    flex-direction: row;
    align-items: center;
  }

  .metro-checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    color: #f5f5f7;
    cursor: pointer;
  }

  .metro-checkbox {
    width: 18px;
    height: 18px;
    accent-color: var(--accent-neon-yellow);
    cursor: pointer;
  }

  .metro-custom-label {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #a1a1aa;
  }

  .metro-custom-input,
  .metro-custom-select {
    width: 100%;
    box-sizing: border-box;
    background: #0f0f12;
    color: #f5f5f7;
    border: 2px solid #000;
    box-shadow: 1px 1px 0 #000;
    border-radius: var(--radius-md);
    padding: 10px 12px;
    font-family: var(--font-secondary);
    font-size: 0.88rem;
    font-weight: 700;
    outline: none;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }

  .metro-custom-input:focus,
  .metro-custom-select:focus {
    border-color: var(--accent-neon-yellow);
    box-shadow: 0 0 0 2px rgba(216, 178, 68, 0.18), 1px 1px 0 #000;
  }

  .metro-custom-input--error {
    border-color: #c0392b !important;
  }

  .metro-custom-error {
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    color: #ff6b6b;
    font-weight: 700;
  }

  .metro-custom-error[hidden] {
    display: none !important;
  }

  .metro-custom-bpm-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .metro-custom-bpm-input {
    flex: 1 1 auto;
    min-width: 0;
  }

  .metro-custom-helper-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 42px;
    padding: 0 12px;
    background: #0f0f12;
    color: var(--accent-neon-yellow);
    border: 2px solid #000;
    box-shadow: 2px 2px 0 #000;
    border-radius: var(--radius-md);
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    touch-action: manipulation;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }

  .metro-custom-helper-btn:hover {
    background: #25252e;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 #000;
  }

  .metro-custom-tap-btn {
    background: var(--accent-neon-yellow);
    color: #000;
  }

  .metro-custom-tap-btn:hover {
    background: var(--btn-green-hover);
  }

  .metro-custom-tap-btn:active {
    transform: scale(0.96);
  }

  .metro-custom-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .metro-custom-actions {
    display: flex;
    gap: 10px;
    margin-top: 4px;
  }

  .metro-custom-cancel {
    padding: 12px 16px;
    background: #0f0f12;
    color: #f5f5f7;
    border: 2px solid #000;
    box-shadow: 2px 2px 0 #000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 800;
    cursor: pointer;
    transition: background-color 0.16s ease, transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
  }

  .metro-custom-cancel:hover {
    background: #25252e;
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 #000;
  }

  .metro-custom-submit {
    flex: 1 1 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 18px;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000;
    box-shadow: 2px 2px 0 #000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background-color 0.16s ease, transform 0.16s var(--ease-tactile), box-shadow 0.16s ease;
  }

  .metro-custom-submit:hover {
    background: var(--btn-green-hover);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 #000;
  }

  .metro-custom-submit:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 #000;
  }

  /* external search results */
  .metro-setlist-external {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 2px dashed rgba(255, 255, 255, 0.08);
  }

  .metro-setlist-external[hidden] {
    display: none !important;
  }

  :global(.metro-setlist-external-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #a1a1aa;
  }

  :global(.metro-setlist-external-row) {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px 12px;
    background: #1e1e24;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    cursor: pointer;
    text-align: left;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease;
  }

  :global(.metro-setlist-external-row:hover) {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #25252e;
  }

  :global(.metro-setlist-external-art) {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    border: 1px solid #000;
    flex-shrink: 0;
    background: #0f0f12;
  }

  :global(.metro-setlist-external-text) {
    display: flex;
    flex-direction: column;
    gap: 1px;
    flex: 1 1 auto;
    min-width: 0;
  }

  :global(.metro-setlist-external-title) {
    font-family: var(--font-secondary);
    font-size: 0.88rem;
    font-weight: 800;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.metro-setlist-external-artist) {
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    color: #a1a1aa;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.metro-setlist-external-add) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 7px 12px;
    background: var(--accent-neon-yellow);
    color: #000;
    border: 2px solid #000;
    box-shadow: 1px 1px 0 #000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    flex-shrink: 0;
    transition: background-color 0.16s ease, transform 0.16s var(--ease-tactile);
  }

  :global(.metro-setlist-external-add:hover) {
    background: var(--btn-green-hover);
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0 #000;
  }

  :global(.metro-setlist-loading) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 18px;
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 700;
    color: #a1a1aa;
  }

  :global(.metro-setlist-loading i) {
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  :global(.metro-setlist-search-highlight) {
    background: rgba(216, 178, 68, 0.22);
    padding: 0 1px;
    border-radius: 2px;
  }

  /* ---------- settings — volume, beat style, toggles ========== */
  .metro-settings-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: 10px;
  }

  .metro-settings-header-row .metro-settings-label {
    margin: 0;
  }

  .metro-settings-info-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    background: #1e1e24;
    color: #a1a1aa;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-pill);
    font-size: 0.65rem;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, color 0.16s ease, background-color 0.16s ease;
  }

  .metro-settings-info-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    color: var(--accent-neon-yellow);
    background: #25252e;
  }

  .metro-settings-label {
    margin: 4px 0 0;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    color: #a1a1aa;
  }

  .metro-volume-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .metro-volume-wrap input[type="range"] {
    flex: 1;
  }

  .metro-volume-value {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--accent-neon-yellow);
    min-width: 3.2ch;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /* styled range — gold thumb, dark track */
  #metroVolume {
    width: 100%;
    height: 8px;
    -webkit-appearance: none;
    appearance: none;
    background: #1e1e24;
    border-radius: 999px;
    border: 2px solid #000000;
    outline: none;
    margin: 6px 0 4px;
    accent-color: var(--accent-neon-yellow);
  }

  #metroVolume::-webkit-slider-runnable-track {
    height: 8px;
    background: #1e1e24;
    border-radius: 999px;
  }

  #metroVolume::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    margin-top: -8px;
    border-radius: 50%;
    background: var(--accent-neon-yellow);
    border: 2px solid #000000;
    box-shadow: 1px 1px 0px #000000;
    cursor: pointer;
    transition: transform 0.12s var(--ease-tactile), background-color 0.12s ease;
  }

  #metroVolume::-webkit-slider-thumb:hover {
    transform: scale(1.1);
    background: var(--btn-green-hover);
  }

  #metroVolume::-moz-range-track {
    height: 8px;
    background: #1e1e24;
    border-radius: 999px;
    border: 2px solid #000000;
  }

  #metroVolume::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--accent-neon-yellow);
    border: 2px solid #000000;
    box-shadow: 1px 1px 0px #000000;
    cursor: pointer;
  }

  /* beat style segmented control */
  .metro-beatstyle-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .metro-beatstyle-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 10px;
    background: #1e1e24;
    color: #a1a1aa;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }

  .metro-beatstyle-chip:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    color: #f5f5f7;
    background: #25252e;
  }

  .metro-beatstyle-chip.active {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
  }

  .metro-beatstyle-chip:focus-visible {
    outline: 2px solid var(--accent-neon-yellow);
    outline-offset: 2px;
  }

  /* settings toggle buttons — 2 per row (2×2 grid) */
  .metro-settoggle-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin-top: 10px;
  }

  .metro-settoggle {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 4px;
    background: #1e1e24;
    color: #a1a1aa;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    font-family: var(--font-secondary);
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }

  .metro-settoggle i {
    font-size: 0.95rem;
    line-height: 1;
  }

  .metro-settoggle:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    color: #f5f5f7;
    background: #25252e;
  }

  .metro-settoggle.active {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
  }

  .metro-settoggle:focus-visible {
    outline: 2px solid var(--accent-neon-yellow);
    outline-offset: 2px;
  }

  .metro-toggle-row {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 10px;
  }

  .metro-toggle {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
  }

  .metro-toggle input {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    inset: 0;
    cursor: pointer;
    z-index: 1;
    margin: 0;
  }

  .metro-toggle-track {
    display: inline-flex;
    align-items: center;
    width: 46px;
    height: 26px;
    flex-shrink: 0;
    padding: 2px;
    box-sizing: border-box;
    background: #1e1e24;
    border: 2px solid #000000;
    border-radius: var(--radius-pill);
    transition: background-color 0.16s ease, border-color 0.16s ease;
  }

  :global(.metro-toggle-knob) {
    display: inline-block;
    width: 18px;
    height: 18px;
    background: #71717a;
    border-radius: 50%;
    transform: translateX(0);
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .metro-toggle input:checked + .metro-toggle-track {
    background: var(--accent-neon-yellow);
    border-color: #000000;
  }

  .metro-toggle input:checked + .metro-toggle-track :global(.metro-toggle-knob) {
    transform: translateX(20px);
    background: #000000;
  }

  .metro-toggle input:focus-visible + .metro-toggle-track {
    outline: 2px solid var(--accent-neon-yellow);
    outline-offset: 2px;
  }

  .metro-toggle-text {
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #f5f5f7;
  }

  .metro-settings-hint {
    margin: 8px 0 0;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    color: #71717a;
    line-height: 1.35;
  }

  /* ---------- copy link card in settings ---------- */
  .metro-settings-copy-wrap {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 2px solid rgba(255, 255, 255, 0.08);
  }

  .metro-copy-link-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 12px 14px;
    background: #1e1e24;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: var(--radius-md);
    font-family: var(--font-secondary);
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease;
  }

  .metro-copy-link-card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #25252e;
  }

  .metro-copy-link-left {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .metro-copy-link-left i {
    color: var(--accent-neon-yellow);
    font-size: 1rem;
  }

  .metro-copy-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 14px;
    background: var(--accent-neon-yellow);
    color: #000000;
    border: 2px solid #000000;
    box-shadow: 1px 1px 0px #000000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    transition: background-color 0.16s ease, color 0.16s ease, transform 0.16s ease;
  }

  .metro-copy-badge.copied {
    background: #22c55e;
    color: #000000;
  }

  /* ---------- Sheet Footer Card: Theme Toggle & Legal Links ---------- */
  .metro-sheet-footer-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    margin-top: 4px;
    padding-top: 12px;
    border-top: 2px solid rgba(255, 255, 255, 0.08);
    text-align: center;
    box-sizing: border-box;
  }

  .footer-badge-row {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .footer-brand-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    background: #18181b;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    padding: 5px 14px;
    border-radius: 6px;
    user-select: none;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;
  }

  .footer-brand-badge:hover {
    background: #27272a;
    transform: translateY(-1px);
  }

  .footer-brand-icon {
    font-size: 0.8rem;
    color: var(--accent-neon-yellow);
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px 10px;
    max-width: 100%;
    margin: 0 auto;
  }

  .footer-legal-btn {
    background: transparent;
    border: none;
    color: #a1a1aa;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 4px 8px;
    border-radius: 4px;
    text-decoration: none;
    transition: color 0.16s ease, background-color 0.16s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    user-select: none;
  }

  .footer-legal-btn:hover,
  .footer-legal-btn:focus-visible {
    color: var(--accent-neon-yellow);
    background: rgba(255, 255, 255, 0.08);
    outline: none;
  }

  .legal-bullet {
    color: rgba(255, 255, 255, 0.25);
    font-size: 0.7rem;
    flex-shrink: 0;
    user-select: none;
  }

  @media (max-width: 480px) {
    .footer-legal-links {
      gap: 4px 8px;
    }
    .footer-legal-btn {
      font-size: 0.68rem;
      padding: 3px 6px;
    }
  }

  .footer-theme-toggle-wrap {
    width: 100%;
  }

  .footer-theme-toggle-btn {
    width: 100%;
    min-height: 48px;
    background: var(--surface-card-light);
    color: var(--text-card-primary);
    border: 3px solid #000000;
    box-shadow: 3px 3px 0px #000000;
    border-radius: 8px;
    padding: 6px 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    user-select: none;
    box-sizing: border-box;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.18s ease;
  }

  .footer-theme-toggle-btn:hover {
    background: var(--surface-card-light-hover);
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0px #000000;
  }

  .footer-theme-toggle-btn:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .theme-current-title {
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.92rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-card-primary);
    flex: 1 1 0;
    text-align: left;
  }

  .theme-pill-segmented {
    display: inline-flex;
    align-items: center;
    background: var(--surface-input);
    border: 2px solid #000000;
    border-radius: 20px;
    padding: 3px;
    gap: 3px;
    box-shadow: 1.5px 1.5px 0px #000000;
    flex: 0 0 auto;
  }

  .theme-pill-btn {
    width: 30px;
    height: 30px;
    min-width: 30px;
    min-height: 30px;
    border-radius: 50%;
    border: 1.5px solid transparent;
    background: transparent;
    color: var(--text-card-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    margin: 0;
    font-size: 0.82rem;
    transition: transform 0.16s var(--ease-tactile), background-color 0.18s ease, color 0.18s ease, box-shadow 0.16s ease;
  }

  .theme-pill-btn:hover {
    color: var(--text-card-primary);
    transform: scale(1.1);
  }

  .theme-pill-btn.active {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
    box-shadow: 1px 1px 0px #000000;
    transform: scale(1.06);
  }

  .theme-mode-label {
    font-family: var(--font-heading, var(--font-secondary));
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-card-secondary);
    flex: 1 1 0;
    text-align: right;
  }

  /* ---------- pitch map section inside settings ---------- */
  .metro-pitch-section {
    margin-top: 6px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .metro-reset-pitch-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 10px 14px;
    background: #1a1a20;
    color: #f5f5f7;
    border: 2px solid #000;
    box-shadow: 2px 2px 0px #000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease, border-color 0.16s ease;
  }

  .metro-reset-pitch-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000;
    background: #24242c;
  }

  /* ---------- beat colors section inside settings ---------- */
  .metro-color-section {
    margin-top: 6px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .metro-color-grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .metro-color-row {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 12px;
    background: #1e1e24;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    cursor: pointer;
    box-sizing: border-box;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease, border-color 0.16s ease;
  }

  .metro-color-row:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #25252e;
  }

  .metro-color-row:active {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0px #000000;
  }

  .metro-color-tier-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid #000000;
    flex-shrink: 0;
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.35);
    transition: background-color 0.14s ease, box-shadow 0.14s ease;
  }

  .metro-color-tier-label {
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    min-width: 3ch;
  }

  .metro-color-hex {
    margin-left: auto;
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #a1a1aa;
    font-variant-numeric: tabular-nums;
  }

  .metro-color-input {
    width: 38px;
    height: 28px;
    padding: 0;
    border: 2px solid #000000;
    border-radius: 6px;
    background: #0f0f12;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    overflow: hidden;
    flex-shrink: 0;
  }

  .metro-color-input::-webkit-color-swatch-wrapper {
    padding: 0;
  }

  .metro-color-input::-webkit-color-swatch {
    border: none;
    border-radius: 4px;
  }

  .metro-color-input::-moz-color-swatch {
    border: none;
    border-radius: 4px;
  }

  .metro-reset-colors-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 10px 14px;
    background: #1a1a20;
    color: #f5f5f7;
    border: 2px solid #000;
    box-shadow: 2px 2px 0px #000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease, border-color 0.16s ease;
  }

  .metro-reset-colors-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000;
    background: #24242c;
  }

  /* ---------- midi section inside settings ---------- */
  .metro-midi-card {
    background: #1e1e24;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    padding: 12px 12px 10px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .metro-midi-status-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .metro-midi-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #71717a;
    border: 1px solid #000;
    flex-shrink: 0;
    transition: background-color 0.16s ease;
  }

  .metro-midi-dot.connected {
    background: #22c55e;
    box-shadow: 0 0 8px rgba(34,197,94,0.45);
  }

  .metro-midi-dot.connecting {
    background: var(--accent-neon-yellow);
    animation: midiPulse 1s infinite alternate;
  }

  @keyframes midiPulse {
    from { opacity: 0.55; }
    to { opacity: 1; }
  }

  .metro-midi-status-text {
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #f5f5f7;
  }

  .metro-midi-support-badge {
    font-family: var(--font-secondary);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #c0392b;
    color: #fff;
    padding: 2px 6px;
    border-radius: var(--radius-pill);
    border: 1px solid #000;
  }

  .metro-midi-device-name {
    margin: 0;
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    color: #a1a1aa;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .metro-midi-actions {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }

  .metro-midi-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--accent-neon-yellow);
    color: #000;
    border: 2px solid #000;
    box-shadow: 2px 2px 0px #000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease;
  }

  .metro-midi-btn:hover {
    transform: translate(-1px,-1px);
    box-shadow: 3px 3px 0px #000;
    background: var(--btn-green-hover);
  }

  .metro-midi-btn.connected {
    background: #22c55e;
  }

  .metro-midi-select {
    flex: 1 1 160px;
    min-width: 160px;
    background: #0f0f12;
    color: #f5f5f7;
    border: 2px solid #000;
    box-shadow: 2px 2px 0px #000;
    border-radius: var(--radius-md);
    padding: 9px 10px;
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .metro-midi-hint {
    margin: 0;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    color: #71717a;
    line-height: 1.35;
  }

  /* ---------- coach deck — horizontal row ---------- */
  .metro-coach-tablist {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 8px;
    padding-bottom: 4px;
    -webkit-overflow-scrolling: touch;
  }

  :global(.metro-coach-tab) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-width: max-content;
    white-space: nowrap;
    padding: 11px 14px;
    background: #1e1e24;
    color: #f5f5f7;
    border: 2px solid #000000;
    box-shadow: 2px 2px 0px #000000;
    border-radius: var(--radius-md);
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }

  :global(.metro-coach-tab:hover) {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0px #000000;
    background: #25252e;
  }

  :global(.metro-coach-tab[aria-selected='true']) {
    background: var(--accent-neon-yellow);
    color: #000000;
  }

  :global(.metro-coach-suggest-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    flex: 0 0 auto;
    min-width: max-content;
    white-space: nowrap;
    padding: 11px 14px;
    background: transparent;
    color: #71717a;
    border: 2px dashed #3f3f46;
    border-radius: var(--radius-md);
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease,
                color 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
  }

  :global(.metro-coach-suggest-btn:hover) {
    background: rgba(242, 253, 67, 0.1);
    color: var(--accent-neon-yellow);
    border-color: var(--accent-neon-yellow);
    transform: translate(-1px, -1px);
    box-shadow: 2px 2px 0px #000000;
  }

  :global(.metro-coach-suggest-btn:active) {
    transform: translate(1px, 1px);
    box-shadow: none;
  }

  :global(.metro-coach-suggest-btn i) {
    font-size: 0.68rem;
  }

  .metro-coach-panel {
    min-height: 150px;
  }

  :global(.metro-coach-panel) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-align: center;
    padding: 18px 12px;
    min-height: 150px;
  }

  :global(.metro-coach-panel i) {
    font-size: 1.6rem;
    color: #71717a;
  }

  :global(.metro-coach-blurb) {
    margin: 0;
    font-family: var(--font-secondary);
    font-size: 0.88rem;
    color: #f5f5f7;
    max-width: 34ch;
  }

  :global(.metro-coach-soon) {
    margin: 0;
    font-family: var(--font-secondary);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #71717a;
  }



  .metro-coach-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 14px 16px;
    background: var(--accent-neon-yellow);
    color: #000;
    border: 3px solid #000;
    box-shadow: 4px 4px 0px #000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease;
  }

  .metro-coach-cta:hover {
    transform: translate(-1px,-1px);
    box-shadow: 5px 5px 0px #000;
    background: var(--btn-green-hover);
  }

  .metro-coach-cta:active {
    transform: translate(1px,1px);
    box-shadow: 1px 1px 0px #000;
  }

  .metro-coach-cta.is-running {
    background: #c0392b;
    color: #ffffff;
  }

  .metro-coach-cta.is-running:hover {
    background: #d64536;
  }

  .metro-coach-live {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .metro-coach-live-card {
    background: #0f0f12;
    border: 2px solid #000;
    border-left: 4px solid var(--accent-neon-yellow);
    box-shadow: 3px 3px 0px #000;
    border-radius: var(--radius-md);
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .metro-coach-live-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .metro-coach-live-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-secondary);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    background: var(--accent-neon-yellow);
    color: #000;
    padding: 3px 8px;
    border-radius: var(--radius-pill);
    border: 1px solid #000;
  }

  .metro-coach-live-phase {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 800;
    color: #f5f5f7;
    line-height: 1;
  }

  .metro-coach-live-phase.muted { color: var(--accent-neon-yellow); }

  .metro-coach-live-sub {
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    color: #a1a1aa;
  }

  .metro-coach-progress {
    height: 8px;
    background: #1e1e24;
    border: 1px solid #000;
    border-radius: 999px;
    overflow: hidden;
  }

  .metro-coach-progress-fill {
    height: 100%;
    background: var(--accent-neon-yellow);
    transform-origin: left center;
    will-change: transform;
  }

  .metro-coach-live-split {
    display: flex;
    gap: 0;
    width: 100%;
    background: var(--accent-neon-yellow);
    border: 3px solid #000;
    box-shadow: 4px 4px 0px #000;
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .metro-coach-live-stop {
    flex: 1 1 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 16px;
    background: #c0392b;
    color: #fff;
    border: none;
    border-right: 2px solid #000;
    font-family: var(--font-secondary);
    font-size: 0.9rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background-color 0.16s ease;
  }

  .metro-coach-live-stop:hover { background: #d64536; }

  .metro-coach-live-expand {
    flex: 0 0 52px;
    width: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-neon-yellow);
    color: #000;
    border: none;
    font-size: 1rem;
    cursor: pointer;
    transition: background-color 0.16s ease;
  }

  .metro-coach-live-expand:hover { background: var(--btn-green-hover); }

  .metro-coach-score {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px;
    background: #1e1e24;
    border: 2px solid #000;
    border-radius: var(--radius-md);
    text-align: center;
  }

  .metro-coach-score-grade {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--accent-neon-yellow);
  }

  .metro-coach-score-detail {
    font-family: var(--font-secondary);
    font-size: 0.82rem;
    color: #f5f5f7;
  }

  .metro-coach-score-actions {
    display: flex;
    gap: 8px;
  }

  .metro-coach-score-btn {
    flex: 1 1 0;
    padding: 10px 12px;
    background: #0f0f12;
    color: #f5f5f7;
    border: 2px solid #000;
    box-shadow: 2px 2px 0px #000;
    border-radius: var(--radius-pill);
    font-family: var(--font-secondary);
    font-size: 0.76rem;
    font-weight: 800;
    cursor: pointer;
  }

  .metro-coach-score-btn.primary {
    background: var(--accent-neon-yellow);
    color: #000;
  }

  /* ---------- desktop ---------- */
  @media (min-width: 768px) {
    .metro-view {
      padding-top: max(16px, calc(14px + env(safe-area-inset-top, 0px)));
      padding-bottom: max(16px, calc(14px + env(safe-area-inset-bottom, 0px)));
    }

    .metro-dial {
      --metro-dial-size: min(380px, calc(100dvh - 280px));
      --metro-dot-radius: calc(var(--metro-dial-size) / 2 - 22px);
    }

    .metro-view.has-strip .metro-dial {
      --metro-dial-size: min(340px, calc(100dvh - 340px));
    }

    .metro-stepper-strip {
      max-width: 420px;
      margin-left: auto;
      margin-right: auto;
    }

    .metro-sheet-toggles {
      max-width: 420px;
      margin-left: auto;
      margin-right: auto;
    }

    .metro-stepper-btn {
      height: 48px;
      min-height: 48px;
    }
  }

  @media (max-width: 380px) {
    .metro-stepper-btn {
      height: 40px;
      min-height: 40px;
      font-size: 0.85rem;
    }

    .metro-bpm-num {
      font-size: clamp(3.2rem, 17vw, 5rem);
    }

    .metro-bpm-input {
      font-size: clamp(2.8rem, 15vw, 4.2rem);
      width: 3.8ch;
    }
  }

  @media (max-height: 720px) {
    .metro-view {
      padding-top: calc(6px + env(safe-area-inset-top, 0px));
      padding-bottom: calc(6px + env(safe-area-inset-bottom, 0px));
    }

    .metro-dial {
      --metro-dial-size: min(80vw, 320px, calc(100dvh - 230px));
      margin: 2px auto;
    }

    .metro-view.has-strip .metro-dial {
      --metro-dial-size: min(76vw, 280px, calc(100dvh - 280px));
    }

    .metro-bpm-num {
      font-size: clamp(2.8rem, min(16vw, 7vh), 4.4rem);
    }

    .metro-bpm-input {
      font-size: clamp(2.4rem, min(14vw, 6vh), 3.8rem);
    }

    .metro-pill-row {
      margin-top: 6px;
      padding: 4px 10px;
    }

    .metro-coach-btn {
      min-height: 44px;
      padding: 10px 14px;
      margin-top: 6px;
      font-size: 0.85rem;
    }

    .metro-controls .metro-icon-btn,
    .metro-tap-btn,
    .metro-play-btn,
    .metro-now-playing {
      height: 46px;
      min-height: 46px;
    }

    .metro-back-pill,
    .metro-topbar .metro-icon-btn {
      height: 44px;
      min-height: 44px;
    }
  }

  @media (max-height: 600px) {
    .metro-dial {
      --metro-dial-size: min(74vw, 240px, calc(100dvh - 180px));
      margin: 1px auto;
    }

    .metro-bpm-num {
      font-size: clamp(2.2rem, min(14vw, 5.5vh), 3.2rem);
    }

    .metro-bpm-input {
      font-size: clamp(2rem, min(12vw, 5vh), 2.8rem);
    }

    .metro-tempo-marking {
      font-size: 0.62rem;
      height: 14px;
      line-height: 14px;
      margin-bottom: 0;
    }

    .metro-coach-btn {
      min-height: 38px;
      padding: 6px 10px;
      margin-top: 4px;
      font-size: 0.8rem;
    }

    .metro-controls .metro-icon-btn,
    .metro-tap-btn,
    .metro-play-btn,
    .metro-now-playing {
      height: 40px;
      min-height: 40px;
    }

    .metro-back-pill,
    .metro-topbar .metro-icon-btn {
      height: 38px;
      min-height: 38px;
    }
  }

  /* ---------- motion respect ---------- */
  @media (prefers-reduced-motion: reduce) {
    .metro-back-pill,
    .metro-back-arrow,
    .metro-icon-btn,
    .metro-pill,
    .metro-tap-btn,
    .metro-play-btn,
    .metro-coach-btn,
    .metro-stepper-btn,
    .metro-sheet,
    .metro-sheet-backdrop,
    .metro-chip,
    .metro-beatstyle-chip,
    .metro-info-btn,
    .metro-settings-info-btn,
    .metro-display-box,
    .metro-copy-link-card,
    .metro-copy-badge,
    .metro-toggle-track,
    .metro-dial.beat-flash-a .metro-bpm-num,
    .metro-dial.beat-flash-b .metro-bpm-num,
    .metro-setlist-header-titles,
    .metro-setlist-search-layer,
    .metro-setlist-search-toggle,
    .metro-setlist-search-toggle .st-icon,
    .metro-setlist-create-btn {
      transition: none !important;
      animation: none !important;
    }

    .metro-sheet-strip,
    .metro-sheet-toggle {
      transition: none !important;
      animation: none !important;
    }
  }

  :global(html.low-power-mode) .metro-dial.beat-flash-a .metro-bpm-num,
  :global(html.low-power-mode) .metro-dial.beat-flash-b .metro-bpm-num {
    animation: none !important;
  }

  :global(html.low-power-mode) .metro-radial-ring :global(.metro-radial-seg) {
    filter: none !important;
  }

  /* ===== Light mode (standard) — crisp brutalist light theme ===== */
  html[data-theme="standard"] .metro-page {
    background-color: #f5f4ef;
    background-image: radial-gradient(circle at 50% 16%, #ffffff 0%, #f5f4ef 42%, #ebebea 78%, #e8e6e1 100%);
    color: #0a0a0c;
  }
  html[data-theme="standard"] .metro-page::before {
    opacity: 0.035;
  }
  html[data-theme="standard"] .metro-back-pill:hover {
    background: var(--accent-neon-yellow);
    color: #000000;
    border-color: #000000;
  }
  html[data-theme="standard"] .metro-back-pill,
  html[data-theme="standard"] .metro-icon-btn,
  html[data-theme="standard"] .metro-topbar-playback,
  html[data-theme="standard"] .metro-setlist-deck-btn,
  html[data-theme="standard"] .metro-stepper-btn,
  html[data-theme="standard"] .metro-controls .metro-now-playing {
    background: #ffffff;
    color: #000000;
    border-color: #000000;
    box-shadow: 3px 3px 0px #000000;
  }
  html[data-theme="standard"] .metro-topbar-title {
    color: #000000;
    background: var(--accent-neon-yellow);
    border-color: #000000;
  }
  html[data-theme="standard"] .metro-dial {
    background: radial-gradient(circle at 50% 38%, #ffffff 0%, #f0efe8 48%, #e4e2d8 100%);
    border: 3px solid #000000;
    box-shadow: 0 10px 36px rgba(0, 0, 0, 0.15), inset 0 2px 0 rgba(255, 255, 255, 1), 4px 4px 0px #000000;
  }
  html[data-theme="standard"] .metro-tempo-marking {
    color: #000000;
    text-shadow: none;
    font-weight: 900;
  }
  html[data-theme="standard"] .metro-bpm-num {
    color: #000000;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.8), 2px 2px 0px rgba(0, 0, 0, 0.15);
    border: 2px solid transparent;
  }
  html[data-theme="standard"] .metro-bpm-num:hover {
    border-color: #000000;
    background: rgba(0, 0, 0, 0.06);
    color: #000000;
  }
