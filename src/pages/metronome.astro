</style>

<script>
  import { initTheme } from '../scripts/controllers/themeController.js';
  initTheme();

  let controllerPromise: Promise<any> | null = null;
  let initialized = false;

  async function loadController() {
    if (!controllerPromise) controllerPromise = import('../scripts/controllers/metronome/index.js');
    return controllerPromise;
  }

  function start() {
    if (initialized) return;
    initialized = true;
    loadController()
      .then((mod) => mod.initMetronome())
      .catch((err) => console.error('KINS Metronome failed to load:', err));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }

  document.addEventListener(
    'click',
    (e) => {
      if (initialized) return;
      const target = e.target as HTMLElement | null;
      const btn = target?.closest('button');
      if (!btn || !btn.dataset.track?.startsWith('metronome:')) return;
      start();
    },
    { passive: true }
  );
</script>

<script is:inline>
  (function initMetroFooterModalTriggers() {
    function handleFooterTriggerClick(e) {
      var target = e.target;
      if (!target || !target.closest) return;

      var suggestBtn = target.closest('#metroOpenSuggestImprovementFooterBtn, #openSuggestImprovementFooterBtn, .open-feedback-trigger, [data-open-feedback]');
      if (suggestBtn) {
        e.preventDefault();
        e.stopPropagation();
        var feedbackModal = document.getElementById('feedbackModal');
        if (typeof window.openFeedbackModal === 'function') {
          var category = suggestBtn.getAttribute('data-feedback-category') || 'Metronome';
          window.openFeedbackModal(category);
        } else if (feedbackModal) {
          feedbackModal.classList.remove('hidden');
          document.body.classList.add('modal-open');
        }
        return;
      }

      var legalBtn = target.closest('#metroOpenLegalFooterBtn, #openLegalFooterBtn, .open-legal-trigger, #metroOpenPrivacyFooterBtn, #openPrivacyFooterBtn, .open-privacy-trigger, #metroOpenTermsFooterBtn, #openTermsFooterBtn, .open-terms-trigger');
      if (legalBtn) {
        e.preventDefault();
        e.stopPropagation();
        var isSubmissions = legalBtn.id === 'metroOpenTermsFooterBtn' || legalBtn.id === 'openTermsFooterBtn' || legalBtn.classList.contains('open-terms-trigger');
        var initialTab = isSubmissions ? 'submissions' : 'privacy';
        if (typeof window.openLegalModal === 'function') {
          window.openLegalModal(initialTab);
        } else if (typeof window.openPrivacyModal === 'function') {
          window.openPrivacyModal();
        } else {
          var legalModal = document.getElementById('legalModal');
          if (legalModal) {
            legalModal.classList.remove('is-closing');
            legalModal.classList.remove('hidden');
            document.body.classList.add('modal-open');
          }
        }
        return;
      }
    }

    document.addEventListener('click', handleFooterTriggerClick, true);

    var yearEls = document.querySelectorAll('#copyrightYear, #metroCopyrightYear, .footer-copyright-year');
    var curYear = new Date().getFullYear().toString();
    yearEls.forEach(function(el) {
      el.textContent = curYear;
    });
  })();
</script>
