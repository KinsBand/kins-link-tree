---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToastContainer from '../components/ui/ToastContainer.astro';
import FeedbackModal from '../components/modals/FeedbackModal.astro';
import LegalModal from '../components/modals/LegalModal.astro';
---

<BaseLayout
  title="KINS METRONOME — Free Web Audio Metronome with Tap Tempo"
  description="Free browser metronome by KINS. Web Audio clock precision, tap tempo, accents, subdivisions and time signatures from 2/4 to 12/8, plus a rehearsal setlist of classic tempos. Audio never leaves your device."
>
  <main class="metro-page">
    <div class="metro-view" id="metroView">
      <div class="metro-topbar">
        <a
          href="/"
          class="metro-back-pill brutal-press"
          aria-label="Back to KINS home"
          title="Back to KINS home"
          data-track="metronome:back_home"
        >
          <i class="fa-solid fa-arrow-left metro-back-arrow" aria-hidden="true"></i>
          <span class="metro-back-label">KINS!</span>
        </a>
        <div class="metro-topbar-center" id="metroTopbarCenter" aria-live="polite" aria-atomic="true">
          <span class="metro-topbar-title" id="metroTopbarTitle" hidden></span>

          <!-- Dynamic Live Playback Display (Req 7 & 10) -->
          <div class="metro-topbar-playback" id="metroTopbarPlayback" hidden>
            <div class="metro-topbar-setlist-line" id="metroTopbarSetlistLine" hidden>
              <span class="metro-topbar-setlist-title" id="metroTopbarSetlistTitle"></span>
            </div>
            <div class="metro-topbar-song-line" id="metroTopbarSongLine">
              <span class="metro-topbar-song-title" id="metroTopbarSongTitle"></span>
              <span class="metro-topbar-sep" id="metroTopbarSep" hidden>—</span>
              <span class="metro-topbar-section" id="metroTopbarSection"></span>
            </div>
            <div class="metro-topbar-counter-line" id="metroTopbarCounterLine" hidden>
              <span class="metro-topbar-counter" id="metroTopbarCounter"></span>
            </div>
          </div>

          <button type="button" class="metro-topbar-undo brutal-press" id="metroTopbarUndo" hidden aria-label="Undo BPM change — restore setlist tempo">
            <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
            UNDO
          </button>
        </div>
        <button type="button" class="metro-icon-btn brutal-press" id="metroSettingsBtn" aria-haspopup="dialog" aria-expanded="false" aria-label="Open settings" data-track="metronome:settings_open">
          <i class="fa-solid fa-gear" aria-hidden="true"></i>
        </button>
      </div>

      <section class="metro-dial" id="metroDial" aria-label="Tempo (drag or scroll to adjust)">
        <div class="metro-beat-dots" id="metroBeatDots" role="group" aria-label="Beat pitch selectors — tap to cycle Low/Mid/High/Mute"></div>
        <svg class="metro-radial-ring" id="metroRadialRing" role="group" aria-label="Beat pitch selectors" viewBox="0 0 200 200" preserveAspectRatio="xMidYMid meet"></svg>
        <div class="metro-dial-core">
          <div class="metro-tempo-marking" id="metroTempoMarking" aria-live="polite">Allegro</div>
          <div class="metro-bpm-row">
            <button type="button" class="metro-bpm-num" id="metroBpmNum" aria-label="Tempo 120 BPM — tap to edit, drag dial or use arrow keys to adjust">120</button>
            <input type="number" class="metro-bpm-input" id="metroBpmInput" inputmode="numeric" pattern="[0-9]*" min="20" max="300" step="1" hidden aria-label="Edit tempo BPM" />
          </div>
          <p class="metro-bpm-unit">BPM</p>
          <div class="metro-pill-row">
            <button type="button" class="metro-pill brutal-press" id="metroTsPill" aria-haspopup="dialog" aria-expanded="false" data-track="metronome:ts_open">
              <span id="metroTsPillLabel">4/4</span>
              <i class="fa-solid fa-chevron-down metro-pill-caret" aria-hidden="true"></i>
            </button>
            <span class="metro-pill-divider" aria-hidden="true"></span>
            <button type="button" class="metro-pill brutal-press" id="metroSubPill" aria-haspopup="dialog" aria-expanded="false" data-track="metronome:sub_open">
              <span id="metroSubPillLabel">1/4</span>
              <i class="fa-solid fa-chevron-down metro-pill-caret" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </section>

      <div class="metro-bottom">
        <div class="metro-controls">
          <button type="button" class="metro-icon-btn brutal-press" id="metroSetlistBtn" aria-haspopup="dialog" aria-expanded="false" aria-label="Open setlist" data-track="metronome:setlist_open">
            <i class="fa-solid fa-music" aria-hidden="true"></i>
          </button>
          <div class="metro-now-playing" id="metroNowPlaying" hidden aria-live="polite" aria-atomic="true">
            <div class="metro-now-playing-inner">
              <div class="metro-now-playing-title" id="metroNowPlayingTitle"></div>
              <div class="metro-now-playing-meta">
                <span class="metro-now-playing-section" id="metroNowPlayingSection"></span>
                <span class="metro-now-playing-sep" id="metroNowPlayingSep" hidden>•</span>
                <span class="metro-now-playing-bars" id="metroNowPlayingBars"></span>
              </div>
            </div>
            <button type="button" class="metro-now-playing-exit brutal-press" id="metroNowPlayingExit" aria-label="Exit playback" title="Exit playback">
              <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
          </div>
          <button type="button" class="metro-tap-btn brutal-press" id="metroTapBtn" data-track="metronome:tap">TAP TEMPO</button>
          <button type="button" class="metro-play-btn brutal-press" id="metroPlayBtn" aria-label="Start metronome" data-track="metronome:play">
            <span class="metro-play-icon icon-play" aria-hidden="true"><i class="fa-solid fa-play"></i></span>
            <span class="metro-play-icon icon-stop" aria-hidden="true"><i class="fa-solid fa-stop"></i></span>
          </button>
        </div>
      </div>

      <button type="button" class="metro-coach-btn brutal-press" id="metroCoachBtn" aria-haspopup="dialog" aria-expanded="false" data-track="metronome:coach_open">
        <span>COACH DECK</span>
      </button>

      <!-- Transformed Setlist Navigation Deck (Req 11: 4 equal 20% zones) -->
      <div class="metro-setlist-deck" id="metroSetlistDeck" hidden aria-label="Setlist performance controls">
        <button type="button" class="metro-setlist-deck-btn brutal-press" id="metroDeckPrevSong" aria-label="Previous song" title="Previous complete song (⏮)">
          <i class="fa-solid fa-backward-step" aria-hidden="true"></i>
        </button>
        <button type="button" class="metro-setlist-deck-btn brutal-press" id="metroDeckPrevSection" aria-label="Previous section" title="Previous section (◀)">
          <i class="fa-solid fa-caret-left" aria-hidden="true"></i>
        </button>
        <button type="button" class="metro-setlist-deck-btn brutal-press" id="metroDeckNextSection" aria-label="Next section" title="Next section (▶)">
          <i class="fa-solid fa-caret-right" aria-hidden="true"></i>
        </button>
        <button type="button" class="metro-setlist-deck-btn brutal-press" id="metroDeckNextSong" aria-label="Next song" title="Next complete song (⏭)">
          <i class="fa-solid fa-forward-step" aria-hidden="true"></i>
        </button>
      </div>

      <div class="metro-coach-live-dock" id="metroCoachLiveDock" hidden aria-live="polite" aria-atomic="true"></div>
    </div>

    <div class="metro-sheet-backdrop" id="metroSheetBackdrop" hidden></div>
    <div class="metro-sheet" id="metroSheet" role="dialog" aria-modal="true" tabindex="-1" hidden>
      <div class="metro-sheet-handle" id="metroSheetHandle" aria-hidden="true"></div>

      <section class="metro-sheet-panel" id="metroPanelTs" hidden aria-label="Time signature">
        <p class="metro-sheet-title">TIME SIGNATURE</p>
        <header class="metro-sheet-head">
          <button type="button" class="metro-info-btn brutal-press" id="metroTsInfoBeats" aria-label="What do beats per bar mean?">
            <i class="fa-solid fa-info" aria-hidden="true"></i>
          </button>
          <div class="metro-sheet-display">
            <button type="button" class="metro-display-box brutal-press" id="metroTsBoxTop" aria-label="Edit beats per bar (top number)">4</button>
            <span class="metro-display-slash" aria-hidden="true">/</span>
            <button type="button" class="metro-display-box brutal-press" id="metroTsBoxBottom" aria-label="Edit note value (bottom number)">4</button>
          </div>
          <button type="button" class="metro-info-btn brutal-press" id="metroTsInfoUnit" aria-label="What does the note value mean?">
            <i class="fa-solid fa-info" aria-hidden="true"></i>
          </button>
        </header>
        <div class="metro-chip-grid" id="metroTsGrid" role="radiogroup" aria-label="Time signature presets"></div>
      </section>

      <section class="metro-sheet-panel" id="metroPanelSub" hidden aria-label="Subdivision">
        <p class="metro-sheet-title">SUBDIVISION</p>
        <header class="metro-sheet-head">
          <button type="button" class="metro-info-btn brutal-press" id="metroSubInfo" aria-label="What are subdivisions?">
            <i class="fa-solid fa-info" aria-hidden="true"></i>
          </button>
          <div class="metro-sheet-display">
            <span class="metro-display-box" id="metroSubBoxTop">1</span>
            <span class="metro-display-slash" aria-hidden="true">/</span>
            <span class="metro-display-box" id="metroSubBoxBottom">4</span>
          </div>
          <span class="metro-info-spacer" aria-hidden="true"></span>
        </header>
        <div class="metro-sub-row" id="metroSubRow" aria-label="Subdivision presets"></div>
      </section>

      <section class="metro-sheet-panel metro-panel--setlist" id="metroPanelSetlist" hidden aria-label="Setlists and Songs">
        <p class="metro-sheet-title" id="metroSetlistSheetMainTitle">SETLIST & SONGS</p>

        <!-- Top 50/50 Navigation Selectors (Req 3) -->
        <div class="metro-menu-nav" id="metroMenuNav" role="tablist" aria-label="Setlist and song navigation">
          <button type="button" class="metro-menu-nav-btn brutal-press active" id="metroNavSetlists" data-nav="setlists" role="tab" aria-selected="true" aria-controls="metroSetlistsListView">
            SETLISTS
          </button>
          <button type="button" class="metro-menu-nav-btn brutal-press" id="metroNavSongs" data-nav="songs" role="tab" aria-selected="false" aria-controls="metroSongsBrowseView">
            SONGS
          </button>
        </div>

        <div class="metro-setlist-content-area" id="metroSetlistContentArea">
          <!-- 1. SETLISTS LIST VIEW (Level 1) -->
          <div class="metro-view-pane metro-setlists-list-view" id="metroSetlistsListView">
            <div class="metro-setlists-list" id="metroSetlistsList"></div>
          </div>

          <!-- 2. SETLIST DETAIL VIEW (Level 2) -->
          <div class="metro-view-pane metro-setlist-detail-view" id="metroSetlistDetailView" hidden>
            <div class="metro-subview-header">
              <button type="button" class="metro-nav-back-btn brutal-press" id="metroSetlistDetailBackBtn" aria-label="Back to setlists">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
              </button>
              <h3 class="metro-subview-title" id="metroSetlistDetailTitle">SETLIST</h3>
              <button type="button" class="metro-subview-action-btn metro-subview-play-btn brutal-press" id="metroSetlistDetailPlayBtn" aria-label="Play full setlist" title="Play full setlist">
                <i class="fa-solid fa-play" aria-hidden="true"></i>
              </button>
            </div>
            <div class="metro-setlist-detail-meta">
              <span class="metro-setlist-detail-count" id="metroSetlistDetailSongCount">0 SONGS</span>
              <div class="metro-setlist-detail-actions">
                <button type="button" class="metro-setlist-detail-edit-name-btn brutal-press" id="metroSetlistDetailEditNameBtn" title="Edit setlist name">
                  <i class="fa-solid fa-pen" aria-hidden="true"></i>
                  <span>RENAME</span>
                </button>
                <button type="button" class="metro-setlist-detail-add-song-btn brutal-press" id="metroSetlistDetailAddSongBtn">
                  <i class="fa-solid fa-plus" aria-hidden="true"></i>
                  <span>ADD SONGS</span>
                </button>
              </div>
            </div>
            <div class="metro-setlist-detail-songs" id="metroSetlistDetailSongs"></div>
          </div>

          <!-- 3. SONGS BROWSE VIEW (Level 1 under SONGS) -->
          <div class="metro-view-pane metro-songs-browse-view" id="metroSongsBrowseView" hidden>
            <div class="metro-setlist-header" id="metroSetlistHeader">
              <!-- Song Categories Underneath (Req 3, No track count badges Req 1) -->
              <div class="metro-setlist-filters" id="metroSetlistFilters" role="tablist" aria-label="Song categories">
                <button type="button" class="metro-setlist-filter brutal-press active" data-filter="inspires" role="tab" aria-selected="true" aria-controls="metroSetlistList">
                  INSPIRES
                </button>
                <button type="button" class="metro-setlist-filter brutal-press" data-filter="covers" role="tab" aria-selected="false" aria-controls="metroSetlistList">
                  COVERS
                </button>
                <button type="button" class="metro-setlist-filter brutal-press" data-filter="originals" role="tab" aria-selected="false" aria-controls="metroSetlistList">
                  ORIGINALS
                </button>
                <button type="button" class="metro-setlist-filter brutal-press" data-filter="custom" role="tab" aria-selected="false" aria-controls="metroSetlistList">
                  CUSTOM
                </button>
              </div>
              <div class="metro-setlist-sort-bar" id="metroSetlistSortBar">
                <span class="metro-setlist-sort-label">SORT:</span>
                <button type="button" class="metro-setlist-sort-chip brutal-press active" data-sort="default">DEFAULT</button>
                <button type="button" class="metro-setlist-sort-chip brutal-press" data-sort="bpm-asc">BPM ↑</button>
                <button type="button" class="metro-setlist-sort-chip brutal-press" data-sort="bpm-desc">BPM ↓</button>
                <button type="button" class="metro-setlist-sort-chip brutal-press" data-sort="alpha">A–Z</button>
              </div>
            </div>
            <div class="metro-setlist-list" id="metroSetlistList"></div>
            <div class="metro-setlist-external" id="metroSetlistExternal" hidden aria-live="polite"></div>
          </div>

          <!-- 4. SONG DETAIL / STRUCTURE EDITOR VIEW (Level 3 or direct from Songs) -->
          <div class="metro-view-pane metro-song-edit-view" id="metroSongEditView" hidden>
            <div class="metro-subview-header">
              <button type="button" class="metro-nav-back-btn brutal-press" id="metroSongEditBackBtn" aria-label="Back">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
              </button>
              <h3 class="metro-subview-title" id="metroSongEditTitle">SONG DETAILS</h3>
              <button type="button" class="metro-subview-action-btn metro-subview-play-btn brutal-press" id="metroSongPlayBtn" aria-label="Play song individually" title="Play song">
                <i class="fa-solid fa-play" aria-hidden="true"></i>
              </button>
            </div>

            <div class="metro-song-edit-tabs" id="metroSongEditTabs" role="tablist" aria-label="Song edit modes">
              <button type="button" class="metro-setlist-add-tab brutal-press active" id="metroSongEditTabDetails" data-add-mode="custom" role="tab" aria-selected="true">
                <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                <span>SONG & STRUCTURE</span>
              </button>
              <button type="button" class="metro-setlist-add-tab brutal-press" id="metroSongEditTabStructure" data-add-mode="search" role="tab" aria-selected="false">
                <i class="fa-solid fa-globe" aria-hidden="true"></i>
                <span>WEB LOOKUP</span>
              </button>
            </div>

            <!-- Tab A: Custom Form & Horizontal Structure Deck (Req 5 & 6 & 9) -->
            <div class="metro-song-edit-pane" id="metroSongEditPaneDetails">
              <form class="metro-custom-form" id="metroCustomForm" novalidate>
                <input type="hidden" id="metroCustomEditId" value="" />
                <input type="hidden" id="metroCustomFromSetlistId" value="" />
                <div class="metro-custom-field">
                  <label class="metro-custom-label" for="metroCustomTitle">SONG TITLE *</label>
                  <input class="metro-custom-input" id="metroCustomTitle" type="text" maxlength="120" placeholder="e.g. Supermarket" required autocomplete="off" />
                  <span class="metro-custom-error" id="metroCustomTitleErr" hidden></span>
                </div>
                <div class="metro-custom-field">
                  <label class="metro-custom-label" for="metroCustomArtist">ARTIST / BAND *</label>
                  <input class="metro-custom-input" id="metroCustomArtist" type="text" maxlength="120" placeholder="e.g. Kins" required autocomplete="off" />
                  <span class="metro-custom-error" id="metroCustomArtistErr" hidden></span>
                </div>
                <div class="metro-custom-field">
                  <label class="metro-custom-label" for="metroCustomBpm">BASE TEMPO (20–300 BPM) *</label>
                  <div class="metro-custom-bpm-row">
                    <input class="metro-custom-input metro-custom-bpm-input" id="metroCustomBpm" type="number" inputmode="numeric" min="20" max="300" step="1" placeholder="120" required />
                    <button type="button" class="metro-custom-helper-btn brutal-press" id="metroCustomUseCurrentBpmBtn" title="Grab current metronome tempo">
                      <i class="fa-solid fa-arrow-down-long" aria-hidden="true"></i>
                      <span id="metroCustomCurrentBpmLabel">USE CURRENT</span>
                    </button>
                    <button type="button" class="metro-custom-helper-btn metro-custom-tap-btn brutal-press" id="metroCustomTapBpmBtn" title="Tap to set BPM">
                      <i class="fa-solid fa-hand-pointer" aria-hidden="true"></i>
                      <span>TAP</span>
                    </button>
                  </div>
                  <span class="metro-custom-error" id="metroCustomBpmErr" hidden></span>
                </div>
                <input type="hidden" id="metroCustomCategory" value="custom" />
                <div class="metro-custom-field">
                  <label class="metro-custom-label" for="metroCustomTimeSig">DEFAULT TIME SIGNATURE</label>
                  <select class="metro-custom-select" id="metroCustomTimeSig">
                    <option value="4-4">4/4</option>
                    <option value="3-4">3/4</option>
                    <option value="2-4">2/4</option>
                    <option value="6-8">6/8</option>
                    <option value="7-8">7/8</option>
                    <option value="5-4">5/4</option>
                    <option value="12-8">12/8</option>
                    <option value="9-8">9/8</option>
                  </select>
                </div>
                <div class="metro-custom-field">
                  <label class="metro-custom-label" for="metroCustomNotes">NOTES / TUNING / KEY (OPTIONAL)</label>
                  <input class="metro-custom-input" id="metroCustomNotes" type="text" maxlength="80" placeholder="e.g. Drop D, Key of Em" autocomplete="off" />
                </div>

                <!-- Count-in toggle (Req 9) -->
                <div class="metro-custom-field metro-custom-field--checkbox">
                  <label class="metro-checkbox-label">
                    <input type="checkbox" id="metroCustomCountIn" class="metro-checkbox" />
                    <span>COUNT-IN BEFORE PLAYBACK (1 BAR)</span>
                  </label>
                </div>

                <!-- SONG STRUCTURE SECTION BUILDER (Req 6) -->
                <div class="metro-structure-builder">
                  <div class="metro-structure-builder-head">
                    <div class="metro-structure-title-row">
                      <label class="metro-custom-label">STRUCTURE</label>
                      <span class="metro-structure-summary" id="metroStructureSummary">0 SECTIONS</span>
                    </div>
                  </div>

                  <!-- Horizontal Structure Deck -->
                  <div class="metro-structure-deck" id="metroStructureDeck"></div>

                  <!-- Quick Add Preset Buttons -->
                  <div class="metro-structure-quick-add">
                    <span class="metro-structure-quick-label">ADD SECTION:</span>
                    <button type="button" class="metro-structure-preset-btn brutal-press" id="metroPresetIntro" data-preset="Intro">+ Intro</button>
                    <button type="button" class="metro-structure-preset-btn brutal-press" id="metroPresetVerse" data-preset="Verse">+ Verse</button>
                    <button type="button" class="metro-structure-preset-btn brutal-press" id="metroPresetChorus" data-preset="Chorus">+ Chorus</button>
                    <button type="button" class="metro-structure-preset-btn brutal-press" id="metroPresetBridge" data-preset="Bridge">+ Bridge</button>
                    <button type="button" class="metro-structure-preset-btn brutal-press" id="metroPresetSolo" data-preset="Solo">+ Solo</button>
                    <button type="button" class="metro-structure-preset-btn brutal-press" id="metroPresetOutro" data-preset="Outro">+ Outro</button>
                    <button type="button" class="metro-structure-preset-btn metro-structure-preset-btn--custom brutal-press" id="metroPresetCustom" data-preset="Custom">+ Custom</button>
                  </div>

                  <!-- Sequence Preview -->
                  <div class="metro-structure-preview" id="metroStructurePreview">
                    <span class="metro-structure-preview-label">FLOW:</span>
                    <div class="metro-structure-preview-flow" id="metroStructureFlow"></div>
                  </div>
                </div>

                <div class="metro-custom-actions">
                  <button type="button" class="metro-custom-cancel brutal-press" id="metroCustomCancelBtn">CANCEL</button>
                  <button type="submit" class="metro-custom-submit brutal-press" id="metroCustomSubmitBtn">
                    <span id="metroCustomSubmitText">SAVE</span>
                  </button>
                </div>
              </form>
            </div>

            <!-- Tab B: Web lookup pane -->
            <div class="metro-song-edit-pane" id="metroSongEditPaneStructure" hidden>
              <div class="metro-setlist-web-search-box">
                <i class="fa-solid fa-magnifying-glass metro-setlist-web-search-icon" aria-hidden="true"></i>
                <input
                  type="search"
                  id="metroSetlistWebSearchInput"
                  class="metro-setlist-web-search-input"
                  placeholder="Search any song or artist (e.g. Nirvana, Radiohead)…"
                  autocomplete="off"
                  spellcheck="false"
                  aria-label="Search song for BPM lookup"
                />
                <button type="button" class="metro-setlist-search-clear brutal-press" id="metroSetlistWebSearchClear" aria-label="Clear web search" hidden>
                  <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
              </div>
              <div class="metro-setlist-web-results" id="metroSetlistWebResults"></div>
            </div>
          </div>

          <!-- 5. CREATE / EDIT SETLIST NAME MODAL/PANE -->
          <div class="metro-view-pane metro-setlist-name-view" id="metroSetlistNameView" hidden>
            <div class="metro-subview-header">
              <button type="button" class="metro-nav-back-btn brutal-press" id="metroSetlistNameBackBtn" aria-label="Back to setlists">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
              </button>
              <h3 class="metro-subview-title" id="metroSetlistNameModalTitle">NEW SETLIST</h3>
              <span class="metro-subview-spacer" aria-hidden="true"></span>
            </div>
            <form class="metro-custom-form" id="metroSetlistNameForm" novalidate>
              <input type="hidden" id="metroSetlistEditId" value="" />
              <div class="metro-custom-field">
                <label class="metro-custom-label" for="metroSetlistNameInput">SETLIST NAME *</label>
                <input class="metro-custom-input" id="metroSetlistNameInput" type="text" maxlength="80" placeholder="e.g. Friday Night Gig" required autocomplete="off" />
                <span class="metro-custom-error" id="metroSetlistNameErr" hidden></span>
              </div>
              <div class="metro-custom-actions">
                <button type="button" class="metro-custom-cancel brutal-press" id="metroSetlistNameCancelBtn">CANCEL</button>
                <button type="submit" class="metro-custom-submit brutal-press" id="metroSetlistNameSubmitBtn">
                  <i class="fa-solid fa-check" aria-hidden="true"></i>
                  <span>SAVE SETLIST</span>
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- FIXED BOTTOM CONTROLS -->
