    font-family:var(--font-secondary); font-size:0.78rem; font-weight:800; cursor:pointer;
    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;
  }
  .metro-coach-mini-chip.active { background:var(--accent-neon-yellow); color:#000; }
  .metro-coach-mini-chip:hover { transform: translate(-1px,-1px); box-shadow:3px 3px 0 #000; }
  .metro-coach-diff-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
  .metro-coach-diff-btn {
