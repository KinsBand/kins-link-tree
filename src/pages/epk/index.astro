---
import EpkLayout from '../../shared/layouts/EpkLayout.astro';
---

<EpkLayout title="The Kins | Official Venue EPK & Booking Portal">
  <div class="view-toggle-bar">
    <div class="view-toggle-brand">
      <i class="fa-solid fa-guitar"></i>
      <span>THE KINS EPK PREVIEW</span>
    </div>
    <div class="view-toggle-buttons">
      <button id="toggleMobileView" class="toggle-btn active">
        <i class="fa-solid fa-mobile-screen-button"></i> Mobile Phone
      </button>
      <button id="toggleFullView" class="toggle-btn">
        <i class="fa-solid fa-desktop"></i> Full Width Desktop
      </button>
    </div>
  </div>

  <div class="app-wrapper">
    <div class="phone-frame" id="phoneFrame">
      <header class="epk-header">
        <a href="#hero" class="brand-logo">
          <span class="brand-name">THE KINS</span>
          <span class="epk-tag">EPK</span>
        </a>
        <nav class="desktop-nav">
          <a href="#quick-facts">Facts</a>
          <a href="#live-video">Video</a>
          <a href="#music">Music</a>
          <a href="#booking" class="nav-cta-link">Book Now</a>
        </nav>
      </header>

      <main class="epk-container">
        <section class="hero-section" id="hero">
          <div class="hero-bg-media">
            <img src={`${import.meta.env.BASE_URL}pfp.jpg`} alt="The Kins live performance" class="hero-img">
            <div class="hero-overlay"></div>
          </div>
          <div class="hero-content">
            <div class="genre-pill-group">
              <span class="badge-pill"><i class="fa-solid fa-fire"></i> INDIE ROCK</span>
              <span class="badge-pill"><i class="fa-solid fa-location-dot"></i> NEWCASTLE, NSW</span>
            </div>
            <h1 class="hero-headline">THE KINS</h1>
            <p class="hero-subheadline">High-energy 4-piece Newcastle indie rock band delivering tight original tracks, massive pub covers, and undeniable stage energy.</p>
            <div class="hero-actions">
              <a href="mailto:Bookings@Kins.au" class="btn primary-btn"><i class="fa-solid fa-calendar-plus"></i> Book The Kins</a>
            </div>
          </div>
        </section>

        <section class="section quick-facts-section" id="quick-facts">
          <h2>Quick Facts for Talent Buyers</h2>
          <div class="quick-facts-grid">
            <div class="fact-card">
              <span class="fact-label">Genre & Vibe</span>
              <span class="fact-value">Indie Rock / Alt Rock</span>
            </div>
            <div class="fact-card">
              <span class="fact-label">Band Lineup</span>
              <span class="fact-value">4 Active Members</span>
            </div>
            <div class="fact-card">
              <span class="fact-label">Performance Length</span>
              <span class="fact-value">30 / 45 / 60 / 90 Mins</span>
            </div>
            <div class="fact-card">
              <span class="fact-label">Direct Contact</span>
              <span class="fact-value">Bookings@Kins.au</span>
            </div>
          </div>
        </section>
      </main>
    </div>
  </div>
</EpkLayout>

<style>
  .epk-body {
    background-color: #0b1410;
    color: #ffffff;
    font-family: var(--font-primary);
  }

  .view-toggle-bar {
    width: 100%;
    background-color: #070d0a;
    padding: 10px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .view-toggle-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--btn-green);
    font-weight: 800;
  }

  .view-toggle-buttons {
    display: flex;
    gap: 8px;
  }

  .toggle-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #fff;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
  }

  .toggle-btn.active {
    background: var(--btn-green);
    color: #0b1f18;
  }

  .app-wrapper {
    display: flex;
    justify-content: center;
    padding: 20px 10px;
  }

  .phone-frame {
    width: 100%;
    max-width: 440px;
    background: linear-gradient(180deg, #11382b 0%, #0b1f18 100%);
    border-radius: 40px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .phone-frame:global(.full-width-mode) {
    max-width: 720px;
    border-radius: 0;
  }

  .epk-header {
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(11, 31, 24, 0.9);
    backdrop-filter: blur(10px);
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: #fff;
    font-weight: 900;
  }

  .epk-tag {
    background: var(--btn-green);
    color: #0b1f18;
    font-size: 0.6rem;
    padding: 2px 6px;
    border-radius: 6px;
  }

  .desktop-nav {
    display: flex;
    gap: 12px;
  }

  .desktop-nav a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .desktop-nav .nav-cta-link {
    color: var(--btn-green);
  }

  .epk-container {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .hero-section {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    padding: 30px 20px;
  }

  .hero-bg-media {
    position: absolute;
    inset: 0;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.4) 0%, rgba(11,31,24,0.95) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .genre-pill-group {
    display: flex;
    gap: 8px;
  }

  .badge-pill {
    background: rgba(83, 198, 120, 0.2);
    border: 1px solid rgba(83, 198, 120, 0.4);
    color: var(--btn-green);
    font-size: 0.68rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 12px;
  }

  .hero-headline {
    font-size: 2.2rem;
    font-weight: 900;
  }

  .hero-subheadline {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.4;
  }

  .primary-btn {
    background: var(--btn-green);
    color: #0b1f18;
    padding: 12px 20px;
    border-radius: 14px;
    text-decoration: none;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .quick-facts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 12px;
  }

  .fact-card {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .fact-label {
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .fact-value {
    font-size: 0.88rem;
    font-weight: 800;
    color: #ffffff;
  }
</style>

<script>
  const phoneFrame = document.getElementById('phoneFrame');
  const toggleMobileViewBtn = document.getElementById('toggleMobileView');
  const toggleFullViewBtn = document.getElementById('toggleFullView');

  if (toggleMobileViewBtn && toggleFullViewBtn && phoneFrame) {
    toggleMobileViewBtn.addEventListener('click', () => {
      phoneFrame.classList.remove('full-width-mode');
      toggleMobileViewBtn.classList.add('active');
      toggleFullViewBtn.classList.remove('active');
    });

    toggleFullViewBtn.addEventListener('click', () => {
      phoneFrame.classList.add('full-width-mode');
      toggleFullViewBtn.classList.add('active');
      toggleMobileViewBtn.classList.remove('active');
    });
  }
</script>
