    </div>

  </div>
</BaseLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<style is:global>
  /* ==========================================================================
     KINS OBSERVABILITY COMMAND CENTER - REDESIGNED 12-COL NEUTRAL DARK THEME
     Palette: #0A0A0D (BG), #121218 (Card), #22222E (Border), #E2F163 (Primary Accent)
     ========================================================================== */

  :root {
    --dash-bg: #0a0a0d;
    --dash-surface: #121218;
    --dash-surface-raised: #181822;
    --dash-surface-hover: #1c1c28;
    --dash-border: #22222e;
    --dash-border-subtle: #191924;
    --dash-border-focus: #e2f163;
    
    --dash-accent: #e2f163;
    --dash-accent-hover: #f0fb7a;
    --dash-accent-bg: rgba(226, 241, 99, 0.08);
