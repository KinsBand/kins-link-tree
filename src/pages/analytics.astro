    --dash-emerald: #10b981;
    --dash-emerald-bg: rgba(16, 185, 129, 0.12);
    --dash-rose: #f43f5e;
    --dash-rose-bg: rgba(244, 63, 94, 0.12);
    --dash-amber: #f59e0b;
    --dash-cyan: #00f0ff;
    --dash-purple: #c084fc;
    --dash-text-muted: #8e8e98;
    --dash-text-dim: #5c5c68;
    --dash-text-main: #f4f4f5;
  }

  .dash-page-wrapper {
    min-height: 100vh;
    background: var(--dash-bg);
    background-image: radial-gradient(circle at 50% 0%, #151520 0%, #0a0a0d 75%);
    color: var(--dash-text-main);
    font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
    padding: 20px 20px 100px 20px;
    box-sizing: border-box;
  }

  .font-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important; }
  .font-bold { font-weight: 700; }
  .hidden { display: none !important; }
  .text-right { text-align: right; }
  .text-center { text-align: center; }
  .text-accent { color: var(--dash-accent) !important; }
  .text-emerald { color: var(--dash-emerald) !important; }
  .text-rose { color: var(--dash-rose) !important; }
  .text-amber { color: var(--dash-amber) !important; }
  .text-cyan { color: var(--dash-cyan) !important; }
  .text-purple { color: var(--dash-purple) !important; }
  .text-muted { color: var(--dash-text-muted) !important; }
  .text-white { color: #ffffff !important; }

  /* Auth Screen Card */
  .dash-auth-card {
    max-width: 440px;
    margin: 80px auto;
