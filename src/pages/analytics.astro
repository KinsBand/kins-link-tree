---
// src/pages/analytics.astro
// Kins Band - Production Observability Command Center (Redesigned 3-View Architecture)
import BaseLayout from '../layouts/BaseLayout.astro';
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Observability Command Center | Kins Band" description="Real-time growth telemetry, inbound social attribution, fan engagement funnels, and UX health diagnostics.">
  <div class="dash-page-wrapper" data-no-track="true">
    
    <!-- AUTHENTICATION SCREEN (Shown when locked) -->
    <div id="dashboard-auth-screen" class="dash-auth-card">
      <div class="auth-icon-circle">
        <i class="fa-solid fa-chart-pie"></i>
      </div>
      <h1 class="auth-title">KINS OBSERVABILITY</h1>
      <p class="auth-subtitle">Enter Admin Passcode to unlock fan growth telemetry, audio funnels, touch ergonomics & live diagnostics.</p>

      <form id="dash-login-form" class="auth-form">
        <input 
          type="password" 
          id="dash-login-pin" 
          placeholder="Enter Passcode (default: kins2026)" 
          class="auth-input"
          autocomplete="current-password"
        />
        <p id="dash-login-error" class="auth-error hidden">Invalid passcode. Please try again.</p>
        <button type="submit" class="auth-btn brutal-btn">
          Unlock Command Center
        </button>
      </form>

      <div class="auth-footer">
        <span>Default PIN: <code>kins2026</code></span>
        <a href={baseUrl} class="auth-back-link">← Back to Site</a>
      </div>
    </div>

    <!-- MAIN DASHBOARD CONTENT (Shown when authenticated) -->
    <div id="dashboard-content" class="dash-main-container hidden">
      
      <!-- TOP COMMAND BAR -->
      <header class="dash-header">
        <div class="dash-brand-block">
          <div class="dash-logo-box">
            <i class="fa-solid fa-chart-line"></i>
          </div>
          <div>
            <div class="dash-title-row">
              <h1 class="dash-main-title">KINS OBSERVABILITY</h1>
              <span class="live-telemetry-badge">
                <span class="live-dot"></span> LIVE
              </span>
            </div>
            <p class="dash-subtitle">Command Center • Inbound Attribution • Experience Diagnostics</p>
          </div>
        </div>

        <!-- 3-VIEW SWITCHER TABS -->
        <nav class="dash-view-tabs" id="dash-view-tabs" aria-label="Dashboard Views">
          <button class="view-tab-btn active" data-view="growth" id="tab-btn-growth">
            <i class="fa-solid fa-arrow-trend-up"></i>
            <span>Growth & Bio-Links</span>
          </button>
          <button class="view-tab-btn" data-view="engagement" id="tab-btn-engagement">
            <i class="fa-solid fa-compact-disc"></i>
            <span>Fan Engagement</span>
          </button>
          <button class="view-tab-btn" data-view="uxhealth" id="tab-btn-uxhealth">
            <i class="fa-solid fa-heart-pulse"></i>
            <span>UX & Site Health</span>
          </button>
        </nav>

        <!-- GLOBAL ACTIONS TOOLBAR -->
        <div class="dash-actions-toolbar">
          <!-- Slide-over Bio Link Builder Trigger -->
          <button id="open-link-builder-btn" class="dash-primary-btn" title="Create tracked bio link">
            <i class="fa-solid fa-plus"></i>
            <span>Build Link</span>
          </button>

          <!-- Time Range Selector -->
          <div class="filter-pill-group" id="dash-time-filters">
            <button data-range="24h" class="range-btn active">24H</button>
            <button data-range="7d" class="range-btn">7D</button>
            <button data-range="30d" class="range-btn">30D</button>
            <button data-range="all" class="range-btn">ALL</button>
          </div>

          <!-- Auto Refresh Selector -->
          <div class="filter-pill-group" id="dash-poll-filters" title="Auto-Refresh Interval">
            <button data-poll="0" class="poll-btn active">OFF</button>
            <button data-poll="5000" class="poll-btn">5s</button>
            <button data-poll="15000" class="poll-btn">15s</button>
            <button data-poll="30000" class="poll-btn">30s</button>
          </div>

          <button id="export-leads-csv-btn" class="dash-icon-btn" title="Export VIP Leads Spreadsheet (CSV)">
            <i class="fa-solid fa-file-csv"></i>
          </button>

          <button id="export-json-btn" class="dash-icon-btn" title="Export Full JSON Telemetry">
            <i class="fa-solid fa-file-code"></i>
          </button>

          <button id="open-heatmap-from-dash" class="dash-icon-btn heatmap-accent" title="Open Live Heatmap HUD (Ctrl+Shift+H)">
            <span>🔥</span>
          </button>

          <button id="change-pin-btn" class="dash-icon-btn" title="Change Admin Passcode">
            <i class="fa-solid fa-key"></i>
          </button>

          <button id="dash-refresh-btn" class="dash-icon-btn" title="Refresh Live Metrics">
            <i class="fa-solid fa-rotate-right"></i>
          </button>

          <button id="dash-logout-btn" class="dash-icon-btn logout-accent" title="Lock Dashboard">
            <i class="fa-solid fa-lock"></i>
          </button>
        </div>
      </header>

      <!-- CONDENSED TOP METRIC SCORECARDS BAR -->
      <section class="top-metrics-bar">
        <div class="metric-scorecard">
          <div class="scorecard-top">
            <span class="scorecard-label">Active Visitors</span>
            <i class="fa-solid fa-users scorecard-icon"></i>
          </div>
          <div class="scorecard-val-row">
            <span class="scorecard-val font-mono" id="kpi-visitors">--</span>
            <span class="scorecard-delta delta-up"><i class="fa-solid fa-arrow-trend-up"></i> +14%</span>
          </div>
          <div class="scorecard-meta" id="kpi-visitor-meta">Live deduplicated sessions</div>
        </div>

        <div class="metric-scorecard">
          <div class="scorecard-top">
            <span class="scorecard-label">Total Views</span>
            <i class="fa-solid fa-eye scorecard-icon"></i>
          </div>
          <div class="scorecard-val-row">
            <span class="scorecard-val font-mono" id="kpi-pageviews">--</span>
            <span class="scorecard-delta delta-neutral" id="kpi-pv-per-user">-- / visitor</span>
          </div>
          <div class="scorecard-meta">Interactions & page impressions</div>
        </div>

        <div class="metric-scorecard">
          <div class="scorecard-top">
            <span class="scorecard-label">Outbound CTR</span>
            <i class="fa-brands fa-spotify scorecard-icon"></i>
          </div>
          <div class="scorecard-val-row">
            <span class="scorecard-val font-mono text-accent" id="kpi-outbound-ctr">--%</span>
            <span class="scorecard-delta delta-up" id="kpi-outbound-count">-- clicks</span>
          </div>
          <div class="scorecard-meta">Streaming & social bio handoffs</div>
        </div>

        <div class="metric-scorecard">
          <div class="scorecard-top">
            <span class="scorecard-label">CWV & UX Health</span>
            <i class="fa-solid fa-shield-check scorecard-icon"></i>
          </div>
          <div class="scorecard-val-row">
            <span class="scorecard-val font-mono text-emerald" id="kpi-ux-score">98%</span>
            <span class="scorecard-delta badge-pass" id="kpi-ux-badge">Optimal</span>
          </div>
          <div class="scorecard-meta" id="kpi-ux-meta">LCP 1.1s • INP 28ms • CLS 0.01</div>
        </div>
      </section>

      <!-- =========================================================================
           VIEW A: FAN ACQUISITION & GROWTH (MARKETING & BIO-LINKS)
           ========================================================================= -->
      <main id="view-growth" class="dash-view-container active">
        <div class="dash-grid-12">
          
          <!-- PRIMARY TREND CANVAS (8 Cols) -->
          <div class="dash-card col-8">
            <div class="card-header">
              <div>
                <h2 class="card-title">INBOUND TRAFFIC VS CONVERSIONS</h2>
                <p class="card-subtitle">Synchronized timeline: visitor traffic volume vs conversion actions over time</p>
              </div>
              <div class="chart-legend-pills">
                <span class="legend-pill"><span class="legend-dot dot-traffic"></span> Pageviews</span>
                <span class="legend-pill"><span class="legend-dot dot-visitors"></span> Unique Visitors</span>
                <span class="legend-pill"><span class="legend-dot dot-conv"></span> Conversions</span>
              </div>
            </div>
            <div class="chart-container-lg">
              <canvas id="trafficTrendChart"></canvas>
            </div>
          </div>

          <!-- BREAKDOWN MATRIX: TOP REFERRERS & CHANNELS (4 Cols) -->
          <div class="dash-card col-4 flex-col-between">
            <div>
              <div class="card-header">
                <div>
                  <h2 class="card-title">ACQUISITION CHANNELS</h2>
                  <p class="card-subtitle">Where fans are arriving from</p>
                </div>
                <i class="fa-solid fa-share-nodes card-header-icon"></i>
              </div>

              <div class="channels-breakdown-list" id="channels-breakdown-list">
                <!-- Dynamically populated -->
              </div>
            </div>

            <div class="card-footer-tip">
              <i class="fa-solid fa-lightbulb text-accent"></i>
              <span>High conversion from TikTok & Instagram bio profiles detected.</span>
            </div>
          </div>

          <!-- INBOUND ATTRIBUTION MATRIX (8 Cols) -->
          <div class="dash-card col-8">
            <div class="card-header">
              <div>
                <h2 class="card-title">INBOUND ATTRIBUTION MATRIX</h2>
                <p class="card-subtitle">Cross-tabulated channel performance & conversion efficiency</p>
              </div>
              <span class="card-badge"><i class="fa-solid fa-link text-accent"></i> First-Touch Attribution</span>
            </div>

            <div class="table-wrapper">
              <table class="dash-table">
                <thead>
                  <tr>
                    <th>Platform & Tracked Bio Alias</th>
                    <th class="text-right">Visitors</th>
                    <th class="text-right">Song Plays</th>
                    <th class="text-right">Stream Clicks</th>
                    <th class="text-right">Conversions</th>
                    <th class="text-right">Conv. Rate</th>
                  </tr>
                </thead>
                <tbody id="inbound-channels-tbody">
                  <!-- Populated dynamically via JS -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- STREAMING PLATFORM DISTRIBUTION (4 Cols) -->
          <div class="dash-card col-4 flex-col-between">
            <div>
              <div class="card-header">
                <div>
                  <h2 class="card-title">STREAMING DESTINATIONS</h2>
                  <p class="card-subtitle">Outbound click handoffs by service</p>
                </div>
                <i class="fa-solid fa-arrow-up-right-from-square card-header-icon"></i>
              </div>

              <div class="streaming-platform-bars" id="streaming-platform-bars">
                <!-- Populated via JS -->
              </div>
            </div>

            <div class="card-footer-stat">
              <span class="stat-label">Top Destination:</span>
              <span class="stat-value font-mono text-accent" id="top-streaming-dest">Spotify (64%)</span>
            </div>
          </div>

        </div>
      </main>

      <!-- =========================================================================
           VIEW B: FAN ENGAGEMENT & CONTENT INTELLIGENCE (MUSIC & EXPERIENCE)
           ========================================================================= -->
      <main id="view-engagement" class="dash-view-container">
        <div class="dash-grid-12">
          
          <!-- AUDIO RETENTION STEP FUNNEL (6 Cols) -->
          <div class="dash-card col-6 flex-col-between">
            <div>
              <div class="card-header">
                <div>
                  <h2 class="card-title">AUDIO PLAYBACK STEP FUNNEL</h2>
                  <p class="card-subtitle">Track progression retention & mid-song drop-off rates</p>
                </div>
                <i class="fa-solid fa-compact-disc text-accent"></i>
              </div>

              <!-- Interconnected Horizontal Step Funnel -->
              <div class="funnel-container">
                <div class="funnel-step" id="funnel-step-0">
                  <div class="step-meta">
                    <span class="step-name">Play Start</span>
                    <span class="step-count font-mono" id="funnel-val-starts">--</span>
                  </div>
                  <div class="step-bar-track">
                    <div class="step-bar-fill" id="funnel-fill-0" style="width: 100%;"></div>
                  </div>
                  <span class="step-pct font-mono">100%</span>
                </div>

                <div class="funnel-drop-arrow">
                  <span class="drop-label" id="drop-label-1">−18% drop</span>
                  <i class="fa-solid fa-chevron-down"></i>
                </div>

                <div class="funnel-step" id="funnel-step-25">
                  <div class="step-meta">
                    <span class="step-name">25% Mark</span>
                    <span class="step-count font-mono" id="funnel-val-25">--</span>
                  </div>
                  <div class="step-bar-track">
                    <div class="step-bar-fill" id="funnel-fill-25" style="width: 82%;"></div>
                  </div>
                  <span class="step-pct font-mono" id="funnel-pct-25">82%</span>
                </div>

                <div class="funnel-drop-arrow">
                  <span class="drop-label" id="drop-label-2">−17% drop</span>
                  <i class="fa-solid fa-chevron-down"></i>
                </div>

                <div class="funnel-step" id="funnel-step-50">
                  <div class="step-meta">
                    <span class="step-name">50% Halfway</span>
                    <span class="step-count font-mono" id="funnel-val-50">--</span>
                  </div>
                  <div class="step-bar-track">
                    <div class="step-bar-fill" id="funnel-fill-50" style="width: 65%;"></div>
                  </div>
                  <span class="step-pct font-mono" id="funnel-pct-50">65%</span>
                </div>

                <div class="funnel-drop-arrow">
                  <span class="drop-label" id="drop-label-3">−17% drop</span>
                  <i class="fa-solid fa-chevron-down"></i>
                </div>

                <div class="funnel-step" id="funnel-step-75">
                  <div class="step-meta">
                    <span class="step-name">75% Climax</span>
                    <span class="step-count font-mono" id="funnel-val-75">--</span>
                  </div>
                  <div class="step-bar-track">
                    <div class="step-bar-fill" id="funnel-fill-75" style="width: 48%;"></div>
                  </div>
                  <span class="step-pct font-mono" id="funnel-pct-75">48%</span>
                </div>

                <div class="funnel-drop-arrow">
                  <span class="drop-label" id="drop-label-4">−10% drop</span>
                  <i class="fa-solid fa-chevron-down"></i>
                </div>

                <div class="funnel-step completed-step" id="funnel-step-100">
                  <div class="step-meta">
                    <span class="step-name">100% Completed</span>
                    <span class="step-count font-mono" id="funnel-val-100">--</span>
                  </div>
                  <div class="step-bar-track">
                    <div class="step-bar-fill fill-accent" id="funnel-fill-100" style="width: 38%;"></div>
                  </div>
                  <span class="step-pct font-mono text-accent font-bold" id="funnel-pct-100">38%</span>
                </div>
              </div>
            </div>

            <div class="funnel-summary-banner">
              <div class="summary-metric">
                <span class="sub-label">Completion Rate</span>
                <span class="sub-val font-mono text-accent" id="funnel-summary-rate">38%</span>
              </div>
              <div class="summary-metric">
                <span class="sub-label">Mid-Track Loss (25%-75%)</span>
                <span class="sub-val font-mono text-rose" id="funnel-summary-drop">34%</span>
              </div>
              <div class="summary-metric">
                <span class="sub-label">Avg Preview Duration</span>
                <span class="sub-val font-mono text-white" id="funnel-summary-time">28s</span>
              </div>
            </div>
          </div>

          <!-- FAN SEARCH DEMAND INDEX (6 Cols) -->
          <div class="dash-card col-6 flex-col-between">
            <div>
              <div class="card-header">
                <div>
                  <h2 class="card-title">FAN SEARCH DEMAND INDEX</h2>
                  <p class="card-subtitle">Cover song & artist keywords searched by fans</p>
                </div>
                <span class="card-badge"><i class="fa-solid fa-magnifying-glass text-accent"></i> Repertoire QA</span>
              </div>

              <div class="table-wrapper">
                <table class="dash-table">
                  <thead>
                    <tr>
                      <th style="width: 40px;">#</th>
                      <th>Search Keyword / Artist</th>
                      <th class="text-right">Volume</th>
                      <th class="text-center">Velocity</th>
                      <th class="text-right">Repertoire Status</th>
                    </tr>
                  </thead>
                  <tbody id="search-demand-tbody">
                    <!-- Populated dynamically via JS -->
                  </tbody>
                </table>
              </div>
            </div>

            <div class="card-footer-tip">
              <i class="fa-solid fa-bullhorn text-accent"></i>
              <span>High unreleased demand for <strong>Radiohead</strong> and <strong>Arctic Monkeys</strong>. Recommended for next video session!</span>
            </div>
          </div>

          <!-- INTERACTION DENSITY MAP (8 Cols) -->
          <div class="dash-card col-8">
            <div class="card-header">
              <div>
                <h2 class="card-title">INTERACTION DENSITY MAP</h2>
                <p class="card-subtitle">Highest engaged UI components, modal opens, and interactive touchpoints</p>
              </div>
              <span class="card-badge"><i class="fa-solid fa-hand-pointer text-accent"></i> UI Heat</span>
            </div>

            <div class="interaction-density-grid" id="interaction-density-grid">
              <!-- Populated dynamically via JS -->
            </div>
          </div>

          <!-- HIGH INTENT CONVERSION ACTIONS (4 Cols) -->
          <div class="dash-card col-4 flex-col-between">
            <div>
              <div class="card-header">
                <div>
                  <h2 class="card-title">CONVERSION ACTIONS</h2>
                  <p class="card-subtitle">High-intent fan conversion distribution</p>
                </div>
                <i class="fa-solid fa-bullseye card-header-icon"></i>
              </div>

              <div class="conversion-actions-list">
                <div class="conv-action-item">
                  <div class="conv-action-left">
                    <div class="conv-icon-box icon-emerald"><i class="fa-solid fa-ticket"></i></div>
                    <div>
                      <span class="conv-title">Tour Ticket Clicks</span>
                      <span class="conv-sub">Gig map ticket links</span>
                    </div>
                  </div>
                  <span class="conv-val font-mono" id="stat-gig-tickets">--</span>
                </div>

                <div class="conv-action-item">
                  <div class="conv-action-left">
                    <div class="conv-icon-box icon-accent"><i class="fa-solid fa-file-pdf"></i></div>
                    <div>
                      <span class="conv-title">EPK Deck Downloads</span>
                      <span class="conv-sub">Press & promoter kit</span>
                    </div>
                  </div>
                  <span class="conv-val font-mono" id="stat-epk-downloads">--</span>
                </div>

                <div class="conv-action-item">
                  <div class="conv-action-left">
                    <div class="conv-icon-box icon-cyan"><i class="fa-solid fa-envelope"></i></div>
                    <div>
                      <span class="conv-title">VIP Newsletter</span>
                      <span class="conv-sub">Substack subscriber opt-ins</span>
                    </div>
                  </div>
                  <span class="conv-val font-mono" id="stat-newsletter">--</span>
                </div>

                <div class="conv-action-item">
                  <div class="conv-action-left">
                    <div class="conv-icon-box icon-purple"><i class="fa-solid fa-comment-dots"></i></div>
                    <div>
                      <span class="conv-title">Community Feedback</span>
                      <span class="conv-sub">Fan messages & song votes</span>
                    </div>
                  </div>
                  <span class="conv-val font-mono" id="stat-feedback">--</span>
                </div>
              </div>
            </div>

            <div class="total-conv-badge">
              <span>Total Direct Conversions:</span>
              <strong class="font-mono text-accent" id="stat-total-conversions">--</strong>
            </div>
          </div>

        </div>
      </main>

      <!-- =========================================================================
           VIEW C: TECHNICAL UX & SITE HEALTH (RUM & DIAGNOSTICS)
           ========================================================================= -->
      <main id="view-uxhealth" class="dash-view-container">
        <div class="dash-grid-12">
          
          <!-- CORE WEB VITALS SCORECARDS (6 Cols) -->
          <div class="dash-card col-6 flex-col-between">
            <div>
              <div class="card-header">
                <div>
                  <h2 class="card-title">CORE WEB VITALS (RUM)</h2>
                  <p class="card-subtitle">Real User Monitoring field metrics vs Google thresholds</p>
                </div>
                <span class="badge-pass"><i class="fa-solid fa-circle-check"></i> All Passing</span>
              </div>

              <div class="cwv-gauges-grid">
                <div class="cwv-gauge-card">
                  <div class="cwv-top">
                    <span class="cwv-label">LCP</span>
                    <span class="badge-tag pass">Good</span>
                  </div>
                  <div class="cwv-val font-mono text-emerald" id="vital-lcp">1.1s</div>
                  <div class="cwv-desc">Largest Contentful Paint</div>
                  <div class="cwv-threshold">&lt; 2.5s threshold</div>
                </div>

                <div class="cwv-gauge-card">
                  <div class="cwv-top">
                    <span class="cwv-label">INP</span>
                    <span class="badge-tag pass">Good</span>
                  </div>
                  <div class="cwv-val font-mono text-emerald" id="vital-inp">28ms</div>
                  <div class="cwv-desc">Interaction to Next Paint</div>
                  <div class="cwv-threshold">&lt; 200ms threshold</div>
                </div>

                <div class="cwv-gauge-card">
                  <div class="cwv-top">
                    <span class="cwv-label">CLS</span>
                    <span class="badge-tag pass">Good</span>
                  </div>
                  <div class="cwv-val font-mono text-emerald" id="vital-cls">0.010</div>
                  <div class="cwv-desc">Cumulative Layout Shift</div>
                  <div class="cwv-threshold">&lt; 0.10 threshold</div>
                </div>
              </div>
            </div>

            <div class="vitals-alert-banner">
              <i class="fa-solid fa-shield-check text-emerald"></i>
              <span>Zero layout shifts or interaction latency spikes detected across mobile devices.</span>
            </div>
          </div>

          <!-- UX FRICTION DIAGNOSTICS & SCORECARD (6 Cols) -->
          <div class="dash-card col-6 flex-col-between">
            <div>
              <div class="card-header">
                <div>
                  <h2 class="card-title">UX FRICTION & TOUCH ACCURACY</h2>
                  <p class="card-subtitle">Centering accuracy, rage taps, and dead clicks diagnostics</p>
                </div>
                <span class="card-badge"><i class="fa-solid fa-fingerprint text-accent"></i> Ergonomics</span>
              </div>

              <!-- Aggregated UX Friction Score Banner -->
              <div class="ux-score-banner">
                <div class="ux-score-left">
                  <span class="ux-score-title">Aggregated UX Friction Index</span>
                  <span class="ux-score-status" id="ux-status-text">98% Clean UX (Optimal Experience)</span>
                </div>
                <div class="ux-score-number font-mono text-emerald" id="ux-score-number">98%</div>
              </div>

              <div class="friction-metrics-grid">
                <div class="friction-card">
                  <span class="f-label">Rage Clicks</span>
                  <span class="f-val font-mono text-rose" id="stat-rage-clicks">0</span>
                  <span class="f-sub">Rapid taps</span>
                </div>

                <div class="friction-card">
                  <span class="f-label">Dead Clicks</span>
                  <span class="f-val font-mono text-amber" id="stat-dead-clicks">0</span>
                  <span class="f-sub">Unlinked taps</span>
                </div>

                <div class="friction-card">
                  <span class="f-label">Near Misses</span>
                  <span class="f-val font-mono text-accent" id="stat-near-misses">0</span>
                  <span class="f-sub">&lt;16px off hitbox</span>
                </div>

                <div class="friction-card">
                  <span class="f-label">Touch Precision</span>
                  <span class="f-val font-mono text-cyan" id="stat-touch-acc">98%</span>
                  <span class="f-sub">Hitbox center</span>
