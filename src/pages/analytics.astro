<script>
  import { isUserAdmin, authenticateAdmin, logoutAdmin, setCustomAdminPasscode } from '../lib/adminAuth';
  import { fetchLiveAnalyticsData } from '../lib/analytics';
  import { generateCampaignUrl } from '../lib/attribution';

  declare const Chart: any;

  let activeRange: '24h' | '7d' | '30d' | 'all' = '24h';
  let chartInstances: Record<string, any> = {};
  let autoPollTimer: any = null;

  const authScreen = document.getElementById('dashboard-auth-screen');
  const dashContent = document.getElementById('dashboard-content');
  const loginForm = document.getElementById('dash-login-form');
  const loginPinInput = document.getElementById('dash-login-pin') as HTMLInputElement | null;
  const loginError = document.getElementById('dash-login-error');
  const logoutBtn = document.getElementById('dash-logout-btn');
  const refreshBtn = document.getElementById('dash-refresh-btn');
  const openHeatmapBtn = document.getElementById('open-heatmap-from-dash');
  const triggerHudBottom = document.getElementById('trigger-hud-bottom');
  const changePinBtn = document.getElementById('change-pin-btn');
  const changePinModal = document.getElementById('change-pin-modal');
  const cancelPinBtn = document.getElementById('cancel-pin-btn');
  const changePinForm = document.getElementById('change-pin-form');
  const newPinInput = document.getElementById('new-pin-input') as HTMLInputElement | null;

  const builderPlatform = document.getElementById('builder-platform') as HTMLSelectElement | null;
  const builderOutputUrl = document.getElementById('builder-output-url') as HTMLInputElement | null;
  const builderCopyBtn = document.getElementById('builder-copy-btn');

  function updateCampaignUrlOutput() {
    if (!builderPlatform || !builderOutputUrl) return;
    const origin = window.location.origin + window.location.pathname.replace('analytics', '').replace(/\/$/, '');
    builderOutputUrl.value = generateCampaignUrl(origin, builderPlatform.value);
  }

  if (builderPlatform) builderPlatform.addEventListener('change', updateCampaignUrlOutput);
  if (builderCopyBtn && builderOutputUrl) {
    builderCopyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(builderOutputUrl.value);
      alert('Campaign bio link copied to clipboard!');
    });
  }

  function checkAuth() {
    if (isUserAdmin()) {
      if (authScreen) authScreen.classList.add('hidden');
      if (dashContent) dashContent.classList.remove('hidden');
      updateCampaignUrlOutput();
      refreshDashboardData();
    } else {
      if (authScreen) authScreen.classList.remove('hidden');
      if (dashContent) dashContent.classList.add('hidden');
      if (loginPinInput) loginPinInput.focus();
    }
  }

  if (loginForm && loginPinInput) {
    loginForm.addEventListener('submit', (e) => {
      e.preventDefault();
      if (authenticateAdmin(loginPinInput.value)) {
        if (loginError) loginError.classList.add('hidden');
        checkAuth();
      } else {
        if (loginError) loginError.classList.remove('hidden');
        loginPinInput.focus();
      }
    });
  }

  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      logoutAdmin();
      checkAuth();
    });
  }

  if (refreshBtn) {
    refreshBtn.addEventListener('click', () => {
      refreshBtn.querySelector('i')?.classList.add('fa-spin');
      refreshDashboardData().then(() => {
        setTimeout(() => refreshBtn.querySelector('i')?.classList.remove('fa-spin'), 400);
      });
    });
  }

  // Auto-Poll Selector
  const pollBtns = document.querySelectorAll('#dash-poll-filters .dash-poll-btn');
  pollBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      pollBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const intervalMs = Number(btn.getAttribute('data-poll') || '0');

      if (autoPollTimer) {
        clearInterval(autoPollTimer);
        autoPollTimer = null;
      }

      if (intervalMs > 0) {
        autoPollTimer = setInterval(() => {
          refreshDashboardData();
        }, intervalMs);
      }
    });
  });

  function triggerHeatmapShortcut() {
    const event = new KeyboardEvent('keydown', {
      key: 'H',
      shiftKey: true,
      ctrlKey: true,
      bubbles: true
    });
    window.dispatchEvent(event);
  }

  if (openHeatmapBtn) openHeatmapBtn.addEventListener('click', triggerHeatmapShortcut);
  if (triggerHudBottom) triggerHudBottom.addEventListener('click', triggerHeatmapShortcut);

  if (changePinBtn && changePinModal) {
    changePinBtn.addEventListener('click', () => changePinModal.classList.remove('hidden'));
  }
  if (cancelPinBtn && changePinModal) {
    cancelPinBtn.addEventListener('click', () => changePinModal.classList.add('hidden'));
  }
  if (changePinForm && newPinInput && changePinModal) {
    changePinForm.addEventListener('submit', (e) => {
      e.preventDefault();
      if (setCustomAdminPasscode(newPinInput.value)) {
        alert('Admin passcode updated successfully!');
        changePinModal.classList.add('hidden');
        newPinInput.value = '';
      }
    });
  }

  const rangeBtns = document.querySelectorAll('#dash-time-filters .dash-range-btn');
  rangeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      rangeBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeRange = btn.getAttribute('data-range') as any || '24h';
      refreshDashboardData();
    });
  });

  let latestAnalyticsData: any = null;

  // 1-Click Export Leads CSV
  const exportCsvBtn = document.getElementById('export-leads-csv-btn');
  if (exportCsvBtn) {
    exportCsvBtn.addEventListener('click', () => {
      if (!latestAnalyticsData) return;
      const events = latestAnalyticsData.rawEvents || [];
      const leadEvents = events.filter((e: any) => 
        e.event_type === 'newsletter_signup_submitted' || 
        e.event_type === 'epk_deck_download' || 
        e.event_type === 'epk_deck_asset_downloaded' || 
        e.event_type === 'gig_map_ticket_cta_clicked'
      );

      const rows = [
        ['Timestamp', 'Event Type', 'Lead Category', 'Label / Detail', 'Inbound Channel', 'Inbound Alias', 'Device', 'Region']
      ];

      leadEvents.forEach((e: any) => {
        rows.push([
          `"${new Date(e.created_at).toISOString()}"`,
          `"${e.event_type}"`,
          `"${e.category || 'conversion'}"`,
          `"${(e.label || '').replace(/"/g, '""')}"`,
          `"${e.metadata?.inbound_channel || 'Direct'}"`,
          `"${e.metadata?.inbound_alias || 'Direct'}"`,
          `"${e.device || 'desktop'}"`,
          `"${e.metadata?.region || 'Global'}"`
        ]);
      });

      const csvContent = 'data:text/csv;charset=utf-8,' + rows.map(r => r.join(',')).join('\n');
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement('a');
      link.setAttribute('href', encodedUri);
      link.setAttribute('download', `kins_leads_export_${new Date().toISOString().split('T')[0]}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });
  }

  // 1-Click Export Full JSON Telemetry
  const exportJsonBtn = document.getElementById('export-json-btn');
  if (exportJsonBtn) {
    exportJsonBtn.addEventListener('click', () => {
      if (!latestAnalyticsData) return;
      const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(latestAnalyticsData, null, 2));
      const link = document.createElement('a');
      link.setAttribute('href', dataStr);
      link.setAttribute('download', `kins_analytics_dump_${new Date().toISOString().split('T')[0]}.json`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });
  }

  async function refreshDashboardData() {
    const data = await fetchLiveAnalyticsData(activeRange);
    latestAnalyticsData = data;

    const el = (id: string) => document.getElementById(id);
    if (el('kpi-visitors')) el('kpi-visitors')!.textContent = data.visitors.toLocaleString();
    if (el('kpi-pageviews')) el('kpi-pageviews')!.textContent = data.pageviews.toLocaleString();
    if (el('kpi-pv-per-user')) el('kpi-pv-per-user')!.textContent = `${data.pvPerUser} / visitor`;
    if (el('kpi-outbound')) el('kpi-outbound')!.textContent = data.outbound.toLocaleString();
    if (el('kpi-audio-plays')) el('kpi-audio-plays')!.textContent = data.audioPlays.toLocaleString();
    if (el('kpi-avg-listen')) el('kpi-avg-listen')!.textContent = `${data.avgListen} avg listen`;
    if (el('kpi-touch-acc')) el('kpi-touch-acc')!.textContent = `${data.touchMetrics.touchAccuracyScore}%`;
    if (el('kpi-touch-ratio')) el('kpi-touch-ratio')!.textContent = `${data.mobilePct}% Mobile • ${data.desktopPct}% Desk`;

    // Pulse Bar
    if (el('pulse-active-sessions')) el('pulse-active-sessions')!.textContent = `${data.visitors}`;
    if (el('pulse-conversion-rate')) el('pulse-conversion-rate')!.textContent = `${data.conversionRate}%`;

    const tickerBox = el('pulse-ticker-items');
    if (tickerBox && data.recentActivities) {
      tickerBox.innerHTML = data.recentActivities.map((act: any) => `
        <span class="pulse-item"><i class="${act.icon} ${act.color}"></i> ${act.text} • <small style="color: #71717a;">${act.time}</small></span>
      `).join('');
    }

    // Touch & Friction Stats
    if (el('stat-rage-clicks')) el('stat-rage-clicks')!.textContent = `${data.touchMetrics.rageClicksCount}`;
    if (el('stat-dead-clicks')) el('stat-dead-clicks')!.textContent = `${data.touchMetrics.deadClicksCount}`;
    if (el('stat-near-misses')) el('stat-near-misses')!.textContent = `${data.touchMetrics.nearMissCount}`;
    if (el('stat-touch-share')) el('stat-touch-share')!.textContent = `${data.touchMetrics.touchPct}%`;

    // Search Queries
    const searchBox = el('search-queries-list');
    if (searchBox && data.topSearches) {
      searchBox.innerHTML = data.topSearches.map((sq: any) => `
        <div class="search-query-row">
          <span style="font-weight: 700; color: #ffffff;"><i class="fa-solid fa-magnifying-glass text-yellow" style="font-size: 0.75rem; margin-right: 6px;"></i>"${sq.term}"</span>
          <span class="font-mono text-cyan font-bold">${sq.count} searches</span>
        </div>
      `).join('');
    }

    const igCount = data.referrers['Instagram'] || 0;
    const ttCount = data.referrers['TikTok'] || 0;
    const spCount = data.referrers['Spotify'] || 0;

    if (el('ref-stat-ig')) el('ref-stat-ig')!.textContent = igCount.toLocaleString();
    if (el('ref-stat-tt')) el('ref-stat-tt')!.textContent = ttCount.toLocaleString();
    if (el('ref-stat-sp')) el('ref-stat-sp')!.textContent = spCount.toLocaleString();

    if (el('stat-gig-tickets')) el('stat-gig-tickets')!.textContent = data.gigTickets.toLocaleString();
    if (el('stat-epk-downloads')) el('stat-epk-downloads')!.textContent = data.epkDownloads.toLocaleString();
    if (el('stat-newsletter')) el('stat-newsletter')!.textContent = data.newsletter.toLocaleString();

    const completePct = data.audioFunnel.starts > 0 
      ? Math.round((data.audioFunnel.completed / data.audioFunnel.starts) * 100)
      : 100;
    if (el('audio-complete-rate')) el('audio-complete-rate')!.textContent = `${completePct}%`;

    if (el('vital-lcp')) el('vital-lcp')!.textContent = data.lcp;
    if (el('vital-inp')) el('vital-inp')!.textContent = data.inp;
    if (el('vital-cls')) el('vital-cls')!.textContent = data.cls;

    // Populate Inbound Channels Table
    const tbody = el('inbound-channels-tbody');
    if (tbody && data.inboundChannels) {
      tbody.innerHTML = data.inboundChannels.map((ch: any) => `
        <tr>
          <td>
            <div style="font-weight: 800; color: #ffffff;">${ch.channel}</div>
            <code style="color: #f2fd43; font-size: 0.68rem;">tinyurl.com/${ch.alias}</code>
          </td>
          <td class="text-right font-mono font-bold">${ch.visitors.toLocaleString()}</td>
          <td class="text-right font-mono text-purple">${ch.audioPlays.toLocaleString()}</td>
          <td class="text-right font-mono text-emerald">${ch.outboundClicks.toLocaleString()}</td>
          <td class="text-right font-mono text-cyan font-bold">${ch.conversions.toLocaleString()}</td>
        </tr>
      `).join('');
    }

    // Populate Top Elements List
    const topElList = el('top-elements-list');
    if (topElList && data.topElements) {
      topElList.innerHTML = data.topElements.map((te: any) => `
        <div class="top-el-row">
          <span style="color: #d4d4d8; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 170px;">
            ${te.label}
          </span>
          <span class="font-mono text-yellow font-bold">${te.count} clicks</span>
        </div>
      `).join('');
    }

    // Error Logs Feed
    const logContainer = el('error-log-container');
    const errBadge = el('error-count-badge');
    if (errBadge) errBadge.textContent = `${data.errorLogs.length} errors`;
    if (logContainer) {
      if (data.errorLogs.length === 0) {
        logContainer.innerHTML = `
          <div class="empty-log-state">
            <i class="fa-solid fa-circle-check text-emerald log-state-icon"></i>
            <div>No unhandled runtime errors recorded. Everything is operating smoothly.</div>
          </div>
        `;
      } else {
        logContainer.innerHTML = data.errorLogs.map((err: any) => `
          <div style="background: rgba(244,63,94,0.1); border: 1px solid rgba(244,63,94,0.3); border-radius: 6px; padding: 8px;">
            <div style="color: #fb7185; font-weight: bold;">[${err.device.toUpperCase()}] ${err.error_message || 'JavaScript Exception'}</div>
            <div style="color: #71717a; font-size: 0.65rem; margin-top: 2px;">${new Date(err.created_at).toLocaleTimeString()} • ${err.path}</div>
          </div>
        `).join('');
      }
    }

    renderAllCharts(data);
  }

  function renderAllCharts(data: any) {
    if (typeof Chart === 'undefined') {
      setTimeout(() => renderAllCharts(data), 200);
      return;
    }

    Chart.defaults.color = '#a1a1aa';
    Chart.defaults.font.family = "'Space Grotesk', sans-serif";

    // 1. Traffic Timeline Chart
    const trafficCtx = (document.getElementById('trafficTimelineChart') as HTMLCanvasElement)?.getContext('2d');
    if (trafficCtx) {
      if (chartInstances.traffic) chartInstances.traffic.destroy();

      chartInstances.traffic = new Chart(trafficCtx, {
        type: 'line',
        data: {
          labels: data.timeline.labels,
          datasets: [
            {
              label: 'Pageviews',
              data: data.timeline.pageviews,
              borderColor: '#f2fd43',
              backgroundColor: 'rgba(242, 253, 67, 0.12)',
              borderWidth: 3,
              fill: true,
              tension: 0.4,
              pointBackgroundColor: '#f2fd43',
              pointRadius: 4
            },
            {
              label: 'Unique Visitors',
              data: data.timeline.visitors,
              borderColor: '#00f0ff',
              backgroundColor: 'rgba(0, 240, 255, 0.08)',
              borderWidth: 2.5,
              fill: true,
              tension: 0.4,
              pointBackgroundColor: '#00f0ff',
              pointRadius: 3
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'top', labels: { boxWidth: 12, color: '#ffffff' } },
            tooltip: { backgroundColor: '#181820', titleColor: '#f2fd43', padding: 10 }
          },
          scales: {
            x: { grid: { color: 'rgba(255,255,255,0.05)' } },
            y: { grid: { color: 'rgba(255,255,255,0.05)' }, beginAtZero: true }
          }
        }
      });
    }

    // 2. Referrer Donut Chart
    const refCtx = (document.getElementById('referrerDonutChart') as HTMLCanvasElement)?.getContext('2d');
    if (refCtx) {
      if (chartInstances.referrer) chartInstances.referrer.destroy();

      chartInstances.referrer = new Chart(refCtx, {
        type: 'doughnut',
        data: {
          labels: Object.keys(data.referrers),
          datasets: [{
            data: Object.values(data.referrers),
            backgroundColor: ['#e1306c', '#00f2fe', '#1db954', '#5865f2', '#f2fd43', '#a855f7'],
            borderWidth: 2,
            borderColor: '#121216'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom', labels: { boxWidth: 10, padding: 8, font: { size: 10 } } }
          },
          cutout: '70%'
        }
      });
    }

    // 3. Audio Milestone Funnel Chart
    const audioCtx = (document.getElementById('audioFunnelChart') as HTMLCanvasElement)?.getContext('2d');
    if (audioCtx) {
      if (chartInstances.audio) chartInstances.audio.destroy();

      const funnelValues = [
        data.audioFunnel.starts || 1,
        data.audioFunnel.m25 || 1,
        data.audioFunnel.m50 || 1,
        data.audioFunnel.m75 || 1,
        data.audioFunnel.completed || 1
      ];

      chartInstances.audio = new Chart(audioCtx, {
        type: 'bar',
        data: {
          labels: ['Play Start', '25% Mark', '50% Mark', '75% Mark', 'Completed'],
          datasets: [{
            label: 'Listeners',
            data: funnelValues,
            backgroundColor: ['#f2fd43', '#d8ea3a', '#bee032', '#a4d42b', '#10b981'],
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: (ctx: any) => `${ctx.raw} total listeners`
              }
            }
          },
          scales: {
            x: { grid: { display: false } },
            y: { grid: { color: 'rgba(255,255,255,0.05)' }, beginAtZero: true }
          }
        }
      });
    }

    // 4. Outbound Streaming Platforms Chart
    const outboundCtx = (document.getElementById('outboundPlatformsChart') as HTMLCanvasElement)?.getContext('2d');
    if (outboundCtx) {
      if (chartInstances.outbound) chartInstances.outbound.destroy();

      chartInstances.outbound = new Chart(outboundCtx, {
        type: 'bar',
        indexAxis: 'y',
        data: {
          labels: Object.keys(data.outboundBreakdown),
          datasets: [{
            label: 'Clicks',
            data: Object.values(data.outboundBreakdown),
            backgroundColor: ['#1db954', '#fc3c44', '#ff0000', '#ff5500', '#00f0ff', '#f2fd43'],
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { color: 'rgba(255,255,255,0.05)' }, beginAtZero: true },
            y: { grid: { display: false } }
          }
        }
      });
    }
  }

  checkAuth();
</script>
