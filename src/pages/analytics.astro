  .auth-back-link:hover { text-decoration: underline; }

  /* Main Container */
  .dash-main-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Header */
  .dash-header {
