            </div>
          </div>
        </div>

        <div class="drawer-panel-footer">
          <button id="builder-done-btn" class="builder-done-btn">Done</button>
        </div>
      </div>
    </div>

    <!-- PASSCODE SETTINGS MODAL -->
    <div id="change-pin-modal" class="modal-overlay hidden" data-no-track="true">
      <div class="modal-card">
        <h3 class="modal-title">Change Admin Passcode</h3>
