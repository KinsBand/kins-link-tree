---
// src/pages/analytics.astro
// Kins Band - Observability Command Center & Inbound Attribution Dashboard
import BaseLayout from '../layouts/BaseLayout.astro';
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Observability Dashboard | Kins Band" description="Real-time analytics, inbound social attribution, touch ergonomics, and system health for Kins Band.">
  <div class="dash-page-wrapper" data-no-track="true">
    
    <!-- AUTHENTICATION SCREEN (Shown when locked) -->
    <div id="dashboard-auth-screen" class="dash-auth-card">
      <div class="auth-icon-circle">
        <i class="fa-solid fa-chart-pie"></i>
      </div>
      <h1 class="auth-title">KINS OBSERVABILITY</h1>
      <p class="auth-subtitle">Enter Admin Passcode to view live traffic, inbound attribution, touch ergonomics & heatmaps.</p>

      <form id="dash-login-form" class="auth-form">
        <input 
          type="password" 
          id="dash-login-pin" 
          placeholder="Enter Passcode (default: kins2026)" 
          class="auth-input"
          autocomplete="current-password"
        />
        <p id="dash-login-error" class="auth-error hidden">Invalid passcode. Please try again.</p>
        <button type="submit" class="auth-btn brutal-btn">
          Unlock Command Center
        </button>
      </form>

      <div class="auth-footer">
        <span>Default PIN: <code>kins2026</code></span>
        <a href={baseUrl} class="auth-back-link">← Back to Site</a>
      </div>
    </div>

    <!-- MAIN DASHBOARD CONTENT (Shown when authenticated) -->
    <div id="dashboard-content" class="dash-main-container hidden">
      
      <!-- Top App Bar -->
      <header class="dash-header">
        <div class="dash-brand">
          <div class="dash-logo-box">
            <i class="fa-solid fa-chart-line"></i>
          </div>
          <div>
            <div class="dash-title-row">
              <h1 class="dash-main-title">KINS OBSERVABILITY</h1>
              <span class="live-badge">
                <span class="live-dot"></span> LIVE TELEMETRY
              </span>
            </div>
            <p class="dash-subtitle">Inbound Social Attribution • Touch Target Intelligence • Zero Admin Noise</p>
          </div>
        </div>

        <!-- Controls: Timeframe, Auto-Poll, Heatmap trigger, Exports, Settings, Logout -->
        <div class="dash-controls">
          <div class="time-filter-pill-box" id="dash-time-filters">
            <button data-range="24h" class="dash-range-btn active">24H</button>
            <button data-range="7d" class="dash-range-btn">7D</button>
            <button data-range="30d" class="dash-range-btn">30D</button>
            <button data-range="all" class="dash-range-btn">ALL</button>
          </div>

          <!-- Auto Refresh Selector -->
          <div class="time-filter-pill-box" id="dash-poll-filters" title="Auto-Refresh Interval">
            <button data-poll="0" class="dash-poll-btn active">OFF</button>
            <button data-poll="5000" class="dash-poll-btn">5s</button>
            <button data-poll="15000" class="dash-poll-btn">15s</button>
            <button data-poll="30000" class="dash-poll-btn">30s</button>
          </div>

          <button id="export-leads-csv-btn" class="dash-action-btn export-btn" title="Export VIP Leads Spreadsheet (CSV)">
            <i class="fa-solid fa-file-csv"></i> Leads CSV
          </button>

          <button id="export-json-btn" class="dash-action-btn export-btn" title="Export Full JSON Telemetry">
            <i class="fa-solid fa-file-code"></i> JSON
          </button>

          <button id="open-heatmap-from-dash" class="dash-action-btn hud-btn">
            <span>🔥</span> Live Heatmap HUD
          </button>

          <button id="change-pin-btn" class="dash-action-btn icon-btn" title="Change Admin Passcode">
            <i class="fa-solid fa-key"></i>
          </button>

          <button id="dash-refresh-btn" class="dash-action-btn icon-btn" title="Refresh Live Metrics">
            <i class="fa-solid fa-rotate-right"></i>
          </button>

          <button id="dash-logout-btn" class="dash-action-btn logout-btn" title="Lock Dashboard">
            <i class="fa-solid fa-lock"></i>
          </button>
        </div>
      </header>

      <!-- REAL-TIME PULSE & RECENT ACTIVITY TICKER BAR -->
      <section class="dash-pulse-bar" id="dash-pulse-bar">
        <div class="pulse-left">
          <span class="pulse-icon"><i class="fa-solid fa-bolt text-yellow"></i></span>
          <span class="pulse-label">LIVE STREAM:</span>
          <div class="pulse-ticker-items" id="pulse-ticker-items">
            <!-- Dynamically populated -->
            <span class="pulse-item"><i class="fa-brands fa-spotify text-emerald"></i> Spotify Stream Click • <small>Just now</small></span>
          </div>
        </div>
        <div class="pulse-right">
          <span>Active Sessions: <strong class="text-emerald font-mono" id="pulse-active-sessions">1</strong></span>
          <span>Conversion: <strong class="text-cyan font-mono" id="pulse-conversion-rate">--%</strong></span>
        </div>
      </section>

      <!-- KPI Summary Cards Strip (6 KPIs) -->
      <section class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-header">
            <span>Unique Visitors</span>
            <i class="fa-solid fa-users text-cyan"></i>
          </div>
          <div class="kpi-value text-white" id="kpi-visitors">--</div>
          <div class="kpi-trend text-emerald">
            <i class="fa-solid fa-arrow-trend-up"></i> Live Sessions
          </div>
        </div>

        <div class="kpi-card">
          <div class="kpi-header">
            <span>Total Pageviews</span>
            <i class="fa-solid fa-eye text-yellow"></i>
          </div>
          <div class="kpi-value text-white" id="kpi-pageviews">--</div>
          <div class="kpi-sub" id="kpi-pv-per-user">-- / visitor</div>
        </div>

        <div class="kpi-card">
          <div class="kpi-header">
            <span>Outbound Clicks</span>
            <i class="fa-brands fa-spotify text-emerald"></i>
          </div>
          <div class="kpi-value text-emerald" id="kpi-outbound">--</div>
          <div class="kpi-sub" id="kpi-ctr-rate">Streaming & Socials</div>
        </div>

        <div class="kpi-card">
          <div class="kpi-header">
            <span>Audio Plays</span>
            <i class="fa-solid fa-music text-purple"></i>
          </div>
          <div class="kpi-value text-purple" id="kpi-audio-plays">--</div>
          <div class="kpi-sub" id="kpi-avg-listen">28s avg listen</div>
        </div>

        <div class="kpi-card">
          <div class="kpi-header">
            <span>Touch Accuracy</span>
            <i class="fa-solid fa-hand-pointer text-cyan"></i>
          </div>
          <div class="kpi-value text-cyan" id="kpi-touch-acc">--%</div>
          <div class="kpi-sub" id="kpi-touch-ratio">Mobile vs Desktop</div>
        </div>

        <div class="kpi-card">
          <div class="kpi-header">
            <span>System Health</span>
            <i class="fa-solid fa-heart-pulse text-rose"></i>
          </div>
          <div class="kpi-value text-emerald" id="kpi-uptime">100%</div>
          <div class="kpi-sub">HTTP 200 OK • SSL Active</div>
        </div>
      </section>

      <!-- ROW: INBOUND BIO LINK PERFORMANCE & CAMPAIGN BUILDER -->
      <section class="dash-grid-2-1">
        <!-- Inbound Bio Links Performance Table -->
        <div class="dash-panel">
          <div class="panel-header">
            <div>
              <h2 class="panel-title">INBOUND SOCIAL & STREAMING BIO LINKS</h2>
              <p class="panel-sub">Traffic and conversions attributed to custom profile bio links</p>
            </div>
            <span class="panel-badge"><i class="fa-solid fa-link text-yellow"></i> First-Touch Attribution</span>
          </div>

          <div class="table-container">
            <table class="dash-table">
              <thead>
                <tr>
                  <th>Platform & Custom Alias</th>
                  <th class="text-right">Visitors</th>
                  <th class="text-right">Song Plays</th>
                  <th class="text-right">Stream Clicks</th>
                  <th class="text-right">Conversions</th>
                </tr>
              </thead>
              <tbody id="inbound-channels-tbody">
                <!-- Populated dynamically via JS -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- 1-Click Bio Link Generator Widget -->
        <div class="dash-panel flex-col-between">
          <div>
            <h2 class="panel-title">CUSTOM BIO LINK BUILDER</h2>
            <p class="panel-sub">Generate tracked URLs for your social & streaming bios</p>
          </div>

          <div class="campaign-builder-form">
            <label class="form-label">Select Target Platform</label>
            <select id="builder-platform" class="builder-select">
              <option value="instagram">Instagram (tinyurl.com/IGBioPage)</option>
              <option value="tiktok">TikTok (tinyurl.com/TKBioPage)</option>
              <option value="spotify">Spotify Artist Bio (tinyurl.com/SPBioPage)</option>
              <option value="facebook">Facebook (tinyurl.com/FBBioPage)</option>
              <option value="youtube">YouTube (tinyurl.com/YTBioPage)</option>
              <option value="discord">Discord (tinyurl.com/DCBioPage)</option>
              <option value="substack">Substack / Newsletter</option>
            </select>

            <label class="form-label mt-2">Generated Tracked URL</label>
            <div class="url-copy-box">
              <input type="text" id="builder-output-url" readonly class="builder-input" value="" />
              <button id="builder-copy-btn" class="builder-copy-btn" title="Copy to Clipboard">
                <i class="fa-solid fa-copy"></i>
              </button>
            </div>
          </div>

          <div class="campaign-tip">
            <i class="fa-solid fa-lightbulb text-yellow"></i>
            <span>Paste this generated link into your bio or create a TinyURL alias pointing to it!</span>
          </div>
        </div>
      </section>

      <!-- ROW 1: TRAFFIC ACQUISITION & REFERRALS (PILLAR 1) -->
      <section class="dash-grid-2-1">
        <div class="dash-panel">
          <div class="panel-header">
            <div>
              <h2 class="panel-title">PILLAR 1: TRAFFIC & SESSIONS OVER TIME</h2>
              <p class="panel-sub">Real distribution of visitors vs total page interactions</p>
            </div>
            <span class="panel-badge"><i class="fa-solid fa-circle text-emerald"></i> Real-time</span>
          </div>
          <div class="chart-box-main">
            <canvas id="trafficTimelineChart"></canvas>
          </div>
        </div>

        <div class="dash-panel">
          <div class="panel-header">
            <div>
              <h2 class="panel-title">ACQUISITION CHANNELS</h2>
              <p class="panel-sub">Where fans are arriving from</p>
            </div>
            <i class="fa-solid fa-share-nodes text-muted"></i>
          </div>
          <div class="chart-box-donut">
            <canvas id="referrerDonutChart"></canvas>
          </div>
          <div class="ref-stats-grid">
            <div class="ref-mini-pill">
              <span class="ref-pill-label">Instagram</span>
              <span class="ref-pill-val" id="ref-stat-ig">--</span>
            </div>
            <div class="ref-mini-pill">
              <span class="ref-pill-label">TikTok</span>
              <span class="ref-pill-val" id="ref-stat-tt">--</span>
            </div>
            <div class="ref-mini-pill">
              <span class="ref-pill-label">Spotify</span>
              <span class="ref-pill-val" id="ref-stat-sp">--</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ROW 2: MUSIC ENGAGEMENT & OUTBOUND CLICKS (PILLAR 2) -->
      <section class="dash-grid-3">
        <!-- Audio Milestone Retention Funnel -->
        <div class="dash-panel">
          <div class="panel-header">
            <div>
              <h2 class="panel-title">PILLAR 2: AUDIO RETENTION FUNNEL</h2>
              <p class="panel-sub">Song preview drop-off rate</p>
            </div>
            <i class="fa-solid fa-compact-disc text-yellow"></i>
          </div>
          <div class="chart-box-funnel">
            <canvas id="audioFunnelChart"></canvas>
          </div>
          <div class="panel-footer-stat">
            Average Completion Rate: <span class="text-yellow font-bold font-mono" id="audio-complete-rate">--%</span>
          </div>
        </div>

        <!-- Outbound Platform Clicks -->
        <div class="dash-panel">
          <div class="panel-header">
            <div>
              <h2 class="panel-title">STREAMING DESTINATIONS</h2>
              <p class="panel-sub">Platform conversion volume</p>
            </div>
            <i class="fa-solid fa-arrow-up-right-from-square text-cyan"></i>
          </div>
          <div class="chart-box-funnel">
            <canvas id="outboundPlatformsChart"></canvas>
          </div>
        </div>

        <!-- Top Interactive Elements Table -->
        <div class="dash-panel flex-col-between">
          <div>
            <h2 class="panel-title">TOP CLICKED ELEMENTS</h2>
            <p class="panel-sub">Most engaged buttons & cards</p>
          </div>

          <div class="top-elements-list" id="top-elements-list">
            <!-- Populated via JS -->
          </div>

          <div class="lead-box">
            <div class="lead-row">
              <span class="lead-label"><i class="fa-solid fa-ticket text-emerald"></i> Tour Ticket Clicks</span>
              <span class="lead-val font-mono" id="stat-gig-tickets">--</span>
            </div>
            <div class="lead-row">
              <span class="lead-label"><i class="fa-solid fa-file-pdf text-yellow"></i> EPK Deck Downloads</span>
              <span class="lead-val font-mono" id="stat-epk-downloads">--</span>
            </div>
            <div class="lead-row">
              <span class="lead-label"><i class="fa-solid fa-envelope text-cyan"></i> Newsletter Signups</span>
              <span class="lead-val font-mono" id="stat-newsletter">--</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ROW 3: TOUCH ERGONOMICS, SEARCH INTELLIGENCE & UX FRICTION -->
      <section class="dash-grid-2-1">
        <!-- Touch Ergonomics & UX Friction Panel -->
        <div class="dash-panel">
          <div class="panel-header">
            <div>
              <h2 class="panel-title">TOUCH ERGONOMICS & UX FRICTION</h2>
              <p class="panel-sub">Touch centering accuracy, rage clicks & dead clicks diagnostics</p>
            </div>
            <span class="panel-badge"><i class="fa-solid fa-shield-halved text-emerald"></i> Touch QA</span>
          </div>

          <div class="friction-grid">
            <div class="friction-card">
              <span class="friction-label">Rage Clicks</span>
              <span class="friction-val text-rose" id="stat-rage-clicks">0</span>
              <span class="friction-sub">Rapid repeated taps</span>
            </div>
            <div class="friction-card">
              <span class="friction-label">Dead Clicks</span>
              <span class="friction-val text-amber" id="stat-dead-clicks">0</span>
              <span class="friction-sub">Taps on unlinked areas</span>
            </div>
            <div class="friction-card">
              <span class="friction-label">Near Misses</span>
              <span class="friction-val text-yellow" id="stat-near-misses">0</span>
              <span class="friction-sub">&lt;16px off button hitbox</span>
            </div>
            <div class="friction-card">
              <span class="friction-label">Touch Share</span>
              <span class="friction-val text-cyan" id="stat-touch-share">--%</span>
              <span class="friction-sub">Mobile pointer events</span>
            </div>
          </div>

          <div class="friction-tip">
            <i class="fa-solid fa-fingerprint text-yellow"></i>
            <span>Press <kbd>Ctrl+Shift+H</kbd> and switch to <strong>RAGE</strong> or <strong>BOXES</strong> mode to inspect hitbox heat directly on live buttons.</span>
          </div>
        </div>

        <!-- Covers Search Intelligence Panel -->
        <div class="dash-panel flex-col-between">
          <div>
            <h2 class="panel-title">COVERS SEARCH INTELLIGENCE</h2>
            <p class="panel-sub">Top artist and track keywords searched by fans</p>
          </div>

          <div class="search-queries-list" id="search-queries-list">
            <!-- Populated via JS -->
          </div>

          <div class="campaign-tip">
            <i class="fa-solid fa-magnifying-glass text-cyan"></i>
            <span>Helps the band choose upcoming video covers based on real fan demand!</span>
          </div>
        </div>
      </section>

      <!-- ROW 4: PERFORMANCE, CORE WEB VITALS & ERROR STREAM (PILLARS 3 & 4) -->
      <section class="dash-grid-1-2">
        <!-- Core Web Vitals Scorecards -->
        <div class="dash-panel flex-col-between">
          <div>
            <h2 class="panel-title">PILLAR 3: CORE WEB VITALS</h2>
            <p class="panel-sub">Real User Monitoring (RUM) metrics</p>
          </div>

          <div class="vitals-grid">
            <div class="vital-card">
              <span class="vital-label">LCP (Load)</span>
              <span class="vital-val text-emerald" id="vital-lcp">1.1s</span>
              <span class="vital-status text-emerald">Good (&lt;2.5s)</span>
            </div>
            <div class="vital-card">
              <span class="vital-label">INP (Latency)</span>
              <span class="vital-val text-emerald" id="vital-inp">28ms</span>
              <span class="vital-status text-emerald">Good (&lt;200ms)</span>
            </div>
            <div class="vital-card">
              <span class="vital-label">CLS (Shift)</span>
              <span class="vital-val text-emerald" id="vital-cls">0.01</span>
              <span class="vital-status text-emerald">Good (&lt;0.1)</span>
            </div>
          </div>

          <div class="vitals-alert">
            <i class="fa-solid fa-circle-check text-emerald"></i>
            <span>Site passes Google PageSpeed & Core Web Vitals thresholds.</span>
          </div>
        </div>

        <!-- Live Runtime Error & Diagnostics Feed -->
        <div class="dash-panel">
          <div class="panel-header">
            <div>
              <h2 class="panel-title">RUNTIME ERROR & EVENT LOGS</h2>
              <p class="panel-sub">Live client diagnostics caught via global observer</p>
            </div>
            <span id="error-count-badge" class="error-badge">0 errors</span>
          </div>

          <div id="error-log-container" class="error-log-box">
            <div class="empty-log-state">
              <i class="fa-solid fa-circle-check text-emerald log-state-icon"></i>
              <div>No unhandled runtime errors recorded. Everything is operating smoothly.</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Bottom Navigation Footer -->
      <footer class="dash-footer">
        <div>Kins Band Observability Engine • Powered by Supabase & Astro</div>
        <div class="footer-links">
          <a href={baseUrl} class="footer-link">Website Home</a>
          <a href={`${baseUrl}epk`} class="footer-link">EPK Press Kit</a>
          <button id="trigger-hud-bottom" class="hud-trigger-link">Press Ctrl+Shift+H for Live Heatmap</button>
        </div>
      </footer>
    </div>

    <!-- Passcode Settings Modal -->
    <div id="change-pin-modal" class="modal-overlay hidden" data-no-track="true">
      <div class="modal-card">
        <h3 class="modal-title">Change Admin Passcode</h3>
        <p class="modal-sub">Set a custom passcode to protect this dashboard and the Dev Heatmap HUD.</p>
        <form id="change-pin-form" class="modal-form">
          <input 
            type="text" 
            id="new-pin-input" 
            placeholder="Enter new PIN (min 4 chars)" 
            class="modal-input"
            required
          />
          <div class="modal-btn-row">
            <button type="button" id="cancel-pin-btn" class="modal-btn-cancel">Cancel</button>
            <button type="submit" class="modal-btn-save">Save Passcode</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<style is:global>
  /* ==========================================================================
     KINS OBSERVABILITY COMMAND CENTER - HIGH-CONTRAST NEO-BRUTALIST STYLES
     ========================================================================== */

  .dash-page-wrapper {
    min-height: 100vh;
    background: #0a0a0c;
    background-image: radial-gradient(circle at 50% 10%, #1a1a24 0%, #0d0d10 60%, #060608 100%);
    color: #ffffff;
    font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, sans-serif;
    padding: 24px 16px 80px 16px;
    box-sizing: border-box;
  }

  .text-white { color: #ffffff !important; }
  .text-yellow { color: #f2fd43 !important; }
  .text-cyan { color: #00f0ff !important; }
  .text-emerald { color: #10b981 !important; }
  .text-amber { color: #f59e0b !important; }
  .text-purple { color: #c084fc !important; }
  .text-rose { color: #fb7185 !important; }
  .text-muted { color: #8e8e93 !important; }
  .font-mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important; }
  .font-bold { font-weight: 700; }
  .hidden { display: none !important; }
  .text-right { text-align: right; }
  .mt-2 { margin-top: 8px; }

  /* Auth Screen Card */
  .dash-auth-card {
    max-width: 440px;
    margin: 80px auto;
    background: #121216;
    border: 3px solid #f2fd43;
    border-radius: 16px;
    padding: 36px 28px;
    text-align: center;
    box-shadow: 0 0 50px rgba(242, 253, 67, 0.3), 6px 6px 0px #000000;
  }

  .auth-icon-circle {
    width: 68px;
    height: 68px;
    margin: 0 auto 18px auto;
    border-radius: 16px;
    background: #1c1c24;
    border: 2px solid #f2fd43;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    color: #f2fd43;
    box-shadow: 0 0 20px rgba(242, 253, 67, 0.25), 3px 3px 0px #000000;
  }

  .auth-title {
    font-family: 'Cinzel', serif;
    font-weight: 900;
    font-size: 1.6rem;
    color: #f2fd43;
    letter-spacing: 0.06em;
    margin: 0 0 8px 0;
    text-shadow: 0 0 15px rgba(242, 253, 67, 0.3);
  }

  .auth-subtitle {
    font-size: 0.85rem;
    color: #a1a1aa;
    margin: 0 0 24px 0;
    line-height: 1.5;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .auth-input {
    width: 100%;
    background: #1a1a22;
    border: 2px solid #3f3f46;
    border-radius: 10px;
    padding: 13px 16px;
    color: #ffffff;
    font-size: 1rem;
    font-family: 'Space Grotesk', sans-serif;
    text-align: center;
    letter-spacing: 0.2em;
    outline: none;
    box-sizing: border-box;
    transition: all 0.2s ease;
  }

  .auth-input:focus {
    border-color: #f2fd43;
    box-shadow: 0 0 15px rgba(242, 253, 67, 0.35);
  }

  .auth-error {
    color: #fb7185;
    font-size: 0.78rem;
    margin: 0;
    font-weight: 700;
  }

  .auth-btn {
    width: 100%;
    background: #f2fd43;
    color: #000000;
    font-weight: 900;
    font-size: 0.95rem;
    padding: 13px;
    border-radius: 10px;
    border: 2px solid #000000;
    cursor: pointer;
    box-shadow: 4px 4px 0px #000000;
    transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .auth-btn:hover {
    background: #faff60;
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px #000000;
  }

  .auth-footer {
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid #27272a;
    display: flex;
    justify-content: space-between;
