  }

  .col-12 { grid-column: span 12; }
  .col-8 { grid-column: span 8; }
  .col-6 { grid-column: span 6; }
  .col-4 { grid-column: span 4; }

  @media (max-width: 1080px) {
    .col-8 { grid-column: span 12; }
    .col-6 { grid-column: span 12; }
    .col-4 { grid-column: span 12; }
  }

  /* Standardized Cards */
  .dash-card {
    background: var(--dash-surface);
    border: 1px solid var(--dash-border);
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .flex-col-between {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .card-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 900;
    font-size: 0.88rem;
    color: #ffffff;
    margin: 0;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card-subtitle {
    font-size: 0.74rem;
    color: var(--dash-text-muted);
    margin: 3px 0 0 0;
  }

  .card-header-icon {
    color: var(--dash-text-dim);
    font-size: 0.95rem;
  }

  .card-badge {
    background: var(--dash-surface-raised);
    border: 1px solid var(--dash-border);
    padding: 3px 10px;
    border-radius: 8px;
    font-size: 0.7rem;
    color: var(--dash-text-muted);
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .chart-legend-pills {
    display: flex;
    gap: 10px;
    font-size: 0.72rem;
    color: var(--dash-text-muted);
  }

  .legend-pill {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .legend-dot { width: 8px; height: 8px; border-radius: 50%; }
  .dot-traffic { background: var(--dash-accent); }
  .dot-visitors { background: var(--dash-cyan); }
  .dot-conv { background: var(--dash-emerald); }

  .chart-container-lg {
    position: relative;
    width: 100%;
    height: 280px;
  }

  /* Tables */
  .table-wrapper {
    overflow-x: auto;
    border-radius: 10px;
    border: 1px solid var(--dash-border);
    background: var(--dash-surface-raised);
  }

  .dash-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
  }

  .dash-table th {
    text-align: left;
    background: #161622;
    color: var(--dash-text-muted);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    padding: 10px 14px;
    border-bottom: 1px solid var(--dash-border);
  }

  .dash-table td {
    padding: 11px 14px;
    border-bottom: 1px solid #1c1c2a;
    color: var(--dash-text-main);
    vertical-align: middle;
  }

  .dash-table tr:hover td {
    background: rgba(226, 241, 99, 0.03);
  }

  .dash-table tr:last-child td { border-bottom: none; }

  .badge-status {
    font-size: 0.68rem;
    font-weight: 800;
    padding: 2px 8px;
    border-radius: 6px;
    display: inline-block;
  }

  .badge-status.repertoire { background: var(--dash-emerald-bg); color: var(--dash-emerald); border: 1px solid rgba(16,185,129,0.3); }
  .badge-status.planned { background: rgba(245, 158, 11, 0.12); color: var(--dash-amber); border: 1px solid rgba(245,158,11,0.3); }
  .badge-status.unreleased { background: #1f1f2c; color: var(--dash-text-muted); border: 1px solid var(--dash-border); }

  .badge-velocity {
    font-family: ui-monospace, monospace;
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--dash-accent);
  }

  /* Channels Breakdown List */
  .channels-breakdown-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .channel-bar-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .channel-bar-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.74rem;
    color: #e4e4e7;
    font-weight: 600;
  }

  .channel-bar-track {
    width: 100%;
    height: 7px;
    background: #1a1a24;
    border-radius: 4px;
    overflow: hidden;
  }

  .channel-bar-fill {
    height: 100%;
    background: var(--dash-accent);
    border-radius: 4px;
  }

  /* Streaming Platform Bars */
  .streaming-platform-bars {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .stream-bar-item {
    background: var(--dash-surface-raised);
    border: 1px solid var(--dash-border);
    border-radius: 10px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .stream-bar-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
  }

  .stream-title { font-weight: 700; color: #ffffff; display: flex; align-items: center; gap: 8px; }
  .stream-count { font-family: ui-monospace, monospace; font-weight: 800; color: var(--dash-text-muted); }

  /* Tips & Footers */
  .card-footer-tip {
    background: var(--dash-accent-bg);
    border: 1px solid var(--dash-accent-border);
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 0.74rem;
    color: #d4d4d8;
    display: flex;
    align-items: center;
    gap: 10px;
    line-height: 1.4;
  }

  .card-footer-stat {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--dash-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.74rem;
  }

  .stat-label { color: var(--dash-text-muted); }
  .stat-value { font-weight: 800; }

  /* Interconnected Audio Step Funnel */
  .funnel-container {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 8px 0;
  }

  .funnel-step {
    background: var(--dash-surface-raised);
    border: 1px solid var(--dash-border);
    border-radius: 10px;
    padding: 9px 14px;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .funnel-step.completed-step {
    border-color: var(--dash-accent-border);
    background: rgba(226, 241, 99, 0.04);
  }

  .step-meta {
    width: 140px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .step-name { font-size: 0.74rem; font-weight: 700; color: #ffffff; }
  .step-count { font-size: 0.74rem; color: var(--dash-text-muted); }

  .step-bar-track {
    flex: 1;
    height: 9px;
    background: #181824;
    border-radius: 5px;
    overflow: hidden;
  }

  .step-bar-fill {
    height: 100%;
    background: #3f3f50;
    border-radius: 5px;
    transition: width 0.4s ease;
  }

  .step-bar-fill.fill-accent { background: var(--dash-accent); }

  .step-pct {
    width: 44px;
    text-align: right;
    font-size: 0.75rem;
    color: var(--dash-text-muted);
  }

  .funnel-drop-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 0.68rem;
    color: var(--dash-text-dim);
    margin: -3px 0;
  }

  .drop-label { font-family: ui-monospace, monospace; color: var(--dash-rose); font-weight: 700; }

  .funnel-summary-banner {
    background: var(--dash-surface-raised);
    border: 1px solid var(--dash-border);
    border-radius: 10px;
    padding: 10px 14px;
    display: flex;
    justify-content: space-around;
    align-items: center;
    text-align: center;
  }

  .summary-metric { display: flex; flex-direction: column; gap: 3px; }
  .sub-label { font-size: 0.68rem; color: var(--dash-text-muted); text-transform: uppercase; }
  .sub-val { font-size: 1rem; font-weight: 800; }

  /* Interaction Density Grid */
  .interaction-density-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  @media (max-width: 700px) {
    .interaction-density-grid { grid-template-columns: 1fr; }
  }

  .density-item-card {
    background: var(--dash-surface-raised);
    border: 1px solid var(--dash-border);
    border-radius: 10px;
    padding: 10px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .density-item-card:hover { border-color: #38384a; }
  .density-label { font-size: 0.76rem; font-weight: 600; color: #ffffff; display: flex; align-items: center; gap: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 220px; }
  .density-count { font-size: 0.8rem; font-weight: 800; color: var(--dash-accent); }

  /* Conversion Actions */
  .conversion-actions-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .conv-action-item {
    background: var(--dash-surface-raised);
    border: 1px solid var(--dash-border);
    border-radius: 10px;
    padding: 10px 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .conv-action-left { display: flex; align-items: center; gap: 10px; }
  .conv-icon-box {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
  }

  .icon-emerald { background: var(--dash-emerald-bg); color: var(--dash-emerald); }
  .icon-accent { background: var(--dash-accent-bg); color: var(--dash-accent); }
  .icon-cyan { background: rgba(0, 240, 255, 0.12); color: var(--dash-cyan); }
  .icon-purple { background: rgba(192, 132, 252, 0.12); color: var(--dash-purple); }

  .conv-title { display: block; font-size: 0.76rem; font-weight: 700; color: #ffffff; }
  .conv-sub { display: block; font-size: 0.66rem; color: var(--dash-text-dim); }
  .conv-val { font-size: 1.1rem; font-weight: 900; color: #ffffff; }

  .total-conv-badge {
    background: #181824;
    border: 1px solid var(--dash-border);
    border-radius: 10px;
    padding: 10px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.76rem;
  }

  /* CWV Gauges */
  .cwv-gauges-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 8px 0;
  }

  @media (max-width: 600px) {
    .cwv-gauges-grid { grid-template-columns: 1fr; }
  }

  .cwv-gauge-card {
    background: var(--dash-surface-raised);
    border: 1px solid var(--dash-border);
    border-radius: 12px;
    padding: 14px 12px;
    text-align: center;
  }

  .cwv-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }

  .cwv-label { font-size: 0.72rem; font-weight: 900; color: #ffffff; }
  .badge-tag {
    font-size: 0.65rem;
    font-weight: 800;
    padding: 1px 6px;
    border-radius: 4px;
  }
  .badge-tag.pass { background: var(--dash-emerald-bg); color: var(--dash-emerald); }

  .cwv-val { font-size: 1.4rem; font-weight: 900; margin: 4px 0; }
  .cwv-desc { font-size: 0.68rem; color: var(--dash-text-muted); }
  .cwv-threshold { font-size: 0.65rem; color: var(--dash-text-dim); margin-top: 2px; }

  .vitals-alert-banner {
    background: var(--dash-emerald-bg);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 0.74rem;
    color: #e4e4e7;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* UX Friction Score */
  .ux-score-banner {
    background: var(--dash-surface-raised);
    border: 1px solid var(--dash-border);
    border-radius: 12px;
    padding: 14px 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .ux-score-title { display: block; font-size: 0.72rem; color: var(--dash-text-muted); font-weight: 700; text-transform: uppercase; }
  .ux-score-status { display: block; font-size: 0.85rem; font-weight: 800; color: #ffffff; margin-top: 2px; }
  .ux-score-number { font-size: 1.8rem; font-weight: 900; }

  .friction-metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  @media (max-width: 600px) {
    .friction-metrics-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .friction-card {
    background: var(--dash-surface-raised);
    border: 1px solid var(--dash-border);
    border-radius: 10px;
    padding: 10px 8px;
    text-align: center;
  }

  .f-label { display: block; font-size: 0.66rem; font-weight: 800; color: var(--dash-text-muted); text-transform: uppercase; }
  .f-val { display: block; font-size: 1.2rem; font-weight: 900; margin: 3px 0; }
  .f-sub { display: block; font-size: 0.64rem; color: var(--dash-text-dim); }

  .hud-launch-btn {
    width: 100%;
    background: #1b1b26;
    border: 1px solid var(--dash-border);
    color: var(--dash-accent);
    padding: 10px;
    border-radius: 10px;
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: all 0.15s ease;
    font-family: inherit;
  }

  .hud-launch-btn:hover {
    background: var(--dash-accent-bg);
    border-color: var(--dash-accent-border);
  }

  .hud-launch-btn kbd {
    background: #121218;
    color: var(--dash-text-muted);
    border: 1px solid var(--dash-border);
    padding: 2px 5px;
    border-radius: 4px;
    font-size: 0.68rem;
    font-family: ui-monospace, monospace;
  }

  /* Viewports */
  .device-split-bars {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .split-row { display: flex; flex-direction: column; gap: 4px; }
  .split-label-row { display: flex; justify-content: space-between; font-size: 0.74rem; color: #e4e4e7; font-weight: 600; }
  .split-track { width: 100%; height: 7px; background: #1a1a24; border-radius: 4px; overflow: hidden; }
  .split-fill { height: 100%; border-radius: 4px; }
  .split-fill.fill-accent { background: var(--dash-accent); }
  .split-fill.fill-slate { background: #64748b; }
  .split-fill.fill-cyan { background: var(--dash-cyan); }

  /* Error Console */
  .error-console-box {
    background: var(--dash-surface-raised);
    border: 1px solid var(--dash-border);
    border-radius: 10px;
    padding: 14px;
    height: 180px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-family: ui-monospace, monospace;
    font-size: 0.74rem;
  }

  .empty-log-state {
    text-align: center;
    color: var(--dash-text-dim);
    margin: auto;
    line-height: 1.5;
  }

  .log-state-icon { font-size: 1.5rem; margin-bottom: 6px; display: block; }

  /* Docked Bottom Telemetry Console */
  .dash-bottom-dock {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(18, 18, 24, 0.98);
    border-top: 1px solid var(--dash-border);
    backdrop-filter: blur(16px);
  }

  .dock-ticker-bar {
    max-width: 1400px;
    margin: 0 auto;
    padding: 8px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-size: 0.74rem;
  }

  .dock-left {
    display: flex;
    align-items: center;
    gap: 10px;
    overflow: hidden;
  }

  .ticker-heading { font-weight: 900; color: var(--dash-accent); letter-spacing: 0.04em; white-space: nowrap; }
  .ticker-stream-preview { color: #d4d4d8; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .console-drawer-toggle {
    background: var(--dash-surface-raised);
    border: 1px solid var(--dash-border);
    color: var(--dash-text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: inherit;
    transition: all 0.15s ease;
  }

  .console-drawer-toggle:hover { color: #ffffff; border-color: var(--dash-accent); }

  .console-drawer-content {
    border-top: 1px solid var(--dash-border);
    background: #0e0e14;
    max-height: 280px;
    display: flex;
    flex-direction: column;
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 20px;
    border-bottom: 1px solid var(--dash-border);
    background: #14141e;
  }

  .drawer-tabs { display: flex; gap: 6px; }
  .drawer-tab-btn {
    background: transparent;
    border: none;
    color: var(--dash-text-muted);
    font-size: 0.74rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 6px;
    cursor: pointer;
    font-family: inherit;
  }

  .drawer-tab-btn.active { background: #222230; color: var(--dash-accent); }

  .drawer-actions { display: flex; gap: 8px; }
  .drawer-action-btn {
    background: transparent;
    border: 1px solid var(--dash-border);
    color: var(--dash-text-muted);
    font-size: 0.72rem;
    padding: 4px 10px;
    border-radius: 6px;
    cursor: pointer;
  }
  .drawer-action-btn:hover { color: #ffffff; border-color: var(--dash-accent); }

  .drawer-body {
    padding: 14px 20px;
    overflow-y: auto;
    max-height: 220px;
  }

  .dtab-pane { display: none; }
  .dtab-pane.active { display: block; }

  .events-stream-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .event-stream-row {
    background: #13131c;
    border: 1px solid #1e1e2c;
    border-radius: 8px;
    padding: 8px 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.74rem;
  }

  .json-code-block {
    margin: 0;
    font-family: ui-monospace, monospace;
    font-size: 0.72rem;
    color: #a1a1aa;
    line-height: 1.4;
  }

  /* Slide-over Link Builder Drawer */
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    display: flex;
    justify-content: flex-end;
  }

  .drawer-panel {
    background: var(--dash-surface);
    border-left: 2px solid var(--dash-border);
    width: 100%;
    max-width: 440px;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.8);
    animation: slideInRight 0.25s ease-out;
  }

  @keyframes slideInRight {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  .drawer-panel-header {
    padding: 20px 24px;
    border-bottom: 1px solid var(--dash-border);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .drawer-panel-title {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 900;
    font-size: 1rem;
    color: #ffffff;
    margin: 0;
    letter-spacing: 0.04em;
  }

  .drawer-panel-sub { font-size: 0.74rem; color: var(--dash-text-muted); margin: 3px 0 0 0; }

  .drawer-close-btn {
    background: transparent;
    border: none;
    color: var(--dash-text-muted);
    font-size: 1.1rem;
    cursor: pointer;
  }
  .drawer-close-btn:hover { color: #ffffff; }

  .drawer-panel-body {
    padding: 24px;
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .builder-form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-label { font-size: 0.72rem; font-weight: 800; color: var(--dash-text-muted); text-transform: uppercase; letter-spacing: 0.04em; }

  .builder-select, .builder-input-text {
    width: 100%;
    background: var(--dash-surface-raised);
    border: 1.5px solid var(--dash-border);
    color: #ffffff;
    padding: 11px 14px;
    border-radius: 10px;
    font-size: 0.84rem;
    font-family: inherit;
    outline: none;
    box-sizing: border-box;
  }

  .builder-select:focus, .builder-input-text:focus {
    border-color: var(--dash-accent);
  }

  .url-copy-row { display: flex; gap: 8px; }

  .builder-input-url {
    flex: 1;
    background: #14141e;
    border: 1.5px solid var(--dash-border);
    color: var(--dash-accent);
    font-family: ui-monospace, monospace;
    font-size: 0.74rem;
    padding: 10px 12px;
    border-radius: 8px;
    outline: none;
    box-sizing: border-box;
  }

  .builder-copy-action-btn {
    background: var(--dash-accent);
    border: 1.5px solid #000000;
    color: #000000;
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 900;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: inherit;
    box-shadow: 2px 2px 0px #000000;
  }

  .builder-copy-action-btn:hover { background: var(--dash-accent-hover); }

  .builder-card-hint {
    background: var(--dash-accent-bg);
    border: 1px solid var(--dash-accent-border);
    border-radius: 12px;
    padding: 14px;
    display: flex;
    gap: 12px;
    font-size: 0.74rem;
    color: #d4d4d8;
    line-height: 1.4;
  }

  .builder-card-hint p { margin: 4px 0 0 0; }

  .drawer-panel-footer {
    padding: 16px 24px;
    border-top: 1px solid var(--dash-border);
    background: #151520;
  }

  .builder-done-btn {
    width: 100%;
    background: #242434;
    border: 1px solid var(--dash-border);
    color: #ffffff;
    font-weight: 800;
    font-size: 0.84rem;
    padding: 11px;
    border-radius: 8px;
    cursor: pointer;
    font-family: inherit;
  }
  .builder-done-btn:hover { background: #2e2e42; }

  /* Passcode Modal */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }

  .modal-card {
    background: var(--dash-surface);
    border: 2px solid var(--dash-accent);
    border-radius: 16px;
    padding: 28px;
    max-width: 380px;
    width: 100%;
    box-shadow: 0 0 40px rgba(226, 241, 99, 0.2), 5px 5px 0px #000000;
  }

  .modal-title { font-family: 'Cinzel', serif; font-weight: 900; font-size: 1.2rem; color: var(--dash-accent); margin: 0 0 8px 0; }
  .modal-sub { font-size: 0.8rem; color: var(--dash-text-muted); margin: 0 0 18px 0; line-height: 1.4; }
  .modal-form { display: flex; flex-direction: column; gap: 14px; }
  .modal-input { width: 100%; background: var(--dash-surface-raised); border: 1.5px solid var(--dash-border); border-radius: 10px; padding: 11px 14px; color: #ffffff; font-size: 0.9rem; outline: none; box-sizing: border-box; }
  .modal-input:focus { border-color: var(--dash-accent); }
  .modal-btn-row { display: flex; gap: 10px; }
  .modal-btn-cancel { flex: 1; background: #27272a; border: 1.5px solid #000000; color: #ffffff; padding: 11px; border-radius: 10px; font-size: 0.82rem; font-weight: 800; cursor: pointer; }
  .modal-btn-save { flex: 1; background: var(--dash-accent); border: 1.5px solid #000000; color: #000000; padding: 11px; border-radius: 10px; font-size: 0.82rem; font-weight: 900; cursor: pointer; box-shadow: 3px 3px 0px #000000; }
</style>

<script>
  import { isUserAdmin, authenticateAdmin, logoutAdmin, setCustomAdminPasscode } from '../lib/adminAuth';
  import { fetchLiveAnalyticsData } from '../lib/analytics';
  import { generateCampaignUrl } from '../lib/attribution';

  declare const Chart: any;

  let activeView: 'growth' | 'engagement' | 'uxhealth' = 'growth';
  let activeRange: '24h' | '7d' | '30d' | 'all' = '24h';
  let chartInstances: Record<string, any> = {};
  let autoPollTimer: any = null;
  let latestAnalyticsData: any = null;

  // DOM Elements
  const authScreen = document.getElementById('dashboard-auth-screen');
  const dashContent = document.getElementById('dashboard-content');
  const loginForm = document.getElementById('dash-login-form');
  const loginPinInput = document.getElementById('dash-login-pin') as HTMLInputElement | null;
  const loginError = document.getElementById('dash-login-error');
  const logoutBtn = document.getElementById('dash-logout-btn');
  const refreshBtn = document.getElementById('dash-refresh-btn');
  const openHeatmapBtn = document.getElementById('open-heatmap-from-dash');
  const openHudActionBtn = document.getElementById('open-hud-action-btn');
  const changePinBtn = document.getElementById('change-pin-btn');
  const changePinModal = document.getElementById('change-pin-modal');
  const cancelPinBtn = document.getElementById('cancel-pin-btn');
  const changePinForm = document.getElementById('change-pin-form');
  const newPinInput = document.getElementById('new-pin-input') as HTMLInputElement | null;

  // Slide-over Link Builder Drawer
  const openLinkBuilderBtn = document.getElementById('open-link-builder-btn');
  const closeLinkBuilderBtn = document.getElementById('close-link-builder-btn');
  const linkBuilderBackdrop = document.getElementById('link-builder-drawer-backdrop');
  const builderDoneBtn = document.getElementById('builder-done-btn');
  const builderPlatform = document.getElementById('builder-platform') as HTMLSelectElement | null;
  const builderCustomAlias = document.getElementById('builder-custom-alias') as HTMLInputElement | null;
  const builderOutputUrl = document.getElementById('builder-output-url') as HTMLInputElement | null;
  const builderCopyBtn = document.getElementById('builder-copy-btn');

  // Bottom Console Drawer
  const toggleConsoleBtn = document.getElementById('toggle-console-drawer-btn');
  const consoleDrawerContent = document.getElementById('console-drawer-content');
  const consoleDrawerArrow = document.getElementById('console-drawer-arrow');
  const closeConsoleDrawerBtn = document.getElementById('close-console-drawer-btn');
  const copyJsonPayloadBtn = document.getElementById('copy-json-payload-btn');

  // VIEW NAVIGATION (3-View Architecture)
  const tabButtons = document.querySelectorAll('.view-tab-btn');
  const viewContainers = {
    growth: document.getElementById('view-growth'),
    engagement: document.getElementById('view-engagement'),
    uxhealth: document.getElementById('view-uxhealth')
  };

  function switchView(viewName: 'growth' | 'engagement' | 'uxhealth') {
    activeView = viewName;
    tabButtons.forEach(btn => {
      if (btn.getAttribute('data-view') === viewName) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    Object.entries(viewContainers).forEach(([key, el]) => {
      if (key === viewName) {
        el?.classList.add('active');
      } else {
        el?.classList.remove('active');
      }
    });

    // Re-render / update charts for the active view to ensure correct dimensions
    if (latestAnalyticsData) {
      setTimeout(() => renderCharts(latestAnalyticsData), 50);
    }
  }

  tabButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const view = btn.getAttribute('data-view') as any;
      if (view) switchView(view);
    });
  });

  // Slide-over Link Builder Logic
  function updateCampaignUrlOutput() {
    if (!builderPlatform || !builderOutputUrl) return;
    const origin = window.location.origin + window.location.pathname.replace('analytics', '').replace(/\/$/, '');
    const platform = builderPlatform.value;
    const customAlias = builderCustomAlias?.value.trim() || '';
    
    let generated = generateCampaignUrl(origin, platform);
    if (customAlias) {
      // Add or replace campaign alias parameter
      const urlObj = new URL(generated);
      urlObj.searchParams.set('alias', customAlias);
      urlObj.searchParams.set('utm_campaign', customAlias.toLowerCase());
      generated = urlObj.toString();
    }
    builderOutputUrl.value = generated;
  }

  function openLinkBuilder() {
    updateCampaignUrlOutput();
    linkBuilderBackdrop?.classList.remove('hidden');
  }

  function closeLinkBuilder() {
    linkBuilderBackdrop?.classList.add('hidden');
  }

  if (openLinkBuilderBtn) openLinkBuilderBtn.addEventListener('click', openLinkBuilder);
  if (closeLinkBuilderBtn) closeLinkBuilderBtn.addEventListener('click', closeLinkBuilder);
  if (builderDoneBtn) builderDoneBtn.addEventListener('click', closeLinkBuilder);
  if (linkBuilderBackdrop) {
    linkBuilderBackdrop.addEventListener('click', (e) => {
      if (e.target === linkBuilderBackdrop) closeLinkBuilder();
    });
  }

  if (builderPlatform) builderPlatform.addEventListener('change', updateCampaignUrlOutput);
  if (builderCustomAlias) builderCustomAlias.addEventListener('input', updateCampaignUrlOutput);
  if (builderCopyBtn && builderOutputUrl) {
    builderCopyBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(builderOutputUrl.value);
      builderCopyBtn.innerHTML = '<i class="fa-solid fa-check"></i> Copied!';
      setTimeout(() => {
        builderCopyBtn.innerHTML = '<i class="fa-solid fa-copy"></i> Copy';
      }, 1800);
    });
  }

  // Bottom Console Drawer Toggle
  if (toggleConsoleBtn && consoleDrawerContent) {
    toggleConsoleBtn.addEventListener('click', () => {
      const isHidden = consoleDrawerContent.classList.toggle('hidden');
      if (consoleDrawerArrow) {
        consoleDrawerArrow.className = isHidden ? 'fa-solid fa-chevron-up' : 'fa-solid fa-chevron-down';
      }
    });
  }

  if (closeConsoleDrawerBtn && consoleDrawerContent) {
    closeConsoleDrawerBtn.addEventListener('click', () => {
      consoleDrawerContent.classList.add('hidden');
      if (consoleDrawerArrow) consoleDrawerArrow.className = 'fa-solid fa-chevron-up';
    });
  }

  // Drawer Tabs (Event Stream vs JSON Payload)
  const drawerTabs = document.querySelectorAll('.drawer-tab-btn');
  const dtabPanes = {
    events: document.getElementById('dtab-events-pane'),
    json: document.getElementById('dtab-json-pane')
  };

  drawerTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      drawerTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const target = tab.getAttribute('data-dtab') as 'events' | 'json';
      Object.entries(dtabPanes).forEach(([k, p]) => {
        if (k === target) p?.classList.add('active');
        else p?.classList.remove('active');
      });
    });
  });

  if (copyJsonPayloadBtn) {
    copyJsonPayloadBtn.addEventListener('click', () => {
      if (!latestAnalyticsData) return;
      navigator.clipboard.writeText(JSON.stringify(latestAnalyticsData, null, 2));
      copyJsonPayloadBtn.innerHTML = '<i class="fa-solid fa-check"></i> Copied!';
      setTimeout(() => {
        copyJsonPayloadBtn.innerHTML = '<i class="fa-solid fa-copy"></i> Copy JSON';
      }, 1500);
    });
  }

  // Authentication Checking
  function checkAuth() {
    if (isUserAdmin()) {
      if (authScreen) authScreen.classList.add('hidden');
      if (dashContent) dashContent.classList.remove('hidden');
      updateCampaignUrlOutput();
      refreshDashboardData();
    } else {
      if (authScreen) authScreen.classList.remove('hidden');
      if (dashContent) dashContent.classList.add('hidden');
      if (loginPinInput) loginPinInput.focus();
    }
  }

  if (loginForm && loginPinInput) {
    loginForm.addEventListener('submit', (e) => {
      e.preventDefault();
      if (authenticateAdmin(loginPinInput.value)) {
        if (loginError) loginError.classList.add('hidden');
        checkAuth();
      } else {
        if (loginError) loginError.classList.remove('hidden');
        loginPinInput.focus();
      }
    });
  }

  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      logoutAdmin();
      checkAuth();
    });
  }

  if (refreshBtn) {
    refreshBtn.addEventListener('click', () => {
      refreshBtn.querySelector('i')?.classList.add('fa-spin');
      refreshDashboardData().then(() => {
        setTimeout(() => refreshBtn.querySelector('i')?.classList.remove('fa-spin'), 400);
      });
    });
  }

  // Auto-Poll Selector
  const pollBtns = document.querySelectorAll('#dash-poll-filters .poll-btn');
  pollBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      pollBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const intervalMs = Number(btn.getAttribute('data-poll') || '0');

      if (autoPollTimer) {
        clearInterval(autoPollTimer);
        autoPollTimer = null;
      }

      if (intervalMs > 0) {
        autoPollTimer = setInterval(() => {
          refreshDashboardData();
        }, intervalMs);
      }
    });
  });

  // Time Range Selector
  const rangeBtns = document.querySelectorAll('#dash-time-filters .range-btn');
  rangeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      rangeBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeRange = btn.getAttribute('data-range') as any || '24h';
      refreshDashboardData();
    });
  });

  // Heatmap HUD Shortcuts
  function triggerHeatmapShortcut() {
    const event = new KeyboardEvent('keydown', {
      key: 'H',
      shiftKey: true,
      ctrlKey: true,
      bubbles: true
    });
    window.dispatchEvent(event);
  }

  if (openHeatmapBtn) openHeatmapBtn.addEventListener('click', triggerHeatmapShortcut);
  if (openHudActionBtn) openHudActionBtn.addEventListener('click', triggerHeatmapShortcut);

  // Passcode Settings Modal
  if (changePinBtn && changePinModal) {
    changePinBtn.addEventListener('click', () => changePinModal.classList.remove('hidden'));
  }
  if (cancelPinBtn && changePinModal) {
    cancelPinBtn.addEventListener('click', () => changePinModal.classList.add('hidden'));
  }
  if (changePinForm && newPinInput && changePinModal) {
    changePinForm.addEventListener('submit', (e) => {
      e.preventDefault();
      if (setCustomAdminPasscode(newPinInput.value)) {
        alert('Admin passcode updated successfully!');
        changePinModal.classList.add('hidden');
        newPinInput.value = '';
      }
    });
  }

  // 1-Click Export Leads CSV
  const exportCsvBtn = document.getElementById('export-leads-csv-btn');
  if (exportCsvBtn) {
    exportCsvBtn.addEventListener('click', () => {
      if (!latestAnalyticsData) return;
      const events = latestAnalyticsData.rawEvents || [];
      const leadEvents = events.filter((e: any) => 
        e.event_type === 'newsletter_signup_submitted' || 
        e.event_type === 'epk_deck_download' || 
        e.event_type === 'epk_deck_asset_downloaded' || 
        e.event_type === 'gig_map_ticket_cta_clicked' ||
        e.event_type === 'feedback_submitted'
      );

      const rows = [
        ['Timestamp', 'Event Type', 'Lead Category', 'Label / Detail', 'Inbound Channel', 'Inbound Alias', 'Device', 'Region']
      ];

      leadEvents.forEach((e: any) => {
        rows.push([
          `"${new Date(e.created_at).toISOString()}"`,
          `"${e.event_type}"`,
          `"${e.category || 'conversion'}"`,
          `"${(e.label || '').replace(/"/g, '""')}"`,
          `"${e.metadata?.inbound_channel || 'Direct'}"`,
          `"${e.metadata?.inbound_alias || 'Direct'}"`,
          `"${e.device || 'desktop'}"`,
          `"${e.metadata?.region || 'Global'}"`
        ]);
      });

      const csvContent = 'data:text/csv;charset=utf-8,' + rows.map(r => r.join(',')).join('\n');
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement('a');
      link.setAttribute('href', encodedUri);
      link.setAttribute('download', `kins_leads_export_${new Date().toISOString().split('T')[0]}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });
  }

  // 1-Click Export Full JSON Telemetry
  const exportJsonBtn = document.getElementById('export-json-btn');
  if (exportJsonBtn) {
    exportJsonBtn.addEventListener('click', () => {
      if (!latestAnalyticsData) return;
      const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(latestAnalyticsData, null, 2));
      const link = document.createElement('a');
      link.setAttribute('href', dataStr);
      link.setAttribute('download', `kins_analytics_dump_${new Date().toISOString().split('T')[0]}.json`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });
  }

  // Refresh Dashboard Data
  async function refreshDashboardData() {
    const data = await fetchLiveAnalyticsData(activeRange);
    latestAnalyticsData = data;

    const el = (id: string) => document.getElementById(id);

    // Top Metric Scorecards
    if (el('kpi-visitors')) el('kpi-visitors')!.textContent = data.visitors.toLocaleString();
    if (el('kpi-pageviews')) el('kpi-pageviews')!.textContent = data.pageviews.toLocaleString();
    if (el('kpi-pv-per-user')) el('kpi-pv-per-user')!.textContent = `${data.pvPerUser} / visitor`;
    if (el('kpi-outbound-ctr')) el('kpi-outbound-ctr')!.textContent = data.outboundCtr;
    if (el('kpi-outbound-count')) el('kpi-outbound-count')!.textContent = `${data.outbound} clicks`;
    if (el('kpi-ux-score')) el('kpi-ux-score')!.textContent = `${data.uxFriction.score}%`;
    if (el('kpi-ux-badge')) el('kpi-ux-badge')!.textContent = data.uxFriction.status;
    if (el('kpi-ux-meta')) el('kpi-ux-meta')!.textContent = `LCP ${data.lcp} • INP ${data.inp} • CLS ${data.cls}`;

    // Acquisition Channels Breakdown (View A)
    const channelsBox = el('channels-breakdown-list');
    if (channelsBox && data.referrers) {
      const totalRefs = Math.max(1, Object.values(data.referrers).reduce((a: any, b: any) => a + b, 0) as number);
      const sorted = Object.entries(data.referrers).sort((a: any, b: any) => b[1] - a[1]);
      channelsBox.innerHTML = sorted.map(([name, count]: any) => {
        const pct = Math.round((count / totalRefs) * 100);
        return `
          <div class="channel-bar-item">
            <div class="channel-bar-label">
              <span>${name}</span>
              <span class="font-mono text-muted">${count} (${pct}%)</span>
            </div>
            <div class="channel-bar-track">
              <div class="channel-bar-fill" style="width: ${pct}%;"></div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Inbound Channels Attribution Matrix (View A)
    const tbody = el('inbound-channels-tbody');
    if (tbody && data.inboundChannels) {
      tbody.innerHTML = data.inboundChannels.map((ch: any) => `
        <tr>
          <td>
            <div style="font-weight: 800; color: #ffffff;">${ch.channel}</div>
            <code style="color: var(--dash-accent); font-size: 0.68rem;">tinyurl.com/${ch.alias}</code>
          </td>
          <td class="text-right font-mono font-bold">${ch.visitors.toLocaleString()}</td>
          <td class="text-right font-mono text-purple">${ch.audioPlays.toLocaleString()}</td>
          <td class="text-right font-mono text-emerald">${ch.outboundClicks.toLocaleString()}</td>
          <td class="text-right font-mono text-cyan font-bold">${ch.conversions.toLocaleString()}</td>
          <td class="text-right font-mono text-accent font-bold">${ch.convRate}</td>
        </tr>
      `).join('');
    }

    // Streaming Platforms List (View A)
    const streamBars = el('streaming-platform-bars');
    if (streamBars && data.outboundPlatformList) {
      streamBars.innerHTML = data.outboundPlatformList.map((item: any) => `
        <div class="stream-bar-item">
          <div class="stream-bar-head">
            <span class="stream-title"><i class="fa-brands fa-${item.platform.toLowerCase().includes('spotify') ? 'spotify text-emerald' : item.platform.toLowerCase().includes('apple') ? 'apple text-rose' : item.platform.toLowerCase().includes('youtube') ? 'youtube text-rose' : 'soundcloud'}"></i> ${item.platform}</span>
            <span class="stream-count font-mono">${item.clicks} clicks (${item.percentage}%)</span>
          </div>
          <div class="channel-bar-track">
            <div class="channel-bar-fill" style="width: ${item.percentage}%;"></div>
          </div>
        </div>
      `).join('');

      if (el('top-streaming-dest') && data.outboundPlatformList[0]) {
        el('top-streaming-dest')!.textContent = `${data.outboundPlatformList[0].platform} (${data.outboundPlatformList[0].percentage}%)`;
      }
    }

    // Audio Step Funnel (View B)
    if (data.audioFunnel) {
      if (el('funnel-val-starts')) el('funnel-val-starts')!.textContent = `${data.audioFunnel.starts} plays`;
      if (el('funnel-val-25')) el('funnel-val-25')!.textContent = `${data.audioFunnel.m25} listeners`;
      if (el('funnel-val-50')) el('funnel-val-50')!.textContent = `${data.audioFunnel.m50} listeners`;
      if (el('funnel-val-75')) el('funnel-val-75')!.textContent = `${data.audioFunnel.m75} listeners`;
      if (el('funnel-val-100')) el('funnel-val-100')!.textContent = `${data.audioFunnel.completed} completed`;

      if (el('funnel-fill-25')) el('funnel-fill-25')!.style.width = `${data.audioFunnel.pctM25}%`;
      if (el('funnel-fill-50')) el('funnel-fill-50')!.style.width = `${data.audioFunnel.pctM50}%`;
      if (el('funnel-fill-75')) el('funnel-fill-75')!.style.width = `${data.audioFunnel.pctM75}%`;
      if (el('funnel-fill-100')) el('funnel-fill-100')!.style.width = `${data.audioFunnel.pctComplete}%`;

      if (el('funnel-pct-25')) el('funnel-pct-25')!.textContent = `${data.audioFunnel.pctM25}%`;
      if (el('funnel-pct-50')) el('funnel-pct-50')!.textContent = `${data.audioFunnel.pctM50}%`;
      if (el('funnel-pct-75')) el('funnel-pct-75')!.textContent = `${data.audioFunnel.pctM75}%`;
      if (el('funnel-pct-100')) el('funnel-pct-100')!.textContent = `${data.audioFunnel.pctComplete}%`;

      if (el('drop-label-1')) el('drop-label-1')!.textContent = `−${100 - data.audioFunnel.pctM25}% drop`;
      if (el('drop-label-2')) el('drop-label-2')!.textContent = `−${data.audioFunnel.pctM25 - data.audioFunnel.pctM50}% drop`;
      if (el('drop-label-3')) el('drop-label-3')!.textContent = `−${data.audioFunnel.pctM50 - data.audioFunnel.pctM75}% drop`;
      if (el('drop-label-4')) el('drop-label-4')!.textContent = `−${data.audioFunnel.pctM75 - data.audioFunnel.pctComplete}% drop`;

      if (el('funnel-summary-rate')) el('funnel-summary-rate')!.textContent = `${data.audioFunnel.pctComplete}%`;
      if (el('funnel-summary-drop')) el('funnel-summary-drop')!.textContent = `${data.audioFunnel.midDropLoss}%`;
      if (el('funnel-summary-time')) el('funnel-summary-time')!.textContent = data.avgListen;
    }

    // Fan Search Demand Index Table (View B)
    const searchTbody = el('search-demand-tbody');
    if (searchTbody && data.topSearches) {
      searchTbody.innerHTML = data.topSearches.map((sq: any) => {
        const statusClass = sq.status === 'In Repertoire' ? 'repertoire' : sq.status === 'Planned' ? 'planned' : 'unreleased';
        return `
          <tr>
            <td class="font-mono text-muted font-bold">${sq.rank}</td>
            <td style="font-weight: 700; color: #ffffff;">
              <i class="fa-solid fa-magnifying-glass text-accent" style="font-size: 0.72rem; margin-right: 6px;"></i>
              "${sq.term}"
            </td>
            <td class="text-right font-mono font-bold">${sq.count} searches</td>
            <td class="text-center badge-velocity">${sq.velocity}</td>
            <td class="text-right">
              <span class="badge-status ${statusClass}">${sq.status}</span>
            </td>
          </tr>
        `;
      }).join('');
    }

    // Interaction Density Map (View B)
    const densityBox = el('interaction-density-grid');
    if (densityBox && data.topElements) {
      densityBox.innerHTML = data.topElements.map((elItem: any) => `
        <div class="density-item-card">
          <span class="density-label">
            <i class="fa-solid fa-arrow-pointer text-muted" style="font-size: 0.7rem;"></i>
            ${elItem.label}
          </span>
          <span class="density-count font-mono">${elItem.count} clicks</span>
        </div>
      `).join('');
    }

    // Conversion Breakdown Numbers (View B)
    if (el('stat-gig-tickets')) el('stat-gig-tickets')!.textContent = data.gigTickets.toLocaleString();
    if (el('stat-epk-downloads')) el('stat-epk-downloads')!.textContent = data.epkDownloads.toLocaleString();
    if (el('stat-newsletter')) el('stat-newsletter')!.textContent = data.newsletter.toLocaleString();
    if (el('stat-feedback')) el('stat-feedback')!.textContent = data.feedback.toLocaleString();
    if (el('stat-total-conversions')) el('stat-total-conversions')!.textContent = data.totalConversions.toLocaleString();

    // UX Health & CWV (View C)
    if (el('vital-lcp')) el('vital-lcp')!.textContent = data.lcp;
    if (el('vital-inp')) el('vital-inp')!.textContent = data.inp;
    if (el('vital-cls')) el('vital-cls')!.textContent = data.cls;

    if (el('ux-score-number')) el('ux-score-number')!.textContent = `${data.uxFriction.score}%`;
    if (el('ux-status-text')) el('ux-status-text')!.textContent = `${data.uxFriction.score}% Clean UX (${data.uxFriction.status} Experience)`;
    if (el('stat-rage-clicks')) el('stat-rage-clicks')!.textContent = `${data.uxFriction.rageClicks}`;
    if (el('stat-dead-clicks')) el('stat-dead-clicks')!.textContent = `${data.uxFriction.deadClicks}`;
    if (el('stat-near-misses')) el('stat-near-misses')!.textContent = `${data.uxFriction.nearMisses}`;
    if (el('stat-touch-acc')) el('stat-touch-acc')!.textContent = `${data.uxFriction.touchAccuracy}%`;

    // Viewports Split (View C)
    if (el('stat-mobile-pct')) el('stat-mobile-pct')!.textContent = `${data.mobilePct}%`;
    if (el('stat-desktop-pct')) el('stat-desktop-pct')!.textContent = `${data.desktopPct}%`;
    if (el('stat-touch-share')) el('stat-touch-share')!.textContent = `${data.uxFriction.touchPct}%`;
    if (el('split-mobile-fill')) el('split-mobile-fill')!.style.width = `${data.mobilePct}%`;
    if (el('split-desktop-fill')) el('split-desktop-fill')!.style.width = `${data.desktopPct}%`;
    if (el('split-touch-fill')) el('split-touch-fill')!.style.width = `${data.uxFriction.touchPct}%`;

    // Runtime Errors Console (View C)
    const errContainer = el('error-log-container');
    const errBadge = el('error-count-badge');
    if (errBadge) errBadge.textContent = `${data.errorLogs.length} errors`;
    if (errContainer) {
      if (data.errorLogs.length === 0) {
        errContainer.innerHTML = `
          <div class="empty-log-state">
            <i class="fa-solid fa-circle-check text-emerald log-state-icon"></i>
            <div class="font-bold">No unhandled client-side runtime errors recorded.</div>
            <div class="text-muted">All web vitals, API calls, and audio player engines operating smoothly.</div>
          </div>
        `;
      } else {
        errContainer.innerHTML = data.errorLogs.map((err: any) => `
          <div style="background: rgba(244,63,94,0.1); border: 1px solid rgba(244,63,94,0.3); border-radius: 6px; padding: 8px;">
            <div style="color: var(--dash-rose); font-weight: bold;">[${err.device.toUpperCase()}] ${err.error_message || 'JavaScript Exception'}</div>
            <div style="color: var(--dash-text-dim); font-size: 0.65rem; margin-top: 2px;">${new Date(err.created_at).toLocaleTimeString()} • ${err.path}</div>
          </div>
        `).join('');
      }
    }

    // Bottom Telemetry Stream Preview
    const tickerBox = el('pulse-ticker-items');
    if (tickerBox && data.recentActivities) {
      tickerBox.innerHTML = data.recentActivities.slice(0, 2).map((act: any) => `
        <span class="pulse-item"><i class="${act.icon} ${act.color}"></i> ${act.text} • <small style="color: #71717a;">${act.time}</small></span>
      `).join(' • ');
    }

    // Drawer Event Stream List
    const streamList = el('events-stream-list');
    if (streamList && data.recentActivities) {
      streamList.innerHTML = data.recentActivities.map((act: any) => `
        <div class="event-stream-row">
          <span><i class="${act.icon} ${act.color}"></i> ${act.text}</span>
          <span class="font-mono text-muted">[${act.device.toUpperCase()}] • ${act.time}</span>
        </div>
      `).join('');
    }

    // Drawer Raw JSON Inspector
    const jsonBlock = el('raw-json-inspector');
    if (jsonBlock) {
      jsonBlock.textContent = JSON.stringify(data, null, 2);
    }

    renderCharts(data);
  }

  function renderCharts(data: any) {
    if (typeof Chart === 'undefined') {
      setTimeout(() => renderCharts(data), 150);
      return;
    }

    Chart.defaults.color = '#8e8e98';
    Chart.defaults.font.family = "'Space Grotesk', sans-serif";

    // 1. Primary Trend Area Chart (Traffic vs Conversions)
    const trafficCtx = (document.getElementById('trafficTrendChart') as HTMLCanvasElement)?.getContext('2d');
    if (trafficCtx) {
      if (chartInstances.traffic) chartInstances.traffic.destroy();

      // Create gradient fills
      const gradPageviews = trafficCtx.createLinearGradient(0, 0, 0, 260);
      gradPageviews.addColorStop(0, 'rgba(226, 241, 99, 0.25)');
      gradPageviews.addColorStop(1, 'rgba(226, 241, 99, 0.00)');

      const gradVisitors = trafficCtx.createLinearGradient(0, 0, 0, 260);
      gradVisitors.addColorStop(0, 'rgba(0, 240, 255, 0.18)');
      gradVisitors.addColorStop(1, 'rgba(0, 240, 255, 0.00)');

      const gradConv = trafficCtx.createLinearGradient(0, 0, 0, 260);
      gradConv.addColorStop(0, 'rgba(16, 185, 129, 0.22)');
      gradConv.addColorStop(1, 'rgba(16, 185, 129, 0.00)');

      chartInstances.traffic = new Chart(trafficCtx, {
        type: 'line',
        data: {
          labels: data.timeline.labels,
          datasets: [
            {
              label: 'Pageviews',
              data: data.timeline.pageviews,
              borderColor: '#e2f163',
              backgroundColor: gradPageviews,
              borderWidth: 2.5,
              fill: true,
              tension: 0.35,
              pointBackgroundColor: '#e2f163',
              pointRadius: 3,
              pointHoverRadius: 6
            },
            {
              label: 'Unique Visitors',
              data: data.timeline.visitors,
              borderColor: '#00f0ff',
              backgroundColor: gradVisitors,
              borderWidth: 2,
              fill: true,
              tension: 0.35,
              pointBackgroundColor: '#00f0ff',
              pointRadius: 3,
              pointHoverRadius: 5
            },
            {
              label: 'Conversions',
              data: data.timeline.conversions,
              borderColor: '#10b981',
              backgroundColor: gradConv,
              borderWidth: 2,
              fill: true,
              tension: 0.35,
              pointBackgroundColor: '#10b981',
              pointRadius: 3,
              pointHoverRadius: 5
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            mode: 'index',
            intersect: false
          },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#151520',
              titleColor: '#e2f163',
              borderColor: '#242432',
              borderWidth: 1,
              padding: 12,
              boxPadding: 6,
              usePointStyle: true
            }
          },
          scales: {
            x: {
              grid: { color: 'rgba(255, 255, 255, 0.04)' },
              ticks: { font: { size: 10 } }
            },
            y: {
              grid: { color: 'rgba(255, 255, 255, 0.04)' },
              beginAtZero: true,
              ticks: { font: { size: 10 } }
            }
          }
        }
      });
    }
  }

  // Initial Auth Check
  checkAuth();
</script>
