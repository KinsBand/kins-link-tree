              <option value="tiktok">TikTok (tinyurl.com/TKBioPage)</option>
              <option value="spotify">Spotify Artist Bio (tinyurl.com/SPBioPage)</option>
              <option value="facebook">Facebook (tinyurl.com/FBBioPage)</option>
              <option value="youtube">YouTube (tinyurl.com/YTBioPage)</option>
              <option value="discord">Discord (tinyurl.com/DCBioPage)</option>
              <option value="substack">Substack / Newsletter (tinyurl.com/SubstackBio)</option>
              <option value="threads">Threads (tinyurl.com/ThreadsBio)</option>
              <option value="applemusic">Apple Music (tinyurl.com/AppleBio)</option>
