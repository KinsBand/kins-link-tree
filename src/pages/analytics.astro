    border-radius: 16px;
    background: var(--dash-surface-raised);
    border: 2px solid var(--dash-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    color: var(--dash-accent);
    box-shadow: 0 0 20px rgba(226, 241, 99, 0.25), 3px 3px 0px #000000;
  }

  .auth-title {
    font-family: 'Cinzel', serif;
