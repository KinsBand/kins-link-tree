---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToastContainer from '../components/ui/ToastContainer.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';
import LegalModal from '../components/modals/LegalModal.astro';
import FeedbackModal from '../components/modals/FeedbackModal.astro';
import { functionalityConfig } from '../settings/functionality.config';

// Navigation & Sticky Filters
import TheoryTopNav from '../components/theory/TheoryTopNav.astro';
import TheoryChipBar from '../components/theory/TheoryChipBar.astro';
import TheoryEmptyState from '../components/theory/TheoryEmptyState.astro';

// Guitar Section Components
import GuitarFretboardHero from '../components/theory/guitar/GuitarFretboardHero.astro';
import GuitarScalesSection from '../components/theory/guitar/GuitarScalesSection.astro';
import GuitarChordsSection from '../components/theory/guitar/GuitarChordsSection.astro';
import GuitarCagedSection from '../components/theory/guitar/GuitarCagedSection.astro';
import GuitarIntervalsSection from '../components/theory/guitar/GuitarIntervalsSection.astro';
import GuitarTuningsSection from '../components/theory/guitar/GuitarTuningsSection.astro';

// Drum Section Components
import DrumGridHero from '../components/theory/drums/DrumGridHero.astro';
import DrumRudimentsSection from '../components/theory/drums/DrumRudimentsSection.astro';
import DrumMeterSection from '../components/theory/drums/DrumMeterSection.astro';
import DrumPolyrhythmsSection from '../components/theory/drums/DrumPolyrhythmsSection.astro';
import DrumGroovesSection from '../components/theory/drums/DrumGroovesSection.astro';
import DrumSubdivisionsSection from '../components/theory/drums/DrumSubdivisionsSection.astro';

// Styles
import '../styles/theory/theory.css';

// Theory page routing gate
if (!functionalityConfig.enableTheoryPage) {
  return Astro.redirect('/');
}
---

<BaseLayout
  title="KINS THEORY 🎸🥁 — Visual Music Theory for Guitar & Drums"
  description="Interactive music theory tools by KINS. Real visual guitar fretboard with live sound synthesis, chord diagrams with muted/open strings, 16-step drum beat sequencer with audio playback, rudiment sticking flows, and polyrhythms."
>
  <main class="theory-page" id="theoryPage">
    <div class="theory-view" id="theoryView">
      <!-- Top Navigation Header -->
      <TheoryTopNav />

      <!-- Sticky Category Filter Chips Bar -->
      <TheoryChipBar />

      <!-- Main Content Area -->
      <div class="theory-content-container">
        <!-- ================================================================= -->
        <!-- GUITAR TAB PANEL -->
        <!-- ================================================================= -->
        <section
          id="guitarPanel"
          class="theory-tab-panel active"
          role="tabpanel"
          aria-labelledby="guitarTabBtn"
        >
          <GuitarFretboardHero />
          <GuitarScalesSection />
          <GuitarChordsSection />
          <GuitarCagedSection />
          <GuitarIntervalsSection />
          <GuitarTuningsSection />
        </section>

        <!-- ================================================================= -->
        <!-- DRUMS TAB PANEL -->
        <!-- ================================================================= -->
        <section
          id="drumsPanel"
          class="theory-tab-panel"
          role="tabpanel"
          aria-labelledby="drumsTabBtn"
          hidden
        >
          <DrumGridHero />
          <DrumRudimentsSection />
          <DrumMeterSection />
          <DrumPolyrhythmsSection />
          <DrumGroovesSection />
          <DrumSubdivisionsSection />
        </section>

        <!-- Dynamic Empty Search Results State -->
        <TheoryEmptyState />

        <!-- Official Site Footer -->
        <SiteFooter />
      </div>
    </div>
  </main>

  <LegalModal />
  <FeedbackModal />
  <ToastContainer />
</BaseLayout>

<script>
  import '../scripts/controllers/theory/index.ts';
</script>
