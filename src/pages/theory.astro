      'd-shape': { name: 'D Shape Position', frets: ['✕', '✕', 0, 2, 3, 2], labels: ['✕', '✕', 'R', '5', 'R', '3'], desc: 'Root on 4th string (Fret 0 for D / Fret 10 for C).' },
