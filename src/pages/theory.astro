    const STRING_BASE_FREQS = [329.63, 246.94, 196.00, 146.83, 110.00, 82.41]; // High E (str 0) to Low E (str 5)

    function getFretFreq(strIndex: number, fret: number): number {
      const base = STRING_BASE_FREQS[strIndex];
      return base * Math.pow(2, fret / 12);
    }

