          drumsPanel.hidden = false;
          drumsPanel.classList.add('active');
        }
        if (guitarPanel) {
          guitarPanel.hidden = true;
          guitarPanel.classList.remove('active');
        }

        if (drumsChipsRow) drumsChipsRow.hidden = false;
        if (guitarChipsRow) guitarChipsRow.hidden = true;
      }

      resetCategoryChips();
      applySearchFilter();
    }

