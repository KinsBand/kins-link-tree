      const activeRow = activeInstrument === 'guitar' ? guitarChipsRow : drumsChipsRow;
      if (!activeRow) return;
      activeRow.querySelectorAll('.theory-chip-btn').forEach((b, idx) => {
        if (idx === 0) b.classList.add('active');
        else b.classList.remove('active');
      });
