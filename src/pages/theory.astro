    const CHROMATIC_SCALE = ['C', 'C#', 'D', 'Eb', 'E', 'F', 'F#', 'G', 'Ab', 'A', 'Bb', 'B'];

    let currentFretMode = 'scales';
    let currentRoot = 'A';
    let currentScaleKey = 'pentatonic-minor';
