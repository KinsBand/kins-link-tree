-card-panel-hover);\r\n}\r\nhtml[data-theme] .tuner-page :is(.tuner-inst-card.active, .tuner-sheet-chip.active, .tuner-mic-cta, .pill-cta) {\r\n  background: var(--btn-brand-primary);\r\n  color: var(--btn-brand-text);\r\n}\r\nhtml[data-theme] .tuner-page :is(.tuner-mic-cta, .tuner-inst-card.active, .tuner-sheet-chip.active):hover {\r\n  background: var(--btn-brand-hover);\r\n}\r\nhtml[data-theme] .tuner-page :is(.tuner-settings-label, .tuner-sheet-setup-label, .tuner-pill-title, .tuner-hint) {\r\n  color: var(--text-card-secondary);\r\n}\r\nhtml[data-theme] .tuner-page :is(.tuner-sheet-setup-value, .tuner-pill-label, .tuner-note, .tuner-cents, .tuner-frequency) {\r\n  color: var(--text-on-light);\r\n}\r\nhtml[data-theme] .tuner-page .tuner-sheet {\r\n  background: var(--surface-card-panel);\r\n  color: var(--text-on-light);\r\n  border: var(--border-brutal);\r\n  box-shadow: var(--shadow-brutal-black-lg);\r\n}\r\nhtml[data-theme] .tuner-page .tuner-sheet-backdrop { background: var(--surface-overlay); }\r\nhtml[data-theme] .tuner-page .tuner-sheet-setup-cell[hidden] { display: none; }\r\nhtml[data-theme] .tuner-page .tuner-sheet-setup-row { grid-template-columns: minmax(0, 1fr); }\r\nhtml[data-theme] .tuner-page :is(button, input, select, a):focus-visible {\r\n  outline: var(--tuner-focus-width) solid var(--brand-accent-primary);\r\n  outline-offset: var(--tuner-focus-offset);\r\n}\r\nhtml[data-theme] .tuner-page :is(button, input, select):disabled { opacity: 0.5; cursor: not-allowed; }\r\nhtml[data-theme] .tuner-page .rail-note { box-sizing: border-box; flex-shrink: 0; }\r\nhtml[data-theme] .tuner-page .rail-note { color: var(--text-card-secondary); opacity: 1; }\r\nhtml[data-theme] .tuner-page .rail-note.is-exact { background: var(--btn-brand-primary); color: var(--btn-brand-text); }\r\nhtml[data-theme] .tuner-page :is(.tuner-icon-btn, .tuner-inst-card, .tuner-sheet-chip, .tuner-sheet-setup-btn, .tuner-input-settings input, .tuner-input-settings select) { border-color: var(--tuner-control-border); }\r\nhtml[data-theme] .tuner-page .tuner-sheet-floating-header {\r\n  position: absolute;\r\n  inset-block-end: calc(100% + var(--tuner-detail-gap));\r\n  inset-inline-start: 50%;\r\n  transform: translateX(-50%);\r\n  z-index: 10;\r\n}\r\nhtml[data-theme] .tuner-page .tuner-sheet-close {\r\n  position: absolute;\r\n  inset-block-start: 50%;\r\n  inset-inline-start: calc(100% + var(--tuner-detail-gap));\r\n  transform: translateY(-50%);\r\n  z-index: 1;\r\n  width: var(--tuner-touch-target); height: var(--tuner-touch-target);\r\n  display: grid; place-items: center;\r\n  border: var(--border-brutal-sm); border-radius: var(--radius-sm);\r\n  box-shadow: var(--shadow-brutal-black);\r\n  background: var(--surface-card-panel); color: var(--text-on-light);\r\n  font: var(--tuner-close-font) var(--font-primary); cursor: pointer;\r\n  transition: transform var(--tuner-mode-duration) var(--ease-tactile), background-color var(--tuner-mode-duration) ease, box-shadow var(--tuner-mode-duration) ease;\r\n}\r\nhtml[data-theme] .tuner-page .tuner-sheet-close:hover { background: var(--surface-card-panel-hover); transform: translateY(-50%) translate(-1px, -1px); }\r\nhtml[data-theme] .tuner-page .tuner-sheet-close:active { transform: translateY(-50%) translate(1px, 1px); box-shadow: var(--shadow-brutal-black); }\r\n@media (min-width: 768px) {\r\n  html[data-theme] .tuner-page .tuner-sheet {\r\n    left: 50%; right: auto; top: 50%; bottom: auto;\r\n    width: min(var(--tuner-dialog-width), calc(100% - var(--tuner-dialog-gutter)));\r\n    max-height: 80dvh;\r\n    border-radius: var(--radius-md);\r\n    transform: translate(-50%, -46%);\r\n    opacity: 0;\r\n    transition: transform var(--tuner-dialog-duration) var(--ease-snappy), opacity var(--tuner-dialog-duration) ease;\r\n  }\r\n  html[data-theme] .tuner-page .tuner-sheet.open { transform: translate(-50%, -50%); opacity: 1; }\r\n  html[data-theme] .tuner-page .tuner-sheet.is-closing { transform: translate(-50%, -46%) !important; opacity: 0; }\r\n}\r\n@media (prefers-reduced-motion: reduce) {\r\n  html[data-theme] .tuner-page .tuner-sheet { transition: none !important; }\r\n}\r\n\r\n/* Compact settings and primary action controls. */\r\nhtml[data-theme] .tuner-page .tuner-sheet-floating-header .tuner-sheet-title { position: static; transform: none; }\r\nhtml[data-theme] .tuner-page .tuner-sheet-close { transition: transform var(--tuner-mode-duration) var(--ease-tactile); }\r\n.tuner-stepper-controls { display: grid; grid-template-columns: var(--tuner-touch-target) minmax(0, 1fr) var(--tuner-touch-target); gap: var(--tuner-detail-gap); align-items: center; }\r\n.tuner-string-stepper { max-width: 100%; }\r\n.tuner-count-edit { display: grid; justify-items: center; }\r\nhtml[data-theme] .tuner-page .tuner-count-edit input { width: 100%; min-width: 0; min-height: var(--tuner-touch-target); box-sizing: border-box; appearance: textfield; text-align: center; font: bold var(--tuner-close-font) var(--font-mono); color: var(--text-on-light); background: var(--surface-card-panel); border: none; border-radius: var(--radius-sm); }\r\n.tuner-count-edit input::-webkit-inner-spin-button, .tuner-count-edit input::-webkit-outer-spin-button { appearance: none; margin: 0; }\r\n.tuner-count-edit span { line-height: 0.5; color: var(--text-card-secondary); pointer-events: none; }\r\n.tuner-behavior-buttons { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--tuner-detail-gap); }\r\nhtml[data-theme] .tuner-page .tuner-mini-button { display: flex; align-items: center; justify-content: center; gap: var(--tuner-detail-gap); min-height: var(--tuner-touch-target); min-width: 0; padding: var(--tuner-detail-gap); border: var(--border-brutal-sm); border-color: var(--tuner-control-border); border-radius: var(--radius-sm); background: var(--surface-card-panel); color: var(--text-on-light); font: bold var(--tuner-detail-font) var(--font-heading); cursor: pointer; transition: transform var(--tuner-mode-duration) var(--ease-tactile); }\r\nhtml[data-theme] .tuner-page :is(.tuner-mini-button, .tuner-count-edit input):hover { background: var(--surface-card-panel-hover); }\r\nhtml[data-theme] .tuner-page .tuner-mini-button[aria-pressed=\"true\"] { background: var(--btn-brand-primary); color: var(--btn-brand-text); }\r\nhtml[data-theme] .tuner-page .tuner-mini-button[aria-pressed=\"true\"]:hover { background: var(--btn-brand-hover); }\r\nhtml[data-theme] .tuner-page .tuner-mini-button.brutal-press:active { transform: translate(var(--tuner-art-press), var(--tuner-art-press)) scale(0.985); }\r\n.tuner-auto-symbol { display: grid; place-items: center; border: var(--tuner-focus-width) solid currentColor; border-radius: var(--radius-pill); width: 1.5em; height: 1.5em; flex-shrink: 0; }\r\n.tuner-main-actions { display: flex; align-items: center; justify-content: center; width: 100%; gap: var(--tuner-detail-gap); }\r\nhtml[data-theme] .tuner-page .mode-drums .tuner-main-actions { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr); }\r\nhtml[data-theme] .tuner-page .mode-drums .tuner-main-actions .tuner-mic-cta { width: 100%; min-width: 0; padding-inline: var(--tuner-detail-gap); }\r\nhtml[data-theme] .tuner-page .tuner-mini-button[hidden] { display: none; }\r\nhtml[data-theme] .tuner-page:has(.mode-ear, .mode-drums) .tuner-behavior-buttons { display: none; }\r\n@media (prefers-reduced-motion: reduce) {\r\n  html[data-theme] .tuner-page :is(.tuner-mini-button, .tuner-sheet-close) { transition: none; }\r\n  html[data-theme] .tuner-page .tuner-mini-button:active { transform: none; }\r\n}\r\n\r\nhtml[data-theme] .tuner-page :is(.tuner-stepper-button, .drum-workflow .tuner-stepper-button) {\r\n  display: inline-flex; align-items: center; justify-content: center;\r\n  width: 100%; height: var(--tuner-touch-target); min-height: var(--tuner-touch-target);\r\n  padding: 0; flex-shrink: 0; border: var(--border-brutal-s