nt-weight:800;letter-spacing:0.05em;text-transform:uppercase;padding:7px 10px;cursor:pointer;user-select:none;transition:background-color 0.16s ease,color 0.16s ease,border-color 0.16s ease,transform 0.16s var(--ease-tactile),box-shadow 0.16s ease}.legal-tab-btn[data-astro-cid-plzmpoju]:hover{color:var(--text-card-primary, #000000);background:var(--surface-card-panel-hover, #ffffff);transform:translate(-1px,-1px);box-shadow:2px 2px 0px #000000}.legal-tab-btn[data-astro-cid-plzmpoju].active{background:var(--btn-brand-primary, #f2fd43);color:var(--btn-brand-text, #000000);border-color:#000000;box-shadow:1.5px 1.5px 0px #000000;font-weight:900}.legal-tab-icon[data-astro-cid-plzmpoju]{font-size:0.8rem}.legal-modal-body[data-astro-cid-plzmpoju]{padding:16px 18px;overflow-y:auto;overscroll-behavior:contain;display:flex;flex-direction:column;gap:14px;color:var(--text-card-secondary, #52525b);font-family:var(--font-secondary);font-size:0.82rem;line-height:1.5}.legal-tab-panel[data-astro-cid-plzmpoju]{display:flex;flex-direction:column;gap:12px;outline:none}.legal-tab-panel[data-astro-cid-plzmpoju].hidden{display:none}.legal-highlight-card[data-astro-cid-plzmpoju]{background:var(--surface-card-panel, #f5f4ef);border:2px solid #000000;box-shadow:3px 3px 0px #000000;border-radius:8px;padding:12px 14px;display:flex;flex-direction:column;gap:6px}.legal-highlight-card[data-astro-cid-plzmpoju].accent-border{border-left:5px solid var(--brand-accent-primary, #f2fd43)}.legal-highlight-meta[data-astro-cid-plzmpoju]{font-size:0.68rem;font-weight:800;color:var(--text-card-muted, #71717a);letter-spacing:0.05em;text-transform:uppercase;display:flex;align-items:center;gap:5px}.legal-highlight-meta[data-astro-cid-plzmpoju] i[data-astro-cid-plzmpoju]{color:var(--brand-accent-primary, #f2fd43)}.legal-intro-text[data-astro-cid-plzmpoju]{color:var(--text-card-secondary, #52525b);margin:0;font-size:0.82rem;line-height:1.45}.legal-intro-text[data-astro-cid-plzmpoju] strong[data-astro-cid-plzmpoju