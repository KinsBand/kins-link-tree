d: var(--surface-card-panel-hover);\n}\nhtml[data-theme] .tuner-page :is(.tuner-inst-card.active, .tuner-sheet-chip.active, .tuner-mic-cta, .pill-cta) {\n  background: var(--btn-brand-primary);\n  color: var(--btn-brand-text);\n}\nhtml[data-theme] .tuner-page :is(.tuner-mic-cta, .tuner-inst-card.active, .tuner-sheet-chip.active):hover {\n  background: var(--btn-brand-hover);\n}\nhtml[data-theme] .tuner-page :is(.tuner-settings-label, .tuner-sheet-setup-label, .tuner-pill-title, .tuner-hint) {\n  color: var(--text-card-secondary);\n}\nhtml[data-theme] .tuner-page :is(.tuner-sheet-setup-value, .tuner-pill-label, .tuner-note, .tuner-cents, .tuner-frequency) {\n  color: var(--text-on-light);\n}\nhtml[data-theme] .tuner-page .tuner-sheet {\n  background: var(--surface-card-panel);\n  color: var(--text-on-light);\n  border: var(--border-brutal);\n  box-shadow: var(--shadow-brutal-black-lg);\n}\nhtml[data-theme] .tuner-page .tuner-sheet-backdrop { background: var(--surface-overlay); }\nhtml[data-theme] .tuner-page .tuner-sheet-setup-cell[hidden] { display: none; }\nhtml[data-theme] .tuner-page .tuner-sheet-setup-row { grid-template-columns: minmax(0, 1fr); }\nhtml[data-theme] .tuner-page :is(button, input, select, a):focus-visible {\n  outline: var(--tuner-focus-width) solid var(--brand-accent-primary);\n  outline-offset: var(--tuner-focus-offset);\n}\nhtml[data-theme] .tuner-page :is(button, input, select):disabled { opacity: 0.5; cursor: not-allowed; }\nhtml[data-theme] .tuner-page .rail-note { box-sizing: border-box; flex-shrink: 0; }\nhtml[data-theme] .tuner-page .rail-note { color: var(--text-card-secondary); opacity: 1; }\nhtml[data-theme] .tuner-page .rail-note.is-exact { background: var(--btn-brand-primary); color: var(--btn-brand-text); }\nhtml[data-theme] .tuner-page :is(.tuner-icon-btn, .tuner-inst-card, .tuner-sheet-chip, .tuner-sheet-setup-btn, .tuner-input-settings input, .tuner-input-settings select) { border-color: var(--tuner-control-border); }\nhtml[data-theme] .tuner-page .tuner-sheet-close {\n  position: absolute; inset-block-start: 0; inset-inline-end: var(--tuner-detail-gap); z-index: 3;\n  width: var(--tuner-touch-target); height: var(--tuner-touch-target);\n  border: none; border-radius: var(--radius-sm);\n  background: var(--surface-card-panel); color: var(--text-on-light);\n  font: var(--tuner-close-font) var(--font-primary); cursor: pointer;\n}\nhtml[data-theme] .tuner-page .tuner-sheet-close:hover { background: var(--surface-card-panel-hover); }\n@media (min-width: 768px) {\n  html[data-theme] .tuner-page .tuner-sheet {\n    left: 50%; right: auto; top: 50%; bottom: auto;\n    width: min(var(--tuner-dialog-width), calc(100% - var(--tuner-dialog-gutter)));\n    max-height: 80dvh;\n    border-radius: var(--radius-md);\n    transform: translate(-50%, -46%);\n    opacity: 0;\n    transition: transform var(--tuner-dialog-duration) var(--ease-snappy), opacity var(--tuner-dialog-duration) ease;\n  }\n  html[data-theme] .tuner-page .tuner-sheet.open { transform: translate(-50%, -50%); opacity: 1; }\n  html[data-theme] .tuner-page .tuner-sheet.is-closing { transform: translate(-50%, -46%) !important; opacity: 0; }\n}\n@media (prefers-reduced-motion: reduce) {\n  html[data-theme] .tuner-page .tuner-sheet { transition: none !important; }\n}\n"],"\n",["STYLE",{},"html[data-theme] .tuner-page [hidden] { display: none !important; }\nhtml[data-theme] .tuner-page .tuner-ear-mode { grid-column: 1 / -1; display: grid; gap: var(--tuner-detail-gap); }\n.tuner-ear-mode span { font: var(--tuner-detail-font) var(--font-primary); text-transform: none; }\n.tuner-sample-credits { font: var(--tuner-detail-font) var(--font-primary); color: var(--text-card-secondary); line-height: 1.5; }\n.tuner-sample-credits a { color: inherit; text-decoration: underline; }\n.tuner-sample-credits a:hover { color: var(--text-on-light); }\n.reference-loading .tuner-peg.is-active { animation: tuner-sample-loading var(--tuner-loading-duration) ease-in-o