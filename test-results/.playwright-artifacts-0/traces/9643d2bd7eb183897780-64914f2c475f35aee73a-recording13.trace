"dark\"] .toast-text-content {\r\n  color: var(--text-card-primary) !important;\r\n}\r\n\r\n[data-theme=\"dark\"] .toast-close-btn {\r\n  color: var(--text-card-primary) !important;\r\n}\r\n\r\n[data-theme=\"dark\"] .toast-progress-bar {\r\n  background: var(--accent-neon-yellow) !important;\r\n}\r\n\r\n/* ==========================================================================\r\n   5. Suggest Improvement / Feedback Modal Icons & Badges\r\n   ========================================================================== */\r\n[data-theme=\"dark\"] .input-left-icon {\r\n  color: var(--text-card-primary) !important;\r\n}\r\n\r\n[data-theme=\"dark\"] .category-chip i {\r\n  color: var(--text-card-primary) !important;\r\n}\r\n\r\n[data-theme=\"dark\"] .category-chip:hover i,\r\n[data-theme=\"dark\"] .category-chip.active i {\r\n  color: #000000 !important;\r\n}\r\n\r\n[data-theme=\"dark\"] .type-pill-btn i {\r\n  color: var(--text-card-primary) !important;\r\n}\r\n\r\n[data-theme=\"dark\"] .type-pill-btn:hover i,\r\n[data-theme=\"dark\"] .type-pill-btn.active i {\r\n  color: #000000 !important;\r\n}\r\n\r\n[data-theme=\"dark\"] .category-chip.active {\r\n  background: var(--accent-neon-yellow) !important;\r\n  color: #000000 !important;\r\n}\r\n\r\n[data-theme=\"dark\"] .category-chip.active span,\r\n[data-theme=\"dark\"] .type-pill-btn.active span {\r\n  color: #000000 !important;\r\n}\r\n\r\n[data-theme=\"dark\"] .type-pill-btn.active {\r\n  background: var(--accent-neon-yellow) !important;\r\n  color: #000000 !important;\r\n}\r\n\r\n[data-theme=\"dark\"] .type-pill-btn[data-type=\"Bug / Broken Item\"].active {\r\n  background: #fca5a5 !important;\r\n  color: #000000 !important;\r\n}\r\n\r\n[data-theme=\"dark\"] .type-pill-btn[data-type=\"Content Fix / Typo\"].active {\r\n  background: #93c5fd !important;\r\n  color: #000000 !important;\r\n}\r\n\r\n/* ==========================================================================\r\n   6. EPK Global Branding & Logo Rules (Zero-Unstyled Protection)\r\n   ========================================================================== */\r\n.epk-nav-logo-img {\r\n  height: 24px !important;\r\n  width: auto !important;\r\n  max-width: 80px !important;\r\n  object-fit: contain !important;\r\n  display: block !important;\r\n}\r\n\r\n.epk-hero-center-logo {\r\n  height: 36px !important;\r\n  width: auto !important;\r\n  max-width: 120px !important;\r\n  object-fit: contain !important;\r\n  display: block !important;\r\n}\r\n\r\n.drawer-logo-img {\r\n  height: 22px !important;\r\n  width: auto !important;\r\n  max-width: 75px !important;\r\n  object-fit: contain !important;\r\n  display: block !important;\r\n}\r\n\r\n/* ==========================================================================\r\n   7. Strict Mobile Horizontal Overflow Elimination\r\n   ========================================================================== */\r\nhtml, body {\r\n  width: 100% !important;\r\n  max-width: 100% !important;\r\n  overflow-x: hidden !important;\r\n  position: relative !important;\r\n}\r\n\r\n.app-wrapper,\r\n.epk-app-wrapper,\r\n.site-container,\r\n.epk-main-content {\r\n  width: 100% !important;\r\n  max-width: 100% !important;\r\n  overflow-x: hidden !important;\r\n  box-sizing: border-box !important;\r\n}\r\n\r\n/* Ensure mobile swipe wrappers remain horizontally scrollable without overflowing page */\r\n.artist-filter-scroll-container,\r\n.epk-video-grid-wrapper,\r\n.epk-photos-grid-wrapper,\r\n.epk-tour-table-wrapper {\r\n  overflow-x: auto !important;\r\n  max-width: 100% !important;\r\n  box-sizing: border-box !important;\r\n}\r\n\r\n\r\n\r\n\r\n\r\n"],"\n",["STYLE",{},".page-preloader-overlay[data-astro-cid-jgey6aqf]{position:fixed;inset:0;z-index:99999;pointer-events:auto;overflow:hidden;visibility:visible;opacity:1;transition:opacity 0.28s var(--ease-snappy),visibility 0.28s ease}.preloader-curtain[data-astro-cid-jgey6aqf]{width:100%;height:100%;background:radial-gradient(circle at 50% 30%,