line-flex;align-items:center;gap:8px;background:#1c1c20;border:2px solid #000000;box-shadow:2px 2px 0px #000000;padding:7px 12px;border-radius:6px;width:fit-content;color:var(--accent-neon-yellow);margin-top:4px}.legal-link[data-astro-cid-plzmpoju]{color:var(--accent-neon-yellow);font-weight:800;text-decoration:underline;transition:color 0.16s ease}.legal-link[data-astro-cid-plzmpoju]:hover{color:#ffffff}.legal-modal-footer[data-astro-cid-plzmpoju]{padding:12px 16px;background:#1c1c20;border-top:3px solid #000000;display:flex;justify-content:flex-end}.legal-footer-close-btn[data-astro-cid-plzmpoju]{background:var(--accent-neon-yellow);color:#000000;font-family:var(--font-secondary);font-size:0.8rem;font-weight:900;letter-spacing:0.04em;text-transform:uppercase;padding:8px 18px;border-radius:6px;border:2.5px solid #000000;box-shadow:2px 2px 0px #000000;cursor:pointer;transition:transform 0.16s var(--ease-tactile),box-shadow 0.16s ease,background-color 0.16s ease}.legal-footer-close-btn[data-astro-cid-plzmpoju]:hover{transform:translate(-1px,-1px);box-shadow:3px 3px 0px #000000;background:#ffffff}@media (max-width: 480px){.legal-tab-btn[data-astro-cid-plzmpoju]{font-size:0.72rem;padding:6px 8px}}@media (max-width: 640px){.modal-backdrop[data-astro-cid-plzmpoju]{align-items:flex-end;padding:0}.legal-modal-container[data-astro-cid-plzmpoju]{max-width:100%;max-height:94vh;max-height:94dvh;border-radius:14px 14px 0 0;border-bottom:none;box-shadow:0 -4px 0px #000000;animation:legalSheetSlideUp 0.3s cubic-bezier(0.16,1,0.3,1)}.legal-modal-container[data-astro-cid-plzmpoju].is-closing{animation:legalSheetSlideDown 0.22s ease forwards}.legal-modal-header[data-astro-cid-plzmpoju]{border-radius:14px 14px 0 0}@keyframes legalSheetSlideUp{from{transform:translateY(100%);opacity:0}to{transform:translateY(0);opacity:1}}@keyframes legalSheetSlideDown{from{transform:translateY(0);opacity:1}to{transform:translateY(100%);opacity:0}}}"],"\n",["STYLE",{},"/* KINS Metronome — Coach Deck runtime (must be global: created via JS, no data-astro-cid) */\r\n  .metro-coach-card {\r\n    display: flex; flex-direction: column; gap: 12px; width: 100%;\r\n    background: #1e1e24; border: 2px solid #000; box-shadow: 3px 3px 0 #000;\r\n    border-radius: var(--radius-md); padding: 14px 12px; box-sizing: border-box;\r\n    text-align: left; align-items: stretch;\r\n  }\r\n  .metro-coach-card--dark { background: #141418; }\r\n  .metro-coach-head { display: flex; flex-direction: column; gap: 4px; }\r\n  .metro-coach-card-title { margin:0; font-family: var(--font-heading); font-size:1.05rem; font-weight:800; letter-spacing:0.02em; color:#f5f5f7; }\r\n  .metro-coach-card-blurb { margin:0; font-family: var(--font-secondary); font-size:0.78rem; color:#a1a1aa; line-height:1.35; }\r\n  .metro-coach-cycle {\r\n    display:flex; align-items:center; justify-content:center; gap:6px;\r\n    background:#0f0f12; border:2px solid #000; border-radius:var(--radius-pill);\r\n    padding:8px 10px; font-family:var(--font-secondary); font-size:0.72rem; font-weight:800;\r\n    letter-spacing:0.08em; text-transform:uppercase; color:#f5f5f7; flex-wrap:wrap;\r\n  }\r\n  .metro-coach-cycle strong { color:var(--accent-neon-yellow); font-weight:900; letter-spacing:0.04em; }\r\n  .metro-cycle-chip {\r\n    display:inline-flex; align-items:center; justify-content:center;\r\n    min-width:26px; height:26px; padding:0 6px;\r\n    background:#2a2a30; color:#f5f5f7; border:1px solid #000; border-radius:var(--radius-sm);\r\n    font-size:0.72rem; font-weight:800;\r\n  }\r\n  .metro-cycle-chip.audible { background:#f5f5f7; color:#000; }\r\n  .metro-cycle-chip.muted { background:var(--accent-neon-yellow); color:#000; }\r\n  .metro-coach-field { display:flex; flex-direction:column; gap:6px; min-width: 0; }\r\n  .metro-coach-field-label {\r\n    display:flex; align-items:center; justify-content:space-between; gap:4px;\r\n    font-family:var(--font-secondary); font-size:0.72rem; font-weight:800;\r\n    letter-spacing:0.04em; text-transform:uppercase; color:#a1a1aa;\r\n    white-space: nowrap; min-width: 0;\r\n  }\r\n  .metro-coach-field-label span {\r\n    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0;\r\n  }\r\n  .metro-coach-field-label strong {\r\n    color:var(--accent-neon-yellow); font-variant-numeric:tabular-nums; white-space: nowrap; flex-shrink: 0;\r\n  }\r\n  .metro-coach-clickable-val {\r\n    cursor: pointer;\r\n    border-bottom: 1px dashed rgba(216, 178, 68, 0.6);\r\n    padding: 1px 3px;\r\n    border-radius: 3px;\r\n    transition: background-color 0.14s ease, border-color 0.14s ease, color 0.14s ease;\r\n  }\r\n  .metro-coach-clickable-val:hover,\r\n  .metro-coach-clickable-val:focus-visible {\r\n    background: rgba(216, 178, 68, 0.18);\r\n    border-bottom-color: var(--accent-neon-yellow);\r\n    color: #ffffff;\r\n    outline: none;\r\n  }\r\n  .metro-coach-inline-num {\r\n    width: 54px;\r\n    padding: 1px 3px;\r\n    font-family: var(--font-secondary);\r\n    font-size: 0.72rem;\r\n    font-weight: 800;\r\n    color: #000000;\r\n    background: var(--accent-neon-yellow);\r\n    border: 1px solid #000000;\r\n    border-radius: 3px;\r\n    outline: none;\r\n    text-align: center;\r\n    box-sizing: border-box;\r\n    -moz-appearance: textfield;\r\n  }\r\n  .metro-coach-inline-num::-webkit-outer-spin-button,\r\n  .metro-coach-inline-num::-webkit-inner-spin-button {\r\n    -webkit-appearance: none;\r\n    margin: 0;\r\n  }\r\n  .metro-coach-slider-wrap {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n    background: #0f0f12;\r\n    border: 2px solid #000000;\r\n    box-shadow: 2px 2px 0px #000000;\r\n    border-radius: var(--radius-md);\r\n    padding: 6px 8px;\r\n    box-sizing: border-box;\r\n    width: 100%;\r\n  }\r\n  .metro-coach-track-box {\r\n    flex: 1 1 auto;\r\n    display: flex;\r\n    align-items: center;\r\n    min-width: 0;\r\n    position: relative;\r\n    padding: 4px 2px;\r\n  }\r\n  .metro-coach-step-btn {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    width: 32px;\r\n    height: 32px;\r\n    flex-shrink: 0;\r\n    background: #1e1e24;\r\n    color: var(--accent-neon-yellow);\r\n    border: 2px solid #000000;\r\n    box-shadow: 1px 1px 0px #000000;\r\n    border-radius: var(--radius-sm);\r\n    font-size: 0.76rem;\r\n    font-weight: 800;\r\n    cursor: pointer;\r\n    touch-action: manipulation;\r\n    user-select: none;\r\n    -webkit-tap-highlight-color: transparent;\r\n    transition: transform 0.12s var(--ease-tactile), box-shadow 0.12s ease, background-color 0.12s ease, color 0.12s ease;\r\n  }\r\n  .metro-coach-step-btn:hover {\r\n    background: #282832;\r\n    color: var(--btn-green-hover);\r\n    transform: translate(-1px, -1px);\r\n    box-shadow: 2px 2px 0px #000000;\r\n  }\r\n  .metro-coach-step-btn:active {\r\n    transform: translate(1px, 1px);\r\n    box-shadow: 0px 0px 0px #000000;\r\n    background: var(--accent-neon-yellow);\r\n    color: #000000;\r\n  }\r\n  .metro-coach-step-btn:focus-visible {\r\n    outline: 2px solid var(--accent-neon-yellow);\r\n    outline-offset: 2px;\r\n  }\r\n  .metro-coach-range {\r\n    -webkit-appearance: none;\r\n    appearance: none;\r\n    width: 100%;\r\n    height: 8px;\r\n    border-radius: 999px;\r\n    background: linear-gradient(to right, var(--accent-neon-yellow) 0%, var(--accent-neon-yellow) var(--pct, 50%), #2a2a30 var(--pct, 50%), #2a2a30 100%);\r\n    border: 1px solid #000000;\r\n    outline: none;\r\n    cursor: pointer;\r\n    touch-action: pan-y;\r\n    margin: 0;\r\n  }\r\n  .metro-coach-range::-webkit-slider-thumb {\r\n    -webkit-appearance: none;\r\n    appearance: none;\r\n    width: 22px;\r\n    height: 22px;\r\n    border-radius: 50%;\r\n    background: var(--accent-neon-yellow);\r\n    border: 2px solid #000000;\r\n    box-shadow: 2px 2px 0px #000000;\r\n    cursor: grab;\r\n    transition: transform 0.12s var(--ease-tactile), background-color 0.12s ease;\r\n  }\r\n  .metro-coach-range::-webkit-slider-thumb:hover {\r\n    transform: scale(1.15);\r\n    background: #FFE082;\r\n  }\r\n  .metro-coach-range::-webkit-slider-thumb:active {\r\n    cursor: grabbing;\r\n    transform: scale(1.22);\r\n    background: #FFFFFF;\r\n  }\r\n  .metro-coach-range::-moz-range-thumb {\r\n    width: 22px;\r\n    height: 22px;\r\n    border-radius: 50%;\r\n    background: var(--accent-neon-yellow);\r\n    border: 2px solid #000000;\r\n    box-shadow: 2px 2px 0px #000000;\r\n    cursor: grab;\r\n  }\r\n  .metro-coach-range::-moz-range-progress {\r\n    background: var(--accent-neon-yellow);\r\n    border-radius: 999px;\r\n    height: 8px;\r\n  }\r\n  .metro-coach-range::-moz-range-track {\r\n    background: #2a2a30;\r\n    border-radius: 999px;\r\n    height: 8px;\r\n  }\r\n  .metro-coach-slider-wrap--clean {\r\n    padding: 8px 10px;\r\n  }\r\n  #coachInnerAudible::-webkit-slider-thumb { background: #f5f5f7; }\r\n  #coachInnerAudible::-moz-range-thumb { background: #f5f5f7; }\r\n  #coachInnerAudible {\r\n    background: linear-gradient(to right, #f5f5f7 0%, #f5f5f7 var(--pct, 25%), #2a2a30 var(--pct, 25%), #2a2a30 100%);\r\n  }\r\n  #coachInnerMuted::-webkit-slider-thumb { background: var(--accent-neon-yellow); }\r\n  #coachInnerMuted::-moz-range-thumb { background: var(--accent-neon-yellow); }\r\n  #coachInnerMuted {\r\n    background: linear-gradient(to right, var(--accent-neon-yellow) 0%, var(--accent-neon-yellow) var(--pct, 25%), #2a2a30 var(--pct, 25%), #2a2a30 100%);\r\n  }\r\n  #coachSpeedStart::-webkit-slider-thumb { background: var(--btn-green-hover); }\r\n  #coachSpeedStart::-moz-range-thumb { background: var(--btn-green-hover); }\r\n  #coachSpeedStart {\r\n    background: linear-gradient(to right, var(--btn-green-hover) 0%, var(--btn-green-hover) var(--pct, 33%), #2a2a30 var(--pct, 33%), #2a2a30 100%);\r\n  }\r\n  #coachSpeedTarget::-webkit-slider-thumb { background: var(--accent-neon-yellow); }\r\n  #coachSpeedTarget::-moz-range-thumb { background: var(--accent-neon-yellow); }\r\n  #coachSpeedTarget {\r\n    background: linear-gradient(to right, var(--accent-neon-yellow) 0%, var(--accent-neon-yellow) var(--pct, 55%), #2a2a30 var(--pct, 55%), #2a2a30 100%);\r\n  }\r\n  #coachSpeedStep::-webkit-slider-thumb { background: var(--accent-neon-yellow); }\r\n  #coachSpeedStep::-moz-range-thumb { background: var(--accent-neon-yellow); }\r\n  #coachSpeedStep {\r\n    background: linear-gradient(to right, var(--accent-neon-yellow) 0%, var(--accent-neon-yellow) var(--pct, 20%), #2a2a30 var(--pct, 20%), #2a2a30 100%);\r\n  }\r\n  #coachSpeedEvery::-webkit-slider-thumb { background: #f5f5f7; }\r\n  #coachSpeedEvery::-moz-range-thumb { background: #f5f5f7; }\r\n  #coachSpeedEvery {\r\n    background: linear-gradient(to right, #f5f5f7 0%, #f5f5f7 var(--pct, 12%), #2a2a30 var(--pct, 12%), #2a2a30 100%);\r\n  }\r\n  .metro-coach-two-col {\r\n    display: grid;\r\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\r\n    gap: 10px;\r\n    width: 100%;\r\n    box-sizing: border-box;\r\n  }\r\n  .metro-coach-two-col .metro-coach-field {\r\n    min-width: 0;\r\n    overflow: hidden;\r\n  }\r\n  .metro-coach-row-split {\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    gap: 10px;\r\n    width: 100%;\r\n    box-sizing: border-box;\r\n    margin-top: 2px;\r\n    flex-wrap: wrap;\r\n  }\r\n  /* Speed Trainer full-width unit toggle + 50/50 repeat/direction actions row */\r\n  .metro-coach-unit-row {\r\n    display: flex;\r\n    width: 100%;\r\n    box-sizing: border-box;\r\n    margin-top: 2px;\r\n  }\r\n  .metro-coach-actions-row {\r\n    display: grid;\r\n    grid-template-columns: 1fr 1fr;\r\n    gap: 10px;\r\n    width: 100%;\r\n    box-sizing: border-box;\r\n    margin-top: 2px;\r\n  }\r\n  .metro-coach-actions-row .metro-coach-toggle-btn {\r\n    width: 100% !important;\r\n    max-width: none !important;\r\n    flex: 1 1 auto !important;\r\n  }\r\n  .metro-unit-toggle {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    background: #0f0f12;\r\n    border: 2px solid #000000;\r\n    box-shadow: 2px 2px 0px #000000;\r\n    border-radius: var(--radius-pill);\r\n    padding: 2px;\r\n    gap: 2px;\r\n    flex-shrink: 0;\r\n  }\r\n  .metro-unit-toggle--full {\r\n    display: flex !important;\r\n    width: 100% !important;\r\n    flex: 1 1 auto !important;\r\n    box-sizing: border-box;\r\n  }\r\n  .metro-unit-toggle--full .metro-unit-btn {\r\n    flex: 1 1 0 !important;\r\n    min-width: 0;\r\n    justify-content: center;\r\n    text-align: center;\r\n  }\r\n  .metro-unit-btn {\r\n    padding: 6px 10px;\r\n    background: transparent;\r\n    color: #a1a1aa;\r\n    border: none;\r\n    border-radius: var(--radius-pill);\r\n    font-family: var(--font-secondary);\r\n    font-size: 0.70rem;\r\n    font-weight: 800;\r\n    letter-spacing: 0.06em;\r\n    cursor: pointer;\r\n    touch-action: manipulation;\r\n    transition: background-color 0.14s ease, color 0.14s ease, transform 0.14s var(--ease-tactile);\r\n  }\r\n  .metro-unit-btn:hover {\r\n    color: #f5f5f7;\r\n  }\r\n  .metro-unit-btn.active {\r\n    background: var(--accent-neon-yellow);\r\n    color: #000000;\r\n    font-weight: 900;\r\n  }\r\n  @media (max-width: 380px) {\r\n    .metro-coach-two-col { gap: 6px; }\r\n    .metro-coach-step-btn { width: 28px; height: 28px; font-size: 0.7rem; }\r\n    .metro-coach-slider-wrap { padding: 4px 6px; gap: 6px; }\r\n    .metro-unit-btn { padding: 4px 6px; font-size: 0.62rem; letter-spacing: 0.02em; }\r\n  }\r\n  .metro-coach-pill-row { display:flex; gap:8px; flex-wrap:wrap; }\r\n  .metro-coach-pill-row.mono { flex-wrap: nowrap; overflow-x: auto; overflow-y: hidden; -webkit-overflow-scrolling: touch; padding: 4px 2px 8px; }\r\n  .metro-coach-preset-row {\r\n    display: flex;\r\n    flex-wrap: nowrap;\r\n    overflow-x: auto;\r\n    overflow-y: hidden;\r\n    gap: 8px;\r\n    padding: 4px 2px 8px;\r\n    scroll-behavior: smooth;\r\n    -webkit-overflow-scrolling: touch;\r\n    scrollbar-width: none;\r\n    -ms-overflow-style: none;\r\n  }\r\n  .metro-coach-preset-row::-webkit-scrollbar {\r\n    display: none;\r\n  }\r\n  .metro-coach-preset-row .metro-coach-mini-chip {\r\n    flex: 0 0 auto;\r\n    min-width: auto;\r\n    min-height: auto;\r\n    white-space: nowrap;\r\n    padding: 7px 14px;\r\n    font-size: 0.76rem;\r\n  }\r\n  .metro-coach-toggle-btn {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    gap: 8px;\r\n    width: 100%;\r\n    padding: 10px 14px;\r\n    background: #1e1e24;\r\n    color: #a1a1aa;\r\n    border: 2px solid #000000;\r\n    box-shadow: 2px 2px 0px #000000;\r\n    border-radius: var(--radius-md);\r\n    font-family: var(--font-secondary);\r\n    font-size: 0.76rem;\r\n    font-weight: 800;\r\n    letter-spacing: 0.08em;\r\n    text-transform: uppercase;\r\n    cursor: pointer;\r\n    touch-action: manipulation;\r\n    -webkit-tap-highlight-color: transparent;\r\n    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;\r\n  }\r\n  .metro-coach-toggle-btn i {\r\n    font-size: 0.95rem;\r\n    line-height: 1;\r\n  }\r\n  .metro-coach-toggle-btn:hover {\r\n    transform: translate(-1px, -1px);\r\n    box-shadow: 3px 3px 0px #000000;\r\n    color: #f5f5f7;\r\n    background: #25252e;\r\n  }\r\n  .metro-coach-toggle-btn.active {\r\n    background: var(--accent-neon-yellow);\r\n    color: #000000;\r\n    border-color: #000000;\r\n  }\r\n  .metro-coach-toggle-btn:focus-visible {\r\n    outline: 2px solid var(--accent-neon-yellow);\r\n    outline-offset: 2px;\r\n  }\r\n  .metro-coach-mini-chip {\r\n    display:inline-flex; align-items:center; justify-content:center;\r\n    flex: 0 0 auto;\r\n    min-width: 64px;\r\n    min-height: 36px;\r\n    padding:8px 12px; background:#0f0f12; color:#f5f5f7;\r\n    border:2px solid #000; box-shadow:2px 2px 0 #000; border-radius:var(--radius-pill);\r\n    font-family:var(--font-secondary); font-size:0.78rem; font-weight:800; cursor:pointer;\r\n    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;\r\n  }\r\n  .metro-coach-mini-chip.active { background:var(--accent-neon-yellow); color:#000; }\r\n  .metro-coach-mini-chip:hover { transform: translate(-1px,-1px); box-shadow:3px 3px 0 #000; }\r\n  .metro-coach-diff-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; }\r\n  .metro-coach-diff-btn {\r\n    display:flex; flex-direction:column; gap:2px; padding:10px 8px;\r\n    background:#0f0f12; color:#a1a1aa; border:2px solid #000; box-shadow:2px 2px 0 #000;\r\n    border-radius:var(--radius-md); cursor:pointer; text-align:left;\r\n    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, border-color 0.16s ease;\r\n  }\r\n  .metro-coach-diff-btn.active { background:var(--accent-neon-yellow); color:#000; border-color:#000; }\r\n  .metro-coach-diff-btn-title { font-family:var(--font-secondary); font-size:0.82rem; font-weight:800; }\r\n  .metro-coach-diff-btn-sub { font-family:var(--font-secondary); font-size:0.62rem; font-weight:700; opacity:0.8; }\r\n  .metro-coach-tap-area {\r\n    display:flex; flex-direction:column; gap:6px; padding:14px 12px;\r\n    background:#0f0f12; border:2px solid var(--accent-neon-yellow); border-radius:var(--radius-md);\r\n    cursor:pointer; user-select:none; text-align:center;\r\n  }\r\n  .metro-coach-tap-title { font-family:var(--font-secondary); font-size:0.82rem; font-weight:800; letter-spacing:0.08em; color:#f5f5f7; }\r\n  .metro-coach-tap-sub { font-family:var(--font-secondary); font-size:0.72rem; color:var(--accent-neon-yellow); }\r\n  .metro-coach-target-card {\r\n    display:flex; flex-direction:column; align-items:center; gap:6px;\r\n    padding:14px 12px; background:#0f0f12; border:2px solid #000; border-radius:var(--radius-md);\r\n  }\r\n  .metro-coach-target-label { font-family:var(--font-secondary); font-size:0.68rem; font-weight:800; letter-spacing:0.14em; color:#a1a1aa; }\r\n  .metro-coach-target-bpm { font-family:var(--font-heading); font-size:2.2rem; font-weight:800; color:var(--accent-neon-yellow); line-height:1; font-variant-numeric:tabular-nums; }\r\n  .metro-coach-target-bpm small { font-size:0.72rem; letter-spacing:0.1em; color:#a1a1aa; margin-left:4px; }\r\n  .metro-coach-dots { display:flex; gap:8px; align-items:center; justify-content:center; }\r\n  .metro-coach-dots span { width:10px; height:10px; border-radius:50%; background:#2a2a30; border:1px solid #000; transition: background-color 0.12s ease, transform 0.12s ease; }\r\n  .metro-coach-dots span.filled { background:var(--accent-neon-yellow); transform:scale(1.15); }\r\n  .metro-coach-cta {\r\n    display:inline-flex; align-items:center; justify-content:center; gap:8px;\r\n    width:100%; padding:14px 16px; background:var(--accent-neon-yellow); color:#000;\r\n    border:3px solid #000; box-shadow:4px 4px 0 #000; border-radius:var(--radius-pill);\r\n    font-family:var(--font-secondary); font-size:0.9rem; font-weight:900; letter-spacing:0.08em;\r\n    cursor:pointer; transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease;\r\n  }\r\n  .metro-coach-cta:hover { transform: translate(-1px,-1px); box-shadow:5px 5px 0 #000; background:var(--btn-green-hover); }\r\n  .metro-coach-cta:active { transform: translate(1px,1px); box-shadow:1px 1px 0 #000; }\r\n  .metro-coach-live { display:flex; flex-direction:column; gap:12px; }\r\n  .metro-coach-live-card {\r\n    background:#0f0f12; border:2px solid #000; border-left:4px solid var(--accent-neon-yellow);\r\n    box-shadow:3px 3px 0 #000; border-radius:var(--radius-md);\r\n    padding:14px 12px; display:flex; flex-direction:column; gap:10px;\r\n  }\r\n  .metro-coach-live-head { display:flex; align-items:center; justify-content:space-between; gap:8px; }\r\n  .metro-coach-live-badge {\r\n    display:inline-flex; align-items:center; gap:6px;\r\n    font-family:var(--font-secondary); font-size:0.68rem; font-weight:800; letter-spacing:0.12em;\r\n    background:var(--accent-neon-yellow); color:#000; padding:3px 8px; border-radius:var(--radius-pill); border:1px solid #000;\r\n  }\r\n  .metro-coach-live-phase { font-family:var(--font-heading); font-size:1.4rem; font-weight:800; color:#f5f5f7; line-height:1; }\r\n  .metro-coach-live-phase.muted { color:var(--accent-neon-yellow); }\r\n  .metro-coach-live-sub { font-family:var(--font-secondary); font-size:0.76rem; color:#a1a1aa; }\r\n  .metro-coach-progress { height:8px; background:#1e1e24; border:1px solid #000; border-radius:999px; overflow:hidden; }\r\n  .metro-coach-progress-fill { height:100%; background:var(--accent-neon-yellow); transform-origin:left center; will-change:transform; }\r\n  .metro-coach-live-split {\r\n    display:flex; gap:0; width:100%;\r\n    background:var(--accent-neon-yellow); border:3px solid #000; box-shadow:4px 4px 0 #000; border-radius:var(--radius-pill); overflow:hidden;\r\n  }\r\n  /* ---------- Dynamic Island Live Dock (Pill button takeover) ---------- */\r\n  .metro-coach-live-dock {\r\n    width: 100%;\r\n    margin-top: 12px;\r\n    display: flex;\r\n    animation: coachPillIn 0.22s var(--ease-snappy);\r\n  }\r\n\r\n  .metro-coach-live-dock[hidden] {\r\n    display: none !important;\r\n  }\r\n\r\n  @keyframes coachPillIn {\r\n    0% {\r\n      opacity: 0;\r\n      transform: scale(0.96);\r\n    }\r\n    100% {\r\n      opacity: 1;\r\n      transform: scale(1);\r\n    }\r\n  }\r\n\r\n  .metro-coach-pill-bar {\r\n    position: relative;\r\n    width: 100%;\r\n    min-height: 54px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    gap: 8px;\r\n    padding: 6px 8px 6px 14px;\r\n    background: #0f0f12;\r\n    border: 3px solid #000000;\r\n    box-shadow: 3px 3px 0px #000000;\r\n    border-radius: var(--radius-pill);\r\n    overflow: hidden;\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  .metro-coach-pill-prog {\r\n    position: absolute;\r\n    left: 0;\r\n    bottom: 0;\r\n    width: 100%;\r\n    height: 3px;\r\n    background: rgba(255, 255, 255, 0.08);\r\n    pointer-events: none;\r\n  }\r\n\r\n  .metro-coach-pill-prog-fill {\r\n    height: 100%;\r\n    width: 100%;\r\n    background: var(--accent-neon-yellow);\r\n    transform-origin: left center;\r\n    transform: scaleX(0);\r\n    will-change: transform;\r\n    transition: transform 0.1s linear;\r\n  }\r\n\r\n  .metro-coach-pill-info {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n    min-width: 0;\r\n    flex: 1 1 auto;\r\n    overflow: hidden;\r\n  }\r\n\r\n  .metro-coach-pill-dot {\r\n    width: 8px;\r\n    height: 8px;\r\n    border-radius: 50%;\r\n    background: #ef4444;\r\n    box-shadow: 0 0 6px rgba(239, 68, 68, 0.75);\r\n    flex-shrink: 0;\r\n    animation: midiPulse 1s infinite alternate;\r\n  }\r\n\r\n  .metro-coach-pill-tag {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n    font-family: var(--font-secondary);\r\n    font-size: 0.78rem;\r\n    font-weight: 700;\r\n    letter-spacing: 0.04em;\r\n    color: #f5f5f7;\r\n    white-space: nowrap;\r\n    overflow: hidden;\r\n    text-overflow: ellipsis;\r\n    min-width: 0;\r\n  }\r\n\r\n  .metro-coach-pill-bold {\r\n    font-weight: 800;\r\n    color: #ffffff;\r\n    letter-spacing: 0.04em;\r\n  }\r\n\r\n  .metro-coach-phase-badge {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    padding: 2px 7px;\r\n    border-radius: var(--radius-pill);\r\n    font-family: var(--font-secondary);\r\n    font-size: 0.66rem;\r\n    font-weight: 900;\r\n    letter-spacing: 0.06em;\r\n    text-transform: uppercase;\r\n    flex-shrink: 0;\r\n  }\r\n\r\n  .metro-coach-phase-badge.muted {\r\n    background: var(--accent-neon-yellow);\r\n    color: #000000;\r\n  }\r\n\r\n  .metro-coach-phase-badge.audible {\r\n    background: #22c55e;\r\n    color: #000000;\r\n  }\r\n\r\n  .metro-coach-grade-badge {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    padding: 2px 7px;\r\n    border-radius: var(--radius-pill);\r\n    background: var(--accent-neon-yellow);\r\n    color: #000000;\r\n    font-family: var(--font-secondary);\r\n    font-size: 0.66rem;\r\n    font-weight: 900;\r\n    letter-spacing: 0.06em;\r\n    text-transform: uppercase;\r\n    flex-shrink: 0;\r\n  }\r\n\r\n  .metro-coach-pill-sub {\r\n    color: #a1a1aa;\r\n    font-size: 0.72rem;\r\n    font-weight: 600;\r\n    white-space: nowrap;\r\n  }\r\n\r\n  .metro-coach-pill-actions {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n    flex-shrink: 0;\r\n  }\r\n\r\n  .metro-coach-pill-stop {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n    padding: 8px 14px;\r\n    background: #c0392b;\r\n    color: #ffffff;\r\n    border: 2px solid #000000;\r\n    box-shadow: 2px 2px 0px #000000;\r\n    border-radius: var(--radius-pill);\r\n    font-family: var(--font-secondary);\r\n    font-size: 0.76rem;\r\n    font-weight: 900;\r\n    letter-spacing: 0.08em;\r\n    cursor: pointer;\r\n    white-space: nowrap;\r\n    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, box-shadow 0.16s ease;\r\n  }\r\n\r\n  .metro-coach-pill-stop:hover {\r\n    background: #d64536;\r\n    transform: translate(-1px, -1px);\r\n    box-shadow: 3px 3px 0px #000000;\r\n  }\r\n\r\n  .metro-coach-pill-stop:active {\r\n    transform: translate(1px, 1px);\r\n    box-shadow: 1px 1px 0px #000000;\r\n  }\r\n\r\n  .metro-coach-pill-retry {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 5px;\r\n    padding: 7px 10px;\r\n    background: #1e1e24;\r\n    color: var(--accent-neon-yellow);\r\n    border: 2px solid #000000;\r\n    box-shadow: 2px 2px 0px #000000;\r\n    border-radius: var(--radius-pill);\r\n    font-family: var(--font-secondary);\r\n    font-size: 0.72rem;\r\n    font-weight: 800;\r\n    letter-spacing: 0.06em;\r\n    cursor: pointer;\r\n    white-space: nowrap;\r\n    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;\r\n  }\r\n\r\n  .metro-coach-pill-retry:hover {\r\n    background: #2a2a34;\r\n    color: #ffffff;\r\n  }\r\n\r\n  .metro-coach-pill-expand {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    width: 36px;\r\n    height: 36px;\r\n    background: #1e1e24;\r\n    color: var(--accent-neon-yellow);\r\n    border: 2px solid #000000;\r\n    box-shadow: 2px 2px 0px #000000;\r\n    border-radius: var(--radius-pill);\r\n    cursor: pointer;\r\n    font-size: 0.85rem;\r\n    flex-shrink: 0;\r\n    transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease, color 0.16s ease;\r\n  }\r\n\r\n  .metro-coach-pill-expand:hover {\r\n    background: #2a2a34;\r\n    color: #ffffff;\r\n    transform: translate(-1px, -1px);\r\n  }\r\n\r\n  .metro-coach-pill-expand:active {\r\n    transform: translate(1px, 1px);\r\n  }\r\n\r\n  @media (max-width: 400px) {\r\n    .metro-coach-pill-bar {\r\n      padding: 4px 4px 4px 10px;\r\n      gap: 6px;\r\n    }\r\n    .metro-coach-pill-sub {\r\n      display: none;\r\n    }\r\n    .metro-coach-pill-stop span {\r\n      display: none;\r\n    }\r\n    .metro-coach-pill-stop {\r\n      padding: 8px 10px;\r\n    }\r\n  }\r\n  .metro-midi-card {\r\n    background:#1e1e24; border:2px solid #000; box-shadow:2px 2px 0 #000; border-radius:var(--radius-md);\r\n    padding:12px 12px 10px; display:flex; flex-direction:column; gap:10px;\r\n  }\r\n  .metro-midi-status-row { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }\r\n  .metro-midi-dot { width:10px; height:10px; border-radius:50%; background:#71717a; border:1px solid #000; flex-shrink:0; transition: background-color 0.16s ease; }\r\n  .metro-midi-dot.connected { background:#22c55e; box-shadow:0 0 8px rgba(34,197,94,0.45); }\r\n  .metro-midi-dot.connecting { background:var(--accent-neon-yellow); animation: midiPulse 1s infinite alternate; }\r\n  @keyframes midiPulse { from { opacity:0.55; } to { opacity:1; } }\r\n  .metro-midi-status-text { font-family:var(--font-secondary); font-size:0.82rem; font-weight:800; letter-spacing:0.06em; text-transform:uppercase; color:#f5f5f7; }\r\n  .metro-midi-support-badge { font-family:var(--font-secondary); font-size:0.62rem; font-weight:800; letter-spacing:0.08em; text-transform:uppercase; background:#c0392b; color:#fff; padding:2px 6px; border-radius:var(--radius-pill); border:1px solid #000; }\r\n  .metro-midi-device-name { margin:0; font-family:var(--font-secondary); font-size:0.78rem; color:#a1a1aa; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\r\n  .metro-midi-actions { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }\r\n  .metro-midi-btn {\r\n    display:inline-flex; align-items:center; gap:8px; padding:10px 14px;\r\n    background:var(--accent-neon-yellow); color:#000; border:2px solid #000; box-shadow:2px 2px 0 #000; border-radius:var(--radius-pill);\r\n    font-family:var(--font-secondary); font-size:0.78rem; font-weight:800; letter-spacing:0.08em; text-transform:uppercase;\r\n    cursor:pointer; transition: transform 0.16s var(--ease-tactile), box-shadow 0.16s ease, background-color 0.16s ease;\r\n  }\r\n  .metro-midi-btn:hover { transform: translate(-1px,-1px); box-shadow:3px 3px 0 #000; background:var(--btn-green-hover); }\r\n  .metro-midi-btn.connected { background:#22c55e; }\r\n  .metro-midi-select {\r\n    flex:1 1 160px; min-width:160px;\r\n    background:#0f0f12; color:#f5f5f7; border:2px solid #000; box-shadow:2px 2px 0 #000; border-radius:var(--radius-md);\r\n    padding:9px 10px; font-family:var(--font-secondary); font-size:0.82rem; font-weight:700;\r\n  }\r\n  .metro-midi-hint { margin:0; font-family:var(--font-secondary); font-size:0.72rem; color:#71717a; line-height:1.35; }\r\n  .metro-panel--coach .metro-coach-panel {\r\n    align-items: stretch !important; justify-content:flex-start !important; text-align:left !important;\r\n    padding:6px 0 12px !important; min-height:auto !important;\r\n  }\r\n  /* toggle — must be global: runtime coach cards create it via JS (no data-astro-cid) */\r\n  .metro-toggle { position: relative; display:flex; align-items:center; gap:12px; cursor:pointer; }\r\n  .metro-toggle input { position:absolute; opacity:0; width:100%; height:100%; inset:0; cursor:pointer; z-index:1; margin:0; }\r\n  .metro-toggle-track {\r\n    display:inline-flex; align-items:center; width:46px; height:26px; flex-shrink:0;\r\n    padding:2px; box-sizing:border-box; background:#1e1e24; border:2px solid #000;\r\n    border-radius:999px; transition: background-color 0.16s ease, border-color 0.16s ease;\r\n  }\r\n  .metro-toggle-knob {\r\n    display:inline-block; width:18px; height:18px; background:#71717a; border-radius:50%;\r\n    transform: translateX(0); transition: transform 0.16s var(--ease-tactile), background-color 0.16s ease;\r\n  }\r\n  .metro-toggle input:checked + .metro-toggle-track { background:var(--accent-neon-yellow); border-color:#000; }\r\n  .metro-toggle input:checked + .metro-toggle-track .metro-toggle-knob { transform: translateX(20px); background:#000; }\r\n  .metro-toggle input:focus-visible + .metro-toggle-track { outline:2px solid var(--accent-neon-yellow); outline-offset:2px; }\r\n  .metro-toggle-text { font-family:var(--font-secondary); font-size:0.8rem; font-weight:800; letter-spacing:0.14em; color:#f5f5f7; }\r\n\r\n  /* dual-range — global (runtime) */\r\n  .metro-dual-range {\r\n    position: relative;\r\n    display: block;\r\n    height: 42px;\r\n    background: #0f0f12;\r\n    border: 2px solid #000;\r\n    border-radius: var(--radius-md);\r\n    padding: 0 12px;\r\n    box-sizing: border-box;\r\n  }\r\n  .metro-dual-track {\r\n    position: absolute;\r\n    left: 12px;\r\n    right: 12px;\r\n    top: 50%;\r\n    transform: translateY(-50%);\r\n    height: 8px;\r\n    background: #2a2a30;\r\n    border: 1px solid #000;\r\n    border-radius: 999px;\r\n    pointer-events: none;\r\n  }\r\n  .metro-dual-fill {\r\n    position: absolute;\r\n    top: 50%;\r\n    transform: translateY(-50%);\r\n    height: 8px;\r\n    background: var(--accent-neon-yellow);\r\n    border-radius: 999px;\r\n    pointer-events: none;\r\n  }\r\n  .metro-dual-range input[type=\"range\"] {\r\n    position: absolute;\r\n    left: 12px;\r\n    right: 12px;\r\n    top: 50%;\r\n    transform: translateY(-50%);\r\n    width: calc(100% - 24px);\r\n    height: 8px;\r\n    margin: 0;\r\n    -webkit-appearance: none;\r\n    appearance: none;\r\n    background: transparent;\r\n    pointer-events: none;\r\n    outline: none;\r\n  }\r\n  .metro-dual-range input[type=\"range\"]::-webkit-slider-runnable-track { height:8px; background:transparent; }\r\n  .metro-dual-range input[type=\"range\"]::-webkit-slider-thumb {\r\n    -webkit-appearance:none; width:20px; height:20px; border-radius:50%;\r\n    background:var(--accent-neon-yellow); border:2px solid #000; box-shadow:1px 1px 0 #000; cursor:pointer; pointer-events:auto;\r\n    transition: transform 0.12s var(--ease-tactile), background-color 0.12s ease;\r\n  }\r\n  .metro-dual-range input[type=\"range\"]::-webkit-slider-thumb:hover { transform: scale(1.08); }\r\n  .metro-dual-range input[type=\"range\"]::-moz-range-track { height:8px; background:transparent; border:none; }\r\n  .metro-dual-range input[type=\"range\"]::-moz-range-thumb {\r\n    width:20px; height:20px; border-radius:50%; background:var(--accent-neon-yellow); border:2px solid #000; box-shadow:1px 1px 0 #000; cursor:pointer; pointer-events:auto;\r\n  }\r\n  #coachInnerAudible::-webkit-slider-thumb { background: #f5f5f7; }\r\n  #coachInnerAudible::-moz-range-thumb { background: #f5f5f7; }\r\n  #coachInnerMuted::-webkit-slider-thumb { background: var(--accent-neon-yellow); }\r\n  #coachInnerMuted::-moz-range-thumb { background: var(--accent-neon-yellow); }\r\n  #coachSpeedStart::-webkit-slider-thumb { background: var(--btn-green-hover); }\r\n  #coachSpeedStart::-moz-range-thumb { background: var(--btn-green-hover); }\r\n  #coachSpeedTarget::-webkit-slider-thumb { background: var(--accent-neon-yellow); }\r\n  #coachSpeedTarget::-moz-range-thumb { background: var(--accent-neon-yellow); }\r\n  .metro-coach-dual-labels {\r\n    display: flex; align-items:center; justify-content: space-between; gap:8px; margin-top:4px;\r\n    font-family: var(--font-secondary); font-size:0.62rem; font-weight:800; letter-spacing:0.08em; color:#71717a;\r\n  }\r\n  .metro-coach-dual-labels strong { color:var(--accent-neon-yellow); font-variant-numeric: tabular-nums; }\r\n  .metro-coach-two-col {\r\n    display: grid; grid-template-columns: 1fr 1fr; gap:10px; width:100%; box-sizing:border-box;\r\n  }\r\n  .metro-coach-two-col .metro-coach-field { min-width:0; }\r\n  @media (max-width: 380px) { .metro-coach-two-col { gap:8px; } }\r\n\r\n  /* ---------- KINS Sheet Strip — runtime DOM (no astro scoping) ---------- */\r\n  .metro-sheet-track { --kins-sheet-canvas-h: 108px; }\r\n  @media (max-width: 380px) { .metro-sheet-track { --kins-sheet-canvas-h: 92px; } }\r\n  .kins-sheet-page {\r\n    flex: 0 0 auto;\r\n    scroll-snap-align: start;\r\n    background: #ffffff;\r\n    border: 2px solid #000;\r\n    box-shadow: 2px 2px 0 #000;\r\n    border-radius: var(--radius-sm);\r\n    overflow: hidden;\r\n    display: flex;\r\n    flex-direction: column;\r\n    min-width: 96px;\r\n    max-width: 220px;\r\n  }\r\n  .kins-sheet-page-head {\r\n    display: flex; align-items: center; justify-content: space-between; gap: 8px;\r\n    padding: 5px 8px; background: #1e1e24; border-bottom: 2px solid #000;\r\n    font-family: var(--font-secondary); font-size: 0.58rem; font-weight: 800;\r\n    letter-spacing: 0.08em; color: var(--accent-neon-yellow); white-space: nowrap;\r\n  }\r\n  .kins-sheet-page-num { color: #71717a; font-variant-numeric: tabular-nums; }\r\n  .kins-sheet-page canvas {\r\n    display: block; width: auto; max-width: 100%;\r\n    height: var(--kins-sheet-canvas-h);\r\n    object-fit: contain; background: #fff;\r\n  }\r\n  .kins-sheet-empty {\r\n    flex: 0 0 auto;\r\n    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;\r\n    width: 100%; min-width: 220px; padding: 18px 12px;\r\n    background: #1e1e24; border: 2px dashed rgba(255,255,255,0.12); border-radius: var(--radius-sm);\r\n    font-family: var(--font-secondary); font-size: 0.72rem; font-weight: 700; color: #a1a1aa; text-align: center;\r\n  }\r\n  .kins-sheet-empty strong { color: #f5f5f7; font-size: 0.78rem; letter-spacing: 0.06em; }\r\n  .kins-sheet-error {\r\n    flex: 0 0 auto;\r\n    background: #2a1212; border: 2px solid #c0392b; color: #ff8a8a;\r\n    padding: 10px 12px; border-radius: var(--radius-sm);\r\n    font-family: var(--font-secondary); font-size: 0.72rem; font-weight: 700;\r\n  }\r\n\r\n  /* bar card signature badge + popover (runtime DOM) */\r\n  .kins-sig-badge {\r\n    display: inline-flex; align-items: center; justify-content: center;\r\n    padding: 1px 6px; background: #0f0f12; color: var(--accent-neon-yellow);\r\n    border: 1px solid rgba(216,178,68,0.4); border-radius: var(--radius-pill);\r\n    font-family: var(--font-secondary); font-size: 0.56rem; font-weight: 900;\r\n    letter-spacing: 0.06em; font-variant-numeric: tabular-nums; cursor: pointer;\r\n  }\r\n  button.kins-sig-badge:hover { background: var(--accent-neon-yellow); color: #000; }\r\n  .kins-sig-badge--static { cursor: default; }\r\n\r\n  .kins-sheet-bar { cursor: pointer; }\r\n  .kins-sheet-bar:hover { box-shadow: 3px 3px 0 #000; transform: translate(-1px,-1px); }\r\n  .kins-sheet-bar canvas { pointer-events: none; }\r\n\r\n  .kins-sig-popover {\r\n    position: fixed; z-index: 90;\r\n    background: #1e1e24; border: 3px solid #000; box-shadow: 4px 4px 0 #000;\r\n    border-radius: var(--radius-md); padding: 12px;\r\n    display: flex; flex-direction: column; gap: 10px;\r\n    animation: kinsSigPop 0.16s var(--ease-snappy);\r\n  }\r\n  @keyframes kinsSigPop { from { opacity: 0; transform: translateY(6px) scale(0.97); } to { opacity: 1; transform: translateY(0) scale(1); } }\r\n  .kins-sig-popover-title {\r\n    margin: 0; font-family: var(--font-secondary); font-size: 0.64rem;\r\n    font-weight: 900; letter-spacing: 0.16em; color: #a1a1aa; text-transform: uppercase;\r\n  }\r\n  .kins-sig-popover-row { display: flex; flex-wrap: wrap; gap: 8px; }\r\n  .kins-sig-popover-row .metro-chip { padding: 10px 8px; font-size: 0.78rem; }\r\n\r\n  @media (prefers-reduced-motion: reduce) {\r\n    .kins-sig-popover,\r\n    .footer-brand-badge,\r\n    .footer-legal-btn,\r\n    .footer-theme-toggle-btn,\r\n    .theme-pill-btn {\r\n      animation: none !important;\r\n      transition: none !important;\r\n    }\r\n  }\r\n\r\n  /* ===== Light mode (standard) — global runtime sheet & coach ===== */\r\n  html[data-theme=\"standard\"] .metro-coach-card {\r\n    background: #ffffff;\r\n    color: #0a0a0c;\r\n  }\r\n  html[data-theme=\"standard\"] .metro-coach-label,\r\n  html[data-theme=\"standard\"] .kins-sig-popover-title,\r\n  html[data-theme=\"standard\"] .metro-coach-dual-labels {\r\n    color: #71717a;\r\n  }\r\n  html[data-theme=\"standard\"] .metro-coach-card .metro-chip {\r\n    background: #f5f4ef;\r\n    color: #0a0a0c;\r\n  }\r\n  html[data-theme=\"standard\"] .metro-coach-card .metro-chip.active {\r\n    background: var(--accent-neon-yellow);\r\n    color: #000000;\r\n  }\r\n  html[data-theme=\"standard\"] .kins-sheet-page-head {\r\n    background: #f5f4ef;\r\n    color: #0a0a0c;\r\n  }\r\n  html[data-theme=\"standard\"] .kins-sheet-empty {\r\n    background: #f5f4ef;\r\n    border-color: rgba(0, 0, 0, 0.12);\r\n    color: #71717a;\r\n  }\r\n  html[data-theme=\"standard\"] .kins-sheet-empty strong {\r\n    color: #0a0a0c;\r\n  }\r\n  html[data-theme=\"standard\"] .kins-sig-badge {\r\n    background: #f5f4ef;\r\n    color: #0a0a0c;\r\n    border-color: rgba(0, 0, 0, 0.15);\r\n  }\r\n  html[data-theme=\"standard\"] .kins-sig-popover {\r\n    background: #ffffff;\r\n    color: #0a0a0c;\r\n  }"],"\n",["STYLE",{},".metro-page[data-astro-cid-oerylgbb]{min-height:100vh;min-height:100dvh;display:flex;flex-direction:column;background-color:#0a0a0c;background-image:radial-gradient(circle at 50% 16%,#1e1c18 0%,#121210 42%,#08080a 78%,#040405 100%);color:var(--text-white);overflow:hidden;position:relative}.metro-page[data-astro-cid-oerylgbb] [hidden]{display:none!important}.metro-view[data-astro-cid-oerylgbb]{position:relative;z-index:1;flex:1 1 auto;display:flex;flex-direction:column;align-items:center;width:100%;max-width:520px;margin:0 auto;padding:calc(14px + env(safe-area-inset-top)) 16px calc(14px + env(safe-area-inset-bottom));box-sizing:border-box}.metro-topbar[data-astro-cid-oerylgbb]{position:relative;display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;flex-shrink:0}.metro-color-section[data-astro-cid-oerylgbb]{margin-top:6px;display:flex;flex-direction:column;gap:8px}.metro-color-grid[data-astro-cid-oerylgbb]{display:flex;flex-direction:column;gap:8px}.metro-color-row[data-astro-cid-oerylgbb]{display:flex;align-items:center;gap:10px;width:100%;padding:10px 12px;background:#1e1e24;color:#f5f5f7;border:2px solid #000000;box-shadow:2px 2px 0px #000000;border-radius:var(--radius-md);cursor:pointer;box-sizing:border-box;transition:transform 0.16s var(--ease-tactile),box-shadow 0.16s ease,background-color 0.16s ease,border-color 0.16s ease}.metro-color-row[data-astro-cid-oerylgbb]:hover{transform:translate(-1px,-1px);box-shadow:3px 3px 0px #000000;background:#25252e}.metro-color-row[data-astro-cid-oerylgbb]:active{transform:translate(1px,1px);box-shadow:1px 1px 0px #000000}.metro-color-tier-dot[data-astro-cid-oerylgbb]{width: