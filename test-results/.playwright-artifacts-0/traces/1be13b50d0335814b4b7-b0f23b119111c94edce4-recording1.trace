CTION",{"class":"legal-tab-panel","id":"legalPanelPrivacy","role":"tabpanel","aria-labelledby":"legalTabPrivacy","tabindex":"0","data-astro-cid-plzmpoju":""}," ",["DIV",{"class":"legal-highlight-card","data-astro-cid-plzmpoju":""}," ",["DIV",{"class":"legal-highlight-meta","data-astro-cid-plzmpoju":""}," ",["I",{"class":"fa-solid fa-clock","aria-hidden":"true","data-astro-cid-plzmpoju":""}]," ",["SPAN",{"data-astro-cid-plzmpoju":""},"LAST UPDATED: AUGUST 2026"]," "]," ",["P",{"class":"legal-intro-text","data-astro-cid-plzmpoju":""}," ",["STRONG",{"data-astro-cid-plzmpoju":""},"Kins"]," (\"we\", \"our\", or \"us\") respects your privacy. This policy outlines how we handle personal information collected through our official website and fan features.\n"]," "]," ",["DIV",{"class":"legal-content-section","data-astro-cid-plzmpoju":""}," ",["H4",{"class":"legal-section-heading","data-astro-cid-plzmpoju":""},"1. Information We Collect"]," ",["DIV",{"class":"legal-bullet-box","data-astro-cid-plzmpoju":""}," ",["DIV",{"class":"bullet-item","data-astro-cid-plzmpoju":""}," ",["SPAN",{"class":"bullet-tag","data-astro-cid-plzmpoju":""},"EMAIL"]," ",["P",{"data-astro-cid-plzmpoju":""},"When you subscribe to our fan updates, we collect your email to deliver release announcements, gig/tour drops, and band news."]," "]," ",["DIV",{"class":"bullet-item","data-astro-cid-plzmpoju":""}," ",["SPAN",{"class":"bullet-tag","data-astro-cid-plzmpoju":""},"SUBMISSIONS"]," ",["P",{"data-astro-cid-plzmpoju":""},"If you submit a fan clip, video link, or message, we collect the link and public handle you provide."]," "]," "]," "]," ",["DIV",{"class":"legal-content-section","data-astro-cid-plzmpoju":""}," ",["H4",{"class":"legal-section-heading","data-astro-cid-plzmpoju":""},"2. How We Use Your Data"]," ",["P",{"class":"legal-body-text","data-astro-cid-plzmpoju":""},"\nWe only use your information for official band communications and featured fan experiences. We never sell, rent, or trade your personal information to third-party advertisers.\n"]," "]," ",["DIV",{"class":"legal-content-section","data-astro-cid-plzmpoju":""}," ",["H4",{"class":"legal-section-heading","data-astro-cid-plzmpoju":""},"3. Service Providers"]," ",["P",{"class":"legal-body-text","data-astro-cid-plzmpoju":""},"\nWe use trusted delivery infrastructure (such as Substack and Supabase) to deliver email updates and host site features. These services process data strictly on our behalf in compliance with modern privacy standards.\n"]," "]," ",["DIV",{"class":"legal-content-section","data-astro-cid-plzmpoju":""}," ",["H4",{"class":"legal-section-heading","data-astro-cid-plzmpoju":""},"4. Unsubscribing & Rights"]," ",["P",{"class":"legal-body-text","data-astro-cid-plzmpoju":""},"\nYou can opt out at any time via the \"Unsubscribe\" link in any update email, or by emailing us directly at ",["A",{"href":"mailto:hello@kinsband.com","class":"legal-link","data-astro-cid-plzmpoju":""},"hello@kinsband.com"],".\n"]," "]," ",["DIV",{"class":"legal-content-section","data-astro-cid-plzmpoju":""}," ",["H4",{"class":"legal-section-heading","data-astro-cid-plzmpoju":""},"5. Privacy Contact"]," ",["P",{"class":"legal-body-text","data-astro-cid-plzmpoju":""},"For privacy questions or data deletion requests, contact:"]," ",["DIV",{"class":"legal-contact-pill","data-astro-cid-plzmpoju":""}," ",["I",{"class":"fa-solid fa-envelope","aria-hidden":"true","data-astro-cid-plzmpoju":""}]," ",["A",{"href":"mailto:hello@kinsband.com","class":"legal-link","data-astro-cid-plzmpoju":""},"hello@kinsband.com"]," "]," "]," "]," "," ",["SECTION",{"class":"legal-tab-panel hidden","id":"legalPanelSubmissions","role":"tabpanel","aria-labelledby":"legalTabSubmissions","tabindex":"0","data-astro-cid-plzmpoju":""}," ",["DIV",{"class":"legal-highlight-card accent-border","data-astro-cid-plzmpoju":""}," ",["DIV",{"class":"legal-highlight-meta accent-text","data-astro-cid-plzmpoju":""}," ",["I",{"class":"fa-solid fa-bolt","aria-hidden":